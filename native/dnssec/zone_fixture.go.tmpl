// Offline authority for the pinned validator prerequisite. No external queries.
package main
import (
 "bufio"
 "crypto"
 "encoding/json"
 "fmt"
 "net"
 "os"
 "strings"
 "time"
 "github.com/miekg/dns"
)
func main() {
 key := &dns.DNSKEY{Hdr:dns.RR_Header{Name:"signed.test.", Rrtype:dns.TypeDNSKEY, Class:dns.ClassINET, Ttl:60}, Flags:257, Protocol:3, Algorithm:dns.ECDSAP256SHA256}
 private,err:=key.Generate(256); if err!=nil {panic(err)}
 sign:=func(rrs []dns.RR, expired bool) []dns.RR {
  now:=time.Now(); end:=now.Add(time.Hour); if expired {end=now.Add(-48*time.Hour)}
  sig:=&dns.RRSIG{Hdr:dns.RR_Header{Name:rrs[0].Header().Name,Rrtype:dns.TypeRRSIG,Class:dns.ClassINET,Ttl:60},Algorithm:key.Algorithm,KeyTag:key.KeyTag(),SignerName:key.Hdr.Name,Inception:uint32(now.Add(-72*time.Hour).Unix()),Expiration:uint32(end.Unix())}
  if err:=sig.Sign(private.(crypto.Signer),rrs);err!=nil {panic(err)}
  return append(rrs,sig)
 }
 rr:=func(s string) dns.RR {r,e:=dns.NewRR(s);if e!=nil {panic(e)};return r}
 listener,err:=net.Listen("tcp4","127.0.0.1:0");if err!=nil {panic(err)}
 handler:=dns.HandlerFunc(func(w dns.ResponseWriter,q *dns.Msg){
  if len(q.Question)!=1 {return}; question:=q.Question[0]
  fmt.Fprintf(os.Stderr,"query %s %d\n",question.Name,question.Qtype)
  m:=new(dns.Msg); m.SetReply(q);m.Authoritative=true;m.RecursionAvailable=true
  name:=question.Name
  if name=="hold.signed.test." {time.Sleep(10*time.Second);return}
  if name=="signed.test." && question.Qtype==dns.TypeDNSKEY {m.Answer=sign([]dns.RR{key},false)
  } else if name=="child.signed.test." && question.Qtype==dns.TypeDS {
   m.Ns=append(sign([]dns.RR{rr("signed.test. 60 IN SOA ns.signed.test. hostmaster.signed.test. 1 60 60 60 60")},false),sign([]dns.RR{rr("child.signed.test. 60 IN NSEC expired.signed.test. NS RRSIG NSEC")},false)...)
  } else if name=="host.child.signed.test." && question.Qtype==dns.TypeA {
   m.Answer=[]dns.RR{rr(name+" 60 IN A 192.0.2.11")}
  } else if (name=="alias.signed.test." || name=="badalias.signed.test." || name=="crossalias.signed.test." || name=="tampered-alias.signed.test.") && question.Qtype==dns.TypeCNAME {
   target:="good.signed.test.";if name=="badalias.signed.test." {target="bogus.signed.test."};if name=="crossalias.signed.test." {target="outside.example.net."}
   record:=rr(name+" 60 IN CNAME "+target);signed:=sign([]dns.RR{record},false)
   if name=="tampered-alias.signed.test." {record.(*dns.CNAME).Target="bogus.signed.test."}
   m.Answer=signed
  } else if (name=="host.branch.signed.test." || name=="host.badbranch.signed.test.") && question.Qtype==dns.TypeCNAME {
   owner:="branch.signed.test.";if name=="host.badbranch.signed.test." {owner="badbranch.signed.test."}
   record:=rr(owner+" 60 IN DNAME outside.example.net.");signed:=sign([]dns.RR{record},false)
   if name=="host.badbranch.signed.test." {record.(*dns.DNAME).Target="changed.example.net."}
   m.Answer=append(signed,rr(name+" 60 IN CNAME host."+record.(*dns.DNAME).Target))
  } else if name=="alias.signed.test." && question.Qtype==dns.TypeA {
   m.Answer=append(sign([]dns.RR{rr(name+" 60 IN CNAME good.signed.test.")},false),sign([]dns.RR{rr("good.signed.test. 60 IN A 192.0.2.9")},false)...)
  } else if name=="badalias.signed.test." && question.Qtype==dns.TypeA {
   target:=rr("bogus.signed.test. 60 IN A 192.0.2.9"); signed:=sign([]dns.RR{target},false);target.(*dns.A).A=net.ParseIP("192.0.2.10")
   m.Answer=append(sign([]dns.RR{rr(name+" 60 IN CNAME bogus.signed.test.")},false),signed...)
  } else if (name=="absent.signed.test." || name=="badabsent.signed.test.") {
   m.Rcode=dns.RcodeNameError
   m.Ns=append(sign([]dns.RR{rr("signed.test. 60 IN SOA ns.signed.test. hostmaster.signed.test. 1 60 60 60 60")},false),sign([]dns.RR{rr("signed.test. 60 IN NSEC alias.signed.test. NS SOA RRSIG NSEC DNSKEY")},false)...)
   if name=="badabsent.signed.test." {m.Ns[3].(*dns.RRSIG).Signature="AAAA"}
  } else if name=="good.signed.test." && question.Qtype==dns.TypeAAAA {
   m.Ns=append(sign([]dns.RR{rr("signed.test. 60 IN SOA ns.signed.test. hostmaster.signed.test. 1 60 60 60 60")},false),sign([]dns.RR{rr("good.signed.test. 60 IN NSEC signed.test. A RRSIG NSEC")},false)...)
  } else if strings.HasSuffix(name,".signed.test.") && question.Qtype==dns.TypeA {
   record:=rr(name+" 60 IN A 192.0.2.9")
   m.Answer=sign([]dns.RR{record},name=="expired.signed.test.")
   if name=="bogus.signed.test." {record.(*dns.A).A=net.ParseIP("192.0.2.10")}
   if name=="unsigned.signed.test." {m.Answer=[]dns.RR{record}}
  } else {m.Rcode=dns.RcodeServerFailure}
  if err:=w.WriteMsg(m);err!=nil {fmt.Fprintln(os.Stderr,err)}
 })
 server:=&dns.Server{Listener:listener,Net:"tcp",Handler:handler}
 go func(){if e:=server.ActivateAndServe();e!=nil {panic(e)}}()
 json.NewEncoder(os.Stdout).Encode(map[string]any{"port":listener.Addr().(*net.TCPAddr).Port,"anchor":key.String()})
 bufio.NewReader(os.Stdin).ReadString('\n')
 server.Shutdown()
}
