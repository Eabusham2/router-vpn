package daemon

import (
	"context"
	"errors"
	"sync"

	box "github.com/sagernet/sing-box"
	"github.com/sagernet/sing-box/adapter"
)

var errRouterVPNInstanceCapture = errors.New("original reserved native construction changed or remains unjoined")

// A capture is reserved before a fresh service constructs anything. It never
// follows StartedService.instance to a later Box, including on startup failure.
type RouterVPNInstanceCloseCapture struct {
	service      *StartedService
	mu           sync.Mutex
	claimed      bool
	sealed       bool
	done         chan struct{}
	instance     *Instance
	original     *box.Box
	failure      error
	boxAttempted bool
}

func (s *StartedService) RouterVPNReserveInstanceCloseContext(ctx context.Context) (*RouterVPNInstanceCloseCapture, error) {
	if s == nil || ctx == nil {
		return nil, errRouterVPNInstanceCapture
	}
	if err := adapter.RouterVPNLockContext(ctx, &s.lifecycleAccess); err != nil {
		return nil, err
	}
	defer s.lifecycleAccess.Unlock()
	if err := adapter.RouterVPNWriteLockContext(ctx, &s.serviceAccess); err != nil {
		return nil, err
	}
	defer s.serviceAccess.Unlock()
	if s.closed || s.instance != nil || s.routerVPNConstructionStarted || s.routerVPNCloseCapture != nil || s.serviceStatus == nil || s.serviceStatus.Status != ServiceStatus_IDLE {
		return nil, errRouterVPNInstanceCapture
	}
	capture := &RouterVPNInstanceCloseCapture{service: s}
	s.routerVPNCloseCapture = capture
	return capture, nil
}

// Called exactly at newInstance entry, before allocation. Unreserved services
// preserve their ordinary lifecycle; a reserved service has one construction.
func (s *StartedService) routerVPNBeginInstanceCapture(ctx context.Context) (*RouterVPNInstanceCloseCapture, error) {
	if err := adapter.RouterVPNWriteLockContext(ctx, &s.serviceAccess); err != nil {
		return nil, err
	}
	s.routerVPNConstructionStarted = true
	capture := s.routerVPNCloseCapture
	s.serviceAccess.Unlock()
	if capture == nil {
		return nil, nil
	}
	capture.mu.Lock()
	defer capture.mu.Unlock()
	if capture.service != s || capture.claimed || capture.sealed {
		return nil, errRouterVPNInstanceCapture
	}
	capture.claimed = true
	capture.done = make(chan struct{})
	return capture, nil
}

func (c *RouterVPNInstanceCloseCapture) routerVPNCompleteInstanceCapture(instance *Instance, failure error, boxAttempted bool) {
	if c == nil {
		return
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	c.instance, c.failure = instance, failure
	c.boxAttempted = boxAttempted
	if instance != nil {
		c.original = instance.Box()
	}
	close(c.done)
}

func (c *RouterVPNInstanceCloseCapture) InstanceContext(ctx context.Context) (*Instance, error) {
	if c == nil || ctx == nil {
		return nil, errRouterVPNInstanceCapture
	}
	c.mu.Lock()
	done := c.done
	c.mu.Unlock()
	if done == nil {
		return nil, errRouterVPNInstanceCapture
	}
	select {
	case <-done:
	case <-ctx.Done():
		return nil, ctx.Err()
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.done != done || c.instance == nil || c.instance.Box() == nil {
		return nil, errors.Join(c.failure, errRouterVPNInstanceCapture)
	}
	return c.instance, ctx.Err()
}

// Seal prevents any later acquisition before joining construction. This is
// not a native-close receipt: an acquired Instance must still actually Close.
func (c *RouterVPNInstanceCloseCapture) SealContext(ctx context.Context) error {
	if c == nil || ctx == nil || ctx.Err() != nil {
		return errors.Join(errRouterVPNInstanceCapture, routerVPNInstanceCaptureContextError(ctx))
	}
	c.mu.Lock()
	c.sealed = true
	done := c.done
	c.mu.Unlock()
	if done != nil {
		select {
		case <-done:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return ctx.Err()
}

func routerVPNInstanceCaptureContextError(ctx context.Context) error {
	if ctx != nil {
		return ctx.Err()
	}
	return nil
}

func (c *RouterVPNInstanceCloseCapture) Owns(instance *Instance, original *box.Box) bool {
	if c == nil || instance == nil || original == nil {
		return false
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.instance == instance && c.original == original && instance.Box() == original
}

func (c *RouterVPNInstanceCloseCapture) ClosedContext(ctx context.Context) error {
	if c == nil || ctx == nil {
		return errRouterVPNInstanceCapture
	}
	c.mu.Lock()
	sealed, claimed, done := c.sealed, c.claimed, c.done
	c.mu.Unlock()
	if !sealed {
		return errRouterVPNInstanceCapture
	}
	if !claimed && done == nil {
		// Positive no-acquisition receipt: sealing atomically forbids the
		// first constructor. This is not inferred from a missing instance.
		return ctx.Err()
	}
	if done == nil {
		return errRouterVPNInstanceCapture
	}
	select {
	case <-done:
	case <-ctx.Done():
		return ctx.Err()
	}
	c.mu.Lock()
	instance, original, failure, attempted := c.instance, c.original, c.failure, c.boxAttempted
	c.mu.Unlock()
	if instance == nil {
		// The exact constructor completed before Box acquisition, with an
		// actual failure; a successful constructor with no owner is invalid.
		if failure == nil || attempted {
			return errRouterVPNInstanceCapture
		}
		return ctx.Err()
	}
	return instance.RouterVPNClosedContext(ctx, original)
}
