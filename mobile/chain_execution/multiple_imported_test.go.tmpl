func multipleImportedExecutionBridgePlan(t *testing.T, target, execution string) *RouterNodeChainExecution {
	t.Helper()
	return multipleImportedExecutionBridgePacketPlan(t, target, execution, false)
}

func multipleImportedExecutionBridgePacketPlan(t *testing.T, target, execution string, includePacket bool) *RouterNodeChainExecution {
	t.Helper()
	raw, _ := executionBridgeSource(t, execution)
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(raw), &source) != nil {
		t.Fatal("original paired source")
	}
	source.Schema = 6
	middlePacket, packetIdentity := source.Nodes[1], source.IdentitySources[1]
	final, identity := source.Nodes[2], source.IdentitySources[2]
	source.Nodes = source.Nodes[:1]
	source.IdentitySources = source.IdentitySources[:1]
	for position := 1; position <= 2; position++ {
		host, ip, id := fmt.Sprintf("203.0.113.%d", 20+position), fmt.Sprintf("198.51.100.%d", 90+position), fmt.Sprintf("native-independent-%d", position)
		password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(73 + position)}, 32))
		graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "interface_name": "router-vpn", "address": []string{"172.29.91.1/30", "fd29:91::1/126"}, "mtu": 1280, "auto_route": true, "strict_route": true, "stack": "system"}}, "endpoints": []any{}, "outbounds": []any{map[string]any{"type": "shadowsocks", "tag": mobilemultihop.ExternalFinalTag, "server": host, "server_port": 8388, "method": mobilemultihop.NativeStartLayerMethod, "password": password}}, "route": map[string]any{"final": mobilemultihop.ExternalFinalTag, "rules": []any{}, "auto_detect_interface": true}}
		profile := map[string]any{"id": id, "node_kind": "external", "endpoint": host, "external": map[string]any{"protocol": "shadowsocks", "expected_public_ip": ip, "shadowsocks": map[string]any{"server": host, "port": 8388, "method": mobilemultihop.NativeStartLayerMethod, "password": password}}, "dns_mode": "home", "start_layer": "off", "mtu_policy": "auto", "ipv6_mode": "off", "home_lan_access": false, "kill_switch_policy": "always"}
		capture := map[string]any{"schema": 1, "exit_id": id, "protocol": "shadowsocks", "expected_public_ip": ip, "profile": profile}
		middle, err := mobilemultihop.NodeChainImportedMemberInput(executionBridgeJSON(t, graph), executionBridgeJSON(t, capture))
		if err != nil {
			t.Fatal(err)
		}
		source.Nodes = append(source.Nodes, middle)
		source.IdentitySources = append(source.IdentitySources, "")
	}
	if includePacket {
		source.Nodes = append(source.Nodes, middlePacket)
		source.IdentitySources = append(source.IdentitySources, packetIdentity)
	}
	source.Nodes = append(source.Nodes, final)
	source.IdentitySources = append(source.IdentitySources, identity)
	original, err := mobilemultihop.NewNodeChain(executionBridgeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	if target != "" {
		original, err = mobilemultihop.ProjectNodeChain(original, target, 1280)
		if err != nil {
			t.Fatal(err)
		}
	}
	launch, err := original.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	plan, err := RouterNodeChainMultipleImportedExecutionFromLaunch(launch, execution)
	if err != nil {
		t.Fatal(err)
	}
	return plan
}
func TestRouterNodeChainExecutionBridgeMultipleImportedOriginalSource(t *testing.T) {
	for _, mode := range []string{"", "ios", "android"} {
		for _, execution := range []string{"server", "auto"} {
			target := mode
			if target == "" {
				target = "native"
			}
			t.Run(target+"/"+execution, func(t *testing.T) {
				plan := multipleImportedExecutionBridgePlan(t, mode, execution)
				defer plan.Close()
				launch, err := plan.LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
				replay, err := NewRouterNodeChainMultipleImportedExecutionLaunch(launch)
				if err != nil {
					t.Fatal(err)
				}
				defer replay.Close()
				original, _ := plan.prep.OriginalMultipleImportedSource()
				other, _ := replay.prep.OriginalMultipleImportedSource()
				if original == other || plan.Source() != replay.Source() || plan.Config() != replay.Config() || plan.SourceSHA256() != replay.SourceSHA256() || plan.LocalSourceSHA256() != replay.LocalSourceSHA256() {
					t.Fatal("typed execution replay changed source or reused original owner")
				}
				if _, err := NewRouterNodeChainExecutionLaunch(launch); err == nil {
					t.Fatal("generic launch accepted typed execution")
				}
				if _, err := NewRouterNodeChainExecution(plan.prep.LocalSource(), execution); err == nil {
					t.Fatal("generic source accepted typed execution")
				}
				for _, bad := range []string{strings.Replace(launch, `"schema":1`, `"schema":1,"schema":1`, 1), launch + " ", strings.Replace(launch, routerNodeChainMultipleImportedExecutionLaunchKind, routerNodeChainExecutionLaunchKind, 1)} {
					if _, err := NewRouterNodeChainMultipleImportedExecutionLaunch(bad); err == nil {
						t.Fatal("noncanonical or foreign-family launch accepted")
					}
				}
			})
		}
	}
}
func TestRouterNodeChainExecutionBridgeMultipleImportedOriginalFactory(t *testing.T) {
	for _, fault := range []string{"original", "ordinary-server", "foreign-server", "foreign-preparation", "duplicate-factory", "copied-plan", "copied-owner", "closed"} {
		t.Run(fault, func(t *testing.T) {
			plan := multipleImportedExecutionBridgePlan(t, "", "server")
			server, err := RouterNodeChainMultipleImportedExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{})
			if err != nil {
				t.Fatal(err)
			}
			t.Cleanup(func() {
				if err := plan.Close(); err != nil {
					t.Error(err)
				}
				if err := server.StartedService.CloseService(); err != nil {
					t.Error(err)
				}
				server.Close()
			})
			captured := plan.multipleServer.Load()
			if captured == nil || captured.preparation != plan.prep {
				t.Fatal("factory lost original preparation")
			}
			switch fault {
			case "ordinary-server":
				if plan.BindNative(&CommandServer{StartedService: server.StartedService, ctx: context.Background()}) == nil {
					t.Fatal("ordinary service borrowed typed factory")
				}
				return
			case "foreign-server":
				other := multipleImportedExecutionBridgePlan(t, "", "server")
				defer other.Close()
				if other.BindNative(server) == nil {
					t.Fatal("equal source borrowed another factory")
				}
				return
			case "foreign-preparation":
				old := plan.prep
				other := multipleImportedExecutionBridgePlan(t, "", "server")
				plan.prep = other.prep
				err = plan.BindNative(server)
				plan.prep = old
				defer other.Close()
				if err == nil {
					t.Fatal("reparsed preparation borrowed original proxy")
				}
				return
			case "duplicate-factory":
				if _, err := RouterNodeChainMultipleImportedExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{}); err == nil {
					t.Fatal("same execution made another native server")
				}
			case "copied-plan":
				copy := &RouterNodeChainExecution{prep: plan.prep}
				copy.multipleServer.Store(captured)
				if copy.BindNative(server) == nil {
					t.Fatal("equal preparation borrowed original plan's native factory")
				}
			case "copied-owner":
				copy := &routerNodeMultipleImportedExecutionServerOwner{self: captured, plan: plan, preparation: captured.preparation, source: captured.source, registry: captured.registry, server: captured.server, started: captured.started}
				plan.multipleServer.Store(copy)
				if plan.BindNative(server) == nil {
					t.Fatal("copied factory owner borrowed original native reservation")
				}
				plan.multipleServer.Store(captured)
			case "closed":
				if err := plan.Close(); err != nil {
					t.Fatal(err)
				}
				if _, err := RouterNodeChainMultipleImportedExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{}); err == nil {
					t.Fatal("retired execution reopened its factory")
				}
				return
			}
			if err := plan.BindNative(server); err != nil {
				t.Fatal(err)
			}
			if plan.Healthy() || plan.NativeClosed() {
				t.Fatal("unstarted native factory invented proof or DOWN")
			}
			if err := plan.Close(); err != nil {
				t.Fatal(err)
			}
			if err := server.StartedService.CloseService(); err != nil || !plan.NativeClosed() {
				t.Fatal("original empty native reservation did not join", err)
			}
		})
	}
}

// The exported command server constructs the Box in this fixture. Only the
// privileged TUN, packet interface and worker status producer use the existing
// test boundaries. Separate SS2022 client and server instances authenticate
// each stream, including streams requested by the real per-position SOCKS front.
type executionFactoryMultipleImported struct {
	candidate *executionFactoryPacketCandidate
	target    string
	peers     map[int]*executionFactoryImportedPeer
	remote    [3]atomic.Int64
}

type executionFactoryImportedPeer struct {
	virtual, socket, public, forward, next string
	method                                 ssclient.Method
	accepted                               atomic.Int64
}

func (m *executionFactoryMultipleImported) sources(t *testing.T, execution string) (*RouterNodeChainExecution, *mobilemultihop.NodeChainServerPolicy) {
	t.Helper()
	owner := multipleImportedExecutionBridgePacketPlan(t, m.target, execution, m.candidate != nil)
	var local mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(owner.prep.LocalSource()), &local) != nil {
		t.Fatal("original private sources")
	}
	entry := owner.prep.ProofInventory()[0]
	// The worker omits the entry and preserves both exact imported profiles.
	server := mobilemultihop.NodeChainServerSource{Schema: 6, EntryID: entry.ProfileID, EntryNodeID: entry.NodeID, EntryMode: entry.Mode, Nodes: append([]string(nil), local.Nodes[1:]...), IdentitySources: append([]string(nil), local.IdentitySources[1:]...)}
	if m.candidate != nil {
		// Reuse the separately provisioned private WG bundle for this exact
		// original packet profile. The client and Server use distinct WG keys.
		pairedOwner, pairedPolicy := executionFactorySources(t, execution)
		defer pairedOwner.Close()
		var paired mobilemultihop.NodeChainServerSource
		if json.Unmarshal([]byte(pairedPolicy.Source()), &paired) != nil || len(paired.Nodes) != 2 || paired.IdentitySources[0] == "" {
			t.Fatal("independent packet peer missing")
		}
		slot := m.candidate.position - 1
		server.Nodes[slot], server.IdentitySources[slot] = paired.Nodes[0], paired.IdentitySources[0]
	}
	policy, err := mobilemultihop.NewNodeChainMultipleImportedServerPolicy(executionBridgeJSON(t, server))
	if err != nil {
		t.Fatal("source for actual remote front", err)
	}
	if m.candidate != nil {
		m.candidate.policy = policy
	}
	return owner, policy
}

func (p *executionFactoryImportedPeer) NewConnection(ctx context.Context, conn net.Conn, meta M.Metadata) error {
	defer conn.Close()
	target := ""
	if meta.Destination.String() == "1.1.1.1:443" {
		target = p.public
		p.accepted.Add(1)
	} else if meta.Destination.String() == p.next && p.forward != "" {
		target = p.forward
	} else {
		return errors.New("foreign encrypted prefix destination")
	}
	upstream, err := (&net.Dialer{}).DialContext(ctx, "tcp", target)
	if err != nil {
		return err
	}
	defer upstream.Close()
	done := make(chan struct{})
	go func() { defer close(done); io.Copy(upstream, conn); upstream.Close() }()
	io.Copy(conn, upstream)
	upstream.Close()
	conn.Close()
	<-done
	return nil
}
func (*executionFactoryImportedPeer) NewPacketConnection(context.Context, N.PacketConn, M.Metadata) error {
	return errors.New("TCP proof only")
}
func (*executionFactoryImportedPeer) NewError(context.Context, error) {}

func (m *executionFactoryMultipleImported) start(t *testing.T, f *executionFactoryLiveFixture, certificate tls.Certificate) {
	t.Helper()
	m.peers = make(map[int]*executionFactoryImportedPeer)
	members := f.serverPolicy.Descriptor().Members
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(f.prep.LocalSource()), &source) != nil {
		t.Fatal("original complete source missing")
	}
	for position := 2; position >= 1; position-- {
		var member struct {
			Config string `json:"config"`
		}
		var graph struct {
			Outbounds []struct {
				Tag      string `json:"tag"`
				Host     string `json:"server"`
				Port     int    `json:"server_port"`
				Method   string `json:"method"`
				Password string `json:"password"`
			} `json:"outbounds"`
		}
		if json.Unmarshal([]byte(source.Nodes[position]), &member) != nil || json.Unmarshal([]byte(member.Config), &graph) != nil || len(graph.Outbounds) != 1 {
			t.Fatal("original complete imported outbound missing")
		}
		opt := graph.Outbounds[0]
		ip := members[position-1].ExpectedPublicIP
		origin := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if r.Method != "GET" || r.Host != "1.1.1.1" || r.URL.Path != "/cdn-cgi/trace" || len(r.URL.Query().Get("routervpn_proof")) != 32 || r.Header.Get("Authorization") != "" {
				http.Error(w, "unknown origin", 403)
				return
			}
			fmt.Fprintf(w, "ip=%s\n", ip)
		}))
		origin.TLS = &tls.Config{Certificates: []tls.Certificate{certificate}, MinVersion: tls.VersionTLS12}
		origin.StartTLS()
		t.Cleanup(origin.Close)
		method, err := ssclient.CreateMethod(f.ctx, opt.Method, ssclient.MethodOptions{Password: opt.Password})
		if err != nil {
			t.Fatal(err)
		}
		peer := &executionFactoryImportedPeer{virtual: net.JoinHostPort(opt.Host, strconv.Itoa(opt.Port)), method: method, public: origin.Listener.Addr().String()}
		m.peers[position] = peer
		if next := m.peers[position+1]; next != nil {
			peer.forward, peer.next = next.socket, next.virtual
		}
		ss, err := shadowaead_2022.NewServiceWithPassword(opt.Method, opt.Password, 10, peer, nil)
		if err != nil {
			t.Fatal(err)
		}
		ln, err := net.Listen("tcp4", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		peer.socket = ln.Addr().String()
		var connections sync.Map
		var workers sync.WaitGroup
		accepted := make(chan struct{})
		go func() {
			defer close(accepted)
			for {
				conn, err := ln.Accept()
				if err != nil {
					return
				}
				workers.Add(1)
				connections.Store(conn, true)
				go func() {
					defer workers.Done()
					defer connections.Delete(conn)
					defer conn.Close()
					conn.SetDeadline(time.Now().Add(30 * time.Second))
					ss.NewConnection(f.ctx, conn, M.Metadata{Source: M.SocksaddrFromNet(conn.RemoteAddr())})
				}()
			}
		}()
		t.Cleanup(func() {
			ln.Close()
			<-accepted
			connections.Range(func(k, v any) bool { k.(net.Conn).Close(); return true })
			workers.Wait()
		})
	}
}

func (m *executionFactoryMultipleImported) remoteDial(ctx context.Context, position int, destination string) (net.Conn, error) {
	if position < 1 || position > 2 || m.peers[position] == nil {
		return nil, errors.New("foreign remote prefix")
	}
	conn, err := (&net.Dialer{}).DialContext(ctx, "tcp", m.peers[1].socket)
	if err != nil {
		return nil, err
	}
	for i := 1; i <= position; i++ {
		address := destination
		if i < position {
			address = m.peers[i+1].virtual
		}
		wrapped, err := m.peers[i].method.DialConn(conn, M.ParseSocksaddr(address))
		if err != nil {
			conn.Close()
			return nil, err
		}
		conn = wrapped
	}
	m.remote[position].Add(1)
	return conn, nil
}

func TestRouterNodeChainExecutionBridgeMultipleImportedSelectedService(t *testing.T) {
	for _, target := range []string{"ios", "android"} {
		for _, outcome := range []string{"server", "compare-local", "compare-server"} {
			t.Run(target+"/"+outcome, func(t *testing.T) {
				socksBridgeNativeSetup(t)
				multiple := &executionFactoryMultipleImported{target: target}
				f := executionFactoryLive(t, outcome, multiple)
				selected := strings.TrimPrefix(outcome, "compare-")
				for position := 1; position <= 2; position++ {
					authenticated := multiple.peers[position].accepted.Load()
					remote := multiple.remote[position].Load()
					if remote == 0 || authenticated < remote {
						t.Fatal("original Server front did not authenticate every imported prefix", position, authenticated, remote)
					}
					if outcome != "server" && authenticated == remote {
						t.Fatal("Compare failed to authenticate the independent Local route", position, authenticated)
					}
				}
				measurement, err := RouterNodeChainExecutionNewHopMeasurement(f.owner, f.server)
				if err != nil {
					t.Fatal("selected measurement", err)
				}
				facade, err := RouterNodeChainExecutionNewLatencyBenchmark(f.owner, f.server, measurement)
				if err != nil {
					t.Fatal("selected latency", err)
				}
				raw := facade.CaptureJSON()
				original, err := f.prep.OriginalMultipleImportedSource()
				if err != nil || original.ValidateMultipleImportedLatencyCapture(raw) != nil {
					t.Fatal("selected native capture lost original member identities", err)
				}
				var capture struct {
					Execution string `json:"selected_execution"`
					Multiple  struct {
						Public []struct {
							Tag string `json:"tag"`
						} `json:"public"`
					} `json:"multiple_imported"`
				}
				if json.Unmarshal([]byte(raw), &capture) != nil || capture.Execution != selected || len(capture.Multiple.Public) != 2 || capture.Multiple.Public[0].Tag == capture.Multiple.Public[1].Tag {
					t.Fatal("selected winner or distinct imported tags lost")
				}
				// Capture Last uses the actual selected runtime. The reopened envelope
				// grants only a fresh preparation until another connection proves it.
				if err = facade.Close(); err != nil {
					t.Fatal(err)
				}
				if err = measurement.Close(); err != nil {
					t.Fatal(err)
				}
				saved, err := f.owner.CaptureLastJSON()
				if err != nil {
					t.Fatal("actual selected Last", err)
				}
				launch, err := original.LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
				last, err := RouterNodeChainMultipleImportedExecutionFromLast(launch, f.prep.Execution(), saved)
				if err != nil {
					t.Fatal("reopen original selected Last", err)
				}
				defer last.Close()
				if last.last == nil || last.last.JSON() != saved || last.state.Load() != nil || last.native.Load() != nil {
					t.Fatal("saved selection fabricated a live owner")
				}
				if healthy := f.owner.Healthy(); !healthy {
					t.Fatal("original connected receipt no longer current")
				}
			})
		}
	}
}

// The selected production Box issues authenticated candidate PUT, status and
// DELETE through its original private entry. The Manager runs normal ownership
// checks. This controlled worker uses a real TCP destination and production
// connect-only quota; native worker/password/packet transport is separate.
type executionFactoryPacketCandidate struct {
	position                int
	destination             string
	listener                net.Listener
	policy                  *mobilemultihop.NodeChainServerPolicy
	current                 atomic.Pointer[executionFactoryPacketOperation]
	accepted, puts, deletes atomic.Int64
	controlError            atomic.Value
}
type executionFactoryPacketOperation struct {
	owner   *executionFactoryPacketCandidate
	capture multihoprelay.NodeChainCandidateCapture
	quota   *multihoprelay.NodeChainCandidateAdmission
}

func (w *executionFactoryRemoteWorker) NewCandidateOperation(ctx context.Context, c multihoprelay.NodeChainCandidateCapture) (multihoprelay.NodeChainCandidateOperation, error) {
	peer := w.candidate
	if peer == nil || !w.alive.Load() || !w.ready.Load() || c.Request.Position != peer.position {
		return nil, errRouterNodeChainExecution
	}
	expected, err := w.capture.Digest()
	actual, e := c.Lease.Digest()
	if err != nil || e != nil || actual != expected {
		return nil, errRouterNodeChainExecution
	}
	target, err := peer.policy.CandidateTarget(c)
	if err != nil {
		return nil, err
	}
	_, address, err := target.Read(peer.policy, c)
	if err != nil || address != peer.destination {
		return nil, errRouterNodeChainExecution
	}
	quota, err := multihoprelay.NewNodeChainCandidateAdmission(context.Background(), c)
	if err != nil {
		return nil, err
	}
	op := &executionFactoryPacketOperation{owner: peer, capture: c.Clone(), quota: quota}
	if !peer.current.CompareAndSwap(nil, op) {
		return nil, errors.Join(errRouterNodeChainExecution, quota.CloseContext(ctx))
	}
	return op, nil
}
func (op *executionFactoryPacketOperation) Prepare(ctx context.Context) (multihoprelay.NodeChainCandidateReceipt, error) {
	return op.Snapshot(ctx)
}
func (op *executionFactoryPacketOperation) Snapshot(ctx context.Context) (multihoprelay.NodeChainCandidateReceipt, error) {
	c := op.capture
	if op.owner.current.Load() != op || ctx.Err() != nil {
		return multihoprelay.NodeChainCandidateReceipt{}, errRouterNodeChainExecution
	}
	d, err := c.Digest()
	use := op.quota.Snapshot()
	return multihoprelay.NodeChainCandidateReceipt{Schema: 1, Operation: c.Request.Operation, OperationOwnerID: c.OperationOwnerID, CaptureSHA256: d, DeadlineAt: c.Request.DeadlineAt, Prepared: true, Retired: use.Retired, Drained: use.Drained, Accepted: use.Accepted, InFlight: use.InFlight}, err
}
func (op *executionFactoryPacketOperation) Close(ctx context.Context) error {
	if err := op.quota.CloseContext(ctx); err != nil {
		return err
	}
	op.owner.current.CompareAndSwap(op, nil)
	return ctx.Err()
}
func (c *executionFactoryPacketCandidate) control(f *executionFactoryLiveFixture, w http.ResponseWriter, r *http.Request) {
	raw, err := io.ReadAll(io.LimitReader(r.Body, multihoprelay.NodeChainCandidateMaximumBytes+1))
	if err != nil || r.URL.RawQuery != "" {
		http.Error(w, "invalid candidate", 400)
		return
	}
	q, err := multihoprelay.DecodeNodeChainCandidateRequest(raw)
	if err != nil || q.Position != c.position || q.Address != c.destination {
		http.Error(w, "wrong packet target", 400)
		return
	}
	var reply any
	switch r.Method {
	case http.MethodPut:
		c.puts.Add(1)
		reply, err = f.manager.CreateChainCandidate(r.Context(), f.peer, q)
	case http.MethodPost:
		reply, err = f.manager.ChainCandidateStatus(r.Context(), f.peer, q)
	case http.MethodDelete:
		err = f.manager.DeleteChainCandidate(r.Context(), f.peer, q)
		if err == nil {
			reply, err = multihoprelay.NewNodeChainCandidateCloseAcknowledgement(q)
			c.deletes.Add(1)
		}
	default:
		http.Error(w, "unsupported", 405)
		return
	}
	if err != nil {
		c.controlError.Store(r.Method + ": " + err.Error())
		http.Error(w, "original candidate owner refused", 409)
		return
	}
	json.NewEncoder(w).Encode(reply)
}
func (c *executionFactoryPacketCandidate) front(ctx context.Context, conn net.Conn, reader *bufio.Reader, user, password string) bool {
	op := c.current.Load()
	if op == nil || user != op.capture.Username() {
		return false
	}
	if password != op.capture.Request.Password || socks5.WriteUsernamePasswordAuthResponse(conn, socks5.UsernamePasswordAuthResponse{Status: socks5.UsernamePasswordStatusSuccess}) != nil {
		return true
	}
	req, err := socks5.ReadRequest(reader)
	if err != nil || req.Command != socks5.CommandConnect {
		return true
	}
	release, err := op.quota.Begin(ctx, user, password, "tcp", req.Destination.String())
	if err != nil {
		return true
	}
	defer release()
	upstream, err := (&net.Dialer{}).DialContext(ctx, "tcp", c.listener.Addr().String())
	if err != nil {
		return true
	}
	upstream.Close()
	socks5.WriteResponse(conn, socks5.Response{ReplyCode: socks5.ReplyCodeSuccess, Bind: M.ParseSocksaddr("127.0.0.1:1234")})
	return true
}
func newExecutionFactoryPacketCandidate(t *testing.T) *executionFactoryPacketCandidate {
	ln, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	c := &executionFactoryPacketCandidate{position: 3, destination: "198.51.100.22:8388", listener: ln}
	done := make(chan struct{})
	go func() {
		defer close(done)
		for {
			s, err := ln.Accept()
			if err != nil {
				return
			}
			c.accepted.Add(1)
			s.Close()
		}
	}()
	t.Cleanup(func() { ln.Close(); <-done })
	return c
}

type executionFactoryCandidateSource struct{ input, id, sha, address string }

func TestRouterNodeChainExecutionBridgeMultipleImportedSelectedPacketCandidate(t *testing.T) {
	runMultipleImportedSelectedCandidate(t, nil)
}

func runMultipleImportedSelectedCandidate(t *testing.T, source *executionFactoryCandidateSource) {
	t.Helper()
	for _, outcome := range []string{"server", "compare-local", "compare-server"} {
		t.Run(outcome, func(t *testing.T) {
			socksBridgeNativeSetup(t)
			wire := newExecutionFactoryPacketCandidate(t)
			if source != nil {
				wire.destination = source.address
			}
			f := executionFactoryLive(t, outcome, &executionFactoryMultipleImported{target: "android", candidate: wire})
			if source != nil {
				f.inventory = executionBridgeJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-openvpn-remote", Inputs: []string{source.input}})
				f.targetID, f.targetSHA = source.id, source.sha
			}
			saved, err := f.owner.CaptureLastJSON()
			if err != nil {
				t.Fatal(err)
			}
			f.runner.mu.Lock()
			workers := append([]*executionFactoryRemoteWorker(nil), f.runner.workers...)
			f.runner.mu.Unlock()
			epoch, err := f.nativeEngine.SelectionEpochContext(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			catalog := executionFactoryCatalogFor(f.inventory)
			for _, bad := range []int32{1, 2, 4} {
				if got, err := RouterNodeChainExecutionNewCandidateMeasurement(f.owner, f.server, bad, f.inventory, catalog); got != nil || err == nil {
					t.Fatal("nonpacket became a candidate timing prefix", bad)
				}
			}
			plan, err := RouterNodeChainExecutionNewCandidateMeasurement(f.owner, f.server, 3, f.inventory, catalog)
			if err != nil {
				t.Fatal("original paired candidate construction", err)
			}
			if err := plan.Prepare(); err != nil {
				t.Fatal("original paired candidate preparation", err)
			}
			request := strings.Repeat("c", 32)
			if err := plan.Start(request, f.targetID); err != nil {
				t.Fatal("original connected candidate start", err)
			}
			deadline := time.Now().Add(hopmeasure.RequestTimeout + hopmeasure.ObservationTimeout)
			var state hopmeasure.CandidateStatus
			for !state.Complete && time.Now().Before(deadline) {
				raw := plan.StatusJSON()
				if json.Unmarshal([]byte(raw), &state) != nil {
					t.Fatal("original published candidate status lost")
				}
				if !state.Complete {
					time.Sleep(25 * time.Millisecond)
				}
			}
			if err := plan.Drain(request); err != nil {
				t.Fatal(err)
			}
			if !state.Complete || !state.Drained || state.Failure != "" || state.CandidateID != f.targetID || state.CandidateSourceSHA256 != f.targetSHA || state.Measurement != "routed-tcp-connect" || len(state.Results) != 1 || state.Results[0].Benchmark == nil || state.Results[0].Benchmark.Attempts != 50 || state.Results[0].Benchmark.Distribution.Samples != 50 || wire.accepted.Load() != 50 {
				t.Fatal("unproved candidate fifty destination handshakes", state.Stage, state.Failure, wire.accepted.Load(), wire.puts.Load(), wire.deletes.Load(), wire.controlError.Load())
			}
			if err := plan.Close(); err != nil {
				t.Fatal(err)
			}
			remote := int64(1)
			if outcome == "compare-local" {
				remote = 0
			}
			f.runner.mu.Lock()
			sameWorkers := slices.Equal(workers, f.runner.workers)
			f.runner.mu.Unlock()
			if wire.puts.Load() != remote || wire.deletes.Load() != remote || wire.current.Load() != nil || f.owner.activities.candidate.Load() != nil || !sameWorkers {
				t.Fatal("candidate did not drain original authenticated operation", wire.puts.Load(), wire.deletes.Load(), wire.controlError.Load())
			}
			last, err := f.owner.CaptureLastJSON()
			now, e := f.nativeEngine.SelectionEpochContext(t.Context())
			if err != nil || e != nil || saved != last || now != epoch || !f.owner.Healthy() {
				t.Fatal("candidate changed original election, Last or health", err, e)
			}
		})
	}
}
