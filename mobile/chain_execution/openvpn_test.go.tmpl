// Actual Local compiler and independent provider pairing execute. No transport
// is started by these source and original CommandServer ownership controls.
func openVPNExecutionBridgePlan(t *testing.T, target, execution string) *RouterNodeChainExecution {
	t.Helper()
	raw, _ := executionBridgeSource(t, execution)
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(raw), &source) != nil {
		t.Fatal("original paired source")
	}
	config := "client\ndev tun\nproto udp\nremote 203.0.113.24 1194\nauth-user-pass\nremote-cert-tls server\npeer-fingerprint " + strings.Repeat("ab", 32) + "\ntun-mtu 1280\ndata-ciphers AES-256-GCM\n"
	profile := nativeopenvpn.Profile{Config: config, Username: "original-local-provider", Password: "local-private-password"}
	serverProfile := profile
	serverProfile.Username = "original-server-provider"
	serverProfile.Password = "server-private-password"
	key := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{71}, 32))
	serverKey := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{72}, 32))
	descriptor, err := nativeopenvpn.DescribePeer(serverProfile, serverKey)
	if err != nil {
		t.Fatal(err)
	}
	pair := nativeopenvpn.Pairing{PrivateKey: key, Server: descriptor}
	if _, err := nativeopenvpn.ValidatePairing(profile, pair); err != nil {
		t.Fatal(err)
	}
	compiled, err := nativeopenvpn.CompileEndpoint(config, profile.Username, profile.Password, mobilemultihop.ExternalFinalTag, "")
	if err != nil {
		t.Fatal(err)
	}
	var ep any
	if json.Unmarshal([]byte(compiled), &ep) != nil {
		t.Fatal("native endpoint")
	}
	graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "interface_name": "router-vpn", "address": []string{"172.29.91.1/30", "fd29:91::1/126"}, "mtu": 1280, "stack": "system", "auto_route": true, "strict_route": true}}, "endpoints": []any{ep}, "outbounds": []any{}, "route": map[string]any{"final": mobilemultihop.ExternalFinalTag, "rules": []any{}}}
	imported := map[string]any{"id": "original-openvpn-middle", "node_kind": "external", "endpoint": "203.0.113.24", "dns_mode": "home", "adguard_ipv4": "192.168.50.133", "ipv6_mode": "off", "home_lan_access": false, "kill_switch_policy": "always", "mtu_policy": "auto", "external": map[string]any{"protocol": "openvpn", "expected_public_ip": "203.0.113.88", "openvpn": profile, "openvpn_pairing": pair}}
	capture := map[string]any{"schema": 1, "exit_id": "original-openvpn-middle", "protocol": "openvpn", "expected_public_ip": "203.0.113.88", "profile": imported}
	member, err := mobilemultihop.NodeChainImportedOpenVPNMemberInput(executionBridgeJSON(t, graph), executionBridgeJSON(t, capture))
	if err != nil {
		t.Fatal(err)
	}
	source.Schema = 5
	source.Nodes[1] = member
	source.IdentitySources[1] = ""
	original, err := mobilemultihop.NewNodeChain(executionBridgeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	if target != "" {
		original, err = mobilemultihop.ProjectNodeChain(original, target, 1280)
		if err != nil {
			t.Fatal(err)
		}
	}
	launch, err := original.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	plan, err := RouterNodeChainOpenVPNExecutionFromLaunch(launch, execution)
	if err != nil {
		t.Fatal(err)
	}
	if plan.prep.Source() == "" || !strings.Contains(plan.Source(), "openvpn_local_launch") {
		t.Fatal("sealed Local launch lost")
	}
	return plan
}
func TestRouterNodeChainExecutionBridgeOpenVPNOriginalSource(t *testing.T) {
	for _, mode := range []string{"", "ios", "android"} {
		for _, execution := range []string{"server", "auto"} {
			t.Run(mode+"/"+execution, func(t *testing.T) {
				plan := openVPNExecutionBridgePlan(t, mode, execution)
				defer plan.Close()
				launch, err := plan.LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
				replay, err := NewRouterNodeChainOpenVPNExecutionLaunch(launch)
				if err != nil {
					t.Fatal(err)
				}
				defer replay.Close()
				original, _ := plan.prep.OriginalOpenVPNSource()
				other, _ := replay.prep.OriginalOpenVPNSource()
				if original == other || plan.Source() != replay.Source() || plan.Config() != replay.Config() || plan.SourceSHA256() != replay.SourceSHA256() || plan.LocalSourceSHA256() != replay.LocalSourceSHA256() {
					t.Fatal("typed execution replay changed source or reused original owner")
				}
				if _, err := NewRouterNodeChainExecutionLaunch(launch); err == nil {
					t.Fatal("generic launch accepted typed execution")
				}
				if _, err := NewRouterNodeChainExecution(plan.prep.LocalSource(), execution); err == nil {
					t.Fatal("generic source accepted typed execution")
				}
				for _, bad := range []string{strings.Replace(launch, `"schema":1`, `"schema":1,"schema":1`, 1), launch + " ", strings.Replace(launch, routerNodeChainOpenVPNExecutionLaunchKind, routerNodeChainExecutionLaunchKind, 1)} {
					if _, err := NewRouterNodeChainOpenVPNExecutionLaunch(bad); err == nil {
						t.Fatal("noncanonical or foreign-family launch accepted")
					}
				}
			})
		}
	}
}
func TestRouterNodeChainExecutionBridgeOpenVPNOriginalFactory(t *testing.T) {
	for _, fault := range []string{"original", "ordinary-server", "foreign-server", "foreign-preparation", "duplicate-factory", "copied-plan", "copied-owner", "closed"} {
		t.Run(fault, func(t *testing.T) {
			plan := openVPNExecutionBridgePlan(t, "", "server")
			server, err := RouterNodeChainOpenVPNExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{})
			if err != nil {
				t.Fatal(err)
			}
			t.Cleanup(func() {
				if err := plan.Close(); err != nil {
					t.Error(err)
				}
				if err := server.StartedService.CloseService(); err != nil {
					t.Error(err)
				}
				server.Close()
			})
			captured := plan.openvpnServer.Load()
			if captured == nil || captured.preparation != plan.prep {
				t.Fatal("factory lost original preparation")
			}
			switch fault {
			case "ordinary-server":
				if plan.BindNative(&CommandServer{StartedService: server.StartedService, ctx: context.Background()}) == nil {
					t.Fatal("ordinary service borrowed typed factory")
				}
				return
			case "foreign-server":
				other := openVPNExecutionBridgePlan(t, "", "server")
				defer other.Close()
				if other.BindNative(server) == nil {
					t.Fatal("equal source borrowed another factory")
				}
				return
			case "foreign-preparation":
				old := plan.prep
				other := openVPNExecutionBridgePlan(t, "", "server")
				plan.prep = other.prep
				err = plan.BindNative(server)
				plan.prep = old
				defer other.Close()
				if err == nil {
					t.Fatal("reparsed preparation borrowed original proxy")
				}
				return
			case "duplicate-factory":
				if _, err := RouterNodeChainOpenVPNExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{}); err == nil {
					t.Fatal("same execution made another native server")
				}
			case "copied-plan":
				copy := &RouterNodeChainExecution{prep: plan.prep}
				copy.openvpnServer.Store(captured)
				if copy.BindNative(server) == nil {
					t.Fatal("equal preparation borrowed original plan's native factory")
				}
			case "copied-owner":
				copy := &routerNodeOpenVPNExecutionServerOwner{self: captured, plan: plan, preparation: captured.preparation, source: captured.source, registry: captured.registry, server: captured.server, started: captured.started}
				plan.openvpnServer.Store(copy)
				if plan.BindNative(server) == nil {
					t.Fatal("copied factory owner borrowed original native reservation")
				}
				plan.openvpnServer.Store(captured)
			case "closed":
				if err := plan.Close(); err != nil {
					t.Fatal(err)
				}
				if _, err := RouterNodeChainOpenVPNExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{}); err == nil {
					t.Fatal("retired execution reopened its factory")
				}
				return
			}
			if err := plan.BindNative(server); err != nil {
				t.Fatal(err)
			}
			if plan.Healthy() || plan.NativeClosed() {
				t.Fatal("unstarted native factory invented proof or DOWN")
			}
			if err := plan.Close(); err != nil {
				t.Fatal(err)
			}
			if err := server.StartedService.CloseService(); err != nil || !plan.NativeClosed() {
				t.Fatal("original empty native reservation did not join", err)
			}
		})
	}
}
