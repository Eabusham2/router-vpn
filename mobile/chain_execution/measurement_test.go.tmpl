package libbox

import (
	"context"
	"errors"
	"sync/atomic"
	"testing"
	"time"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

var _ routerNodeChainExecutionMeasurementService = (*mobilemultihop.NodeChainExecutionMeasurement)(nil)

// The bridge's actual native-instance/Box identity fixture and actual public
// gomobile-facing methods execute. Measurement I/O is an explicit component
// double here; shared selected-prefix HTTP/I/O tests remain separately required.
type executionMeasurementBoundary struct {
	starts, closes, invalidations atomic.Int32
	failClose                     atomic.Bool
	closeHook                     func(context.Context) error
}

func (s *executionMeasurementBoundary) Start(string, int) error { s.starts.Add(1); return nil }
func (s *executionMeasurementBoundary) StartLatency(string, string) error {
	s.starts.Add(1)
	return nil
}
func (s *executionMeasurementBoundary) StartResponse(string, string) error {
	s.starts.Add(1)
	return nil
}
func (s *executionMeasurementBoundary) Cancel(string)      {}
func (s *executionMeasurementBoundary) Drain(string) error { return nil }
func (s *executionMeasurementBoundary) StatusJSON() string {
	return `{"fixture":"native-I/O-boundary"}`
}
func (s *executionMeasurementBoundary) Invalidate()  { s.invalidations.Add(1) }
func (s *executionMeasurementBoundary) Close() error { return s.CloseContext(context.Background()) }
func (s *executionMeasurementBoundary) CloseContext(ctx context.Context) error {
	s.closes.Add(1)
	if s.closeHook != nil {
		return s.closeHook(ctx)
	}
	if s.failClose.Load() {
		return errors.New("original measurement socket close failed")
	}
	return ctx.Err()
}

func executionMeasurementFixture(t *testing.T) (*RouterNodeChainExecution, *routerNodeChainExecutionState, *routerNodeChainExecutionControllerRef) {
	t.Helper()
	m, state := executionBridgeNativeFixture(t)
	controller := &routerNodeChainExecutionControllerRef{&executionBridgeControllerBoundary{close: func(ctx context.Context) error { return ctx.Err() }}}
	state.controller.Store(controller)
	return m, state, controller
}

func TestRouterNodeChainExecutionBridgeMeasurementRetainsFailedOriginalClose(t *testing.T) {
	m, state, controller := executionMeasurementFixture(t)
	service := &executionMeasurementBoundary{}
	public, err := m.captureExecutionMeasurementContext(context.Background(), state, controller, func(context.Context) (routerNodeChainExecutionMeasurementService, error) { return service, nil })
	if err != nil || public == nil {
		t.Fatal("original measurement admission failed", err)
	}
	if err := public.Start("captured", 65536); err != nil || service.starts.Load() != 1 {
		t.Fatal("public wrapper lost original service", err)
	}
	if err := public.Start("captured", 1); err == nil || service.starts.Load() != 1 {
		t.Fatal("wrapper lost bounded byte admission")
	}
	old := m.activities.measurement.Load()
	state.controller.Store(&routerNodeChainExecutionControllerRef{controller.value})
	if err := public.Start("replacement", 65536); err == nil || service.starts.Load() != 1 {
		t.Fatal("same-value replacement runtime borrowed measurement")
	}
	service.failClose.Store(true)
	if err := public.Close(); err == nil || m.activities.measurement.Load() != old || old.closed.Load() {
		t.Fatal("failed original measurement close released owner")
	}
	service.failClose.Store(false)
	if err := public.Close(); err != nil || m.activities.measurement.Load() != nil || !old.closed.Load() || service.closes.Load() != 2 {
		t.Fatal("exact failed measurement cleanup could not retry", err)
	}
	if err := public.Start("late", 65536); err == nil {
		t.Fatal("retired measurement started again")
	}
}

func TestRouterNodeChainExecutionBridgeMeasurementLateFactoryRemainsOwned(t *testing.T) {
	m, state, controller := executionMeasurementFixture(t)
	entered, release, result := make(chan struct{}), make(chan struct{}), make(chan error, 1)
	service := &executionMeasurementBoundary{}
	service.failClose.Store(true)
	go func() {
		_, err := m.captureExecutionMeasurementContext(context.Background(), state, controller, func(context.Context) (routerNodeChainExecutionMeasurementService, error) {
			close(entered)
			<-release
			return service, errors.New("owned late factory result")
		})
		result <- err
	}()
	<-entered
	m.NetworkChanged()
	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Millisecond)
	err := m.closeActivitiesContext(ctx)
	cancel()
	if !errors.Is(err, context.DeadlineExceeded) || m.activities.operation.Load() == nil {
		t.Fatal("late measurement factory was acknowledged before return", err)
	}
	close(release)
	if err := <-result; err == nil {
		t.Fatal("late factory became connected admission")
	}
	retained := m.activities.measurement.Load()
	if retained == nil || retained.service != service || service.invalidations.Load() != 1 {
		t.Fatal("owned late measurement result was lost")
	}
	if err := m.closeActivitiesContext(context.Background()); err == nil || m.activities.measurement.Load() != retained {
		t.Fatal("failed late close lost retained measurement")
	}
	service.failClose.Store(false)
	if err := m.closeActivitiesContext(context.Background()); err != nil || m.activities.measurement.Load() != nil || m.activities.operation.Load() != nil {
		t.Fatal("late original cleanup did not join", err)
	}
}

func TestRouterNodeChainExecutionBridgeActivitiesKeepExactGeneration(t *testing.T) {
	m, state, controller := executionMeasurementFixture(t)
	old, err := m.claimActivity(context.Background(), state, controller, "measurement")
	if err != nil {
		t.Fatal(err)
	}
	if next, err := m.claimActivity(context.Background(), state, controller, "mtu"); err == nil || next != nil {
		t.Fatal("MTU overlapped original measurement")
	}
	old.release()
	next, err := m.claimActivity(context.Background(), state, controller, "mtu")
	if err != nil {
		t.Fatal(err)
	}
	old.release()
	if m.activities.operation.Load() != next {
		t.Fatal("old activity erased replacement")
	}
	next.release()
	state.controller.Store(&routerNodeChainExecutionControllerRef{controller.value})
	if captured, err := m.claimActivity(context.Background(), state, controller, "measurement"); err == nil || captured != nil {
		t.Fatal("old controller admitted new activity")
	}
	m.NetworkChanged()
	if captured, err := m.claimActivity(context.Background(), state, state.controller.Load(), "measurement"); err == nil || captured != nil {
		t.Fatal("retired execution admitted activity")
	}
}

func TestRouterNodeChainExecutionBridgeMeasurementJoinPrecedesRemoteAndNativeRetirement(t *testing.T) {
	m, state, controller := executionMeasurementFixture(t)
	service := &executionMeasurementBoundary{}
	service.failClose.Store(true)
	var remote, native atomic.Int32
	controller.value = &executionBridgeControllerBoundary{close: func(ctx context.Context) error { remote.Add(1); return ctx.Err() }}
	state.engine.Store(&routerNodeChainExecutionEngineRef{&executionBridgeEngineBoundary{retire: func(ctx context.Context) error { native.Add(1); return ctx.Err() }}})
	if _, err := m.captureExecutionMeasurementContext(context.Background(), state, controller, func(context.Context) (routerNodeChainExecutionMeasurementService, error) { return service, nil }); err != nil {
		t.Fatal(err)
	}
	if err := m.closeContext(context.Background()); err == nil || m.closed.Load() || remote.Load() != 0 || native.Load() != 0 {
		t.Fatal("failed measurement cleanup authorized remote/native retirement", err)
	}
	service.failClose.Store(false)
	if err := m.closeContext(context.Background()); err != nil || !m.closed.Load() || remote.Load() != 1 || native.Load() != 1 {
		t.Fatal("joined measurement did not release exact retirement", err)
	}
}
