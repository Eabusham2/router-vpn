package libbox

import (
	"context"
	"testing"
)

// This is only the additional bridge native-close barrier. The capsule has
// no shared proof authority, so full restore must still refuse after actual
// daemon/Box closure. No successful native reader/remote proof is doubled.
func TestRouterNodeChainExecutionBridgeRestoreRequiresOriginalNativeJoin(t *testing.T) {
	source, _ := executionBridgeSource(t, "server")
	m, err := NewRouterNodeChainExecution(source, "server")
	if err != nil {
		t.Fatal(err)
	}
	server := executionBridgeReservedService(t, m)
	if err := server.StartedService.StartOrReloadService(server.ctx, executionBridgeEmptyNativeConfig, nil); err != nil {
		t.Fatal(err)
	}
	lifetime, cancel := context.WithCancel(server.ctx)
	t.Cleanup(cancel)
	state := &routerNodeChainExecutionState{server: server, service: server.StartedService, instance: server.StartedService.Instance(),
		box: server.StartedService.Instance().Box(), lifetime: lifetime, cancel: cancel, runDone: make(chan struct{})}
	close(state.runDone)
	controller := &routerNodeChainExecutionControllerRef{&executionBridgeControllerBoundary{close: func(ctx context.Context) error { return ctx.Err() }}}
	engine := &routerNodeChainExecutionEngineRef{&executionBridgeEngineBoundary{retire: func(ctx context.Context) error { return ctx.Err() }}}
	state.controller.Store(controller)
	state.engine.Store(engine)
	m.state.Store(state)
	capture := &RouterNodeChainExecutionRestoreCapture{owner: m, state: state, controller: controller, engine: engine, native: m.native.Load()}
	m.restoreCapture.Store(capture)
	if capture.originalNativeJoined(t.Context()) == nil {
		t.Fatal("live execution fabricated original native join")
	}
	if err := m.Close(); err != nil {
		t.Fatal(err)
	}
	if capture.originalNativeJoined(t.Context()) == nil {
		t.Fatal("restore used shared close without original native join")
	}
	if err := server.CloseService(); err != nil {
		t.Fatal(err)
	}
	if err := capture.originalNativeJoined(t.Context()); err != nil {
		t.Fatal("actual original daemon close receipt lost", err)
	}
	for _, fault := range []string{"capsule", "controller", "engine", "state", "native"} {
		t.Run(fault, func(t *testing.T) {
			switch fault {
			case "capsule":
				m.restoreCapture.Store(&RouterNodeChainExecutionRestoreCapture{})
			case "controller":
				state.controller.Store(&routerNodeChainExecutionControllerRef{controller.value})
			case "engine":
				state.engine.Store(&routerNodeChainExecutionEngineRef{engine.value})
			case "state":
				m.state.Store(&routerNodeChainExecutionState{})
			case "native":
				m.native.Store(&routerNodeChainExecutionNative{})
			}
			if capture.originalNativeJoined(t.Context()) == nil {
				t.Fatal("replacement borrowed original restore close", fault)
			}
			m.restoreCapture.Store(capture)
			state.controller.Store(controller)
			state.engine.Store(engine)
			m.state.Store(state)
			m.native.Store(capture.native)
		})
	}
	if _, err := NewRouterNodeChainExecutionRestore(capture); err == nil {
		t.Fatal("native close replaced shared reader/remote restore authority")
	}
}

func TestRouterNodeChainExecutionBridgeRestoreRefusesSerializedAuthority(t *testing.T) {
	var missing *RouterNodeChainExecution
	if missing.RequireRestore(nil) == nil {
		t.Fatal("missing restore granted authority")
	}
	source, _ := executionBridgeSource(t, "server")
	m, err := NewRouterNodeChainExecution(source, "server")
	if err != nil {
		t.Fatal(err)
	}
	claimed := &RouterNodeChainExecutionRestoreCapture{owner: m}
	claimed.claimed.Store(true)
	for _, capture := range []*RouterNodeChainExecutionRestoreCapture{nil, {}, claimed} {
		if restored, err := NewRouterNodeChainExecutionRestore(capture); err == nil || restored != nil {
			t.Fatal("metadata-only restore granted effective MTU authority")
		}
		if m.RequireRestore(capture) == nil {
			t.Fatal("ordinary source borrowed opaque restore authority")
		}
	}
}
