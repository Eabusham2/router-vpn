// Only the original selected execution can reserve a candidate. Entry timing
// uses that execution's retained local entry; later packet prefixes use either
// its retained Local graph or its exact Server lease. The exported factory
// never opens another graph or reruns Compare.
type routerNodeChainExecutionCandidateService interface {
	Start(string, string) error
	Cancel(string)
	Drain(string) error
	StatusJSON() string
	Invalidate()
	CloseContext(context.Context) error
}
type routerNodeChainExecutionCandidateServiceRef struct {
	value routerNodeChainExecutionCandidateService
}

// The concrete shared constructors remain separate. This private readback
// surface cannot parse a source or grant authority to another execution.
type routerNodeChainExecutionCandidatePlanMetadata interface {
	Metadata() string
	MetadataPage(int32) string
	CaptureSHA256() string
}
type RouterNodeChainExecutionCandidateMeasurement struct {
	self            *RouterNodeChainExecutionCandidateMeasurement
	owner           *RouterNodeChainExecution
	state           *routerNodeChainExecutionState
	controller      *routerNodeChainExecutionControllerRef
	engine          *routerNodeChainExecutionEngineRef
	projection      *mobilemultihop.NodeChainExecutionProjection
	runtime         *mobilemultihop.NodeChainExecutionRuntime
	plan            routerNodeChainExecutionCandidatePlanMetadata
	catalog         RouterNodeChainCandidateCatalog
	inventorySHA    string
	factory         func(context.Context) (routerNodeChainExecutionCandidateService, error)
	service         atomic.Pointer[routerNodeChainExecutionCandidateServiceRef]
	retired         atomic.Bool
	prepared        atomic.Bool
	callbackActive  atomic.Bool
	observation     sync.Mutex
	pending         *routerNodeChainCatalogCall
	preparation     sync.Mutex
	prepareStarted  bool
	prepareDeadline time.Time
	prepareDone     chan struct{}
	prepareActivity *routerNodeChainExecutionActivity
}

func RouterNodeChainExecutionNewCandidateMeasurement(owner *RouterNodeChainExecution, server *CommandServer, position int32, inventory string, catalog RouterNodeChainCandidateCatalog) (*RouterNodeChainExecutionCandidateMeasurement, error) {
	ctx, cancel := context.WithTimeout(context.Background(), hopmeasure.ObservationTimeout)
	defer cancel()
	return owner.newExecutionCandidateMeasurementContext(ctx, server, int(position), inventory, catalog)
}

// Source metadata only: the live candidate factory separately binds the
// original selected winner, native owner, catalog and cleanup scope.
func (m *RouterNodeChainExecution) SupportsSelectedFinalResponseCandidate(position int32) bool {
	return m != nil && m.prep != nil && !m.retired.Load() && !m.closed.Load() &&
		m.prep.SupportsSelectedFinalResponseCandidate(int(position))
}
func (m *RouterNodeChainExecution) SelectedPacketCandidateMode(position int32) string {
	if m == nil || m.prep == nil || m.retired.Load() || m.closed.Load() {
		return ""
	}
	return m.prep.SelectedPacketCandidateMode(int(position))
}
func (m *RouterNodeChainExecution) SupportsCompareLocalPacketResponseCandidate(position int32) bool {
	return m != nil && m.prep != nil && !m.retired.Load() && !m.closed.Load() && m.prep.SupportsCompareLocalPacketResponseCandidate(int(position))
}
func (m *RouterNodeChainExecution) SupportsServerPacketResponseCandidate(position int32) bool {
	return m != nil && m.prep != nil && !m.retired.Load() && !m.closed.Load() && m.prep.SupportsServerPacketResponseCandidate(int(position))
}
func (m *RouterNodeChainExecution) SelectedPacketCandidateInputFitsSource(position int32, input string) bool {
	return m != nil && m.prep != nil && !m.retired.Load() && !m.closed.Load() && m.prep.SelectedPacketCandidateInputFitsSource(int(position), input)
}

func (m *RouterNodeChainExecution) newExecutionCandidateMeasurementContext(ctx context.Context, server *CommandServer, position int, inventory string, catalog RouterNodeChainCandidateCatalog) (*RouterNodeChainExecutionCandidateMeasurement, error) {
	if m == nil || ctx == nil || ctx.Err() != nil || position < 0 || position >= mobilemultihop.NodeChainExtendedLocalMaximumNodes-1 || server == nil || catalog == nil {
		return nil, errRouterNodeChainExecution
	}
	deadline := time.Now().Add(hopmeasure.ObservationTimeout)
	if bound, ok := ctx.Deadline(); ok && bound.Before(deadline) {
		deadline = bound
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.activities.admission); err != nil {
		return nil, err
	}
	defer m.activities.admission.Unlock()
	state, controller, runtime, err := m.executionRuntimeContext(ctx)
	if err != nil || state == nil || state.owner != m || state.server != server || m.activities.candidate.Load() != nil {
		return nil, errors.Join(err, errRouterNodeChainExecution)
	}
	activity, err := m.claimActivity(ctx, state, controller, "candidate-capture")
	if err != nil {
		return nil, err
	}
	defer activity.release()
	engine, projection := state.engine.Load(), state.projection.Load()
	if engine == nil || projection == nil || m.prep == nil {
		return nil, errRouterNodeChainExecution
	}
	var plan routerNodeChainExecutionCandidatePlanMetadata
	var factory func(context.Context, *RouterNodeChainExecutionCandidateMeasurement) (routerNodeChainExecutionCandidateService, error)
	var inventoryMode struct {
		ResponseMode string `json:"response_mode"`
	}
	if json.Unmarshal([]byte(inventory), &inventoryMode) != nil {
		return nil, errRouterNodeChainExecution
	}
	if mode := inventoryMode.ResponseMode; mode != "" {
		if !mobilemultihop.NodeChainPrefixMode(mode) || m.prep.SelectedPacketCandidateMode(position) != mode {
			return nil, errRouterNodeChainExecution
		}
		switch runtime.Progress().Execution {
		case "local":
			selected, err := runtime.NewLocalPacketResponseCandidatePlanContext(ctx, position, inventory)
			if err != nil {
				return nil, err
			}
			plan = selected
			factory = func(call context.Context, owner *RouterNodeChainExecutionCandidateMeasurement) (routerNodeChainExecutionCandidateService, error) {
				service, err := selected.NewMeasurementContext(call, owner)
				if service == nil {
					return nil, err
				}
				return service, err
			}
		case "server":
			var selected *mobilemultihop.NodeChainExecutionRemoteCandidatePlan
			var err error
			if position == 0 {
				selected, err = runtime.NewRemoteFirstPacketResponseCandidatePlanContext(ctx, position, inventory)
			} else {
				selected, err = runtime.NewRemotePacketResponseCandidatePlanContext(ctx, position, inventory)
			}
			if err != nil {
				return nil, err
			}
			plan = selected
			factory = func(call context.Context, owner *RouterNodeChainExecutionCandidateMeasurement) (routerNodeChainExecutionCandidateService, error) {
				service, err := selected.NewMeasurementContext(call, owner)
				if service == nil {
					return nil, err
				}
				return service, err
			}
		default:
			return nil, errRouterNodeChainExecution
		}
	} else if position == 0 {
		entry, err := runtime.NewEntryCandidatePlanContext(ctx, position, inventory)
		if err != nil {
			return nil, err
		}
		plan = entry
		factory = func(call context.Context, owner *RouterNodeChainExecutionCandidateMeasurement) (routerNodeChainExecutionCandidateService, error) {
			service, err := entry.NewMeasurementContext(call, owner)
			if service == nil {
				return nil, err
			}
			return service, err
		}
	} else if runtime.Progress().Execution == "local" {
		// The constructor captures the existing Local winner and its original
		// packet prefix. A changed or Server winner is rejected without fallback.
		local, err := runtime.NewLocalCandidatePlanContext(ctx, position, inventory)
		if err != nil {
			return nil, err
		}
		plan = local
		factory = func(call context.Context, owner *RouterNodeChainExecutionCandidateMeasurement) (routerNodeChainExecutionCandidateService, error) {
			service, err := local.NewMeasurementContext(call, owner)
			if service == nil {
				return nil, err
			}
			return service, err
		}
	} else if runtime.Progress().Execution == "server" {
		// The response plan binds the original Server winner and obtains matching
		// registered sources from that server when the measurement starts.
		remote, err := runtime.NewSelectedRemoteCandidatePlanContext(ctx, position, inventory)
		if err != nil {
			return nil, err
		}
		plan = remote
		factory = func(call context.Context, owner *RouterNodeChainExecutionCandidateMeasurement) (routerNodeChainExecutionCandidateService, error) {
			service, err := remote.NewMeasurementContext(call, owner)
			if service == nil {
				return nil, err
			}
			return service, err
		}
	} else {
		return nil, errRouterNodeChainExecution
	}
	var metadata struct {
		PreparationSource string `json:"preparation_source_sha256"`
		PreparationConfig string `json:"preparation_config_sha256"`
		Source            string `json:"source_sha256"`
		Config            string `json:"config_sha256"`
		CandidateMode     string `json:"candidate_mode"`
	}
	if json.Unmarshal([]byte(plan.Metadata()), &metadata) != nil || metadata.PreparationSource != m.prep.SourceSHA256() || metadata.PreparationConfig != m.prep.ConfigSHA256() || metadata.Source != projection.SourceSHA256() || metadata.Config != projection.ConfigSHA256() || metadata.CandidateMode != inventoryMode.ResponseMode {
		return nil, errRouterNodeChainExecution
	}
	sum := sha256.Sum256([]byte(inventory))
	candidate := &RouterNodeChainExecutionCandidateMeasurement{owner: m, state: state, controller: controller, engine: engine, projection: projection, runtime: runtime, plan: plan, catalog: catalog, inventorySHA: hex.EncodeToString(sum[:]), prepareDeadline: deadline}
	candidate.self = candidate
	candidate.factory = func(call context.Context) (routerNodeChainExecutionCandidateService, error) {
		return factory(call, candidate)
	}
	return m.reserveExecutionCandidateContext(ctx, candidate)
}

// The package-private publication seam lets component tests exercise exact
// native slot ownership without fabricating shared proof or encrypted traffic.
// Shipping reaches it only after the actual selected runtime compiled its plan.
func (m *RouterNodeChainExecution) reserveExecutionCandidateContext(ctx context.Context, candidate *RouterNodeChainExecutionCandidateMeasurement) (*RouterNodeChainExecutionCandidateMeasurement, error) {
	if m == nil || candidate == nil || candidate.self != candidate || candidate.owner != m || candidate.state == nil || candidate.state.owner != m || ctx == nil || ctx.Err() != nil || m.nativeCurrent(ctx, candidate.state) != nil || candidate.state.controller.Load() != candidate.controller || candidate.state.engine.Load() != candidate.engine || candidate.state.projection.Load() != candidate.projection || m.activities.candidate.Load() != nil {
		return nil, errRouterNodeChainExecution
	}
	if !m.activities.candidate.CompareAndSwap(nil, candidate) {
		return nil, errRouterNodeChainExecution
	}
	// No fallible callback or service work follows reservation publication.
	return candidate, nil
}

func (m *RouterNodeChainExecutionCandidateMeasurement) current(ctx context.Context) error {
	if m == nil || ctx == nil || ctx.Err() != nil || m.self != m || m.owner == nil || m.state == nil || m.state.owner != m.owner || m.retired.Load() || m.owner.activities.candidate.Load() != m || m.owner.state.Load() != m.state || m.state.controller.Load() != m.controller || m.state.engine.Load() != m.engine || m.state.projection.Load() != m.projection {
		return errRouterNodeChainExecution
	}
	return m.owner.nativeCurrent(ctx, m.state)
}
func (m *RouterNodeChainExecutionCandidateMeasurement) Prepare() error {
	return m.prepareContext(context.Background())
}
func (m *RouterNodeChainExecutionCandidateMeasurement) prepareContext(ctx context.Context) error {
	if m == nil || ctx == nil || m.prepareDeadline.IsZero() || m.factory == nil {
		return errRouterNodeChainExecution
	}
	ctx, cancel := context.WithDeadline(ctx, m.prepareDeadline)
	defer cancel()
	if err := m.current(ctx); err != nil {
		return err
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.preparation); err != nil {
		return err
	}
	if m.prepareStarted || m.retired.Load() {
		m.preparation.Unlock()
		return errRouterNodeChainExecution
	}
	m.prepareStarted = true
	m.prepareDone = make(chan struct{})
	done := m.prepareDone
	m.preparation.Unlock()
	defer close(done)
	if err := adapter.RouterVPNLockContext(ctx, &m.owner.activities.admission); err != nil {
		return err
	}
	activity, err := m.owner.claimActivity(ctx, m.state, m.controller, "candidate-prepare")
	m.owner.activities.admission.Unlock()
	if err != nil {
		return err
	}
	m.prepareActivity = activity
	service, err := m.factory(ctx)
	if service != nil {
		m.service.Store(&routerNodeChainExecutionCandidateServiceRef{service})
	}
	if err == nil && service == nil {
		err = errRouterNodeChainExecution
	}
	if err == nil {
		err = m.current(ctx)
	}
	if err == nil {
		m.prepared.Store(true)
		activity.release()
	}
	// Failed/late Prepare leaves its exact activity and callback for Close.
	return err
}
func (m *RouterNodeChainExecutionCandidateMeasurement) MeasurementExecutionContext(ctx context.Context) (*mobilemultihop.NodeChainExecutionRuntime, error) {
	if err := m.current(ctx); err != nil {
		return nil, err
	}
	runtime, ok := m.controller.value.(*mobilemultihop.NodeChainExecutionRuntime)
	if !ok || runtime == nil || runtime != m.runtime {
		return nil, errRouterNodeChainExecution
	}
	return runtime, m.current(ctx)
}
func (m *RouterNodeChainExecutionCandidateMeasurement) BeginMeasurementContext(ctx context.Context) (func(), error) {
	if err := m.current(ctx); err != nil {
		return nil, err
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.owner.activities.admission); err != nil {
		return nil, err
	}
	defer m.owner.activities.admission.Unlock()
	if mtu := m.owner.activities.mtu.Load(); mtu != nil {
		if controller := mtu.controller.Load(); controller != nil && controller.Running() {
			return nil, errRouterNodeChainExecution
		}
	}
	activity, err := m.owner.claimActivity(ctx, m.state, m.controller, "candidate")
	if err != nil {
		return nil, err
	}
	release := func() { _ = m.joinCatalog(context.Background()); activity.release() }
	return release, m.current(ctx)
}
func (m *RouterNodeChainExecutionCandidateMeasurement) CandidateInventoryCurrentContext(parent context.Context, capture string) error {
	if parent == nil {
		return errors.New("candidate catalog observation has no original caller")
	}
	ctx, cancel := context.WithTimeout(parent, hopmeasure.ObservationTimeout)
	defer cancel()
	if err := m.current(ctx); err != nil {
		return err
	}
	if m.plan == nil || capture != m.plan.CaptureSHA256() || m.catalog == nil {
		return errors.New("candidate catalog differs from its original capture")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.observation); err != nil {
		return err
	}
	defer m.observation.Unlock()
	if m.pending != nil {
		select {
		case <-m.pending.done:
			m.pending = nil
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	if err := m.current(ctx); err != nil {
		return err
	}
	call := &routerNodeChainCatalogCall{done: make(chan struct{})}
	m.pending = call
	m.callbackActive.Store(true)
	go func() {
		defer func() { m.callbackActive.Store(false); close(call.done) }()
		call.digest = m.catalog.CurrentInventorySHA256()
	}()
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-call.done:
		m.pending = nil
		if err := m.current(ctx); err != nil {
			return err
		}
		if call.digest != m.inventorySHA {
			m.retired.Store(true)
			return errors.New("original candidate catalog revision or source changed")
		}
		return ctx.Err()
	}
}

func (m *RouterNodeChainExecutionCandidateMeasurement) Metadata() string { return m.MetadataPage(0) }
func (m *RouterNodeChainExecutionCandidateMeasurement) MetadataPage(offset int32) string {
	if m == nil || m.self != m || m.plan == nil {
		return ""
	}
	return m.plan.MetadataPage(offset)
}
func (m *RouterNodeChainExecutionCandidateMeasurement) CaptureSHA256() string {
	if m == nil || m.self != m || m.plan == nil {
		return ""
	}
	return m.plan.CaptureSHA256()
}
func (m *RouterNodeChainExecutionCandidateMeasurement) Start(request, candidateID string) error {
	if m == nil || m.self != m || m.service.Load() == nil || !m.prepared.Load() {
		return errors.New("candidate measurement is unavailable")
	}
	return m.service.Load().value.Start(request, candidateID)
}
func (m *RouterNodeChainExecutionCandidateMeasurement) Cancel(request string) {
	if m != nil && m.self == m {
		if service := m.service.Load(); service != nil {
			service.value.Cancel(request)
		}
	}
}
func (m *RouterNodeChainExecutionCandidateMeasurement) Drain(request string) error {
	if m == nil || m.self != m || m.service.Load() == nil {
		return errors.New("candidate measurement is unavailable")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := m.service.Load().value.Drain(request); err != nil {
		return err
	}
	return m.joinCatalog(ctx)
}
func (m *RouterNodeChainExecutionCandidateMeasurement) StatusJSON() string {
	if m == nil || m.self != m || m.service.Load() == nil {
		return ""
	}
	raw := m.service.Load().value.StatusJSON()
	if !m.callbackActive.Load() {
		return raw
	}
	var status hopmeasure.CandidateStatus
	if json.Unmarshal([]byte(raw), &status) != nil {
		return ""
	}
	status.Complete, status.Drained, status.Stage, status.Results = false, false, "draining", []hopmeasure.Result{}
	encoded, _ := json.Marshal(status)
	return string(encoded)
}
func (m *RouterNodeChainExecutionCandidateMeasurement) NetworkChanged() {
	if m != nil && m.self == m {
		m.retired.Store(true)
		if service := m.service.Load(); service != nil {
			service.value.Invalidate()
		}
	}
}
func (m *RouterNodeChainExecutionCandidateMeasurement) Close() error {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	return m.closeContext(ctx)
}
func (m *RouterNodeChainExecutionCandidateMeasurement) closeContext(ctx context.Context) error {
	if m == nil {
		return nil
	}
	if ctx == nil || m.self != m || m.owner == nil || m.state == nil || m.state.owner != m.owner {
		return errors.New("candidate close requires its original owner and caller")
	}
	if retained := m.owner.activities.candidate.Load(); retained != nil && retained != m {
		return errors.New("candidate close lost its original owner slot")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.preparation); err != nil {
		return err
	}
	m.retired.Store(true)
	started, done := m.prepareStarted, m.prepareDone
	m.preparation.Unlock()
	if started {
		select {
		case <-done:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	if service := m.service.Load(); service != nil {
		if err := service.value.CloseContext(ctx); err != nil {
			return err
		}
	}
	if err := m.joinCatalog(ctx); err != nil {
		return err
	}
	if m.prepareActivity != nil {
		m.prepareActivity.release()
	}
	m.owner.activities.candidate.CompareAndSwap(m, nil)
	return nil
}

func (m *RouterNodeChainExecutionCandidateMeasurement) joinCatalog(ctx context.Context) error {
	if err := adapter.RouterVPNLockContext(ctx, &m.observation); err != nil {
		return err
	}
	defer m.observation.Unlock()
	if m.pending != nil {
		select {
		case <-m.pending.done:
			m.pending = nil
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return ctx.Err()
}
