const routerNodeChainMultipleImportedExecutionLaunchKind = "routervpn-node-chain-multiple-imported-execution-preparation-input"

type routerNodeMultipleImportedExecutionServerKey struct{}
type routerNodeMultipleImportedExecutionServerOwner struct {
	self          *routerNodeMultipleImportedExecutionServerOwner
	plan          *RouterNodeChainExecution
	preparation   *mobilemultihop.NodeChainExecutionPreparation
	source        *mobilemultihop.NodeChain
	registry      *outbound.Registry
	server        *CommandServer
	started       *daemon.StartedService
	externalFinal bool
}

// The sealed Local envelope remains original; its projection is never stripped.
func RouterNodeChainMultipleImportedExecutionFromLaunch(input, execution string) (*RouterNodeChainExecution, error) {
	return routerNodeImportedExecutionFromLaunch(input, execution, mobilemultihop.NewNodeChainMultipleImportedExecutionPreparation)
}

func routerNodeImportedExecutionFromLaunch(input, execution string, prepare func(*mobilemultihop.NodeChain, string) (*mobilemultihop.NodeChainExecutionPreparation, error)) (*RouterNodeChainExecution, error) {
	original, err := mobilemultihop.ParseNodeChainLaunchInput(input)
	if err != nil {
		return nil, err
	}
	prep, err := prepare(original, execution)
	if err != nil {
		return nil, err
	}
	return &RouterNodeChainExecution{prep: prep}, nil
}
func NewRouterNodeChainMultipleImportedExecutionLaunch(input string) (*RouterNodeChainExecution, error) {
	return routerNodeImportedExecutionLaunch(input, routerNodeChainMultipleImportedExecutionLaunchKind, mobilemultihop.ParseNodeChainMultipleImportedExecutionPreparation)
}

func routerNodeImportedExecutionLaunch(input, kind string, parse func(string) (*mobilemultihop.NodeChainExecutionPreparation, error)) (*RouterNodeChainExecution, error) {
	if len(input) == 0 || len(input) > mobilemultihop.NodeChainInputLimit {
		return nil, errRouterNodeChainExecution
	}
	var launch routerNodeChainExecutionLaunch
	if json.Unmarshal([]byte(input), &launch) != nil || launch.Kind != kind || (launch.Schema != 1 && launch.Schema != 2) {
		return nil, errRouterNodeChainExecution
	}
	prep, err := parse(launch.Source)
	if err != nil {
		return nil, err
	}
	m := &RouterNodeChainExecution{prep: prep}
	if m.SourceSHA256() != launch.SourceSHA256 || m.ConfigSHA256() != launch.ConfigSHA256 {
		return nil, errRouterNodeChainExecution
	}
	if launch.Schema == 2 {
		last, e := mobilemultihop.ParseNodeChainExecutionLast(launch.Last, prep)
		if e != nil {
			return nil, e
		}
		m.last = &last
	} else if launch.Last != "" {
		return nil, errRouterNodeChainExecution
	}
	canonical, err := m.LaunchInput()
	if err != nil || canonical != input {
		return nil, errRouterNodeChainExecution
	}
	return m, nil
}
func RouterNodeChainMultipleImportedExecutionFromLast(input, execution, lastJSON string) (*RouterNodeChainExecution, error) {
	m, err := RouterNodeChainMultipleImportedExecutionFromLaunch(input, execution)
	return routerNodeImportedExecutionFromLast(m, err, lastJSON)
}

func routerNodeImportedExecutionFromLast(m *RouterNodeChainExecution, err error, lastJSON string) (*RouterNodeChainExecution, error) {
	if err != nil {
		return nil, err
	}
	last, err := mobilemultihop.ParseNodeChainExecutionLast(lastJSON, m.prep)
	if err != nil {
		return nil, err
	}
	m.last = &last
	return m, nil
}

// The typed execution plan creates the exact caller-local registry and binds
// the preparation before the host receives an otherwise ordinary CommandServer.
// The host must retain this returned handle, BindNative, then Start it.
func (m *RouterNodeChainExecution) newImportedCommandServer(handler CommandServerHandler, platform PlatformInterface, externalFinal bool) (*CommandServer, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	if m == nil || m.prep == nil || handler == nil || platform == nil {
		return nil, errRouterNodeChainExecution
	}
	if externalFinal != m.prep.RequiresExternalFinalExecutionObserver() || !externalFinal && (!m.prep.RequiresMultipleImportedExecutionObserver() || m.prep.RequiresDesktopMultipleImportedExecutionObserver()) {
		return nil, errRouterNodeChainExecution
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.mu); err != nil {
		return nil, err
	}
	defer m.mu.Unlock()
	if m.retired.Load() || m.started || m.native.Load() != nil || m.state.Load() != nil || m.multipleServer.Load() != nil || m.openvpnServer.Load() != nil || m.connectServer.Load() != nil || m.socksServer.Load() != nil {
		return nil, errRouterNodeChainExecution
	}
	source, err := m.originalImportedExecutionSource(externalFinal)
	if err != nil {
		return nil, err
	}
	native := baseContext(platform)
	registry := include.OutboundRegistry()
	native = service.ContextWith[option.OutboundOptionsRegistry](native, registry)
	native = service.ContextWith[adapter.OutboundRegistry](native, registry)
	if externalFinal {
		native, err = box.RouterVPNNodeExternalFinalExecutionContext(native, m.prep)
	} else {
		native, err = box.RouterVPNNodeMultipleImportedExecutionContext(native, m.prep)
	}
	if err != nil {
		return nil, err
	}
	owner := &routerNodeMultipleImportedExecutionServerOwner{plan: m, preparation: m.prep, source: source, registry: registry, externalFinal: externalFinal}
	owner.self = owner
	native = context.WithValue(native, routerNodeMultipleImportedExecutionServerKey{}, owner)
	server := newCommandServerWithContext(handler, platform, native)
	owner.server, owner.started = server, server.StartedService
	m.multipleServer.Store(owner)
	return server, nil
}
func RouterNodeChainMultipleImportedExecutionNewCommandServer(m *RouterNodeChainExecution, handler CommandServerHandler, platform PlatformInterface) (*CommandServer, error) {
	if m == nil {
		return nil, errRouterNodeChainExecution
	}
	return m.newImportedCommandServer(handler, platform, false)
}
func (m *RouterNodeChainExecution) requireMultipleImportedServer(ctx context.Context, server *CommandServer) error {
	if m == nil || ctx == nil || ctx.Err() != nil {
		return errRouterNodeChainExecution
	}
	if m.prep == nil {
		if m.multipleServer.Load() != nil {
			return errRouterNodeChainExecution
		}
		return nil // Existing untyped instance readback grants no preparation authority.
	}
	externalFinal := m.prep.RequiresExternalFinalExecutionObserver()
	if !externalFinal && !m.prep.RequiresMultipleImportedExecutionObserver() {
		if m.multipleServer.Load() != nil {
			return errRouterNodeChainExecution
		}
		return nil
	}
	owner := m.multipleServer.Load()
	if owner == nil || owner.externalFinal != externalFinal || owner.self != owner || owner.plan != m || owner.preparation != m.prep || server == nil || server.ctx == nil || owner.server != server || owner.started == nil || server.StartedService != owner.started || server.ctx.Value(routerNodeMultipleImportedExecutionServerKey{}) != owner || service.FromContext[adapter.OutboundRegistry](server.ctx) != owner.registry || service.FromContext[option.OutboundOptionsRegistry](server.ctx) != owner.registry {
		return errRouterNodeChainExecution
	}
	original, err := m.originalImportedExecutionSource(externalFinal)
	if err != nil || original != owner.source {
		return errors.Join(err, errRouterNodeChainExecution)
	}
	return ctx.Err()
}

func (m *RouterNodeChainExecution) originalImportedExecutionSource(externalFinal bool) (*mobilemultihop.NodeChain, error) {
	if externalFinal {
		return m.prep.OriginalExternalFinalSource()
	}
	return m.prep.OriginalMultipleImportedSource()
}
