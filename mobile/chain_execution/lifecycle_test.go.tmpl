type executionBridgeEngineBoundary struct {
	routerNodeChainExecutionEngine
	retire func(context.Context) error
}

func executionBridgeReservedService(t *testing.T, m *RouterNodeChainExecution) *CommandServer {
	t.Helper()
	ctx := box.Context(service.ContextWith[adapter.PlatformInterface](context.Background(), &executionBridgePlatform{}), include.InboundRegistry(), include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
	service := daemon.NewStartedService(daemon.ServiceOptions{Context: ctx, LogMaxLines: 16})
	server := &CommandServer{StartedService: service, ctx: ctx}
	if err := m.BindNative(server); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = m.Close(); _ = service.CloseService(); service.Close() })
	return server
}

const executionBridgeEmptyNativeConfig = `{"log":{"disabled":true},"outbounds":[{"type":"direct","tag":"direct"}]}`

