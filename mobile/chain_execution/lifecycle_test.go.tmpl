func executionBridgeNativeFixture(t *testing.T) (*RouterNodeChainExecution, *routerNodeChainExecutionState) {
	t.Helper()
	owner, _, _ := routerMTUContextFixture(t)
	owner.server.ctx = context.Background()
	lifetime, cancel := context.WithCancel(owner.server.ctx)
	t.Cleanup(cancel)
	m := &RouterNodeChainExecution{}
	state := &routerNodeChainExecutionState{server: owner.server, service: owner.server.StartedService, instance: owner.instance, box: owner.instance.Box(), lifetime: lifetime, cancel: cancel, runDone: make(chan struct{})}
