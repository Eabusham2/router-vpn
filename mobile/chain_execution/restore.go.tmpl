package libbox

import (
	"context"
	"sync/atomic"
	"time"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

// This capture is process-owned authority, never a JSON receipt or saved
// profile. Its original proof choice and original native teardown must join
// before one replacement can receive it. Durable Last is a separate API.
type RouterNodeChainExecutionRestoreCapture struct {
	owner       *RouterNodeChainExecution
	state       *routerNodeChainExecutionState
	controller  *routerNodeChainExecutionControllerRef
	engine      *routerNodeChainExecutionEngineRef
	native      *routerNodeChainExecutionNative
	mobile      mobilemultihop.NodeChainExecutionMobileRestoreCapture
	claimed     atomic.Bool
	replacement atomic.Pointer[routerNodeChainExecutionRestoreReplacement]
}

type routerNodeChainExecutionRestoreReplacement struct {
	owner       *RouterNodeChainExecution
	preparation *mobilemultihop.NodeChainExecutionPreparation
}

// The host calls this only after its original native Close. Execution.Close
// alone never proves native teardown, and an uncaptured owner grants no such
// receipt. A pure never-started capture is discarded by the host separately.
func (m *RouterNodeChainExecution) NativeClosed() bool {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	return m.nativeClosedContext(ctx) == nil
}

func (m *RouterNodeChainExecution) nativeClosedContext(ctx context.Context) error {
	if m == nil || ctx == nil || !m.retired.Load() || !m.closed.Load() {
		return errRouterNodeChainExecution
	}
	state := m.state.Load()
	native := m.native.Load()
	if native == nil || native.server == nil || native.service == nil || native.server.StartedService != native.service || native.capture == nil {
		return errRouterNodeChainExecution
	}
	if state != nil && (state.server != native.server || state.service != native.service || !native.capture.Owns(state.instance, state.box)) {
		return errRouterNodeChainExecution
	}
	if err := native.capture.ClosedContext(ctx); err != nil {
		return err
	}
	if m.state.Load() != state || m.native.Load() != native || !m.retired.Load() || !m.closed.Load() {
		return errRouterNodeChainExecution
	}
	return ctx.Err()
}

func (m *RouterNodeChainExecution) CaptureRestore() (*RouterNodeChainExecutionRestoreCapture, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	state, controller, runtime, err := m.executionRuntimeContext(ctx)
	if err != nil {
		return nil, err
	}
	engine, native := state.engine.Load(), m.native.Load()
	if engine == nil || native == nil || native.server != state.server || native.service != state.service ||
		native.capture == nil || !native.capture.Owns(state.instance, state.box) {
		return nil, errRouterNodeChainExecution
	}
	capture, err := runtime.CaptureMobileRestoreContext(ctx)
	if err != nil {
		return nil, err
	}
	if m.nativeCurrent(ctx, state) != nil || state.controller.Load() != controller || state.engine.Load() != engine || m.native.Load() != native {
		return nil, errRouterNodeChainExecution
	}
	retained := &RouterNodeChainExecutionRestoreCapture{owner: m, state: state, controller: controller, engine: engine, native: native, mobile: capture}
	for {
		original := m.restoreCapture.Load()
		if original != nil && original.claimed.Load() {
			return nil, errRouterNodeChainExecution
		}
		if original != nil && original.state == state && original.controller == controller && original.engine == engine && original.native == native {
			retained = original
			break
		}
		// A subsequent authorized MTU generation may capture its own actual
		// readback. The old unclaimed capsule loses authority; it is never
		// silently relabeled with the new reader or effective MTU.
		if m.restoreCapture.CompareAndSwap(original, retained) {
			break
		}
	}
	if retained.owner != m || retained.claimed.Load() || m.restoreCapture.Load() != retained ||
		m.nativeCurrent(ctx, state) != nil || state.controller.Load() != controller || state.engine.Load() != engine || m.native.Load() != native {
		return nil, errRouterNodeChainExecution
	}
	return retained, nil
}

func (c *RouterNodeChainExecutionRestoreCapture) originalNativeJoined(ctx context.Context) error {
	if c == nil || ctx == nil || c.owner == nil || c.state == nil || c.controller == nil || c.engine == nil || c.native == nil ||
		c.owner.restoreCapture.Load() != c || c.owner.state.Load() != c.state || c.owner.native.Load() != c.native ||
		c.state.controller.Load() != c.controller || c.state.engine.Load() != c.engine ||
		!c.owner.closed.Load() || !c.owner.retired.Load() || c.state.instance == nil || c.state.box == nil {
		return errRouterNodeChainExecution
	}
	// Native reader retirement and shared remote join do not substitute the
	// original daemon Instance.Close return value. Require all three owners.
	if err := c.owner.nativeClosedContext(ctx); err != nil {
		return err
	}
	return ctx.Err()
}

func (c *RouterNodeChainExecutionRestoreCapture) originalJoined(ctx context.Context) error {
	if err := c.originalNativeJoined(ctx); err != nil {
		return err
	}
	if _, err := c.mobile.SourceContext(ctx); err != nil {
		return err
	}
	return ctx.Err()
}

func NewRouterNodeChainExecutionRestore(capture *RouterNodeChainExecutionRestoreCapture) (*RouterNodeChainExecution, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	if err := capture.originalJoined(ctx); err != nil {
		return nil, err
	}
	preparation, err := capture.mobile.NewPreparationContext(ctx)
	if err != nil {
		return nil, err
	}
	if preparation.Source() != capture.owner.Source() || preparation.LocalSourceSHA256() != capture.owner.LocalSourceSHA256() ||
		preparation.Execution() != capture.owner.RequestedExecution() {
		return nil, errRouterNodeChainExecution
	}
	if _, err := preparation.MobileRestoreReadback(); err != nil {
		return nil, err
	}
	if err := capture.originalJoined(ctx); err != nil {
		return nil, err
	}
	if !capture.claimed.CompareAndSwap(false, true) {
		return nil, errRouterNodeChainExecution
	}
	m := &RouterNodeChainExecution{prep: preparation, restore: capture}
	capture.replacement.Store(&routerNodeChainExecutionRestoreReplacement{owner: m, preparation: preparation})
	return m, nil
}

// RequireRestore validates a process-owned returned plan. Its actual Config
// may differ at the captured TUN MTU; equality with the old initial Config is
// not proof. No serialized launch, scalar MTU or matching source can recreate
// this exact capsule-to-preparation-to-object relationship.
func (m *RouterNodeChainExecution) RequireRestore(capture *RouterNodeChainExecutionRestoreCapture) error {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	if m == nil || capture == nil || capture.owner == nil || m.restore != capture || !capture.claimed.Load() || m.retired.Load() || m.closed.Load() {
		return errRouterNodeChainExecution
	}
	replacement := capture.replacement.Load()
	if replacement == nil || replacement.owner != m || replacement.preparation != m.prep || m.prep == nil ||
		m.Source() != capture.owner.Source() || m.LocalSourceSHA256() != capture.owner.LocalSourceSHA256() ||
		m.RequestedExecution() != capture.owner.RequestedExecution() {
		return errRouterNodeChainExecution
	}
	if _, err := m.prep.MobileRestoreReadback(); err != nil {
		return err
	}
	if err := capture.originalJoined(ctx); err != nil {
		return err
	}
	if capture.replacement.Load() != replacement || m.retired.Load() || m.closed.Load() {
		return errRouterNodeChainExecution
	}
	return ctx.Err()
}
