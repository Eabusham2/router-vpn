type executionFactoryDNS struct{ dns.TransportAdapter }

func (*executionFactoryDNS) Start(adapter.StartStage) error { return nil }
func (*executionFactoryDNS) Close() error                   { return nil }
func (*executionFactoryDNS) Reset()                         {}
func (*executionFactoryDNS) Exchange(ctx context.Context, request *mdns.Msg) (*mdns.Msg, error) {
	if ctx.Err() != nil || len(request.Question) != 1 || request.Question[0].Qtype != mdns.TypeA {
		return nil, errRouterNodeChainExecution
	}
	answer := new(mdns.Msg)
	answer.SetReply(request)
	answer.Answer = []mdns.RR{&mdns.A{Hdr: mdns.RR_Header{Name: request.Question[0].Name, Rrtype: mdns.TypeA, Class: mdns.ClassINET, Ttl: 30}, A: net.IP{93, 184, 216, 34}}}
	return answer, nil
}
func (d *executionFactoryDNS) ExchangeAsync(ctx context.Context, request *mdns.Msg, callback func(*mdns.Msg, error)) {
	answer, err := d.Exchange(ctx, request)
	callback(answer, err)
}

// The Manager still validates full original captures/receipts. These explicit
// remote worker observations do not stand in for an encrypted Server worker.
type executionFactoryRemoteWorker struct {
	candidate    *executionFactoryPacketCandidate
	capture      multihoprelay.NodeChainCapture
	alive, ready atomic.Bool
	sequence     atomic.Uint64
	proofAt      atomic.Int64
}

func (w *executionFactoryRemoteWorker) Alive() bool { return w.alive.Load() }
func (w *executionFactoryRemoteWorker) Stop(ctx context.Context) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	w.alive.Store(false)
	return nil
}
func (w *executionFactoryRemoteWorker) Bootstrap(ctx context.Context) error {
	if ctx.Err() != nil || !w.alive.Load() {
		return errors.Join(ctx.Err(), errRouterNodeChainExecution)
	}
	w.proofAt.Store(time.Now().UnixMilli())
	w.ready.Store(true)
	return nil
}
func (w *executionFactoryRemoteWorker) Snapshot(ctx context.Context, nonce string) (multihoprelay.NodeChainReceipt, error) {
	c := w.capture
	digest, err := c.Digest()
	if err != nil || ctx.Err() != nil || !w.alive.Load() {
		return multihoprelay.NodeChainReceipt{}, errors.Join(err, ctx.Err(), errRouterNodeChainExecution)
	}
	r := multihoprelay.NodeChainReceipt{Schema: 1, SessionID: c.Request.SessionID, OwnerID: c.OwnerID,
		Peer: c.Peer, SourceSHA256: c.Source.SourceSHA256, RegistrySHA256: c.RegistrySHA256,
		DNSPolicySHA256: c.Source.DNSPolicySHA256, CaptureSHA256: digest, Nonce: nonce,
		Sequence: w.sequence.Add(1), HeartbeatAt: time.Now().UnixMilli(), Phase: multihoprelay.NodeChainPending, FrontReady: true}
	if w.ready.Load() {
		r.Phase, r.TrafficAllowed, r.DNSProven, r.PublicProven, r.ProofAt = multihoprelay.NodeChainReady, true, true, true, w.proofAt.Load()
		for _, member := range c.Source.Members {
			r.Prefixes = append(r.Prefixes, multihoprelay.NodeChainPrefixReceipt{Position: member.Position, ProfileID: member.ProfileID,
				NodeID: member.NodeID, Mode: member.Mode, Proven: true, ResponseMS: 1.5, NodeKind: member.NodeKind,
				ProofKind: member.ProofKind, SourceSHA256: member.SourceSHA256})
		}
	}
	return r, nil
}

type executionFactoryRemoteRunner struct {
	candidate *executionFactoryPacketCandidate
	mu        sync.Mutex
	workers   []*executionFactoryRemoteWorker
	refresh   atomic.Int64
}

func (*executionFactoryRemoteRunner) Start(context.Context, []byte, multihoprelay.Lease) (multihoprelay.Process, error) {
	return nil, errors.New("ordinary worker fallback forbidden")
}
func (r *executionFactoryRemoteRunner) StartChain(ctx context.Context, capture multihoprelay.NodeChainCapture) (multihoprelay.NodeChainProcess, error) {
	if err := capture.Validate(); err != nil || ctx.Err() != nil {
		return nil, errors.Join(err, ctx.Err())
	}
	worker := &executionFactoryRemoteWorker{capture: capture.Clone(), candidate: r.candidate}
	worker.alive.Store(true)
	r.mu.Lock()
	r.workers = append(r.workers, worker)
	r.mu.Unlock()
	return worker, nil
}
func (r *executionFactoryRemoteRunner) position(user, password string) int {
	r.mu.Lock()
	defer r.mu.Unlock()
	for _, worker := range r.workers {
		if !worker.Alive() || !worker.ready.Load() {
			continue
		}
		for _, original := range worker.capture.Request.Users {
			if original.Username == user && original.Password == password {
				return original.Position
			}
		}
	}
	return -1
}
func (r *executionFactoryRemoteRunner) maintain(ctx context.Context) {
	ticker := time.NewTicker(5 * time.Second)
	defer ticker.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			r.mu.Lock()
			workers := append([]*executionFactoryRemoteWorker(nil), r.workers...)
			r.mu.Unlock()
			for _, worker := range workers {
				if worker.Alive() && worker.ready.Load() && worker.Bootstrap(ctx) == nil {
					r.refresh.Add(1)
				}
			}
		}
	}
}

