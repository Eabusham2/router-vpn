		}
		if f.multiple != nil && f.multiple.peers[position] != nil {
			return shadowsocks.NewOutbound(ctx, router, logger, tag, opts)
		}
		return &executionFactoryPrefix{Adapter: outbound.NewAdapter(C.TypeShadowsocks, tag, []string{"tcp", "udp"}, nil), fixture: f, position: position}, nil
	})
	dns.RegisterTransport[option.RemoteDNSServerOptions](resolvers, C.DNSTypeUDP, func(_ context.Context, _ log.ContextLogger, tag string, options option.RemoteDNSServerOptions) (adapter.DNSTransport, error) {
		return &executionFactoryDNS{dns.NewTransportAdapterWithRemoteOptions(C.DNSTypeUDP, tag, options)}, nil
	})
	if specialized != nil {
		f.server = specialized
	} else {
		ctx := box.Context(service.ContextWith[adapter.PlatformInterface](f.ctx, &executionFactoryPlatform{}), ins, outs, ends, resolvers, boxService.NewRegistry(), certificate.NewRegistry())
		started := daemon.NewStartedService(daemon.ServiceOptions{Context: ctx, LogMaxLines: 16})
		f.server = &CommandServer{StartedService: started, ctx: ctx}
	}
	started, ctx := f.server.StartedService, f.server.ctx
