// Compile complete original Local bytes and a distinct server packet identity.
// All source/profile/proof validation is the shipping compiler's work.
func executionFactorySources(t *testing.T, execution string) (*RouterNodeChainExecution, *mobilemultihop.NodeChainServerPolicy) {
	t.Helper()
	raw, _ := executionBridgeSource(t, execution)
	owner, err := NewRouterNodeChainExecution(raw, execution)
	if err != nil {
		t.Fatal(err)
	}
	var local mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(raw), &local) != nil {
		t.Fatal("original full Local source missing")
	}
	proofs := owner.prep.ProofInventory()
	source := mobilemultihop.NodeChainServerSource{Schema: 1, EntryID: proofs[0].ProfileID, EntryNodeID: proofs[0].NodeID, EntryMode: proofs[0].Mode}
	for position, input := range local.Nodes {
		if position == 0 {
			continue
		}
		var row struct {
			Mode      string `json:"mode"`
			Files     string `json:"files"`
			Profile   string `json:"profile_json"`
			Start     string `json:"start"`
			Bootstrap string `json:"dns_bootstrap"`
		}
		if json.Unmarshal([]byte(input), &row) != nil {
			t.Fatal("full member input missing")
		}
		identity := local.IdentitySources[position]
		if row.Mode == "wg" {
			var files map[string]string
			if json.Unmarshal([]byte(row.Files), &files) != nil {
				t.Fatal("original packet assets missing")
			}
			config, err := base64.StdEncoding.DecodeString(files["wg.conf"])
			if err != nil {
				t.Fatal(err)
			}
			old := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(20 + position)}, 32))
			next := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(220 + position)}, 32))
			if strings.Count(string(config), old) != 1 {
				t.Fatal("original distinct packet key unavailable")
			}
			files["wg.conf"] = base64.StdEncoding.EncodeToString([]byte(strings.Replace(string(config), old, next, 1)))
			row.Files = executionBridgeJSON(t, files)
			node, err := mobilemultihop.NewNodeProfile(row.Mode, row.Files, row.Profile, row.Start, row.Bootstrap)
			if err != nil {
				t.Fatal(err)
			}
			input, err = node.LaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			identity = row.Files
		}
		source.Nodes = append(source.Nodes, input)
		source.IdentitySources = append(source.IdentitySources, identity)
	}
	policy, err := mobilemultihop.NewNodeChainServerPolicy(executionBridgeJSON(t, source))
	if err != nil {
		t.Fatal("original server source", err)
	}
	return owner, policy
}

func executionFactoryPublicTLS(t *testing.T) (*httptest.Server, *tls.Config) {
	t.Helper()
	public, private, err := ed25519.GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	certificate := &x509.Certificate{SerialNumber: big.NewInt(29), NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
		IPAddresses: []net.IP{net.ParseIP("1.1.1.1"), net.ParseIP("1.0.0.1")}, IsCA: true, BasicConstraintsValid: true,
		KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
	der, err := x509.CreateCertificate(rand.Reader, certificate, certificate, public, private)
	if err != nil {
		t.Fatal(err)
	}
	root, err := x509.ParseCertificate(der)
	if err != nil {
		t.Fatal(err)
	}
	roots := x509.NewCertPool()
	roots.AddCert(root)
	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method != "GET" || r.Host != "1.1.1.1" && r.Host != "1.0.0.1" || r.URL.Path != "/cdn-cgi/trace" ||
			len(r.URL.Query().Get("routervpn_proof")) != 32 || r.Header.Get("Authorization") != "" {
			http.Error(w, "unowned public proof", 403)
			return
		}
		_, _ = io.WriteString(w, "ip=203.0.113.88\n")
	}))
	server.TLS = &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: private}}, MinVersion: tls.VersionTLS12}
	server.StartTLS()
	t.Cleanup(server.Close)
	return server, &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}
}

func newExecutionFactoryLiveFixture(t *testing.T, outcome string) *executionFactoryLiveFixture {
	t.Helper()
	return executionFactoryLive(t, outcome, nil)
}
func executionFactoryLive(t *testing.T, outcome string, multiple *executionFactoryMultipleImported) *executionFactoryLiveFixture {
	t.Helper()
	execution := "server"
	if strings.HasPrefix(outcome, "compare-") {
		execution = "auto"
	}
	var owner *RouterNodeChainExecution
	var policy *mobilemultihop.NodeChainServerPolicy
	if multiple == nil {
		owner, policy = executionFactorySources(t, execution)
	} else {
		owner, policy = multiple.sources(t, execution)
	}
	f := &executionFactoryLiveFixture{owner: owner, prep: owner.prep, serverPolicy: policy, outcome: outcome, multiple: multiple}
	// The original native service outlives testing.T cancellation until its
	// registered cleanup joins the controller and daemon in that order.
	f.ctx, f.cancel = context.WithCancel(context.Background())
	f.current.Store(true)
	var local mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(f.prep.LocalSource()), &local) != nil {
		t.Fatal("original full source unavailable")
	}
	var graph map[string]any
	if json.Unmarshal([]byte(f.prep.Config()), &graph) != nil {
		t.Fatal("original preparation graph missing")
	}
	for _, value := range graph["endpoints"].([]any) {
		row := value.(map[string]any)
		if row["tag"] != f.prep.ProofInventory()[0].Tag {
			continue
		}
		for _, value := range row["address"].([]any) {
			prefix, err := netip.ParsePrefix(value.(string))
			if err == nil && prefix.Addr().Is4() {
				if f.peer.IsValid() {
					t.Fatal("ambiguous captured entry peer")
				}
				f.peer = prefix.Addr()
			}
		}
	}
	discovery, err := f.prep.Discovery()
	if err != nil || !f.peer.IsValid() {
		t.Fatal("original discovery capture unavailable", err)
	}
	api, err := url.Parse(discovery.API)
	if err != nil {
		t.Fatal(err)
	}
	f.frontHost = api.Hostname()
	ttl := 15
	if multiple != nil && multiple.candidate != nil {
		f.runner.candidate = multiple.candidate
		ttl = 90 // Normal provisioned lease for the complete fifty-connection operation.
	}
	f.manager, err = multihoprelay.New(multihoprelay.Config{ListenIP: f.frontHost, FirstPort: 32000, LastPort: 32000, TTLSeconds: ttl, NodeChains: []multihoprelay.NodeChainDescriptor{policy.Descriptor()}}, policy.Descriptor().EntryNodeID, &f.runner)
	if err != nil {
		t.Fatal(err)
	}
	public, trust := executionFactoryPublicTLS(t)
	f.public, f.trust = public.Listener.Addr().String(), trust
	if multiple != nil {
		multiple.start(t, f, public.TLS.Certificates[0])
	}
	proofs := f.prep.ProofInventory()
	for position, input := range local.Nodes {
		if multiple != nil && multiple.peers[position] != nil {
			f.private = append(f.private, "")
			f.privateAddress = append(f.privateAddress, "")
			continue
		}
		var row, profile map[string]any
		if json.Unmarshal([]byte(input), &row) != nil || json.Unmarshal([]byte(row["profile_json"].(string)), &profile) != nil {
			t.Fatal("original private proof source missing")
		}
		api, err := url.Parse(profile["router_api"].(string))
		if err != nil || api.Host == "" {
			t.Fatal("original private proof address missing")
		}
		token := profile["api_token"].(string)
		endpoint := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if r.Host != api.Host || r.Header.Get("Authorization") != "Bearer "+token || r.Header.Get("Cache-Control") != "no-store" || r.Header.Get("Accept-Encoding") != "identity" {
				http.Error(w, "unowned private proof", 403)
				return
			}
			if position == 0 && f.multiple != nil && f.multiple.candidate != nil && r.URL.Path == "/api/multihop/chain/candidate" {
				f.multiple.candidate.control(f, w, r)
				return
			}
			if position == 0 && r.URL.Path == "/api/multihop/chain/lease" {
				f.serveControl(w, r)
				return
			}
			if r.Method != "GET" || r.URL.Path != "/health" {
				http.Error(w, "unowned private path", 400)
				return
			}
			_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "node_id": proofs[position].NodeID, "proof": "router-vpn-private-agent-v1"})
		}))
		t.Cleanup(endpoint.Close)
		f.private, f.privateAddress = append(f.private, endpoint.Listener.Addr().String()), append(f.privateAddress, api.Host)
	}
	f.front, err = net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	last := local.Nodes[len(local.Nodes)-1]
	var row struct {
		Mode      string `json:"mode"`
		Files     string `json:"files"`
		Profile   string `json:"profile_json"`
		Start     string `json:"start"`
		Bootstrap string `json:"dns_bootstrap"`
	}
	if json.Unmarshal([]byte(last), &row) != nil {
		t.Fatal("original candidate missing")
	}
	candidate, err := mobilemultihop.NewNodeProfile(row.Mode, row.Files, row.Profile, row.Start, row.Bootstrap)
	if err != nil {
		t.Fatal(err)
	}
	f.targetID, f.targetSHA = proofs[len(proofs)-1].ProfileID, candidate.SourceSHA256()
	f.inventory = executionBridgeJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-mobile-selected-factory-1", Inputs: []string{last}})
	f.wg.Add(2)
	go func() { defer f.wg.Done(); f.runner.maintain(f.ctx) }()
	go func() {
		defer f.wg.Done()
		for {
			conn, err := f.front.Accept()
			if err != nil {
				return
			}
			f.connections.Store(conn, true)
			f.wg.Add(1)
			go func() { defer f.wg.Done(); defer f.connections.Delete(conn); defer conn.Close(); f.serveSOCKS(conn) }()
		}
	}()
	t.Cleanup(func() {
		cleanup, cancel := context.WithTimeout(context.Background(), 8*time.Second)
		defer cancel()
		if f.owner.state.Load() != nil || f.owner.native.Load() != nil {
			if err := f.owner.closeContext(cleanup); err != nil {
				t.Error("original mobile execution failed to join", err)
			}
		}
		if err := f.manager.Close(cleanup); err != nil {
			t.Error("original lease Manager failed to join", err)
		}
		if f.server != nil {
			if err := f.server.CloseService(); err != nil {
				t.Error("original daemon Box failed to close", err)
			}
			if !f.owner.NativeClosed() {
				t.Error("actual native construction lacked joined close receipt")
			}
			if f.multiple != nil {
				f.server.Close()
			} else {
				f.server.StartedService.Close()
			}
		}
		f.current.Store(false)
		f.cancel()
		_ = f.front.Close()
		f.connections.Range(func(key, _ any) bool { _ = key.(net.Conn).Close(); return true })
		done := make(chan struct{})
		go func() { f.wg.Wait(); close(done) }()
		select {
		case <-done:
		case <-cleanup.Done():
			t.Error("original fixture network did not join")
		}
	})
	f.constructNative(t)
	// Keep runWithFactory's actual lifecycle and concrete Box constructor. The
	// existing current callback supplies only fixture TLS trust before Run's first
	// ObserveChainContext; it never changes selected/native authority.
	if f.multiple != nil {
		err = f.owner.Run(f.server)
		if state := f.owner.state.Load(); err == nil && state != nil && state.engine.Load() != nil {
			f.nativeEngine, _ = state.engine.Load().value.(*box.RouterVPNNodeChainExecutionEngine)
		}
	} else {
		err = f.owner.runWithFactory(f.server, func(ctx context.Context, b *box.Box, prep *mobilemultihop.NodeChainExecutionPreparation, session string, current func(context.Context) error) (routerNodeChainExecutionEngine, error) {
			if b != f.instance || prep != f.prep {
				return nil, errRouterNodeChainExecution
			}
			observed := func(call context.Context) error {
				if err := current(call); err != nil {
					return err
				}
				state := f.owner.state.Load()
				if state != nil {
					if ref := state.controller.Load(); ref != nil {
						controller, ok := ref.value.(*mobilemultihop.NodeChainExecutionRuntime)
						if !ok || controller == nil {
							return errRouterNodeChainExecution
						}
						f.trustOnce.Do(func() { *executionFactoryNativeField[*tls.Config](t, controller, "testTLS") = f.trust })
					}
				}
				return current(call)
			}
			engine, err := b.RouterVPNNewNodeChainExecutionEngine(ctx, prep, session, observed)
			if engine != nil {
				f.nativeEngine = engine
			}
			return engine, err
		})
	}
	if err != nil {
		t.Fatal("actual mobile selected execution Run", err)
	}
	state := f.owner.state.Load()
	if state == nil || state.owner != f.owner || state.server != f.server || state.box != f.instance || state.engine.Load() == nil || state.engine.Load().value != f.nativeEngine {
		t.Fatal("Run did not retain actual native construction")
	}
	progress := state.controller.Load().value.Progress()
	if !progress.Ready || progress.Execution != strings.TrimPrefix(outcome, "compare-") || strings.HasPrefix(outcome, "compare-") && (f.refused.Load() == 0 || len(progress.Comparison.Measurements) != 2) {
		t.Fatal("actual selected winner changed", progress.Execution)
	}
	return f
}

