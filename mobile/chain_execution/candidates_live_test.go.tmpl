	outbound.Register[option.ShadowsocksOutboundOptions](outs, C.TypeShadowsocks, func(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, opts option.ShadowsocksOutboundOptions) (adapter.Outbound, error) {
