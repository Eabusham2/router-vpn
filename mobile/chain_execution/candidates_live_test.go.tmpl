		t.Fatal("original native reservation", err)
	}
	if err := started.StartOrReloadService(ctx, f.prep.Config(), nil); err != nil {
		t.Fatal("actual daemon complete Box construction", err)
	}
	instance := started.Instance()
	if instance == nil || instance.Box() == nil {
		t.Fatal("actual native constructor returned no Box")
	}
	f.instance = instance.Box()
}

func (f *executionFactoryLiveFixture) dial(ctx context.Context, position int, server bool, address string) (net.Conn, error) {
	if ctx.Err() != nil || !f.current.Load() || position < 0 || position >= len(f.private) {
		return nil, errRouterNodeChainExecution
	}
	if position == 0 && address == net.JoinHostPort(f.frontHost, "32000") {
		return (&net.Dialer{}).DialContext(ctx, "tcp", f.front.Addr().String())
	}
	if f.multiple != nil {
		if candidate := f.multiple.candidate; candidate != nil && !server && position == 3 && address == candidate.destination {
			return (&net.Dialer{}).DialContext(ctx, "tcp", candidate.listener.Addr().String())
		}
		if position == 0 && address == f.multiple.peers[1].virtual {
			return (&net.Dialer{}).DialContext(ctx, "tcp", f.multiple.peers[1].socket)
		}
		if server && f.multiple.peers[position] != nil && address == "1.1.1.1:443" {
			return f.multiple.remoteDial(ctx, position, address)
		}
	}
	target := ""
	if address == f.privateAddress[position] {
		loser := position == len(f.private)-1 && (f.outcome == "compare-local" && server || f.outcome == "compare-server" && !server)
		if loser {
			f.refused.Add(1)
			return nil, errors.New("fixture refuses only losing final proof")
		}
		target = f.private[position]
	} else if position == len(f.private)-1 && (address == "1.1.1.1:443" || address == "1.0.0.1:443") {
		target = f.public
	}
	if target == "" {
		return nil, errors.New("uncaptured original prefix destination")
	}
	return (&net.Dialer{}).DialContext(ctx, "tcp", target)
}

func (f *executionFactoryLiveFixture) serveSOCKS(conn net.Conn) {
	_ = conn.SetDeadline(time.Now().Add(15 * time.Second))
	reader := bufio.NewReader(conn)
	greeting, err := socks5.ReadAuthRequest(reader)
	if err != nil || len(greeting.Methods) != 1 || greeting.Methods[0] != socks5.AuthTypeUsernamePassword ||
		socks5.WriteAuthResponse(conn, socks5.AuthResponse{Method: socks5.AuthTypeUsernamePassword}) != nil {
		return
	}
	auth, err := socks5.ReadUsernamePasswordAuthRequest(reader)
	if err == nil && f.multiple != nil && f.multiple.candidate != nil && f.multiple.candidate.front(f.ctx, conn, reader, auth.Username, auth.Password) {
		return
	}
	position := f.runner.position(auth.Username, auth.Password)
	if err != nil || position < 1 || socks5.WriteUsernamePasswordAuthResponse(conn, socks5.UsernamePasswordAuthResponse{Status: socks5.UsernamePasswordStatusSuccess}) != nil {
		return
	}
	request, err := socks5.ReadRequest(reader)
	if err != nil || request.Command != socks5.CommandConnect {
		return
	}
	upstream, err := f.dial(f.ctx, position, true, request.Destination.String())
	if err != nil {
		return
	}
	defer upstream.Close()
	if socks5.WriteResponse(conn, socks5.Response{ReplyCode: socks5.ReplyCodeSuccess, Bind: M.ParseSocksaddr("127.0.0.1:1234")}) != nil {
		return
	}
	_ = conn.SetDeadline(time.Time{})
	_ = upstream.SetDeadline(time.Now().Add(15 * time.Second))
	done := make(chan struct{})
	go func() { _, _ = io.Copy(upstream, reader); _ = upstream.Close(); close(done) }()
	_, _ = io.Copy(conn, upstream)
	_ = conn.Close()
	_ = upstream.Close()
	<-done
}

func (f *executionFactoryLiveFixture) serveControl(w http.ResponseWriter, r *http.Request) {
	if r.URL.RawQuery != "" {
		http.Error(w, "invalid query", 400)
		return
	}
	if r.Method == "GET" {
		challenge, sources, err := f.manager.ChainAvailable(f.peer)
		first, last, portErr := f.manager.ChainPortRange(f.peer)
		if err != nil || portErr != nil {
			http.Error(w, "unavailable", 503)
			return
		}
		_ = json.NewEncoder(w).Encode(mobilemultihop.NodeChainExecutionDiscovery{NodeID: f.prep.ProofInventory()[0].NodeID,
			Challenge: challenge, Sources: sources, FirstPort: first, LastPort: last})
		return
	}
	body, err := io.ReadAll(io.LimitReader(r.Body, 4097))
	if err != nil || len(body) > 4096 {
		http.Error(w, "invalid request", 400)
		return
	}
	request, nonce, err := multihoprelay.DecodeNodeChainLeaseRequest(body, r.Method == "POST")
	if err != nil {
		http.Error(w, "invalid original request", 400)
		return
	}
	switch r.Method {
	case "PUT":
		f.puts.Add(1)
		lease, err := f.manager.CreateChain(r.Context(), f.peer, request)
		if err == nil {
			_ = json.NewEncoder(w).Encode(lease)
			return
		}
	case "POST":
		status, err := f.manager.ChainStatus(r.Context(), f.peer, request, nonce)
		if err == nil {
			_ = json.NewEncoder(w).Encode(status)
			return
		}
	case "DELETE":
		f.deletes.Add(1)
		if err := f.manager.DeleteChain(r.Context(), f.peer, request); err == nil {
			_ = json.NewEncoder(w).Encode(map[string]any{"node_id": request.EntryNodeID, "session_id": request.SessionID, "stopped": true})
			return
		}
	}
	http.Error(w, "original Manager refused request", 502)
}

type executionFactoryCatalog struct {
	digest atomic.Value
	calls  atomic.Int64
}

func (c *executionFactoryCatalog) CurrentInventorySHA256() string {
	c.calls.Add(1)
	return c.digest.Load().(string)
}
func executionFactoryCatalogFor(inventory string) *executionFactoryCatalog {
	sum := sha256.Sum256([]byte(inventory))
	c := &executionFactoryCatalog{}
	c.digest.Store(hex.EncodeToString(sum[:]))
	return c
}

func executionFactoryMetadata(t *testing.T, f *executionFactoryLiveFixture, c *RouterNodeChainExecutionCandidateMeasurement, position int) {
	t.Helper()
	var value struct {
		Schema            int    `json:"schema"`
		Capture           string `json:"capture_sha256"`
		PrefixPosition    int    `json:"prefix_position"`
		PrefixID          string `json:"prefix_id"`
		PreparationSource string `json:"preparation_source_sha256"`
		PreparationConfig string `json:"preparation_config_sha256"`
		Source            string `json:"source_sha256"`
		Config            string `json:"config_sha256"`
		Requested         string `json:"requested_execution"`
		Execution         string `json:"execution"`
		Epoch             uint64 `json:"selection_epoch"`
		Targets           []struct {
			ID     string `json:"id"`
			Source string `json:"source_sha256"`
		} `json:"targets"`
	}
	projection := f.owner.state.Load().projection.Load()
	epoch, err := f.nativeEngine.SelectionEpochContext(t.Context())
	if err != nil || json.Unmarshal([]byte(c.Metadata()), &value) != nil || value.Schema != 1 || value.Capture == "" || value.Capture != c.CaptureSHA256() || value.PrefixPosition != position || value.PrefixID != f.prep.ProofInventory()[position].ProfileID || value.PreparationSource != f.prep.SourceSHA256() || value.PreparationConfig != f.prep.ConfigSHA256() || value.Source != projection.SourceSHA256() || value.Config != projection.ConfigSHA256() || value.Requested != f.prep.Execution() || value.Execution != strings.TrimPrefix(f.outcome, "compare-") || value.Epoch == 0 || value.Epoch != epoch || len(value.Targets) != 1 || value.Targets[0].ID != f.targetID || value.Targets[0].Source != f.targetSHA {
		t.Fatal("exported factory lost complete source or selected metadata", err, c.Metadata())
	}
}

func TestRouterNodeChainExecutionBridgeCandidateSelectedFactory(t *testing.T) {
	for _, outcome := range []string{"server", "compare-local", "compare-server"} {
		t.Run(outcome, func(t *testing.T) {
			f := newExecutionFactoryLiveFixture(t, outcome)
			state := f.owner.state.Load()
			controller := state.controller.Load()
			engine := state.engine.Load()
			projection := state.projection.Load()
			runtime, ok := controller.value.(*mobilemultihop.NodeChainExecutionRuntime)
			if !ok || runtime == nil {
				t.Fatal("actual selected controller missing")
			}
			before := executionBridgeJSON(t, runtime.Progress().Comparison)
			puts := f.puts.Load()
			epoch, err := f.nativeEngine.SelectionEpochContext(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			for _, position := range []int32{0, 1} {
				catalog := executionFactoryCatalogFor(f.inventory)
				candidate, err := RouterNodeChainExecutionNewCandidateMeasurement(f.owner, f.server, position, f.inventory, catalog)
				if err != nil || candidate == nil {
					t.Fatal("proved original exported candidate factory refused", position, err)
				}
				if f.owner.activities.candidate.Load() != candidate || candidate.self != candidate || candidate.service.Load() != nil || candidate.prepared.Load() || catalog.calls.Load() != 0 {
					t.Fatal("exported factory did not return its unique reservation before Prepare")
				}
				if candidate.Start("premature", f.targetID) == nil {
					t.Fatal("unprepared exported handle started work")
				}
				if next, err := RouterNodeChainExecutionNewCandidateMeasurement(f.owner, f.server, position, f.inventory, catalog); err == nil || next != nil || f.owner.activities.candidate.Load() != candidate || candidate.retired.Load() {
					t.Fatal("duplicate public factory stole original reservation")
				}
				copy := &RouterNodeChainExecution{prep: f.prep}
				copy.state.Store(state)
				if next, err := RouterNodeChainExecutionNewCandidateMeasurement(copy, f.server, position, f.inventory, catalog); err == nil || next != nil || state.lifetime.Err() != nil || f.owner.activities.candidate.Load() != candidate {
					t.Fatal("copied public owner changed original reservation")
				}
				foreign := &CommandServer{StartedService: f.server.StartedService, ctx: f.server.ctx}
				if next, err := RouterNodeChainExecutionNewCandidateMeasurement(f.owner, foreign, position, f.inventory, catalog); err == nil || next != nil || f.owner.activities.candidate.Load() != candidate {
					t.Fatal("foreign CommandServer borrowed original factory")
				}
				executionFactoryMetadata(t, f, candidate, int(position))
				if err := candidate.Prepare(); err != nil {
					t.Fatal("actual public candidate Prepare", position, err)
				}
				if candidate.service.Load() == nil || !candidate.prepared.Load() || catalog.calls.Load() == 0 {
					t.Fatal("public Prepare did not create actual shared candidate service")
				}
				if position > 0 && outcome != "compare-local" {
					if _, ok := candidate.service.Load().value.(*mobilemultihop.NodeChainExecutionRemoteCandidateMeasurement); !ok {
						t.Fatal("Server interior did not retain actual remote candidate service")
					}
				} else if _, ok := candidate.service.Load().value.(*mobilemultihop.NodeChainExecutionCandidateMeasurement); !ok {
					t.Fatal("entry or Local interior did not retain actual packet candidate service")
				}
				if got, err := candidate.MeasurementExecutionContext(t.Context()); err != nil || got != runtime {
					t.Fatal("prepared candidate replaced selected runtime", err)
				}
				release, err := candidate.BeginMeasurementContext(t.Context())
				if err != nil || release == nil || f.owner.activities.operation.Load() == nil {
					t.Fatal("prepared public candidate lost its native activity", err)
				}
				release()
				if err := candidate.Close(); err != nil || f.owner.activities.candidate.Load() != nil || f.owner.activities.operation.Load() != nil || candidate.callbackActive.Load() {
					t.Fatal("public candidate close did not join exact ownership", err)
				}
				replacement, err := RouterNodeChainExecutionNewCandidateMeasurement(f.owner, f.server, position, f.inventory, catalog)
				if err != nil || replacement == nil || replacement == candidate {
					t.Fatal("public same-catalog replacement was unavailable", err)
				}
				if err := candidate.Close(); err == nil || replacement.retired.Load() || f.owner.activities.candidate.Load() != replacement {
					t.Fatal("old public handle retired same-catalog replacement")
				}
				if err := replacement.Prepare(); err != nil {
					t.Fatal(err)
				}
				if err := replacement.Close(); err != nil {
					t.Fatal(err)
				}
				if f.owner.state.Load() != state || state.controller.Load() != controller || state.engine.Load() != engine || state.projection.Load() != projection || executionBridgeJSON(t, runtime.Progress().Comparison) != before || f.puts.Load() != puts {
					t.Fatal("public candidate factory reran or replaced selected execution")
				}
				now, err := f.nativeEngine.SelectionEpochContext(t.Context())
				if err != nil || now != epoch || !f.owner.Healthy() {
					t.Fatal("public candidate changed original selected epoch or proof", err)
				}
			}
			// A real callback refusal leaves the original returned handle responsible
			// for its failed Prepare activity. It cannot disappear or borrow a key.
			for _, position := range []int32{0, 1} {
				catalog := executionFactoryCatalogFor(f.inventory)
				candidate, err := RouterNodeChainExecutionNewCandidateMeasurement(f.owner, f.server, position, f.inventory, catalog)
				if err != nil || candidate == nil {
					t.Fatal(position, err)
				}
				catalog.digest.Store(strings.Repeat("f", 64))
				if err := candidate.Prepare(); err == nil || f.owner.activities.candidate.Load() != candidate || f.owner.activities.operation.Load() == nil {
					t.Fatal("failed public Prepare discarded original handle or activity", position)
				}
				if candidate.service.Load() != nil {
					t.Fatal("refused factory retained a nonexistent measurement service", position)
				}
				if err := candidate.Close(); err != nil || f.owner.activities.candidate.Load() != nil || f.owner.activities.operation.Load() != nil || candidate.callbackActive.Load() {
					t.Fatal("failed public Prepare did not join through exact returned handle", position, err)
				}
			}
			if f.puts.Load() != puts || executionBridgeJSON(t, runtime.Progress().Comparison) != before || !f.owner.Healthy() {
				t.Fatal("failed candidate Prepare replaced or retired original selected execution")
			}
		})
	}
}
