// The exported candidate factory runs on a selected controller produced by the
// real mobile BindNative/daemon construction/Run lifecycle, concrete Box engine,
// managers, selector and application gate. Private HTTP, lease Manager,
// authenticated SOCKS and public TLS proof all execute. The encrypted packet
// transports, OS interface and remote worker proof observations are explicit
// models. The original TUN is constructed but its privileged Start is modeled.
// These are factory/ownership proofs, not encrypted routing, physical MTU,
// device acceptance, or a completed fifty-sample candidate measurement.
//
// Reflection is confined to the existing shared testTLS trust field. It is
// installed by the original native-current callback, synchronously before the
// real controller Run reaches any proof. No ready state, trial, epoch, native
// service, constructor reservation or shared candidate plan is injected.
func executionFactoryNativeField[T any](t *testing.T, owner any, name string) *T {
	t.Helper()
	field := reflect.ValueOf(owner).Elem().FieldByName(name)
	if !field.IsValid() || !field.CanAddr() || field.Type() != reflect.TypeFor[T]() {
		t.Fatal("pinned entry component field changed", name)
	}
	return (*T)(unsafe.Pointer(field.UnsafeAddr()))
}

