const routerNodeChainOpenVPNExecutionLaunchKind = "routervpn-node-chain-openvpn-execution-preparation-input"

type routerNodeOpenVPNExecutionServerKey struct{}
type routerNodeOpenVPNExecutionServerOwner struct {
	self        *routerNodeOpenVPNExecutionServerOwner
	plan        *RouterNodeChainExecution
	preparation *mobilemultihop.NodeChainExecutionPreparation
	source      *mobilemultihop.NodeChain
	registry    *outbound.Registry
	server      *CommandServer
	started     *daemon.StartedService
}

// This distinct parser constructs the original typed source once. Generic
// execution remains closed; the original Local schema-five capture is retained.
func NewRouterNodeChainOpenVPNExecution(localSource, execution string) (*RouterNodeChainExecution, error) {
	original, err := mobilemultihop.NewNodeChain(localSource)
	if err != nil {
		return nil, err
	}
	prep, err := mobilemultihop.NewNodeChainOpenVPNExecutionPreparation(original, execution)
	if err != nil {
		return nil, err
	}
	return &RouterNodeChainExecution{prep: prep}, nil
}

// The sealed Local envelope remains original; its projection is never stripped.
func RouterNodeChainOpenVPNExecutionFromLaunch(input, execution string) (*RouterNodeChainExecution, error) {
	original, err := mobilemultihop.ParseNodeChainLaunchInput(input)
	if err != nil {
		return nil, err
	}
	prep, err := mobilemultihop.NewNodeChainOpenVPNExecutionPreparation(original, execution)
	if err != nil {
		return nil, err
	}
	return &RouterNodeChainExecution{prep: prep}, nil
}
func NewRouterNodeChainOpenVPNExecutionLaunch(input string) (*RouterNodeChainExecution, error) {
	if len(input) == 0 || len(input) > mobilemultihop.NodeChainInputLimit {
		return nil, errRouterNodeChainExecution
	}
	var launch routerNodeChainExecutionLaunch
	if json.Unmarshal([]byte(input), &launch) != nil || launch.Kind != routerNodeChainOpenVPNExecutionLaunchKind || (launch.Schema != 1 && launch.Schema != 2) {
		return nil, errRouterNodeChainExecution
	}
	prep, err := mobilemultihop.ParseNodeChainOpenVPNExecutionPreparation(launch.Source)
	if err != nil {
		return nil, err
	}
	m := &RouterNodeChainExecution{prep: prep}
	if m.SourceSHA256() != launch.SourceSHA256 || m.ConfigSHA256() != launch.ConfigSHA256 {
		return nil, errRouterNodeChainExecution
	}
	if launch.Schema == 2 {
		last, e := mobilemultihop.ParseNodeChainExecutionLast(launch.Last, prep)
		if e != nil {
			return nil, e
		}
		m.last = &last
	} else if launch.Last != "" {
		return nil, errRouterNodeChainExecution
	}
	canonical, err := m.LaunchInput()
	if err != nil || canonical != input {
		return nil, errRouterNodeChainExecution
	}
	return m, nil
}
func RouterNodeChainOpenVPNExecutionFromLast(input, execution, lastJSON string) (*RouterNodeChainExecution, error) {
	m, err := RouterNodeChainOpenVPNExecutionFromLaunch(input, execution)
	if err != nil {
		return nil, err
	}
	last, err := mobilemultihop.ParseNodeChainExecutionLast(lastJSON, m.prep)
	if err != nil {
		return nil, err
	}
	m.last = &last
	return m, nil
}

// The typed execution plan creates the exact caller-local registry and binds
// the preparation before the host receives an otherwise ordinary CommandServer.
// The host must retain this returned handle, BindNative, then Start it.
func (m *RouterNodeChainExecution) newOpenVPNCommandServer(handler CommandServerHandler, platform PlatformInterface) (*CommandServer, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	if m == nil || m.prep == nil || handler == nil || platform == nil || !m.prep.RequiresOpenVPNExecutionObserver() {
		return nil, errRouterNodeChainExecution
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.mu); err != nil {
		return nil, err
	}
	defer m.mu.Unlock()
	if m.retired.Load() || m.started || m.native.Load() != nil || m.state.Load() != nil || m.openvpnServer.Load() != nil || m.connectServer.Load() != nil || m.socksServer.Load() != nil {
		return nil, errRouterNodeChainExecution
	}
	source, err := m.prep.OriginalOpenVPNSource()
	if err != nil {
		return nil, err
	}
	native := baseContext(platform)
	registry := include.OutboundRegistry()
	native = service.ContextWith[option.OutboundOptionsRegistry](native, registry)
	native = service.ContextWith[adapter.OutboundRegistry](native, registry)
	native, err = box.RouterVPNNodeOpenVPNExecutionContext(native, m.prep)
	if err != nil {
		return nil, err
	}
	owner := &routerNodeOpenVPNExecutionServerOwner{plan: m, preparation: m.prep, source: source, registry: registry}
	owner.self = owner
	native = context.WithValue(native, routerNodeOpenVPNExecutionServerKey{}, owner)
	server := newCommandServerWithContext(handler, platform, native)
	owner.server, owner.started = server, server.StartedService
	m.openvpnServer.Store(owner)
	return server, nil
}
func RouterNodeChainOpenVPNExecutionNewCommandServer(m *RouterNodeChainExecution, handler CommandServerHandler, platform PlatformInterface) (*CommandServer, error) {
	if m == nil {
		return nil, errRouterNodeChainExecution
	}
	return m.newOpenVPNCommandServer(handler, platform)
}
func (m *RouterNodeChainExecution) requireOpenVPNServer(ctx context.Context, server *CommandServer) error {
	if m == nil || ctx == nil || ctx.Err() != nil {
		return errRouterNodeChainExecution
	}
	if m.prep == nil {
		if m.openvpnServer.Load() != nil {
			return errRouterNodeChainExecution
		}
		return nil // Existing untyped instance readback grants no preparation authority.
	}
	if !m.prep.RequiresOpenVPNExecutionObserver() {
		if m.openvpnServer.Load() != nil {
			return errRouterNodeChainExecution
		}
		return nil
	}
	owner := m.openvpnServer.Load()
	if owner == nil || owner.self != owner || owner.plan != m || owner.preparation != m.prep || server == nil || server.ctx == nil || owner.server != server || owner.started == nil || server.StartedService != owner.started || server.ctx.Value(routerNodeOpenVPNExecutionServerKey{}) != owner || service.FromContext[adapter.OutboundRegistry](server.ctx) != owner.registry || service.FromContext[option.OutboundOptionsRegistry](server.ctx) != owner.registry {
		return errRouterNodeChainExecution
	}
	original, err := m.prep.OriginalOpenVPNSource()
	if err != nil || original != owner.source {
		return errors.Join(err, errRouterNodeChainExecution)
	}
	return ctx.Err()
}
