package daemon

import (
	"context"
	"errors"
	"sync"

	box "github.com/sagernet/sing-box"
)

// The first actual Instance.Close owns the only Box.Close result. Repeated
// Close calls join that original operation and cannot turn os.ErrClosed or
// an early Box.done signal into successful native retirement.
type routerVPNInstanceCloseReceipt struct {
	mu       sync.Mutex
	done     chan struct{}
	original *box.Box
	owner    *Instance
	result   error
}

func (i *Instance) routerVPNCloseOriginal(closeOriginal func() error) error {
	r := &i.routerVPNCloseReceipt
	r.mu.Lock()
	if r.owner != nil && r.owner != i || r.original != nil && r.original != i.instance {
		r.mu.Unlock()
		return errors.New("original native Instance close owner changed")
	}
	if r.done != nil {
		done := r.done
		r.mu.Unlock()
		<-done
		r.mu.Lock()
		result := r.result
		r.mu.Unlock()
		return result
	}
	r.done, r.original, r.owner = make(chan struct{}), i.instance, i
	done := r.done
	r.mu.Unlock()
	preclose := i.instance.RouterVPNCloseSOCKSMiddle()
	result := closeOriginal()
	if preclose != nil {
		result = errors.Join(preclose, result)
	}
	r.mu.Lock()
	r.result = result
	close(done)
	r.mu.Unlock()
	return result
}

func (i *Instance) RouterVPNClosedContext(ctx context.Context, original *box.Box) error {
	if i == nil || ctx == nil || original == nil || i.instance != original {
		return errors.New("original native close receipt changed")
	}
	r := &i.routerVPNCloseReceipt
	r.mu.Lock()
	done, captured, owner := r.done, r.original, r.owner
	r.mu.Unlock()
	if done == nil || captured != original || owner != i {
		return errors.New("original native close has not joined")
	}
	select {
	case <-done:
	case <-ctx.Done():
		return ctx.Err()
	}
	r.mu.Lock()
	result := r.result
	valid := r.done == done && r.original == original && r.owner == i && i.instance == original
	r.mu.Unlock()
	if !valid {
		return errors.New("original native close receipt was replaced")
	}
	if result != nil {
		return result
	}
	return ctx.Err()
}
