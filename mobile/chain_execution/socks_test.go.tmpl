func socksExecutionBridgePlan(t *testing.T, mode, execution string) *RouterNodeChainExecution {
	t.Helper()
	source, err := socksBridgeSource(t, mode).Source()
	if err != nil {
		t.Fatal(err)
	}
	plan, err := NewRouterNodeChainSOCKSExecution(source, execution)
	if err != nil {
		t.Fatal(err)
	}
	return plan
}
func TestRouterNodeChainExecutionBridgeSOCKSOriginalSource(t *testing.T) {
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		for _, execution := range []string{"server", "auto"} {
			t.Run(mode+"/"+execution, func(t *testing.T) {
				plan := socksExecutionBridgePlan(t, mode, execution)
				defer plan.Close()
				launch, err := plan.LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
				replay, err := NewRouterNodeChainSOCKSExecutionLaunch(launch)
				if err != nil {
					t.Fatal(err)
				}
				defer replay.Close()
				original, _ := plan.prep.OriginalSOCKSSource()
				other, _ := replay.prep.OriginalSOCKSSource()
				if original == other || plan.Source() != replay.Source() || plan.Config() != replay.Config() || plan.SourceSHA256() != replay.SourceSHA256() || plan.LocalSourceSHA256() != replay.LocalSourceSHA256() {
					t.Fatal("typed execution replay changed source or reused original owner")
				}
				if _, err := NewRouterNodeChainExecutionLaunch(launch); err == nil {
					t.Fatal("generic launch accepted typed execution")
				}
				if _, err := NewRouterNodeChainExecution(plan.prep.LocalSource(), execution); err == nil {
					t.Fatal("generic source accepted typed execution")
				}
				for _, bad := range []string{strings.Replace(launch, `"schema":1`, `"schema":1,"schema":1`, 1), launch + " ", strings.Replace(launch, routerNodeChainSOCKSExecutionLaunchKind, routerNodeChainExecutionLaunchKind, 1)} {
					if _, err := NewRouterNodeChainSOCKSExecutionLaunch(bad); err == nil {
						t.Fatal("noncanonical or foreign-family launch accepted")
					}
				}
			})
		}
	}
}
func TestRouterNodeChainExecutionBridgeSOCKSOriginalFactory(t *testing.T) {
	for _, fault := range []string{"original", "ordinary-server", "foreign-server", "foreign-preparation", "duplicate-factory", "local-constructor", "copied-plan", "copied-owner", "closed"} {
		t.Run(fault, func(t *testing.T) {
			plan := socksExecutionBridgePlan(t, "wg", "server")
			server, err := RouterNodeChainSOCKSExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{})
			if err != nil {
				t.Fatal(err)
			}
			t.Cleanup(func() {
				if err := plan.Close(); err != nil {
					t.Error(err)
				}
				if err := server.StartedService.CloseService(); err != nil {
					t.Error(err)
				}
				server.Close()
			})
			captured := plan.socksServer.Load()
			if captured == nil || captured.preparation != plan.prep {
				t.Fatal("factory lost original preparation")
			}
			switch fault {
			case "ordinary-server":
				if plan.BindNative(&CommandServer{StartedService: server.StartedService, ctx: context.Background()}) == nil {
					t.Fatal("ordinary service borrowed typed factory")
				}
				return
			case "foreign-server":
				other := socksExecutionBridgePlan(t, "wg", "server")
				defer other.Close()
				if other.BindNative(server) == nil {
					t.Fatal("equal source borrowed another factory")
				}
				return
			case "foreign-preparation":
				old := plan.prep
				other := socksExecutionBridgePlan(t, "wg", "server")
				plan.prep = other.prep
				err = plan.BindNative(server)
				plan.prep = old
				defer other.Close()
				if err == nil {
					t.Fatal("reparsed preparation borrowed original proxy")
				}
				return
			case "duplicate-factory":
				if _, err := RouterNodeChainSOCKSExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{}); err == nil {
					t.Fatal("same execution made another native server")
				}
			case "local-constructor":
				source, _ := plan.prep.OriginalSOCKSSource()
				local := &RouterNodeChainSOCKS{source: source}
				local.self = local
				if local.BindNative(server) == nil {
					t.Fatal("Local owner adopted execution factory")
				}
			case "copied-plan":
				copy := &RouterNodeChainExecution{prep: plan.prep}
				copy.socksServer.Store(captured)
				if copy.BindNative(server) == nil {
					t.Fatal("equal preparation borrowed original plan's native factory")
				}
			case "copied-owner":
				copy := &routerNodeSOCKSExecutionServerOwner{self: captured, plan: plan, preparation: captured.preparation, source: captured.source, capture: captured.capture, registry: captured.registry, server: captured.server, started: captured.started}
				plan.socksServer.Store(copy)
				if plan.BindNative(server) == nil {
					t.Fatal("copied factory owner borrowed original native reservation")
				}
				plan.socksServer.Store(captured)
			case "closed":
				if err := plan.Close(); err != nil {
					t.Fatal(err)
				}
				if _, err := RouterNodeChainSOCKSExecutionNewCommandServer(plan, &socksBridgeHandler{}, &socksBridgePlatform{}); err == nil {
					t.Fatal("retired execution reopened its factory")
				}
				return
			}
			if err := plan.BindNative(server); err != nil {
				t.Fatal(err)
			}
			if plan.Healthy() || plan.NativeClosed() {
				t.Fatal("unstarted native factory invented proof or DOWN")
			}
			if err := plan.Close(); err != nil {
				t.Fatal(err)
			}
			if err := server.StartedService.CloseService(); err != nil || !plan.NativeClosed() {
				t.Fatal("original empty native reservation did not join", err)
			}
		})
	}
}

// A durable record is source data, never a prior live proof. Native fresh
// discovery and execution still have to run after this parser succeeds.
func socksExecutionBridgeLast(t *testing.T, chosen string) (*RouterNodeChainExecution, string) {
	t.Helper()
	plan := socksExecutionBridgePlan(t, "wg", "auto")
	var local mobilemultihop.NodeChainSource
	if err := json.Unmarshal([]byte(plan.prep.LocalSource()), &local); err != nil {
		t.Fatal(err)
	}
	proofs := plan.prep.ProofInventory()
	source := mobilemultihop.NodeChainServerSource{Schema: 3, EntryID: proofs[0].ProfileID, EntryNodeID: proofs[0].NodeID, EntryMode: proofs[0].Mode, Nodes: local.Nodes[1:], IdentitySources: local.IdentitySources[1:]}
	server, err := mobilemultihop.NewNodeChainSOCKSServerPolicy(executionBridgeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	descriptor := server.Descriptor()
	digest, err := descriptor.Digest()
	if err != nil {
		t.Fatal(err)
	}
	discovery, err := plan.prep.Discovery()
	if err != nil {
		t.Fatal(err)
	}
	api, err := url.Parse(discovery.API)
	if err != nil {
		t.Fatal(err)
	}
	input := sha256.Sum256([]byte(plan.prep.LocalSource()))
	record := executionBridgeLastRecord{Schema: 1, LocalSourceSHA256: plan.LocalSourceSHA256(), LocalInputSHA256: hex.EncodeToString(input[:]), Setting: "auto", Execution: chosen, Target: mobilemultihop.Targets[0], Descriptor: descriptor, DescriptorSHA256: digest, DNSPolicySHA256: descriptor.DNSPolicySHA256, EntryHost: api.Hostname(), Peer: "10.77.0.2", FirstPort: 32000, LastPort: 32007, Port: 32003}
	sum := sha256.Sum256(append([]byte("routervpn-node-chain-execution-last-v1\x00"), []byte(executionBridgeJSON(t, record))...))
	record.Digest = hex.EncodeToString(sum[:])
	saved := executionBridgeJSON(t, record)
	if _, err := mobilemultihop.ParseNodeChainExecutionLast(saved, plan.prep); err != nil {
		t.Fatal(err)
	}
	return plan, saved
}

func TestRouterNodeChainExecutionBridgeSOCKSLastRetainsChoiceWithoutProof(t *testing.T) {
	for _, chosen := range []string{"local", "server"} {
		t.Run(chosen, func(t *testing.T) {
			original, saved := socksExecutionBridgeLast(t, chosen)
			defer original.Close()
			plan, err := RouterNodeChainSOCKSExecutionFromLast(original.prep.LocalSource(), "auto", saved)
			if err != nil {
				t.Fatal(err)
			}
			defer plan.Close()
			launch, err := plan.LaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			replay, err := NewRouterNodeChainSOCKSExecutionLaunch(launch)
			if err != nil {
				t.Fatal(err)
			}
			defer replay.Close()
			if replay.last == nil || replay.last.JSON() != saved || replay.last.Execution() != chosen || replay.Config() != original.Config() || replay.Source() != original.Source() || replay.Healthy() || replay.Execution() != "" {
				t.Fatal("saved Last lost original choice or fabricated live proof")
			}
			if raw, err := replay.CaptureLastJSON(); err == nil || raw != "" {
				t.Fatal("unproved Last was recaptured as a live result")
			}
			if _, err := NewRouterNodeChainExecutionLaunch(launch); err == nil {
				t.Fatal("generic launch borrowed typed Last")
			}
			var captured routerNodeChainExecutionLaunch
			if json.Unmarshal([]byte(launch), &captured) != nil {
				t.Fatal("missing original launch")
			}
			for _, fault := range []string{"missing-last", "downgrade", "config", "kind"} {
				changed := captured
				switch fault {
				case "missing-last":
					changed.Last = ""
				case "downgrade":
					changed.Schema = 1
				case "config":
					changed.ConfigSHA256 = strings.Repeat("d", 64)
				case "kind":
					changed.Kind = routerNodeChainExecutionLaunchKind
				}
				if _, err := NewRouterNodeChainSOCKSExecutionLaunch(executionBridgeJSON(t, changed)); err == nil {
					t.Fatal("changed Last launch admitted", fault)
				}
			}
		})
	}
}
