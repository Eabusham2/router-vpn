package libbox

import (
	"context"
	"strings"
	"testing"
)

func connectExecutionBridgePlan(t *testing.T, mode, protocol, execution string) *RouterNodeChainExecution {
	t.Helper()
	name := ""
	if protocol == "https-connect" {
		name = "original-connect.example"
	}
	source, err := connectBridgeSourceProtocol(t, mode, protocol, name).Source()
	if err != nil {
		t.Fatal(err)
	}
	plan, err := NewRouterNodeChainCONNECTExecution(source, execution)
	if err != nil {
		t.Fatal(err)
	}
	return plan
}
func TestRouterNodeChainExecutionBridgeCONNECTOriginalSource(t *testing.T) {
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		for _, protocol := range []string{"http-connect", "https-connect"} {
			for _, execution := range []string{"server", "auto"} {
				t.Run(mode+"/"+protocol+"/"+execution, func(t *testing.T) {
					plan := connectExecutionBridgePlan(t, mode, protocol, execution)
					defer plan.Close()
					launch, err := plan.LaunchInput()
					if err != nil {
						t.Fatal(err)
					}
					replay, err := NewRouterNodeChainCONNECTExecutionLaunch(launch)
					if err != nil {
						t.Fatal(err)
					}
					defer replay.Close()
					original, _ := plan.prep.OriginalCONNECTSource()
					other, _ := replay.prep.OriginalCONNECTSource()
					if original == other || plan.Source() != replay.Source() || plan.Config() != replay.Config() || plan.SourceSHA256() != replay.SourceSHA256() || plan.LocalSourceSHA256() != replay.LocalSourceSHA256() {
						t.Fatal("typed execution replay changed source or reused original owner")
					}
					if _, err := NewRouterNodeChainExecutionLaunch(launch); err == nil {
						t.Fatal("generic launch accepted typed execution")
					}
					if _, err := NewRouterNodeChainExecution(plan.prep.LocalSource(), execution); err == nil {
						t.Fatal("generic source accepted typed execution")
					}
					for _, bad := range []string{strings.Replace(launch, `"schema":1`, `"schema":1,"schema":1`, 1), launch + " ", strings.Replace(launch, routerNodeChainCONNECTExecutionLaunchKind, routerNodeChainExecutionLaunchKind, 1)} {
						if _, err := NewRouterNodeChainCONNECTExecutionLaunch(bad); err == nil {
							t.Fatal("noncanonical or foreign-family launch accepted")
						}
					}
				})
			}
		}
	}
}
func TestRouterNodeChainExecutionBridgeCONNECTOriginalFactory(t *testing.T) {
	for _, fault := range []string{"original", "ordinary-server", "foreign-server", "foreign-preparation", "duplicate-factory", "local-constructor", "closed"} {
		t.Run(fault, func(t *testing.T) {
			plan := connectExecutionBridgePlan(t, "wg", "http-connect", "server")
			server, err := plan.NewCommandServer(&connectBridgeHandler{}, &connectBridgePlatform{})
			if err != nil {
				t.Fatal(err)
			}
			t.Cleanup(func() {
				if err := plan.Close(); err != nil {
					t.Error(err)
				}
				if err := server.StartedService.CloseService(); err != nil {
					t.Error(err)
				}
				server.Close()
			})
			captured := plan.connectServer.Load()
			if captured == nil || captured.preparation != plan.prep {
				t.Fatal("factory lost original preparation")
			}
			switch fault {
			case "ordinary-server":
				if plan.BindNative(&CommandServer{StartedService: server.StartedService, ctx: context.Background()}) == nil {
					t.Fatal("ordinary service borrowed typed factory")
				}
				return
			case "foreign-server":
				other := connectExecutionBridgePlan(t, "wg", "http-connect", "server")
				defer other.Close()
				if other.BindNative(server) == nil {
					t.Fatal("equal source borrowed another factory")
				}
				return
			case "foreign-preparation":
				old := plan.prep
				other := connectExecutionBridgePlan(t, "wg", "http-connect", "server")
				plan.prep = other.prep
				err = plan.BindNative(server)
				plan.prep = old
				defer other.Close()
				if err == nil {
					t.Fatal("reparsed preparation borrowed original proxy")
				}
				return
			case "duplicate-factory":
				if _, err := plan.NewCommandServer(&connectBridgeHandler{}, &connectBridgePlatform{}); err == nil {
					t.Fatal("same execution made another native server")
				}
			case "local-constructor":
				source, _ := plan.prep.OriginalCONNECTSource()
				local := &RouterNodeChainCONNECT{source: source}
				local.self = local
				if local.BindNative(server) == nil {
					t.Fatal("Local owner adopted execution factory")
				}
			case "closed":
				if err := plan.Close(); err != nil {
					t.Fatal(err)
				}
				if _, err := plan.NewCommandServer(&connectBridgeHandler{}, &connectBridgePlatform{}); err == nil {
					t.Fatal("retired execution reopened its factory")
				}
				return
			}
			if err := plan.BindNative(server); err != nil {
				t.Fatal(err)
			}
			if plan.Healthy() || plan.NativeClosed() {
				t.Fatal("unstarted native factory invented proof or DOWN")
			}
			if err := plan.Close(); err != nil {
				t.Fatal(err)
			}
			if err := server.StartedService.CloseService(); err != nil || !plan.NativeClosed() {
				t.Fatal("original empty native reservation did not join", err)
			}
		})
	}
}
