var _ routerNodeChainExecutionCandidateService = (*mobilemultihop.NodeChainExecutionCandidateMeasurement)(nil)

// Actual native instance/Box currentness and public handle lifecycle execute.
// The candidate service and selected-controller I/O are explicit component
// doubles. The shared suite separately requires real HTTP/TLS and fifty dials.
type executionCandidateBoundary struct {
	starts, closes atomic.Int32
	failClose      atomic.Bool
}

func (s *executionCandidateBoundary) Start(string, string) error { s.starts.Add(1); return nil }
func (s *executionCandidateBoundary) Cancel(string)              {}
func (s *executionCandidateBoundary) Drain(string) error         { return nil }
func (s *executionCandidateBoundary) StatusJSON() string {
	return `{"component":"candidate-native-lifecycle"}`
}
func (s *executionCandidateBoundary) Invalidate() {}
func (s *executionCandidateBoundary) CloseContext(ctx context.Context) error {
	s.closes.Add(1)
	if s.failClose.Load() {
		return errors.New("original component close pending")
	}
	return ctx.Err()
}
func executionCandidateFixture(t *testing.T) (*RouterNodeChainExecution, *RouterNodeChainExecutionCandidateMeasurement, *executionCandidateBoundary) {
	t.Helper()
	owner, state, controller := executionMeasurementFixture(t)
	state.owner = owner
	service := &executionCandidateBoundary{}
	candidate := &RouterNodeChainExecutionCandidateMeasurement{owner: owner, state: state, controller: controller, engine: state.engine.Load(), projection: state.projection.Load(), prepareDeadline: time.Now().Add(hopmeasure.ObservationTimeout)}
	candidate.self = candidate
	candidate.factory = func(context.Context) (routerNodeChainExecutionCandidateService, error) { return service, nil }
	if _, err := owner.reserveExecutionCandidateContext(t.Context(), candidate); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if owner.activities.candidate.Load() == candidate {
			if err := candidate.Close(); err != nil {
				t.Error(err)
			}
		}
	})
	return owner, candidate, service
}
func TestRouterNodeChainExecutionBridgeCandidateFactory(t *testing.T) {
	for _, fault := range []string{"missing-owner", "unproved-owner"} {
		t.Run(fault, func(t *testing.T) {
			var owner *RouterNodeChainExecution
			var server *CommandServer
			if fault == "unproved-owner" {
				owner, state := executionBridgeNativeFixture(t)
				state.owner = owner
				server = state.server
				for _, position := range []int32{-1, 0, 1, 7} {
					if got, err := RouterNodeChainExecutionNewCandidateMeasurement(owner, server, position, "{}", &candidateBridgeCatalog{}); err == nil || got != nil || owner.activities.candidate.Load() != nil {
						t.Fatal("unproved execution acquired entry candidate")
					}
				}
				return
			}
			if got, err := RouterNodeChainExecutionNewCandidateMeasurement(owner, server, 0, "{}", &candidateBridgeCatalog{}); err == nil || got != nil {
				t.Fatal("missing execution acquired candidate")
			}
		})
	}
}
func TestRouterNodeChainExecutionBridgeCandidateOwnership(t *testing.T) {
	for _, fault := range []string{"copied-handle", "copied-owner", "copied-owner-cleared", "controller", "stale-close", "duplicate"} {
		t.Run(fault, func(t *testing.T) {
			owner, candidate, service := executionCandidateFixture(t)
			switch fault {
			case "copied-handle":
				copy := &RouterNodeChainExecutionCandidateMeasurement{self: candidate, owner: owner, state: candidate.state, prepareDeadline: candidate.prepareDeadline, factory: candidate.factory}
				if copy.Prepare() == nil || copy.Close() == nil || candidate.retired.Load() {
					t.Fatal("copied entry handle borrowed cleanup")
				}
			case "copied-owner", "copied-owner-cleared":
				copy := &RouterNodeChainExecution{prep: owner.prep}
				copy.state.Store(candidate.state)
				if fault == "copied-owner" {
					copy.activities.candidate.Store(candidate)
				}
				copy.NetworkChanged()
				ctx, cancel := context.WithTimeout(t.Context(), 50*time.Millisecond)
				err := copy.closeContext(ctx)
				cancel()
				if err == nil || candidate.state.lifetime.Err() != nil || candidate.retired.Load() || owner.retired.Load() {
					t.Fatal("copied execution owner retired original entry activity")
				}
			case "controller":
				candidate.state.controller.Store(&routerNodeChainExecutionControllerRef{candidate.controller.value})
				err := candidate.current(t.Context())
				candidate.state.controller.Store(candidate.controller)
				if err == nil {
					t.Fatal("replacement controller retained candidate authority")
				}
			case "stale-close":
				if err := candidate.Close(); err != nil {
					t.Fatal(err)
				}
				replacement := &RouterNodeChainExecutionCandidateMeasurement{owner: owner, state: candidate.state, controller: candidate.controller, engine: candidate.engine, projection: candidate.projection, inventorySHA: candidate.inventorySHA, prepareDeadline: time.Now().Add(hopmeasure.ObservationTimeout), factory: candidate.factory}
				replacement.self = replacement
				if _, err := owner.reserveExecutionCandidateContext(t.Context(), replacement); err != nil {
					t.Fatal(err)
				}
				if err := candidate.Close(); err == nil || owner.activities.candidate.Load() != replacement || replacement.retired.Load() {
					t.Fatal("stale entry handle acknowledged replacement cleanup")
				}
				if err := replacement.Prepare(); err != nil {
					t.Fatal(err)
				}
				if err := replacement.Close(); err != nil {
					t.Fatal(err)
				}
			case "duplicate":
				duplicate := &RouterNodeChainExecutionCandidateMeasurement{owner: owner, state: candidate.state, controller: candidate.controller, engine: candidate.engine, projection: candidate.projection}
				duplicate.self = duplicate
				if got, err := owner.reserveExecutionCandidateContext(t.Context(), duplicate); err == nil || got != nil || owner.activities.candidate.Load() != candidate || candidate.retired.Load() {
					t.Fatal("duplicate constructor stole original entry reservation")
				}
				if candidate.service.Load() != nil || service.starts.Load() != 0 {
					t.Fatal("constructor performed service work before return")
				}
			}
		})
	}
}
func TestRouterNodeChainExecutionBridgeCandidatePrepare(t *testing.T) {
	for _, fault := range []string{"deadline", "held-prepare", "held-catalog"} {
		t.Run(fault, func(t *testing.T) {
			owner, candidate, _ := executionCandidateFixture(t)
			if fault == "deadline" {
				candidate.prepareDeadline = time.Now().Add(-time.Millisecond)
				if candidate.Prepare() == nil || candidate.service.Load() != nil {
					t.Fatal("entry Prepare renewed original deadline")
				}
				return
			}
			entered, release := make(chan struct{}), make(chan struct{})
			var once sync.Once
			unblock := func() { once.Do(func() { close(release) }) }
			defer unblock()
			done := make(chan error, 1)
			joined := make(chan struct{})
			t.Cleanup(func() {
				unblock()
				select {
				case <-joined:
				case <-time.After(time.Second):
					t.Error("original entry callback did not join cleanup")
				}
			})
			if fault == "held-prepare" {
				candidate.factory = func(context.Context) (routerNodeChainExecutionCandidateService, error) {
					close(entered)
					<-release
					return nil, errors.New("original partial Prepare failed")
				}
				go func() { defer close(joined); done <- candidate.Prepare() }()
			} else {
				// A foreign catalog callback that exceeded its original observation still
				// has an exact completion channel retained by the real close path.
				call := &routerNodeChainCatalogCall{done: make(chan struct{})}
				candidate.pending = call
				candidate.callbackActive.Store(true)
				go func() {
					defer close(joined)
					close(entered)
					<-release
					candidate.callbackActive.Store(false)
					close(call.done)
					done <- nil
				}()
			}
			select {
			case <-entered:
			case <-time.After(time.Second):
				t.Fatal("owned preparation did not enter")
			}
			ctx, cancel := context.WithTimeout(t.Context(), 15*time.Millisecond)
			err := candidate.closeContext(ctx)
			cancel()
			if !errors.Is(err, context.DeadlineExceeded) || owner.activities.candidate.Load() != candidate {
				t.Fatal("held entry "+fault+" fabricated joined cleanup", err)
			}
			unblock()
			select {
			case <-done:
			case <-time.After(time.Second):
				t.Fatal("original entry callback did not join")
			}
			if err := candidate.Close(); err != nil {
				t.Fatal(err)
			}
			if owner.activities.operation.Load() != nil || owner.activities.candidate.Load() != nil {
				t.Fatal("entry retained joined activity")
			}
		})
	}
}
func TestRouterNodeChainExecutionBridgeCandidateActivity(t *testing.T) {
	owner, candidate, service := executionCandidateFixture(t)
	if candidate.Start(strings.Repeat("a", 32), "captured") == nil {
		t.Fatal("entry worker started before Prepare")
	}
	if err := candidate.Prepare(); err != nil {
		t.Fatal(err)
	}
	if candidate.Prepare() == nil {
		t.Fatal("entry Prepare was not one-shot")
	}
	release, err := candidate.BeginMeasurementContext(t.Context())
	if err != nil {
		t.Fatal(err)
	}
	if _, err := owner.claimActivity(t.Context(), candidate.state, candidate.controller, "mtu"); err == nil {
		release()
		t.Fatal("MTU borrowed active entry measurement")
	}
	release()
	if err := candidate.Start(strings.Repeat("b", 32), "captured"); err != nil || service.starts.Load() != 1 {
		t.Fatal("prepared original handle lost service")
	}
	service.failClose.Store(true)
	if candidate.Close() == nil || owner.activities.candidate.Load() != candidate {
		t.Fatal("failed original service close lost reservation")
	}
	service.failClose.Store(false)
	if err := candidate.Close(); err != nil || owner.activities.candidate.Load() != nil {
		t.Fatal("original entry cleanup did not join", err)
	}
}
