package daemon

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/adapter"
)

// RouterVPNInstanceContext is the caller-bounded counterpart of Instance.
// It returns the same owned pointer without extending its lifetime or starting
// an asynchronous observer while a service replacement holds the write lock.
func (s *StartedService) RouterVPNInstanceContext(ctx context.Context) (*Instance, error) {
	if s == nil {
		return nil, errors.New("native started service is unavailable")
	}
	if err := adapter.RouterVPNRLockContext(ctx, &s.serviceAccess); err != nil {
		return nil, err
	}
	defer s.serviceAccess.RUnlock()
	return s.instance, ctx.Err()
}
