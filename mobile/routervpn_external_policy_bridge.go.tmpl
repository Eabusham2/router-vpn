package libbox

import (
	"context"
	"errors"
	box "github.com/sagernet/sing-box"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"time"
)

// RouterCompileExternalPolicy applies the exact captured ordinary external
// DNS, IPv6, LAN and MTU policy without opening a socket or changing a profile.
// The bounded envelope binds the original strings, compiled graph and metadata.
// Hosts must still prove the selected native DNS and exit before reporting UP.
func RouterCompileExternalPolicy(config, capture string) (string, error) {
	return mobilemultihop.CompileExternalPolicy(config, capture)
}

// Capture once before compilation. Restoration supplies only the receipt's
// already-proved runtime choice; the saved profile remains unchanged.
func RouterPrepareExternalExecutionCapture(source, capture, restored string) (string, error) {
	return mobilemultihop.PrepareExternalExecutionCapture(source, capture, restored)
}

// Profile editors use the shipping validation contract before saving an
// optional same-node HTTPS response endpoint. This does not open a socket.
func RouterValidateExternalResponseProbe(host, probeJSON string) error {
	return mobilemultihop.ValidateExternalResponseProbe(host, probeJSON)
}

// Draft validation deliberately emits no runnable graph or DNS substitution.
// A real connection must still compile and prove its complete captured policy.
func RouterValidateExternalTransport(source, capture string) error {
	return mobilemultihop.ValidateExternalTransport(source, capture)
}

// The shared runtime DNS parser permits an unresolved Home choice only while
// editing. It returns no runnable graph and never substitutes a public preset.
func RouterValidateExternalDNS(profile, entry string) error {
	return mobilemultihop.ValidateExternalDNS(profile, entry)
}

type RouterExternalProofRequest struct {
	request        *box.RouterVPNExternalProofRequest
	current        func() bool
	currentContext func(context.Context) error
}

// Factory captures the real Box before Run may block. Cancel only reaches
// this request, even when the host has already replaced its StartedService.
func RouterExternalCreateProof(server *CommandServer, source, capture, session string) (*RouterExternalProofRequest, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	return routerExternalCreateProofContext(ctx, server, source, capture, session)
}

func routerExternalCreateProofContext(ctx context.Context, server *CommandServer, source, capture, session string) (*RouterExternalProofRequest, error) {
	if ctx == nil {
		return nil, errors.New("external native proof has no constructor caller")
	}
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	if server == nil || server.StartedService == nil {
		return nil, errors.New("external native service unavailable")
	}
	started := server.StartedService
	instance, err := started.RouterVPNInstanceContext(ctx)
	if err != nil {
		return nil, err
	}
	if instance == nil || instance.Box() == nil {
		return nil, errors.New("external native instance unavailable")
	}
	request, err := instance.Box().RouterVPNExternalCreateProofContext(ctx, source, capture, session)
	if err != nil {
		return nil, err
	}
	currentContext := func(ctx context.Context) error {
		if ctx == nil {
			return errors.New("external native proof has no observation caller")
		}
		if err := ctx.Err(); err != nil {
			return err
		}
		if server.StartedService != started {
			return errors.New("external native service changed")
		}
		actual, err := started.RouterVPNInstanceContext(ctx)
		if err != nil {
			return err
		}
		if server.StartedService != started || actual != instance {
			return errors.New("external native instance changed")
		}
		return ctx.Err()
	}
	current := func() bool {
		ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
		defer cancel()
		return currentContext(ctx) == nil
	}
	if err := currentContext(ctx); err != nil {
		request.Cancel()
		return nil, err
	}
	return &RouterExternalProofRequest{request: request, current: current, currentContext: currentContext}, nil
}
func (r *RouterExternalProofRequest) Run() (string, error) {
	if r == nil || r.request == nil || r.currentContext == nil {
		if r != nil {
			r.Cancel()
		}
		return "", errors.New("external native request retired")
	}
	return r.request.RunObserved(r.currentContext)
}
func (r *RouterExternalProofRequest) runContext(ctx context.Context) (string, error) {
	if r == nil || r.request == nil || r.currentContext == nil {
		if r != nil {
			r.Cancel()
		}
		return "", errors.New("external native request retired")
	}
	return r.request.RunContext(ctx, r.currentContext)
}
func (r *RouterExternalProofRequest) Cancel() {
	if r != nil && r.request != nil {
		r.request.Cancel()
	}
}
func (r *RouterExternalProofRequest) Healthy() bool {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	return r.healthyContext(ctx) == nil
}
func (r *RouterExternalProofRequest) healthyContext(ctx context.Context) error {
	if r == nil || r.request == nil || r.currentContext == nil {
		return errors.New("external native proof has no captured observation owner")
	}
	if err := r.currentContext(ctx); err != nil {
		return err
	}
	if err := r.request.HealthyContext(ctx); err != nil {
		return err
	}
	return r.currentContext(ctx)
}
func (r *RouterExternalProofRequest) Close() error {
	if r == nil || r.request == nil {
		return nil
	}
	return r.request.Close()
}
func (r *RouterExternalProofRequest) ProgressJSON() string {
	if r == nil || r.request == nil {
		return ""
	}
	return r.request.ProgressJSON()
}
func (r *RouterExternalProofRequest) Execution() string {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	if r.healthyContext(ctx) != nil {
		return ""
	}
	outcome, err := r.request.ExecutionContext(ctx)
	if err != nil || r.currentContext(ctx) != nil {
		return ""
	}
	return outcome
}
