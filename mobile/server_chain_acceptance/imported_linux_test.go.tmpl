func serverChainMultipleKey(t *testing.T) string {
	t.Helper()
	raw, err := hex.DecodeString(serverChainEncryptedRandom(t, 32))
	if err != nil {
		t.Fatal(err)
	}
	return base64.StdEncoding.EncodeToString(raw)
}

func (p *serverChainMultiplePeer) read(t *testing.T) serverChainMultipleStats {
	t.Helper()
	var s serverChainMultipleStats
	d := json.NewDecoder(bytes.NewReader(p.original.process.line(t)))
	d.DisallowUnknownFields()
	if d.Decode(&s) != nil || d.Decode(new(any)) != io.EOF || len(s.Peer.Prefixes) != 1 || s.Peer.Schema != 1 ||
		s.Peer.Middle.Method != mobilemultihop.NativeStartLayerMethod || s.Peer.Prefixes[0].Mode != "wg" ||
		strings.Count(s.Peer.PublicCA, "-----BEGIN CERTIFICATE-----") != 2 ||
		s.Peer.Final.DirectQueries != 0 || s.Peer.Final.EntryPublicQueries != 0 {
		t.Fatal("invalid multiple-import peer evidence")
	}
	a, err := netip.ParseAddrPort(s.Address)
	packet, e := netip.ParseAddrPort(s.Peer.Address)
	outerHost, packetHost := "192.168.210.2", "127.0.0.1"
	if p.layout == "packet-first" {
		outerHost, packetHost = "10.79.0.2", "192.168.210.2"
	}
	if err != nil || e != nil || packet.Addr().String() != packetHost || packet.Port() == 0 || a.Addr().String() != outerHost || a.Port() == 0 ||
		p.stats.Address != "" && (s.Address != p.stats.Address || s.Peer.PublicCA != p.stats.Peer.PublicCA || s.Peer.Address != p.stats.Peer.Address) {
		t.Fatal("original multiple-import peer replaced")
	}
	p.stats = s
	return s
}

func (p *serverChainMultiplePeer) command(t *testing.T, cmd string) serverChainMultipleStats {
	t.Helper()
	if _, err := io.WriteString(p.original.process.input, cmd+"\n"); err != nil {
		t.Fatal(err)
	}
	return p.read(t)
}

func serverChainMultiplePeerStart(t *testing.T, layout string, throughput bool) *serverChainMultiplePeer {
	t.Helper()
	o := serverChainImportedKeys(t, "original")
	p := &serverChainMultiplePeer{original: o, layout: layout, first: serverChainMultipleKey(t), second: serverChainMultipleKey(t)}
	img := serverChainEncryptedImage(t, "ROUTERVPN_SERVER_CHAIN_PEER")
	cmd := exec.Command("ip", "netns", "exec", "rvpn-peer", img, "-test.run=^TestRouterVPNDesktopMultipleImportedServerReferenceProcess$", "-test.count=1", "-test.timeout=100s")
	cmd.Env = []string{"PATH=/usr/sbin:/usr/bin:/sbin:/bin", "GORACE=atexit_sleep_ms=0", "ROUTERVPN_MULTIPLE_SERVER_REFERENCE_CHILD=1"}
	o.process = serverChainEncryptedStart(t, cmd)
	paired := map[string]any{"schema": 1, "address": "192.168.210.2", "client_address": "192.168.210.1", "prefixes": o.prefixes, "final_password": o.password, "final_node_proof_id": serverChainEncryptedProof(o.finalServer), "final_api_token": "encrypted-server-final-token"}
	if json.NewEncoder(o.process.input).Encode(map[string]any{"schema": 1, "paired": paired, "middle_method": mobilemultihop.NativeStartLayerMethod, "middle_password": p.second, "outer_password": p.first, "layout": layout, "throughput": throughput}) != nil {
		t.Fatal("multiple-import peer input failed")
	}
	p.read(t)
	o.stats.PublicCA = p.stats.Peer.PublicCA
	return p
}

// The sparse suffix inserts a real paired WG between independent imported SS
// members. Its literal is exposed only by the first authenticated SS provider.
func serverChainMultipleSource(t *testing.T, p *serverChainMultiplePeer, name string) (*mobilemultihop.NodeChainServerPolicy, multihoprelay.NodeChainCapture) {
	t.Helper()
	o := p.original
	o.stats.Address = "198.51.100.112:51820"
	if name == "packet-first" {
		o.stats.Address = p.stats.Peer.Address
	}
	a, err := netip.ParseAddrPort(p.stats.Address)
	if err != nil {
		t.Fatal(err)
	}
	first, second := p.first, p.second
	if name == "wrong-key-first" {
		first = serverChainMultipleKey(t)
	}
	if name == "wrong-key-second" {
		second = serverChainMultipleKey(t)
	}
	s := mobilemultihop.NodeChainServerSource{Schema: 6, EntryID: "multiple-encrypted-entry", EntryNodeID: serverChainEncryptedProof(serverChainEncryptedKey(t)), EntryMode: "wg"}
	positions := []int{0}
	appendPacket := func() {

		packet, identity := serverChainEncryptedMemberSource(t, o, 0, "")
		s.Nodes = append(s.Nodes, packet)
		s.IdentitySources = append(s.IdentitySources, identity)
		positions = append(positions, len(s.Nodes))
	}
	if name == "packet-first" {
		appendPacket()
	}
	firstIndex := len(s.Nodes)
	s.Nodes = append(s.Nodes, serverChainImportedMember(t, a, first, "independent-first-import", "203.0.113.87", false, true))
	s.IdentitySources = append(s.IdentitySources, "")
	if name != "adjacent" && name != "packet-first" {
		appendPacket()
	}
	final, identity := serverChainEncryptedMemberSource(t, o, len(o.prefixes), "")
	s.Nodes = append(s.Nodes, serverChainImportedMember(t, netip.MustParseAddrPort("10.79.0.1:8388"), second, "independent-second-import", "203.0.113.88", false, true), final)
	s.IdentitySources = append(s.IdentitySources, "", identity)
	raw := serverChainEncryptedJSON(t, s)
	if _, err := mobilemultihop.NewNodeChainServerPolicy(raw); err == nil {
		t.Fatal("legacy constructor admitted multiple imports")
	}
	policy, err := mobilemultihop.NewNodeChainMultipleImportedServerPolicy(raw)
	if err != nil {
		t.Fatal("original multiple-import Server source rejected", err)
	}
	desc := policy.Descriptor()
	digest, err := desc.Digest()
	if err != nil {
		t.Fatal(err)
	}
	q := multihoprelay.NodeChainRequest{Schema: 6, SessionID: serverChainEncryptedRandom(t, 16), EntryNodeID: desc.EntryNodeID, SourceSHA256: desc.SourceSHA256, DescriptorSHA256: digest, DNSPolicySHA256: desc.DNSPolicySHA256, Epoch: serverChainEncryptedRandom(t, 32), Peer: "192.168.210.1", AcquireExpiresAt: time.Now().Add(30 * time.Second).Unix(), Port: 28440, LocalPacketPositions: positions}
	for range positions {
		q.LocalPacketPublicKeys = append(q.LocalPacketPublicKeys, base64.StdEncoding.EncodeToString(serverChainEncryptedKey(t).PublicKey().Bytes()))
	}
	for i := range desc.Members {
		q.Users = append(q.Users, multihoprelay.NodeChainUser{Position: i + 1, Username: serverChainEncryptedRandom(t, 24), Password: serverChainEncryptedRandom(t, 24)})
	}
	c := multihoprelay.NodeChainCapture{Schema: 1, Request: q, Source: desc, RegistrySHA256: digest, OwnerID: serverChainEncryptedRandom(t, 32), Peer: q.Peer, Host: q.Peer, BootstrapDeadline: time.Now().Add(30 * time.Second).UTC()}
	if err := c.Validate(); err != nil {
		t.Fatal(err)
	}
	targets, err := policy.ProofTargets(c)
	last := len(c.Request.Users) - 1
	if err != nil || len(targets) != last+1 || targets[firstIndex].ExpectedPublicIP != "203.0.113.87" || targets[last-1].ExpectedPublicIP != "203.0.113.88" ||
		targets[firstIndex].Proof.NodeID != "" || targets[last-1].Proof.NodeID != "" || targets[last].Proof.NodeID != serverChainEncryptedProof(o.finalServer) ||
		(name != "adjacent" && targets[positions[1]-1].Proof.NodeID != o.prefixes[0].NodeProofID) || policy.NativeCarrierRequired() != (name == "packet-first") {
		t.Fatal("multiple-import proof order or identities changed", err)
	}
	return policy, c
}

