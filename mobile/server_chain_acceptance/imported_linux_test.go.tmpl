// Each service drives just the original worker suffix position. Physical entry
// zero and desktop Compare selection are separately owned by the client.
type serverChainThroughputEngine struct {
	worker           *serverChainEncryptedWorker
	route            mobilemultihop.NodeChainServerFrontRoute
	user             multihoprelay.NodeChainUser
	tag, destination string
}

func (e *serverChainThroughputEngine) Identity() string {
	return e.route.Binding.CaptureSHA256 + "/" + e.route.Tag
}

func (e *serverChainThroughputEngine) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	if tag != e.tag || address != e.destination || !e.route.AllowsDestination("tcp", address) {
		return nil, fmt.Errorf("measurement exceeded its single captured prefix")
	}
	conn, err := e.worker.connection(e.user, M.ParseSocksaddr(address))
	if err != nil {
		return nil, err
	}
	// The SOCKS handshake retains its original three-second deadline. The
	// shipping service now owns the connection's bounded transfer lifetime.
	deadline, _ := ctx.Deadline()
	if err = conn.SetDeadline(deadline); err != nil {
		conn.Close()
		return nil, err
	}
	return conn, nil
}

type serverChainThroughputReceipt struct {
	Position int        `json:"position"`
	Kind     string     `json:"kind"`
	Client   [2]int64   `json:"client_bytes"`
	Peer     [2]uint64  `json:"peer_bytes"`
	Seconds  [2]float64 `json:"seconds"`
}

func serverChainThroughputRun(t *testing.T, e *serverChainThroughputEngine, hop hopmeasure.Hop) hopmeasure.Result {
	t.Helper()
	ctx, cancel := context.WithTimeout(t.Context(), hopmeasure.RequestTimeout)
	defer cancel()
	service, err := hopmeasure.NewContext(ctx, e, []hopmeasure.Hop{hop})
	if err != nil {
		t.Fatal("original position service", err)
	}
	defer func() {
		if err := service.Close(); err != nil {
			t.Error("position service did not close", err)
		}
	}()
	id := serverChainEncryptedRandom(t, 16)
	if err = service.StartContext(ctx, id, 8<<20); err != nil {
		t.Fatal("position service start", err)
	}
	for ctx.Err() == nil {
		var state hopmeasure.Status
		if json.Unmarshal([]byte(service.StatusContextJSON(ctx)), &state) != nil || state.Request != id {
			t.Fatal("lost original throughput request", hop.ID)
		}
		if state.Complete {
			if err = service.Drain(id); err != nil || len(state.Results) != 1 || state.Results[0].ID != hop.ID || state.Results[0].Kind != hop.Kind || state.Failure != "" {
				t.Fatal("original position terminal or join changed", hop.ID, err)
			}
			return state.Results[0]
		}
		time.Sleep(10 * time.Millisecond)
	}
	t.Fatal("position transfer timed out", hop.ID)
	return hopmeasure.Result{}
}

func serverChainMultipleThroughput(t *testing.T, w *serverChainEncryptedWorker, p *serverChainMultiplePeer, policy *mobilemultihop.NodeChainServerPolicy, c multihoprelay.NodeChainCapture) []serverChainThroughputReceipt {
	t.Helper()
	// The namespace driver is a fresh process for each case. Trust only the two
	// certificates from the original controls, with the shipping TLS verifier.
	dir := t.TempDir()
	ca := filepath.Join(dir, "selected-peer.pem")
	if err := os.WriteFile(ca, []byte(p.stats.Peer.PublicCA), 0600); err != nil {
		t.Fatal(err)
	}
	t.Setenv("SSL_CERT_FILE", ca)
	t.Setenv("SSL_CERT_DIR", filepath.Join(dir, "no-system-roots"))
	want := x509.NewCertPool()
	roots, err := x509.SystemCertPool()
	if err != nil || !want.AppendCertsFromPEM([]byte(p.stats.Peer.PublicCA)) || !want.Equal(roots) {
		t.Fatal("measurement lost original isolated TLS authorities")
	}
	routes, err := policy.FrontRoutes(c)
	if err != nil || len(routes) != 4 {
		t.Fatal("original four worker prefixes unavailable")
	}
	targets, err := policy.ProofTargets(c)
	if err != nil || len(targets) != 4 {
		t.Fatal("original four worker proofs unavailable")
	}
	var receipts []serverChainThroughputReceipt
	for i, route := range routes {
		target := targets[i]
		user := c.Request.Users[i]
		isPublic := i == 0 || i == 2
		if route.Position != i+1 || user.Position != route.Position || route.Tag != target.Proof.Tag || target.Proof.Position != route.Position ||
			target.Binding != route.Binding || route.Binding.CaptureSHA256 != w.digest || route.Username != user.Username || route.Password != user.Password ||
			route.PublicPathBenchmark != isPublic || route.Final != (i == 3) {
			t.Fatal("throughput source position changed", i)
		}
		hop := hopmeasure.Hop{ID: target.Proof.ProfileID, Role: "exit", Kind: "private-node", Tag: "proxy", API: target.API, Token: target.Token, Proof: target.Proof.NodeID}
		destination := target.Address
		if isPublic {
			hop.Kind, hop.Tag = "public-path", "custom-exit"
			destination = hopmeasure.PublicAddress
		}
		owner := &serverChainThroughputEngine{w, route, user, hop.Tag, destination}
		before := p.command(t, "stats")
		if i == 3 {
			// Retain the same original front user and destination. A foreign
			// API token at the actual final must yield no transferable score.
			bad := hop
			bad.Token = serverChainEncryptedRandom(t, 24)
			r := serverChainThroughputRun(t, owner, bad)
			denied := p.command(t, "stats")
			if r.Ready || r.Failure == "" || r.Download != nil || r.Upload != nil || denied.BenchmarkBytes != before.BenchmarkBytes || denied.BenchmarkDenied != before.BenchmarkDenied+1 {
				t.Fatal("foreign final API bearer produced an encrypted throughput result")
			}
		}
		result := serverChainThroughputRun(t, owner, hop)
		if !result.Ready || result.Failure != "" || result.Download == nil || result.Upload == nil || result.Idle == nil || result.Idle.Samples != 6 {
			t.Fatal("original worker prefix did not complete both transfers", i+1, result.Failure)
		}
		after := p.command(t, "stats")
		expected := before.BenchmarkBytes
		for direction, transfer := range []*hopmeasure.Transfer{result.Download, result.Upload} {
			if transfer.Bytes != 8<<20 || !(transfer.Seconds > 0) || !(transfer.Mbps > 0) {
				t.Fatal("original worker prefix lost transfer count or duration", i+1, direction)
			}
			expected[i][direction] += 8 << 20
		}
		if after.BenchmarkBytes != expected || (after.BenchmarkDNS > before.BenchmarkDNS) != isPublic || after.Peer.Final.DirectQueries != 0 {
			t.Fatal("transfer reached a different peer, size or DNS authority", i+1)
		}
		snapshot := w.call(t, "snapshot")
		if !snapshot.OK || snapshot.Receipt == nil || snapshot.Receipt.Phase != multihoprelay.NodeChainReady || !snapshot.Receipt.TrafficAllowed {
			t.Fatal("original worker retired during transfer", i+1)
		}
		receipts = append(receipts, serverChainThroughputReceipt{route.Position, hop.Kind,
			[2]int64{result.Download.Bytes, result.Upload.Bytes}, [2]uint64{after.BenchmarkBytes[i][0] - before.BenchmarkBytes[i][0], after.BenchmarkBytes[i][1] - before.BenchmarkBytes[i][1]}, [2]float64{result.Download.Seconds, result.Upload.Seconds}})
	}
	return receipts
}

func serverChainMultipleScenario(t *testing.T, name string) {
	t.Helper()
	layout := "sparse"
	if name == "adjacent" || name == "packet-first" {
		layout = name
	}
	p := serverChainMultiplePeerStart(t, layout, name == "throughput-sparse")
	policy, c := serverChainMultipleSource(t, p, name)
	switch name {
	case "wrong-public-first":
		p.command(t, "wrong-outer-public")
	case "wrong-public-second":
		p.command(t, "wrong-middle-public")
	case "failed-selected-dns":
		p.command(t, "fail-dns")
	}
	w := serverChainEncryptedWorkerStart(t, p.original, policy, c, "")
	pending := w.call(t, "snapshot")
	if !pending.OK || pending.Receipt == nil || pending.Receipt.Phase != multihoprelay.NodeChainPending || pending.Receipt.TrafficAllowed {
		t.Fatal("multiple-import pending gate is open")
	}
	final := c.Request.Users[len(c.Request.Users)-1]
	health := M.ParseSocksaddr("10.77.0.1:8787")
	w.refuse(t, final, health)
	baseline := p.command(t, "stats")
	// A real WG endpoint can exchange a captured keepalive during Box start.
	// It never grants an application request or any member proof.
	if baseline.TCP != 0 || baseline.Proofs != 0 || baseline.Peer.Middle.RawTCP != 0 || baseline.Peer.Middle.PublicQueries != 0 ||
		baseline.Peer.Prefixes[0].ProofQueries != 0 || baseline.Peer.Final.RouterQueries != 0 || baseline.Peer.Final.DNSQueries != 0 ||
		baseline.Peer.Final.FinalPublicQueries != 0 || baseline.Peer.Final.CoverPackets != 0 {
		t.Fatal("pending front forwarded application data or admitted a proof")
	}
	if !w.call(t, "bootstrap").OK {
		t.Fatal("original multiple-import bootstrap refused")
	}
	positive := name == "throughput-sparse" || name == "adjacent" || name == "sparse" || name == "packet-first" || name == "joined-active-udp"
	ready, failed := false, false
	deadline := time.Now().Add(15 * time.Second)
	for time.Now().Before(deadline) {
		response := w.call(t, "snapshot")
		if !response.OK {
			failed = true
			break
		}
		if response.Receipt.Phase == multihoprelay.NodeChainReady && response.Receipt.TrafficAllowed {
			ready = true
			break
		}
		time.Sleep(20 * time.Millisecond)
	}
	if positive != ready || failed == ready {
		t.Fatal("multiple-import gate published the wrong terminal state", name, ready, failed)
	}
	var packets net.PacketConn
	candidateConnects := 0
	var throughput []serverChainThroughputReceipt
	if ready {
		targets, err := policy.ProofTargets(c)
		if err != nil {
			t.Fatal(err)
		}
		last := targets[len(targets)-1]
		w.health(t, final, last.API, last.Token, last.Proof.NodeID)
		w.selectedDNS(t)
		if name == "throughput-sparse" {
			throughput = serverChainMultipleThroughput(t, w, p, policy, c)
		}
		if name == "sparse" {
			// The first original imported SS carries this paired WG prefix.
			// The final imported SS is outside the candidate's connect-only scope.
			candidateConnects = w.candidateAcceptance(t, policy, c, 2)
		}
		before := p.command(t, "stats")
		for _, member := range c.Request.Users[:len(c.Request.Users)-1] {
			w.refuse(t, member, health)
			w.refuse(t, member, uot.RequestDestination(2))
		}
		foreign := final
		foreign.Password = serverChainEncryptedRandom(t, 24)
		w.refuse(t, foreign, health)
		after := p.command(t, "stats")
		if after.Peer.Final.RouterQueries != before.Peer.Final.RouterQueries || after.Peer.Final.DNSQueries != before.Peer.Final.DNSQueries {
			t.Fatal("foreign/middle user reached final")
		}
		target := M.ParseSocksaddr("10.77.0.1:45999")
		packets = w.packets(t, target)
		defer packets.Close()
		payload := []byte(serverChainEncryptedRandom(t, 16))
		if n, err := packets.WriteTo(payload, target); err != nil || n != len(payload) {
			t.Fatal("captured UoT write", err)
		}
		buf := make([]byte, 2048)
		n, from, err := packets.ReadFrom(buf)
		if err != nil || from.String() != target.String() || !bytes.Equal(buf[:n], payload) {
			t.Fatal("original terminal UoT echo", err)
		}
		if name == "joined-active-udp" {
			p.command(t, "drop-cover")
			if _, err := packets.WriteTo(payload, target); err != nil {
				t.Fatal(err)
			}
			until := time.Now().Add(2 * time.Second)
			for time.Now().Before(until) {
				v := p.command(t, "stats").Peer.Final
				if v.CoverPackets > v.CoverReplies {
					break
				}
				time.Sleep(10 * time.Millisecond)
			}
		}
	} else {
		w.refuse(t, final, health)
	}
	st := p.command(t, "stats")
	outerProved := name != "wrong-key-first"
	innerReached := outerProved && name != "wrong-public-first"
	innerProved := innerReached && name != "wrong-key-second"
	finalReached := innerProved && name != "wrong-public-second"
	if st.TCP == 0 || (st.Proofs > 0) != outerProved || (st.Peer.Middle.RawTCP > 0) != innerReached || (st.Peer.Middle.PublicQueries > 0) != innerProved ||
		(st.Peer.Final.RouterQueries > 0) != finalReached || (st.Peer.Final.DNSQueries > 0) != finalReached || (st.Peer.Final.FinalPublicQueries > 0) != ready ||
		(st.OuterAuthFailures > 0) != (name == "wrong-key-first") || (st.InnerAuthFailures > 0) != (name == "wrong-key-second") ||
		(layout != "adjacent" && innerReached && st.Peer.Prefixes[0].RawUDP == 0) || (layout == "adjacent" || name == "wrong-key-first") && st.Peer.Prefixes[0].RawUDP != 0 ||
		(st.Peer.Prefixes[0].ProofQueries > 0) != (layout != "adjacent" && innerReached) {
		t.Fatal("wrong original proof boundary", name)
	}
	if ready && (st.UDP == 0 || st.Peer.Middle.RawUDP == 0 || st.Peer.Final.FinalRawUDP == 0 || st.Peer.Final.CoverReplies == 0) {
		t.Fatal("missing real encrypted UDP witnesses", name)
	}
	inFlight := st.Peer.Final.CoverPackets > st.Peer.Final.CoverReplies
	if inFlight != (name == "joined-active-udp") {
		t.Fatal("wrong in-flight packet at retirement")
	}
	w.stop(t)
	if packets != nil {
		_ = packets.SetReadDeadline(time.Now().Add(time.Second))
		if _, _, err := packets.ReadFrom(make([]byte, 2048)); err == nil {
			t.Fatal("original UDP survived joined Stop")
		}
	}
	_ = p.original.process.input.Close()
	p.original.process.join(t)
	receipt := map[string]any{"case": name, "capture_sha256": w.digest, "source_sha256": c.Source.SourceSHA256, "positions": c.Request.LocalPacketPositions,
		"ready": ready, "pending_closed": true, "outer_tcp": st.TCP, "outer_udp": st.UDP, "outer_proofs": st.Proofs, "outer_auth_failures": st.OuterAuthFailures, "inner_auth_failures": st.InnerAuthFailures,
		"packet_udp": st.Peer.Prefixes[0].RawUDP, "packet_proofs": st.Peer.Prefixes[0].ProofQueries, "inner_tcp": st.Peer.Middle.RawTCP, "inner_udp": st.Peer.Middle.RawUDP,
		"inner_proofs": st.Peer.Middle.PublicQueries, "final_health": st.Peer.Final.RouterQueries, "final_dns": st.Peer.Final.DNSQueries, "final_public": st.Peer.Final.FinalPublicQueries,
		"final_udp": st.Peer.Final.FinalRawUDP, "echo_replies": st.Peer.Final.CoverReplies, "in_flight": inFlight, "worker_joined": true, "peer_joined": true}
	if name == "sparse" {
		receipt["candidate_position"] = 2
		receipt["candidate_connects"] = candidateConnects
	}
	if name == "throughput-sparse" {
		receipt["throughput"] = throughput
		receipt["benchmark_dns"] = st.BenchmarkDNS
		receipt["wrong_bearer_refusals"] = st.BenchmarkDenied
	}
	t.Log("MULTIPLE_SERVER_RECEIPT " + serverChainEncryptedJSON(t, receipt))
}

func TestServerChainMultipleEncryptedNative(t *testing.T) {
	if os.Getenv("ROUTERVPN_SERVER_CHAIN_NATIVE_NS") != "1" || os.Geteuid() != 0 {
		t.Fatal("multiple-import worker needs original isolated namespace")
	}
	info, err := os.Stat("/proc/self/ns/net")
	outer := os.Getenv("ROUTERVPN_SERVER_CHAIN_OUTER_NETNS")
	if err != nil || outer == "" || fmt.Sprintf("%d:%d", info.Sys().(*syscall.Stat_t).Dev, info.Sys().(*syscall.Stat_t).Ino) == outer {
		t.Fatal("multiple-import worker retained host namespace")
	}
	for _, name := range serverChainMultipleCases {
		t.Run(name, func(t *testing.T) { serverChainMultipleScenario(t, name) })
	}
}
