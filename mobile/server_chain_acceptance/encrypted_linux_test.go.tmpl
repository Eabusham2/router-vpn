// This is an encrypted acceptance fixture, not a successful native callback
// double. The unchanged independent peer runs in its own network namespace;
// the actual shipping CLI owns Box, all WG/AWG/SS2022 engines, selected DNS,
// the authenticated front, proof lifetime, packet flows, and joined cleanup.
// The original peer CA is supplied through the OS verifier's SSL_CERT_FILE.
// No InsecureSkipVerify, fake proof, native registry replacement, or TUN is used.
var serverChainEncryptedCases = []string{"wg", "awg-fast", "awg-strong", "mixed-three", "wrong-first-key", "wrong-middle-key", "wrong-ss-key", "wrong-awg-parameters", "wrong-node", "failed-selected-dns", "wrong-public-trust", "cancel-prefix", "admission-restrictions", "joined-active-udp"}

