type RouterMultihop struct{ controller *mobilemultihop.Controller }

func NewRouterMultihop(config, metadata string) (*RouterMultihop, error) {
	c, e := mobilemultihop.New(config, metadata)
	if e != nil {
		return nil, e
	}
	return &RouterMultihop{c}, nil
}
func (m *RouterMultihop) Config() string       { return m.controller.Config() }
func (m *RouterMultihop) ProgressJSON() string { return m.controller.ProgressJSON() }

// Only public identities from the same healthy selected native owner cross
// this runtime-only restoration boundary. No private key or lease secret does.
func (m *RouterMultihop) ServerIdentityPinsJSON() (string, error) {
	return m.controller.ServerIdentityPinsJSON()
}
func (m *RouterMultihop) NetworkChanged() { m.controller.NetworkChanged() }
func (m *RouterMultihop) Healthy() bool   { return m.controller.Healthy() }
func (m *RouterMultihop) Close() error    { return m.controller.Close() }
func (m *RouterMultihop) Run(server *CommandServer) error {
	ctx, cancel := context.WithTimeout(context.Background(), routerMultihopObservationTimeout)
	engine, err := routerCapturedMultihopEngine(ctx, server)
	cancel()
	if err != nil {
		return err
	}
	return m.controller.Run(context.Background(), engine)
}
func routerCapturedMultihopEngine(ctx context.Context, server *CommandServer) (*routerMultihopEngine, error) {
	if ctx == nil || server == nil || server.StartedService == nil {
		return nil, errors.New("native multihop engine is not running")
	}
	instance, err := server.StartedService.RouterVPNInstanceContext(ctx)
	if err != nil {
		return nil, err
	}
	if instance == nil || instance.Box() == nil {
		return nil, errors.New("native multihop engine is not running")
	}
	engine := &routerMultihopEngine{server: server, instance: instance.Box()}
	if _, err := engine.IdentityContext(ctx); err != nil {
		return nil, err
	}
	return engine, nil
}

type routerMultihopEngine struct {
	server   *CommandServer
	instance *box.Box
}

// Match the existing native proof-observation policy without detached readers.
const routerMultihopObservationTimeout = 1500 * time.Millisecond

func (e *routerMultihopEngine) Identity() string {
	ctx, cancel := context.WithTimeout(context.Background(), routerMultihopObservationTimeout)
	defer cancel()
	identity, _ := e.IdentityContext(ctx)
	return identity
}
func (e *routerMultihopEngine) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if tag != mobilemultihop.LocalTag && tag != mobilemultihop.ServerTag && tag != "entry-wg" && tag != "routervpn-hop-entry" {
		return nil, errors.New("unowned outbound tag")
	}
	return e.dialOwned(ctx, tag, address)
}
func (e *routerMultihopEngine) dialOwned(ctx context.Context, tag, address string) (net.Conn, error) {
	if _, err := e.IdentityContext(ctx); err != nil {
		return nil, err
	}
	host, _, err := net.SplitHostPort(address)
	if err != nil || net.ParseIP(strings.Trim(host, "[]")) == nil {
		return nil, errors.New("routed probes require a literal destination")
	}
	outbound, found, err := adapter.RouterVPNOutboundContext(ctx, e.instance.Outbound(), tag)
	if err != nil {
		return nil, err
	}
	if !found {
		return nil, errors.New("native candidate outbound is missing")
	}
	connection, err := outbound.DialContext(ctx, "tcp", M.ParseSocksaddr(address))
	identityErr := error(nil)
	if _, identityErr = e.IdentityContext(ctx); identityErr == nil {
		var current adapter.Outbound
		current, found, identityErr = adapter.RouterVPNOutboundContext(ctx, e.instance.Outbound(), tag)
		if identityErr == nil && (!found || current != outbound) {
			identityErr = errors.New("native dial outbound owner changed")
		}
	}
	if err != nil || identityErr != nil || ctx.Err() != nil {
		if connection != nil {
			err = errors.Join(err, connection.Close())
		}
		return nil, errors.Join(err, identityErr, ctx.Err())
	}
	if connection == nil {
		return nil, errors.New("native outbound returned no connection")
	}
	return connection, nil
}
func (e *routerMultihopEngine) selectorContext(ctx context.Context) (*group.Selector, error) {
	if _, err := e.IdentityContext(ctx); err != nil {
		return nil, err
	}
	outbound, found, err := adapter.RouterVPNOutboundContext(ctx, e.instance.Outbound(), mobilemultihop.SelectorTag)
	if err != nil {
		return nil, err
	}
	if !found {
		return nil, errors.New("multihop selector missing")
	}
	selector, ok := outbound.(*group.Selector)
	if !ok {
		return nil, errors.New("unowned native selector")
	}
	if _, err := e.IdentityContext(ctx); err != nil {
		return nil, err
	}
	return selector, nil
}
func (e *routerMultihopEngine) selector() (*group.Selector, error) {
	ctx, cancel := context.WithTimeout(context.Background(), routerMultihopObservationTimeout)
	defer cancel()
	return e.selectorContext(ctx)
}
func (e *routerMultihopEngine) Select(tag string) error {
	ctx, cancel := context.WithTimeout(context.Background(), routerMultihopObservationTimeout)
	defer cancel()
	return e.SelectContext(ctx, tag)
}
func (e *routerMultihopEngine) SelectContext(ctx context.Context, tag string) error {
	if tag != mobilemultihop.LocalTag && tag != mobilemultihop.ServerTag {
		return errors.New("unproved execution selection")
	}
	selector, err := e.selectorContext(ctx)
	if err != nil {
		return err
	}
	current := func(ctx context.Context) error {
		original, err := e.selectorContext(ctx)
		if err != nil { return err }
		if original != selector { return errors.New("native selector owner changed") }
		return ctx.Err()
	}
	if err := selector.RouterVPNSelectOutboundContext(ctx, tag, current); err != nil { return err }
	if selector.Now() != tag {
		return errors.New("native selector refused winner")
	}
	return current(ctx)
}
func (e *routerMultihopEngine) Selected() string {
	ctx, cancel := context.WithTimeout(context.Background(), routerMultihopObservationTimeout)
	defer cancel()
	selected, _ := e.SelectedContext(ctx)
	return selected
}

