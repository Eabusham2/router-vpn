// NewRouterMultihopWithEntryStartLayer retains the captured comparison owner
// while the authenticated entry layer is added before any native engine starts.
func NewRouterMultihopWithEntryStartLayer(config, metadata, start string) (*RouterMultihop, error) {
	c, e := mobilemultihop.NewWithEntryStartLayer(config, metadata, start)
	if e != nil {
		return nil, e
	}
	return &RouterMultihop{c}, nil
}

// RouterCompileMultihopEntryStartLayer is pure preflight for private staging.
// Runtime creation repeats this validation; the returned proposal is not reused.
func RouterCompileMultihopEntryStartLayer(config, metadata, start string) (string, error) {
	c, e := mobilemultihop.NewWithEntryStartLayer(config, metadata, start)
	if e != nil {
		return "", e
	}
	defer c.Close()
	return c.Config(), nil
}

// NewRouterMultihopWithStartLayers binds both sources to the same native owner.
func NewRouterMultihopWithStartLayers(config, metadata, entry, exit string) (*RouterMultihop, error) {
	c, e := mobilemultihop.NewWithStartLayers(config, metadata, entry, exit)
	if e != nil {
		return nil, e
	}
	return &RouterMultihop{c}, nil
}

// Pure preflight must repeat at runtime; its random lease proposal is not reused.
func RouterCompileMultihopStartLayers(config, metadata, entry, exit string) (string, error) {
	c, e := mobilemultihop.NewWithStartLayers(config, metadata, entry, exit)
	if e != nil {
		return "", e
	}
	defer c.Close()
	return c.Config(), nil
}
