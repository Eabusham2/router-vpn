	t.Helper()
	port := remoteNativePort(t)
	tls := map[string]any{"certificate": []string{pki.provider}, "key": []string{pki.providerKey}, "client_certificate": []string{pki.ca}, "verify_client_certificate": "require", "remote_certificate_tls": "client"}
	remoteNativeStart(t, map[string]any{"log": map[string]any{"disabled": true}, "endpoints": []any{map[string]any{"type": "openvpn-server", "tag": "provider", "system": false, "listen": "127.0.0.1", "listen_port": port, "network": network, "address": []string{"10.211.18.1/24"}, "data_ciphers": []string{"AES-256-GCM", "AES-128-GCM"}, "tls": tls}}, "outbounds": []any{map[string]any{"type": "direct", "tag": "egress"}}, "route": map[string]any{"rules": []any{map[string]any{"ip_cidr": []string{"192.0.2.123/32"}, "port": []int{80}, "action": "route", "outbound": "egress", "override_address": "127.0.0.1", "override_port": echoPort}, map[string]any{"action": "reject"}}}})
