type remoteNativeOpenVPNNativeCertificates struct{ ca, provider, providerKey, local, localKey, relay, relayKey string }

func remoteNativeOpenVPNNativePKI(t *testing.T) remoteNativeOpenVPNNativeCertificates {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	ca := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "Private native OpenVPN test CA"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature}
	der, err := x509.CreateCertificate(rand.Reader, ca, ca, &key.PublicKey, key)
	if err != nil {
		t.Fatal(err)
	}
	result := remoteNativeOpenVPNNativeCertificates{ca: string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))}
	issue := func(serial int64, name string, usage x509.ExtKeyUsage) (string, string) {
		private, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
		if err != nil {
			t.Fatal(err)
		}
		cert := &x509.Certificate{SerialNumber: big.NewInt(serial), Subject: pkix.Name{CommonName: name}, NotBefore: ca.NotBefore, NotAfter: ca.NotAfter, KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{usage}, DNSNames: []string{name}}
		der, err := x509.CreateCertificate(rand.Reader, cert, ca, &private.PublicKey, key)
		if err != nil {
			t.Fatal(err)
		}
		secret, err := x509.MarshalPKCS8PrivateKey(private)
		if err != nil {
			t.Fatal(err)
		}
		return string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})), string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: secret}))
	}
	result.provider, result.providerKey = issue(2, "provider.routervpn.test", x509.ExtKeyUsageServerAuth)
	result.local, result.localKey = issue(3, "local-client.routervpn.test", x509.ExtKeyUsageClientAuth)
	result.relay, result.relayKey = issue(4, "relay-client.routervpn.test", x509.ExtKeyUsageClientAuth)
	return result
}

func remoteNativeOpenVPNNativeProfile(pki remoteNativeOpenVPNNativeCertificates, cert, key, network, control string) nativeopenvpn.Profile {
	config := "client\nremote 192.0.2.1 1194 " + network + "\nverify-x509-name provider.routervpn.test name\nremote-cert-tls server\ndata-ciphers AES-256-GCM:AES-128-GCM\ntun-mtu 1400\nhand-window 3\ntls-timeout 1\n<ca>\n" + pki.ca + "</ca>\n<cert>\n" + cert + "</cert>\n<key>\n" + key + "</key>\n"
	if control != "" {
		config += "<" + control + ">\n" + remoteNativeOpenVPNControlKey + "</" + control + ">\n"
		if control == "tls-auth" {
			config += "key-direction 1\n"
		}
	}
	return nativeopenvpn.Profile{Config: config}
}

var remoteNativeOpenVPNControlKey = "-----BEGIN OpenVPN Static key V1-----\n" + strings.Repeat(strings.Repeat("a", 32)+"\n", 16) + "-----END OpenVPN Static key V1-----\n"

type remoteNativePhysical struct {
	first, second int
	network       string
	calls         atomic.Int64
}

func (p *remoteNativePhysical) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	var port int
	switch destination.String() {
	case "192.0.2.1:1194":
		if network != "tcp" {
			return nil, errors.New("unowned first protocol")
		}
		port = p.first
	case "192.0.2.2:1443":
		if network != p.network {
			return nil, errors.New("unowned second protocol")
		}
		port = p.second
	default:
		return nil, errors.New("unowned physical destination")
	}
	p.calls.Add(1)
	return (&net.Dialer{}).DialContext(ctx, network, fmt.Sprintf("127.0.0.1:%d", port))
}
func (*remoteNativePhysical) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
	return nil, errors.New("unowned packet listener")
}

func remoteNativeFactory(parent context.Context, raw []byte, physical N.Dialer, dispatch func(uint64, func() error) error) (*routerVPNRelayBox, error) {
	ctx, cancel := context.WithCancel(include.Context(context.Background()))
	stop := context.AfterFunc(parent, cancel)
	if physical != nil {
		registry := service.FromContext[adapter.EndpointRegistry](ctx).(*E.Registry)
		E.Register[option.OpenVPNClientEndpointOptions](registry, "openvpn-client", func(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.OpenVPNClientEndpointOptions) (adapter.Endpoint, error) {
			owner, err := O.RouterVPNTestPhysicalClientEndpoint(ctx, router, logger, tag, options, physical)
			if err == nil && dispatch != nil {
				owner.(*O.ClientEndpoint).RouterVPNTestConfigurationDispatch(dispatch)
			}
			return owner, err
		})
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
	if err != nil {
		stop()
		cancel()
		return nil, err
	}
	owner, err := box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		stop()
		cancel()
		return nil, err
	}
	return &routerVPNRelayBox{Box: owner, cancel: cancel, stop: stop}, nil
}

func remoteNativePort(t *testing.T) int {
	t.Helper()
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	port := listener.Addr().(*net.TCPAddr).Port
	_ = listener.Close()
	return port
}
func remoteNativeStart(t *testing.T, root map[string]any) *routerVPNRelayBox {
	t.Helper()
	raw, _ := json.Marshal(root)
	owner, err := remoteNativeFactory(context.Background(), raw, nil, nil)
	if err != nil {
		t.Fatal(err)
	}
	if err = owner.Start(); err != nil {
		_ = owner.Close()
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := owner.Close(); !remoteNativeOnlyClosed(err) {
			t.Error(err)
		}
	})
	return owner
}

