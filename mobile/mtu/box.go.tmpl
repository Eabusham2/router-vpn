package box

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/adapter/inbound"
	"github.com/sagernet/sing-box/protocol/tun"
)

// RouterVPNChangeMTU uses the same receipt-bearing transaction as retained
// service owners. It never reloads the Box, selectors, keys or DNS policy.
func (s *Box) RouterVPNChangeMTU(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
	transaction, err := s.RouterVPNChangeMTUTransaction(ctx, expected, mtu)
	if transaction == nil {
		return expected, err
	}
	return transaction.Current(), err
}
func (s *Box) RouterVPNChangeMTUTransaction(ctx context.Context, expected adapter.Inbound, mtu int) (*inbound.RouterVPNTunTransaction, error) {
	select {
	case <-s.done:
		return nil, errors.New("MTU service is closed")
	default:
	}
	original, ok := expected.(*tun.Inbound)
	if !ok {
		return nil, errors.New("captured inbound is not the native TUN")
	}
	current, exists, err := adapter.RouterVPNInboundContext(ctx, s.inbound, expected.Tag())
	if err != nil {
		return nil, err
	}
	if !exists || current != expected || ctx == nil || ctx.Err() != nil {
		return nil, errors.New("MTU inbound ownership changed")
	}
	return s.inbound.RouterVPNReplaceTunOwned(ctx, expected, func() (adapter.Inbound, adapter.Inbound, error) { return original.RouterVPNMTUReadersContext(ctx, mtu) })
}
func (s *Box) RouterVPNRetryMTUTransaction(ctx context.Context, transaction *inbound.RouterVPNTunTransaction) error {
	return s.inbound.RouterVPNRetryTunTransaction(ctx, transaction)
}
