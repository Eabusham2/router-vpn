package inbound

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemtu"
	"sync"
	"testing"
	"time"
)

type mtuTestInbound struct {
	mu              sync.Mutex
	tag, kind       string
	alive           bool
	started, closed int
	failure         adapter.StartStage
	fail, closeFail bool
	gate            chan struct{}
	entered         chan struct{}
}

func (t *mtuTestInbound) Tag() string  { return t.tag }
func (t *mtuTestInbound) Type() string { return t.kind }
func (t *mtuTestInbound) Start(stage adapter.StartStage) error {
	if stage == adapter.StartStateStart && t.gate != nil {
		close(t.entered)
		<-t.gate
	}
	t.mu.Lock()
	defer t.mu.Unlock()
	t.started++
	if t.fail && stage == t.failure {
		return errors.New("fixture start error")
	}
	t.alive = true
	return nil
}
func (t *mtuTestInbound) Close() error {
	t.mu.Lock()
	defer t.mu.Unlock()
	t.closed++
	t.alive = false
	if t.closeFail {
		return errors.New("fixture close error")
	}
	return nil
}
func mtuFixture() (*Manager, *mtuTestInbound, *mtuTestInbound, *mtuTestInbound) {
	a := &mtuTestInbound{tag: "tun", kind: "tun", alive: true}
	b := &mtuTestInbound{tag: "tun", kind: "tun"}
	r := &mtuTestInbound{tag: "tun", kind: "tun"}
	m := &Manager{started: true, stage: adapter.StartStateStarted, inbounds: []adapter.Inbound{a}, inboundByTag: map[string]adapter.Inbound{"tun": a}}
	return m, a, b, r
}
func TestRouterVPNTunReplacementAndRollback(t *testing.T) {
	for _, fail := range []bool{false, true} {
		m, a, b, r := mtuFixture()
		b.fail = fail
		b.failure = adapter.StartStatePostStart
		current, err := m.RouterVPNReplaceTun(context.Background(), a, b, r)
		if fail {
			if err == nil || current != r || !r.alive || b.alive {
				t.Fatal("failed replacement not restored")
			}
		} else {
			if err != nil || current != b || !b.alive || r.alive {
				t.Fatal("candidate not adopted")
			}
		}
		if a.alive || a.closed != 1 {
			t.Fatal("old TUN retained its native reader")
		}
		got, ok := m.Get("tun")
		if !ok || got != current {
			t.Fatal("wrong registered owner")
		}
	}
}
func TestRouterVPNTunFailureDoesNotStartAnOverlappingReader(t *testing.T) {
	m, a, b, r := mtuFixture()
	b.fail = true
	b.closeFail = true
	current, err := m.RouterVPNReplaceTun(context.Background(), a, b, r)
	if current != nil || err == nil || r.started != 0 {
		t.Fatal("unconfirmed shutdown allowed overlap")
	}
	if _, ok := m.inboundByTag["tun"]; ok {
		t.Fatal("failed owner still published")
	}
}
func TestRouterVPNTunInvalidationAndStaleCapture(t *testing.T) {
	m, a, b, r := mtuFixture()
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	if _, err := m.RouterVPNReplaceTun(ctx, a, b, r); err == nil || a.closed != 0 || b.closed != 1 || r.closed != 1 {
		t.Fatal("cancelled work changed live TUN")
	}
	m, a, b, r = mtuFixture()
	other := &mtuTestInbound{tag: "tun", kind: "tun"}
	if _, err := m.RouterVPNReplaceTun(context.Background(), other, b, r); err == nil || a.closed != 0 || b.closed != 1 || r.closed != 1 {
		t.Fatal("stale pointer mutated current TUN")
	}
}
func TestRouterVPNTunMutationIsSerialized(t *testing.T) {
	m, a, b, r := mtuFixture()
	b.gate = make(chan struct{})
	b.entered = make(chan struct{})
	completed := make(chan struct{})
	go func() { defer close(completed); _, _ = m.RouterVPNReplaceTun(context.Background(), a, b, r) }()
	<-b.entered
	other := &mtuTestInbound{tag: "tun", kind: "tun"}
	backup := &mtuTestInbound{tag: "tun", kind: "tun"}
	second := make(chan error, 1)
	go func() { _, err := m.RouterVPNReplaceTun(context.Background(), a, other, backup); second <- err }()
	select {
	case <-second:
		t.Fatal("replacement lock did not serialize ownership")
	case <-time.After(10 * time.Millisecond):
	}
	close(b.gate)
	<-completed
	if err := <-second; err == nil {
		t.Fatal("second stale operation replaced winner")
	}
	if other.started != 0 {
		t.Fatal("stale candidate started")
	}
}

func TestRouterVPNTunBorrowedPlatformKeepsCapturedRollback(t *testing.T) {
	m, original, candidate, rollback := mtuFixture()
	ctx, cancel := context.WithCancel(context.Background())
	candidate.gate = make(chan struct{})
	candidate.entered = make(chan struct{})
	done := make(chan adapter.Inbound, 1)
	go func() { current, _ := m.RouterVPNReplaceTun(ctx, original, candidate, rollback); done <- current }()
	<-candidate.entered
	cancel()
	close(candidate.gate)
	if current := <-done; current != rollback || !rollback.alive || candidate.alive {
		t.Fatal("borrowed platform lost its existing captured rollback semantics")
	}
	cleanup, cancelCleanup := context.WithTimeout(context.Background(), time.Second)
	defer cancelCleanup()
	if err := m.RouterVPNCloseNativeTunContext(cleanup); err != nil || rollback.closed != 0 || !rollback.alive {
		t.Fatal("native pre-retirement consumed a borrowed or generic reader", err, rollback.closed)
	}
	if err := m.Close(); err != nil || rollback.closed != 1 || rollback.alive {
		t.Fatal("ordinary manager did not close its exact borrowed reader once", err, rollback.closed)
	}
}

type mtuCloseCallback struct {
	*mtuTestInbound
	afterClose func()
}

func (t *mtuCloseCallback) Close() error {
	err := t.mtuTestInbound.Close()
	if t.afterClose != nil {
		t.afterClose()
	}
	return err
}
func TestRouterVPNTunContextRejectsLatePublicationAfterUnusedClose(t *testing.T) {
	m, original, candidate, unused := mtuFixture()
	work, finish, err := mobilemtu.WithOperationContext(context.Background(), time.Second, time.Second)
	if err != nil {
		t.Fatal(err)
	}
	defer finish()
	work, cancel := context.WithCancel(work)
	defer cancel()
	checked := false
	rollback := &mtuCloseCallback{mtuTestInbound: unused, afterClose: func() {
		checked = true
		if work.Err() != nil || m.inboundByTag[original.Tag()] != candidate {
			t.Error("candidate was not owned before unused-reader close")
		}
		cancel()
	}}
	transaction, err := m.RouterVPNReplaceTunOwned(work, original, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
	if !checked || !errors.Is(err, context.Canceled) || transaction == nil || transaction.Current() != candidate || m.inboundByTag[original.Tag()] != candidate {
		t.Fatal("cancellation discarded original provisional reader or error", err)
	}
	evidence := transaction.Evidence()
	if !candidate.alive || !evidence[1].Started || evidence[1].Retired || !evidence[2].Retired {
		t.Fatal("provisional candidate or unused-reader retirement was inferred", evidence)
	}
	cleanup, err := mobilemtu.OperationCleanupContext(work)
	if err != nil {
		t.Fatal(err)
	}
	restored := &mtuTestInbound{tag: "tun", kind: "tun"}
	unusedAgain := &mtuTestInbound{tag: "tun", kind: "tun"}
	restore, err := m.RouterVPNReplaceTunOwned(cleanup, candidate, func() (adapter.Inbound, adapter.Inbound, error) { return restored, unusedAgain, nil })
	if err != nil || restore.Current() != restored || !restored.alive || candidate.alive {
		t.Fatal("original cleanup could not replace exact provisional candidate", err)
	}
	if unused.started != 0 || unused.closed != 1 {
		t.Fatal("retired unused rollback was restarted")
	}
}
func TestRouterVPNTunContextAdmissionLocksDoNotConstructLate(t *testing.T) {
	for _, boundary := range []string{"lifecycle", "access"} {
		t.Run(boundary, func(t *testing.T) {
			m, original, candidate, rollback := mtuFixture()
			if boundary == "lifecycle" {
				m.routervpnLifecycle.Lock()
			} else {
				m.access.Lock()
			}
			ctx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
			defer cancel()
			called := false
			done := make(chan error, 1)
			go func() {
				_, err := m.RouterVPNReplaceTunOwned(ctx, original, func() (adapter.Inbound, adapter.Inbound, error) { called = true; return candidate, rollback, nil })
				done <- err
			}()
			select {
			case err := <-done:
				if !errors.Is(err, context.DeadlineExceeded) {
					t.Errorf("original context lost: %v", err)
				}
			case <-time.After(time.Second):
				t.Error("mutation admission ignored caller deadline")
			}
			if boundary == "lifecycle" {
				m.routervpnLifecycle.Unlock()
			} else {
				m.access.Unlock()
			}
			if called || original.closed != 0 || candidate.started != 0 {
				t.Fatal("expired admission acquired native resources")
			}
		})
	}
}
