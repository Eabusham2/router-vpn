package libbox

import (
 "context"
 "errors"
 "net"
 "net/netip"
 "strconv"
 "strings"
 "sync"
 "sync/atomic"
 "syscall"
 "time"

 "github.com/sagernet/sing-box/adapter"
 "github.com/sagernet/sing-box/daemon"
 "github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemtu"
)

type RouterMTUState struct { Session string; Path string; Interface string; MTU int32 }

type RouterMTUPlatform interface {
 CaptureMTU() *RouterMTUState
 BeginMTUChange(expected *RouterMTUState) error
 EndMTUChange() error
 BindMTUSocket(expected *RouterMTUState, fd int64) error
 ReadMTUCache() string
 CompareAndSwapMTUCache(expected, replacement string) bool
 AbortMTU(reason string)
}

type RouterMTU struct { controller *mobilemtu.Controller; owner *routerMTUOwner }
type routerMTUOwner struct {
 mu sync.Mutex
 invalid atomic.Bool
 platform RouterMTUPlatform
 server *CommandServer
 instance *daemon.Instance
 inbound adapter.Inbound
 session, path string
 external routerMTUExternalLease
 proofCurrent func() bool
 proofCurrentContext func(context.Context) error
 // This constructor-only context is cleared before the owner is published.
 initialContext context.Context
}

const routerMTUObservationBudget = 1500 * time.Millisecond
var _ mobilemtu.ContextOwner = (*routerMTUOwner)(nil)

type routerMTUPreferences struct { platform RouterMTUPlatform }
func (p routerMTUPreferences) ReadMTUCache() (string, error) {
 raw := p.platform.ReadMTUCache()
 if len(raw) > 65536 { return "", errors.New("MTU preferences exceed their bound") }
 return raw, nil
}
func (p routerMTUPreferences) CompareAndSwapMTUCache(a, b string) (bool, error) {
 if len(a) > 65536 || len(b) > 65536 { return false, errors.New("MTU preference write exceeds its bound") }
 return p.platform.CompareAndSwapMTUCache(a,b), nil
}
func routerMTUState(value *RouterMTUState) (mobilemtu.State,error) {
 if value == nil || value.Session == "" || value.Path == "" || value.Interface == "" || len(value.Session)>128 || len(value.Path)>256 || len(value.Interface)>128 || value.MTU<1280 || value.MTU>9000 {
  return mobilemtu.State{}, errors.New("native MTU interface readback is unavailable")
 }
 return mobilemtu.State{Session:value.Session, Path:value.Path, Interface:value.Interface, MTU:int(value.MTU)},nil
}
func routerMTUExport(s mobilemtu.State) *RouterMTUState { return &RouterMTUState{Session:s.Session,Path:s.Path,Interface:s.Interface,MTU:int32(s.MTU)} }

func NewRouterMTU(server *CommandServer, platform RouterMTUPlatform, config, profile string) (*RouterMTU,error) {
 ctx,cancel:=context.WithTimeout(context.Background(),routerMTUObservationBudget);defer cancel()
 return newRouterMTUContext(ctx,server,platform,config,profile)
}
func newRouterMTUContext(ctx context.Context, server *CommandServer, platform RouterMTUPlatform, config, profile string) (*RouterMTU,error) {
 if server==nil || server.StartedService==nil || platform==nil { return nil,errors.New("MTU requires a running native command server and platform") }
 instance,err:=server.StartedService.RouterVPNInstanceContext(ctx);if err!=nil{return nil,err}
 if instance==nil || instance.Box()==nil { return nil,errors.New("MTU native service is not running") }
 state,err:=routerMTUState(platform.CaptureMTU());if err!=nil{return nil,err}
 plan,err:=mobilemtu.NewPlan(config,state.MTU);if err!=nil{return nil,err}
 inbound,ok,err:=adapter.RouterVPNInboundContext(ctx,instance.Box().Inbound(),plan.TunTag);if err!=nil{return nil,err}
 if !ok || inbound==nil || inbound.Type()!="tun" { return nil,errors.New("MTU graph does not own the live TUN") }
 owner:=&routerMTUOwner{platform:platform,server:server,instance:instance,inbound:inbound,session:state.Session,path:state.Path,initialContext:ctx}
 defer func(){owner.initialContext=nil}()
 controller,err:=mobilemtu.New(owner,config,profile,mobilemtu.NewCache(routerMTUPreferences{platform}))
 if err!=nil{return nil,err}
 current,err:=owner.CaptureContext(ctx)
 if err!=nil||current!=state{_ = controller.Close();return nil,errors.Join(err,errors.New("MTU native owner changed during capture"))}
 return &RouterMTU{controller:controller,owner:owner},nil
}
func (m *RouterMTU) Start(request string,force bool) error { if m==nil||m.controller==nil{return errors.New("MTU owner is missing")};return m.controller.Start(request,force) }
func (m *RouterMTU) Cancel(request string) { if m!=nil&&m.controller!=nil{m.controller.Cancel(request)} }
func (m *RouterMTU) NetworkChanged() { if m!=nil&&m.owner!=nil{m.owner.invalid.Store(true);m.controller.Invalidate()} }
func (m *RouterMTU) Close() error {
 if m==nil||m.controller==nil{return nil}
 m.owner.invalid.Store(true)
 if err:=m.controller.Close();err!=nil{return err}
 // A timed-out drain retains the exact claim, so a replacement optimizer
 // cannot overlap its still-owned native transaction or public socket.
 if m.owner.external!=nil{m.owner.external.Close()}
 return nil
}
func (m *RouterMTU) Running() bool { return m!=nil&&m.controller!=nil&&m.controller.Running() }
func (m *RouterMTU) StatusJSON() string { if m==nil||m.controller==nil{return "{}"};return m.controller.StatusJSON() }
func (o *routerMTUOwner) currentLockedContext(ctx context.Context) error {
 if ctx==nil{return errors.New("MTU native observation has no caller")}
 if err:=ctx.Err();err!=nil{return err}
 if o==nil||o.invalid.Load()||o.server==nil||o.server.StartedService==nil||o.instance==nil||o.instance.Box()==nil||o.inbound==nil{return errors.New("MTU native session was replaced or stopped")}
 instance,err:=o.server.StartedService.RouterVPNInstanceContext(ctx)
 if err!=nil{return err}
 if instance!=o.instance{return errors.New("MTU native instance changed")}
 if o.proofCurrentContext!=nil {
  if err:=o.proofCurrentContext(ctx);err!=nil{return err}
 } else if o.external==nil&&o.proofCurrent!=nil&&!o.proofCurrent(){return errors.New("MTU native proof retired")}
 if o.external!=nil {
  var captured adapter.Inbound
  if bounded,ok:=o.external.(interface{HealthyContext(context.Context)error;InboundContext(context.Context)(adapter.Inbound,error)});ok {
   if err=bounded.HealthyContext(ctx);err!=nil{return err}
   captured,err=bounded.InboundContext(ctx)
  } else {
   // Legacy Tor leases retain their original proof contract until their own
   // context capability is supplied; no claim is made that this callback is bounded.
   if o.proofCurrent==nil||!o.proofCurrent(){return errors.New("MTU native proof retired")}
   captured,err=o.external.Inbound()
  }
  if err!=nil{return err}
  if captured!=o.inbound{return errors.New("MTU proof owns another native TUN")}
 }
 current,ok,err:=adapter.RouterVPNInboundContext(ctx,o.instance.Box().Inbound(),o.inbound.Tag())
 if err!=nil{return err}
 if !ok||current!=o.inbound{return errors.New("MTU native TUN changed")}
 return ctx.Err()
}
func (o *routerMTUOwner) captureLockedContext(ctx context.Context) (mobilemtu.State,error) {
 if err:=o.currentLockedContext(ctx);err!=nil{return mobilemtu.State{},err}
 state,err:=routerMTUState(o.platform.CaptureMTU())
 if err!=nil{return mobilemtu.State{},err}
 if state.Session!=o.session||state.Path!=o.path{return mobilemtu.State{},errors.New("MTU physical path or session changed")}
 if err=o.currentLockedContext(ctx);err!=nil{return mobilemtu.State{},err}
 return state,nil
}
func (o *routerMTUOwner) CaptureContext(ctx context.Context) (mobilemtu.State,error) {
 if o==nil{return mobilemtu.State{},errors.New("MTU owner is missing")}
 if err:=adapter.RouterVPNLockContext(ctx,&o.mu);err!=nil{return mobilemtu.State{},err}
 defer o.mu.Unlock();return o.captureLockedContext(ctx)
}
func (o *routerMTUOwner) Capture() (mobilemtu.State,error) {
 if o!=nil&&o.initialContext!=nil{return o.CaptureContext(o.initialContext)}
 ctx,cancel:=context.WithTimeout(context.Background(),routerMTUObservationBudget);defer cancel()
 return o.CaptureContext(ctx)
}
func (o *routerMTUOwner) ChangeMTU(ctx context.Context, expected mobilemtu.State, mtu int) (mobilemtu.State,error) {
 if o==nil{return expected,errors.New("MTU owner is missing")}
 if err:=adapter.RouterVPNLockContext(ctx,&o.mu);err!=nil{return expected,err};defer o.mu.Unlock()
 state,err:=o.captureLockedContext(ctx)
 if err!=nil{return state,err}
 if state!=expected||mtu<1280||mtu>9000{return state,errors.New("stale or invalid MTU mutation")}
 if mtu==state.MTU{return state,nil}
 if !mobilemtu.SameOperationContext(ctx,ctx) {
  captured,finish,err:=mobilemtu.WithCleanupContext(ctx,3*time.Second);if err!=nil{return state,err};defer finish();ctx=captured
 }
 if err=o.platform.BeginMTUChange(routerMTUExport(expected));err!=nil{return state,err}
 var current adapter.Inbound
 var changeErr error
 if o.external!=nil{current,changeErr=o.external.ChangeMTU(ctx,o.inbound,mtu)}else{current,changeErr=o.instance.Box().RouterVPNChangeMTU(ctx,o.inbound,mtu)}
 o.inbound=current
 endErr:=o.platform.EndMTUChange()
 // A cancelled work read cannot erase this transaction's returned reader.
 // Finalization uses only the original operation's one cleanup allowance.
 after,captureErr:=o.captureLockedContext(ctx)
 if ctx.Err()!=nil&&(errors.Is(captureErr,context.Canceled)||errors.Is(captureErr,context.DeadlineExceeded)) {
  cleanup,cleanupErr:=mobilemtu.OperationCleanupContext(ctx)
  if cleanupErr!=nil{captureErr=cleanupErr}else{after,captureErr=o.captureLockedContext(cleanup)}
 }
 if current==nil||endErr!=nil||captureErr!=nil {
  o.invalid.Store(true)
  // The platform must queue shutdown, never synchronously re-enter this owner.
  o.platform.AbortMTU("MTU transaction lost its captured native TUN")
  return mobilemtu.State{},errors.New("native MTU application or rollback could not be confirmed")
 }
 if changeErr!=nil{return after,changeErr}
 if after.MTU!=mtu{return after,errors.New("native MTU readback differs from the candidate")}
 if ctx.Err()!=nil{return after,ctx.Err()}
 return after,nil
}
func (o *routerMTUOwner) DialThroughTunnel(ctx context.Context, expected mobilemtu.State, network,address string) (net.Conn,error) {
 if o.external!=nil{return o.dialExternal(ctx,expected,network,address)}
 // The controller further restricts these sockets to the frozen paired endpoint.
 host,port,err:=net.SplitHostPort(address);ip,ipErr:=netip.ParseAddr(host);number,portErr:=strconv.Atoi(port)
 if err!=nil||ipErr!=nil||portErr!=nil||number<1||number>65535||!ip.IsPrivate()||ip.Zone()!=""||ip.Is4In6()||(network!="tcp"&&network!="udp"){return nil,errors.New("invalid private MTU socket target")}
 return o.dialBoundSocket(ctx,expected,network,address)
}
// All destinations are validated by the private or external caller before
// this primitive receives a literal address. It never invokes a DNS resolver.
func (o *routerMTUOwner) dialBoundSocket(ctx context.Context, expected mobilemtu.State, network,address string) (net.Conn,error) {
 host,_,parseErr:=net.SplitHostPort(address)
 if _,err:=netip.ParseAddr(host);parseErr!=nil||err!=nil{return nil,errors.New("MTU binding requires a literal address")}
 state,err:=o.CaptureContext(ctx);if err!=nil||state!=expected{return nil,errors.Join(err,errors.New("stale MTU socket owner"))}
 dialer:=net.Dialer{ControlContext:func(ctx context.Context, transport,address string, raw syscall.RawConn)error{
  state,err:=o.CaptureContext(ctx);if err!=nil||state!=expected{return errors.Join(err,errors.New("MTU socket invalidated before binding"))}
  var bindErr error
  if err=raw.Control(func(fd uintptr){
   bindErr=o.platform.BindMTUSocket(routerMTUExport(expected),int64(fd))
   if bindErr==nil&&strings.HasPrefix(transport,"udp"){bindErr=routerMTUNoFragment(int(fd),strings.HasSuffix(transport,"6"))}
  });err!=nil{return err}
  if bindErr!=nil{return bindErr}
  state,err=o.CaptureContext(ctx);if err!=nil||state!=expected{return errors.Join(err,errors.New("MTU socket invalidated while binding"))}
  return nil
 }}
 conn,err:=dialer.DialContext(ctx,network,address);if err!=nil{return nil,err}
 state,err=o.CaptureContext(ctx);if err!=nil||state!=expected{_ = conn.Close();return nil,errors.Join(err,errors.New("MTU socket invalidated during connect"))}
 return conn,nil
}
