package box_test

import (
	"context"
	"testing"

	box "github.com/sagernet/sing-box"
	"github.com/sagernet/sing-box/include"
	"github.com/sagernet/sing-box/option"
	SJ "github.com/sagernet/sing/common/json"
)

// Construct real native TUN adapters without opening an OS interface. The
// ownership rejection occurs before any reader or platform mutation starts.
func mtuBoxFixture(t *testing.T) *box.Box {
	t.Helper()
	ctx,cancel:=context.WithCancel(context.Background());t.Cleanup(cancel)
	ctx=box.Context(ctx,include.InboundRegistry(),include.OutboundRegistry(),include.EndpointRegistry(),include.DNSTransportRegistry(),include.ServiceRegistry(),include.CertificateProviderRegistry())
	options,err:=SJ.UnmarshalExtendedContext[option.Options](ctx,[]byte(`{"log":{"disabled":true},"inbounds":[{"type":"tun","tag":"tun-in","mtu":1280,"address":["172.29.97.1/30"],"auto_route":true,"strict_route":true,"stack":"system"}],"outbounds":[{"type":"direct","tag":"direct"}],"route":{"final":"direct"}}`))
	if err!=nil{t.Fatal(err)}
	engine,err:=box.New(box.Options{Context:ctx,Options:options})
	if err!=nil{t.Fatal(err)}
	t.Cleanup(func(){_ = engine.Close()})
	return engine
}

func TestRouterVPNMTUStaleCaptureCannotAdoptAnotherNativeReader(t *testing.T) {
	live,old:=mtuBoxFixture(t),mtuBoxFixture(t)
	current,ok:=live.Inbound().Get("tun-in");if !ok{t.Fatal("actual native TUN missing")}
	expected,ok:=old.Inbound().Get("tun-in");if !ok||expected==current{t.Fatal("independent native TUN fixture missing")}
	result,err:=live.RouterVPNChangeMTU(context.Background(),expected,1400)
	if err==nil || result!=expected || result==current {t.Fatal("stale transaction adopted the unrelated current reader",err)}
	still,ok:=live.Inbound().Get("tun-in");if !ok||still!=current{t.Fatal("stale transaction mutated the live interface")}
	ctx,cancel:=context.WithCancel(context.Background());cancel()
	result,err=live.RouterVPNChangeMTU(ctx,current,1400)
	if err==nil||result!=current{t.Fatal("canceled transaction lost its captured owner")}
}
