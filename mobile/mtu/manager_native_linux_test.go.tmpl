// These are explicit native-call models around the actual shipping manager.
// Real kernel receipts and Box calls are covered by the separate namespace gate.
type mtuEvidenceInbound struct {
	*mtuTestInbound
	label               string
	deadline            time.Time
	retireFailure       bool
	readyReads, retires int
	retired             bool
}

func (e *mtuEvidenceInbound) RouterVPNDesktopMTUReceiptContext(ctx context.Context) (string, string, error) {
	e.mu.Lock()
	defer e.mu.Unlock()
	if ctx == nil || ctx.Err() != nil {
		return "", "", context.Canceled
	}
	deadline, ok := ctx.Deadline()
	if !ok || !deadline.Equal(e.deadline) {
		return "", "", errors.New("model received renewed native budget")
	}
	if e.retired {
		return "", "retired:" + e.label, nil
	}
	if e.alive {
		e.readyReads++
		return "ready:" + e.label, "", nil
	}
	return "", "", nil
}
func (e *mtuEvidenceInbound) RouterVPNDesktopTunCloseContext(ctx context.Context) error {
	e.mu.Lock()
	defer e.mu.Unlock()
	if ctx == nil || ctx.Err() != nil {
		return context.Canceled
	}
	e.retires++
	if e.retireFailure {
		return errors.New("modeled original native close failed")
	}
	e.alive = false
	e.retired = true
	e.closed++
	return nil
}
func mtuEvidenceFixture(t *testing.T) (context.Context, *Manager, *mtuEvidenceInbound, func(string) *mtuEvidenceInbound) {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	t.Cleanup(cancel)
	deadline, _ := ctx.Deadline()
	makeReader := func(label string) *mtuEvidenceInbound {
		return &mtuEvidenceInbound{mtuTestInbound: &mtuTestInbound{tag: "tun", kind: "tun"}, label: label, deadline: deadline}
	}
	original := makeReader("original")
	original.alive = true
	m := &Manager{started: true, stage: adapter.StartStateStarted, inbounds: []adapter.Inbound{original}, inboundByTag: map[string]adapter.Inbound{"tun": original}}
	return ctx, m, original, makeReader
}
func TestRouterVPNTunTransactionRetainsOriginalAndPartialCandidateEvidence(t *testing.T) {
	for _, failure := range []bool{false, true} {
		t.Run(map[bool]string{false: "candidate", true: "rollback"}[failure], func(t *testing.T) {
			ctx, m, original, makeReader := mtuEvidenceFixture(t)
			candidate, rollback := makeReader("candidate"), makeReader("rollback")
			candidate.fail = failure
			candidate.failure = adapter.StartStatePostStart
			transaction, err := m.RouterVPNReplaceTunOwned(ctx, original, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
			if transaction == nil || failure != (err != nil) {
				t.Fatal("transaction outcome lost actual native operation", err)
			}
			evidence := transaction.Evidence()
			if len(evidence) != 3 || evidence[0].Inbound != original || evidence[0].Ready != "ready:original" || evidence[0].Retirement != "retired:original" || !evidence[0].Retired {
				t.Fatal("original ready and retirement evidence lost", evidence)
			}
			if failure {
				if transaction.Current() != rollback || evidence[1].Inbound != candidate || !evidence[1].StartAttempted || evidence[1].Started || !evidence[1].Retired || evidence[1].Retirement != "retired:candidate" || evidence[2].Ready != "ready:rollback" {
					t.Fatal("partial candidate history or exact rollback lost", evidence)
				}
			} else if transaction.Current() != candidate || evidence[1].Ready != "ready:candidate" || evidence[2].Retirement != "retired:rollback" {
				t.Fatal("successful candidate lost unused native owner", evidence)
			}
			// Returned slices cannot mutate the original retained record.
			evidence[0].Ready = "foreign"
			if transaction.Evidence()[0].Ready != "ready:original" {
				t.Fatal("caller rewrote original transaction history")
			}
		})
	}
}
func TestRouterVPNTunTransactionPreservesFailedConstructionAndRetry(t *testing.T) {
	ctx, m, original, makeReader := mtuEvidenceFixture(t)
	candidate := makeReader("partial-constructor")
	candidate.retireFailure = true
	transaction, err := m.RouterVPNReplaceTunOwned(ctx, original, func() (adapter.Inbound, adapter.Inbound, error) {
		return candidate, nil, errors.New("constructor failed")
	})
	if err == nil || transaction.Current() != original || original.closed != 0 || len(m.routervpnMTUPending) != 1 || len(m.routervpnRetired) != 1 {
		t.Fatal("partial constructor ownership dropped", err)
	}
	evidence := transaction.Evidence()
	if !evidence[1].Pending || evidence[1].Inbound != candidate || evidence[1].Ready != "" {
		t.Fatal("partial adapter fabricated Ready", evidence)
	}
	foreign, _, _, _ := mtuEvidenceFixture(t)
	if err := (&Manager{}).RouterVPNRetryTunTransaction(foreign, transaction); err == nil {
		t.Fatal("foreign manager retired original partial adapter")
	}
	candidate.retireFailure = false
	if err := m.RouterVPNRetryTunTransaction(ctx, transaction); err != nil {
		t.Fatal(err)
	}
	if len(m.routervpnMTUPending) != 0 || len(m.routervpnRetired) != 0 || original.closed != 0 || transaction.Evidence()[1].Retirement != "retired:partial-constructor" {
		t.Fatal("retry did not settle only original partial adapter")
	}
	original.retireFailure = true
	if err := m.RouterVPNCloseNativeTunContext(ctx); err == nil || original.closed != 0 || !original.alive {
		t.Fatal("native pre-retirement skipped or discarded its original failed reader", err)
	}
	original.retireFailure = false
	if err := m.RouterVPNCloseNativeTunContext(ctx); err != nil || original.closed != 1 || !original.retired {
		t.Fatal("native pre-retirement did not settle its original reader", err, original.closed)
	}
}
func TestRouterVPNTunTransactionBoundsHistoryBeforeAcquisition(t *testing.T) {
	ctx, m, original, makeReader := mtuEvidenceFixture(t)
	current := adapter.Inbound(original)
	var pending []*RouterVPNTunTransaction
	var abandoned []*mtuEvidenceInbound
	factories := 0
	for i := 0; i < routerVPNMTUPendingLimit; i++ {
		candidate, rollback := makeReader("candidate"), makeReader("pending-unused")
		rollback.retireFailure = true
		transaction, err := m.RouterVPNReplaceTunOwned(ctx, current, func() (adapter.Inbound, adapter.Inbound, error) { factories++; return candidate, rollback, nil })
		if err == nil || transaction == nil || transaction.Current() != candidate {
			t.Fatal("unsettled unused reader was not retained", err)
		}
		pending = append(pending, transaction)
		abandoned = append(abandoned, rollback)
		current = candidate
	}
	_, err := m.RouterVPNReplaceTunOwned(ctx, current, func() (adapter.Inbound, adapter.Inbound, error) {
		factories++
		return makeReader("forbidden"), makeReader("forbidden"), nil
	})
	if err == nil || factories != routerVPNMTUPendingLimit {
		t.Fatal("history capacity checked after new native acquisition")
	}
	for i, transaction := range pending {
		abandoned[i].retireFailure = false
		if err := m.RouterVPNRetryTunTransaction(ctx, transaction); err != nil {
			t.Fatal(err)
		}
	}
	if len(m.routervpnMTUPending) != 0 || len(m.routervpnRetired) != 0 {
		t.Fatal("settled histories still block original manager")
	}
	_, err = m.RouterVPNReplaceTunOwned(ctx, current, func() (adapter.Inbound, adapter.Inbound, error) {
		factories++
		return makeReader("next"), makeReader("backup"), nil
	})
	if err != nil || factories != routerVPNMTUPendingLimit+1 {
		t.Fatal("original manager did not recover after exact cleanup", err)
	}
}
func TestRouterVPNTunTransactionCancelledAcquisitionAndNativeClose(t *testing.T) {
	ctx, m, original, makeReader := mtuEvidenceFixture(t)
	canceled, cancel := context.WithCancel(ctx)
	cancel()
	called := false
	if _, err := m.RouterVPNReplaceTunOwned(canceled, original, func() (adapter.Inbound, adapter.Inbound, error) {
		called = true
		return makeReader("forbidden"), makeReader("forbidden"), nil
	}); err == nil || called || original.closed != 0 {
		t.Fatal("cancelled operation acquired a native reader")
	}
	work, stop := context.WithCancel(ctx)
	candidate, rollback := makeReader("candidate"), makeReader("rollback")
	candidate.gate = make(chan struct{})
	candidate.entered = make(chan struct{})
	done := make(chan *RouterVPNTunTransaction, 1)
	go func() {
		transaction, _ := m.RouterVPNReplaceTunOwned(work, original, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
		done <- transaction
	}()
	<-candidate.entered
	stop()
	close(candidate.gate)
	transaction := <-done
	if transaction == nil || transaction.Current() != nil || len(m.routervpnMTUPending) != 1 || rollback.started != 0 {
		t.Fatal("cancelled native work restarted or lost original owners")
	}
	// A later explicit bounded cleanup retries retained originals; no new factory.
	if err := m.RouterVPNRetryTunTransaction(ctx, transaction); err != nil {
		t.Fatal(err)
	}
	if candidate.alive || rollback.alive || transaction.Evidence()[1].Retirement != "retired:candidate" || transaction.Evidence()[2].Retirement != "retired:rollback" {
		t.Fatal("canceled candidate cleanup was inferred instead of joined")
	}
}

func (e *mtuEvidenceInbound) RouterVPNDesktopMTUBoundedTransaction() bool { return true }

func TestRouterVPNTunFullSearchRetainsEveryOriginalAttempt(t *testing.T) {
	for _, mode := range []string{"full-search-and-winner", "failed-candidate-and-original-restore", "cancel-after-provisional-winner"} {
		t.Run(mode, func(t *testing.T) {
			ctx, m, original, makeReader := mtuEvidenceFixture(t)
			current := adapter.Inbound(original)
			plan := mobilemtu.Plan{Original: 1360, Ceiling: 1500}
			candidates := plan.Candidates(1420)
			if len(candidates) != 5 {
				t.Fatal("actual planner candidate budget changed", candidates)
			}
			sequence := append(append([]int(nil), candidates...), 1420)
			failure := -1
			if mode == "failed-candidate-and-original-restore" {
				sequence = append(append([]int(nil), candidates[:3]...), plan.Original)
				failure = 2
			}
			if mode == "cancel-after-provisional-winner" {
				sequence = append(sequence, plan.Original)
			}
			history := make([]*RouterVPNTunTransaction, 0, len(sequence))
			for i, mtu := range sequence {
				candidate, rollback := makeReader(fmt.Sprintf("candidate-%d-mtu-%d", i, mtu)), makeReader(fmt.Sprintf("rollback-%d", i))
				candidate.fail = i == failure
				candidate.failure = adapter.StartStatePostStart
				transaction, err := m.RouterVPNReplaceTunOwned(ctx, current, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
				if transaction == nil || transaction.Current() == nil || (i == failure) != (err != nil) {
					t.Fatal("actual candidate sequence lost its owner", i, err)
				}
				history = append(history, transaction)
				current = transaction.Current()
			}
			if len(m.routervpnMTUPending) != 0 || len(m.routervpnRetired) != 0 {
				t.Fatal("settled search retained unjoined native resources")
			}
			for i, transaction := range history {
				evidence := transaction.Evidence()
				if len(evidence) != 3 || evidence[0].Ready == "" || evidence[0].Retirement == "" || !evidence[0].Retired {
					t.Fatal("full search discarded predecessor evidence", i)
				}
				if i == failure && (!evidence[1].Retired || evidence[1].Retirement == "" || evidence[1].Started) {
					t.Fatal("full search discarded failed native candidate", i)
				}
			}
		})
	}
}

// Native cleanup may change only the context of the original unstarted rollback
// adapter. No replacement factory or current-reader lookup creates its authority.
type mtuCleanupInbound struct {
	*mtuTestInbound
	label      string
	startup    context.Context
	afterStart func()
}

func (e *mtuCleanupInbound) RouterVPNDesktopMTUBoundedTransaction() bool { return true }
func (e *mtuCleanupInbound) RouterVPNDesktopMTUStartupContext(ctx context.Context) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	if e.started != 0 || e.closed != 0 {
		return errors.New("rollback was already started or retired")
	}
	e.startup = ctx
	return nil
}
func (e *mtuCleanupInbound) Start(stage adapter.StartStage) error {
	if e.startup != nil && e.startup.Err() != nil {
		return e.startup.Err()
	}
	if err := e.mtuTestInbound.Start(stage); err != nil {
		return err
	}
	if stage == adapter.StartStateStarted && e.afterStart != nil {
		e.afterStart()
	}
	return nil
}
func (e *mtuCleanupInbound) RouterVPNDesktopMTUReceiptContext(ctx context.Context) (string, string, error) {
	if err := ctx.Err(); err != nil {
		return "", "", err
	}
	if e.alive {
		return "ready:" + e.label, "", nil
	}
	if e.closed > 0 {
		return "", "retired:" + e.label, nil
	}
	return "", "", nil
}
func (e *mtuCleanupInbound) RouterVPNDesktopTunCloseContext(ctx context.Context) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	return e.mtuTestInbound.Close()
}
func TestRouterVPNTunContextRestoresOnlyWithOriginalCleanupAllowance(t *testing.T) {
	for _, expire := range []bool{false, true} {
		t.Run(map[bool]string{false: "restores", true: "expired-cleanup"}[expire], func(t *testing.T) {
			work, finish, err := mobilemtu.WithOperationContext(context.Background(), time.Second, 30*time.Millisecond)
			if err != nil {
				t.Fatal(err)
			}
			defer finish()
			work, cancel := context.WithCancel(work)
			defer cancel()
			makeReader := func(label string) *mtuCleanupInbound {
				return &mtuCleanupInbound{mtuTestInbound: &mtuTestInbound{tag: "tun", kind: "tun"}, label: label, startup: work}
			}
			original, candidate, rollback := makeReader("original"), makeReader("candidate"), makeReader("rollback")
			original.alive = true
			m := &Manager{started: true, stage: adapter.StartStateStarted, inbounds: []adapter.Inbound{original}, inboundByTag: map[string]adapter.Inbound{"tun": original}}
			candidate.afterStart = func() {
				if expire {
					cleanup, err := mobilemtu.OperationCleanupContext(work)
					if err != nil {
						t.Fatal(err)
					}
					<-cleanup.Done()
				}
				cancel()
			}
			calls := 0
			transaction, err := m.RouterVPNReplaceTunOwned(work, original, func() (adapter.Inbound, adapter.Inbound, error) { calls++; return candidate, rollback, nil })
			if !errors.Is(err, context.Canceled) || calls != 1 || transaction == nil {
				t.Fatal("original mutation lost cancellation or recreated readers", err, calls)
			}
			if !expire {
				if transaction.Current() != rollback || m.inboundByTag[original.Tag()] != rollback || !rollback.alive || candidate.alive {
					t.Fatal("original cleanup did not restore preconstructed rollback")
				}
				if !mobilemtu.SameOperationContext(work, rollback.startup) || !mobilemtu.StrictOperationContext(rollback.startup) {
					t.Fatal("rollback acquired fresh authority")
				}
				cleanup, err := mobilemtu.OperationCleanupContext(work)
				if err != nil || cleanup != rollback.startup {
					t.Fatal("rollback renewed cleanup deadline", err)
				}
			} else {
				if transaction.Current() != nil || rollback.started != 0 || !candidate.alive || len(m.routervpnMTUPending) != 1 {
					t.Fatal("expired cleanup restarted rollback or discarded live candidate")
				}
				if !errors.Is(err, context.DeadlineExceeded) {
					t.Fatal("cleanup expiry was overwritten", err)
				}
				stopCtx, stop := context.WithTimeout(context.Background(), time.Second)
				defer stop()
				if err := m.RouterVPNRetryTunTransaction(stopCtx, transaction); err != nil || candidate.alive {
					t.Fatal("original Stop did not settle pending reader", err)
				}
			}
		})
	}
}

type mtuControllerManagerOwner struct {
	manager  *Manager
	current  *mtuCleanupInbound
	mtu      map[*mtuCleanupInbound]int
	cancel   context.CancelFunc
	original mobilemtu.State
	pending  context.Context
	history  []*RouterVPNTunTransaction
	test     *testing.T
}

func (o *mtuControllerManagerOwner) Capture() (mobilemtu.State, error) {
	return mobilemtu.State{}, errors.New("strict controller entered legacy capture")
}
func (o *mtuControllerManagerOwner) CaptureContext(ctx context.Context) (mobilemtu.State, error) {
	if err := adapter.RouterVPNLockContext(ctx, &o.manager.access); err != nil {
		return mobilemtu.State{}, err
	}
	defer o.manager.access.Unlock()
	if o.manager.inboundByTag["tun"] != o.current || o.current == nil || !o.current.alive {
		return mobilemtu.State{}, errors.New("original manager lost retained reader")
	}
	return mobilemtu.State{Session: "original-native-session", Path: "original-physical-path", Interface: o.current.label, MTU: o.mtu[o.current]}, nil
}
func (o *mtuControllerManagerOwner) RollbackStateContext(ctx context.Context, expected mobilemtu.State) (mobilemtu.State, error) {
	if !mobilemtu.SameOperationContext(ctx, o.pending) || expected != o.original {
		return mobilemtu.State{}, errors.New("cleanup cannot adopt another original transaction")
	}
	return o.CaptureContext(ctx)
}
func (o *mtuControllerManagerOwner) ChangeMTU(ctx context.Context, expected mobilemtu.State, mtu int) (mobilemtu.State, error) {
	before, err := o.CaptureContext(ctx)
	if err != nil || before != expected {
		return mobilemtu.State{}, errors.Join(err, errors.New("mutation changed captured original"))
	}
	original := o.current
	makeReader := func(label string, mtu int) *mtuCleanupInbound {
		reader := &mtuCleanupInbound{mtuTestInbound: &mtuTestInbound{tag: "tun", kind: "tun"}, label: fmt.Sprintf("%s-%d", label, len(o.history)), startup: ctx}
		o.mtu[reader] = mtu
		return reader
	}
	candidate, rollback := makeReader("candidate", mtu), makeReader("rollback", before.MTU)
	var unused adapter.Inbound = rollback
	if len(o.history) == 0 {
		o.pending = ctx
		o.original = before
		unused = &mtuCleanupCloseCallback{mtuCleanupInbound: rollback, afterClose: func() {
			if o.manager.inboundByTag["tun"] != candidate || ctx.Err() != nil {
				o.test.Error("strict native candidate not owned before unused close")
			}
			o.cancel()
		}}
	}
	transaction, changeErr := o.manager.RouterVPNReplaceTunOwned(ctx, original, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, unused, nil })
	if transaction == nil {
		return before, changeErr
	}
	o.history = append(o.history, transaction)
	current, ok := transaction.Current().(*mtuCleanupInbound)
	if !ok {
		return mobilemtu.State{}, errors.Join(changeErr, errors.New("transaction has no retained reader"))
	}
	o.current = current
	if ctx.Err() != nil {
		return before, errors.Join(changeErr, ctx.Err())
	}
	after, err := o.CaptureContext(ctx)
	return after, errors.Join(changeErr, err)
}
func (o *mtuControllerManagerOwner) VerifyExternal(ctx context.Context, expected mobilemtu.State) error {
	actual, err := o.CaptureContext(ctx)
	if err != nil {
		return err
	}
	if actual != expected {
		return errors.New("public proof changed captured native reader")
	}
	return nil
}
func (o *mtuControllerManagerOwner) DialThroughTunnel(context.Context, mobilemtu.State, string, string) (net.Conn, error) {
	return nil, errors.New("cancelled work must not enter measurement")
}

type mtuCleanupCloseCallback struct {
	*mtuCleanupInbound
	afterClose func()
}

func (e *mtuCleanupCloseCallback) RouterVPNDesktopTunCloseContext(ctx context.Context) error {
	err := e.mtuCleanupInbound.RouterVPNDesktopTunCloseContext(ctx)
	if err == nil {
		e.afterClose()
	}
	return err
}
func TestRouterVPNTunContextControllerRestoresAfterUnusedCloseCancellation(t *testing.T) {
	parent, cancel := context.WithTimeout(context.Background(), time.Second)
	defer cancel()
	original := &mtuCleanupInbound{mtuTestInbound: &mtuTestInbound{tag: "tun", kind: "tun", alive: true}, label: "original", startup: parent}
	manager := &Manager{started: true, stage: adapter.StartStateStarted, inbounds: []adapter.Inbound{original}, inboundByTag: map[string]adapter.Inbound{"tun": original}}
	owner := &mtuControllerManagerOwner{manager: manager, current: original, mtu: map[*mtuCleanupInbound]int{original: 1380}, cancel: cancel, test: t}
	config := `{"inbounds":[{"type":"tun","tag":"tun","mtu":1380,"auto_route":true,"strict_route":true}],"outbounds":[{"type":"shadowsocks","tag":"custom-exit","server":"192.0.2.1","server_port":8388,"method":"2022-blake3-aes-256-gcm","password":"captured-test-key"}],"route":{"final":"custom-exit"}}`
	authority := `{"schema":1,"id":"captured-exit","source_sha256":"` + strings.Repeat("a", 64) + `","expected_public_ip":"198.51.100.9","mtu_policy":"auto","jumbo_tun":false}`
	controller, err := mobilemtu.NewExternalContext(parent, owner, config, authority, nil)
	if err != nil {
		t.Fatal(err)
	}
	defer controller.Close()
	err = controller.RunContext(parent, strings.Repeat("a", 32), true)
	if !errors.Is(err, context.Canceled) {
		t.Fatal("native cancellation lost caller error", err)
	}
	var status mobilemtu.Status
	if json.Unmarshal([]byte(controller.StatusJSON()), &status) != nil || status.Measured || !status.Restored || status.EffectiveMTU != 1380 {
		t.Fatal("strict shared controller did not restore original native MTU", status)
	}
	if len(owner.history) != 2 || owner.current == original || owner.mtu[owner.current] != 1380 || !owner.current.alive {
		t.Fatal("strict cleanup lost exact original operation history")
	}
	for _, transaction := range owner.history {
		history := transaction.Evidence()
		if !history[0].Retired || !history[1].Started || !history[2].Retired {
			t.Fatal("cleanup discarded actual native evidence", history)
		}
	}
}
