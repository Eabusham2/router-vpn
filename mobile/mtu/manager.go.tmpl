package inbound

import (
	"context"
	"errors"
	"fmt"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemtu"
	"runtime"
	"sync"
)

const routerVPNMTUPendingLimit = 32

// Each slot is an actual adapter constructed for this one manager transaction.
// Ready and retirement are different native attestations. A failed partial
// constructor never becomes Ready merely because cleanup later succeeds.
type RouterVPNTunEvidence struct {
	Inbound                                   adapter.Inbound
	Role                                      string
	StartAttempted, Started, Retired, Pending bool
	Ready, Retirement                         string
}
type RouterVPNTunTransaction struct {
	mu       sync.Mutex
	manager  *Manager
	original adapter.Inbound
	current  adapter.Inbound
	readers  [3]RouterVPNTunEvidence
	pending  bool
}

func (t *RouterVPNTunTransaction) Current() adapter.Inbound {
	if t == nil {
		return nil
	}
	t.mu.Lock()
	defer t.mu.Unlock()
	return t.current
}
func (t *RouterVPNTunTransaction) Evidence() []RouterVPNTunEvidence {
	if t == nil {
		return nil
	}
	t.mu.Lock()
	defer t.mu.Unlock()
	return append([]RouterVPNTunEvidence(nil), t.readers[:]...)
}

// This is an observation of one actual manager transaction, not a caller's
// replacement pointer. Every unused reader must have joined retirement before
// a higher-level owner can transfer its ingress to the returned active reader.
func (m *Manager) RouterVPNReadTunTransactionContext(ctx context.Context, t *RouterVPNTunTransaction, original adapter.Inbound) (adapter.Inbound, error) {
	if ctx == nil || ctx.Err() != nil || m == nil || t == nil || original == nil || t.manager != m {
		return nil, errors.New("TUN readback has no original manager transaction")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.routervpnLifecycle); err != nil {
		return nil, err
	}
	defer m.routervpnLifecycle.Unlock()
	if err := adapter.RouterVPNLockContext(ctx, &t.mu); err != nil {
		return nil, err
	}
	defer t.mu.Unlock()
	if t.original != original || t.readers[0].Inbound != original || t.current == nil || t.pending ||
		!m.started || m.stage != adapter.StartStateStarted {
		return nil, errors.New("TUN readback belongs to an unsettled or retired transaction")
	}
	active := 0
	for _, e := range t.readers {
		if e.Inbound == nil {
			continue
		}
		if e.Pending || e.Inbound.Type() != "tun" || e.Inbound.Tag() != original.Tag() {
			return nil, errors.New("TUN readback changed its captured reader family")
		}
		if e.Inbound == t.current {
			active++
			if !e.Started || e.Retired {
				return nil, errors.New("TUN readback did not retain its started reader")
			}
		} else if !e.Retired {
			return nil, errors.New("TUN readback still owns an unretired reader")
		}
	}
	if active != 1 {
		return nil, errors.New("TUN readback lacks one exact active reader")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.access); err != nil {
		return nil, err
	}
	defer m.access.Unlock()
	listed := 0
	for _, value := range m.inbounds {
		if value == t.current {
			listed++
		}
	}
	if listed != 1 || m.inboundByTag[original.Tag()] != t.current || ctx.Err() != nil {
		return nil, errors.New("TUN transaction no longer owns the actual manager reader")
	}
	return t.current, nil
}

// Existing callers use this same owned transaction. The factory form below is
// the shipping Box entry: capacity/admission precede candidate construction.
func (m *Manager) RouterVPNReplaceTun(ctx context.Context, expected, candidate, rollback adapter.Inbound) (adapter.Inbound, error) {
	transaction, err := m.RouterVPNReplaceTunOwned(ctx, expected, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
	if transaction == nil {
		// Compatibility callers already constructed these two objects. The
		// shipping Box uses the factory entry below, so it acquires nothing on
		// rejected admission. Preserve prior cleanup of preconstructed readers
		// without allowing a stale call to close a currently adopted pointer.
		m.routervpnLifecycle.Lock()
		defer m.routervpnLifecycle.Unlock()
		if expected != nil && candidate != nil && rollback != nil && expected != candidate && expected != rollback && candidate != rollback &&
			expected.Type() == "tun" && candidate.Type() == "tun" && rollback.Type() == "tun" && expected.Tag() != "" && candidate.Tag() == expected.Tag() && rollback.Tag() == expected.Tag() {
			for _, value := range []adapter.Inbound{candidate, rollback} {
				m.access.Lock()
				adopted := false
				for _, current := range m.inbounds {
					adopted = adopted || current == value
				}
				m.access.Unlock()
				if adopted {
					continue
				}
				if closeErr := routervpnCloseTunContext(ctx, value); closeErr != nil {
					found := false
					for _, retained := range m.routervpnRetired {
						found = found || retained == value
					}
					if !found {
						m.routervpnRetired = append(m.routervpnRetired, value)
					}
					err = errors.Join(err, closeErr)
				}
			}
		}
		return expected, err
	}
	return transaction.Current(), err
}

func (m *Manager) RouterVPNReplaceTunOwned(ctx context.Context, expected adapter.Inbound, construct func() (adapter.Inbound, adapter.Inbound, error)) (*RouterVPNTunTransaction, error) {
	if err := adapter.RouterVPNLockContext(ctx, &m.routervpnLifecycle); err != nil {
		return nil, err
	}
	defer m.routervpnLifecycle.Unlock()
	if ctx == nil || ctx.Err() != nil || expected == nil || expected.Type() != "tun" || expected.Tag() == "" || construct == nil {
		return nil, errors.New("TUN transaction lost its original caller or adapter")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.access); err != nil {
		return nil, err
	}
	index := -1
	for i, value := range m.inbounds {
		if value == expected {
			index = i
			break
		}
	}
	admitted := m.started && m.stage == adapter.StartStateStarted && m.inboundByTag[expected.Tag()] == expected && index >= 0
	m.access.Unlock()
	if !admitted {
		return nil, errors.New("TUN transaction belongs to a stale or stopped inbound")
	}
	// Reserve all three possible history owners before invoking construction.
	if routervpnBoundedMTU(expected) && (len(m.routervpnMTUPending) >= routerVPNMTUPendingLimit || len(m.routervpnRetired) > 3*routerVPNMTUPendingLimit-3) {
		return nil, errors.New("TUN transaction retains too many unsettled original owners")
	}
	transaction := &RouterVPNTunTransaction{manager: m, original: expected, current: expected}
	transaction.readers[0] = RouterVPNTunEvidence{Inbound: expected, Role: "original", Started: true}
	transaction.mu.Lock()
	defer transaction.mu.Unlock()
	candidate, rollback, constructionErr := construct()
	transaction.readers[1] = RouterVPNTunEvidence{Inbound: candidate, Role: "candidate"}
	transaction.readers[2] = RouterVPNTunEvidence{Inbound: rollback, Role: "rollback"}
	reused := candidate == expected || rollback == expected || candidate != nil && candidate == rollback
	// Invalid constructor output grants no close authority over the original
	// or twice over one pointer. Distinct partial objects still remain ours.
	if candidate == expected {
		transaction.readers[1].Inbound = nil
	}
	if rollback == expected || rollback == candidate {
		transaction.readers[2].Inbound = nil
	}
	remember := func(e *RouterVPNTunEvidence) {
		e.Pending = true
		for _, old := range m.routervpnRetired {
			if old == e.Inbound {
				return
			}
		}
		m.routervpnRetired = append(m.routervpnRetired, e.Inbound)
	}
	defer func() {
		for _, e := range transaction.readers {
			if e.Pending {
				transaction.pending = true
			}
		}
		if transaction.pending {
			m.routervpnMTUPending = append(m.routervpnMTUPending, transaction)
		}
	}()

	resourceCtx := ctx
	cleanupActive := false
	useCleanup := func() error {
		if cleanupActive {
			return resourceCtx.Err()
		}
		if !mobilemtu.SameOperationContext(ctx, ctx) {
			if !routervpnBoundedMTU(expected) && !mobilemtu.StrictOperationContext(ctx) {
				return nil
			}
			return ctx.Err()
		}
		cleanup, err := mobilemtu.OperationCleanupContext(ctx)
		if err != nil {
			return err
		}
		resourceCtx = cleanup
		cleanupActive = true
		return nil
	}
	capture := func(e *RouterVPNTunEvidence) error { return routervpnMTUEvidence(resourceCtx, e) }
	settled := func(e *RouterVPNTunEvidence) {
		e.Pending = false
		for i, value := range m.routervpnRetired {
			if value == e.Inbound {
				m.routervpnRetired = append(m.routervpnRetired[:i], m.routervpnRetired[i+1:]...)
				break
			}
		}
	}
	closeOwned := func(e *RouterVPNTunEvidence) error {
		if e.Inbound == nil {
			return nil
		}
		if e.Retired {
			err := capture(e)
			if err == nil {
				settled(e)
			}
			return err
		}
		before := capture(e)
		if err := routervpnCloseTunContext(resourceCtx, e.Inbound); err != nil {
			remember(e)
			return errors.Join(before, err)
		}
		e.Retired = true
		after := capture(e)
		if after != nil {
			remember(e)
		} else {
			settled(e)
		}
		return errors.Join(before, after)
	}
	if reused || constructionErr != nil || candidate == nil || rollback == nil || candidate.Type() != "tun" || rollback.Type() != "tun" || candidate.Tag() != expected.Tag() || rollback.Tag() != expected.Tag() {
		cleanupErr := useCleanup()
		return transaction, errors.Join(constructionErr, cleanupErr, errors.New("TUN transaction did not construct its distinct native readers"), closeOwned(&transaction.readers[1]), closeOwned(&transaction.readers[2]))
	}
	if err := capture(&transaction.readers[0]); err != nil {
		cleanupErr := useCleanup()
		return transaction, errors.Join(err, cleanupErr, closeOwned(&transaction.readers[1]), closeOwned(&transaction.readers[2]))
	}
	publish := func(value adapter.Inbound) error {
		admission := ctx
		restored := value == rollback && cleanupActive
		// Borrowed mobile handles keep their established rollback contract. Strict
		// operations restore only with the original captured cleanup capability.
		borrowedRollback := value == rollback && !routervpnBoundedMTU(expected) && !mobilemtu.StrictOperationContext(ctx)
		if restored {
			admission = resourceCtx
		} else if borrowedRollback {
			admission = context.WithoutCancel(ctx)
		}
		if value == nil {
			transaction.current = nil
			if ctx.Err() != nil {
				if err := useCleanup(); err != nil {
					return err
				}
				admission = resourceCtx
			}
		}
		if err := adapter.RouterVPNLockContext(admission, &m.access); err != nil {
			return err
		}
		defer m.access.Unlock()
		if value != nil && !restored && !borrowedRollback && ctx.Err() != nil {
			return ctx.Err()
		}
		if value == nil {
			delete(m.inboundByTag, expected.Tag())
			m.inbounds = append(m.inbounds[:index], m.inbounds[index+1:]...)
		} else {
			m.inbounds[index] = value
			m.inboundByTag[expected.Tag()] = value
		}
		transaction.current = value
		return nil
	}
	unpublished := func(e *RouterVPNTunEvidence, err error) error {
		if e.Inbound != nil && !e.Retired {
			remember(e)
		}
		transaction.current = nil
		return errors.Join(err, publish(nil))
	}
	start := func(e *RouterVPNTunEvidence, checkCancel bool) error {
		e.StartAttempted = true
		for _, stage := range adapter.ListStartStages {
			if checkCancel && resourceCtx.Err() != nil {
				return resourceCtx.Err()
			}
			if err := adapter.LegacyStart(e.Inbound, stage); err != nil {
				return err
			}
		}
		if err := capture(e); err != nil {
			return err
		}
		if checkCancel && resourceCtx.Err() != nil {
			return resourceCtx.Err()
		}
		e.Started = true
		return nil
	}
	restore := func(cause error) (*RouterVPNTunTransaction, error) {
		if err := useCleanup(); err != nil {
			return transaction, errors.Join(cause, err, publish(nil), closeOwned(&transaction.readers[1]), closeOwned(&transaction.readers[2]))
		}
		// Never overlap a still-live original or partial candidate with rollback.
		if err := closeOwned(&transaction.readers[0]); err != nil {
			return transaction, errors.Join(cause, err, publish(nil), closeOwned(&transaction.readers[1]), closeOwned(&transaction.readers[2]))
		}
		if err := closeOwned(&transaction.readers[1]); err != nil {
			return transaction, errors.Join(cause, err, publish(nil), closeOwned(&transaction.readers[2]))
		}
		if cleanupActive {
			if prepared, ok := rollback.(interface{ RouterVPNDesktopMTUStartupContext(context.Context) error }); ok {
				if err := prepared.RouterVPNDesktopMTUStartupContext(resourceCtx); err != nil {
					return transaction, unpublished(&transaction.readers[2], errors.Join(cause, err))
				}
			} else if routervpnBoundedMTU(expected) {
				return transaction, unpublished(&transaction.readers[2], errors.Join(cause, errors.New("original native rollback omitted bounded startup capability")))
			}
		}
		if err := start(&transaction.readers[2], cleanupActive || routervpnBoundedMTU(expected)); err != nil {
			return transaction, errors.Join(cause, err, publish(nil), closeOwned(&transaction.readers[2]))
		}
		if err := publish(rollback); err != nil {
			return transaction, unpublished(&transaction.readers[2], errors.Join(cause, err))
		}
		return transaction, fmt.Errorf("TUN candidate rejected; prior reader restored: %w", cause)
	}
	if err := closeOwned(&transaction.readers[0]); err != nil {
		return restore(fmt.Errorf("old TUN teardown is unverified: %w", err))
	}
	if err := start(&transaction.readers[1], true); err != nil {
		return restore(err)
	}
	// This is provisional manager ownership, not an optimizer winner. Install
	// the exact candidate while work is still live, before closing the unused
	// rollback instance. A cancellation in that close returns this same retained
	// candidate with its error so the original upper cleanup can restore it.
	if err := publish(candidate); err != nil {
		return restore(err)
	}
	unusedErr := closeOwned(&transaction.readers[2])
	if unusedErr != nil && mobilemtu.SameOperationContext(ctx, ctx) {
		if cleanupErr := useCleanup(); cleanupErr == nil {
			unusedErr = errors.Join(unusedErr, closeOwned(&transaction.readers[2]))
		} else {
			unusedErr = errors.Join(unusedErr, cleanupErr)
		}
	}
	return transaction, errors.Join(unusedErr, ctx.Err())
}

func routervpnMTUEvidence(ctx context.Context, e *RouterVPNTunEvidence) error {
	if e.Inbound == nil {
		return nil
	}
	reader, ok := e.Inbound.(interface {
		RouterVPNDesktopMTUReceiptContext(context.Context) (string, string, error)
	})
	if runtime.GOOS != "linux" || !routervpnBoundedMTU(e.Inbound) || !ok {
		return nil
	}
	ready, retired, err := reader.RouterVPNDesktopMTUReceiptContext(ctx)
	if err != nil {
		return err
	}
	if ready != "" && retired != "" || ready != "" && e.Ready != "" && ready != e.Ready || retired != "" && e.Retirement != "" && retired != e.Retirement {
		return errors.New("native TUN transaction changed its original evidence")
	}
	if ready != "" {
		e.Ready = ready
	}
	if retired != "" {
		e.Retirement = retired
	}
	if e.Retired && retired == "" {
		return errors.New("retired native TUN omitted its actual call history")
	}
	return nil
}

// Retry only failed resources already held by this exact manager transaction.
// The current reader is never selected by tag or implicitly retired here.
func (m *Manager) RouterVPNRetryTunTransaction(ctx context.Context, t *RouterVPNTunTransaction) error {
	if err := adapter.RouterVPNLockContext(ctx, &m.routervpnLifecycle); err != nil {
		return err
	}
	defer m.routervpnLifecycle.Unlock()
	if ctx == nil || ctx.Err() != nil || t == nil || t.manager != m {
		return errors.New("MTU cleanup lost its original manager or caller")
	}
	if err := adapter.RouterVPNLockContext(ctx, &t.mu); err != nil {
		return err
	}
	defer t.mu.Unlock()
	if !t.pending {
		return nil
	}
	found := false
	for _, old := range m.routervpnMTUPending {
		if old == t {
			found = true
		}
	}
	if !found {
		return errors.New("MTU cleanup lost its retained history owner")
	}
	for i := range t.readers {
		e := &t.readers[i]
		if !e.Pending {
			continue
		}
		if err := adapter.RouterVPNLockContext(ctx, &m.access); err != nil {
			return err
		}
		current := m.inboundByTag[e.Inbound.Tag()]
		m.access.Unlock()
		if current == e.Inbound {
			return errors.New("MTU cleanup cannot retire a currently adopted reader")
		}
		if !e.Retired {
			if err := routervpnCloseTunContext(ctx, e.Inbound); err != nil {
				return err
			}
			e.Retired = true
		}
		if err := routervpnMTUEvidence(ctx, e); err != nil {
			return err
		}
		e.Pending = false
		for j, old := range m.routervpnRetired {
			if old == e.Inbound {
				m.routervpnRetired = append(m.routervpnRetired[:j], m.routervpnRetired[j+1:]...)
				break
			}
		}
	}
	t.pending = false
	for i, old := range m.routervpnMTUPending {
		if old == t {
			m.routervpnMTUPending = append(m.routervpnMTUPending[:i], m.routervpnMTUPending[i+1:]...)
			break
		}
	}
	return ctx.Err()
}

// Only original manager-held instances are visited, including failed MTU
// readers retained for retry. Only directly owned native Linux readers need
// this pre-dependency retirement. Generic and borrowed readers remain owned by
// the ordinary manager Close stage, which must visit them exactly once.
// This never resolves an interface or tag by name.
func (m *Manager) RouterVPNCloseNativeTunContext(ctx context.Context) error {
	m.routervpnLifecycle.Lock()
	defer m.routervpnLifecycle.Unlock()
	m.access.Lock()
	originals := append(append([]adapter.Inbound(nil), m.inbounds...), m.routervpnRetired...)
	m.access.Unlock()
	for _, original := range originals {
		if original.Type() == "tun" && routervpnBoundedMTU(original) {
			if err := routervpnCloseTunContext(ctx, original); err != nil {
				return err
			}
		}
	}
	return nil
}
func routervpnCloseTunContext(ctx context.Context, original adapter.Inbound) error {
	if runtime.GOOS == "darwin" {
		if native, ok := original.(interface {
			RouterVPNDesktopDarwinNodeChainRetirementEnabled() bool
			RouterVPNDesktopDarwinNodeChainCloseContext(context.Context) error
		}); ok {
			if native.RouterVPNDesktopDarwinNodeChainRetirementEnabled() {
				return native.RouterVPNDesktopDarwinNodeChainCloseContext(ctx)
			}
		}
	}
	if runtime.GOOS == "linux" {
		if closer, ok := original.(interface{ RouterVPNDesktopTunCloseContext(context.Context) error }); ok {
			return closer.RouterVPNDesktopTunCloseContext(ctx)
		}
	}
	return original.Close()
}

func routervpnBoundedMTU(value adapter.Inbound) bool {
	owner, ok := value.(interface{ RouterVPNDesktopMTUBoundedTransaction() bool })
	return ok && owner.RouterVPNDesktopMTUBoundedTransaction()
}

// This separately typed Darwin entry is called only by the original ordered
// child before its physical source and one-shot Box teardown. It preserves the
// ordinary Linux/borrowed manager lifecycle unchanged.
func (m *Manager) RouterVPNCloseDarwinNodeChainTunContext(ctx context.Context) error {
	if runtime.GOOS != "darwin" || ctx == nil || ctx.Err() != nil {
		return errors.New("Darwin ordered cleanup lost its original caller")
	}
	if _, bounded := ctx.Deadline(); !bounded {
		return errors.New("Darwin ordered cleanup requires its original deadline")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.routervpnLifecycle); err != nil {
		return err
	}
	defer m.routervpnLifecycle.Unlock()
	if err := adapter.RouterVPNLockContext(ctx, &m.access); err != nil {
		return err
	}
	originals := append(append([]adapter.Inbound(nil), m.inbounds...), m.routervpnRetired...)
	m.access.Unlock()
	visited := make(map[adapter.Inbound]bool)
	for _, original := range originals {
		if original == nil || original.Type() != "tun" || visited[original] {
			continue
		}
		visited[original] = true
		owned, ok := original.(interface {
			RouterVPNDesktopDarwinNodeChainRetirementEnabled() bool
			RouterVPNDesktopDarwinNodeChainRetirementContext(context.Context) error
			RouterVPNDesktopDarwinNodeChainCloseContext(context.Context) error
		})
		if !ok {
			return errors.New("Darwin ordered manager lost an original native retirement capability")
		}
		if !owned.RouterVPNDesktopDarwinNodeChainRetirementEnabled() {
			// Box construction can fail before the explicit preparation. This
			// capability succeeds only while this same reader has never acquired
			// any native TUN, stack or borrowed platform handle.
			if err := owned.RouterVPNDesktopDarwinNodeChainRetirementContext(ctx); err != nil {
				return err
			}
		}
		if err := owned.RouterVPNDesktopDarwinNodeChainCloseContext(ctx); err != nil {
			return err
		}
		if err := adapter.RouterVPNLockContext(ctx, &m.access); err != nil {
			return err
		}
		// Remove only this successfully joined pointer. Failed/unvisited
		// originals remain retained, and ordinary Box.Close cannot close a
		// completed Darwin descriptor/stack a second time.
		for i := len(m.inbounds) - 1; i >= 0; i-- {
			if m.inbounds[i] == original {
				m.inbounds = append(m.inbounds[:i], m.inbounds[i+1:]...)
			}
		}
		if m.inboundByTag[original.Tag()] == original {
			delete(m.inboundByTag, original.Tag())
		}
		for i := len(m.routervpnRetired) - 1; i >= 0; i-- {
			if m.routervpnRetired[i] == original {
				m.routervpnRetired = append(m.routervpnRetired[:i], m.routervpnRetired[i+1:]...)
			}
		}
		m.access.Unlock()
	}
	return ctx.Err()
}
