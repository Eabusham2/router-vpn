//go:build linux && !android

package box_test

import (
	"context"
	"errors"
	"fmt"
	"net"
	"os"
	"os/exec"
	"regexp"
	"runtime"
	"strconv"
	"strings"
	"sync/atomic"
	"syscall"
	"testing"
	"time"

	"github.com/sagernet/netlink"
	box "github.com/sagernet/sing-box"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemtu"
	"github.com/sagernet/sing-box/include"
	"github.com/sagernet/sing-box/option"
	ntun "github.com/sagernet/sing-box/protocol/tun"
	"github.com/sagernet/sing-box/routervpn/desktopnetwork"
	SJ "github.com/sagernet/sing/common/json"
