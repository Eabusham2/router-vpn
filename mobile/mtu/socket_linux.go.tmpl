//go:build linux || android

package libbox

import "golang.org/x/sys/unix"

func routerMTUNoFragment(fd int, ipv6 bool) error {
 if ipv6 {return unix.SetsockoptInt(fd,unix.IPPROTO_IPV6,unix.IPV6_MTU_DISCOVER,unix.IP_PMTUDISC_DO)}
 return unix.SetsockoptInt(fd,unix.IPPROTO_IP,unix.IP_MTU_DISCOVER,unix.IP_PMTUDISC_DO)
}
func RouterMTUBindInterface(fd int64,name string) error {
 if _,err:=routerMTUInterface(name);err!=nil{return err}
 if fd<0||fd>2147483647{return unix.EBADF}
 return unix.SetsockoptString(int(fd),unix.SOL_SOCKET,unix.SO_BINDTODEVICE,name)
}
