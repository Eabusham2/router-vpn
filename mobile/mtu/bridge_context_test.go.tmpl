// Test-only access holds the exact native service/manager locks. It refuses a
// changed private field or type and adds no production observation hook.
func routerMTUField[T any](t *testing.T, owner any, name string) *T {
	t.Helper()
	value := reflect.ValueOf(owner).Elem().FieldByName(name)
	if !value.IsValid() || !value.CanAddr() || value.Type() != reflect.TypeOf((*T)(nil)).Elem() {
		t.Fatalf("native MTU fixture field changed: %s", name)
	}
	return (*T)(unsafe.Pointer(value.UnsafeAddr()))
}

type routerMTUContextInbound struct{ tag string }

func (p *routerMTUContextInbound) Type() string                   { return "tun" }
func (p *routerMTUContextInbound) Tag() string                    { return p.tag }
func (p *routerMTUContextInbound) Start(adapter.StartStage) error { return nil }
func (p *routerMTUContextInbound) Close() error                   { return nil }

type routerMTUContextPlatform struct {
	state                       RouterMTUState
	reads, begins, ends, aborts int
	onRead                      func(int)
}

func (p *routerMTUContextPlatform) CaptureMTU() *RouterMTUState {
	p.reads++
	if p.onRead != nil {
		p.onRead(p.reads)
	}
	state := p.state
	return &state
}
func (p *routerMTUContextPlatform) BeginMTUChange(*RouterMTUState) error       { p.begins++; return nil }
func (p *routerMTUContextPlatform) EndMTUChange() error                        { p.ends++; return nil }
func (p *routerMTUContextPlatform) BindMTUSocket(*RouterMTUState, int64) error { return nil }
func (p *routerMTUContextPlatform) ReadMTUCache() string                       { return "" }
func (p *routerMTUContextPlatform) CompareAndSwapMTUCache(string, string) bool { return true }
func (p *routerMTUContextPlatform) AbortMTU(string)                            { p.aborts++ }

func routerMTUContextFixture(t *testing.T) (*routerMTUOwner, *inbound.Manager, *routerMTUContextPlatform) {
	t.Helper()
	reader := &routerMTUContextInbound{tag: "tun-in"}
	manager := inbound.NewManager(nil, nil, nil)
	*routerMTUField[map[string]adapter.Inbound](t, manager, "inboundByTag") = map[string]adapter.Inbound{"tun-in": reader}
	engine := &box.Box{}
	*routerMTUField[*inbound.Manager](t, engine, "inbound") = manager
	instance := &daemon.Instance{}
	*routerMTUField[*box.Box](t, instance, "instance") = engine
	started := &daemon.StartedService{}
	*routerMTUField[*daemon.Instance](t, started, "instance") = instance
	platform := &routerMTUContextPlatform{state: RouterMTUState{Session: "session", Path: "path", Interface: "tun", MTU: 1380}}
	owner := &routerMTUOwner{platform: platform, server: &CommandServer{StartedService: started}, instance: instance, inbound: reader, session: "session", path: "path"}
	return owner, manager, platform
}

// A signal from the actual caller context confirms observation admission.
// The test still holds the original mutex until the cancelled call returns.
type routerMTUObservedContext struct {
	context.Context
	reads   atomic.Int32
	entered chan struct{}
	at      int32
}

func (c *routerMTUObservedContext) Err() error {
	if c.reads.Add(1) == c.at {
		close(c.entered)
	}
	return c.Context.Err()
}

func TestRouterMTUContextCancellationRetainsNativeLockOwners(t *testing.T) {
	for _, name := range []string{"owner", "service", "inbound"} {
		t.Run(name, func(t *testing.T) {
			owner, manager, platform := routerMTUContextFixture(t)
			var unlock func()
			switch name {
			case "owner":
				owner.mu.Lock()
				unlock = owner.mu.Unlock
			case "service":
				lock := routerMTUField[sync.RWMutex](t, owner.server.StartedService, "serviceAccess")
				lock.Lock()
				unlock = lock.Unlock
			case "inbound":
				lock := routerMTUField[sync.Mutex](t, manager, "access")
				lock.Lock()
				unlock = lock.Unlock
			}
			var once sync.Once
			release := func() { once.Do(unlock) }
			defer release()
			parent, cancel := context.WithCancel(context.Background())
			defer cancel()
			ctx := &routerMTUObservedContext{Context: parent, entered: make(chan struct{}), at: map[string]int32{"owner": 2, "service": 5, "inbound": 9}[name]}
			done := make(chan error, 1)
			go func() { _, err := owner.CaptureContext(ctx); done <- err }()
			select {
			case <-ctx.entered:
			case err := <-done:
				t.Fatal("native MTU observation returned before its retained lock", err)
			case <-time.After(time.Second):
				cancel()
				release()
				err := <-done
				t.Fatal("native MTU observation did not retain the original caller", err)
			}
			cancel()
			var err error
			select {
			case err = <-done:
			case <-time.After(time.Second):
				release()
				err = <-done
				t.Fatal("native MTU observation waited for a retained lock after cancellation", err)
			}
			if !errors.Is(err, context.Canceled) || platform.reads != 0 || owner.invalid.Load() {
				t.Fatal("cancelled observation mutated or retired original owner", err)
			}
			release()
			state, err := owner.CaptureContext(context.Background())
			if err != nil || state.Session != "session" || state.MTU != 1380 {
				t.Fatal("fresh caller lost original owner after cancellation", err)
			}
		})
	}
}

func TestRouterMTUContextRejectsReplacementAndLateRead(t *testing.T) {
	for _, name := range []string{"service", "inbound", "cancelled-read", "changed-path", "proof-context"} {
		t.Run(name, func(t *testing.T) {
			owner, manager, platform := routerMTUContextFixture(t)
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			old := owner.inbound
			switch name {
			case "service":
				*routerMTUField[*daemon.Instance](t, owner.server.StartedService, "instance") = &daemon.Instance{}
			case "inbound":
				(*routerMTUField[map[string]adapter.Inbound](t, manager, "inboundByTag"))["tun-in"] = &routerMTUContextInbound{tag: "tun-in"}
			case "cancelled-read":
				platform.onRead = func(int) { cancel() }
			case "changed-path":
				platform.onRead = func(int) { platform.state.Path = "replacement" }
			case "proof-context":
				owner.proofCurrent = func() bool { t.Fatal("bounded MTU called contextless proof"); return true }
				owner.proofCurrentContext = func(context.Context) error { cancel(); return context.Canceled }
			}
			state, err := owner.CaptureContext(ctx)
			if err == nil || state != (mobilemtu.State{}) || owner.inbound != old || platform.begins != 0 || platform.aborts != 0 {
				t.Fatal("foreign or late read adopted/mutated a native reader", state, err)
			}
		})
	}
}

func TestRouterMTUContextConstructorRetainsCaller(t *testing.T) {
	owner, _, platform := routerMTUContextFixture(t)
	lock := routerMTUField[sync.RWMutex](t, owner.server.StartedService, "serviceAccess")
	lock.Lock()
	var once sync.Once
	release := func() { once.Do(lock.Unlock) }
	defer release()
	parent, cancel := context.WithCancel(context.Background())
	defer cancel()
	ctx := &routerMTUObservedContext{Context: parent, entered: make(chan struct{}), at: 2}
	done := make(chan error, 1)
	go func() {
		result, err := newRouterMTUContext(ctx, owner.server, platform, "{}", "{}")
		if result != nil {
			err = errors.New("cancelled constructor published an owner")
		}
		done <- err
	}()
	select {
	case <-ctx.entered:
	case err := <-done:
		t.Fatal("MTU constructor returned before its retained service lock", err)
	case <-time.After(time.Second):
		cancel()
		release()
		err := <-done
		t.Fatal("MTU constructor did not retain the original caller", err)
	}
	cancel()
	select {
	case err := <-done:
		if !errors.Is(err, context.Canceled) {
			t.Fatal("constructor lost original cancellation", err)
		}
	case <-time.After(time.Second):
		release()
		err := <-done
		t.Fatal("constructor waited for service replacement lock", err)
	}
	if platform.reads != 0 || platform.begins != 0 {
		t.Fatal("cancelled constructor touched platform")
	}
}

