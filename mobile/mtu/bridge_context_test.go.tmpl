func TestRouterMTUContextExternalHealthRetainsCaller(t *testing.T) {
	for _, name := range []string{"current", "cancel-before", "cancel-during"} {
		t.Run(name, func(t *testing.T) {
			owner, _, _ := routerMTUContextFixture(t)
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			calls := 0
			owner.external = &routerMTUContextLease{current: owner.inbound, health: func(call context.Context) error {
				calls++
				if call != ctx {
					t.Fatal("external health replaced its original caller")
				}
				if name == "cancel-during" {
					cancel()
				}
				return nil
			}}
			if name == "cancel-before" {
				cancel()
			}
			err := owner.externalHealthyContext(ctx)
			if name == "current" && (err != nil || calls != 1) || name != "current" && !errors.Is(err, context.Canceled) || name == "cancel-before" && calls != 0 || name == "cancel-during" && calls != 1 {
				t.Fatal("external health admitted a late callback or lost the captured lease", calls, err)
			}
		})
	}
}

func TestRouterMTUContextCancelledMutationRetainsOriginalReadbackAndRollback(t *testing.T) {
	owner, manager, platform := routerMTUContextFixture(t)
	before, err := owner.CaptureContext(context.Background())
	if err != nil {
		t.Fatal(err)
	}
	op, finish, err := mobilemtu.WithOperationContext(context.Background(), time.Minute, 3*time.Second)
	if err != nil {
		t.Fatal(err)
	}
	defer finish()
	ctx, cancel := context.WithCancel(op)
	defer cancel()
	lease := &routerMTUContextLease{current: owner.inbound}
	owner.external = lease
	owner.proofCurrent = func() bool { t.Fatal("contextless proof bypassed bounded lease"); return false }
	changes := 0
	lease.change = func(call context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
		if expected != lease.current || call.Err() != nil {
			t.Fatal("transaction did not retain exact reader/caller")
		}
		changes++
		reader := &routerMTUContextInbound{tag: "tun-in"}
		(*routerMTUField[map[string]adapter.Inbound](t, manager, "inboundByTag"))["tun-in"] = reader
		lease.current = reader
		platform.state.MTU = int32(mtu)
		if changes == 1 {
			cancel()
			return reader, context.Canceled
		}
		return reader, nil
	}
	after, err := owner.ChangeMTU(ctx, before, 1400)
	if !errors.Is(err, context.Canceled) || after.MTU != 1400 || owner.inbound != lease.current || owner.invalid.Load() || platform.aborts != 0 || platform.begins != 1 || platform.ends != 1 {
		t.Fatal("cancelled mutation lost actual original readback", after, err)
	}
	cleanup, err := mobilemtu.OperationCleanupContext(ctx)
	if err != nil {
		t.Fatal(err)
	}
	deadline, _ := cleanup.Deadline()
	restored, err := owner.ChangeMTU(cleanup, after, before.MTU)
	if err != nil || restored != before || platform.begins != 2 || platform.ends != 2 || platform.aborts != 0 {
		t.Fatal("exact original rollback failed", restored, err)
	}
	again, err := mobilemtu.OperationCleanupContext(ctx)
	if err != nil {
		t.Fatal(err)
	}
	if retained, _ := again.Deadline(); retained != deadline {
		t.Fatal("readback renewed original cleanup allowance")
	}
}

func TestRouterMTUContextLateConnectedSocketIsClosed(t *testing.T) {
	for _, fault := range []string{"cancel", "replacement"} {
		t.Run(fault, func(t *testing.T) {
			owner, _, platform := routerMTUContextFixture(t)
			expected, err := routerMTUState(&platform.state)
			if err != nil {
				t.Fatal(err)
			}
			listener, err := net.Listen("tcp", "127.0.0.1:0")
			if err != nil {
				t.Fatal(err)
			}
			defer listener.Close()
			peer := make(chan error, 1)
			go func() {
				conn, err := listener.Accept()
				if err != nil {
					peer <- err
					return
				}
				defer conn.Close()
				_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
				var b [1]byte
				_, err = conn.Read(b[:])
				peer <- err
			}()
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			platform.onRead = func(n int) {
				if n == 4 {
					if fault == "cancel" {
						cancel()
					} else {
						*routerMTUField[*daemon.Instance](t, owner.server.StartedService, "instance") = &daemon.Instance{}
					}
				}
			}
			connection, err := owner.dialBoundSocket(ctx, expected, "tcp", listener.Addr().String())
			if connection != nil {
				_ = connection.Close()
			}
			if connection != nil || err == nil || platform.reads != 4 {
				_ = listener.Close()
				<-peer
				t.Fatal("late native socket escaped original capture", err, platform.reads)
			}
			if err := <-peer; err != io.EOF {
				t.Fatal("late owned socket did not close before return", err)
			}
		})
	}
}

func TestRouterMTUContextConstructorKeepsCapturedConfiguration(t *testing.T) {
	owner, _, platform := routerMTUContextFixture(t)
	config := `{"inbounds":[{"type":"tun","tag":"tun-in","mtu":1380,"address":["172.29.94.1/30"],"auto_route":true,"strict_route":true}],"outbounds":[{"type":"shadowsocks","tag":"proxy","server":"192.0.2.1","server_port":8388,"password":"original-key","method":"2022-blake3-aes-256-gcm"}],"route":{"final":"proxy","rules":[{"protocol":"dns","action":"hijack-dns"}]},"dns":{"final":"selected","servers":[{"type":"tls","tag":"selected","server":"192.0.2.53","detour":"proxy"}]}}`
	profile := `{"id":"home","node_kind":"router-vpn","node_proof_id":"` + strings.Repeat("a", 64) + `","router_api":"http://10.77.0.1:8787","api_token":"fixture-token","daita_host":"10.77.0.1","daita_port":45999,"socks_host":"10.77.0.1","mtu_policy":"auto"}`
	created, err := newRouterMTUContext(context.Background(), owner.server, platform, config, profile)
	if err != nil {
		t.Fatal(err)
	}
	defer created.Close()
	if created.owner.initialContext != nil || created.owner.instance != owner.instance || created.owner.inbound != owner.inbound || created.controller.Config() != config || platform.begins != 0 {
		t.Fatal("constructor changed original owner/configuration or retained construction caller")
	}
}
