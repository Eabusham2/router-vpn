func (l *routerMTUContextLease) Healthy() bool { return true }
func (l *routerMTUContextLease) Close()        {}
func (l *routerMTUContextLease) Inbound() (adapter.Inbound, error) {
	return nil, errors.New("contextless lease read forbidden")
}
func (l *routerMTUContextLease) HealthyContext(ctx context.Context) error {
