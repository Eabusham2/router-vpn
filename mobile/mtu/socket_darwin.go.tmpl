//go:build darwin || ios

package libbox

import "golang.org/x/sys/unix"

func routerMTUNoFragment(fd int,ipv6 bool) error {
 if ipv6{return unix.SetsockoptInt(fd,unix.IPPROTO_IPV6,unix.IPV6_DONTFRAG,1)}
 return unix.SetsockoptInt(fd,unix.IPPROTO_IP,unix.IP_DONTFRAG,1)
}
func RouterMTUBindInterface(fd int64,name string) error {
 value,err:=routerMTUInterface(name);if err!=nil{return err}
 if fd<0||fd>2147483647{return unix.EBADF}
 address,err:=unix.Getsockname(int(fd));if err!=nil{return err}
 switch address.(type){
 case *unix.SockaddrInet4:return unix.SetsockoptInt(int(fd),unix.IPPROTO_IP,unix.IP_BOUND_IF,value.Index)
 case *unix.SockaddrInet6:return unix.SetsockoptInt(int(fd),unix.IPPROTO_IPV6,unix.IPV6_BOUND_IF,value.Index)
 default:return unix.EAFNOSUPPORT
 }
}
