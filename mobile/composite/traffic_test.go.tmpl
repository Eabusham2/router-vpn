// The only physical dialer in this fixture maps immutable documentation/test
// addresses to listeners owned by this test. In particular, the client mapper
// knows only the entry node. A direct client-to-exit leak is an immediate error.
type physical struct {
	outbound.Adapter
	targets      map[string]string
	tcp, packets atomic.Int64
	mu           sync.Mutex
	seen         map[string]int
}

func (p *physical) DialContext(ctx context.Context, network string, to M.Socksaddr) (net.Conn, error) {
	target, ok := p.targets[to.String()]
	if !ok || network != "tcp" && network != "udp" {
		return nil, errors.New("test physical socket bypassed its captured node")
	}
	if network == "tcp" {
		p.tcp.Add(1)
	} else {
		p.packets.Add(1)
	}
	p.mu.Lock()
	p.seen[to.String()]++
	p.mu.Unlock()
	conn, err := (&net.Dialer{}).DialContext(ctx, network, target)
	if err != nil {
		return nil, err
	}
	return &mappedConnected{Conn: conn, remote: to}, nil
}

type mappedConnected struct {
	net.Conn
	remote M.Socksaddr
}

func (c *mappedConnected) RemoteAddr() net.Addr { return c.remote }
func (p *physical) ListenPacket(ctx context.Context, to M.Socksaddr) (net.PacketConn, error) {
	if _, ok := p.targets[to.String()]; !ok {
		return nil, errors.New("test UDP bypassed its captured node")
	}
	conn, err := (&net.ListenConfig{}).ListenPacket(ctx, "udp", "127.0.0.1:0")
	if err != nil {
		return nil, err
	}
	p.packets.Add(1)
	return &mappedPacket{PacketConn: conn, owner: p}, nil
}

type mappedPacket struct {
	net.PacketConn
	owner *physical
}

func (p *mappedPacket) WriteTo(packet []byte, to net.Addr) (int, error) {
	target, ok := p.owner.targets[to.String()]
	if !ok {
		return 0, errors.New("test datagram bypassed its captured node")
	}
	address, err := net.ResolveUDPAddr("udp", target)
	if err != nil {
		return 0, err
	}
	p.owner.mu.Lock()
	p.owner.seen[to.String()]++
	p.owner.mu.Unlock()
	return p.PacketConn.WriteTo(packet, address)
}
func (p *mappedPacket) ReadFrom(packet []byte) (int, net.Addr, error) {
	n, from, err := p.PacketConn.ReadFrom(packet)
	if err != nil {
		return n, from, err
	}
	for original, target := range p.owner.targets {
		if target == from.String() {
			return n, M.ParseSocksaddr(original), nil
		}
	}
	return 0, nil, errors.New("unowned test datagram source")
}

func encode(t *testing.T, value any) []byte {
	t.Helper()
	raw, err := json.Marshal(value)
	if err != nil {
		t.Fatal(err)
	}
	return raw
}

