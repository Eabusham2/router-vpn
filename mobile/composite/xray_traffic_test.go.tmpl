func compositeCamouflage(t *testing.T) string {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	certificate := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "www.example.com"}, DNSNames: []string{"www.example.com"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
	der, err := x509.CreateCertificate(rand.Reader, certificate, certificate, &key.PublicKey, key)
	if err != nil {
		t.Fatal(err)
	}
	private, err := x509.MarshalPKCS8PrivateKey(key)
	if err != nil {
		t.Fatal(err)
	}
	pair, err := tls.X509KeyPair(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: private}))
	if err != nil {
		t.Fatal(err)
	}
	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusNoContent) }))
	server.EnableHTTP2 = true
	server.TLS = &tls.Config{Certificates: []tls.Certificate{pair}, MinVersion: tls.VersionTLS13, MaxVersion: tls.VersionTLS13, CurvePreferences: []tls.CurveID{tls.X25519}}
	server.StartTLS()
	t.Cleanup(server.Close)
	return server.Listener.Addr().String()
}

// Only exact test destinations reach this bridge. It records the native
// Xray server's real TCP egress while preserving the shared node mapper. UDP
// is deliberately unsupported here: the composite must use Hysteria2 for it.
func compositeTCPBridge(t *testing.T, owner *physical, destination string) string {
	t.Helper()
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	var mu sync.Mutex
	stopped := false
	connections := map[net.Conn]bool{}
	t.Cleanup(func() {
		cancel()
		listener.Close()
		mu.Lock()
		defer mu.Unlock()
		stopped = true
		for conn := range connections {
			conn.Close()
		}
	})
	go func() {
		for {
			conn, err := listener.Accept()
			if err != nil {
				return
			}
			mu.Lock()
			if stopped {
				mu.Unlock()
				conn.Close()
				return
			}
			connections[conn] = true
			mu.Unlock()
			go func() {
				defer func() { conn.Close(); mu.Lock(); delete(connections, conn); mu.Unlock() }()
				upstream, err := owner.DialContext(ctx, "tcp", M.ParseSocksaddr(destination))
				if err != nil {
					return
				}
				defer upstream.Close()
				stop := context.AfterFunc(ctx, func() { upstream.Close() })
				defer stop()
				done := make(chan struct{})
				go func() { _, _ = io.Copy(upstream, conn); upstream.Close(); close(done) }()
				_, _ = io.Copy(conn, upstream)
				conn.Close()
				<-done
			}()
		}
	}()
	return listener.Addr().String()
}

func startCompositeXray(t *testing.T, node *node) (int, map[string]any) {
	t.Helper()
	binary := os.Getenv("ROUTER_VPN_XRAY_TEST_BINARY")
	if binary == "" {
		t.Fatal("exact pinned Xray server binary required for encrypted split/MAX proof")
	}
	if node.mode != "split" && node.mode != "max" {
		t.Fatal("unsupported Xray composite fixture mode")
	}
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	port := listener.Addr().(*net.TCPAddr).Port
	defer listener.Close()
	reality, err := ecdh.X25519().GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	user := map[string]any{"id": "11111111-1111-4111-8111-111111111111", "flow": "xtls-rprx-vision", "encryption": "none"}
	decryption := "none"
	if node.mode == "max" {
		seed := make([]byte, 64)
		if _, err := rand.Read(seed); err != nil {
			t.Fatal(err)
		}
		pq, err := mlkem.NewDecapsulationKey768(seed)
		if err != nil {
			t.Fatal(err)
		}
		user["encryption"] = "mlkem768x25519plus.native.0rtt." + base64.RawURLEncoding.EncodeToString(pq.EncapsulationKey().Bytes())
		decryption = "mlkem768x25519plus.native.600s." + base64.RawURLEncoding.EncodeToString(seed)
	}
	clientStream := map[string]any{"network": "raw", "security": "reality", "realitySettings": map[string]any{"serverName": "www.example.com", "fingerprint": "chrome", "password": base64.RawURLEncoding.EncodeToString(reality.PublicKey().Bytes()), "shortId": "0123456789abcdef"}}
	client := map[string]any{"inbounds": []any{map[string]any{"tag": "socks", "listen": "127.0.0.1", "port": 1090, "protocol": "socks", "settings": map[string]any{"auth": "noauth", "udp": true}}}, "outbounds": []any{map[string]any{"tag": "proxy", "protocol": "vless", "settings": map[string]any{"vnext": []any{map[string]any{"address": node.host, "port": port, "users": []any{user}}}}, "streamSettings": clientStream}}}
	serverStream := map[string]any{"network": "raw", "security": "reality", "realitySettings": map[string]any{"target": compositeCamouflage(t), "serverNames": []string{"www.example.com"}, "privateKey": base64.RawURLEncoding.EncodeToString(reality.Bytes()), "shortIds": []string{"0123456789abcdef"}}}
	outputs := []any{map[string]any{"tag": "block", "protocol": "blackhole"}}
	rules := []any{}
	keys := make([]string, 0, len(node.physical.targets))
	for key := range node.physical.targets {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	for index, destination := range keys {
		bridge := compositeTCPBridge(t, node.physical, destination)
		host, destPort, err := net.SplitHostPort(destination)
		if err != nil {
			t.Fatal(err)
		}
		_, bridgePort, err := net.SplitHostPort(bridge)
		if err != nil {
			t.Fatal(err)
		}
		tag := "owned-" + strconv.Itoa(index)
		outputs = append(outputs, map[string]any{"tag": tag, "protocol": "freedom", "settings": map[string]any{"redirect": bridge, "finalRules": []any{map[string]any{"action": "allow", "network": "tcp", "ip": []string{"127.0.0.1/32"}, "port": bridgePort}, map[string]any{"action": "block", "blockDelay": "0-0"}}}})
		rules = append(rules, map[string]any{"type": "field", "network": "tcp", "ip": []string{host + "/32"}, "port": destPort, "outboundTag": tag})
	}
	server := map[string]any{"log": map[string]any{"loglevel": "debug"}, "inbounds": []any{map[string]any{"tag": "captured-node", "listen": "127.0.0.1", "port": port, "protocol": "vless", "settings": map[string]any{"clients": []any{map[string]any{"id": user["id"], "flow": user["flow"]}}, "decryption": decryption}, "streamSettings": serverStream}}, "outbounds": outputs, "routing": map[string]any{"domainStrategy": "AsIs", "rules": rules}}
	// Keep the candidate occupied while the camouflage and all forwarding
	// listeners are constructed. None may reclaim this port and impersonate
	// the Xray child during readiness. A foreign process may still win the
	// final handoff; the bounded launcher recognizes only that exact failure.
	process, actualPort, err := launchCompositeXray(binary, t.TempDir(), server, listener, nil)
	if err != nil {
		t.Fatal(err)
	}
	client["outbounds"].([]any)[0].(map[string]any)["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["port"] = actualPort
	t.Cleanup(func() {
		if err := process.close(); err != nil {
			t.Error(err)
		}
		if t.Failed() {
			t.Logf("owned exact Xray server diagnostics: %s", process.diagnostics())
		}
	})
	return actualPort, client
}

type compositeXrayProcess struct {
	command   *exec.Cmd
	log       *os.File
	done      chan struct{}
	err       error // Published only by closing done after the actual Wait.
	closeOnce sync.Once
	closeErr  error
}

func (p *compositeXrayProcess) diagnostics() string {
	file, err := os.Open(p.log.Name())
	if err != nil {
		return ""
	}
	defer file.Close()
	raw, _ := io.ReadAll(io.LimitReader(file, 64<<10))
	return string(raw)
}

func (p *compositeXrayProcess) close() error {
	p.closeOnce.Do(func() {
		select {
		case <-p.done:
		default:
			_ = p.command.Process.Kill()
			select {
			case <-p.done:
			case <-time.After(3 * time.Second):
				p.closeErr = errors.New("owned Xray fixture process did not join")
				return
			}
		}
		p.closeErr = p.log.Close()
	})
	return p.closeErr
}

// Xray emits platform.LineSeparator(): CRLF on Windows and LF elsewhere.
// Only complete records from the retained child log can witness its exact bind
// and startup. A different listener or an unrelated "started" line cannot.
func compositeXrayStartupRecords(diagnostic, address string) bool {
	if address == "" {
		return false
	}
	bound, started := false, false
	for _, record := range strings.SplitAfter(diagnostic, "\n") {
		if !strings.HasSuffix(record, "\n") {
			continue
		}
		line := strings.TrimSuffix(strings.TrimSuffix(record, "\n"), "\r")
		bound = bound || strings.HasSuffix(line, "transport/internet/tcp: listening TCP on "+address)
		started = started || strings.Contains(line, "core: Xray ") && strings.HasSuffix(line, " started")
	}
	return bound && started
}

func TestCompositeXrayStartupRecords(t *testing.T) {
	address := "127.0.0.1:40981"
	for _, binding := range []string{"transport/internet/tcp: listening TCP on "} {
		for _, ending := range []string{"\n", "\r\n"} {
			bound := "2026/10/31 00:00:00 [Info] " + binding + address + ending
			started := "2026/10/31 00:00:00 [Warning] core: Xray 26.10 started" + ending
			if !compositeXrayStartupRecords(bound+started, address) {
				t.Fatalf("exact owned Xray records were rejected: binding=%q ending=%q", binding, ending)
			}
			for name, diagnostic := range map[string]string{
				"missing-bind":     started,
				"missing-start":    bound,
				"wrong-address":    strings.ReplaceAll(bound, address, "127.0.0.2:40981") + started,
				"extended-address": strings.ReplaceAll(bound, address, address+"0") + started,
				"bind-suffix":      strings.ReplaceAll(bound, address, address+" trailing") + started,
				"truncated-bind":   started + strings.TrimSuffix(bound, ending),
				"truncated-start":  bound + strings.TrimSuffix(started, ending),
				"unrelated-start":  bound + "core: Xray 26.10" + ending + "other component started" + ending,
			} {
				if compositeXrayStartupRecords(diagnostic, address) {
					t.Errorf("unowned or incomplete Xray record was accepted: %s ending=%q", name, ending)
				}
			}
			if compositeXrayStartupRecords(bound+started, "") {
				t.Fatal("empty listener identity was accepted")
			}
		}
	}
}

func (p *compositeXrayProcess) ready(address string) (bool, error) {
	deadline := time.NewTimer(5 * time.Second)
	defer deadline.Stop()
	tick := time.NewTicker(10 * time.Millisecond)
	defer tick.Stop()
	for {
		select {
		case <-p.done:
			// Only a naturally exited child with its own exact bind diagnostic
			// permits another port. TLS, key, config and timeout errors do not.
			diagnostic := p.diagnostics()
			bindError := syscall.EADDRINUSE.Error()
			if goruntime.GOOS == "windows" {
				// Windows net.Listen returns the localized Winsock error, not
				// the synthetic POSIX EADDRINUSE text in package syscall.
				bindError = syscall.Errno(10048).Error() // WSAEADDRINUSE
			}
			collision := p.err != nil && strings.Contains(diagnostic, "listen tcp "+address+": bind: "+bindError)
			return collision, fmt.Errorf("owned Xray fixture exited before readiness: %v\n%s", p.err, diagnostic)
		default:
		}
		diagnostic := p.diagnostics()
		// A TCP accept alone might belong to the port thief. These two records
		// come from this captured child's private log and prove its actual bind
		// and completed startup before the final live-process/socket checks.
		if compositeXrayStartupRecords(diagnostic, address) {
			connection, err := net.DialTimeout("tcp", address, 100*time.Millisecond)
			if err == nil {
				_ = connection.Close()
				select {
				case <-p.done:
					return false, errors.New("owned Xray fixture exited during readiness")
				default:
					return false, nil
				}
			}
		}
		select {
		case <-p.done:
		case <-deadline.C:
			return false, errors.New("owned Xray fixture did not publish its listener and startup within the bound")
		case <-tick.C:
		}
	}
}

// The optional handoff hook belongs only to the deterministic bind-collision
// regression. Ordinary fixtures pass nil and retain their generated identity,
// credentials, routes and TLS parameters across at most three port attempts.
func launchCompositeXray(binary, directory string, server map[string]any, reservation net.Listener, handoff func(int, string) error) (*compositeXrayProcess, int, error) {
	defer func() {
		if reservation != nil {
			_ = reservation.Close()
		}
	}()
	for attempt := 0; attempt < 3; attempt++ {
		address := reservation.Addr().String()
		port := reservation.Addr().(*net.TCPAddr).Port
		server["inbounds"].([]any)[0].(map[string]any)["port"] = port
		path := filepath.Join(directory, fmt.Sprintf("owned-server-%d.json", attempt))
		raw, err := json.Marshal(server)
		if err != nil {
			return nil, 0, err
		}
		if err := os.WriteFile(path, raw, 0600); err != nil {
			return nil, 0, err
		}
		log, err := os.OpenFile(filepath.Join(directory, fmt.Sprintf("owned-server-%d.log", attempt)), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
		if err != nil {
			return nil, 0, err
		}
		command := exec.Command(binary, "run", "-c", path)
		command.Stdout, command.Stderr = log, log
		if err := reservation.Close(); err != nil {
			_ = log.Close()
			return nil, 0, err
		}
		if handoff != nil {
			if err := handoff(attempt, address); err != nil {
				_ = log.Close()
				return nil, 0, err
			}
		}
		if err := command.Start(); err != nil {
			_ = log.Close()
			return nil, 0, err
		}
		process := &compositeXrayProcess{command: command, log: log, done: make(chan struct{})}
		go func() { process.err = command.Wait(); close(process.done) }()
		collision, err := process.ready(address)
		if err == nil {
			return process, port, nil
		}
		if joinErr := process.close(); joinErr != nil {
			return nil, 0, joinErr
		}
		if !collision || attempt == 2 {
			return nil, 0, err
		}
		reservation, err = net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			return nil, 0, err
		}
	}
	return nil, 0, errors.New("owned Xray fixture exhausted bounded bind attempts")
}

func TestCompositeXrayFixtureRetriesOnlyOwnedBindCollision(t *testing.T) {
	binary := os.Getenv("ROUTER_VPN_XRAY_TEST_BINARY")
	if binary == "" {
		t.Fatal("exact pinned Xray server binary required for startup ownership regression")
	}
	for _, scenario := range []string{"foreign-listener", "configuration-failure", "live-child-with-foreign-tcp"} {
		t.Run(scenario, func(t *testing.T) {
			invalid := scenario == "configuration-failure"
			wrongTransport := scenario == "live-child-with-foreign-tcp"
			listener, err := net.Listen("tcp", "127.0.0.1:0")
			if err != nil {
				t.Fatal(err)
			}
			defer listener.Close()
			originalAddress := listener.Addr().String()
			originalPort := listener.Addr().(*net.TCPAddr).Port
			protocol := "socks"
			if invalid {
				protocol = "routervpn-invalid-fixture"
			}
			server := map[string]any{
				"log": map[string]any{"loglevel": "debug"},
				"inbounds": []any{map[string]any{"tag": "captured-node", "listen": "127.0.0.1", "port": originalPort, "protocol": protocol,
					"settings": map[string]any{"auth": "password", "accounts": []any{map[string]any{"user": "captured-test-user", "pass": "captured-test-password"}}, "udp": false}}},
				"outbounds": []any{map[string]any{"tag": "block", "protocol": "blackhole"}},
			}
			if wrongTransport {
				// Keep an actual Xray child alive on UDP while a foreign TCP
				// listener occupies the desired address. Liveness alone is not
				// evidence that this child owns the promised TCP transport.
				inbound := server["inbounds"].([]any)[0].(map[string]any)
				inbound["protocol"] = "dokodemo-door"
				inbound["settings"] = map[string]any{"network": "udp", "address": "127.0.0.1", "port": 9}
			}
			attempts := 0
			var foreign net.Listener
			directory := t.TempDir()
			process, port, err := launchCompositeXray(binary, directory, server, listener, func(attempt int, address string) error {
				attempts++
				if attempt != 0 {
					return nil
				}
				var bindErr error
				foreign, bindErr = net.Listen("tcp", address)
				if bindErr == nil {
					t.Cleanup(func() { _ = foreign.Close() })
				}
				return bindErr
			})
			if process != nil {
				t.Cleanup(func() {
					if err := process.close(); err != nil {
						t.Error(err)
					}
				})
			}
			if invalid || wrongTransport {
				if err == nil || process != nil || attempts != 1 {
					t.Fatal("non-bind startup error was hidden by a port retry", attempts, err)
				}
				if wrongTransport {
					diagnostic, readErr := os.ReadFile(filepath.Join(directory, "owned-server-0.log"))
					if readErr != nil || !strings.Contains(string(diagnostic), "listening UDP on "+originalAddress) || !strings.Contains(string(diagnostic), " started\n") || !strings.Contains(err.Error(), "did not publish") {
						t.Fatal("foreign-listener regression did not retain a live non-TCP child until readiness rejection", err, readErr, string(diagnostic))
					}
				}
			} else {
				if err != nil || process == nil || port == originalPort || attempts != 2 {
					t.Fatal("fixture accepted a foreign listener or failed its bounded bind retry", attempts, err)
				}
				before, after := map[string]any{}, map[string]any{}
				first, e1 := os.ReadFile(filepath.Join(directory, "owned-server-0.json"))
				second, e2 := os.ReadFile(filepath.Join(directory, "owned-server-1.json"))
				if e1 != nil || e2 != nil || json.Unmarshal(first, &before) != nil || json.Unmarshal(second, &after) != nil {
					t.Fatal("fixture retry lost a captured attempt")
				}
				before["inbounds"].([]any)[0].(map[string]any)["port"] = float64(port)
				if !reflect.DeepEqual(before, after) {
					t.Fatal("fixture bind retry changed credentials or routing")
				}
			}
			// The wrong listener remains available. A bare TCP readiness check
			// would accept it; the launcher must neither use nor close it.
			connection, dialErr := net.DialTimeout("tcp", originalAddress, time.Second)
			if dialErr != nil {
				t.Fatal("fixture altered the retained foreign listener", dialErr)
			}
			_ = connection.Close()
		})
	}
}
