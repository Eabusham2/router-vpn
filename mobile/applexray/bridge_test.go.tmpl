package libbox

import (
	"crypto/ecdh"
	"crypto/mlkem"
	"encoding/base64"
	"encoding/json"
	"strings"
	"testing"
)

func TestRouterXrayRegisteredInTheActualNativeCore(t *testing.T) {
	key, err := ecdh.X25519().NewPrivateKey(make([]byte, 32))
	if err != nil {
		t.Fatal(err)
	}
	user := map[string]any{"id": "11111111-1111-4111-8111-111111111111", "flow": "xtls-rprx-vision", "encryption": "none"}
	stream := map[string]any{"network": "raw", "security": "reality", "realitySettings": map[string]any{"serverName": "www.example.com", "fingerprint": "chrome", "password": base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()), "shortId": "0123456789abcdef"}}
	cfg := map[string]any{"inbounds": []any{map[string]any{"protocol": "socks", "listen": "127.0.0.1", "port": 1090, "settings": map[string]any{"udp": true, "auth": "noauth"}}}, "outbounds": []any{map[string]any{"protocol": "vless", "tag": "proxy", "settings": map[string]any{"vnext": []any{map[string]any{"address": "192.0.2.1", "port": 443, "users": []any{user}}}}, "streamSettings": stream}}}
	raw, err := json.Marshal(cfg)
	if err != nil {
		t.Fatal(err)
	}
	wrapper := `{"inbounds":[{"type":"tun","auto_route":true,"strict_route":true}],"outbounds":[{"type":"socks","tag":"proxy","server":"127.0.0.1","server_port":1090,"version":"5"}],"route":{"final":"proxy"}}`
	result, err := RouterCompileXrayProfile("reality-vision", wrapper, string(raw))
	if err != nil {
		t.Fatal(err)
	}
	var offline map[string]any
	if err = json.Unmarshal([]byte(result), &offline); err != nil {
		t.Fatal(err)
	}
	offline["inbounds"] = []any{map[string]any{"type": "mixed", "listen": "127.0.0.1", "listen_port": 0}}
	checked, err := json.Marshal(offline)
	if err != nil {
		t.Fatal(err)
	}
	if err = CheckConfig(string(checked)); err != nil {
		t.Fatal("actual pinned core rejected native Xray:", err)
	}
	if RouterXrayRevision() != "50231eaff98ccc31b5cbd247a721c16e97fe5ec1" {
		t.Fatal("wrong native Xray revision")
	}
}

func TestRouterXrayStartLayerRegisteredNativeGraph(t *testing.T) {
	private, err := ecdh.X25519().NewPrivateKey(make([]byte, 32))
	if err != nil {
		t.Fatal(err)
	}
	pq, err := mlkem.NewDecapsulationKey768(make([]byte, 64))
	if err != nil {
		t.Fatal(err)
	}
	for _, mode := range []string{"reality-vision", "reality-pq-vision", "reality-xhttp", "split", "max"} {
		for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			t.Run(mode+"/"+layer, func(t *testing.T) {
				user := map[string]any{"id": "11111111-1111-4111-8111-111111111111", "flow": "xtls-rprx-vision", "encryption": "none"}
				stream := map[string]any{"network": "raw", "security": "reality", "realitySettings": map[string]any{"serverName": "www.example.com", "fingerprint": "chrome", "password": base64.RawURLEncoding.EncodeToString(private.PublicKey().Bytes()), "shortId": "0123456789abcdef"}}
				if mode == "reality-pq-vision" || mode == "reality-xhttp" || mode == "max" {
					user["encryption"] = "mlkem768x25519plus.native.0rtt." + base64.RawURLEncoding.EncodeToString(pq.EncapsulationKey().Bytes())
				}
				if mode == "reality-xhttp" {
					delete(user, "flow")
					stream["network"] = "xhttp"
					stream["xhttpSettings"] = map[string]any{"path": "/auth", "mode": "auto"}
				}
				raw := map[string]any{"inbounds": []any{map[string]any{"protocol": "socks", "listen": "127.0.0.1", "port": 1090, "settings": map[string]any{"auth": "noauth", "udp": true}}}, "outbounds": []any{map[string]any{"protocol": "vless", "tag": "proxy", "settings": map[string]any{"vnext": []any{map[string]any{"address": "192.0.2.1", "port": 443, "users": []any{user}}}}, "streamSettings": stream}}}
				wrapper := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "auto_route": true, "strict_route": true}}, "outbounds": []any{map[string]any{"type": "socks", "tag": "proxy", "server": "127.0.0.1", "server_port": 1090, "version": "5"}}, "route": map[string]any{"final": "proxy"}}
				if mode == "split" || mode == "max" {
					wrapper["outbounds"] = append(wrapper["outbounds"].([]any), map[string]any{"type": "hysteria2", "tag": "udp", "server": "192.0.2.1", "server_port": 8443, "password": "test-only-auth", "tls": map[string]any{"enabled": true, "server_name": "hy.example.test"}})
					wrapper["route"].(map[string]any)["rules"] = []any{map[string]any{"network": "tcp", "action": "route", "outbound": "proxy"}, map[string]any{"network": "udp", "action": "route", "outbound": "udp"}}
				}
				aes := map[string]any{"outbounds": []any{map[string]any{"type": "shadowsocks", "tag": "proxy", "server": "192.0.2.1", "server_port": 8388, "method": "2022-blake3-aes-256-gcm", "password": base64.StdEncoding.EncodeToString([]byte(strings.Repeat("s", 32)))}}}
				policy := map[string]string{"mode": layer, "raw_mode": mode, "node_kind": "router-vpn", "router_api": "http://10.77.0.1:8787"}
				a, _ := json.Marshal(wrapper)
				b, _ := json.Marshal(raw)
				c, _ := json.Marshal(aes)
				d, _ := json.Marshal(policy)
				graph, err := RouterComposeXrayStartLayer(mode, string(a), string(b), string(c), string(d))
				if err != nil {
					t.Fatal(err)
				}
				var offline map[string]any
				if err = json.Unmarshal([]byte(graph), &offline); err != nil {
					t.Fatal(err)
				}
				offline["inbounds"] = []any{map[string]any{"type": "mixed", "listen": "127.0.0.1", "listen_port": 0}}
				checked, _ := json.Marshal(offline)
				if err = CheckConfig(string(checked)); err != nil {
					t.Fatal("native Xray/REALITY/PQ/dual-transport AES graph rejected", err)
				}
			})
		}
	}
}
