// These tests never reach the public Internet, use a user key or change routes.
// The real native client talks to a separate exact-revision Xray server process.
// Only the physical dialer's documentation-IP destination is mapped to loopback.
// All cryptography and VLESS/TCP/UDP framing use the actual production engines.
type loopbackUnderlay struct {
	destination string
	mu          sync.Mutex
	calls       int
}

func (d *loopbackUnderlay) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	if network != "tcp" || destination.String() != "192.0.2.1:443" {
		return nil, fmt.Errorf("unexpected outer dial %s %s", network, destination.String())
	}
	d.mu.Lock()
	d.calls++
	d.mu.Unlock()
	return (&net.Dialer{}).DialContext(ctx, "tcp", d.destination)
}
func (*loopbackUnderlay) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
	return nil, fmt.Errorf("unexpected physical UDP dial")
}
func loopbackCamouflage(t *testing.T) string {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	template := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "www.example.com"}, DNSNames: []string{"www.example.com"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
	cert, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
	if err != nil {
		t.Fatal(err)
	}
	encoded, err := x509.MarshalPKCS8PrivateKey(key)
	if err != nil {
		t.Fatal(err)
	}
	pair, err := tls.X509KeyPair(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: cert}), pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: encoded}))
	if err != nil {
		t.Fatal(err)
	}
	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusNoContent) }))
	server.EnableHTTP2 = true
	server.TLS = &tls.Config{Certificates: []tls.Certificate{pair}, MinVersion: tls.VersionTLS13, MaxVersion: tls.VersionTLS13, CurvePreferences: []tls.CurveID{tls.X25519}}
	server.StartTLS()
	t.Cleanup(server.Close)
	return server.Listener.Addr().String()
}
func loopbackEcho(t *testing.T) (string, string) {
	t.Helper()
	tcp, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	udp, err := net.ListenPacket("udp", "127.0.0.1:0")
	if err != nil {
		tcp.Close()
		t.Fatal(err)
	}
	var mu sync.Mutex
	connections := map[net.Conn]bool{}
	t.Cleanup(func() {
		tcp.Close()
		udp.Close()
		mu.Lock()
		defer mu.Unlock()
		for c := range connections {
			c.Close()
		}
	})
	go func() {
		for {
			c, err := tcp.Accept()
			if err != nil {
				return
			}
			mu.Lock()
			connections[c] = true
			mu.Unlock()
			go func() { defer c.Close(); _, _ = io.Copy(c, c); mu.Lock(); delete(connections, c); mu.Unlock() }()
		}
	}()
	go func() {
		b := make([]byte, 65535)
		for {
			n, a, err := udp.ReadFrom(b)
			if err != nil {
				return
			}
			_, _ = udp.WriteTo(b[:n], a)
		}
	}()
	return tcp.Addr().String(), udp.LocalAddr().String()
}

type loopbackXrayDNSRoute struct {
	network string
	server  string
	port    uint16
	private string
}

func startLoopbackXray(t *testing.T, mode, camouflage, tcpEcho, udpEcho string, raw []byte) (string, []byte) {
	t.Helper()
	return startLoopbackXrayWithDNS(t, mode, camouflage, tcpEcho, udpEcho, raw, nil)
}

// Extra routes exist only in the separate reference process. They admit one
// captured DNS tuple each to its retained loopback peer; existing callers keep
// their original echo-only policy and gain no resolver or Internet fallback.
func startLoopbackXrayWithDNS(t *testing.T, mode, camouflage, tcpEcho, udpEcho string, raw []byte, routes []loopbackXrayDNSRoute, diagnostics ...func(string)) (string, []byte) {
	t.Helper()
	binary := os.Getenv("ROUTER_VPN_XRAY_TEST_BINARY")
	if binary == "" {
		t.Fatal("pinned Xray fixture binary is required for encrypted traffic tests")
	}
	// Reserve a loopback-only candidate port; a readiness check also verifies
	// that the exact child is still running before the test adopts the port.
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	address := listener.Addr().String()
	port := listener.Addr().(*net.TCPAddr).Port
	listener.Close()
	realityKey, err := ecdh.X25519().GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	client, err := applexray.Object(raw)
	if err != nil {
		t.Fatal(err)
	}
	outbound := client["outbounds"].([]any)[0].(map[string]any)
	stream := outbound["streamSettings"].(map[string]any)
	stream["realitySettings"].(map[string]any)["password"] = base64.RawURLEncoding.EncodeToString(realityKey.PublicKey().Bytes())
	user := outbound["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)
	serverUser := map[string]any{"id": user["id"]}
	if flow, ok := user["flow"]; ok {
		if flow == "xtls-rprx-vision-udp443" {
			// UDP443 is an explicit client choice; the actual server protocol
			// always authenticates the ordinary Vision flow.
			flow = "xtls-rprx-vision"
		}
		serverUser["flow"] = flow
	}
	decryption := "none"
	if mode == "reality-pq-vision" || mode == "reality-xhttp" || mode == "max" {
		seed := make([]byte, 64)
		if _, err := rand.Read(seed); err != nil {
			t.Fatal(err)
		}
		pq, err := mlkem.NewDecapsulationKey768(seed)
		if err != nil {
			t.Fatal(err)
		}
		user["encryption"] = "mlkem768x25519plus.native.0rtt." + base64.RawURLEncoding.EncodeToString(pq.EncapsulationKey().Bytes())
		decryption = "mlkem768x25519plus.native.600s." + base64.RawURLEncoding.EncodeToString(seed)
	}
	serverStream := map[string]any{"network": stream["network"], "security": "reality", "realitySettings": map[string]any{"target": camouflage, "serverNames": []string{"www.example.com"}, "privateKey": base64.RawURLEncoding.EncodeToString(realityKey.Bytes()), "shortIds": []string{"0123456789abcdef"}}}
	if mode == "reality-xhttp" {
		serverStream["xhttpSettings"] = stream["xhttpSettings"]
		if mask, present := stream["finalmask"]; present {
			serverStream["finalmask"] = mask
		}
	}
	// Explicitly authorize only this test's loopback echo endpoints. New Xray
	// versions correctly reject private destinations from VLESS by default.
	// This rule is fixture-only; every other destination is blocked immediately.
	_, tcpPort, err := net.SplitHostPort(tcpEcho)
	if err != nil {
		t.Fatal(err)
	}
	_, udpPort, err := net.SplitHostPort(udpEcho)
	if err != nil {
		t.Fatal(err)
	}
	echoPolicy := map[string]any{"finalRules": []any{
		map[string]any{"action": "allow", "network": "tcp", "ip": []string{"127.0.0.1/32"}, "port": tcpPort},
		map[string]any{"action": "allow", "network": "udp", "ip": []string{"127.0.0.1/32"}, "port": udpPort},
		map[string]any{"action": "block", "blockDelay": "0-0"},
	}}
	server := map[string]any{"log": map[string]any{"loglevel": "debug"}, "inbounds": []any{map[string]any{"tag": "local-test-server", "listen": "127.0.0.1", "port": port, "protocol": "vless", "settings": map[string]any{"clients": []any{serverUser}, "decryption": decryption}, "streamSettings": serverStream}}, "outbounds": []any{map[string]any{"protocol": "freedom", "tag": "test-echo", "settings": echoPolicy}}}
	if len(routes) != 0 {
		outbounds := server["outbounds"].([]any)
		var rules []any
		seen := map[string]bool{}
		for index, route := range routes {
			selected, err := netip.ParseAddr(route.server)
			private, privateErr := netip.ParseAddrPort(route.private)
			identity := fmt.Sprintf("%s/%s/%d", route.network, route.server, route.port)
			if err != nil || !selected.Is4() || selected.IsLoopback() || selected.IsUnspecified() || route.port == 0 ||
				privateErr != nil || !private.Addr().Is4() || !private.Addr().IsLoopback() || private.Port() == 0 ||
				(route.network != "tcp" && route.network != "udp") || seen[identity] {
				t.Fatal("loopback Xray lost an exact separately owned DNS route")
			}
			seen[identity] = true
			tag := fmt.Sprintf("captured-dns-%d", index)
			outbounds = append(outbounds, map[string]any{"protocol": "freedom", "tag": tag, "settings": map[string]any{
				"redirect": route.private, "finalRules": []any{
					map[string]any{"action": "allow", "network": route.network, "ip": []string{"127.0.0.1/32"}, "port": fmt.Sprint(private.Port())},
					map[string]any{"action": "block", "blockDelay": "0-0"},
				}}})
			rules = append(rules, map[string]any{"type": "field", "network": route.network, "ip": []string{route.server + "/32"}, "port": fmt.Sprint(route.port), "outboundTag": tag})
		}
		server["outbounds"] = outbounds
		server["routing"] = map[string]any{"domainStrategy": "AsIs", "rules": rules}
	}
	config, err := json.Marshal(server)
	if err != nil {
		t.Fatal(err)
	}
	path := filepath.Join(t.TempDir(), "test-server.json")
	if err := os.WriteFile(path, config, 0600); err != nil {
		t.Fatal(err)
	}
	log, err := os.Create(filepath.Join(t.TempDir(), "server.log"))
	if err != nil {
		t.Fatal(err)
	}
	if len(diagnostics) > 1 {
		t.Fatal("multiple reference diagnostic owners")
	}
	if len(diagnostics) == 1 {
		diagnostics[0](log.Name())
	}
	command := exec.Command(binary, "run", "-c", path)
	capture := ""
	if os.Getenv("ROUTER_VPN_XRAY_REFERENCE_DETECTOR_READY") == "1" {
		capture = fmt.Sprintf("%x", sha256.Sum256(config))
		command.Env = append(os.Environ(), "ROUTER_VPN_XRAY_REFERENCE_DETECTOR_CAPTURE="+capture)
	}
	command.Stdout = log
	command.Stderr = log
	if err := command.Start(); err != nil {
		t.Fatal(err)
	}
	done := make(chan error, 1)
	go func() { done <- command.Wait() }()
	t.Cleanup(func() {
		_ = command.Process.Kill()
		select {
		case <-done:
		case <-time.After(3 * time.Second):
			t.Error("test server process did not exit")
		}
		log.Close()
		if t.Failed() {
			body, _ := os.ReadFile(log.Name())
			t.Logf("isolated fixture server diagnostics: %s", body)
		}
	})
	ready := false
	for until := time.Now().Add(5 * time.Second); time.Now().Before(until); {
		select {
		case err := <-done:
			done <- err
			log.Close()
			body, _ := os.ReadFile(log.Name())
			t.Fatalf("fixture server failed: %v: %s", err, body)
		default:
		}
		c, err := net.DialTimeout("tcp", address, 100*time.Millisecond)
		if err == nil {
			c.Close()
			if capture == "" {
				ready = true
				break
			}
			diagnostic, readErr := os.ReadFile(log.Name())
			original, sourceErr := os.ReadFile(path)
			if readErr == nil && sourceErr == nil && bytes.Equal(original, config) &&
				loopbackXrayDetectorRecord(diagnostic, command.Process.Pid, capture, camouflage) {
				select {
				case err := <-done:
					done <- err
					t.Fatal("original loopback Xray child exited during detector readiness", err)
				default:
				}
				ready = true
				break
			}
		}
		time.Sleep(20 * time.Millisecond)
	}
	if !ready {
		t.Fatal("loopback Xray server never became ready")
	}
	normalized, err := json.Marshal(client)
	if err != nil {
		t.Fatal(err)
	}
	return address, normalized
}

func loopbackXrayDetectorRecord(diagnostic []byte, pid int, capture, camouflage string) bool {
	if pid <= 0 || len(capture) != 64 || camouflage == "" {
		return false
	}
	keys := []string{camouflage + " www.example.com 0", camouflage + " www.example.com 1", camouflage + " www.example.com 2"}
	sort.Strings(keys)
	raw, _ := json.Marshal(keys)
	wanted := fmt.Sprintf("RouterVPN reference detector complete: pid=%d config=%s tuples=%x", pid, capture, sha256.Sum256(raw))
	count := 0
	for _, line := range strings.SplitAfter(string(diagnostic), "\n") {
		if strings.HasSuffix(line, "\n") && strings.TrimSuffix(strings.TrimSuffix(line, "\n"), "\r") == wanted {
			count++
		}
	}
	return count == 1
}
func TestNativeXrayEncryptedLoopbackTCPAndUDP(t *testing.T) {
	installScopedDialer()
	camouflage := loopbackCamouflage(t)
	tcp, udp := loopbackEcho(t)
	tests := []struct{ mode, mask string }{
		{"reality-vision", "original"}, {"reality-pq-vision", "original"},
		{"reality-xhttp", "original"}, {"reality-xhttp", "no-finalmask-control"},
		{"reality-xhttp", "tcp-segments-control"},
	}
	for _, test := range tests {
		mode := test.mode
		t.Run(mode+"/"+test.mask, func(t *testing.T) {
			input := nativeConfig(t, mode)
			if mode == "reality-xhttp" && test.mask != "original" {
				config, err := applexray.Object(input)
				if err != nil {
					t.Fatal(err)
				}
				stream := config["outbounds"].([]any)[0].(map[string]any)["streamSettings"].(map[string]any)
				if test.mask == "no-finalmask-control" {
					delete(stream, "finalmask")
				} else {
					stream["finalmask"].(map[string]any)["tcp"].([]any)[0].(map[string]any)["settings"].(map[string]any)["packets"] = "1-1"
				}
				input, err = json.Marshal(config)
				if err != nil {
					t.Fatal(err)
				}
			}
			endpoint, raw := startLoopbackXray(t, mode, camouflage, tcp, udp, input)
			plan, err := applexray.Prepare(mode, raw)
			if err != nil {
				t.Fatal(err)
			}
			// Fixture-only diagnostics: the production compiler still disables file
			// logging. Generated test keys are ephemeral and no user profile is used.
			diagnostic, err := applexray.Object(plan.JSON)
			if err != nil {
				t.Fatal(err)
			}
			diagnostic["log"] = map[string]any{"loglevel": "debug"}
			plan.JSON, err = json.Marshal(diagnostic)
			if err != nil {
				t.Fatal(err)
			}
			ctx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
			defer cancel()
			underlay := &loopbackUnderlay{destination: endpoint}
			binding := &binding{ctx: ctx, dialer: underlay, server: netip.MustParseAddrPort("192.0.2.1:443"), sockets: map[*ownedConn]bool{}}
			h := &Outbound{ctx: context.WithValue(ctx, bindingKey{}, binding), cancel: cancel, binding: binding, plan: plan}
			if err := h.Start(adapter.StartStateStart); err != nil {
				t.Fatal(err)
			}
			t.Cleanup(func() { _ = h.Close() })
			conn, err := h.DialContext(ctx, "tcp", M.ParseSocksaddr(tcp))
			if err != nil {
				t.Fatal(err)
			}
			conn.SetDeadline(time.Now().Add(8 * time.Second))
			payload := bytes.Repeat([]byte("authenticated-native-xray-payload/"), 512)
			if _, err = conn.Write(payload); err != nil {
				t.Fatal("encrypted TCP write:", err)
			}
			received := make([]byte, len(payload))
			if _, err = io.ReadFull(conn, received); err != nil {
				trace := make([]byte, 128*1024)
				n := runtime.Stack(trace, true)
				t.Logf("bounded isolated-traffic failure trace: %s", trace[:n])
				t.Fatal("encrypted TCP read:", err)
			}
			if !bytes.Equal(received, payload) {
				t.Fatal("encrypted TCP payload changed")
			}
			conn.Close()
			packets, err := h.ListenPacket(ctx, M.ParseSocksaddr(udp))
			if err != nil {
				t.Fatal(err)
			}
			defer packets.Close()
			for _, size := range []int{64, 1200, 9000} {
				packets.SetDeadline(time.Now().Add(8 * time.Second))
				message := bytes.Repeat([]byte{byte(size)}, size)
				if _, err = packets.WriteTo(message, M.ParseSocksaddr(udp)); err != nil {
					t.Fatalf("encrypted UDP %d write: %v", size, err)
				}
				b := make([]byte, 65535)
				n, from, err := packets.ReadFrom(b)
				if err != nil {
					t.Fatalf("encrypted UDP %d read: %v", size, err)
				}
				if from.String() != udp || n != size || !bytes.Equal(b[:n], message) {
					t.Fatalf("encrypted UDP %d destination/payload changed: received=%d from=%v expected=%s", size, n, from, udp)
				}
			}
			if err := h.Close(); err != nil {
				t.Fatal(err)
			}
			if _, err := packets.WriteTo([]byte("after-close"), M.ParseSocksaddr(udp)); err == nil {
				t.Fatal("datagram survived native owner teardown")
			}
			underlay.mu.Lock()
			calls := underlay.calls
			underlay.mu.Unlock()
			if calls == 0 {
				t.Fatal("test bypassed encrypted physical transport")
			}
		})
	}
}

func TestNativeXrayCompletedDialRetainsOwnedConnections(t *testing.T) {
	installScopedDialer()
	camouflage := loopbackCamouflage(t)
	tcp, udp := loopbackEcho(t)
	for _, mode := range []string{"reality-vision", "reality-pq-vision", "reality-xhttp"} {
		t.Run(mode, func(t *testing.T) {
			endpoint, raw := startLoopbackXray(t, mode, camouflage, tcp, udp, nativeConfig(t, mode))
			plan, err := applexray.Prepare(mode, raw)
			if err != nil {
				t.Fatal(err)
			}
			lifetime, retire := context.WithCancel(context.Background())
			defer retire()
			underlay := &loopbackUnderlay{destination: endpoint}
			binding := &binding{ctx: lifetime, dialer: underlay, server: netip.MustParseAddrPort("192.0.2.1:443"), sockets: map[*ownedConn]bool{}}
			h := &Outbound{ctx: context.WithValue(lifetime, bindingKey{}, binding), cancel: retire, binding: binding, plan: plan}
			if err := h.Start(adapter.StartStateStart); err != nil {
				t.Fatal(err)
			}
			t.Cleanup(func() { _ = h.Close() })
			var connections []net.Conn
			for _, target := range []struct{ network, address string }{{"tcp", tcp}, {"udp", udp}} {
				pending, cancel := context.WithCancel(context.Background())
				cancel()
				if connection, err := h.DialContext(pending, target.network, M.ParseSocksaddr(target.address)); err == nil || connection != nil {
					if connection != nil {
						_ = connection.Close()
					}
					t.Fatal("cancelled caller published an actual native dispatch")
				}
				caller, dialFinished := context.WithCancel(context.Background())
				connection, err := h.DialContext(caller, target.network, M.ParseSocksaddr(target.address))
				dialFinished() // Same lifetime transition used by the actual DNS pool.
				if err != nil {
					t.Fatal(err)
				}
				connections = append(connections, connection)
				defer connection.Close()
				if err := connection.SetDeadline(time.Now().Add(8 * time.Second)); err != nil {
					t.Fatal(err)
				}
				message := bytes.Repeat([]byte("captured-native-owner/"), 24)
				if _, err := connection.Write(message); err != nil {
					t.Fatal("completed actual Xray dial retained its caller cancellation", target.network, err)
				}
				answer := make([]byte, len(message))
				if _, err := io.ReadFull(connection, answer); err != nil || !bytes.Equal(answer, message) {
					t.Fatal("completed actual Xray dial lost authenticated traffic", target.network, err)
				}
			}
			if err := h.Close(); err != nil {
				t.Fatal(err)
			}
			for _, connection := range connections {
				if n, err := connection.Write([]byte("retired")); err == nil || n != 0 {
					t.Fatal("actual native retirement lost a returned connection", n, err)
				}
			}
		})
	}
}

// This separately bounded protocol reference proves ML-KEM authentication at
// the existing owned dialer boundary. It grants no imported physical route,
// system TUN, mobile VPN entitlement, or public router acceptance.
func TestNativePQRealityAuthenticationRefusal(t *testing.T) {
	installScopedDialer()
	camouflage := loopbackCamouflage(t)
	tcp, udp := loopbackEcho(t)
	endpoint, original := startLoopbackXray(t, "reality-pq-vision", camouflage, tcp, udp, nativeConfig(t, "reality-pq-vision"))
	for _, fault := range []string{"matching-key", "wrong-pq-key", "restored-key"} {
		t.Run(fault, func(t *testing.T) {
			raw := append([]byte(nil), original...)
			if fault == "wrong-pq-key" {
				graph, err := applexray.Object(raw)
				if err != nil {
					t.Fatal(err)
				}
				key, err := mlkem.NewDecapsulationKey768(bytes.Repeat([]byte{0x39}, 64))
				if err != nil {
					t.Fatal(err)
				}
				user := graph["outbounds"].([]any)[0].(map[string]any)["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)
				user["encryption"] = "mlkem768x25519plus.native.0rtt." + base64.RawURLEncoding.EncodeToString(key.EncapsulationKey().Bytes())
				raw, err = json.Marshal(graph)
				if err != nil {
					t.Fatal(err)
				}
			}
			plan, err := applexray.Prepare("reality-pq-vision", raw)
			if err != nil {
				t.Fatal("reference must exercise a structurally valid PQ key", err)
			}
			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
			defer cancel()
			underlay := &loopbackUnderlay{destination: endpoint}
			binding := &binding{ctx: ctx, dialer: underlay, server: netip.MustParseAddrPort("192.0.2.1:443"), sockets: map[*ownedConn]bool{}}
			h := &Outbound{ctx: context.WithValue(ctx, bindingKey{}, binding), cancel: cancel, binding: binding, plan: plan}
			if err := h.Start(adapter.StartStateStart); err != nil {
				t.Fatal(err)
			}
			defer h.Close()
			conn, err := h.DialContext(ctx, "tcp", M.ParseSocksaddr(tcp))
			if err != nil {
				t.Fatal("PQ key control must reach the actual owned transport", err)
			}
			defer conn.Close()
			conn.SetDeadline(time.Now().Add(3 * time.Second))
			payload := []byte("captured-pq-authentication-control")
			_, writeErr := conn.Write(payload)
			received := make([]byte, len(payload))
			n, readErr := io.ReadFull(conn, received)
			if fault == "wrong-pq-key" {
				if readErr == nil || n != 0 {
					t.Fatal("wrong ML-KEM peer key gained authenticated plaintext")
				}
			} else if writeErr != nil || readErr != nil || !bytes.Equal(received, payload) {
				t.Fatal("matching original PQ key failed authenticated traffic", writeErr, readErr)
			}
			underlay.mu.Lock()
			calls := underlay.calls
			underlay.mu.Unlock()
			if calls == 0 {
				t.Fatal("PQ authentication control never reached original encrypted peer")
			}
			if err := h.Close(); err != nil {
				t.Fatal(err)
			}
		})
	}
}

// Separate XHTTP controls exercise the existing pinned server and scoped owner.
// A disjoint path is required: Xray deliberately accepts a normalized prefix.
func TestNativeXHTTPAuthenticationRefusal(t *testing.T) {
	installScopedDialer()
	camouflage := loopbackCamouflage(t)
	tcp, udp := loopbackEcho(t)
	var diagnostic string
	endpoint, original := startLoopbackXrayWithDNS(t, "reality-xhttp", camouflage, tcp, udp, nativeConfig(t, "reality-xhttp"), nil, func(path string) { diagnostic = path })
	for _, fault := range []string{"matching-key", "wrong-xhttp-path", "restored-path", "wrong-pq-key", "restored-key"} {
		t.Run(fault, func(t *testing.T) {
			prior, err := os.ReadFile(diagnostic)
			if err != nil {
				t.Fatal(err)
			}
			raw := bytes.Clone(original)
			graph, err := applexray.Object(raw)
			if err != nil {
				t.Fatal(err)
			}
			outbound := graph["outbounds"].([]any)[0].(map[string]any)
			user := outbound["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)
			if fault == "wrong-xhttp-path" {
				outbound["streamSettings"].(map[string]any)["xhttpSettings"].(map[string]any)["path"] = "/unowned-xhttp-control"
			} else if fault == "wrong-pq-key" {
				key, err := mlkem.NewDecapsulationKey768(bytes.Repeat([]byte{0x59}, 64))
				if err != nil {
					t.Fatal(err)
				}
				changed := "mlkem768x25519plus.native.0rtt." + base64.RawURLEncoding.EncodeToString(key.EncapsulationKey().Bytes())
				if changed == user["encryption"] {
					t.Fatal("key control equals original peer")
				}
				user["encryption"] = changed
			}
			raw, err = json.Marshal(graph)
			if err != nil {
				t.Fatal(err)
			}
			plan, err := applexray.Prepare("reality-xhttp", raw)
			if err != nil {
				t.Fatal("peer control must be structurally valid", err)
			}
			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
			defer cancel()
			underlay := &loopbackUnderlay{destination: endpoint}
			binding := &binding{ctx: ctx, dialer: underlay, server: netip.MustParseAddrPort("192.0.2.1:443"), sockets: map[*ownedConn]bool{}}
			h := &Outbound{ctx: context.WithValue(ctx, bindingKey{}, binding), cancel: cancel, binding: binding, plan: plan}
			if err := h.Start(adapter.StartStateStart); err != nil {
				t.Fatal(err)
			}
			defer h.Close()
			conn, dialErr := h.DialContext(ctx, "tcp", M.ParseSocksaddr(tcp))
			payload := []byte("captured-xhttp-authentication-control")
			received := make([]byte, len(payload))
			var n int
			var writeErr, errorRead error
			if dialErr == nil {
				defer conn.Close()
				conn.SetDeadline(time.Now().Add(3 * time.Second))
				_, writeErr = conn.Write(payload)
				n, errorRead = io.ReadFull(conn, received)
			} else {
				errorRead = dialErr
			}
			negative := fault == "wrong-xhttp-path" || fault == "wrong-pq-key"
			if negative {
				if errorRead == nil || n != 0 {
					t.Fatal("foreign XHTTP authority gained authenticated plaintext")
				}
			} else if dialErr != nil || writeErr != nil || errorRead != nil || !bytes.Equal(received, payload) {
				t.Fatal("original XHTTP did not restore authenticated traffic", dialErr, writeErr, errorRead)
			}
			underlay.mu.Lock()
			calls := underlay.calls
			underlay.mu.Unlock()
			if calls == 0 {
				t.Fatal("XHTTP control never reached original encrypted peer")
			}
			if conn != nil {
				_ = conn.Close()
			}
			if err := h.Close(); err != nil {
				t.Fatal(err)
			}
			if negative {
				wanted := "ML-KEM-768 handshake failed"
				if fault == "wrong-xhttp-path" {
					wanted = "failed to validate path"
				}
				tick := time.NewTicker(10 * time.Millisecond)
				defer tick.Stop()
				for {
					evidence, err := os.ReadFile(diagnostic)
					if err != nil || len(evidence) < len(prior) || !bytes.Equal(evidence[:len(prior)], prior) {
						t.Fatal("original XHTTP peer diagnostics changed", err)
					}
					recent := evidence[len(prior):]
					if bytes.Contains(recent, []byte(wanted)) && (fault != "wrong-xhttp-path" || bytes.Contains(recent, []byte("/unowned-xhttp-control/"))) {
						break
					}
					select {
					case <-ctx.Done():
						t.Fatal("original encrypted peer did not witness exact XHTTP refusal", fault, string(recent))
					case <-tick.C:
					}
				}
			}
		})
	}
}

func TestNativeXHTTPConfigurationRefusal(t *testing.T) {
	installScopedDialer()
	for _, fault := range []string{"ordinary-key", "missing-key", "malformed-key", "vision-flow", "vision-udp443-flow", "raw-network", "relative-path", "download-settings", "foreign-mode"} {
		t.Run(fault, func(t *testing.T) {
			graph, err := applexray.Object(nativeConfig(t, "reality-xhttp"))
			if err != nil {
				t.Fatal(err)
			}
			out := graph["outbounds"].([]any)[0].(map[string]any)
			user := out["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)
			stream := out["streamSettings"].(map[string]any)
			settings := stream["xhttpSettings"].(map[string]any)
			switch fault {
			case "ordinary-key":
				user["encryption"] = "none"
			case "missing-key":
				delete(user, "encryption")
			case "malformed-key":
				user["encryption"] = "mlkem768x25519plus.native.0rtt.not_a_valid_encapsulation_key"
			case "vision-flow":
				user["flow"] = "xtls-rprx-vision"
			case "vision-udp443-flow":
				user["flow"] = "xtls-rprx-vision-udp443"
			case "raw-network":
				stream["network"] = "raw"
			case "relative-path":
				settings["path"] = "relative"
			case "download-settings":
				settings["downloadSettings"] = map[string]any{"address": "198.51.100.99"}
			case "foreign-mode":
				settings["mode"] = "stream-one"
			}
			raw, err := json.Marshal(graph)
			if err != nil {
				t.Fatal(err)
			}
			plan, err := applexray.Prepare("reality-xhttp", raw)
			if fault != "malformed-key" {
				if err == nil {
					t.Fatal("unowned XHTTP configuration admitted")
				}
				return
			}
			if err != nil {
				t.Fatal("malformed encoded key must reach pinned key parser", err)
			}
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			d := &fixtureDialer{}
			defer d.close()
			b := &binding{ctx: ctx, dialer: d, server: plan.Server, sockets: map[*ownedConn]bool{}}
			h := &Outbound{ctx: context.WithValue(ctx, bindingKey{}, b), cancel: cancel, binding: b, plan: plan}
			defer h.Close()
			if err := h.Start(adapter.StartStateStart); err == nil {
				h.Close()
				t.Fatal("pinned Xray accepted malformed ML-KEM key")
			}
			if d.calls != 0 {
				t.Fatal("malformed key opened an outer socket")
			}
		})
	}
}
