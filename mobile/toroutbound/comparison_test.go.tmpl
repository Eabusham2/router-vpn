func (f *torComparisonFixture) command(line string) string {
	parts := strings.Fields(line)
	if len(parts) < 2 || parts[0] != "ROUTERVPN_LASTRELAY" {
		return "512 forbidden\r\n"
	}
	f.mu.Lock()
	defer f.mu.Unlock()
	if parts[1] == "INFO" {
		return fmt.Sprintf("250 version=1 transport=begindir min_ttl_ms=100 max_ttl_ms=10000 max_response_bytes=8192 generation_highwater=%d\r\n", f.highwater)
	}
	if parts[1] == "ANCHOR" {
		if len(parts) != 10 || parts[4] != f.h.socksUsername || parts[5] != f.h.socksPassword || !f.anchorLive || net.JoinHostPort(parts[6], parts[7]) != f.anchorClient || net.JoinHostPort(parts[8], parts[9]) != f.anchorTarget {
			return "551 wrong anchor\r\n"
		}
		f.anchorChecks++
		fields := map[string]string{"version": "1", "session": parts[2], "source": parts[3], "anchor": "111", "circuit": "222", "exit": strings.Repeat("4", 40), "path_sha256": strings.Repeat("5", 64), "client_ip": parts[6], "client_port": parts[7], "target_ip": parts[8], "target_port": parts[9]}
		switch f.fault {
		case "source":
			fields["source"] = strings.Repeat("f", 64)
		case "session":
			fields["session"] = strings.Repeat("e", 64)
		case "client":
			fields["client_port"] = "1"
		case "target":
			fields["target_ip"] = "8.8.8.8"
		case "circuit-after-capture":
			fields["circuit"] = "223"
		case "path-after-capture":
			fields["path_sha256"] = strings.Repeat("6", 64)
		case "anchor-after-capture":
			fields["anchor"] = "112"
		}
		return comparisonControlReply(fields)
	}
	if parts[1] == "CAPTURE" {
		if f.fault == "bad-capture" {
			f.failedDrainOnce.Do(func() { close(f.failedNativeDrain) })
			return "551 exact capture unavailable\r\n"
		}
		if len(parts) != 10 || parts[6] != "111" || parts[7] != f.h.socksUsername || parts[8] != f.h.socksPassword || !f.anchorLive {
			return "551 wrong capture\r\n"
		}
		generation, _ := strconv.ParseUint(parts[4], 10, 64)
		ttl, _ := strconv.Atoi(parts[5])
		if generation <= f.highwater {
			return "551 old generation\r\n"
		}
		f.highwater = generation
		f.fields = map[string]string{"version": "1", "state": "armed", "reason": "captured", "session": parts[2], "source": parts[3], "generation": parts[4], "anchor": "111", "circuit": "222", "stream": "0", "relay_stream": "0", "end_reason": "0", "exit": strings.Repeat("4", 40), "path_sha256": strings.Repeat("5", 64), "address": parts[4] + "." + parts[9][:32] + "." + parts[9][32:] + ".lastrelay.routervpn.invalid", "port": "1", "expires_ms": parts[5], "request_bytes": "0", "response_bytes": "0"}
		f.expires = time.Now().Add(time.Duration(ttl) * time.Millisecond)
	} else if parts[1] == "STATUS" || parts[1] == "CLOSE" {
		if len(parts) != 6 || f.fields == nil || parts[2] != f.fields["session"] || parts[3] != f.fields["source"] || parts[4] != f.fields["generation"] {
			return "551 wrong owner\r\n"
		}
		if parts[1] == "CLOSE" {
			f.nativeCloses++
			f.fields["state"], f.fields["reason"], f.fields["expires_ms"] = "stopped", "controller", "0"
			if f.fault == "native-close-still-draining" {
				f.fields["state"] = "draining"
				f.failedDrainOnce.Do(func() { close(f.failedNativeDrain) })
			}
		}
	} else {
		return "512 forbidden\r\n"
	}
	if f.fields["state"] != "stopped" && f.fields["state"] != "draining" {
		f.fields["expires_ms"] = strconv.FormatInt(max(1, time.Until(f.expires).Milliseconds()), 10)
	}
	return comparisonControlReply(f.fields)
}

func comparisonControlReply(fields map[string]string) string {
	keys := make([]string, 0, len(fields))
	for key := range fields {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	values := make([]string, 0, len(keys))
	for _, key := range keys {
		values = append(values, key+"="+fields[key])
	}
	return "250 " + strings.Join(values, " ") + "\r\n"
}

type comparisonCloseFailure struct {
	net.Conn
	calls atomic.Int32
	fail  int32
}

func (c *comparisonCloseFailure) Close() error {
	if c.calls.Add(1) <= c.fail {
		return errors.New("raw close pending")
	}
	return c.Conn.Close()
}

type comparisonHeldRead struct {
	net.Conn
	entered, release chan struct{}
	once             sync.Once
}

func (c *comparisonHeldRead) Read(buffer []byte) (int, error) {
	c.once.Do(func() { close(c.entered) })
	n, err := c.Conn.Read(buffer)
	<-c.release
	return n, err
}

