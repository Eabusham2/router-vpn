type torTestDNS struct {
	adapter.DNSRouter
	calls  atomic.Int32
	lookup func(context.Context, string, adapter.DNSQueryOptions) ([]netip.Addr, error)
}

func (r *torTestDNS) Lookup(ctx context.Context, domain string, options adapter.DNSQueryOptions) ([]netip.Addr, error) {
	r.calls.Add(1)
	if ctx.Value(torBootstrapDNSKey{}) == nil {
		return nil, errors.New("missing bootstrap cycle guard")
	}
	if r.lookup != nil {
		return r.lookup(ctx, domain, options)
	}
	return []netip.Addr{netip.MustParseAddr("192.0.2.77"), netip.MustParseAddr("2001:db8::77")}, nil
}

