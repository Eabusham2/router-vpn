package routervpntor

import (
	"context"
	"errors"
	"io"
	"net"
	"strings"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	"github.com/sagernet/sing-box/routervpn/mobiletor"
	M "github.com/sagernet/sing/common/metadata"
)

type torDNSTestConnection struct {
	net.Conn
	allowClose atomic.Bool
	closes     atomic.Int32
}

func (c *torDNSTestConnection) Close() error {
	c.closes.Add(1)
	if !c.allowClose.Load() {
		return errors.New("private-Tor-DNS-close-detail")
	}
	return c.Conn.Close()
}

func TestTorDNSMeasurementRetainsLateNativeSocketAndProofUntilRetryCloses(t *testing.T) {
	for _, retire := range []string{"caller", "owner", "native-error"} {
		t.Run(retire, func(t *testing.T) {
			var predecessorDials, finalDials atomic.Int32
			h, _ := torPredecessorFixture(t, func(context.Context, string, M.Socksaddr) (net.Conn, error) {
				predecessorDials.Add(1)
				return nil, errors.New("unexpected predecessor route")
			})
			client, peer := net.Pipe()
			defer peer.Close()
			raw := &torDNSTestConnection{Conn: client}
			defer func() { raw.allowClose.Store(true); _ = raw.Close() }()
			entered, release := make(chan struct{}), make(chan struct{})
			var releaseOnce sync.Once
			defer releaseOnce.Do(func() { close(release) })
			application, err := mobiletor.NewNetwork(h.ctx, func(_ context.Context, kind, address string) (net.Conn, error) {
				finalDials.Add(1)
				if kind != "tcp" || address != "1.1.1.1:53" {
					t.Error("Tor DNS application destination changed")
				}
				close(entered)
				<-release
				if retire == "native-error" {
					return raw, errors.New("private-Tor-DNS-dial-detail")
				}
				return raw, nil
			}, nil)
			if err != nil {
				t.Fatal(err)
			}
			h.application = application
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			type dialResult struct {
				connection net.Conn
				err        error
			}
			done := make(chan dialResult, 1)
			// Exercise the production post-proof helper. This fixture deliberately
			// cannot pass TorHealthy and therefore cannot manufacture a live proof.
			go func() { c, err := h.dialDNSMeasurement(ctx, h.sessionID, "1.1.1.1:53"); done <- dialResult{c, err} }()
			<-entered
			if retire == "caller" {
				cancel()
			} else if retire == "owner" {
				h.CancelTor(h.sessionID)
			}
			releaseOnce.Do(func() { close(release) })
			result := <-done
			if result.connection == nil || result.err == nil || strings.Contains(result.err.Error(), "private-") {
				t.Fatal("late Tor native socket was lost or exposed", result.err)
			}
			if err := result.connection.Close(); err == nil || strings.Contains(err.Error(), "private-") {
				t.Fatal("Tor DNS accepted a failed native close", err)
			}
			proofDrained := make(chan struct{})
			go func() { h.proofWorkers.Wait(); close(proofDrained) }()
			ctxClose, stop := context.WithTimeout(context.Background(), 20*time.Millisecond)
			if err := h.closeWithContext(ctxClose); err == nil {
				t.Fatal("Tor owner released its proof before native socket closure")
			}
			stop()
			select {
			case <-h.closeDone:
				t.Fatal("Tor cleanup reported a failed native close as drained")
			default:
			}
			select {
			case <-proofDrained:
				t.Fatal("Tor DNS released its proof worker while native close was still failing")
			default:
			}
			if raw.closes.Load() == 0 || predecessorDials.Load() != 0 || finalDials.Load() != 1 {
				t.Fatal("Tor DNS did not use only its retained final application owner")
			}
			raw.allowClose.Store(true)
			var closers sync.WaitGroup
			for range 8 {
				closers.Add(1)
				go func() {
					defer closers.Done()
					if err := result.connection.Close(); err != nil {
						t.Error(err)
					}
				}()
			}
			closers.Wait()
			ctxClose, stop = context.WithTimeout(context.Background(), time.Second)
			defer stop()
			if err := h.closeWithContext(ctxClose); err != nil {
				t.Fatal("successful native retry did not release Tor proof ownership", err)
			}
			select {
			case <-proofDrained:
			case <-time.After(time.Second):
				t.Fatal("successful native retry retained its proof worker")
			}
			var b [1]byte
			if _, err := peer.Read(b[:]); err != io.EOF {
				t.Fatal("Tor DNS native socket remained open after drain", err)
			}
		})
	}
}

func TestTorDNSMeasurementRejectsUnprovedOrForeignCircuitAndUncataloguedDestination(t *testing.T) {
	var dials atomic.Int32
	h, _ := torPredecessorFixture(t, func(context.Context, string, M.Socksaddr) (net.Conn, error) {
		dials.Add(1)
		return nil, errors.New("unexpected predecessor dial")
	})
	application, err := mobiletor.NewNetwork(h.ctx, func(context.Context, string, string) (net.Conn, error) {
		dials.Add(1)
		return nil, errors.New("unexpected final dial")
	}, nil)
	if err != nil {
		t.Fatal(err)
	}
	h.application = application
	for _, session := range []string{"", "foreign-session", h.sessionID} {
		for _, address := range []string{"1.1.1.1:53", "dns.google:443", "10.77.0.1:53", "1.1.1.1:8787", "[::ffff:1.1.1.1]:53"} {
			if connection, err := h.TorDNSMeasurementDial(context.Background(), session, address); connection != nil || err == nil {
				t.Fatal("unproved circuit or destination acquired DNS measurement authority")
			}
		}
	}
	if connection, err := h.TorDNSMeasurementDial(nil, h.sessionID, "1.1.1.1:53"); connection != nil || err == nil {
		t.Fatal("missing caller context acquired DNS measurement authority")
	}
	if dials.Load() != 0 {
		t.Fatal("unproved or foreign DNS request reached a native network")
	}
	if err := h.Close(); err != nil {
		t.Fatal(err)
	}
}
