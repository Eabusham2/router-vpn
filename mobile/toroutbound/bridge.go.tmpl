package libbox

import (
	"errors"

	box "github.com/sagernet/sing-box"
	"github.com/sagernet/sing-box/protocol/routervpntor"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
	"github.com/sagernet/sing-box/routervpn/tornotices"
)

// RouterTorSetStateDirectory must be called before constructing a Tor VPN Box.
// The canonical private app directory is retained across session stops and is
// separate from temporary Libbox runtime folders that hosts remove on stop.
func RouterTorSetStateDirectory(directory string) error {
	return routervpntor.SetStateDirectory(directory)
}

// RouterCompileTorProfile compiles captured node, DNS, interface and optional
// predecessor configuration before either host stages files or opens a VPN.
func RouterCompileTorProfile(profileJSON, sessionID, predecessorJSON string) (string, error) {
	return mobiletor.CompileProfile(profileJSON, sessionID, predecessorJSON)
}

// An idle Home-default node can be saved before its Router entry is selected.
// Validation never emits a runnable graph or changes the saved DNS choice.
func RouterValidateTorProfile(profileJSON string) error {
	return mobiletor.ValidateProfile(profileJSON)
}

// The full entry profile is captured separately from the external node. Its
// private proof identity must match the compiled native predecessor at Run.
func RouterCompileTorProfileWithPredecessor(profileJSON, sessionID, predecessorJSON, predecessorProfileJSON string) (string, error) {
	return mobiletor.CompileProfileWithPredecessor(profileJSON, sessionID, predecessorJSON, predecessorProfileJSON)
}

type RouterTorProofRequest struct {
	request *box.RouterVPNTorProofRequest
}

func RouterTorCreateProof(server *CommandServer, outboundTag, sessionID string) (*RouterTorProofRequest, error) {
	return RouterTorCreateProofWithPredecessor(server, outboundTag, sessionID, "")
}

// The factory captures the actual Box and outbound before Run can block. A
// host may invoke Cancel from its immediate STOP/network callback while its
// serialized native service worker later waits for the complete Close drain.
func RouterTorCreateProofWithPredecessor(server *CommandServer, outboundTag, sessionID, profileJSON string) (*RouterTorProofRequest, error) {
	if server == nil || server.StartedService == nil {
		return nil, errors.New("native Tor VPN owner is unavailable")
	}
	instance := server.StartedService.Instance()
	if instance == nil || instance.Box() == nil {
		return nil, errors.New("native Tor VPN instance is unavailable")
	}
	request, err := instance.Box().RouterVPNTorCreateProof(outboundTag, sessionID, profileJSON)
	if err != nil {
		return nil, err
	}
	if instance != server.StartedService.Instance() {
		request.Cancel()
		return nil, errors.New("native Tor proof belongs to a retired VPN instance")
	}
	return &RouterTorProofRequest{request: request}, nil
}

func (r *RouterTorProofRequest) Run() (string, error) {
	if r == nil || r.request == nil {
		return "", errors.New("native Tor proof request is unavailable")
	}
	return r.request.Run()
}

func (r *RouterTorProofRequest) Cancel() {
	if r != nil && r.request != nil {
		r.request.Cancel()
	}
}

func (r *RouterTorProofRequest) Healthy() bool {
	return r != nil && r.request != nil && r.request.Healthy()
}

// The result contains session_id, ip, is_tor and checked_at from the actual
// HTTPS Tor exit check. It never accepts a caller-supplied expected exit IP.
func RouterTorProof(server *CommandServer, outboundTag, sessionID string) (string, error) {
	request, err := RouterTorCreateProof(server, outboundTag, sessionID)
	if err != nil {
		return "", err
	}
	return request.Run()
}

// Keeping this exported getter in Libbox also retains the original PT license
// text and source manifests in the one final Android/Apple Go runtime.
func RouterTorSourceNotices() string { return tornotices.JSON() }
