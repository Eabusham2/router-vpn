package libbox

import (
	"context"
	"errors"
	"time"

	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// RouterTorComparison exposes exact durations, not scores. Hosts retain every
// nonnil result, including factory errors, and retry Close after native teardown
// when a bounded wait cannot prove the measurement streams have joined.
type RouterTorComparison struct {
	request mobiletor.Comparison
	ctx     context.Context
	cancel  context.CancelFunc
	current func() bool
}

func RouterTorCreateComparison(server *CommandServer, proof *RouterTorProofRequest, target string) (*RouterTorComparison, error) {
	if server == nil || server.StartedService == nil || proof == nil || proof.request == nil || !proof.Healthy() {
		return nil, errors.New("Tor comparison requires the retained successful VPN proof")
	}
	instance := server.StartedService.Instance()
	if instance == nil || instance.Box() == nil {
		return nil, errors.New("Tor comparison native Box is unavailable")
	}
	request, err := instance.Box().RouterVPNTorCreateComparison(proof.request, target)
	if request == nil {
		if err == nil {
			err = errors.New("Tor comparison returned no retained native owner")
		}
		return nil, err
	}
	ctx, cancel := context.WithCancel(context.Background())
	r := &RouterTorComparison{request: request, ctx: ctx, cancel: cancel, current: func() bool {
		return server.StartedService != nil && server.StartedService.Instance() == instance
	}}
	if err != nil || !r.active() {
		r.Cancel()
		if err == nil {
			err = errors.New("Tor comparison belongs to a retired native service")
		}
	}
	return r, err
}

func (r *RouterTorComparison) active() bool {
	return r != nil && r.request != nil && r.ctx != nil && r.ctx.Err() == nil && r.current != nil && r.current()
}

func (r *RouterTorComparison) Prepare() error {
	if !r.active() {
		return errors.New("Tor comparison is unavailable")
	}
	ctx, cancel := context.WithTimeout(r.ctx, 25*time.Second)
	defer cancel()
	err := r.request.Prepare(ctx)
	if err != nil || ctx.Err() != nil || !r.active() {
		r.Cancel()
		return errors.New("Tor comparison preparation failed or retired")
	}
	return nil
}

func (r *RouterTorComparison) Identity() string {
	if !r.active() {
		return ""
	}
	identity := r.request.Identity()
	if !r.active() {
		return ""
	}
	return identity
}

func (r *RouterTorComparison) Verify() error {
	if !r.active() {
		return errors.New("Tor comparison is unavailable")
	}
	ctx, cancel := context.WithTimeout(r.ctx, 5*time.Second)
	defer cancel()
	err := r.request.Verify(ctx)
	if err != nil || ctx.Err() != nil || !r.active() {
		r.Cancel()
		return errors.New("Tor comparison verification failed or retired")
	}
	return nil
}

func (r *RouterTorComparison) ProbeLastNanos() (int64, error) {
	return r.probe("")
}

func (r *RouterTorComparison) ProbeExternalNanos(target string) (int64, error) {
	if target == "" {
		if r != nil {
			r.Cancel()
		}
		return 0, errors.New("Tor comparison external target is missing")
	}
	return r.probe(target)
}

func (r *RouterTorComparison) probe(target string) (int64, error) {
	if !r.active() {
		return 0, errors.New("Tor comparison is unavailable")
	}
	ctx, cancel := context.WithTimeout(r.ctx, 12*time.Second)
	defer cancel()
	var elapsed time.Duration
	var err error
	if target == "" {
		elapsed, err = r.request.ProbeLast(ctx)
	} else {
		elapsed, err = r.request.ProbeExternal(ctx, target)
	}
	if err != nil || elapsed <= 0 || elapsed > 12*time.Second || ctx.Err() != nil || !r.active() {
		r.Cancel()
		return 0, errors.New("Tor comparison returned no valid current response time")
	}
	return int64(elapsed), nil
}

func (r *RouterTorComparison) Cancel() {
	if r == nil {
		return
	}
	if r.cancel != nil {
		r.cancel()
	}
	if r.request != nil {
		r.request.Cancel()
	}
}

func (r *RouterTorComparison) Close() error {
	if r == nil {
		return nil
	}
	r.Cancel()
	if r.request == nil {
		return nil
	}
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	return r.request.Close(ctx)
}
