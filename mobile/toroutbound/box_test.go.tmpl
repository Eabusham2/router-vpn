// This fixture proves request ownership/cancellation, never public Tor traffic.
// The native/PT test separately exercises the actual pinned C invocation.
type torBoxFixture struct {
	outbound.Adapter
	N.Dialer
	ctx     context.Context
	cancel  context.CancelFunc
	session string
	health  atomic.Bool
	cancels atomic.Int32
	calls   atomic.Int32
	prove   func(context.Context, string, *mobiletor.PredecessorProof) (mobiletor.Proof, error)
}

func newTorBoxFixture(t *testing.T, session string) *torBoxFixture {
	t.Helper()
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	f := &torBoxFixture{Adapter: outbound.NewAdapter("routervpn-tor", "tor-final", []string{N.NetworkTCP}, nil), ctx: ctx, cancel: cancel, session: session}
	f.health.Store(true)
	return f
}
func (f *torBoxFixture) TorSessionID() string { return f.session }
func (f *torBoxFixture) CancelTor(session string) {
	if session == f.session {
		f.cancels.Add(1)
		f.cancel()
	}
}
func (f *torBoxFixture) TorHealthy(session string) bool {
	return session == f.session && f.ctx.Err() == nil && f.health.Load()
}
func (f *torBoxFixture) TorProofWithPredecessor(ctx context.Context, session string, predecessor *mobiletor.PredecessorProof) (mobiletor.Proof, error) {
	f.calls.Add(1)
	if f.prove != nil {
		return f.prove(ctx, session, predecessor)
	}
	return mobiletor.Proof{SessionID: session, IsTor: true, IP: "192.0.2.1", CheckedAt: time.Now().UTC()}, nil
}

func TestRouterTorProofCancelKeepsCapturedOwnerAfterReplacement(t *testing.T) {
	old := newTorBoxFixture(t, "session-old")
	replacement := newTorBoxFixture(t, "session-new")
	var current atomic.Pointer[torBoxFixture]
	current.Store(old)
	entered := make(chan struct{})
	old.prove = func(context.Context, string, *mobiletor.PredecessorProof) (mobiletor.Proof, error) {
		close(entered)
		<-old.ctx.Done()
		return mobiletor.Proof{}, errors.New("captured owner stopped")
	}
	request, err := newRouterTorProofRequest(context.Background(), old, old.session, "", func() bool { return current.Load() == old })
	if err != nil {
		t.Fatal(err)
	}
	result := make(chan error, 1)
	go func() { _, err := request.Run(); result <- err }()
	<-entered
	current.Store(replacement)
	request.Cancel()
	request.Cancel()
	select {
	case err := <-result:
		if err == nil {
			t.Fatal("canceled old proof succeeded")
		}
	case <-time.After(time.Second):
		t.Fatal("Cancel did not unblock captured proof")
	}
	if old.cancels.Load() != 1 || replacement.cancels.Load() != 0 || replacement.ctx.Err() != nil || request.Healthy() {
		t.Fatal("old handle reached replacement session")
	}
}

func TestRouterTorProofRunAndHealthRequireSameSuccessfulOwner(t *testing.T) {
	f := newTorBoxFixture(t, "session")
	var current atomic.Bool
	current.Store(true)
	r, err := newRouterTorProofRequest(context.Background(), f, f.session, "", current.Load)
	if err != nil {
		t.Fatal(err)
	}
	if r.Healthy() {
		t.Fatal("unproved owner appeared healthy")
	}
	raw, err := r.Run()
	if err != nil {
		t.Fatal(err)
	}
	var proof mobiletor.Proof
	if json.Unmarshal([]byte(raw), &proof) != nil || proof.SessionID != f.session || !proof.IsTor || proof.DNSProven || !r.Healthy() {
		t.Fatal("captured proof was not delivered")
	}
	if _, err := r.Run(); err == nil || f.calls.Load() != 1 {
		t.Fatal("request was reused")
	}
	f.health.Store(false)
	if r.Healthy() {
		t.Fatal("failed native owner remained healthy")
	}
	f.health.Store(true)
	current.Store(false)
	if r.Healthy() {
		t.Fatal("replaced native owner remained healthy")
	}
	r.Cancel()
	if r.Healthy() {
		t.Fatal("canceled successful owner remained healthy")
	}
}

type torBoxDNSCapture struct {
	valid atomic.Bool
	calls atomic.Int32
	prove func(context.Context) error
}

func (c *torBoxDNSCapture) Identity() string {
	if c.valid.Load() {
		return "captured-native-graph"
	}
	return ""
}
func (c *torBoxDNSCapture) DNSProof(ctx context.Context) error {
	c.calls.Add(1)
	if c.prove != nil {
		return c.prove(ctx)
	}
	return nil
}

func TestRouterTorProofRequiresCapturedDNSBeforeSuccess(t *testing.T) {
	for _, kind := range []string{"success", "DNS-failure", "graph-retired", "cancel", "owner-replaced"} {
		t.Run(kind, func(t *testing.T) {
			old := newTorBoxFixture(t, "captured")
			replacement := newTorBoxFixture(t, "replacement")
			var current atomic.Pointer[torBoxFixture]
			current.Store(old)
			r, err := newRouterTorProofRequest(context.Background(), old, old.session, "", func() bool { return current.Load() == old })
			if err != nil {
				t.Fatal(err)
			}
			capture := &torBoxDNSCapture{}
			capture.valid.Store(true)
			r.capture = capture
			capture.prove = func(ctx context.Context) error {
				if ctx.Err() != nil || old.calls.Load() != 1 || r.Healthy() {
					t.Error("DNS did not run after circuit proof and before Connected")
				}
				switch kind {
				case "DNS-failure":
					return errors.New("private-resolver-secret")
				case "graph-retired":
					capture.valid.Store(false)
				case "cancel":
					r.Cancel()
				case "owner-replaced":
					current.Store(replacement)
				}
				return nil
			}
			raw, err := r.Run()
			if kind == "success" {
				var proof mobiletor.Proof
				if err != nil || json.Unmarshal([]byte(raw), &proof) != nil || !proof.IsTor || !proof.DNSProven || !r.Healthy() {
					t.Fatal("selected DNS proof did not authorize captured session", err)
				}
				capture.valid.Store(false)
				if r.Healthy() {
					t.Fatal("retired DNS graph retained session authority")
				}
				r.Cancel()
			} else if err == nil || raw != "" || r.Healthy() || strings.Contains(err.Error(), "secret") {
				t.Fatal("failed or stale selected DNS proof became Connected", raw, err)
			}
			if capture.calls.Load() != 1 || old.cancels.Load() != 1 || replacement.cancels.Load() != 0 || replacement.ctx.Err() != nil {
				t.Fatal("DNS proof reached or stopped a replacement owner")
			}
		})
	}
}

func TestRouterTorProofCancellationRetainsPendingDNSAndRejectsLateSuccess(t *testing.T) {
	f := newTorBoxFixture(t, "captured")
	r, err := newRouterTorProofRequest(context.Background(), f, f.session, "", func() bool { return true })
	if err != nil {
		t.Fatal(err)
	}
	entered, release, canceled := make(chan struct{}), make(chan struct{}), make(chan struct{})
	capture := &torBoxDNSCapture{}
	capture.valid.Store(true)
	capture.prove = func(ctx context.Context) error {
		close(entered)
		<-ctx.Done()
		close(canceled)
		<-release // An uncooperative native callback remains owned until it exits.
		return nil
	}
	r.capture = capture
	done := make(chan error, 1)
	go func() {
		raw, err := r.Run()
		if raw != "" {
			t.Error("canceled DNS proof delivered a result")
		}
		done <- err
	}()
	<-entered
	r.Cancel()
	<-canceled
	select {
	case <-done:
		t.Fatal("proof forgot its pending native DNS callback")
	default:
	}
	if r.Healthy() {
		t.Fatal("pending canceled DNS proof retained authority")
	}
	close(release)
	select {
	case err := <-done:
		if err == nil || r.Healthy() || f.cancels.Load() != 1 {
			t.Fatal("late DNS success was published after cancellation", err)
		}
	case <-time.After(time.Second):
		t.Fatal("released native DNS proof failed to drain")
	}
}

func TestRouterTorProofRejectsStaleFalseAndCanceledRequests(t *testing.T) {
	for _, mode := range []string{"before-run", "false-proof", "wrong-session", "retired-during-proof"} {
		t.Run(mode, func(t *testing.T) {
			f := newTorBoxFixture(t, "captured")
			var current atomic.Bool
			current.Store(true)
			f.prove = func(context.Context, string, *mobiletor.PredecessorProof) (mobiletor.Proof, error) {
				proof := mobiletor.Proof{SessionID: f.session, IsTor: true}
				if mode == "false-proof" {
					proof.IsTor = false
				}
				if mode == "wrong-session" {
					proof.SessionID = "other"
				}
				if mode == "retired-during-proof" {
					current.Store(false)
				}
				return proof, nil
			}
			r, err := newRouterTorProofRequest(context.Background(), f, f.session, "", current.Load)
			if err != nil {
				t.Fatal(err)
			}
			if mode == "before-run" {
				r.Cancel()
			}
			if raw, err := r.Run(); err == nil || raw != "" || r.Healthy() || f.cancels.Load() != 1 {
				t.Fatal("invalid proof escaped its session", raw, err)
			}
			if mode == "before-run" && f.calls.Load() != 0 {
				t.Fatal("canceled request invoked native proof")
			}
		})
	}
	f := newTorBoxFixture(t, "captured")
	if _, err := newRouterTorProofRequest(context.Background(), f, "other", "", func() bool { return true }); err == nil {
		t.Fatal("foreign session captured")
	}
	if _, err := newRouterTorProofRequest(context.Background(), f, f.session, `{"api_token":"secret"}`, func() bool { return true }); err == nil || strings.Contains(err.Error(), "secret") {
		t.Fatal("unvalidated predecessor captured or exposed", err)
	}
}

func TestRouterTorProofCapturesPrivateEntrySeparatelyFromDeliveredJSON(t *testing.T) {
	f := newTorBoxFixture(t, "captured")
	profile := `{"id":"entry","node_kind":"router-vpn","node_proof_id":"` + strings.Repeat("a", 64) + `","router_api":"http://10.77.0.1:8787","api_token":"private-proof-secret"}`
	f.prove = func(_ context.Context, session string, entry *mobiletor.PredecessorProof) (mobiletor.Proof, error) {
		if entry == nil {
			t.Error("private entry proof was discarded")
		}
		return mobiletor.Proof{SessionID: session, IsTor: true}, nil
	}
	r, err := newRouterTorProofRequest(context.Background(), f, f.session, profile, func() bool { return true })
	if err != nil {
		t.Fatal(err)
	}
	raw, err := r.Run()
	if err != nil || strings.Contains(raw, "private-proof-secret") || strings.Contains(raw, "router_api") {
		t.Fatal("private entry credentials escaped proof handle", err)
	}
}
