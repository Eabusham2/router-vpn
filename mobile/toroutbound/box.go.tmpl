package box

import (
	"context"
	"encoding/json"
	"errors"
	"sync/atomic"
	"time"

	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

type torProofOwner interface {
	TorSessionID() string
	TorProofWithPredecessor(context.Context, string, *mobiletor.PredecessorProof) (mobiletor.Proof, error)
	CancelTor(string)
	TorHealthy(string) bool
}

type torExternalProofOwner interface {
	torProofOwner
	TorExternalPredecessor(string) (*mobiletor.ExternalPredecessorProof, error)
	TorProofWithExternalPredecessor(context.Context, string, *mobiletor.ExternalPredecessorProof) (mobiletor.Proof, error)
	TorExternalConfig() string
}

// Full mobile preparation installs this capture hook at package initialization.
// Standalone Tor builds retain their original proof API without importing the
// larger TUN/measurement runtime. A full capture must prove its selected DNS
// route before success and is the only kind that can grant MTU access.
type routerVPNTorProofCapture interface {
	Identity() string
	DNSProof(context.Context) error
}

var routerVPNTorCaptureProof func(*Box) (routerVPNTorProofCapture, error)

// RouterVPNTorProofRequest captures one Box, actual outbound and VPN session.
// Cancel never consults a mutable host service or a replacement outbound.
type RouterVPNTorProofRequest struct {
	ctx                 context.Context
	cancel              context.CancelFunc
	owner               torProofOwner
	current             func() bool
	sessionID           string
	predecessor         *mobiletor.PredecessorProof
	externalPredecessor *mobiletor.ExternalPredecessorProof
	externalOwner       torExternalProofOwner
	started             atomic.Bool
	succeeded           atomic.Bool
	canceled            atomic.Bool
	capture             routerVPNTorProofCapture
	server              torServerProofOwner
}

func (s *Box) RouterVPNTorCreateProof(outboundTag, sessionID, predecessorJSON string) (*RouterVPNTorProofRequest, error) {
	if s == nil || s.ctx == nil || s.ctx.Err() != nil || s.outbound == nil || outboundTag == "" || sessionID == "" {
		return nil, errors.New("native Tor proof owner is unavailable")
	}
	owner, found := s.outbound.Outbound(outboundTag)
	if !found || owner == nil || owner.Type() != "routervpn-tor" && owner.Type() != mobiletor.ServerTorClientType {
		return nil, errors.New("native Tor final outbound is unavailable")
	}
	request, err := newRouterTorProofRequest(s.ctx, owner, sessionID, predecessorJSON, func() bool {
		current, found := s.outbound.Outbound(outboundTag)
		return found && current == owner && s.ctx.Err() == nil
	})
	if err != nil {
		return nil, err
	}
	// Legacy direct proof APIs also serve non-TUN native fixtures. They remain
	// usable, but only a full captured single-TUN graph can grant MTU ownership.
	if routerVPNTorCaptureProof != nil {
		request.capture, err = routerVPNTorCaptureProof(s)
		if err != nil {
			request.cancel()
			return nil, err
		}
	}
	if err := request.bindServer(owner); err != nil {
		request.Cancel()
		return nil, err
	}
	if err := request.bindExternal(); err != nil {
		request.Cancel()
		return nil, err
	}
	return request, nil
}

func (r *RouterVPNTorProofRequest) bindExternal() error {
	if r.externalPredecessor == nil {
		return nil
	}
	capture, captured := r.capture.(torServerProofCapture)
	if r.externalOwner == nil || !captured || capture == nil || !capture.ServerGraph(r.externalOwner.TorExternalConfig()) || !capture.EntryCurrent() {
		return errors.New("Tor ordinary path requires its complete source-bound native TUN and selected DNS")
	}
	return nil
}

func newRouterTorProofRequest(ctx context.Context, outbound adapter.Outbound, sessionID, predecessorJSON string, current func() bool) (*RouterVPNTorProofRequest, error) {
	owner, ok := outbound.(torProofOwner)
	if ctx == nil || ctx.Err() != nil || !ok || sessionID == "" || owner.TorSessionID() != sessionID || current == nil || !current() {
		return nil, errors.New("native Tor proof does not belong to this VPN session")
	}
	var predecessor *mobiletor.PredecessorProof
	var externalPredecessor *mobiletor.ExternalPredecessorProof
	var externalOwner torExternalProofOwner
	if predecessorJSON != "" {
		var err error
		predecessor, err = mobiletor.NewPredecessorProof(predecessorJSON)
		if err != nil {
			var supported bool
			externalOwner, supported = owner.(torExternalProofOwner)
			if !supported || outbound.Type() != "routervpn-tor" {
				return nil, err
			}
			externalPredecessor, err = externalOwner.TorExternalPredecessor(predecessorJSON)
			if err != nil || externalPredecessor == nil || !externalPredecessor.MatchesProfile(predecessorJSON) {
				return nil, errors.New("native Tor ordinary proof lost its exact captured source")
			}
		}
	}
	owned, cancel := context.WithCancel(ctx)
	return &RouterVPNTorProofRequest{ctx: owned, cancel: cancel, owner: owner, current: current, sessionID: sessionID, predecessor: predecessor,
		externalPredecessor: externalPredecessor, externalOwner: externalOwner}, nil
}

func (r *RouterVPNTorProofRequest) prove(ctx context.Context) (mobiletor.Proof, error) {
	if r.externalPredecessor != nil {
		if r.predecessor != nil || r.externalOwner == nil {
			return mobiletor.Proof{}, errors.New("native Tor mixed private and ordinary predecessor authority")
		}
		return r.externalOwner.TorProofWithExternalPredecessor(ctx, r.sessionID, r.externalPredecessor)
	}
	return r.owner.TorProofWithPredecessor(ctx, r.sessionID, r.predecessor)
}

func (r *RouterVPNTorProofRequest) Run() (result string, failure error) {
	if r == nil || !r.started.CompareAndSwap(false, true) {
		return "", errors.New("native Tor proof request is unavailable or already used")
	}
	defer func() {
		if failure != nil {
			r.Cancel()
		}
	}()
	if r.canceled.Load() || r.ctx.Err() != nil || !r.currentNative() {
		return "", errors.New("native Tor proof belongs to a retired VPN session")
	}
	ctx, cancel := context.WithTimeout(r.ctx, 3*time.Minute)
	defer cancel()
	proof, err := r.prove(ctx)
	if err != nil {
		return "", err
	}
	if r.canceled.Load() || ctx.Err() != nil || !r.currentNative() || proof.SessionID != r.sessionID || !proof.IsTor {
		return "", errors.New("native Tor proof belongs to a retired outbound")
	}
	proof.DNSProven = false
	if r.capture != nil {
		if err := r.capture.DNSProof(ctx); err != nil {
			return "", errors.New("native Tor selected DNS failed proof")
		}
		if r.canceled.Load() || ctx.Err() != nil || !r.currentNative() {
			return "", errors.New("native Tor DNS proof belongs to a retired graph")
		}
		proof.DNSProven = true
	}
	data, err := json.Marshal(proof)
	if err != nil {
		return "", errors.New("native Tor traffic proof could not be encoded")
	}
	r.succeeded.Store(true)
	if r.canceled.Load() || ctx.Err() != nil || !r.currentNative() {
		r.succeeded.Store(false)
		return "", errors.New("native Tor proof was canceled")
	}
	return string(data), nil
}

func (r *RouterVPNTorProofRequest) Cancel() {
	if r != nil && r.canceled.CompareAndSwap(false, true) {
		r.succeeded.Store(false)
		if r.cancel != nil {
			r.cancel()
		}
		if r.owner != nil {
			r.owner.CancelTor(r.sessionID)
		}
	}
}

func (r *RouterVPNTorProofRequest) Healthy() bool {
	return r != nil && r.ctx != nil && r.owner != nil && r.succeeded.Load() && !r.canceled.Load() && r.ctx.Err() == nil && r.currentNative() && r.owner.TorHealthy(r.sessionID)
}

func (r *RouterVPNTorProofRequest) currentNative() bool {
	return r != nil && r.current != nil && r.current() && (r.capture == nil || r.capture.Identity() != "")
}

// RouterVPNTorProof preserves the synchronous convenience API. Mobile hosts
// retain the request itself so Stop and network changes can cancel immediately.
func (s *Box) RouterVPNTorProof(outboundTag, sessionID string) (string, error) {
	request, err := s.RouterVPNTorCreateProof(outboundTag, sessionID, "")
	if err != nil {
		return "", err
	}
	return request.Run()
}

type torServerProofOwner interface {
	torProofOwner
	TorServerConfig() string
	BindTorServer(*mobiletor.PredecessorProof, func() bool, func() bool) error
	CloseTor(context.Context, string) error
}

type torServerProofCapture interface {
	routerVPNTorProofCapture
	ServerGraph(string) bool
	EntryCurrent() bool
}

func (r *RouterVPNTorProofRequest) bindServer(outbound adapter.Outbound) error {
	if outbound.Type() != mobiletor.ServerTorClientType {
		return nil
	}
	owner, ok := r.owner.(torServerProofOwner)
	capture, captured := r.capture.(torServerProofCapture)
	if !ok || !captured || capture == nil || r.predecessor == nil || !capture.ServerGraph(owner.TorServerConfig()) || !capture.EntryCurrent() {
		return errors.New("Tor Server requires its complete captured native TUN, selected DNS and private entry")
	}
	if err := owner.BindTorServer(r.predecessor, capture.EntryCurrent, r.currentNative); err != nil {
		return err
	}
	r.server = owner
	return nil
}

func (r *RouterVPNTorProofRequest) Close() error {
	if r == nil {
		return nil
	}
	r.Cancel()
	if r.server == nil {
		// Local cancellation is drained by the existing checked native service
		// close. It owns no remote lease and needs no new shutdown operation.
		return nil
	}
	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
	defer cancel()
	return r.server.CloseTor(ctx, r.sessionID)
}
