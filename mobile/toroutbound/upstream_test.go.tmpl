package routervpntor

import (
	"testing"

	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing/service"
)

func TestTorUpstreamCapturesExactPredecessorAndTransitiveOwners(t *testing.T) {
	f := newTorCaptureFixture(t, "entry")
	f.out.items["entry"] = torOut("entry", "routervpn-composite", "encrypted", "helper")
	f.out.items["encrypted"] = torOut("encrypted", "shadowsocks", "lower")
	f.out.items["helper"] = torOut("helper", "routervpn-helper", "lower")
	f.out.items["lower"] = torOut("lower", "direct")
	captured, err := captureTorUpstream(f.ctx, "tor-final", "entry")
	if err != nil || len(captured.owners) != 4 || captured.current() != nil {
		t.Fatal("predecessor graph was not captured", err)
	}
	f.out.set("lower", torOut("lower", "direct"))
	if err := captured.current(); err == nil {
		t.Fatal("replacement under the same tag retained proof ownership")
	}
	f2 := newTorCaptureFixture(t, "entry")
	captured, err = captureTorUpstream(f2.ctx, "tor-final", "entry")
	if err != nil {
		t.Fatal(err)
	}
	service.MustRegister[adapter.OutboundManager](f2.ctx, &torTestOutboundManager{})
	if err := captured.current(); err == nil {
		t.Fatal("replacement manager retained proof ownership")
	}
}

func TestTorUpstreamRejectsCircularMissingOrTorDependencies(t *testing.T) {
	for name, mutate := range map[string]func(*torCaptureFixture){
		"missing": func(f *torCaptureFixture) { delete(f.out.items, "entry") },
		"tor":     func(f *torCaptureFixture) { f.out.items["entry"] = torOut("entry", Type) },
		"self":    func(f *torCaptureFixture) { f.out.items["entry"] = torOut("entry", "shadowsocks", "tor-final") },
		"cycle": func(f *torCaptureFixture) {
			f.out.items["entry"] = torOut("entry", "shadowsocks", "other")
			f.out.items["other"] = torOut("other", "direct", "entry")
		},
		"empty": func(f *torCaptureFixture) { f.out.items["entry"] = torOut("entry", "shadowsocks", "") },
	} {
		t.Run(name, func(t *testing.T) {
			f := newTorCaptureFixture(t, "entry")
			mutate(f)
			if _, err := captureTorUpstream(f.ctx, "tor-final", "entry"); err == nil {
				t.Fatal("unowned predecessor accepted")
			}
		})
	}
}
