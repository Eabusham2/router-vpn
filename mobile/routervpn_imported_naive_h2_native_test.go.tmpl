// The dedicated native gate supplies the same sealed library as packaging.
// Static builds do not claim that an unexecuted dynamic load has succeeded.
var routerImportedNaiveH2LoadLibrary = func(string) error {
	return errors.New("Naive H2 parser requires the explicit pure-Go native loader")
}

func routerImportedNaiveH2Library(t *testing.T) {
	t.Helper()
	path, expected := os.Getenv("ROUTERVPN_NODE_CRONET_LIBRARY"), os.Getenv("ROUTERVPN_NODE_CRONET_SHA256")
	size, err := strconv.ParseInt(os.Getenv("ROUTERVPN_NODE_CRONET_BYTES"), 10, 64)
	if err != nil || size <= 0 || size > 128<<20 || len(expected) != 64 || !filepath.IsAbs(path) {
		t.Fatal("Naive H2 parser requires its exact native-library module seal")
	}
	info, err := os.Lstat(path)
	if err != nil || !info.Mode().IsRegular() || info.Size() != size {
		t.Fatal("Naive H2 parser library is absent, linked or changed", err)
	}
	file, err := os.Open(path)
	if err != nil {
		t.Fatal(err)
	}
	defer file.Close()
	opened, err := file.Stat()
	if err != nil || !os.SameFile(info, opened) {
		t.Fatal("Naive H2 parser library changed during capture", err)
	}
	digest := sha256.New()
	n, err := io.Copy(digest, io.LimitReader(file, size+1))
	if err != nil || n != size || hex.EncodeToString(digest.Sum(nil)) != expected {
		t.Fatal("Naive H2 parser library differs from its captured module", err)
	}
	if err := routerImportedNaiveH2LoadLibrary(path); err != nil {
		t.Fatal("actual pinned Cronet parser library did not load", err)
	}
	after, err := os.Lstat(path)
	if err != nil || !os.SameFile(opened, after) || after.Size() != size {
		t.Fatal("Naive H2 parser library changed during native load", err)
	}
}

func routerImportedNaiveH2Names() map[string]bool {
	names := map[string]bool{}
	for _, kind := range []string{"socks5", "shadowsocks", "hysteria2", "http-connect", "https-connect", "wireguard", "amneziawg", "openvpn-tcp", "openvpn-udp"} {
		for _, first := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, last := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				names[kind+"--naive-h2--"+first+"--"+last+".json"] = true
			}
		}
	}
	return names
}

