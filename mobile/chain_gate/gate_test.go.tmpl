type closeOnly struct{ closeFn func() error }

func (c *closeOnly) Close() error { return c.closeFn() }

func TestRouterVPNChainGatePrebindFailedRetirement(t *testing.T) {
	for _, network := range []string{"tcp", "udp"} {
		t.Run(network, func(t *testing.T) {
			f := newFixture(t)
			var raw io.Closer
			var closed func()
			if network == "tcp" {
				client, peer := net.Pipe()
				raw = client
				defer client.Close()
				defer peer.Close()
				if err := peer.SetReadDeadline(time.Now().Add(time.Second)); err != nil {
					t.Fatal(err)
				}
				closed = func() {
					if _, err := peer.Read(make([]byte, 1)); !errors.Is(err, io.EOF) {
						t.Fatal("prebind TCP owner remained live", err)
					}
				}
			} else {
				packet, err := net.ListenPacket("udp", "127.0.0.1:0")
				if err != nil {
					t.Fatal(err)
				}
				raw = packet
				defer packet.Close()
				closed = func() {
					if _, _, err := packet.ReadFrom(make([]byte, 1)); !errors.Is(err, net.ErrClosed) {
						t.Fatal("prebind UDP owner remained live", err)
					}
				}
			}
			var calls atomic.Int64
			original := &closeOnly{func() error {
				if calls.Add(1) == 1 {
					return errors.New("original prebind close failed")
				}
				return raw.Close()
			}}
			release, err := f.gate.RetireInbound(original)
			if err != nil || release == nil {
				t.Fatal("prebind retirement refused", err)
			}
			f.gate.mu.Lock()
			var receipt *closeResult
			for owner := range f.gate.flows {
				receipt = owner.result
			}
			f.gate.mu.Unlock()
			if receipt == nil {
				t.Fatal("prebind original close not retained")
			}
			<-receipt.done
			f.gate.mu.Lock()
			retained := len(f.gate.flows) == 1 && !f.gate.open && f.gate.control == nil
			f.gate.mu.Unlock()
			if !retained || receipt.err == nil || calls.Load() != 1 {
				t.Fatal("prebind failed-close ownership disappeared")
			}
			f.bind(t)
			requireError(t, f.control.Open(f.ctx), "prebind failed close allowed forwarding")
			if err := f.gate.Close(); err != nil {
				t.Fatal("native gate did not retry original prebind close", err)
			}
			if err := release(); err != nil || calls.Load() != 2 {
				t.Fatal("prebind retry replaced or repeated original close", err, calls.Load())
			}
			closed()
		})
	}
}

func TestRouterVPNChainGatePrebindBoundedDrain(t *testing.T) {
	for _, network := range []string{"tcp", "udp"} {
