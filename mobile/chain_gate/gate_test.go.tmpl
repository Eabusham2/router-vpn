func TestRouterVPNChainGateClosedRevokeRetiresPendingOpen(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		f := newFixture(t)
		entered, resume := make(chan struct{}), make(chan struct{})
		unblock := sync.OnceFunc(func() { close(resume) })
		defer unblock()
		var block atomic.Bool
		var err error
		f.control, err = f.gate.Bind(f.ctx, "original-preparation:session", func(ctx context.Context) error {
			if block.Load() {
				close(entered)
				select {
				case <-ctx.Done():
					return ctx.Err()
				case <-resume:
				}
			}
			return ctx.Err()
		})
		if err != nil {
			t.Fatal(err)
		}
		block.Store(true)
		done := make(chan error, 1)
		go func() { done <- f.control.Open(f.ctx) }()
		<-entered
		// Revoke must not wait for a foreign guard while holding gate.mu.
		if err := f.control.Revoke(f.ctx); err != nil {
			t.Fatal(err)
		}
		unblock()
		if err := <-done; !errors.Is(err, ErrClosed) {
			t.Fatal("closed revoke did not retire pending open", err)
		}
		f.gate.mu.Lock()
		opened := f.gate.open
		f.gate.mu.Unlock()
		if opened {
			t.Fatal("older Open replaced newer closed decision")
		}
	})
}

