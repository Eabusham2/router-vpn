func TestRouterVPNChainGateInboundDNSOwnership(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		f := newFixture(t)
		f.bind(t)
		denied, deniedPeer := net.Pipe()
		defer deniedPeer.Close()
		if _, release, err := f.control.TrackInbound(f.ctx, denied); err == nil {
			t.Fatal("pending hijacked DNS input admitted")
		} else if release == nil || release() != nil {
			t.Fatal("denied input lost retained release")
		}
		if _, err := deniedPeer.Read(make([]byte, 1)); !errors.Is(err, io.EOF) {
			t.Fatal("denied input actual close missing", err)
		}
		client, peer := net.Pipe()
		defer peer.Close()
		if err := f.control.Open(f.ctx); err != nil {
			t.Fatal(err)
		}
		entered, release := make(chan struct{}), make(chan struct{})
		var once sync.Once
		var closes atomic.Int64
		raw := &closeConn{client, func() error { closes.Add(1); once.Do(func() { close(entered) }); <-release; return client.Close() }}
		owned, closeOwned, err := f.control.TrackInbound(f.ctx, raw)
		if err != nil {
			t.Fatal(err)
		}
		done := make(chan error, 1)
		go func() { done <- closeOwned() }()
		<-entered
		deadline, cancel := context.WithTimeout(f.ctx, time.Second)
		defer cancel()
		if err := f.control.Revoke(deadline); !errors.Is(err, context.DeadlineExceeded) {
			t.Fatal("inbound close callback not joined", err)
		}
		if owned.Err() == nil {
			t.Fatal("revocation did not cancel original inbound context")
		}
		requireError(t, f.control.Open(f.ctx), "pending hijacked DNS close allowed reopen")
		close(release)
		if err := <-done; err != nil {
			t.Fatal(err)
		}
		if err := f.control.Revoke(f.ctx); err != nil {
			t.Fatal(err)
		}
		if err := closeOwned(); err != nil || closes.Load() != 1 {
			t.Fatal("inbound handler repeated raw Close", err, closes.Load())
		}
		if !state(t, f).Drained {
			t.Fatal("inbound close receipt was lost")
		}
	})
}

