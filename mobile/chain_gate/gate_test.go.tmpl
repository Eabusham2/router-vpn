				unblock := sync.OnceFunc(func() { close(resume) })
				defer unblock()
				var calls atomic.Int64
				original := &closeConn{client, func() error { calls.Add(1); close(entered); <-resume; return client.Close() }}
				var raw io.Closer = original
				if network == "udp" {
					raw = &packetDouble{closer: original}
				}
				release, err := f.gate.RetireInbound(raw)
				if err != nil || release == nil {
					t.Fatal(err)
				}
				<-entered
				// The native io.Closer itself retains the existing five-second bound.
				if err := f.gate.Close(); !errors.Is(err, context.DeadlineExceeded) {
					t.Fatal("native prebind drain lost its bound", err)
				}
				f.gate.mu.Lock()
				retained := len(f.gate.flows) == 1 && f.gate.closed
				f.gate.mu.Unlock()
				if !retained {
					t.Fatal("timed-out prebind close lost original owner")
				}
				unblock()
				if err := f.gate.Close(); err != nil {
					t.Fatal(err)
				}
				if err := release(); err != nil || calls.Load() != 1 {
					t.Fatal("prebind close was not joined exactly once", err, calls.Load())
				}
			})
		})
	}
}

