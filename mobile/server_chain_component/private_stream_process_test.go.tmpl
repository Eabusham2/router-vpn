//go:build linux && !android

package routervpnamnezia_test

import (
	"bufio"
	"context"
	"crypto/rand"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net"
	"os"
	"os/exec"
	"sync"
	"testing"
	"time"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/multihoprelay"
)

// This diagnostic starts the unmodified registered sing-box worker in another
// OS process. Only its original WG front crosses from the fixture's userspace
// stack to the kernel listener; proofs and all suffix traffic run in the child.
type privateStreamProcess struct {
	test          *testing.T
	acknowledged  bool
	joinOnce      sync.Once
	holdMu        sync.Mutex
	hold, entered chan struct{}
	command       *exec.Cmd
	capture       multihoprelay.NodeChainCapture
	digest        string
	input, output *os.File
	scanner       *bufio.Scanner
	ipc           chan struct{}
	exited        chan struct{}
	exitErr       error
	listener      net.Listener
	ctx           context.Context
	cancel        context.CancelFunc
	handlers      sync.WaitGroup
}

func privateStreamNonce() string {
	var raw [32]byte
	if _, err := rand.Read(raw[:]); err != nil {
		panic(err)
	}
	return hex.EncodeToString(raw[:])
}
func startPrivateStreamProcess(ctx context.Context, t *testing.T, src string, capture multihoprelay.NodeChainCapture, listener net.Listener) (*privateStreamProcess, error) {
	if !capture.Source.PrivateStreamAt(2) || capture.Validate() != nil || capture.Peer != "10.80.0.2" || capture.Host != "10.80.0.1" {
		return nil, errors.New("unowned private stream lease")
	}
	file, err := os.Open(os.Getenv("ROUTERVPN_PRIVATE_STREAM_IMAGE"))
	if err != nil {
		return nil, err
	}
	defer file.Close()
	info, err := file.Stat()
	if err != nil || !info.Mode().IsRegular() {
		return nil, errors.New("missing original worker image")
	}
	hash := sha256.New()
	if _, err = io.Copy(hash, file); err != nil || hex.EncodeToString(hash.Sum(nil)) != os.Getenv("ROUTERVPN_PRIVATE_STREAM_SHA256") {
		return nil, errors.New("worker image changed")
	}
	dir := t.TempDir()
	if err = os.Chmod(dir, 0700); err != nil {
		return nil, err
	}
	root, err := os.OpenRoot(dir)
	if err != nil {
		return nil, err
	}
	defer root.Close()
	raw, err := json.Marshal(capture)
	if err != nil {
		return nil, err
	}
	if err = root.WriteFile("node-chain-capture.json", raw, 0600); err != nil {
		return nil, err
	}
	if err = root.WriteFile("node-chain-source.json", []byte(src), 0600); err != nil {
		return nil, err
	}
	p := &privateStreamProcess{test: t, command: exec.Command("/proc/self/fd/3", "routervpn-node-chain-relay", "--runtime-dir", dir), capture: capture, ipc: make(chan struct{}, 1), exited: make(chan struct{}), listener: listener}
	p.digest, err = capture.Digest()
	if err != nil {
		return nil, err
	}
	p.command.ExtraFiles = []*os.File{file}
	p.command.Dir = dir
	p.command.Env = []string{"PATH=/usr/local/bin:/usr/bin:/bin", "LANG=C", "SSL_CERT_FILE=" + os.Getenv("SSL_CERT_FILE"), "SSL_CERT_DIR=" + os.Getenv("SSL_CERT_DIR")}
	p.command.Stderr = os.Stderr
	childInput, in, err := os.Pipe()
	if err != nil {
		return nil, err
	}
	defer childInput.Close()
	out, childOutput, err := os.Pipe()
	if err != nil {
		in.Close()
		return nil, err
	}
	defer childOutput.Close()
	p.command.Stdin, p.command.Stdout = childInput, childOutput
	p.input, p.output = in, out
	p.scanner = bufio.NewScanner(out)
	p.scanner.Buffer(make([]byte, 2048), multihoprelay.NodeChainIPCMaximumBytes+1)
	p.ctx, p.cancel = context.WithCancel(context.Background())
	if err = p.command.Start(); err != nil {
		p.cancel()
		in.Close()
		out.Close()
		return nil, err
	}
	go func() { p.exitErr = p.command.Wait(); close(p.exited) }()
	p.handlers.Add(1)
	go p.bridge()
	t.Cleanup(func() {
		select {
		case <-p.exited:
		default:
			_ = p.command.Process.Kill()
			<-p.exited
			t.Error("private stream child required forced cleanup")
		}
		p.cancel()
		_ = listener.Close()
		p.handlers.Wait()
		_ = in.Close()
		_ = out.Close()
	})
	if p.command.Process.Pid <= 1 || p.command.Process.Pid == os.Getpid() {
		return nil, errors.New("no separate native process")
	}
	t.Logf("SEPARATE_NATIVE_CHILD pid=%d source=%s capture=%s image=%s", p.command.Process.Pid, capture.Source.SourceSHA256, p.digest, os.Getenv("ROUTERVPN_PRIVATE_STREAM_SHA256"))
	receipt, err := p.Snapshot(ctx, privateStreamNonce())
	if err != nil || receipt.Phase != multihoprelay.NodeChainPending {
		return p, errors.Join(err, errors.New("worker did not acknowledge its original pending front"))
	}
	return p, nil
}
func (p *privateStreamProcess) bridge() {
	defer p.handlers.Done()
	for {
		accepted, err := p.listener.Accept()
		if err != nil {
			return
		}
		peer, _, e := net.SplitHostPort(accepted.RemoteAddr().String())
		if e != nil || peer != p.capture.Peer || accepted.LocalAddr().String() != p.listener.Addr().String() {
			accepted.Close()
			continue
		}
		p.handlers.Add(1)
		go func() {
			defer p.handlers.Done()
			defer accepted.Close()
			dial := net.Dialer{LocalAddr: &net.TCPAddr{IP: net.ParseIP(peer)}}
			raw, e := dial.DialContext(p.ctx, "tcp4", p.listener.Addr().String())
			if e != nil {
				return
			}
			defer raw.Close()
			stop := context.AfterFunc(p.ctx, func() { _ = accepted.Close(); _ = raw.Close() })
			defer stop()
			done := make(chan struct{})
			go func() { _, _ = io.Copy(raw, accepted); _ = raw.(*net.TCPConn).CloseWrite(); close(done) }()
			_, _ = io.Copy(accepted, raw)
			_ = accepted.Close()
			_ = raw.Close()
			<-done
		}()
	}
}
func (p *privateStreamProcess) exchange(ctx context.Context, operation, nonce string) (multihoprelay.NodeChainIPCResponse, error) {
	var zero multihoprelay.NodeChainIPCResponse
	select {
	case p.ipc <- struct{}{}:
		defer func() { <-p.ipc }()
	case <-ctx.Done():
		return zero, ctx.Err()
	}
	if ctx.Err() != nil {
		return zero, ctx.Err()
	}
	deadline := time.Now().Add(8 * time.Second)
	if end, ok := ctx.Deadline(); ok && end.Before(deadline) {
		deadline = end
	}
	if err := p.input.SetWriteDeadline(deadline); err != nil {
		return zero, err
	}
	if err := p.output.SetReadDeadline(deadline); err != nil {
		return zero, err
	}
	request := multihoprelay.NodeChainIPCRequest{Schema: 1, Operation: operation, Nonce: nonce, CaptureSHA256: p.digest}
	if err := json.NewEncoder(p.input).Encode(request); err != nil {
		return zero, err
	}
	if !p.scanner.Scan() {
		return zero, errors.Join(io.ErrUnexpectedEOF, p.scanner.Err())
	}
	receipt, err := multihoprelay.DecodeNodeChainIPCResponse(p.scanner.Bytes())
	if err != nil || !receipt.OK || receipt.Operation != operation || receipt.Nonce != nonce || receipt.CaptureSHA256 != p.digest {
		return zero, fmt.Errorf("invalid original child %s acknowledgement: %w", operation, err)
	}
	if operation == "stop" {
		if !p.scanner.Scan() {
			return zero, errors.New("missing native child closed frame")
		}
		closed, err := multihoprelay.DecodeNodeChainIPCResponse(p.scanner.Bytes())
		if err != nil || !closed.OK || closed.Operation != "closed" || closed.Nonce != p.capture.OwnerID || closed.CaptureSHA256 != p.digest {
			return zero, errors.New("invalid original child closed receipt")
		}
		p.acknowledged = true
	}
	return receipt, nil
}
func (p *privateStreamProcess) Alive() bool {
	select {
	case <-p.exited:
		return false
	default:
		return true
	}
}
func (p *privateStreamProcess) Snapshot(ctx context.Context, nonce string) (multihoprelay.NodeChainReceipt, error) {
	started := time.Now()
	response, err := p.exchange(ctx, "snapshot", nonce)
	if err != nil {
		return multihoprelay.NodeChainReceipt{}, err
	}
	if response.Receipt == nil {
		return multihoprelay.NodeChainReceipt{}, errors.New("missing child receipt")
	}
	return *response.Receipt, multihoprelay.ValidateNodeChainReceipt(*response.Receipt, p.capture, nonce, started, time.Now())
}
func (p *privateStreamProcess) Bootstrap(ctx context.Context) error {
	if _, err := p.exchange(ctx, "bootstrap", privateStreamNonce()); err != nil {
		return err
	}
	ticker := time.NewTicker(100 * time.Millisecond)
	defer ticker.Stop()
	for {
		r, err := p.Snapshot(ctx, privateStreamNonce())
		if err != nil {
			return err
		}
		if r.Phase == multihoprelay.NodeChainReady {
			return nil
		}
		select {
		case <-ctx.Done():
			return ctx.Err()
		case <-ticker.C:
		}
	}
}
func (p *privateStreamProcess) HoldStop() (<-chan struct{}, func()) {
	p.holdMu.Lock()
	defer p.holdMu.Unlock()
	p.hold, p.entered = make(chan struct{}), make(chan struct{})
	return p.entered, func() { p.holdMu.Lock(); defer p.holdMu.Unlock(); close(p.hold); p.hold = nil }
}
func (p *privateStreamProcess) Stop(ctx context.Context) error {
	p.holdMu.Lock()
	hold := p.hold
	if hold != nil && p.entered != nil {
		close(p.entered)
		p.entered = nil
	}
	p.holdMu.Unlock()
	if hold != nil {
		select {
		case <-hold:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	// The manager serializes Stop. Require the child's explicit closure receipt
	// as well as its normal OS exit and the WG bridge join.

	if p.Alive() {
		if _, err := p.exchange(ctx, "stop", privateStreamNonce()); err != nil {
			return err
		}

	}
	select {
	case <-p.exited:
	case <-ctx.Done():
		return ctx.Err()
	}
	p.cancel()
	_ = p.listener.Close()
	p.handlers.Wait()
	if p.exitErr != nil || !p.acknowledged {
		return errors.Join(p.exitErr, errors.New("unacknowledged child exit"))
	}
	p.joinOnce.Do(func() {
		p.test.Logf("SEPARATE_NATIVE_JOINED pid=%d source=%s capture=%s image=%s", p.command.Process.Pid, p.capture.Source.SourceSHA256, p.digest, os.Getenv("ROUTERVPN_PRIVATE_STREAM_SHA256"))
	})
	return nil
}
