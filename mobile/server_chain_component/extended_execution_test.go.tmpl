// Only the CLI registry and its startup context live in the outer main
// package. The projected worker and authenticated front retain their sources.
var mainCommand = &cobra.Command{}
var globalCtx = context.Background()

type extendedActualWorker struct {
	n    *routerVPNServerChain
	root *os.Root
}

func (w *extendedActualWorker) Stop(ctx context.Context) error {
	if err := w.n.Close(ctx); err != nil {
		return err
	}
	return w.root.Close()
}
func (w *extendedActualWorker) Alive() bool { return w.n.ctx.Err() == nil }
func (w *extendedActualWorker) Bootstrap(ctx context.Context) error {
	ctx, cancel := context.WithDeadline(ctx, w.n.capture.BootstrapDeadline)
	defer cancel()
	if err := w.n.Begin(); err != nil {
		return err
	}
	ticker := time.NewTicker(200 * time.Millisecond)
	defer ticker.Stop()
	for {
		var raw [32]byte
		if _, err := rand.Read(raw[:]); err != nil {
			return err
		}
		nonce := hex.EncodeToString(raw[:])
		started := time.Now()
		r, err := w.n.Snapshot(ctx, nonce)
		if err != nil {
			return err
		}
		if err = multihoprelay.ValidateNodeChainReceipt(r, w.n.capture, nonce, started, time.Now()); err != nil {
			return err
		}
		if r.Phase == multihoprelay.NodeChainReady {
			return nil
		}
		select {
		case <-ctx.Done():
			return ctx.Err()
		case <-ticker.C:
		}
	}
}
func (w *extendedActualWorker) Snapshot(ctx context.Context, nonce string) (multihoprelay.NodeChainReceipt, error) {
	return w.n.Snapshot(ctx, nonce)
}
func TestOriginalExtendedSelectedExecution(t *testing.T) {
	type selectedCase struct {
		name                         string
		count                        int
		entry, mode, winner, measure string
		first, last                  int
	}
	cases := []selectedCase{
		{"4-private-server-response", 4, "wg", "server", "server", "response", 0, 0},
		{"4-private-auto-local", 4, "wg", "auto", "local", "response", 0, 0},
		{"4-private-auto-server", 4, "wg", "auto", "server", "response", 0, 0},
		{"4-private-server-latency", 4, "wg", "server", "server", "latency", 1, 4},
		{"4-private-server-throughput", 4, "wg", "server", "server", "throughput", 0, 0},
		{"4-private-drain", 4, "wg", "server", "server", "drain", 0, 0},
		{"4-private-wrong-public", 4, "wg", "server", "server", "wrong-public", 0, 0},
		{"4-private-wrong-exit", 4, "wg", "server", "server", "wrong-exit", 0, 0},
		{"4-private-wrong-key", 4, "wg", "server", "server", "wrong-key", 0, 0},
		{"4-private-wrong-identity", 4, "wg", "server", "server", "wrong-identity", 0, 0},
		{"4-private-wrong-dns", 4, "wg", "server", "server", "wrong-dns", 0, 0},
		{"9-server-response", 9, "wg", "server", "server", "response", 0, 0},
		{"9-auto-local-response", 9, "wg", "auto", "local", "response", 0, 0},
		{"9-auto-server-response", 9, "wg", "auto", "server", "response", 0, 0},
		{"16-server-response", 16, "wg", "server", "server", "response", 0, 0},
		{"16-auto-local-response", 16, "wg", "auto", "local", "response", 0, 0},
		{"16-auto-server-response", 16, "wg", "auto", "server", "response", 0, 0},

		{"9-server-latency", 9, "wg", "server", "server", "latency", 1, 9},
		{"9-server-throughput", 9, "wg", "server", "server", "throughput", 0, 0},
		{"9-auto-local", 9, "wg", "auto", "local", "", 0, 0},
		{"9-auto-server", 9, "wg", "auto", "server", "", 0, 0},
		{"16-server-latency", 16, "wg", "server", "server", "latency", 1, 16},
		{"16-server-throughput", 16, "wg", "server", "server", "throughput", 0, 0},
		{"16-auto-local", 16, "wg", "auto", "local", "", 0, 0},
		{"16-auto-server", 16, "wg", "auto", "server", "", 0, 0},
	}
	for first := 1; first <= 16; first += 4 {
		cases = append(cases, selectedCase{
			fmt.Sprintf("16-server-latency-%d-%d", first, first+3), 16, "wg", "server", "server", "latency", first, first + 3})
	}
	for _, entry := range []string{"awg2-fast", "awg2-strong"} {
		for _, count := range []int{9, 16} {
			prefix := fmt.Sprintf("%d-%s-", count, entry)
			for _, variant := range []struct{ mode, winner string }{{"server", "server"}, {"auto", "local"}, {"auto", "server"}} {
				cases = append(cases, selectedCase{prefix + variant.mode + "-" + variant.winner, count, entry, variant.mode, variant.winner, "response", 0, 0})
			}
			cases = append(cases, selectedCase{prefix + "mtu", count, entry, "server", "server", "mtu", 0, 0})
			cases = append(cases, selectedCase{prefix + "server-throughput", count, entry, "server", "server", "throughput", 0, 0})
			if count == 9 {
				cases = append(cases, selectedCase{prefix + "server-latency", count, entry, "server", "server", "latency", 1, 9})
			} else {
				for first := 1; first <= 16; first += 4 {
					cases = append(cases, selectedCase{prefix + fmt.Sprintf("server-latency-%d-%d", first, first+3), count, entry, "server", "server", "latency", first, first + 3})
				}
			}
		}
	}
	privatePositions := map[string]int{}
	for _, c := range cases {
		if c.count == 4 {
			privatePositions[c.name] = 2
		}
	}
	responsePositions := map[string]int{}
	for _, layout := range []struct {
		name          string
		count, paired int
		allFaults     bool
	}{
		{"3-local-private", 3, 0, true}, {"4-local-private", 4, 2, true},
		{"9-local-private", 9, 7, false}, {"16-local-private", 16, 14, false},
		{"4-imported-penultimate", 4, 0, true}, {"9-imported-penultimate", 9, 0, false},
		{"16-imported-penultimate", 16, 0, false}, {"5-paired-2-imported-penultimate", 5, 2, false},
		{"9-paired-4-imported-penultimate", 9, 4, false}, {"16-paired-7-imported-penultimate", 16, 7, false},
	} {
		for _, fault := range []string{"original", "wrong-candidate-key", "forged-response", "wrong-private-id", "late-catalog", "late-cancel", "server-winner"} {
			if fault != "original" && !layout.allFaults {
				continue
			}
			winner := "local"
			if fault == "server-winner" {
				winner = "server"
			}
			name := layout.name + "-" + fault
			responsePositions[name] = layout.paired
			cases = append(cases, selectedCase{name, layout.count, "wg", "auto", winner, "private-response/" + fault, 0, 0})
		}
	}
	for _, layout := range []struct{ count, position int }{{3, 1}, {4, 1}, {9, 6}, {16, 8}, {16, 13}} {
		faults := []string{"original"}
		if layout.count == 4 {
			faults = append(faults, "wrong-candidate-key", "forged-response", "wrong-private-id", "late-catalog", "late-cancel", "server-winner", "suffix-alias", "changed-original-suffix")
		}
		for _, fault := range faults {
			winner := "local"
			if fault == "server-winner" {
				winner = "server"
			}
			name := fmt.Sprintf("%d-imported-stop-%d-%s", layout.count, layout.position, fault)
			cases = append(cases, selectedCase{name, layout.count, "wg", "auto", winner, "private-response/" + fault, layout.position, 0})
		}
	}
	additionalPrivate := make(map[string][]int)
	for _, layout := range []struct{ count, paired, second, stop int }{{5, 2, 0, 1}, {5, 2, 0, 2}, {7, 2, 4, 3}, {9, 2, 4, 4}} {
		faults := []string{"original"}
		if layout.count == 7 {
			faults = append(faults, "wrong-candidate-key", "late-cancel", "server-winner")
		}
		for _, fault := range faults {
			winner := "local"
			if fault == "server-winner" {
				winner = "server"
			}
			name := fmt.Sprintf("%d-recursive-stop-%d-%s", layout.count, layout.stop, fault)
			responsePositions[name] = layout.paired
			if layout.second > 0 {
				additionalPrivate[name] = []int{layout.second}
			}
			cases = append(cases, selectedCase{name, layout.count, "wg", "auto", winner, "private-response/" + fault, layout.stop, 0})
		}
	}
	// Start from the original three-node import, cross eight through insertion,
	// then revisit earlier imported and paired stops with the untouched suffix.
	for _, entry := range []string{"awg2-fast", "awg2-strong"} {
		for _, layout := range []struct {
			count, stop int
			private     []int
		}{
			{3, 1, nil}, {5, 2, []int{2}}, {7, 4, []int{2, 4}},
			{8, 4, []int{2, 4}}, {9, 3, []int{2, 4}}, {16, 8, []int{2, 4}},
		} {
			faults := []string{"original"}
			if layout.count == 7 {
				faults = append(faults, "wrong-candidate-key", "forged-response", "wrong-private-id", "late-catalog", "late-cancel", "server-winner", "suffix-alias", "changed-original-suffix")
			}
			for _, fault := range faults {
				name := fmt.Sprintf("%d-%s-recursive-stop-%d-%s", layout.count, entry, layout.stop, fault)
				winner := "local"
				if fault == "server-winner" {
					winner = "server"
				}
				if len(layout.private) > 0 {
					responsePositions[name] = layout.private[0]
					additionalPrivate[name] = layout.private[1:]
				}
				cases = append(cases, selectedCase{name, layout.count, entry, "auto", winner, "private-response/" + fault, layout.stop, 0})
			}
		}
	}
	registerPrivate := func(count, position int, mode, winner, operation string, first, last int) {
		name := fmt.Sprintf("%d-private-%d-%s-%s-%s", count, position, mode, winner, operation)
		if operation == "latency" {
			name += fmt.Sprintf("-%d-%d", first, last)
		}
		privatePositions[name] = position
		cases = append(cases, selectedCase{name, count, "wg", mode, winner, operation, first, last})
	}
	for _, layout := range []struct{ count, middle, late, batch int }{{5, 2, 3, 5}, {9, 4, 7, 9}, {16, 2, 14, 4}} {
		registerPrivate(layout.count, layout.middle, "server", "server", "response", 0, 0)
		registerPrivate(layout.count, layout.late, "auto", "local", "response", 0, 0)
		registerPrivate(layout.count, layout.middle, "auto", "server", "response", 0, 0)
		registerPrivate(layout.count, layout.late, "server", "server", "throughput", 0, 0)
		registerPrivate(layout.count, layout.middle, "server", "server", "drain", 0, 0)
		for first := 1; first <= layout.count; first += layout.batch {
			registerPrivate(layout.count, layout.late, "server", "server", "latency", first, first+layout.batch-1)
		}
	}
	registerPrivate(5, 3, "server", "server", "wrong-key", 0, 0)
	registerPrivate(9, 4, "server", "server", "wrong-public", 0, 0)
	registerPrivate(9, 7, "server", "server", "wrong-dns", 0, 0)
	registerPrivate(16, 14, "server", "server", "wrong-identity", 0, 0)
	registerPrivate(16, 2, "server", "server", "wrong-exit", 0, 0)
	for _, c := range cases {
		t.Run(c.name, func(t *testing.T) {
			paired := privatePositions[c.name]
			if position, response := responsePositions[c.name]; response {
				paired = position
			}
			routervpnamnezia.RunExtendedOriginalWorker(t, c.count, c.entry, c.mode, c.winner, c.measure, c.first, c.last, paired, func(ctx, base context.Context, src string, capture multihoprelay.NodeChainCapture, listener net.Listener) (multihoprelay.NodeChainProcess, error) {
				if privatePositions[c.name] > 0 {
					child, err := startPrivateStreamProcess(ctx, t, src, capture, listener)
					if child == nil {
						_ = listener.Close()
						return nil, err
					}
					return child, err
				}
				dir := t.TempDir()
				if err := os.Chmod(dir, 0700); err != nil {
					return nil, err
				}
				root, err := os.OpenRoot(dir)
				if err != nil {
					return nil, err
				}
				raw, err := json.Marshal(capture)
				if err != nil {
					return nil, err
				}
				if err = root.WriteFile("node-chain-capture.json", raw, 0600); err != nil {
					return nil, err
				}
				if err = root.WriteFile("node-chain-source.json", []byte(src), 0600); err != nil {
					return nil, err
				}
				owner, err := routerVPNNewServerChainWithListener(ctx, base, root, dir, capture, func(ctx context.Context, n, addr string) (net.Listener, error) {
					if n != "tcp" || addr != listener.Addr().String() || ctx.Err() != nil {
						return nil, errors.New("wrong original WireGuard listener")
					}
					return listener, nil
				})
				if err != nil {
					t.Log("native creation failed:", err)
					if owner != nil {
						drain, cancel := context.WithTimeout(context.Background(), 3*time.Second)
						defer cancel()
						_ = owner.Close(drain)
					}
					_ = root.Close()
					return nil, err
				}
				return &extendedActualWorker{owner.(*routerVPNServerChain), root}, nil
			}, additionalPrivate[c.name]...)
		})
	}
}
