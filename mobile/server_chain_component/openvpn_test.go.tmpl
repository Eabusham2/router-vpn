	if json.Unmarshal([]byte(launch), &source) != nil {
		t.Fatal("original provider source")
	}
	source.Nodes[len(source.Nodes)-1] = nativeOpenVPNFinalCompanion(t, source.Nodes[len(source.Nodes)-1])
	var member struct {
		Config  string `json:"config"`
		Capture string `json:"capture"`
	}
	if json.Unmarshal([]byte(source.Nodes[count]), &member) != nil {
		t.Fatal("original imported member")
	}
	var capture struct {
		Profile struct {
			External struct {
				OpenVPN nativeopenvpn.Profile `json:"openvpn"`
			} `json:"external"`
		} `json:"profile"`
	}
	if json.Unmarshal([]byte(member.Capture), &capture) != nil {
