func (f *nativeOpenVPNServerFixture) close() error {
	if f.closed {
		return nil
	}
	f.owner.cancel()
	var failure error
	for _, c := range f.originals {
		failure = errors.Join(failure, c.Close())
	}
	if failure != nil {
		return failure
	}
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	if err := f.owner.closeTransportContext(ctx); err != nil {
		return err
	}
	if err := f.owner.box.Close(); err != nil {
		return err
	}
	if !f.owner.stopParent() {
		select {
		case <-f.owner.parentDone:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	f.closed = true
	return nil
}
func (f *nativeOpenVPNServerFixture) ObserveServerContext(ctx context.Context) (mobilemultihop.NodeChainServerBinding, error) {
	if err := f.owner.openVPN.current(ctx, f.owner); err != nil {
		return mobilemultihop.NodeChainServerBinding{}, err
	}
	if _, err := f.owner.OpenVPNMiddleStateContext(ctx, f.owner.openVPN.capture.Middle.Tag); err != nil {
		return mobilemultihop.NodeChainServerBinding{}, err
	}
	return f.owner.binding, nil
}
func (f *nativeOpenVPNServerFixture) OpenVPNMiddleStateContext(ctx context.Context, tag string) (nativeopenvpn.PacketObservation, error) {
	return f.owner.OpenVPNMiddleStateContext(ctx, tag)
}
func (f *nativeOpenVPNServerFixture) DialServerContext(ctx context.Context, tag, network, address string) (net.Conn, error) {
	if _, err := f.ObserveServerContext(ctx); err != nil {
		return nil, err
	}
	out := f.owner.outputs[tag]
	if out == nil {
		return nil, errors.New("foreign actual output")
	}
	c, err := out.DialContext(ctx, network, M.ParseSocksaddr(address))
	if c != nil {
		f.originals = append(f.originals, c)
	}
	return c, err
}
func (f *nativeOpenVPNServerFixture) ProveServerDNSContext(ctx context.Context, capture mobilemultihop.NodeChainServerDNSCapture) error {
	if _, err := f.ObserveServerContext(ctx); err != nil {
		return err
	}
	original, err := f.owner.policy.DNSCapture(f.owner.capture)
	if err != nil || !reflect.DeepEqual(original, capture) {
		return errors.New("foreign selected DNS capture")
	}
	q := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
	r, err := f.dns.Exchange(ctx, q)
	if err != nil {
		return err
	}
	if r == nil || r.Id != q.Id || r.Rcode != dns.RcodeSuccess || len(r.Answer) != 1 {
		return errors.New("actual selected DNS missing answer")
	}
	a, ok := r.Answer[0].(*dns.A)
	if !ok || !a.A.Equal(net.ParseIP("93.184.216.34")) {
		return errors.New("actual selected DNS changed answer")
	}
	_, err = f.ObserveServerContext(ctx)
	return err
}
func TestNativeOpenVPNServerOriginalEndpoint(t *testing.T) {
	selected := os.Getenv("ROUTERVPN_SERVER_OPENVPN_COMPONENT")
	t.Run(strings.ReplaceAll(selected, "/", "_"), func(t *testing.T) {
		parts := strings.Split(selected, "/")
		if len(parts) != 5 {
			t.Fatal("explicit component case required")
		}
		count, err := strconv.Atoi(parts[2])
		if err != nil || (count != 1 && count != 5) || (parts[0] != "wg" && parts[0] != "awg2-fast" && parts[0] != "awg2-strong") || (parts[1] != "tcp" && parts[1] != "udp") {
			t.Fatal("uncaptured native component case")
		}
		layer := parts[3]
		if layer == "off" {
			layer = ""
		}
		if layer != "" && layer != "aes-256-gcm" && layer != "aes-256-gcm+xor-whitening" {
			t.Fatal("uncaptured final layer")
		}
		fault := parts[4]
		if fault != "original" && fault != "wrong-server-password" && fault != "reconnect" && fault != "final-layer-key" {
			t.Fatal("uncaptured component fault")
		}
		if fault == "final-layer-key" && layer == "" {
			t.Fatal("layer-key control requires original enabled layer")
		}
		f := newNativeOpenVPNServerFixture(t, parts[0], parts[1], count, layer, fault)
		if fault == "wrong-server-password" {
			if f.initialError == nil || f.owner.openVPN.state != nil || f.peer.provider.stats().authFailures < 1 {
				t.Fatal("wrong Server credential lacked actual authentication refusal", f.initialError, f.peer.provider.stats())
			}
			if err := f.close(); err != nil {
				t.Fatal("failed original authentication did not join", err)
			}
			return
		}
		n := f.owner
		original := *n.openVPN.state
		before := f.peer.snapshot()
		ctx, cancel := context.WithTimeout(n.ctx, 20*time.Second)
		defer cancel()
		result, err := n.policy.Prove(ctx, n.capture, f)
		if fault == "final-layer-key" {
			after := f.peer.snapshot()
			if err == nil || result.PublicProven || after.Final.RouterQueries != before.Final.RouterQueries || after.Final.DNSQueries != before.Final.DNSQueries || after.Final.FinalPublicQueries != before.Final.FinalPublicQueries || after.Middle.PublicQueries <= before.Middle.PublicQueries {
				t.Fatal("wrong final layer reached an original private/DNS/public proof", err, before, after)
			}
			if err := f.close(); err != nil {
				t.Fatal("wrong final key original retirement did not join", err)
			}
			return
		}
		if err != nil || !result.DNSProven || !result.PublicProven || len(result.Prefixes) != count+2 || result.Binding != n.binding {
			t.Fatal("actual native Server proof failed", err)
		}
		after := f.peer.snapshot()
		for i, prefix := range after.Prefixes {
			if prefix.RawUDP <= before.Prefixes[i].RawUDP || prefix.ProofQueries <= before.Prefixes[i].ProofQueries {
				t.Fatal("Server omitted actual original packet prefix", i, before.Prefixes[i], prefix)
			}
		}
		if after.Middle.PublicQueries <= before.Middle.PublicQueries || after.Final.RouterQueries <= before.Final.RouterQueries || after.Final.DNSQueries <= before.Final.DNSQueries || after.Final.FinalPublicQueries <= before.Final.FinalPublicQueries {
			t.Fatal("Server proof borrowed original provider counters", before, after, f.peer.provider.stats())
		}
		if state, err := n.OpenVPNMiddleStateContext(ctx, n.openVPN.capture.Middle.Tag); err != nil || state != original {
			t.Fatal("original packet receipt changed after traffic", err)
		}
		endpoint := n.openVPN.endpoint
		middle := n.openVPN.capture.Middle.Tag
		n.outputs[middle] = n.outputs[n.policy.ProofInventory()[0].Tag]
		if _, err := n.openVPN.observe(ctx, n, false); err == nil {
			t.Fatal("foreign native outbound retained Server authority")
		}
		n.outputs[middle] = endpoint
		originalOwner := n.openVPN
		copied := *originalOwner
		n.openVPN = &copied
		if err := copied.current(ctx, n); err == nil {
			t.Fatal("copied original owner retained Server authority")
		}
		n.openVPN = originalOwner
		if fault == "reconnect" {
			endpoint.InterfaceUpdated(n.ctx)
			deadline := time.NewTimer(5 * time.Second)
			defer deadline.Stop()
			tick := time.NewTicker(10 * time.Millisecond)
			defer tick.Stop()
			for {
				remote, capacity, e := endpoint.RouterVPNConnectedCapacityContext(ctx)
				if e == nil && remote.Generation > original.Remote.Generation && capacity > 0 {
					break
				}
				select {
				case <-deadline.C:
					t.Fatal("actual original native reconnect did not complete")
				case <-tick.C:
				case <-ctx.Done():
					t.Fatal(ctx.Err())
				}
			}
			if _, err := n.OpenVPNMiddleStateContext(ctx, middle); err == nil || n.ctx.Err() == nil || *n.openVPN.state != original {
				t.Fatal("reconnected native packet owner replaced original pinned receipt", err)
			}
		}
		if err := f.close(); err != nil {
			t.Fatal("original native Server close did not join", err)
		}
		if _, _, err := endpoint.RouterVPNConnectedCapacityContext(context.Background()); err == nil {
			t.Fatal("closed original endpoint retained packet readiness")
		}
	})
}
