		}
		graph["endpoints"] = []any{compiled}
		rawCapture["profile"].(map[string]any)["external"].(map[string]any)["openvpn"] = serverProfile
		source.Nodes[count], e = mobilemultihop.NodeChainImportedOpenVPNMemberInput(desktopNodeChainJSON(t, graph), desktopNodeChainJSON(t, rawCapture))
		if e != nil {
			t.Fatal(e)
		}
	}
	if localProfile.Config == "" {
		t.Fatal("independent provider-issued Local capture absent")
	}
	localKey := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{71}, 32))
	serverKey := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{72}, 32))
	local, err := nativeopenvpn.DescribePeer(localProfile, localKey)
	if err != nil {
		t.Fatal(err)
	}
	server, err := nativeopenvpn.DescribePeer(serverProfile, serverKey)
	if err != nil || nativeopenvpn.ValidatePublicPair(local, server) != nil {
		t.Fatal("independent provider pair", err)
	}
	serverSource := mobilemultihop.NodeChainServerSource{Schema: 5, EntryID: "independent-client-entry", EntryNodeID: strings.Repeat("e", 64), EntryMode: mode, Nodes: source.Nodes, IdentitySources: source.IdentitySources, OpenVPNPairing: &mobilemultihop.NodeChainOpenVPNServerPairing{PrivateKey: serverKey, Local: local, Server: server}}
	n := f.owner
	n.policy, err = mobilemultihop.NewNodeChainOpenVPNServerPolicy(desktopNodeChainJSON(t, serverSource))
	if err != nil {
		t.Fatal("actual sealed Server source", err)
	}
	descriptor := n.policy.Descriptor()
	digest, _ := descriptor.Digest()
	request := multihoprelay.NodeChainRequest{Schema: 5, SessionID: strings.Repeat("1", 32), EntryNodeID: descriptor.EntryNodeID, SourceSHA256: descriptor.SourceSHA256, DescriptorSHA256: digest, DNSPolicySHA256: descriptor.DNSPolicySHA256, Epoch: strings.Repeat("2", 64), Peer: "10.77.0.2", AcquireExpiresAt: time.Now().Add(time.Minute).Unix(), Port: 26240}
	for i := 0; i <= count; i++ {
		key, e := ecdh.X25519().GenerateKey(rand.Reader)
		if e != nil {
			t.Fatal(e)
		}
		request.LocalPacketPositions = append(request.LocalPacketPositions, i)
		request.LocalPacketPublicKeys = append(request.LocalPacketPublicKeys, base64.StdEncoding.EncodeToString(key.PublicKey().Bytes()))
	}
	for i := range descriptor.Members {
		request.Users = append(request.Users, multihoprelay.NodeChainUser{Position: i + 1, Username: fmt.Sprintf("%048x", 101+i*2), Password: fmt.Sprintf("%048x", 102+i*2)})
	}
	n.capture = multihoprelay.NodeChainCapture{Schema: 1, Request: request, Source: descriptor, RegistrySHA256: digest, OwnerID: strings.Repeat("3", 64), Peer: request.Peer, Host: "10.77.0.1", BootstrapDeadline: time.Now().Add(30 * time.Second).UTC()}
	config, original, err := n.policy.ReadOpenVPNServerCapture(n.capture)
	if err != nil {
		t.Fatal("actual source reader", err)
