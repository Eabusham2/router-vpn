// Component boundary: the command container and its first physical UDP tuple
// are explicit fixtures. The helper below is the unchanged shipping helper;
// its Box, concrete OpenVPN endpoint, TLS-authenticated provider, packet receipt,
// WG/AWG prefix, selected DNS and SS2022 final all execute their actual code.
// This does not create a kernel carrier, lease manager or installed host.
type nativeOpenVPNServerFixture struct {
	owner        *routerVPNServerChain
	peer         *nodeChainOpenVPNFixture
	dns          adapter.DNSTransport
	originals    []net.Conn
	closed       bool
	initialError error
}
type nativeOpenVPNServerPhysical struct{ adapter.Endpoint }

func (*nativeOpenVPNServerPhysical) Dependencies() []string { return nil }

func nativeOpenVPNFinalCompanion(t *testing.T, input string) string {
	t.Helper()
	var row struct {
		Mode      string `json:"mode"`
		Files     string `json:"files"`
		Profile   string `json:"profile_json"`
		Start     string `json:"start"`
		Bootstrap string `json:"dns_bootstrap"`
	}
	if json.Unmarshal([]byte(input), &row) != nil {
		t.Fatal("final input")
	}
	var assets map[string]string
	var profile, graph map[string]any
	if json.Unmarshal([]byte(row.Files), &assets) != nil || json.Unmarshal([]byte(row.Profile), &profile) != nil {
		t.Fatal("final captured assets")
	}
	raw, err := base64.StdEncoding.DecodeString(assets["sing-box.json"])
	if err != nil || json.Unmarshal(raw, &graph) != nil {
		t.Fatal("final config", err)
	}
	final := graph["outbounds"].([]any)[0].(map[string]any)
	configHash, keyHash := sha256.Sum256(raw), sha256.Sum256([]byte(final["password"].(string)))
	declaration := []byte(desktopNodeChainJSON(t, map[string]any{"schema": 1, "node_id": profile["node_proof_id"], "configured_image": nativecomposite.SSServiceImage, "uot_version": 2, "endpoint": final["server"], "port": final["server_port"], "method": final["method"], "source_sha256": hex.EncodeToString(configHash[:]), "key_sha256": hex.EncodeToString(keyHash[:])}))
	if err = nativecomposite.ValidateSSServiceCompanion(raw, declaration, profile["node_proof_id"].(string)); err != nil {
		t.Fatal("actual final companion", err)
	}
	assets[nativecomposite.SSServiceAsset] = base64.StdEncoding.EncodeToString(declaration)
	node, err := mobilemultihop.NewNodeProfile(row.Mode, desktopNodeChainJSON(t, assets), row.Profile, row.Start, row.Bootstrap)
	if err != nil {
		t.Fatal(err)
	}
	result, err := node.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	return result
}
func newNativeOpenVPNServerFixture(t *testing.T, mode, network string, count int, finalLayer, fault string) *nativeOpenVPNServerFixture {
