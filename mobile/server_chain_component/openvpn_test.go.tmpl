	}
	serverProfile := capture.Profile.External.OpenVPN
	if fault == "wrong-server-password" {
		serverProfile.Password += "-wrong"
		var graph, rawCapture map[string]any
		if json.Unmarshal([]byte(member.Config), &graph) != nil || json.Unmarshal([]byte(member.Capture), &rawCapture) != nil {
