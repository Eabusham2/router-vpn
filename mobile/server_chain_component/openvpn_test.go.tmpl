	registry := BDNS.NewTransportRegistry()
	DNST.RegisterUDP(registry)
	DNST.RegisterTCP(registry)
	OVPN.RegisterDNSTransport(registry)
	nativeContext := service.ContextWith[adapter.PlatformInterface](transport, &nodeSOCKSPlatform{})
	nativeContext = box.Context(nativeContext, ins, outs, ends, registry, boxService.NewRegistry(), certificate.NewRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](nativeContext, []byte(config))
	if err != nil {
		t.Fatal(err)
	}
	n.box, err = box.New(box.Options{Context: nativeContext, Options: options})
	if err != nil {
		t.Fatal("actual Server Box", err)
	}
	t.Cleanup(func() {
		if err := f.close(); err != nil {
			t.Error("actual original Server failed joined retirement", err)
		}
	})
	if err = n.box.Start(); err != nil {
		t.Fatal("actual Server start", err)
	}
	n.outputs = map[string]adapter.Outbound{}
	for _, proof := range proofs {
		actual, found, e := adapter.RouterVPNOutboundContext(n.ctx, n.box.Outbound(), proof.Tag)
		if e != nil || !found || actual == nil {
			t.Fatal("original output", e)
		}
		n.outputs[proof.Tag] = actual
	}
	n.openVPN, err = newRouterVPNServerChainOpenVPN(n.ctx, n, config)
	if err != nil {
		t.Fatal("original native helper", err)
	}
	initialize, finish := context.WithTimeout(n.ctx, 5*time.Second)
	defer finish()
	if err = n.openVPN.await(initialize, n); err != nil {
		if fault == "wrong-server-password" {
			f.initialError = err
			return f
		}
		t.Fatal("actual authenticated packet receipt", err)
	}
	if fault == "wrong-server-password" {
		t.Fatal("wrong original provider password acquired connected receipt")
	}
	dnsCapture, err := n.policy.DNSCapture(n.capture)
	if err != nil {
		t.Fatal(err)
	}
	var found bool
	f.dns, found = service.FromContext[adapter.DNSTransportManager](nativeContext).Transport(dnsCapture.ResolverTag)
	if !found {
		t.Fatal("actual selected DNS absent")
	}
	ca := filepath.Join(t.TempDir(), "original-provider-ca.pem")
	if err = os.WriteFile(ca, []byte(p.peer.paired.ca), 0600); err != nil {
		t.Fatal(err)
