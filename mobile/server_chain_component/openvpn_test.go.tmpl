	// No Local traffic or connected receipt can be borrowed.
	var localProfile nativeopenvpn.Profile
	p := nodeChainOpenVPNStartPrefixesWithPair(t, mode, network, fault, 45*time.Second, count, &localProfile, finalLayer)
	if err := p.closeNative(); err != nil {
		t.Fatal("unused Local owner did not retire", err)
	}
	f := &nativeOpenVPNServerFixture{peer: p, owner: &routerVPNServerChain{}}
	transport := f.owner.initializeLifetime(t.Context(), p.ctx)
	launch, err := p.chain.LaunchInput()
