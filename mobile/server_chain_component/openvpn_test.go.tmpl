	n.binding = original.Binding
	proofs := n.policy.ProofInventory()
	ins, outs, ends := inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry()
	OVPN.RegisterEndpoint(ends)
	SS.RegisterOutbound(outs)
	WHT.RegisterOutbound(outs)
	address := p.peer.paired.bind.address()
	if p.complete != nil {
		address = p.complete.prefixes[0].bind.address()
