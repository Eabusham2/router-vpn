type chainNativeFixture struct {
	chain       *mobilemultihop.NodeChain
	box         *Box
	engine      *RouterVPNNodeChainEngine
	registry    *outbound.Registry
	inRegistry  *inbound.Registry
	dnsRegistry *dns.TransportRegistry
	prefixes    map[string]*chainNativePrefix
	current     atomic.Bool
}

func newChainNativeFixture(t *testing.T, edit func(map[string]any)) *chainNativeFixture {
	t.Helper()
	f := &chainNativeFixture{chain: chainNativeSource(t), prefixes: map[string]*chainNativePrefix{}}
	f.current.Store(true)
	f.registry = outbound.NewRegistry()
	group.RegisterSelector(f.registry)
	f.inRegistry = inbound.NewRegistry()
	endpointRegistry := endpoint.NewRegistry()
	inbound.Register[option.TunInboundOptions](f.inRegistry, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
		return &chainNativeTUN{inbound.NewAdapter(C.TypeTun, tag)}, nil
	})
	outbound.Register[option.ShadowsocksOutboundOptions](f.registry, C.TypeShadowsocks, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.ShadowsocksOutboundOptions) (adapter.Outbound, error) {
		p := &chainNativePrefix{Adapter: outbound.NewAdapter(C.TypeShadowsocks, tag, []string{"tcp", "udp"}, nil)}
		f.prefixes[tag] = p
		return p, nil
	})
	endpoint.Register[option.WireGuardEndpointOptions](endpointRegistry, C.TypeWireGuard, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.WireGuardEndpointOptions) (adapter.Endpoint, error) {
		p := &chainNativePrefix{Adapter: outbound.NewAdapter(C.TypeWireGuard, tag, []string{"tcp", "udp"}, nil)}
		f.prefixes[tag] = p
		return p, nil
	})
	f.dnsRegistry = dns.NewTransportRegistry()
	dns.RegisterTransport[option.RemoteDNSServerOptions](f.dnsRegistry, C.DNSTypeUDP, func(_ context.Context, _ log.ContextLogger, tag string, _ option.RemoteDNSServerOptions) (adapter.DNSTransport, error) {
		return &chainNativeDNS{TransportAdapter: dns.NewTransportAdapter(C.DNSTypeUDP, tag, nil)}, nil
	})
	ctx := Context(context.Background(), f.inRegistry, f.registry, endpointRegistry, f.dnsRegistry, boxService.NewRegistry(), certificate.NewRegistry())
	logger := log.NewNOPFactory().Logger()
	ends := endpoint.NewManager(logger, endpointRegistry)
	outs := outbound.NewManager(logger, f.registry, ends, mobilemultihop.SelectorTag)
	ins := inbound.NewManager(logger, f.inRegistry, ends)
	transports := dns.NewTransportManager(logger, f.dnsRegistry, outs, f.chain.DNSCapture().ResolverTag)
	service.MustRegister[adapter.OutboundManager](ctx, outs)
	var graph map[string]any
	if err := json.Unmarshal([]byte(f.chain.Config()), &graph); err != nil {
		t.Fatal(err)
	}
	if edit != nil {
		edit(graph)
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(chainNativeJSON(t, graph)))
	if err != nil {
		t.Fatal(err)
	}
	network := new(route.NetworkManager)
	*chainNativeField[context.Context](t, network, "ctx") = ctx
	chainNativeField[atomic.Bool](t, network, "started").Store(true)
	*chainNativeField[tun.DefaultInterfaceMonitor](t, network, "interfaceMonitor") = &chainNativeMonitor{physical: &control.Interface{Name: "chain-fixture", Index: 27}}
	f.box = &Box{ctx: ctx, done: make(chan struct{}), inbound: ins, outbound: outs, endpoint: ends, dnsTransport: transports, network: network,
		routerVPNNodeChainOptions: routerVPNNodeChainOptionsDigest(ctx, options)}
	for _, entry := range options.Inbounds {
		if err := ins.Create(ctx, nil, logger, entry.Tag, entry.Type, entry.Options); err != nil {
			t.Fatal(err)
		}
	}
	for _, entry := range options.Endpoints {
		if err := ends.Create(ctx, nil, logger, entry.Tag, entry.Type, entry.Options); err != nil {
			t.Fatal(err)
		}
	}
	for _, entry := range options.Outbounds {
		if err := outs.Create(ctx, nil, logger, entry.Tag, entry.Type, entry.Options); err != nil {
			t.Fatal(err)
		}
	}
	for _, entry := range options.DNS.Servers {
		if err := transports.Create(ctx, logger, entry.Tag, entry.Type, entry.Options); err != nil {
			t.Fatal(err)
		}
	}
	selected, found := outs.Outbound(mobilemultihop.SelectorTag)
	if !found {
		t.Fatal("selector missing")
	}
	if err := selected.(*group.Selector).Start(); err != nil {
		t.Fatal(err)
	}
	return f
}

func (f *chainNativeFixture) capture(ctx context.Context) (*RouterVPNNodeChainEngine, error) {
	return f.box.RouterVPNNewNodeChainEngine(ctx, f.chain, strings.Repeat("a", 64), func(ctx context.Context) error {
		if !f.current.Load() {
			return errors.New("native owner replaced")
		}
		return ctx.Err()
	})
}

func TestRouterVPNNodeChainNativeCaptureAndSubstitution(t *testing.T) {
	f := newChainNativeFixture(t, nil)
	engine, err := f.capture(context.Background())
	if err != nil {
		t.Fatal("complete native capture", err)
	}
	identity, err := engine.ObserveChainContext(context.Background())
	if err != nil || identity.SourceSHA256 != f.chain.SourceSHA256() || identity.ConfigSHA256 != f.chain.ConfigSHA256() {
		t.Fatal("wrong native identity", err)
	}
	for _, fault := range []string{"middle-key", "dns", "route", "mtu"} {
		t.Run(fault, func(t *testing.T) {
			other := newChainNativeFixture(t, func(graph map[string]any) {
				switch fault {
				case "middle-key":
					graph["endpoints"].([]any)[1].(map[string]any)["private_key"] = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{115}, 32))
				case "dns":
					graph["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)["server"] = "192.168.50.134"
				case "route":
					graph["route"].(map[string]any)["rules"] = []any{}
				case "mtu":
					graph["inbounds"].([]any)[0].(map[string]any)["mtu"] = float64(1400)
				}
			})
			if owned, err := other.capture(context.Background()); err == nil || owned != nil {
				t.Fatal("substituted actual graph acquired ordered authority")
			}
		})
	}
	if _, err := engine.Dial(context.Background(), "direct", "1.1.1.1:443"); err == nil {
		t.Fatal("arbitrary prefix admitted")
	}
	if _, err := engine.Dial(context.Background(), f.chain.FinalTag(), "unowned.example:443"); err == nil {
		t.Fatal("ambient hostname admitted")
	}
	dnsCapture := f.chain.DNSCapture()
	dnsCapture.ResolverSHA256 = strings.Repeat("f", 64)
	if err := engine.DNSProofContext(context.Background(), dnsCapture); err == nil {
		t.Fatal("foreign selected DNS admitted")
	}
	f.current.Store(false)
	if _, err := engine.ObserveChainContext(context.Background()); err == nil {
		t.Fatal("replacement owner adopted old proof")
	}
}

func TestRouterVPNNodeChainNativeHeldReadAndLateDial(t *testing.T) {
	for _, fault := range []string{"manager-held", "cancel", "network", "replacement", "closing"} {
		t.Run(fault, func(t *testing.T) {
			f := newChainNativeFixture(t, nil)
			engine, err := f.capture(context.Background())
			if err != nil {
				t.Fatal(err)
			}
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			if fault == "manager-held" {
				mu := chainNativeField[sync.RWMutex](t, f.box.outbound, "access")
				mu.Lock()
				bounded, finish := context.WithTimeout(ctx, 15*time.Millisecond)
				_, err := engine.ObserveChainContext(bounded)
				finish()
				mu.Unlock()
				if !errors.Is(err, context.DeadlineExceeded) {
					t.Fatal("original manager deadline lost", err)
				}
				if _, err := engine.ObserveChainContext(ctx); err != nil {
					t.Fatal("timed-out observer damaged native owner", err)
				}
				return
			}
			connection, peer := net.Pipe()
			defer connection.Close()
			defer peer.Close()
			f.prefixes[f.chain.FinalTag()].dial = func(context.Context) (net.Conn, error) {
				switch fault {
				case "cancel":
					cancel()
				case "network":
					chainNativeField[atomic.Uint64](t, f.box.network, "routerVPNNodeChainGeneration").Add(1)
				case "replacement":
					f.current.Store(false)
				case "closing":
					close(f.box.done)
				}
				return connection, nil
			}
			if result, err := engine.Dial(ctx, f.chain.FinalTag(), "1.1.1.1:443"); err == nil || result != nil {
				t.Fatal("late unowned connection published")
			}
			deadlineErr := peer.SetWriteDeadline(time.Now().Add(time.Second))
			if deadlineErr != nil && !errors.Is(deadlineErr, io.ErrClosedPipe) {
				t.Fatal("unexpected peer deadline", deadlineErr)
			}
			if deadlineErr == nil {
				if _, err := peer.Write([]byte{1}); !errors.Is(err, io.ErrClosedPipe) {
					t.Fatal("late connection was not closed", err)
				}
			}
		})
	}
}
