package box

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"net"
	"slices"
	"time"

	"github.com/sagernet/sing-box/adapter"
	C "github.com/sagernet/sing-box/constant"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/hopmeasure"
	M "github.com/sagernet/sing/common/metadata"
)

// Generic imported SS execution retains its own source receipt. It never
// borrows the typed CONNECT constructor or a replacement resolver/packet path.
func (e *RouterVPNNodeChainExecutionEngine) dialImportedPublicContext(ctx context.Context, state *routerVPNExecutionState, tag string) (net.Conn, error) {
	if e == nil || ctx == nil || state == nil || state.stage != 2 || state.projection == nil || e.instance == nil || e.instance.dnsRouter == nil || e.resolver == nil {
		return nil, errRouterVPNExecutionOwner
	}
	execution := ""
	selected := e.selector.Now()
	epoch := e.selector.RouterVPNNodeChainSelectionEpoch()
	if selected == state.local.Tag() {
		execution = "local"
	} else if selected == state.server.Tag() {
		execution = "server"
	} else {
		return nil, errRouterVPNExecutionOwner
	}
	var ipv6 bool
	if e.prep.RequiresExternalFinalExecutionObserver() {
		members, allowIPv6, err := state.projection.ExternalFinalPublicMeasurementCaptures(execution)
		if err != nil || !slices.ContainsFunc(members, func(member mobilemultihop.NodeChainPublicMeasurementCapture) bool { return member.Tag == tag }) {
			return nil, errRouterVPNExecutionOwner
		}
		ipv6 = allowIPv6
	} else if e.prep.RequiresMultipleImportedExecutionObserver() {
		members, allowIPv6, err := state.projection.ImportedPublicMeasurementCaptures(execution)
		if err != nil || !slices.ContainsFunc(members, func(member mobilemultihop.NodeChainPublicMeasurementCapture) bool { return member.Tag == tag }) {
			return nil, errRouterVPNExecutionOwner
		}
		ipv6 = allowIPv6
	} else {
		capturedTag, allowIPv6, err := state.projection.ImportedPublicMeasurementCapture(execution)
		if err != nil || capturedTag != tag {
			return nil, errRouterVPNExecutionOwner
		}
		ipv6 = allowIPv6
	}
	dns, err := state.projection.DNSCapture(execution)
	if err != nil || dns.SelectedTag != selected || dns.DNS.ResolverTag != e.dnsCapture.DNS.ResolverTag {
		return nil, errRouterVPNExecutionOwner
	}
	current := func() error {
		observed, err := e.ObserveChainContext(ctx)
		if err != nil || observed != state.identity || e.state.Load() != state || e.selector.Now() != selected || e.selector.RouterVPNNodeChainSelectionEpoch() != epoch {
			return errRouterVPNExecutionOwner
		}
		return ctx.Err()
	}
	if err = current(); err != nil {
		return nil, err
	}
	if execution == "server" {
		// The remote authenticated prefix grants exactly this hostname. Its own
		// retained selected resolver validates every resulting address; sending a
		// client-resolved IP would bypass (and is rejected by) that front authority.
		retained := state.prefixes[tag]
		if retained == nil {
			return nil, errRouterVPNExecutionOwner
		}
		conn, dialErr := retained.DialContext(ctx, "tcp", M.ParseSocksaddr(hopmeasure.PublicAddress))
		if observed := current(); observed != nil || conn == nil {
			return conn, errors.Join(dialErr, observed, errRouterVPNExecutionOwner)
		}
		return conn, dialErr
	}
	query, cancel := context.WithTimeout(ctx, 5*time.Second)
	defer cancel()
	query = adapter.WithContext(query, &adapter.InboundContext{Inbound: dns.DNS.TUNTag, InboundType: C.TypeTun, Network: "udp", Protocol: "dns"})
	addresses, err := e.instance.dnsRouter.Lookup(query, hopmeasure.PublicHost, adapter.DNSQueryOptions{Transport: e.resolver, DisableCache: true, DisableOptimisticCache: true})
	if observed := current(); err != nil || observed != nil {
		return nil, errors.Join(err, observed)
	}
	for _, ip := range addresses {
		if !ip.IsValid() || ip.Zone() != "" || ip.Is4In6() || !ip.IsGlobalUnicast() || ip.IsPrivate() || ip.IsLoopback() || ip.IsLinkLocalUnicast() || ip.IsUnspecified() || ip.Is6() && !ipv6 {
			continue
		}
		conn, dialErr := e.Dial(ctx, tag, net.JoinHostPort(ip.String(), "443"))
		if observed := current(); observed != nil {
			return conn, errors.Join(dialErr, observed)
		}
		if dialErr == nil && conn != nil {
			return conn, nil
		}
		if conn != nil {
			return conn, dialErr
		}
	}
	return nil, errRouterVPNExecutionOwner
}
