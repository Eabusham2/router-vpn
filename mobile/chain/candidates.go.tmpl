// The host observes its actual stores, source files and original chain/server
// ownership. Its digest covers the exact inventory JSON, including a monotonic
// catalog revision that advances even when a source changes away and back.
// Return empty on unavailable or changed ownership. Never return a fixed copy
// of the factory's digest without checking the current host catalog.
type RouterNodeChainCandidateCatalog interface {
	CurrentInventorySHA256() string
}

type routerNodeChainCatalogCall struct {
	done   chan struct{}
	digest string
}

type RouterNodeChainCandidateMeasurement struct {
	self            *RouterNodeChainCandidateMeasurement
	owner           *RouterNodeChain
	state           *routerNodeChainProofState
	plan            *mobilemultihop.NodeChainCandidatePlan
	catalog         RouterNodeChainCandidateCatalog
	inventorySHA    string
	service         atomic.Pointer[hopmeasure.CandidateService]
	retired         atomic.Bool
	callbackActive  atomic.Bool
	observation     sync.Mutex
	pending         *routerNodeChainCatalogCall // retained until the foreign callback joins
	preparation     sync.Mutex
	prepareStarted  bool
	prepareDeadline time.Time     // original constructor observation deadline, never renewed
	prepareDone     chan struct{} // closed only by the admitted Prepare caller
}

func RouterNodeChainNewCandidateMeasurement(plan *RouterNodeChain, server *CommandServer, prefixPosition int32, inventory string, catalog RouterNodeChainCandidateCatalog) (*RouterNodeChainCandidateMeasurement, error) {
	ctx, cancel := context.WithTimeout(context.Background(), hopmeasure.ObservationTimeout)
	defer cancel()
	return plan.newCandidateMeasurementContext(ctx, server, int(prefixPosition), inventory, catalog)
}

func (m *RouterNodeChain) newCandidateMeasurementContext(ctx context.Context, server *CommandServer, position int, inventory string, catalog RouterNodeChainCandidateCatalog) (*RouterNodeChainCandidateMeasurement, error) {
	if m == nil || m.self != m || m.chain == nil || server == nil || catalog == nil || ctx == nil {
		return nil, errors.New("candidate measurement requires its original native owner and live catalog")
	}
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	prepareDeadline := time.Now().Add(hopmeasure.ObservationTimeout)
	if deadline, bounded := ctx.Deadline(); bounded && deadline.Before(prepareDeadline) {
		prepareDeadline = deadline
	}
	state := m.state.Load()
	if state == nil || state.chain == nil || state.revoked.Load() {
		return nil, errors.New("candidate measurement has no original proved source")
	}
	// The live proof controller owns the exact imported registry. The dormant
	// launch plan has matching bytes but cannot substitute for that owner.
	plan, err := state.chain.NewCandidatePlanFromInputs(position, inventory, nil)
	if err != nil {
		return nil, err
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.mu); err != nil {
		return nil, err
	}
	if m.server != server || m.state.Load() != state || state.revoked.Load() || m.candidate.Load() != nil || m.healthyContext(ctx) != nil {
		m.mu.Unlock()
		return nil, errors.New("candidate measurement changed its native server, catalog or proof")
	}
	digest := sha256.Sum256([]byte(inventory))
	candidate := &RouterNodeChainCandidateMeasurement{owner: m, state: state, plan: plan, catalog: catalog, inventorySHA: hex.EncodeToString(digest[:]), prepareDeadline: prepareDeadline}
	candidate.self = candidate
	m.candidate.Store(candidate)
	m.mu.Unlock()
	// The caller receives every published reservation before foreign catalog
	// or service work. No fallible operation follows slot publication.
	return candidate, nil
}

// Prepare is one-shot and uses the original New deadline. The host must retain
// this exact handle first; failed preparation is cleaned only through Close.
func (m *RouterNodeChainCandidateMeasurement) Prepare() error {
	return m.prepareContext(context.Background())
}
func (m *RouterNodeChainCandidateMeasurement) prepareContext(ctx context.Context) error {
	if m == nil || ctx == nil || m.prepareDeadline.IsZero() {
		return errors.New("candidate lost its original construction deadline")
	}
	ctx, cancel := context.WithDeadline(ctx, m.prepareDeadline)
	defer cancel()
	if err := m.current(ctx); err != nil {
		return err
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.preparation); err != nil {
		return err
	}
	if m.prepareStarted || m.retired.Load() || m.owner.candidate.Load() != m {
		m.preparation.Unlock()
		return errors.New("candidate preparation requires its original unused reservation")
	}
	m.prepareStarted = true
	m.prepareDone = make(chan struct{})
	done := m.prepareDone
	m.preparation.Unlock()
	defer close(done)
	service, err := m.plan.NewMeasurementContext(ctx, m)
	if err == nil {
		m.service.Store(service)
		err = m.current(ctx)
	}
	return err
}

func (m *RouterNodeChainCandidateMeasurement) current(ctx context.Context) error {
	if ctx == nil || m == nil || m.self != m || m.owner == nil || m.owner.self != m.owner || m.state == nil || m.retired.Load() || m.owner.candidate.Load() != m || m.owner.state.Load() != m.state {
		return errors.New("candidate measurement lost its original native proof reader")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	return m.owner.nativeCurrent(ctx, m.state)
}

func (m *RouterNodeChainCandidateMeasurement) MeasurementChainContext(ctx context.Context) (*mobilemultihop.NodeChain, error) {
	if err := m.current(ctx); err != nil {
		return nil, err
	}
	chain, err := m.owner.MeasurementChainContext(ctx)
	if err != nil {
		return nil, err
	}
	return chain, m.current(ctx)
}
func (m *RouterNodeChainCandidateMeasurement) BeginMeasurementContext(ctx context.Context) (func(), error) {
	if err := m.current(ctx); err != nil {
		return nil, err
	}
	release, err := m.owner.BeginMeasurementContext(ctx)
	if err != nil {
		return release, err
	}
	if err := m.current(ctx); err != nil {
		release()
		return nil, err
	}
	return func() {
		// The activity release belongs to the worker: a canceled foreign
		// observation still owns this hold until its actual callback returns.
		_ = m.joinCatalog(context.Background())
		release()
	}, nil
}

func (m *RouterNodeChainCandidateMeasurement) CandidateInventoryCurrentContext(parent context.Context, capture string) error {
	if parent == nil {
		return errors.New("candidate catalog observation has no original caller")
	}
	ctx, cancel := context.WithTimeout(parent, hopmeasure.ObservationTimeout)
	defer cancel()
	if err := m.current(ctx); err != nil {
		return err
	}
	if m.plan == nil || capture != m.plan.CaptureSHA256() || m.catalog == nil {
		return errors.New("candidate catalog differs from its original capture")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.observation); err != nil {
		return err
	}
	defer m.observation.Unlock()
	if m.pending != nil {
		select {
		case <-m.pending.done:
			m.pending = nil
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	if err := m.current(ctx); err != nil {
		return err
	}
	call := &routerNodeChainCatalogCall{done: make(chan struct{})}
	m.pending = call
	m.callbackActive.Store(true)
	go func() {
		defer func() { m.callbackActive.Store(false); close(call.done) }()
		call.digest = m.catalog.CurrentInventorySHA256()
	}()
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-call.done:
		m.pending = nil
		if err := m.current(ctx); err != nil {
			return err
		}
		if call.digest != m.inventorySHA {
			m.retired.Store(true)
			return errors.New("original candidate catalog revision or source changed")
		}
		return ctx.Err()
	}
}

func (m *RouterNodeChainCandidateMeasurement) Metadata() string { return m.MetadataPage(0) }
func (m *RouterNodeChainCandidateMeasurement) MetadataPage(offset int32) string {
	if m == nil || m.self != m || m.plan == nil {
		return ""
	}
	return m.plan.MetadataPage(offset)
}
func (m *RouterNodeChainCandidateMeasurement) CaptureSHA256() string {
	if m == nil || m.self != m || m.plan == nil {
		return ""
	}
	return m.plan.CaptureSHA256()
}
func (m *RouterNodeChainCandidateMeasurement) Start(request, candidateID string) error {
	if m == nil || m.self != m || m.service.Load() == nil {
		return errors.New("candidate measurement is unavailable")
	}
	return m.service.Load().Start(request, candidateID)
}
func (m *RouterNodeChainCandidateMeasurement) Cancel(request string) {
	if m != nil && m.self == m {
		if service := m.service.Load(); service != nil {
			service.Cancel(request)
		}
	}
}
func (m *RouterNodeChainCandidateMeasurement) Drain(request string) error {
	if m == nil || m.self != m || m.service.Load() == nil {
		return errors.New("candidate measurement is unavailable")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := m.service.Load().Drain(request); err != nil {
		return err
	}
	return m.joinCatalog(ctx)
}
func (m *RouterNodeChainCandidateMeasurement) StatusJSON() string {
	if m == nil || m.self != m || m.service.Load() == nil {
		return ""
	}
	raw := m.service.Load().StatusJSON()
	if !m.callbackActive.Load() {
		return raw
	}
	var status hopmeasure.CandidateStatus
	if json.Unmarshal([]byte(raw), &status) != nil {
		return ""
	}
	status.Complete, status.Drained, status.Stage, status.Results = false, false, "draining", []hopmeasure.Result{}
	encoded, _ := json.Marshal(status)
	return string(encoded)
}
func (m *RouterNodeChainCandidateMeasurement) NetworkChanged() {
	if m != nil && m.self == m {
		m.retired.Store(true)
		if service := m.service.Load(); service != nil {
			service.Invalidate()
		}
	}
}
func (m *RouterNodeChainCandidateMeasurement) Close() error {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	return m.closeContext(ctx)
}
func (m *RouterNodeChainCandidateMeasurement) closeContext(ctx context.Context) error {
	if m == nil {
		return nil
	}
	if ctx == nil || m.self != m || m.owner == nil || m.owner.self != m.owner {
		return errors.New("candidate close requires its original owner and caller")
	}
	if retained := m.owner.candidate.Load(); retained != nil && retained != m {
		return errors.New("candidate close lost its original owner slot")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.preparation); err != nil {
		return err
	}
	m.retired.Store(true)
	started, done := m.prepareStarted, m.prepareDone
	m.preparation.Unlock()
	if started {
		select {
		case <-done:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	if service := m.service.Load(); service != nil {
		if err := service.CloseContext(ctx); err != nil {
			return err
		}
	}
	if err := m.joinCatalog(ctx); err != nil {
		return err
	}
	if m.owner != nil {
		m.owner.candidate.CompareAndSwap(m, nil)
	}
	return nil
}

func (m *RouterNodeChainCandidateMeasurement) joinCatalog(ctx context.Context) error {
	if err := adapter.RouterVPNLockContext(ctx, &m.observation); err != nil {
		return err
	}
	defer m.observation.Unlock()
	if m.pending != nil {
		select {
		case <-m.pending.done:
			m.pending = nil
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return ctx.Err()
}

// RouterNodeChainCandidateInputSupported uses the original shared compiler;
// unsupported saved rows remain unscored without exposing their destinations.
func RouterNodeChainCandidateInputSupported(input string) bool {
	return mobilemultihop.NodeChainCandidateInputSupported(input)
}

func RouterNodeChainHysteria2CandidateInputSupported(input string) bool {
	return mobilemultihop.NodeChainHysteria2CandidateInputSupported(input)
}

func RouterNodeChainSupportsConnectedHysteria2FinalCandidate(plan *RouterNodeChain, position int32) bool {
	return plan != nil && plan.self == plan && plan.chain != nil && plan.chain.SupportsConnectedHysteria2FinalCandidate(int(position))
}

func RouterNodeChainCandidatePrefixMeasurement(plan *RouterNodeChain, position int32) string {
	if plan == nil || plan.self != plan || plan.chain == nil {
		return ""
	}
	return plan.chain.CandidatePrefixMeasurement(int(position))
}

func RouterNodeChainConnectedCandidatePrefixMeasurement(plan *RouterNodeChain, position int32) string {
	if plan == nil || plan.self != plan || plan.chain == nil {
		return ""
	}
	return plan.chain.ConnectedCandidatePrefixMeasurement(int(position))
}

// Retain only independent original imported candidates for one Local public prefix.
func RouterNodeChainFilterPublicCandidateInventory(source string, position int32, inventory string) (string, error) {
	return mobilemultihop.FilterNodeChainPublicCandidateInventory(source, int(position), inventory)
}

func RouterNodeChainCandidateInputSupportedForMeasurement(input, measurement string) bool {
	return mobilemultihop.NodeChainCandidateInputSupportedForMeasurement(input, measurement)
}

// Compare a prepared public prefix row to its complete original native owner.
func RouterNodeChainCandidatePrefixProof(plan *RouterNodeChain, position int32) string {
	if plan == nil || plan.self != plan || plan.chain == nil {
		return ""
	}
	proof, ok := plan.chain.CandidatePrefixProof(int(position))
	if !ok {
		return ""
	}
	raw, err := json.Marshal(proof)
	if err != nil {
		return ""
	}
	return string(raw)
}
