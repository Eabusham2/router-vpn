package libbox

import (
	"context"
	"encoding/json"
	"errors"
	"time"

	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

// RouterNodeChainImportedCONNECTMemberInput preserves the complete original saved
// import and its public identity; it never creates paired node credentials.
func RouterNodeChainImportedCONNECTMemberInput(config, capture string) (string, error) {
	return mobilemultihop.NodeChainImportedCONNECTMemberInput(config, capture)
}

// This distinct factory retains one private source object. It grants no
// ordinary schema, Server/Compare, candidate or platform UI admission.
func NewRouterNodeChainCONNECT(input string) (*RouterNodeChainCONNECT, error) {
	source, err := mobilemultihop.NewNodeChainCONNECTSource(input)
	if err != nil {
		return nil, err
	}
	plan := &RouterNodeChainCONNECT{source: source}
	plan.self = plan
	return plan, nil
}

// NewCommandServer installs only the source-bound local CONNECT registry. The
// host first retains the returned server, then explicitly calls BindNative
// before Start. Binding failures must not hide the server in gomobile's error
// return; the host needs its original handle for exact native cleanup.
func (m *RouterNodeChainCONNECT) NewCommandServer(handler CommandServerHandler, platform PlatformInterface) (*CommandServer, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	if m == nil || m.source == nil || handler == nil || platform == nil {
		return nil, errRouterNodeChainCONNECT()
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.mu); err != nil {
		return nil, err
	}
	defer m.mu.Unlock()
	if m.retired.Load() || m.native.Load() != nil || m.state.Load() != nil {
		return nil, errRouterNodeChainCONNECT()
	}
	server, err := newRouterNodeCONNECTCommandServer(handler, platform, m.source)
	if server != nil {
		m.native.Store(&routerNodeChainCONNECTNative{server: server, service: server.StartedService})
	}
	if err != nil || server == nil {
		return server, errors.Join(err, errRouterNodeChainCONNECT())
	}
	return server, nil
}

// RouterNodeChainCONNECTNewCommandServer exposes the original result and error
// through gomobile's top-level factory ABI. A partial server remains available
// to the host for exact cleanup; this wrapper neither retries nor discards it.
func RouterNodeChainCONNECTNewCommandServer(m *RouterNodeChainCONNECT, handler CommandServerHandler, platform PlatformInterface) (*CommandServer, error) {
	if m == nil {
		return nil, errRouterNodeChainCONNECT()
	}
	return m.NewCommandServer(handler, platform)
}

// Source is the exact private schema4 input for the original protected session
// file. It carries no generic launch, Ready or native ownership authority.
func (m *RouterNodeChainCONNECT) Source() (string, error) {
	if m == nil || m.source == nil {
		return "", errRouterNodeChainCONNECT()
	}
	return m.source.Source()
}
func (m *RouterNodeChainCONNECT) Config() (string, error) {
	if m == nil || m.source == nil {
		return "", errRouterNodeChainCONNECT()
	}
	config, _, err := m.source.ReadValidated()
	return config, err
}
func (m *RouterNodeChainCONNECT) SourceSHA256() string {
	if m == nil || m.source == nil {
		return ""
	}
	_, meta, err := m.source.ReadValidated()
	if err != nil {
		return ""
	}
	return meta.SourceSHA256
}
func (m *RouterNodeChainCONNECT) ConfigSHA256() string {
	if m == nil || m.source == nil {
		return ""
	}
	_, meta, err := m.source.ReadValidated()
	if err != nil {
		return ""
	}
	return meta.ConfigSHA256
}
func (m *RouterNodeChainCONNECT) Metadata() string {
	if m == nil || m.source == nil {
		return ""
	}
	_, meta, err := m.source.ReadValidated()
	if err != nil {
		return ""
	}
	raw, err := json.Marshal(meta)
	if err != nil {
		return ""
	}
	return string(raw)
}
func (m *RouterNodeChainCONNECT) ProgressJSON() string {
	progress := mobilemultihop.NodeChainProgress{Stage: "idle", Execution: "local"}
	if m != nil {
		if state := m.state.Load(); state != nil {
			progress = state.runtime.Progress()
		}
		if m.retired.Load() {
			progress.Ready = false
		}
	}
	raw, _ := json.Marshal(progress)
	return string(raw)
}
