// Reuses the original separately compiled SOCKS/SS encrypted reference and
// every actual packet-prefix device. Only the first physical tuple and the
// original test TUN boundary are adapted; later routes remain native detours.
func TestRouterNodeChainSOCKSEncryptedPrefixes(t *testing.T) {
	chosen := os.Getenv("ROUTERVPN_SOCKS_PREFIX_CASE")
	if chosen == "" {
		t.Skip("captured separate prefix peer required")
	}
	parts := strings.Split(chosen, "/")
	if len(parts) != 3 {
		t.Fatal("uncaptured prefix case")
	}
	mode := parts[0]
	count, err := strconv.Atoi(parts[1])
	if err != nil || strconv.Itoa(count) != parts[1] || (count != 2 && count != 6) || (mode != "wg" && mode != "awg2-fast" && mode != "awg2-strong") {
		t.Fatal("uncaptured prefix inventory")
	}
	group, err := strconv.Atoi(parts[2])
	if err != nil || strconv.Itoa(group) != parts[2] || group < 0 || group >= (count+2)/2 {
		t.Fatal("uncaptured measurement group")
	}
	t.Run(strings.ReplaceAll(chosen, "/", "-"), func(t *testing.T) {
		peer := socksRunStartPeerPrefixes(t, mode, "", count)
		f, physical := socksRunNative(t, peer)
		if err := f.owner.Run(f.server); err != nil {
			t.Fatal("complete encrypted prefix proof", err)
		}
		var progress mobilemultihop.NodeChainProgress
		if !f.owner.Healthy() || json.Unmarshal([]byte(f.owner.ProgressJSON()), &progress) != nil || !progress.Ready || !progress.Complete || !progress.DNSProven || !progress.PublicProven || len(progress.Prefixes) != count+2 {
			t.Fatal("complete prefix/DNS/public proof absent")
		}
		_, meta, err := f.owner.source.ReadValidated()
		if err != nil || len(meta.Proofs) != count+2 || len(meta.Physical) != 1 {
			t.Fatal("original source inventory lost", err)
		}
		before := peer.observe(t)
		record := socksRunCounters(t, before)
		rows, ok := record["prefixes"].([]any)
		if !ok || len(rows) != count || physical.calls.Load() < 1 || before.DNS < 1 {
			t.Fatal("captured encrypted prefix observations absent")
		}
		for i, row := range rows {
			r := row.(map[string]any)
			if socksRunCounter(t, r, "raw_udp") < 1 || socksRunCounter(t, r, "proof_queries") < 2 {
				t.Fatal("unproved encrypted prefix", i)
			}
		}
		measurement, err := RouterNodeChainSOCKSNewHopMeasurement(f.owner, f.server)
		if err != nil {
			t.Fatal(err)
		}
		benchmark, err := RouterNodeChainSOCKSNewLatencyBenchmark(f.owner, f.server, measurement)
		if err != nil {
			t.Fatal(err)
		}
		startPosition, endPosition := group*2, group*2+2
		for i := startPosition; i < endPosition; i++ {
			proof := meta.Proofs[i]
			t.Logf("SOCKS_PREFIX_FIFTY position=%d phase=start", i)
			started := time.Now()
			start := peer.observe(t)
			request := fmt.Sprintf("%032x", i+1)
			if err := benchmark.Start(request, proof.ProfileID); err != nil {
				t.Fatal("captured prefix fifty admission", i, err)
			}
			deadline := time.Now().Add(hopmeasure.RequestTimeout + hopmeasure.ObservationTimeout)
			var status hopmeasure.Status
			for time.Now().Before(deadline) {
				if json.Unmarshal([]byte(benchmark.StatusJSON()), &status) != nil {
					t.Fatal("fifty status lost")
				}
				if status.Complete {
					break
				}
				time.Sleep(10 * time.Millisecond)
			}
			if err := benchmark.Drain(request); err != nil {
				t.Fatal(err)
			}
			var saved hopmeasure.OrderedLatencyReceipt
			if json.Unmarshal([]byte(benchmark.SavedJSON(proof.ProfileID)), &saved) != nil || saved.SourceSHA256 != meta.SourceSHA256 || saved.ConfigSHA256 != meta.ConfigSHA256 || saved.Position != i || saved.NodeID != proof.ProfileID || saved.Request != request || !saved.Result.Ready || saved.Result.Benchmark == nil || saved.Result.Benchmark.Attempts != 50 || saved.Result.Benchmark.Failed != 0 || saved.Result.Benchmark.Distribution == nil || saved.Result.Benchmark.Distribution.Samples != 50 {
				t.Fatalf("actual original fifty receipt absent position=%d status=%s saved=%s progress=%s", i, benchmark.StatusJSON(), benchmark.SavedJSON(proof.ProfileID), f.owner.ProgressJSON())
			}
			kind, metric := "private-node", "routed-private-response-including-connection"
			if i == count {
				kind, metric = "public-path", "routed-https-response-after-tls"
			}
			if saved.Result.Kind != kind || saved.Result.Benchmark.Measurement != metric {
				t.Fatal("prefix sample metric/position changed", i)
			}
			t.Logf("SOCKS_PREFIX_FIFTY position=%d phase=complete elapsed=%s", i, time.Since(started))
			end := peer.observe(t)
			if len(start.Samples) != count+2 || len(end.Samples) != count+2 {
				t.Fatal("original measured peer counters absent")
			}
			for j := range end.Samples {
				want := uint64(0)
				if i == j {
					want = 50
				}
				if end.Samples[j]-start.Samples[j] != want {
					t.Fatal("fifty bypassed original selected prefix", i, j, start.Samples, end.Samples)
				}
			}
		}
		if err := benchmark.Close(); err != nil {
			t.Fatal(err)
		}
		if err := measurement.Close(); err != nil {
			t.Fatal(err)
		}
		socksRunCloseNative(t, f)
		if err := peer.close(); err != nil {
			t.Fatal(err)
		}
	})
}

func TestRouterNodeChainSOCKSPrefixEncryptedRefusal(t *testing.T) {
	fault := os.Getenv("ROUTERVPN_SOCKS_PREFIX_REFUSAL")
	if fault == "" {
		t.Skip("captured separate long-prefix refusal required")
	}
	switch fault {
	case "middle-password", "final-token", "selected-dns", "middle-public", "hold-prefix":
	default:
		t.Fatal("foreign prefix refusal")
	}
	t.Run(fault, func(t *testing.T) {
		peer := socksRunStartPeerPrefixes(t, "wg", fault, 6)
		f, physical := socksRunNative(t, peer)
		if fault != "" {
			done := make(chan error, 1)
			go func() { done <- f.owner.Run(f.server) }()
			if fault == "hold-prefix" {
				deadline := time.Now().Add(3 * time.Second)
				held := false
				for time.Now().Before(deadline) {
					if peer.observe(t).HeldProofs > 0 {
						held = true
						break
					}
					time.Sleep(5 * time.Millisecond)
				}
				if !held {
					t.Fatal("cancel control missed real last packet-prefix private HTTP")
				}
				f.owner.NetworkChanged()
			}
			bound := 15 * time.Second
			if fault == "hold-prefix" {
				bound = hopmeasure.ObservationTimeout
			}
			select {
			case err := <-done:
				if err == nil {
					t.Fatal("wrong original encrypted proof was accepted", fault)
				}
			case <-time.After(bound):
				if fault == "hold-prefix" {
					t.Fatal("cancelled original proof did not join before observation deadline")
				}
				t.Fatal("failed original proof did not join")
			}
			if f.owner.Healthy() {
				t.Fatal("failed original proof remained Ready")
			}
			var progress mobilemultihop.NodeChainProgress
			_ = json.Unmarshal([]byte(f.owner.ProgressJSON()), &progress)
			if progress.Ready {
				t.Fatal("failed proof published ready progress")
			}
			observed := peer.observe(t)
			if physical.calls.Load() == 0 {
				t.Fatal("negative never reached original packet prefix")
			}
			if fault == "final-token" && observed.FinalAuth == 0 {
				t.Fatal("wrong final token missed actual private refusal")
			}
			if fault == "selected-dns" && observed.DNS == 0 {
				t.Fatal("wrong DNS missed actual full-prefix packet query")
			}
			if fault == "middle-password" && observed.MiddleAuth == 0 {
				t.Fatal("wrong password missed actual SOCKS authentication refusal")
			}
			socksRunCloseNative(t, f)
			if err := peer.close(); err != nil {
				t.Fatal(err)
			}
			return
		}
	})
}
