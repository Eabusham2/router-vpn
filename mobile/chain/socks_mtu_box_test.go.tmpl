func(f *socksMTUFixture)observe(ctx context.Context)error{
	if !f.current.Load(){return errors.New("original native source retired")}
	return ctx.Err()
}
type socksMTUPauseOwner struct{
	fixture *socksMTUFixture
	engine *RouterVPNNodeChainSOCKSEngine
	block chan struct{}
	entered chan struct{}
	pauseCalls atomic.Int32
	current atomic.Bool
}
func newSOCKSMTUPauseOwner(f *socksMTUFixture)*socksMTUPauseOwner{
	p:=&socksMTUPauseOwner{fixture:f,engine:f.engine};p.current.Store(true);return p
}
func(p *socksMTUPauseOwner)PauseSOCKSMTUContext(ctx context.Context,source *mobilemultihop.NodeChainSOCKSSource,engine *RouterVPNNodeChainSOCKSEngine)error{
	if source!=p.fixture.source||engine!=p.engine{return errors.New("foreign original proof pause")}
	p.pauseCalls.Add(1)
	if p.entered!=nil{select{case p.entered<-struct{}{}:default:}}
	if p.block!=nil{select{case<-p.block:case<-ctx.Done():return ctx.Err()}}
	return ctx.Err()
}
func(p *socksMTUPauseOwner)ObserveSOCKSMTUContext(ctx context.Context,source *mobilemultihop.NodeChainSOCKSSource)error{
	if source!=p.fixture.source||!p.current.Load(){return errors.New("foreign paused native owner")}
	return p.fixture.observe(ctx)
}
func socksMTUOperation(t *testing.T)(context.Context,context.CancelFunc){
	t.Helper();ctx,done,err:=mobilemtu.WithOperationContext(t.Context(),5*time.Second,3*time.Second)
	if err!=nil{t.Fatal(err)};t.Cleanup(done);return ctx,done
}
func socksMTUBegin(t *testing.T,f *socksMTUFixture)(context.Context,*socksMTUPauseOwner,*RouterVPNNodeChainSOCKSMTU){
	t.Helper();ctx,_:=socksMTUOperation(t);p:=newSOCKSMTUPauseOwner(f)
	m,err:=f.engine.BeginSOCKSMTUContext(ctx,p);if err!=nil{t.Fatal(err)}
	if err=m.PauseContext(ctx);err!=nil{t.Fatal(err)}
	return ctx,p,m
}
func socksMTUAcquire(f *socksMTUFixture,candidate,rollback *socksMTUReader,count *int)func(context.Context,adapter.Inbound,int)(*inbound.RouterVPNTunTransaction,error){
	return func(ctx context.Context,original adapter.Inbound,_ int)(*inbound.RouterVPNTunTransaction,error){
		(*count)++
		return f.box.inbound.RouterVPNReplaceTunOwned(ctx,original,func()(adapter.Inbound,adapter.Inbound,error){return candidate,rollback,nil})
	}
}
func TestRouterVPNNodeChainSOCKSMTUJoinedNativeReader(t *testing.T){
	for _,scenario:=range []string{"candidate","rollback","unchanged","pending-close"}{t.Run(scenario,func(t *testing.T){
		f:=newSOCKSMTUFixture(t);ctx,p,m:=socksMTUBegin(t,f)
		candidate,rollback:=socksMTUNewReader("candidate-socks-tun",73,1300),socksMTUNewReader("rollback-socks-tun",74,1280)
		candidate.startFailure.Store(scenario=="rollback");rollback.closeFailure.Store(scenario=="pending-close")
		acquired:=0;target:=1300;if scenario=="unchanged"{target=1280}
		value,err:=m.changeContext(ctx,f.tun,target,socksMTUAcquire(f,candidate,rollback,&acquired))
		if scenario=="pending-close"{
			if err==nil||value!=candidate||m.step==nil||m.step.joined||!m.RetainsCleanup(){t.Fatal("unjoined SOCKS MTU reader escaped its original operation",err)}
			if _,err=m.ResumeContext(ctx,f.observe);err==nil{t.Fatal("unjoined SOCKS MTU transaction authorized new proof")}
			if err=m.CloseContext(ctx);err==nil||!m.RetainsCleanup(){t.Fatal("failed SOCKS MTU retirement erased original cleanup",err)}
			rollback.closeFailure.Store(false)
			if err=m.PauseContext(ctx);err!=nil{t.Fatal(err)}
			value,err=m.changeContext(ctx,f.tun,target,socksMTUAcquire(f,candidate,rollback,&acquired))
		}
		if scenario=="rollback"{
			if err==nil||value!=rollback{t.Fatal("failed SOCKS MTU candidate lost actual rollback",err)}
		}else if err!=nil{t.Fatal(err)}
		want:=1;if scenario=="unchanged"{want=0}
		if acquired!=want||m.step==nil||!m.step.joined||m.Current()!=value{t.Fatal("SOCKS MTU retried acquisition or lost joined reader")}
		next,err:=m.ResumeContext(ctx,f.observe);if err!=nil||next==nil{t.Fatal("exact joined reader could not resume proof",err)}
		p.engine=next
		if _,err=next.ObserveChainContext(ctx);err!=nil{t.Fatal(err)}
		if _,err=f.engine.ObserveChainContext(ctx);err==nil{t.Fatal("old SOCKS proof engine survived reader handoff")}
		if err=m.FinishContext(ctx);err!=nil||m.RetainsCleanup(){t.Fatal("joined current operation did not detach",err)}
		if _,err=next.ObserveChainContext(ctx);err!=nil{t.Fatal("finished native receipt invalidated current proof",err)}
		if _,err=f.box.RouterVPNNewNodeChainSOCKSEngine(ctx,f.source,strings.Repeat("e",64),f.observe); scenario!="rollback"&&scenario!="unchanged"&&err==nil{
			t.Fatal("initial constructor admitted changed MTU without continuation")
		}
	})}
}
func TestRouterVPNNodeChainSOCKSMTUHeldPauseAndForeignCaller(t *testing.T){
	f:=newSOCKSMTUFixture(t);ctx,_:=socksMTUOperation(t);p:=newSOCKSMTUPauseOwner(f)
	p.block,p.entered=make(chan struct{}),make(chan struct{},1)
	m,err:=f.engine.BeginSOCKSMTUContext(ctx,p);if err!=nil{t.Fatal(err)}
	if _,err=f.engine.observation.ObserveChainContext(ctx);err==nil{t.Fatal("nested original proof observation escaped its MTU pause")}
	var releaseOnce sync.Once
	unblock:=func(){releaseOnce.Do(func(){close(p.block)})}
	joined:=make(chan struct{})
	var pauseErr error
	go func(){pauseErr=m.PauseContext(ctx);close(joined)}()
	t.Cleanup(func(){
		unblock()
		cleanup,stop:=context.WithTimeout(context.Background(),2*time.Second);defer stop()
		select{case<-joined:case<-cleanup.Done():t.Error("original held SOCKS proof callback did not join");return}
		if m.RetainsCleanup(){if err:=m.RetireContext(cleanup,p);err!=nil{t.Error("original held SOCKS proof cleanup did not join",err)}}
	})
	// Admission to the held callback is causal evidence. A short timeout
	// spent in unrelated native observation cannot substitute for this join.
	select{
	case<-p.entered:
	case<-joined:
		t.Fatal("held original SOCKS proof pause released its MTU owner",pauseErr)
	case<-ctx.Done():
		t.Fatal("held original SOCKS proof pause released its MTU owner",ctx.Err())
	}
	short,stop:=context.WithTimeout(ctx,15*time.Millisecond);err=m.PauseContext(short);stop()
	if !errors.Is(err,context.DeadlineExceeded)||!m.RetainsCleanup(){t.Fatal("held original SOCKS proof pause released its MTU owner",err)}
	short,stop=context.WithTimeout(ctx,15*time.Millisecond)
	_,err=m.ChangeContext(short,f.tun,1300);stop()
	if !errors.Is(err,context.DeadlineExceeded)||m.Current()!=f.tun{t.Fatal("unjoined original proof allowed native mutation",err)}
	if _,err=f.engine.BeginSOCKSMTUContext(ctx,p);err==nil{t.Fatal("same original engine admitted a second MTU owner")}
	unblock()
	select{case<-joined:case<-ctx.Done():t.Fatal("original held SOCKS proof callback did not join",ctx.Err())}
	if pauseErr!=nil{t.Fatal(pauseErr)}
	if err=m.PauseContext(ctx);err!=nil{t.Fatal(err)}
	foreign,_:=socksMTUOperation(t)
	if err=m.PauseContext(foreign);err==nil{t.Fatal("foreign MTU operation joined original proof")}
	if err=m.CloseContext(ctx);err!=nil||m.RetainsCleanup(){t.Fatal("joined exact pause could not retire",err)}
}
func TestRouterVPNNodeChainSOCKSMTUResumeKeepsNativeReadback(t *testing.T){
	for _,fault:=range []string{"name","index","mtu","source","network","caller"}{t.Run(fault,func(t *testing.T){
		f:=newSOCKSMTUFixture(t);ctx,p,m:=socksMTUBegin(t,f)
		if _,err:=m.ChangeContext(ctx,f.tun,1280);err!=nil{t.Fatal(err)}
		switch fault{
		case "name":f.tun.name="foreign"
		case "index":f.tun.index++
		case "mtu":f.tun.mtu++
		case "source":p.current.Store(false)
		case "network":monitor:=chainNativeField[tun.DefaultInterfaceMonitor](t,f.box.network,"interfaceMonitor");*monitor=&chainNativeMonitor{physical:&control.Interface{Name:"foreign",Index:99}}
		case "caller":cancelled,stop:=context.WithCancel(ctx);stop();ctx=cancelled
		}
		if _,err:=m.ResumeContext(ctx,f.observe);err==nil{t.Fatal("changed original SOCKS reader or owner admitted resume",fault)}
		if !m.RetainsCleanup(){t.Fatal("rejected SOCKS resume dropped its cleanup owner")}
		// No new native reader was acquired by this test; explicit teardown
		// remains the original fixture manager's responsibility.
	})}
}
func TestRouterVPNNodeChainSOCKSMTUCleanupRestoresOnlyOriginalValue(t *testing.T){
	f:=newSOCKSMTUFixture(t);ctx,p,m:=socksMTUBegin(t,f)
	candidate,rollback:=socksMTUNewReader("candidate",73,1300),socksMTUNewReader("rollback",74,1280)
	acquired:=0
	if _,err:=m.changeContext(ctx,f.tun,1300,socksMTUAcquire(f,candidate,rollback,&acquired));err!=nil{t.Fatal(err)}
	cleanup,err:=mobilemtu.OperationCleanupContext(ctx);if err!=nil{t.Fatal(err)}
	if _,err=m.ResumeContext(cleanup,f.observe);err==nil{t.Fatal("cleanup context resumed unrestored SOCKS probe")}
	if _,err=m.ChangeContext(cleanup,candidate,1320);err==nil{t.Fatal("cleanup context acquired another SOCKS MTU probe")}
	restored,backup:=socksMTUNewReader("restored",75,1280),socksMTUNewReader("retained-probe",76,1300)
	if _,err=m.changeContext(cleanup,candidate,1280,socksMTUAcquire(f,restored,backup,&acquired));err!=nil{t.Fatal(err)}
	next,err:=m.ResumeContext(cleanup,f.observe);if err!=nil{t.Fatal("exact original native MTU could not restore",err)}
	p.engine=next
	if err=m.FinishContext(cleanup);err!=nil{t.Fatal(err)}
	if acquired!=2{t.Fatal("cleanup repeated native acquisition")}
}

func TestRouterVPNNodeChainSOCKSMTULateOriginalResultRetainsReader(t *testing.T){
	f:=newSOCKSMTUFixture(t);ctx,p,m:=socksMTUBegin(t,f)
	candidate,rollback:=socksMTUNewReader("late-candidate",73,1300),socksMTUNewReader("late-backup",74,1280)
	child,cancel:=context.WithCancel(ctx);defer cancel()
	acquired:=0
	acquire:=socksMTUAcquire(f,candidate,rollback,&acquired)
	value,err:=m.changeContext(child,f.tun,1300,func(call context.Context,original adapter.Inbound,target int)(*inbound.RouterVPNTunTransaction,error){
		receipt,failure:=acquire(call,original,target)
		cancel()
		return receipt,errors.Join(failure,call.Err())
	})
	if err==nil||value!=candidate||m.Current()!=candidate||m.step==nil||m.step.transaction==nil||m.step.joined{
		t.Fatal("late original SOCKS MTU result lost partial reader authority",err)
	}
	cleanup,err:=mobilemtu.OperationCleanupContext(child);if err!=nil{t.Fatal(err)}
	restored,backup:=socksMTUNewReader("late-restored",75,1280),socksMTUNewReader("late-probe",76,1300)
	if _,err=m.changeContext(cleanup,candidate,1280,socksMTUAcquire(f,restored,backup,&acquired));err!=nil{t.Fatal(err)}
	next,err:=m.ResumeContext(cleanup,f.observe);if err!=nil{t.Fatal(err)}
	p.engine=next
	if err=m.FinishContext(cleanup);err!=nil||acquired!=2{t.Fatal("late original receipt did not restore exactly once",err)}
}
func TestRouterVPNNodeChainSOCKSMTUManagerAndLockRemainOwned(t *testing.T){
	f:=newSOCKSMTUFixture(t);ctx,_,m:=socksMTUBegin(t,f)
	if _,err:=m.ChangeContext(ctx,f.tun,1280);err!=nil{t.Fatal(err)}
	m.mu.Lock()
	short,stop:=context.WithTimeout(ctx,15*time.Millisecond)
	_,err:=m.ChangeContext(short,f.tun,1300)
	stop();m.mu.Unlock()
	if !errors.Is(err,context.DeadlineExceeded){t.Fatal("held SOCKS MTU owner ignored caller deadline",err)}
	old:=f.box.inbound
	f.box.inbound=inbound.NewManager(log.NewNOPFactory().Logger(),inbound.NewRegistry(),f.box.endpoint)
	if _,err=m.ResumeContext(ctx,f.observe);err==nil{t.Fatal("foreign native manager adopted original SOCKS MTU receipt")}
	if err=m.CloseContext(ctx);err!=nil{t.Fatal("original cleanup followed substituted native manager",err)}
	f.box.inbound=old
}

func TestRouterVPNNodeChainSOCKSMTURetirementAfterWorkCannotRenewAuthority(t *testing.T){
 f:=newSOCKSMTUFixture(t)
 operation,finish:=socksMTUOperation(t)
 original:=newSOCKSMTUPauseOwner(f)
 retained,err:=f.engine.BeginSOCKSMTUContext(operation,original);if err!=nil{t.Fatal(err)}
 finish()
 call,cancel:=context.WithTimeout(t.Context(),time.Second);defer cancel()
 if err=retained.PauseContext(call);err==nil{t.Fatal("expired SOCKS MTU operation regained proof-pause authority")}
 if _,err=retained.ChangeContext(call,f.tun,1300);err==nil{t.Fatal("expired SOCKS MTU operation regained mutation authority")}
 if _,err=retained.ResumeContext(call,f.observe);err==nil{t.Fatal("expired SOCKS MTU operation regained proof authority")}
 if err=retained.FinishContext(call);err==nil{t.Fatal("expired SOCKS MTU operation published a winner")}
 foreign:=newSOCKSMTUPauseOwner(f)
 if err=retained.RetireContext(call,foreign);err==nil{t.Fatal("replacement SOCKS MTU owner retired original handles")}
 if original.pauseCalls.Load()!=0{t.Fatal("foreign cleanup reached original proof join")}
 if err=retained.RetireContext(call,original);err!=nil||retained.RetainsCleanup(){t.Fatal("original expired operation could not join retained handles",err)}
 if original.pauseCalls.Load()!=1{t.Fatal("retirement did not join original proof exactly once")}
 if err=retained.RetireContext(call,original);err!=nil||original.pauseCalls.Load()!=1{t.Fatal("joined retirement reacquired original work",err)}
}
func TestRouterVPNNodeChainSOCKSMTURetirementRetainsFailedJoin(t *testing.T){
 f:=newSOCKSMTUFixture(t)
 operation,finish:=socksMTUOperation(t)
 original:=newSOCKSMTUPauseOwner(f);original.block=make(chan struct{})
 retained,err:=f.engine.BeginSOCKSMTUContext(operation,original);if err!=nil{t.Fatal(err)}
 finish()
