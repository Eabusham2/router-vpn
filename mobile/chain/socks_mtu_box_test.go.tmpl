	read:=func(chain *mobilemultihop.NodeChain) mobilemultihop.NodeChainSource {
		raw,err:=chain.LaunchInput();if err!=nil{t.Fatal(err)}
		var source mobilemultihop.NodeChainSource
		if err=json.Unmarshal([]byte(raw),&source);err!=nil{t.Fatal(err)}
		return source
	}
	source:=read(chainNativeSourceModes(t,[]string{"wg","wg"}))
	identities:=read(chainNativeSourceModes(t,[]string{"wg","wg","wg"}))
	files:=func(input string)string{
		var node struct{ Files string `json:"files"` }
		if err:=json.Unmarshal([]byte(input),&node);err!=nil||node.Files==""{t.Fatal("original MTU identity missing",err)}
		return node.Files
	}
	graph:=map[string]any{
		"inbounds":[]any{map[string]any{"type":"tun","tag":"tun-in","interface_name":"router-vpn","address":[]string{"172.29.91.1/30","fd29:91::1/126"},"mtu":1280,"auto_route":true,"strict_route":true,"stack":"system"}},
		"outbounds":[]any{map[string]any{"type":"socks","tag":"custom-exit","server":"203.0.113.20","server_port":1080,"version":"5","username":"original-user","password":"original-password"}},
		"route":map[string]any{"rules":[]any{},"final":"custom-exit","auto_detect_interface":true},
	}
	profile:=map[string]any{"id":"original-mtu-middle","node_kind":"external","dns_mode":"home","mtu_policy":"auto","kill_switch_policy":"always","ipv6_mode":"off","home_lan_access":false,
		"external":map[string]any{"protocol":"socks5","expected_public_ip":"203.0.113.88","socks5":map[string]any{"host":"203.0.113.20","port":1080,"username":"original-user","password":"original-password"}}}
	captured:=map[string]any{"schema":1,"exit_id":"original-mtu-middle","protocol":"socks5","expected_public_ip":"203.0.113.88","profile":profile}
	middle,err:=mobilemultihop.NodeChainImportedSOCKSMemberInput(chainNativeJSON(t,graph),chainNativeJSON(t,captured))
