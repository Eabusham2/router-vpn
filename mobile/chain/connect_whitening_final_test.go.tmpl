package routervpnwhitening

import (
	"bytes"
	"context"
	"encoding/base64"
	"errors"
	"net"
	"testing"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/startwhitening"
	"github.com/sagernet/sing-box/option"
	M "github.com/sagernet/sing/common/metadata"
)

type connectFinalClosedDialer struct{ identity byte }

func (*connectFinalClosedDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
	return nil, errors.New("component has no network authority")
}
func (*connectFinalClosedDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
	return nil, errors.New("component has no packet authority")
}

// Actual native AES method/UoT/whitening objects are constructed here. The
// deliberately closed lower dialer makes this only an ownership component;
// the separate encrypted fixture establishes protocol traffic and retirement.
func TestCONNECTWhiteningFinalReadbackKeepsActualNativeOwners(t *testing.T) {
	for _, fault := range []string{"original", "owner", "method", "dialer", "key", "server", "uot-client", "uot-version", "uot-dialer", "reset", "close", "cancel", "wrong-options-key", "wrong-options-uot"} {
		t.Run(fault, func(t *testing.T) {
			ctx, cancel := context.WithCancel(t.Context())
			defer cancel()
			options := Options{ServerOptions: option.ServerOptions{Server: "203.0.113.25", ServerPort: 8388}, Method: startwhitening.Method,
				Password: base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, 32)), UDPOverTCP: &option.UDPOverTCPOptions{Enabled: true, Version: 2}}
			h, err := newOutbound(ctx, "captured-final", options, new(connectFinalClosedDialer))
			if err != nil {
				t.Fatal(err)
			}
			originalOwner := h.owner
			defer originalOwner.Close()
			read, err := h.RouterVPNCONNECTFinalReadback(options)
			if err != nil || read(ctx) != nil {
				t.Fatal("original concrete final was not captured", err)
			}
			switch fault {
			case "owner":
				h.owner = startwhitening.NewOwner(ctx)
				defer h.owner.Close()
			case "method":
				other, err := newOutbound(ctx, "other-final", options, new(connectFinalClosedDialer))
				if err != nil {
					t.Fatal(err)
				}
				defer other.Close()
				h.method = other.method
			case "dialer":
				h.dialer = new(connectFinalClosedDialer)
			case "key":
				h.key[0] ^= 1
			case "server":
				h.server.Port++
			case "uot-client":
				copied := *h.uotClient
				h.uotClient = &copied
			case "uot-version":
				h.uotClient.Version = 1
			case "uot-dialer":
				h.uotClient.Dialer = new(connectFinalClosedDialer)
			case "reset":
				h.owner.Reset()
			case "close":
				if err := h.Close(); err != nil {
					t.Fatal(err)
				}
			case "cancel":
				cancel()
			case "wrong-options-key":
				options.Password = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{74}, 32))
				if _, err := h.RouterVPNCONNECTFinalReadback(options); err == nil {
					t.Fatal("foreign key acquired native final capture")
				}
				return
			case "wrong-options-uot":
				options.UDPOverTCP = &option.UDPOverTCPOptions{Enabled: true, Version: 1}
				if _, err := h.RouterVPNCONNECTFinalReadback(options); err == nil {
					t.Fatal("foreign UoT version acquired native final capture")
				}
				return
			}
			if (read(t.Context()) == nil) != (fault == "original") {
				t.Fatal("replaced final acquired original native readback", fault)
			}
			if fault == "original" {
				call, stop := context.WithCancel(t.Context())
				stop()
				if read(call) == nil {
					t.Fatal("cancelled caller acquired native final readback")
				}
			}
		})
	}
}
