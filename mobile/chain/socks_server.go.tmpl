package libbox

import (
	"context"
	"errors"
	"reflect"

	box "github.com/sagernet/sing-box"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/adapter/outbound"
	"github.com/sagernet/sing-box/daemon"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/include"
	"github.com/sagernet/sing-box/option"
	ownedSOCKS "github.com/sagernet/sing-box/protocol/routervpnnodesocks"
	"github.com/sagernet/sing/service"
)

type routerNodeSOCKSServerKey struct{}
type routerNodeSOCKSServerOwner struct {
	source *mobilemultihop.NodeChainSOCKSSource
	capture *ownedSOCKS.Capture
	config string
	metadata mobilemultihop.NodeChainSOCKSSourceMetadata
	registry *outbound.Registry
	server *CommandServer
	started *daemon.StartedService
}

// Only the typed plan can request this private construction. Stock callers
// retain NewCommandServer and its unmodified ordinary registries.
func newRouterNodeSOCKSCommandServer(handler CommandServerHandler, platform PlatformInterface,
	source *mobilemultihop.NodeChainSOCKSSource) (*CommandServer, error) {
	if handler == nil || platform == nil || source == nil {
		return nil, errors.New("ordered SOCKS server needs its original source and platform")
	}
	config, metadata, err := source.ReadValidated()
	if err != nil {
		return nil, err
	}
	ctx := baseContext(platform)
	capture, err := ownedSOCKS.NewCapture(ctx, source)
	if err != nil {
		return nil, err
	}
	registry := include.OutboundRegistry()
	if err = capture.Register(registry); err != nil {
		return nil, err
	}
	ctx = capture.Context()
	// box.Context preserves existing registries. Both parsing and native
	// construction must instead refer to this one new caller-local registry.
	ctx = service.ContextWith[option.OutboundOptionsRegistry](ctx, registry)
	ctx = service.ContextWith[adapter.OutboundRegistry](ctx, registry)
	ctx, err = box.RouterVPNNodeSOCKSContext(ctx, source, capture)
	if err != nil {
		return nil, err
	}
	owner := &routerNodeSOCKSServerOwner{
		source: source, capture: capture, config: config, metadata: metadata, registry: registry,
	}
	ctx = context.WithValue(ctx, routerNodeSOCKSServerKey{}, owner)
	// The original constructor body is infallible. Every new guard above
	// runs before acquisition, so gomobile can never hide a partial server
	// behind an error result. The host retains this result, then BindNative.
	server := newCommandServerWithContext(handler, platform, ctx)
	owner.server, owner.started = server, server.StartedService
	return server, nil
}

func requireRouterNodeSOCKSServer(ctx context.Context, server *CommandServer,
	source *mobilemultihop.NodeChainSOCKSSource) error {
	if ctx == nil || ctx.Err() != nil || server == nil || server.ctx == nil ||
		server.ctx.Err() != nil || server.StartedService == nil || source == nil {
		return errors.New("ordered SOCKS server lost its original caller or native owner")
	}
	owner, ok := server.ctx.Value(routerNodeSOCKSServerKey{}).(*routerNodeSOCKSServerOwner)
	if !ok || owner == nil || owner.source != source || owner.server != server ||
		owner.started != server.StartedService || owner.capture == nil ||
		service.FromContext[adapter.OutboundRegistry](server.ctx) != owner.registry ||
		service.FromContext[option.OutboundOptionsRegistry](server.ctx) != owner.registry {
		return errors.New("ordered SOCKS server has a foreign source, registry or native service")
	}
	if err := owner.capture.RequireOriginalContext(server.ctx, source); err != nil {
		return err
	}
	config, metadata, err := source.ReadValidated()
	if err != nil || config != owner.config || !reflect.DeepEqual(metadata, owner.metadata) {
		return errors.New("ordered SOCKS server source changed after original capture")
	}
	if err := server.ctx.Err(); err != nil {
		return err
	}
	return ctx.Err()
}
