// These native component cases execute the real Box owner, manager transaction,
// gate, selector and ingress. Shared pause issuance and privileged OS readback
// are explicit boundaries: the shared suite exercises the real pause issuer;
// these fixtures install its closed capsule and substitute native TUN readback.
// Public shipping entry points still reject every fixture TUN as non-native.
func executionMTUSet(t *testing.T, value reflect.Value, name string, input any) {
	t.Helper()
	field := value.Elem().FieldByName(name)
	if !field.IsValid() || !field.CanAddr() {
		t.Fatal("closed pause fixture field changed", name)
	}
	source := reflect.ValueOf(input)
	if !source.Type().AssignableTo(field.Type()) {
		t.Fatal("closed pause fixture type changed", name)
	}
	reflect.NewAt(field.Type(), unsafe.Pointer(field.UnsafeAddr())).Elem().Set(source)
}

func executionMTUBinding(t *testing.T, f *executionNativeFixture, p *mobilemultihop.NodeChainExecutionProjection) mobilemultihop.NodeChainExecutionMTUResumeBinding {
	t.Helper()
	r, err := mobilemultihop.NewNodeChainExecutionRuntime(p, f.engine)
	if err != nil {
		t.Fatal(err)
	}
	var binding mobilemultihop.NodeChainExecutionMTUResumeBinding
	slot := reflect.ValueOf(&binding).Elem().FieldByName("state")
	state := reflect.New(slot.Type().Elem())
	identity, err := f.engine.ObserveChainContext(t.Context())
	if err != nil {
		t.Fatal(err)
	}
	execution := "local"
	if f.engine.selector.Now() == f.engine.state.Load().server.Tag() {
		execution = "server"
	}
	for name, value := range map[string]any{"owner": r, "projection": p, "engine": f.engine, "identity": identity,
		"nonce": strings.Repeat("7", 64), "execution": execution, "selectedTag": f.engine.selector.Now(),
		"selectionEpoch": f.engine.selector.RouterVPNNodeChainSelectionEpoch(), "tunTag": "routervpn-chain-tun",
		"result": routechoice.Result{Target: mobilemultihop.Targets[0], Winner: &routechoice.Candidate{Execution: routechoice.Execution(execution), Transport: "ordered", EntryID: "entry", ExitID: "exit"}}} {
		executionMTUSet(t, state, name, value)
	}
	executionMTUSet(t, reflect.ValueOf(r), "identity", identity)
	executionMTUSet(t, reflect.ValueOf(r), "closed", true)
	field := reflect.ValueOf(r).Elem().FieldByName("mtuPause")
	reflect.NewAt(field.Type(), unsafe.Pointer(field.UnsafeAddr())).Elem().Set(state)
	reflect.NewAt(slot.Type(), unsafe.Pointer(slot.UnsafeAddr())).Elem().Set(state)
	if err := binding.ValidateTransitionContext(t.Context()); err != nil {
		t.Fatal("closed shared boundary fixture", err)
	}
	return binding
}

type executionMTUNativeReader struct {
	adapter.Inbound
	failClose, failStart atomic.Bool
}

func (r *executionMTUNativeReader) Close() error {
	if r.failClose.Load() {
		return errors.New("original native reader close remains pending")
	}
	return nil
}
func (r *executionMTUNativeReader) Start(stage adapter.StartStage) error {
	if r.failStart.Load() {
		return errors.New("candidate native reader failed startup")
	}
	return r.Inbound.Start(stage)
}
func executionMTUReader() *executionMTUNativeReader {
	return &executionMTUNativeReader{Inbound: &chainNativeTUN{inbound.NewAdapter(C.TypeTun, "routervpn-chain-tun")}}
}

func TestRouterVPNExecutionNativeMTUUsesJoinedReader(t *testing.T) {
	for _, scenario := range []string{"candidate", "rollback", "unchanged", "pending-close"} {
		t.Run(scenario, func(t *testing.T) {
			f := newExecutionNativeFixture(t, "server", nil)
			p := f.adopt(t)
			e := f.engine
			for _, stage := range adapter.ListStartStages {
				if err := f.box.inbound.Start(stage); err != nil {
					t.Fatal(err)
				}
			}
			binding := executionMTUBinding(t, f, p)
			before := e.reader.Load()
			candidate, rollback := executionMTUReader(), executionMTUReader()
			candidate.failStart.Store(scenario == "rollback")
			rollback.failClose.Store(scenario == "pending-close")
			readbacks := map[adapter.Inbound]routerVPNExecutionMTUReadback{before.inbound: {"original", 11, 1400}, candidate: {"candidate", 12, 1300}, rollback: {"rollback", 13, 1400}}
			read := func(ctx context.Context, r adapter.Inbound) (routerVPNExecutionMTUReadback, error) {
				value, ok := readbacks[r]
				if !ok {
					return value, errRouterVPNExecutionOwner
				}
				return value, ctx.Err()
			}
			var acquisitions int
			acquire := func(ctx context.Context, r adapter.Inbound, mtu int) (*inbound.RouterVPNTunTransaction, error) {
				acquisitions++
				return f.box.inbound.RouterVPNReplaceTunOwned(ctx, r, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
			}
			value := 1300
			if scenario == "unchanged" {
				value = 1400
			}
			result, err := e.changeExecutionMTUContext(t.Context(), binding, before.inbound, value, acquire, read)
			if scenario == "pending-close" {
				if err == nil || result != candidate || e.mtu.Load() == nil || e.mtu.Load().joined || e.reader.Load() != before {
					t.Fatal("unjoined native replacement escaped its original owner", err)
				}
				if err := e.admitExecutionMTUContext(t.Context(), binding, read); err == nil {
					t.Fatal("unjoined replacement admitted resume")
				}
				rollback.failClose.Store(false)
				result, err = e.changeExecutionMTUContext(t.Context(), binding, before.inbound, value, acquire, read)
			}
			if scenario == "rollback" {
				if err == nil || result != rollback {
					t.Fatal("failed candidate did not retain actual rollback", err)
				}
			} else if err != nil {
				t.Fatal(err)
			}
			op := e.mtu.Load()
			if op == nil || !op.joined || op.result == nil || op.result.inbound != result || e.reader.Load() != op.result || op.result.ingress.Current(t.Context()) != nil {
				t.Fatal("native transaction did not retain its exact joined reader")
			}
			expectedAcquisitions := 1
			if scenario == "unchanged" {
				expectedAcquisitions = 0
			}
			if acquisitions != expectedAcquisitions {
				t.Fatal("native retry reacquired another TUN", acquisitions)
			}
			if err := e.admitExecutionMTUContext(t.Context(), binding, read); err != nil {
				t.Fatal("joined native readback did not admit proof", err)
			}
			if err := e.admitExecutionMTUContext(t.Context(), binding, read); err != nil {
				t.Fatal("same receipt admission was not idempotent", err)
			}
			if err := e.SelectContext(t.Context(), binding.SelectedTag()); err != nil {
				t.Fatal(err)
			}
			other := e.state.Load().local.Tag()
			if other == binding.SelectedTag() {
				other = e.state.Load().server.Tag()
			}
			if err := e.SelectContext(t.Context(), other); err == nil {
				t.Fatal("MTU resume reselected another execution")
			}
			open, err := e.ApplicationOpenContext(t.Context())
			if err != nil || open {
				t.Fatal("MTU proof admission opened traffic", err)
			}
			if e.instance != f.box || e.entry != f.prefixes[f.prep.ProofInventory()[0].Tag] || e.resolver != f.dns {
				t.Fatal("MTU replaced original physical or DNS graph")
			}
			if err := e.AdmitExecutionMTUResumeContext(t.Context(), binding); err == nil {
				t.Fatal("public native readback accepted a component TUN double")
			}
		})
	}
}

func TestRouterVPNExecutionNativeMTURejectsChangedOwnership(t *testing.T) {
	for _, scenario := range []string{"zero-binding", "foreign-identity", "foreign-engine", "foreign-selector", "open-gate", "retired-source", "invalid-fixed", "above-bound", "cancelled", "foreign-reader"} {
		t.Run(scenario, func(t *testing.T) {
			f := newExecutionNativeFixture(t, "server", nil)
			p := f.adopt(t)
			e := f.engine
			binding := executionMTUBinding(t, f, p)
			expected := e.reader.Load().inbound
			value := 1300
			ctx, cancel := context.WithCancel(t.Context())
			defer cancel()
			switch scenario {
			case "zero-binding":
				binding = mobilemultihop.NodeChainExecutionMTUResumeBinding{}
			case "foreign-identity":
				other := newExecutionNativeFixture(t, "server", nil)
				projection := other.adopt(t)
				binding = executionMTUBinding(t, other, projection)
			case "foreign-engine":
				// Equal identity and delegated observations do not grant another
				// engine the original runtime's opaque native mutation authority.
				foreign := &struct {
					mobilemultihop.NodeChainExecutionEngine
				}{e}
				state := reflect.ValueOf(&binding).Elem().FieldByName("state")
				executionMTUSet(t, state, "engine", foreign)
				if err := binding.ValidateTransitionContext(ctx); err != nil {
					t.Fatal("foreign engine fixture lost its equal closed identity", err)
				}
			case "foreign-selector":
				if !e.selector.SelectOutbound(e.state.Load().local.Tag()) {
					t.Fatal("foreign selector fixture")
				}
			case "open-gate":
				if err := e.OpenApplicationContext(ctx, binding.Identity(), binding.SelectedTag()); err != nil {
					t.Fatal(err)
				}
			case "retired-source":
				f.current.Store(false)
			case "invalid-fixed":
				value = 1279
			case "above-bound":
				bound, err := binding.MTUPlan()
				if err != nil {
					t.Fatal(err)
				}
				value = bound.Ceiling + 1
			case "cancelled":
				cancel()
			case "foreign-reader":
				expected = executionMTUReader()
			}
			var acquired bool
			acquire := func(context.Context, adapter.Inbound, int) (*inbound.RouterVPNTunTransaction, error) {
				acquired = true
				return nil, errors.New("unexpected native acquisition")
			}
			read := func(context.Context, adapter.Inbound) (routerVPNExecutionMTUReadback, error) {
				return routerVPNExecutionMTUReadback{"fixture", 1, 1400}, nil
			}
			if _, err := e.changeExecutionMTUContext(ctx, binding, expected, value, acquire, read); err == nil || acquired || e.mtu.Load() != nil {
				t.Fatal("changed ownership acquired native MTU transaction", err, acquired)
			}
		})
	}
}

func TestRouterVPNExecutionNativeMTUReadbackAndRetirementRemainOwned(t *testing.T) {
	f := newExecutionNativeFixture(t, "server", nil)
	p := f.adopt(t)
	e := f.engine
	for _, stage := range adapter.ListStartStages {
		if err := f.box.inbound.Start(stage); err != nil {
			t.Fatal(err)
		}
	}
	binding := executionMTUBinding(t, f, p)
	before := e.reader.Load()
	candidate, rollback := executionMTUReader(), executionMTUReader()
	rollback.failClose.Store(true)
	acquire := func(ctx context.Context, r adapter.Inbound, _ int) (*inbound.RouterVPNTunTransaction, error) {
		return f.box.inbound.RouterVPNReplaceTunOwned(ctx, r, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
	}
	read := func(ctx context.Context, r adapter.Inbound) (routerVPNExecutionMTUReadback, error) {
		if r == before.inbound {
			return routerVPNExecutionMTUReadback{"original", 1, 1400}, ctx.Err()
		}
		return routerVPNExecutionMTUReadback{"candidate", 2, 1300}, ctx.Err()
	}
	if _, err := e.changeExecutionMTUContext(t.Context(), binding, before.inbound, 1300, acquire, read); err == nil {
		t.Fatal("pending close accepted")
	}
	f.current.Store(false)
	if err := e.RetireContext(t.Context()); err == nil {
		t.Fatal("retired source abandoned original unused reader")
	}
	rollback.failClose.Store(false)
	if err := e.RetireContext(t.Context()); err != nil {
		t.Fatal("exact pending native cleanup did not join after source retirement", err)
	}
	if e.state.Load().stage != 3 || e.mtu.Load() == nil {
		t.Fatal("native retirement discarded history or kept forwarding state")
	}
}

func TestRouterVPNExecutionNativeMTURetainsUnchangedPause(t *testing.T) {
	for _, scenario := range []string{"work", "cancelled-work-cleanup", "repeat"} {
		t.Run(scenario, func(t *testing.T) {
			f := newExecutionNativeFixture(t, "server", nil)
			p := f.adopt(t)
			e := f.engine
			binding := executionMTUBinding(t, f, p)
			before := e.reader.Load()
			work, cancelWork := context.WithCancel(t.Context())
			defer cancelWork()
			ctx, finish, err := mobilemtu.WithOperationContext(work, time.Second, time.Second)
			if err != nil {
				t.Fatal(err)
			}
			defer finish()
			if scenario == "cancelled-work-cleanup" {
				cancelWork()
				ctx, err = mobilemtu.OperationCleanupContext(ctx)
				if err != nil {
					t.Fatal(err)
				}
			}
			var observations int
			read := func(call context.Context, reader adapter.Inbound) (routerVPNExecutionMTUReadback, error) {
				observations++
				if reader != before.inbound || !mobilemtu.SameOperationContext(call, ctx) {
					t.Fatal("unchanged cleanup replaced the original reader or operation")
				}
				return routerVPNExecutionMTUReadback{"original", 11, 1400}, call.Err()
			}
			attempts := 1
			if scenario == "repeat" {
				attempts = 2
			}
			for i := 0; i < attempts; i++ {
				if err := e.retainUnchangedExecutionMTUContext(ctx, binding, before.inbound, 1400, read); err != nil {
					t.Fatal("original unchanged pause could not retain its reader", err)
				}
				op := e.mtu.Load()
				if op == nil || !op.joined || op.admitted || op.transaction != nil || op.before != before || op.result != before || e.reader.Load() != before || op.binding.Nonce() != binding.Nonce() || op.observed.mtu != 1400 {
					t.Fatal("unchanged pause acquired or substituted a native transaction")
				}
			}
			if observations != 2*attempts {
				t.Fatal("unchanged pause lacked two actual readbacks", observations)
			}
			retained := e.mtu.Load()
			if err := e.RetainUnchangedExecutionMTUContext(ctx, binding, before.inbound, 1400); err == nil || e.mtu.Load() != retained {
				t.Fatal("public unchanged pause accepted a component TUN double")
			}
			if err := e.admitExecutionMTUContext(ctx, binding, read); err != nil {
				t.Fatal("unchanged receipt failed selected-only proof admission", err)
			}
			if open, err := e.ApplicationOpenContext(ctx); err != nil || open {
				t.Fatal("unchanged pause opened application traffic", err)
			}
		})
	}
}

func TestRouterVPNExecutionNativeMTURejectsUnchangedSubstitution(t *testing.T) {
	for _, scenario := range []string{"zero-binding", "foreign-engine", "foreign-reader", "actual-value", "second-read", "read-error", "pending-previous", "foreign-previous", "no-operation", "unbounded", "cancelled", "retired-source", "open-gate", "reader-during-read"} {
		t.Run(scenario, func(t *testing.T) {
			f := newExecutionNativeFixture(t, "server", nil)
			p := f.adopt(t)
			e := f.engine
			binding := executionMTUBinding(t, f, p)
			before := e.reader.Load()
			expected := before.inbound
			ctx, finish, err := mobilemtu.WithOperationContext(t.Context(), time.Second, time.Second)
			if err != nil {
				t.Fatal(err)
			}
			defer finish()
			switch scenario {
			case "zero-binding":
				binding = mobilemultihop.NodeChainExecutionMTUResumeBinding{}
			case "foreign-engine":
				foreign := &struct {
					mobilemultihop.NodeChainExecutionEngine
				}{e}
				executionMTUSet(t, reflect.ValueOf(&binding).Elem().FieldByName("state"), "engine", foreign)
			case "foreign-reader":
				expected = executionMTUReader()
			case "pending-previous", "foreign-previous":
				op := &routerVPNExecutionMTUTransition{binding: binding, before: before, result: before, epoch: binding.SelectionEpoch(), joined: scenario != "pending-previous"}
				if scenario == "foreign-previous" {
					op.result = &routerVPNExecutionReader{inbound: executionMTUReader(), ingress: before.ingress, generation: before.generation}
				}
				e.mtu.Store(op)
			case "no-operation":
				var stop context.CancelFunc
				ctx, stop = context.WithTimeout(t.Context(), time.Second)
				defer stop()
			case "unbounded":
				ctx = context.WithoutCancel(ctx)
			case "cancelled":
				var stop context.CancelFunc
				ctx, stop = context.WithCancel(ctx)
				stop()
			case "retired-source":
				f.current.Store(false)
			case "open-gate":
				if err := e.OpenApplicationContext(ctx, binding.Identity(), binding.SelectedTag()); err != nil {
					t.Fatal(err)
				}
			}
			previous := e.mtu.Load()
			var observations int
			read := func(call context.Context, reader adapter.Inbound) (routerVPNExecutionMTUReadback, error) {
				observations++
				if scenario == "read-error" {
					return routerVPNExecutionMTUReadback{}, errors.New("original native observation failed")
				}
				value := routerVPNExecutionMTUReadback{"original", 11, 1400}
				if scenario == "actual-value" {
					value.mtu = 1300
				}
				if scenario == "second-read" && observations == 2 {
					value.index++
				}
				if scenario == "reader-during-read" && observations == 2 {
					e.reader.Store(&routerVPNExecutionReader{inbound: before.inbound, ingress: before.ingress, generation: before.generation + 1})
				}
				return value, call.Err()
			}
			if err := e.retainUnchangedExecutionMTUContext(ctx, binding, expected, 1400, read); err == nil || e.mtu.Load() != previous {
				t.Fatal("unchanged cleanup accepted changed native ownership or observation", err)
			}
		})
	}
}
