// Build the actual separately compiled Server suffix and its registered native
// owner before the cleanup component exercises an original ownedConn. The
// operation below supplies the controlled TCP socket directly, so this proves
// encrypted retirement and fresh source/manager admission, not HTTP proxy I/O.
func connectRetirementServerOwner(t *testing.T, ctx context.Context, password string, whitened bool) (*Capture, *Outbound) {
	t.Helper()
	encode := func(v any) string {
		raw, err := json.Marshal(v)
		if err != nil {
			t.Fatal(err)
		}
		return string(raw)
	}
	paired := func(index byte) (map[string]any, string, string) {
		client, err := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{index}, 32))
		if err != nil {
			t.Fatal(err)
		}
		remote, err := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{index + 50}, 32))
		if err != nil {
			t.Fatal(err)
		}
		public := base64.StdEncoding.EncodeToString(remote.PublicKey().Bytes())
		identity := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + public))
		address := fmt.Sprintf("198.51.100.%d", index)
		profile := map[string]any{"id": fmt.Sprintf("retirement-node-%d", index), "node_kind": "router-vpn", "node_proof_id": hex.EncodeToString(identity[:]), "router_api": "http://10.77.0.1:8787", "api_token": fmt.Sprintf("retirement-token-%d", index), "endpoint": address, "dns_mode": "home", "adguard_ipv4": "192.168.50.133", "mtu_policy": "auto", "ipv6_mode": "off", "home_lan_access": false, "kill_switch_policy": "always"}
		config := fmt.Sprintf("[Interface]\nAddress=10.77.0.2/24\nPrivateKey=%s\nDNS=192.168.50.133\nMTU=2000\n[Peer]\nPublicKey=%s\nEndpoint=%s:51820\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n", base64.StdEncoding.EncodeToString(client.Bytes()), public, address)
		return profile, encode(map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(config))}), base64.StdEncoding.EncodeToString(client.PublicKey().Bytes())
	}
	entry, _, clientKey := paired(20)
	finalProfile, finalIdentity, _ := paired(22)
	layer := "aes-256-gcm"
	if whitened {
		layer = "aes-256-gcm+xor-whitening"
	}
	finalProfile["start_layer"] = layer
	finalGraph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "auto_route": true, "strict_route": true}}, "outbounds": []any{map[string]any{"type": "shadowsocks", "tag": "proxy", "server": "198.51.100.22", "server_port": 8388, "method": startwhitening.Method, "password": password}}, "route": map[string]any{"final": "proxy", "rules": []any{}}}
	rawFinal := []byte(encode(finalGraph))
	configHash, keyHash := sha256.Sum256(rawFinal), sha256.Sum256([]byte(password))
	declaration := map[string]any{"schema": 1, "node_id": finalProfile["node_proof_id"], "configured_image": nativecomposite.SSServiceImage, "uot_version": 2, "endpoint": "198.51.100.22", "port": 8388, "method": startwhitening.Method, "source_sha256": hex.EncodeToString(configHash[:]), "key_sha256": hex.EncodeToString(keyHash[:])}
	files := map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString(rawFinal), nativecomposite.SSServiceAsset: base64.StdEncoding.EncodeToString([]byte(encode(declaration)))}
	final, err := mobilemultihop.NewNodeProfile("shadowsocks", encode(files), encode(finalProfile), "", "")
	if err != nil {
		t.Fatal("actual retirement final", err)
	}
	finalInput, err := final.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	middleGraph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "interface_name": "router-vpn", "address": []string{"172.29.91.1/30", "fd29:91::1/126"}, "mtu": 1280, "auto_route": true, "strict_route": true, "stack": "system"}}, "outbounds": []any{map[string]any{"type": "http", "tag": "custom-exit", "server": "203.0.113.20", "server_port": 1080, "username": "original-user", "password": "original-password"}}, "route": map[string]any{"rules": []any{}, "final": "custom-exit", "auto_detect_interface": true}}
	middleProfile := map[string]any{"id": "retirement-middle", "node_kind": "external", "dns_mode": "home", "kill_switch_policy": "always", "ipv6_mode": "off", "home_lan_access": false, "mtu_policy": "auto", "external": map[string]any{"protocol": "http-connect", "expected_public_ip": "203.0.113.88", "http_connect": map[string]any{"host": "203.0.113.20", "port": 1080, "username": "original-user", "password": "original-password"}}}
	middle, err := mobilemultihop.NodeChainImportedCONNECTMemberInput(encode(middleGraph), encode(map[string]any{"schema": 1, "exit_id": "retirement-middle", "protocol": "http-connect", "expected_public_ip": "203.0.113.88", "profile": middleProfile}))
	if err != nil {
		t.Fatal(err)
	}
	policy, err := mobilemultihop.NewNodeChainCONNECTServerPolicy(encode(mobilemultihop.NodeChainServerSource{Schema: 4, EntryID: entry["id"].(string), EntryNodeID: entry["node_proof_id"].(string), EntryMode: "wg", Nodes: []string{middle, finalInput}, IdentitySources: []string{"", finalIdentity}}))
	if err != nil {
		t.Fatal("actual retirement Server policy", err)
	}
	descriptor := policy.Descriptor()
	digest, err := descriptor.Digest()
	if err != nil {
		t.Fatal(err)
	}
	request := multihoprelay.NodeChainRequest{Schema: 4, SessionID: strings.Repeat("1", 32), EntryNodeID: descriptor.EntryNodeID, SourceSHA256: descriptor.SourceSHA256, DescriptorSHA256: digest, DNSPolicySHA256: descriptor.DNSPolicySHA256, Epoch: strings.Repeat("2", 64), Peer: "10.77.0.2", AcquireExpiresAt: time.Now().Add(time.Minute).Unix(), Port: 26240, LocalPacketPublicKeys: []string{clientKey}, LocalPacketPositions: []int{0}}
	for i := range descriptor.Members {
		request.Users = append(request.Users, multihoprelay.NodeChainUser{Position: i + 1, Username: fmt.Sprintf("%048x", 101+i*2), Password: fmt.Sprintf("%048x", 102+i*2)})
	}
	lease := multihoprelay.NodeChainCapture{Schema: 1, Request: request, Source: descriptor, RegistrySHA256: digest, OwnerID: strings.Repeat("3", 64), Peer: request.Peer, Host: "10.77.0.1", BootstrapDeadline: time.Now().Add(time.Minute).UTC()}
	captured, err := NewServerCapture(ctx, policy, lease)
	if err != nil {
		t.Fatal("actual retirement capture", err)
	}
	registry := outbound.NewRegistry()
	if err = captured.Register(registry); err != nil {
		t.Fatal(err)
	}
	logger := log.NewNOPFactory().Logger()
	ends := endpoint.NewManager(logger, endpoint.NewRegistry())
	manager := outbound.NewManager(logger, registry, ends, captured.finalTag())
	nativeCtx := service.ContextWith[adapter.EndpointManager](captured.Context(), ends)
	nativeCtx = service.ContextWith[adapter.OutboundManager](nativeCtx, manager)
	nativeCtx = service.ContextWith[adapter.ConnectionManager](nativeCtx, route.NewConnectionManager(logger))
	config, err := policy.NativeConfig(lease)
	if err != nil {
		t.Fatal(err)
	}
	var graph struct {
		Outbounds []json.RawMessage `json:"outbounds"`
	}
	if json.Unmarshal([]byte(config), &graph) != nil {
		t.Fatal("actual retirement native graph")
	}
	t.Cleanup(func() {
		closeCtx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
		defer cancel()
		if err := captured.CloseContext(closeCtx); err != nil {
			t.Error("actual retirement capture cleanup", err)
		}
		if err := manager.Close(); err != nil {
			t.Error("actual retirement manager cleanup", err)
		}
	})
	for _, raw := range graph.Outbounds {
		var identity struct{ Type, Tag string }
		if json.Unmarshal(raw, &identity) != nil {
			t.Fatal("actual retirement native identity")
		}
		var options any
		switch identity.Type {
		case "http":
			options = new(option.HTTPOutboundOptions)
		case "shadowsocks":
			options = new(option.ShadowsocksOutboundOptions)
		case "routervpn-aes-xor":
			options = new(whitening.Options)
		default:
			t.Fatal("unexpected retirement native outbound", identity.Type)
		}
		if err = json.Unmarshal(raw, options); err != nil {
			t.Fatal(err)
		}
		if err = manager.Create(nativeCtx, nil, logger, identity.Tag, identity.Type, options); err != nil {
			t.Fatal("actual retirement constructor", err)
		}
	}
	for _, stage := range adapter.ListStartStages {
		if err = manager.Start(stage); err != nil {
			t.Fatal("actual retirement native start", err)
		}
	}
	if err = captured.ObserveServerContext(ctx, policy, lease); err != nil {
		t.Fatal("actual retirement native admission", err)
	}
	return captured, captured.middle
}

func exerciseCONNECTEncryptedRetirement(t *testing.T, whitened bool) {
	for _, wrong := range []bool{false, true} {
		name := "correct-key"
		if wrong {
			name = "wrong-key"
		}
		t.Run(name, func(t *testing.T) {
			listener, e := net.Listen("tcp4", "127.0.0.1:0")
			if e != nil {
				t.Fatal(e)
			}
			defer listener.Close()
			ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
			defer cancel()
			handler := new(wrongFinalActualHandler)
			password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, 32))
			server, e := SS.NewServiceWithPassword("2022-blake3-aes-256-gcm", password, 10, handler, nil)
			if e != nil {
				t.Fatal(e)
			}
			providerPassword := password
			joined := make(chan error, 1)
			go func() {
				c, e := listener.Accept()
				if e != nil {
					joined <- e
					return
				}
				_ = c.SetDeadline(time.Now().Add(3 * time.Second))
				if whitened {
					original := c
					providerOwner := startwhitening.NewOwner(ctx)
					defer providerOwner.Close()
					key, failure := startwhitening.Key("2022-blake3-aes-256-gcm", providerPassword)
					if failure != nil {
						joined <- failure
						_ = original.Close()
						return
					}
					transformed, failure := providerOwner.Open(ctx, key, false, func(context.Context) (net.Conn, error) { return original, nil })
					if failure != nil {
						joined <- failure
						_ = original.Close()
						return
					}
					c = transformed
				}
				// Exactly the native reference final's lifetime: return the original
				// NewConnection error, close its actual accepted TCP, then acknowledge join.
				e = server.NewConnection(ctx, c, M.Metadata{Source: M.SocksaddrFromNet(c.RemoteAddr())})
				closeErr := c.Close()
				joined <- errors.Join(e, closeErr)
			}()
			manager := route.NewConnectionManager(log.NewNOPFactory().Logger())
			lowerCtx := service.ContextWith[adapter.ConnectionManager](ctx, manager)
			lower, e := dialer.New(lowerCtx, option.DialerOptions{}, false)
			if e != nil {
				t.Fatal(e)
			}
			tracked, e := lower.DialContext(ctx, "tcp", M.ParseSocksaddr(listener.Addr().String()))
			if e != nil {
				t.Fatal(e)
			}
			t.Cleanup(func() { _ = tracked.Close() })
			retained, e := captureServerTCP(tracked)
			if e != nil {
				t.Fatal(e)
			}
			if wrong {
				password = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{74}, 32))
			}
			capture, owner := connectRetirementServerOwner(t, ctx, password, whitened)
			op := connectCloseOperation(owner, retained)
			// A controlled real TCP socket is installed in this operation after
			// actual source/manager/final admission. No HTTP proxy is simulated.
			original := &ownedConn{Conn: op.tcp, operation: op}
			op.connection = original

			client, e := SS.NewWithPassword("2022-blake3-aes-256-gcm", password, nil)
			if e != nil {
				t.Fatal(e)
			}
			var cipherRaw net.Conn = op.tcp
			var transformed *startwhitening.Conn
			if whitened {
				originalOwner := startwhitening.NewOwner(ctx)
				t.Cleanup(func() { _ = originalOwner.Close() })
				key, failure := startwhitening.Key("2022-blake3-aes-256-gcm", password)
				if failure != nil {
					t.Fatal(failure)
				}
				transformed, failure = originalOwner.Open(ctx, key, false, func(context.Context) (net.Conn, error) { return original, nil })
				if failure != nil {
					t.Fatal(failure)
				}
				cipherRaw = transformed
			}
			encrypted, e := client.DialConn(cipherRaw, M.ParseSocksaddr("10.77.0.1:8787"))
			if e != nil {
				t.Fatal(e)
			}

			var guard net.Conn
			if whitened {
				guard, e = startwhitening.OwnAuthenticatedStream(transformed, encrypted)
				if e != nil {
					t.Fatal(e)
				}
			} else {
				guard = startwhitening.GuardAuthenticatedStream(original, encrypted)
			}
			wrapper := &connectRetirementWrapper{Conn: guard}
			retire := capture.serverConnectionRetirement(wrapper)
			if retire == nil {
				t.Fatal("opaque original SS retirement receipt was not captured")
			}
			packets := uot.NewLazyConn(guard, uot.Request{IsConnect: true, Destination: M.ParseSocksaddr("192.168.50.133:53")})
			packetRetire := capture.serverConnectionRetirement(packets)
			foreignCipher := &connectRetirementCipherFailure{Conn: original, failure: errors.New("unrelated original cipher close failure")}
			foreignGuard := startwhitening.GuardAuthenticatedStream(original, foreignCipher)
			foreignRetire := capture.serverConnectionRetirement(foreignGuard)
			if foreignRetire == nil {
				t.Fatal("original second close boundary missing")
			}
			if packetRetire == nil {
				t.Fatal("original UoT retirement path was not captured")
			}
			if err := retire(ctx, wrapper, errors.New("not closed")); err == nil {
				t.Fatal("unclosed opaque stream acquired retirement acknowledgement")
			}
			_, writeErr := guard.Write([]byte("ping"))
			var reply [4]byte
			_, readErr := io.ReadFull(guard, reply[:])
			var peerErr error
			select {
			case peerErr = <-joined:
			case <-ctx.Done():
				t.Fatal("actual encrypted peer did not join", ctx.Err())
			}
			if wrong {
				if handler.accepted.Load() != 0 || peerErr == nil || readErr == nil {
					t.Fatal("wrong final key did not cause actual encrypted authentication refusal", peerErr, readErr)
				}
			} else if peerErr != nil || writeErr != nil || readErr != nil || string(reply[:]) != "pong" || handler.accepted.Load() != 1 {
				t.Fatal("actual matching-key control failed", peerErr, writeErr, readErr)
			}
			before := manager.Count()
			closeCtx, finish := context.WithTimeout(context.Background(), 2*time.Second)
			defer finish()
			closeErr := wrapper.Close()
			retryErr := owner.CloseContext(closeCtx)
			t.Logf("actual peer joined; tracked=%T manager_before=%d manager_after=%d accepted=%d peer_error=%v read_error=%v operation_close=%v outbound_retry=%v raw_done=%t native_done=%t force_done=%t operation_drained=%t", tracked, before, manager.Count(), handler.accepted.Load(), peerErr, readErr, closeErr, retryErr, completed(op.tcp.done), completed(op.tcp.nativeDone), completed(op.tcp.forceDone), completed(op.drained))
			if manager.Count() != 0 || !completed(op.tcp.nativeDone) || !completed(op.drained) {
				t.Fatal("original owned cleanup did not join")
			}
			if wrong {
				if closeErr == nil || retryErr == nil {
					t.Fatal("authentication failure lost original close receipt")
				}
				reject := func(name string, actual net.Conn, failure error) {
					t.Helper()
					if retire(closeCtx, actual, failure) == nil {
						t.Fatal("retirement accepted foreign or incomplete owner", name)
					}
				}
				foreignClose := foreignGuard.Close()
				if foreignRetire(closeCtx, foreignGuard, foreignClose) == nil {
					t.Fatal("unrelated actual cipher Close failure was acknowledged")
				}
				copied := *original
				reject("copied original", &copied, closeErr)
				reject("mixed error", wrapper, errors.Join(closeErr, errors.New("unrelated close remains unjoined")))
				wrapper.Conn = &copied
				reject("replaced wrapper", wrapper, closeErr)
				wrapper.Conn = guard
				capture.middle = &Outbound{}
				reject("replaced outbound", wrapper, closeErr)
				capture.middle = owner
				original.Conn = tracked
				reject("replaced payload", wrapper, closeErr)
				original.Conn = op.tcp
				rawPayload := op.tcp.Conn
				op.tcp.Conn = &connectServerOpaqueConn{Conn: tracked}
				reject("replaced native payload", wrapper, closeErr)
				op.tcp.Conn = rawPayload
				nativeDone := op.tcp.nativeDone
				op.tcp.nativeDone = make(chan struct{})
				reject("native close incomplete", wrapper, closeErr)
				op.tcp.nativeDone = nativeDone
				forceDone := op.tcp.forceDone
				op.tcp.forceDone = make(chan struct{})
				reject("force close incomplete", wrapper, closeErr)
				op.tcp.forceDone = forceDone
				drained := op.drained
				op.drained = make(chan struct{})
				reject("operation incomplete", wrapper, closeErr)
				op.drained = drained
				op.tcp.nativeErr = errors.New("original native Close failed")
				reject("native failure", wrapper, closeErr)
				op.tcp.nativeErr = nil
				if err := retire(closeCtx, wrapper, closeErr); err != nil {
					t.Fatal("joined original authentication refusal could not retire", err)
				}
				if err := packetRetire(closeCtx, packets, closeErr); err != nil {
					t.Fatal("original UoT path lost joined retirement", err)
				}
				if err := capture.CloseContext(closeCtx); err != nil {
					t.Fatal("original capture retained acknowledged trial error", err)
				}
				if err := owner.Close(); err != nil {
					t.Fatal("Box outbound close retained acknowledged trial error", err)
				}
				if err := original.Close(); err == nil {
					t.Fatal("retirement erased original trial Close failure")
				}
				if err := retire(closeCtx, wrapper, closeErr); err != nil {
					t.Fatal("same original retirement retry changed", err)
				}
			}
			if !wrong && (closeErr != nil || retryErr != nil) {
				t.Fatal("matching-key cleanup failed", closeErr, retryErr)
			}
		})
	}
}

