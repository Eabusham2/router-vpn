// These tests use real Box registries and the shipping private public-route
// owner. The existing fixture explicitly doubles packet/kernel I/O. Actual
// independent encrypted providers are exercised by multiple_imported_test.go.
func chainNativeMultipleImportedSource(t *testing.T, count int, positions []int) *mobilemultihop.NodeChain {
	t.Helper()
	original := chainNativeImportedSSPrefixSource(t, count-2)
	launch, err := original.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(launch), &source) != nil || len(source.Nodes) != count {
		t.Fatal("original complete source missing")
	}
	var input struct {
		Config  string `json:"config"`
		Capture string `json:"capture"`
	}
	if json.Unmarshal([]byte(source.Nodes[count-2]), &input) != nil {
		t.Fatal("original imported member missing")
	}
	for _, position := range positions {
		var graph, capture map[string]any
		if json.Unmarshal([]byte(input.Config), &graph) != nil || json.Unmarshal([]byte(input.Capture), &capture) != nil {
			t.Fatal("complete imported capture missing")
		}
		profile := capture["profile"].(map[string]any)
		external := profile["external"].(map[string]any)
		ss := external["shadowsocks"].(map[string]any)
		out := graph["outbounds"].([]any)[0].(map[string]any)
		id, host, public := fmt.Sprintf("native-independent-%d", position), fmt.Sprintf("203.0.113.%d", 40+position), fmt.Sprintf("198.51.100.%d", 40+position)
		password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(90 + position)}, 32))
		profile["id"], profile["endpoint"], capture["exit_id"] = id, host, id
		external["expected_public_ip"], capture["expected_public_ip"] = public, public
		ss["server"], ss["port"], ss["password"] = host, 21000+position, password
		out["server"], out["server_port"], out["password"] = host, 21000+position, password
		source.Nodes[position], err = mobilemultihop.NodeChainImportedMemberInput(chainNativeJSON(t, graph), chainNativeJSON(t, capture))
		if err != nil {
			t.Fatal(err)
		}
		source.IdentitySources[position] = ""
	}
	source.Schema = 6
	chain, err := mobilemultihop.NewNodeChain(chainNativeJSON(t, source))
	if err != nil {
		t.Fatal("complete independent source", err)
	}
	return chain
}

// The older constructor-only fixture intentionally omits the DNS router. These
// public-route owner tests need the original selected DNS owner as well as its
// existing captured transport. Build that real router from the same source;
// packet/TUN I/O remains the explicit test double described above.
func newChainNativeMultipleImportedFixture(t *testing.T, count int, positions []int) *chainNativeFixture {
	t.Helper()
	f := newChainNativeFixtureSource(t, chainNativeMultipleImportedSource(t, count, positions), nil, nil)
	ctx := f.box.ctx
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(f.chain.Config()))
	if err != nil || options.DNS == nil || f.box.dnsRouter != nil {
		t.Fatal("original imported DNS source missing or already replaced", err)
	}
	service.MustRegister[adapter.DNSTransportManager](ctx, f.box.dnsTransport)
	service.MustRegister[adapter.NetworkManager](ctx, f.box.network)
	router, err := dns.NewRouter(ctx, log.NewNOPFactory(), *options.DNS)
	if err != nil {
		t.Fatal("original imported DNS router", err)
	}
	f.box.dnsRouter = router
	service.MustRegister[adapter.DNSRouter](ctx, router)
	t.Cleanup(func() {
		if err := router.Close(); err != nil {
			t.Error("original imported DNS router did not retire", err)
		}
	})
	if err := router.Initialize(options.DNS.Rules); err != nil {
		t.Fatal("original imported DNS rules", err)
	}
	for _, stage := range adapter.ListStartStages {
		if err := router.Start(stage); err != nil {
			t.Fatal("original imported DNS startup", err)
		}
	}
	return f
}

func TestRouterVPNMultipleImportedPublicRouteOriginalOwners(t *testing.T) {
	for _, layout := range []struct {
		name      string
		count     int
		positions []int
	}{
		{"adjacent", 4, []int{1, 2}}, {"separated", 5, []int{1, 3}}, {"maximum", 8, []int{1, 4, 6}},
	} {
		t.Run(layout.name, func(t *testing.T) {
			f := newChainNativeMultipleImportedFixture(t, layout.count, layout.positions)
			engine, err := f.capture(context.Background())
			if err != nil {
				t.Fatal(err)
			}
			captured, ipv6, err := f.chain.PublicMeasurementCaptures()
			if err != nil || len(captured) != len(layout.positions) {
				t.Fatal("complete native public inventory", err)
			}
			for i, capture := range captured {
				if capture.Position != layout.positions[i] || capture.Tag != f.chain.PrefixTags()[capture.Position] || capture.SourceSHA256 == "" {
					t.Fatal("wrong original position", i)
				}
				if actual, err := engine.public.permit(engine.observation, capture.Tag); err != nil || actual != ipv6 {
					t.Fatal("original public owner refused", i, err)
				}
			}
			captured[0].SourceSHA256 = "changed caller copy"
			if _, err := engine.public.permit(engine.observation, f.chain.PrefixTags()[layout.positions[0]]); err != nil {
				t.Fatal("caller inventory aliased retained owner", err)
			}
			for _, tag := range []string{f.chain.PrefixTags()[0], f.chain.FinalTag(), "foreign"} {
				if _, err := engine.public.permit(engine.observation, tag); err == nil {
					t.Fatal("uncaptured public route admitted", tag)
				}
			}
		})
	}
}

func TestRouterVPNMultipleImportedPublicRouteRefusals(t *testing.T) {
	for _, fault := range []string{"equal-source", "copied-source", "copied-route-owner", "nil-original", "foreign-observation", "omitted-position", "swapped-positions", "changed-source-hash", "changed-position", "changed-ipv6", "missing-prefix", "retired-outer-owner"} {
		t.Run(fault, func(t *testing.T) {
			f := newChainNativeMultipleImportedFixture(t, 5, []int{1, 3})
			engine, err := f.capture(context.Background())
			if err != nil {
				t.Fatal(err)
			}
			tag := f.chain.PrefixTags()[1]
			if _, err := engine.public.permit(engine.observation, tag); err != nil {
				t.Fatal("negative lacked original positive", err)
			}
			switch fault {
			case "equal-source":
				launch, e := f.chain.LaunchInput()
				if e != nil {
					t.Fatal(e)
				}
				other, e := mobilemultihop.ParseNodeChainLaunchInput(launch)
				if e != nil || other == f.chain || other.Config() != f.chain.Config() || other.SourceSHA256() != f.chain.SourceSHA256() {
					t.Fatal("equal-source witness invalid", e)
				}
				engine.public.source = other
			case "copied-source":
				copy := *f.chain
				engine.public.source = &copy
			case "copied-route-owner":
				copy := *engine.public
				engine.public = &copy
			case "nil-original":
				engine.public.originalSource = nil
			case "foreign-observation":
				copy := *engine.observation
				engine.observation = &copy
			case "omitted-position":
				engine.public.captured = engine.public.captured[:1]
			case "swapped-positions":
				engine.public.captured[0], engine.public.captured[1] = engine.public.captured[1], engine.public.captured[0]
			case "changed-source-hash":
				engine.public.captured[1].SourceSHA256 = engine.public.captured[0].SourceSHA256
			case "changed-position":
				engine.public.captured[1].Position = 2
			case "changed-ipv6":
				engine.public.ipv6 = !engine.public.ipv6
			case "missing-prefix":
				delete(engine.observation.prefixes, f.chain.PrefixTags()[3])
			case "retired-outer-owner":
				f.current.Store(false)
				if _, e := engine.ObserveChainContext(context.Background()); e == nil {
					t.Fatal("retired original native owner accepted")
				}
				return
			}
			if _, err := engine.public.permit(engine.observation, tag); err == nil {
				t.Fatal("changed original public source retained route authority", fault)
			}
		})
	}
}
