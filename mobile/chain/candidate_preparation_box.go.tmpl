var errRouterVPNCandidatePreparation = errors.New("original candidate prefix preparation changed or retired")

// This owner retains closed application and DNS ingress during prefix proof
// and candidate measurement. Native packet candidates reach their one captured
// UDP peer only through the separately sealed prepared request.
type RouterVPNNodeChainCandidatePreparationEngine struct {
	instance           *Box
	prep               *mobilemultihop.NodeChainCandidatePreparation
	current            func(context.Context) error
	identity           mobilemultihop.NodeChainIdentity
	retired            atomic.Bool
	inbound            adapter.Inbound
	selector           *group.Selector
	selected           string
	prefixes           map[string]adapter.Outbound
	outbounds          map[string]adapter.Outbound
	resolvers          map[string]adapter.DNSTransport
	services           map[string]adapter.Service
	gate               *G.Outbound
	control            *G.Control
	ingress            *route.RouterVPNNodeChainIngress
	gateID             string
	hostnameTargets    map[string]mobilemultihop.NodeChainAppendHostnameTarget
	hostnameDialers    map[string]N.Dialer
	hostnameCandidates map[string]string
	hostnameIPv4Only   map[string]bool
	hostnameMu         sync.Mutex
	hostnameAnswers    map[string][]netip.Addr
	hostnameEndpoints  map[netip.AddrPort]string
	hostnamePrepared   atomic.Bool
	hostnameFailed     atomic.Bool
}

func (s *Box) RouterVPNNewNodeChainCandidatePreparationEngine(ctx context.Context, prep *mobilemultihop.NodeChainCandidatePreparation,
	session string, current func(context.Context) error) (*RouterVPNNodeChainCandidatePreparationEngine, error) {
	if s == nil || ctx == nil || ctx.Err() != nil || prep == nil || current == nil || !routerVPNNodeChainSession(session) ||
		s.ctx == nil || s.ctx.Err() != nil || s.routerVPNNodeChainExecutionOptions == "" || s.router == nil || s.network == nil || current(ctx) != nil {
		return nil, errRouterVPNCandidatePreparation
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](s.ctx, []byte(prep.Config()))
	if err != nil || routerVPNNodeChainExecutionOptionsDigest(s.ctx, options) != s.routerVPNNodeChainExecutionOptions {
		return nil, errRouterVPNCandidatePreparation
	}
	proofs := prep.ProofInventory()
	if prep.SourceSHA256() == "" || prep.ConfigSHA256() == "" || len(proofs) == 0 || len(proofs) != prep.PrefixPosition()+1 {
		return nil, errRouterVPNCandidatePreparation
	}
	e := &RouterVPNNodeChainCandidatePreparationEngine{instance: s, prep: prep, current: current, selected: proofs[len(proofs)-1].Tag,
		identity: mobilemultihop.NodeChainIdentity{EngineID: fmt.Sprintf("%p", s), SessionID: session, SourceSHA256: prep.SourceSHA256(), ConfigSHA256: prep.ConfigSHA256()},
		prefixes: make(map[string]adapter.Outbound), outbounds: make(map[string]adapter.Outbound), resolvers: make(map[string]adapter.DNSTransport), services: make(map[string]adapter.Service)}
	e.identity.NetworkID, err = s.network.RouterVPNNodeChainNetworkContext(ctx)
	if err != nil {
		return nil, err
	}
	inbounds, err := adapter.RouterVPNInboundsContext(ctx, s.inbound)
	if err != nil || len(inbounds) != 1 || inbounds[0].Type() != C.TypeTun || inbounds[0].Tag() != "routervpn-chain-tun" {
		return nil, errRouterVPNCandidatePreparation
	}
	e.inbound = inbounds[0]
	var tags []string
	for _, row := range options.Outbounds {
		tags = append(tags, row.Tag)
	}
	for _, row := range options.Endpoints {
		tags = append(tags, row.Tag)
	}
	for _, tag := range tags {
		retained, found, err := adapter.RouterVPNOutboundContext(ctx, s.outbound, tag)
		if err != nil || !found || retained == nil || tag == "" || e.outbounds[tag] != nil {
			return nil, errRouterVPNCandidatePreparation
		}
		e.outbounds[tag] = retained
	}
	if options.DNS != nil {
		for _, row := range options.DNS.Servers {
			retained, found, err := adapter.RouterVPNTransportContext(ctx, s.dnsTransport, row.Tag)
			if err != nil || !found || retained == nil || row.Tag == "" || e.resolvers[row.Tag] != nil {
				return nil, errRouterVPNCandidatePreparation
			}
			e.resolvers[row.Tag] = retained
		}
	}
	for _, row := range options.Services {
		if row.Type == C.TypeOOMKiller {
			continue
		}
		retained, found, err := adapter.RouterVPNServiceContext(ctx, s.service, row.Tag)
		if err != nil || !found || retained == nil || row.Tag == "" || e.services[row.Tag] != nil {
			return nil, errRouterVPNCandidatePreparation
		}
		e.services[row.Tag] = retained
	}
	for _, proof := range proofs {
		retained := e.outbounds[proof.Tag]
		if retained == nil || e.prefixes[proof.Tag] != nil {
			return nil, errRouterVPNCandidatePreparation
		}
		e.prefixes[proof.Tag] = retained
	}
	if err := e.captureAppendHostnames(); err != nil {
		return nil, err
	}
	selector, ok := e.outbounds[mobilemultihop.SelectorTag].(*group.Selector)
	if !ok || selector == nil || !reflect.DeepEqual(selector.All(), []string{e.selected}) || selector.Now() != e.selected {
		return nil, errRouterVPNCandidatePreparation
	}
	e.selector = selector
	gate, ok := e.outbounds[mobilemultihop.NodeChainExecutionGateTag].(*G.Outbound)
	if !ok || gate == nil {
		return nil, errRouterVPNCandidatePreparation
	}
	e.gate = gate
	e.gateID = e.identity.EngineID + ":" + session + ":" + prep.SourceSHA256()
	e.control, err = gate.Bind(ctx, e.gateID, e.nativeCurrent)
	if err != nil {
		return nil, err
	} // failed Bind owns no foreign gate cleanup
	e.ingress, err = s.router.RouterVPNBindNodeChainIngress(ctx, e.inbound, e.nativeCurrent, e.control.TrackInbound, e.applicationClosed)
	if err != nil {
		return e, err
	} // retain exact acquired control for retry
	if _, err := e.ObservePreparationContext(ctx); err != nil {
		return e, err
	}
	return e, nil
}

// The ingress and gate use this callback while observing their own state.
// Keep it acyclic: only exact native managers, physical generation and outer
// lifetime are read here, never ingress.Current or control.Observe.
func (e *RouterVPNNodeChainCandidatePreparationEngine) nativeCurrent(ctx context.Context) error {
	if e == nil || ctx == nil || ctx.Err() != nil || e.retired.Load() || e.hostnameFailed.Load() || e.instance == nil || e.current == nil || e.current(ctx) != nil {
		return errRouterVPNCandidatePreparation
	}
	s := e.instance
	if s.ctx == nil || s.ctx.Err() != nil || s.done == nil || s.network == nil || s.routerVPNNodeChainExecutionOptions == "" {
		return errRouterVPNCandidatePreparation
	}
	source, config, err := e.prep.ReadIdentityValidated()
	if err != nil || source != e.identity.SourceSHA256 || config != e.identity.ConfigSHA256 {
		return errRouterVPNCandidatePreparation
	}
	select {
	case <-s.done:
		return errRouterVPNCandidatePreparation
	default:
	}
	network, err := s.network.RouterVPNNodeChainNetworkContext(ctx)
	if err != nil || network != e.identity.NetworkID {
		return errRouterVPNCandidatePreparation
	}
	inbounds, err := adapter.RouterVPNInboundsContext(ctx, s.inbound)
	if err != nil || len(inbounds) != 1 || inbounds[0] != e.inbound || e.inbound.Type() != C.TypeTun || e.inbound.Tag() != "routervpn-chain-tun" {
		return errRouterVPNCandidatePreparation
	}
	for tag, retained := range e.outbounds {
		actual, found, err := adapter.RouterVPNOutboundContext(ctx, s.outbound, tag)
		if err != nil || !found || actual != retained {
			return errRouterVPNCandidatePreparation
		}
	}
	for tag, retained := range e.resolvers {
		actual, found, err := adapter.RouterVPNTransportContext(ctx, s.dnsTransport, tag)
		if err != nil || !found || actual != retained {
			return errRouterVPNCandidatePreparation
		}
	}
	for tag, retained := range e.services {
		actual, found, err := adapter.RouterVPNServiceContext(ctx, s.service, tag)
		if err != nil || !found || actual != retained {
			return errRouterVPNCandidatePreparation
		}
	}
	if !reflect.DeepEqual(e.selector.All(), []string{e.selected}) || e.selector.Now() != e.selected || e.retired.Load() || e.current(ctx) != nil {
		return errRouterVPNCandidatePreparation
	}
	network, err = s.network.RouterVPNNodeChainNetworkContext(ctx)
	if err != nil || network != e.identity.NetworkID || ctx.Err() != nil {
		return errRouterVPNCandidatePreparation
	}
	select {
	case <-s.done:
		return errRouterVPNCandidatePreparation
	default:
		return nil
	}
}

func (e *RouterVPNNodeChainCandidatePreparationEngine) applicationClosed(ctx context.Context) (bool, error) {
	return false, e.nativeCurrent(ctx)
}

func (e *RouterVPNNodeChainCandidatePreparationEngine) ObservePreparationContext(ctx context.Context) (mobilemultihop.NodeChainIdentity, error) {
	if e == nil || e.nativeCurrent(ctx) != nil || e.ingress == nil || e.ingress.Current(ctx) != nil || e.control == nil {
		return mobilemultihop.NodeChainIdentity{}, errRouterVPNCandidatePreparation
	}
	state, err := e.control.Observe(ctx)
	// Denied TUN inputs can still own an unfinished Close. They never grant
	// forwarding; the exact control retains them through native retirement.
	if err != nil || state.Open || state.Closed || state.Identity != e.gateID || e.nativeCurrent(ctx) != nil {
		return mobilemultihop.NodeChainIdentity{}, errRouterVPNCandidatePreparation
	}
	return e.identity, nil
}

func (e *RouterVPNNodeChainCandidatePreparationEngine) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if _, err := e.ObservePreparationContext(ctx); err != nil {
		return nil, err
	}
	retained := e.prefixes[tag]
	if retained == nil || !e.prep.AllowsDial(tag, address) {
		return nil, errRouterVPNCandidatePreparation
	}
	ctx = e.hostnameContext(ctx)
	var conn net.Conn
	var dialErr error
	if resolver, hostname := e.hostnameCandidates[address]; hostname {
		if tag != e.selected || !e.hostnamePrepared.Load() || e.hostnameDialers[resolver] == nil {
			return nil, errRouterVPNCandidatePreparation
		}
		conn, dialErr = e.hostnameDialers[resolver].DialContext(ctx, "tcp", M.ParseSocksaddr(address))
	} else {
		destination, err := routerVPNExecutionDestination(address)
		if err != nil {
			return nil, err
		}
		conn, dialErr = retained.DialContext(ctx, "tcp", destination)
	}
	observed, err := e.ObservePreparationContext(ctx)
	if err != nil || observed != e.identity || ctx.Err() != nil || conn == nil {
		return conn, errors.Join(dialErr, err, ctx.Err(), errRouterVPNCandidatePreparation)
	}
	return conn, dialErr
}

// The sealed request only permits the candidate's one literal UDP peer
// through the retained packet prefix. Gate, ingress and original physical
// owner are observed independently from any private TCP proof permission.
func (e *RouterVPNNodeChainCandidatePreparationEngine) DialPreparedCandidatePacketContext(ctx context.Context, request *mobilemultihop.NodeChainCandidatePacketRequest) (net.Conn, error) {
	if e == nil {
		return nil, errRouterVPNCandidatePreparation
	}
	identity, tag, address, err := request.ReadPrepared(ctx, e, e.prep)
	if err != nil || identity != e.identity || tag != e.selected {
		return nil, errors.Join(err, errRouterVPNCandidatePreparation)
	}
	target := M.ParseSocksaddr(address)
	retained := e.prefixes[tag]
	if retained == nil || !target.IsIP() || target.Port == 0 {
		return nil, errRouterVPNCandidatePreparation
	}
	ctx = e.hostnameContext(ctx)
	conn, dialErr := retained.DialContext(ctx, "udp", target)
	after, actualTag, actualAddress, observed := request.ReadPrepared(ctx, e, e.prep)
	if conn == nil || after != identity || actualTag != tag || actualAddress != address {
		observed = errors.Join(observed, errRouterVPNCandidatePreparation)
	}
	return conn, errors.Join(dialErr, observed, ctx.Err())
}

func (e *RouterVPNNodeChainCandidatePreparationEngine) OpenPreparedCandidateEndpointContext(ctx context.Context, request *mobilemultihop.NodeChainCandidatePacketRequest) (mobilemultihop.NodeChainCandidateEndpoint, error) {
	if e == nil {
		return nil, errRouterVPNCandidatePreparation
	}
	return request.OpenPreparedNativeEndpoint(ctx, e, e.prep, routerVPNNewCandidateAWG)
}

// The enclosing owner first joins candidates and private proof workers. This
// closes only the original deny gate/ingress; its Box/TUN is retired afterward.
// Failed close retains the control so a later retry can finish exact cleanup.
func (e *RouterVPNNodeChainCandidatePreparationEngine) RetireContext(ctx context.Context) error {
	if e == nil || ctx == nil || e.control == nil {
		return errRouterVPNCandidatePreparation
	}
	e.retired.Store(true)
	if err := e.control.Close(ctx); err != nil {
		return err
	}
	if e.ingress != nil {
		e.ingress.Retire()
	}
	return ctx.Err()
}

// Only the original append preparation can supply these exact resolver and
// prefix tags. The dialers add no transport, worker, physical route or final.
func (e *RouterVPNNodeChainCandidatePreparationEngine) captureAppendHostnames() error {
	policy, err := e.prep.AppendHostnamePolicy()
	if err != nil {
		return err
	}
	if len(policy.Targets) == 0 {
		return nil
	}
	e.hostnameTargets = make(map[string]mobilemultihop.NodeChainAppendHostnameTarget)
	e.hostnameDialers = make(map[string]N.Dialer)
	e.hostnameCandidates = make(map[string]string)
	e.hostnameIPv4Only = make(map[string]bool)
	e.hostnameAnswers = make(map[string][]netip.Addr)
	e.hostnameEndpoints = make(map[netip.AddrPort]string)
	for _, literal := range policy.LiteralTargets {
		target, err := netip.ParseAddrPort(literal)
		if err != nil || target.String() != literal {
			return errRouterVPNCandidatePreparation
		}
		e.hostnameEndpoints[target] = "literal"
	}
	for _, target := range policy.Targets {
		if target.ResolverTag == "" || e.hostnameTargets[target.ResolverTag].ResolverTag != "" || e.prefixes[target.PrefixTag] == nil ||
			e.resolvers[target.ResolverTag] == nil || e.resolvers[target.ResolverTag].Type() != "tcp" {
			return errRouterVPNCandidatePreparation
		}
		var query option.DomainResolveOptions
		if SJ.Unmarshal([]byte(target.Query), &query) != nil || query.Server != target.ResolverTag {
			return errRouterVPNCandidatePreparation
		}
		peer := M.ParseSocksaddr(target.Address)
		if !peer.IsDomain() || peer.Port == 0 {
			return errRouterVPNCandidatePreparation
		}
		original, err := dialer.New(e.instance.ctx, option.DialerOptions{Detour: target.PrefixTag, AbstractDialerOptions: option.AbstractDialerOptions{DomainResolver: &query}}, true)
		if err != nil {
			return err
		}
		original, err = dialer.BindRouterVPNOriginalPeer(original, peer, target.ResolverTag, target.Exclusions)
		if err != nil {
			return err
		}
		e.hostnameTargets[target.ResolverTag], e.hostnameDialers[target.ResolverTag] = target, original
		e.hostnameIPv4Only[target.ResolverTag] = query.Strategy == option.DomainStrategy(C.DomainStrategyIPv4Only)
		if target.Candidate {
			if target.PrefixTag != e.selected || e.hostnameCandidates[target.Address] != "" {
				return errRouterVPNCandidatePreparation
			}
			e.hostnameCandidates[target.Address] = target.ResolverTag
		}
	}
	return nil
}

func (e *RouterVPNNodeChainCandidatePreparationEngine) hostnameContext(ctx context.Context) context.Context {
	if len(e.hostnameTargets) == 0 {
		return ctx
	}
	return dialer.ContextWithRouterVPNOriginalPeerCheck(ctx, e.checkHostnameAnswers)
}

func (e *RouterVPNNodeChainCandidatePreparationEngine) checkHostnameAnswers(ctx context.Context, host string, port uint16, transport adapter.DNSTransport, answers []netip.Addr) error {
	if ctx == nil {
		return errRouterVPNCandidatePreparation
	}
	if ctx.Err() != nil || e.retired.Load() || e.hostnameFailed.Load() {
		return errors.Join(ctx.Err(), errRouterVPNCandidatePreparation)
	}
	fail := func() error { e.hostnameFailed.Store(true); return errRouterVPNCandidatePreparation }
	if transport == nil {
		return fail()
	}
	target, found := e.hostnameTargets[transport.Tag()]
	if !found || e.resolvers[transport.Tag()] != transport || target.Address != net.JoinHostPort(strings.ToLower(host), strconv.Itoa(int(port))) || len(answers) == 0 || len(answers) > 4096 {
		return fail()
	}
	unique := map[netip.Addr]bool{}
	for _, answer := range answers {
		if !answer.IsValid() || answer.Zone() != "" || answer.Is4In6() || answer.IsUnspecified() || answer.IsMulticast() || e.hostnameIPv4Only[target.ResolverTag] && !answer.Is4() {
			return fail()
		}
		unique[answer] = true
	}
	captured := make([]netip.Addr, 0, len(unique))
	for address := range unique {
		captured = append(captured, address)
	}
	slices.SortFunc(captured, func(a, b netip.Addr) int { return a.Compare(b) })
	e.hostnameMu.Lock()
	defer e.hostnameMu.Unlock()
	if e.retired.Load() || e.hostnameFailed.Load() || ctx.Err() != nil {
		return errors.Join(ctx.Err(), errRouterVPNCandidatePreparation)
	}
	if original, exists := e.hostnameAnswers[target.ResolverTag]; exists && !slices.Equal(original, captured) {
		return fail()
	}
	for _, address := range captured {
		endpoint := netip.AddrPortFrom(address, port)
		if owner := e.hostnameEndpoints[endpoint]; owner != "" && owner != target.ResolverTag {
			return fail()
		}
	}
	if _, exists := e.hostnameAnswers[target.ResolverTag]; !exists {
		e.hostnameAnswers[target.ResolverTag] = append([]netip.Addr(nil), captured...)
		for _, address := range captured {
			e.hostnameEndpoints[netip.AddrPortFrom(address, port)] = target.ResolverTag
		}
	}
	return nil
}

// This synchronous phase is inside the original runtime Start budget. Every
// captured hostname is admitted before Prepared and before candidate sockets;
// repeated or inconsistent DNS cannot replace an already captured answer set.
func (e *RouterVPNNodeChainCandidatePreparationEngine) PrepareAppendHostnameContext(ctx context.Context, prep *mobilemultihop.NodeChainCandidatePreparation) error {
	if e == nil || prep == nil || prep != e.prep || e.hostnamePrepared.Load() {
		return errRouterVPNCandidatePreparation
	}
	if _, err := e.ObservePreparationContext(ctx); err != nil {
		return err
	}
	ctx = e.hostnameContext(ctx)
	policy, err := prep.AppendHostnamePolicy()
	if err != nil || len(policy.Targets) != len(e.hostnameTargets) || len(policy.Targets) == 0 {
		return errors.Join(err, errRouterVPNCandidatePreparation)
	}
	for _, target := range policy.Targets {
		if e.hostnameDialers[target.ResolverTag] == nil {
			return errRouterVPNCandidatePreparation
		}
		if err := dialer.ResolveRouterVPNOriginalPeer(ctx, e.hostnameDialers[target.ResolverTag]); err != nil {
			return err
		}
		if _, err := e.ObservePreparationContext(ctx); err != nil {
			return err
		}
	}
	e.hostnameMu.Lock()
	complete := len(e.hostnameAnswers) == len(e.hostnameTargets) && !e.hostnameFailed.Load() && !e.retired.Load()
	e.hostnameMu.Unlock()
	if !complete {
		return errRouterVPNCandidatePreparation
	}
	e.hostnamePrepared.Store(true)
	_, err = e.ObservePreparationContext(ctx)
	return err
}

// Only this purpose-bound request can reach the original entry control/front
// tuple. The native engine, preparation, packet endpoint and network generation
// stay the same; normal AllowsDial remains unchanged.
func (e *RouterVPNNodeChainCandidatePreparationEngine) DialAppendExecutionContext(ctx context.Context, request *mobilemultihop.NodeChainCandidateAppendExecutionDialRequest) (net.Conn, error) {
	if e == nil || request == nil {
		return nil, errRouterVPNCandidatePreparation
	}
	tag, address, err := request.Read(ctx, e, e.prep)
	if err != nil {
		return nil, err
	}
	identity, err := e.ObservePreparationContext(ctx)
	if err != nil || identity != e.identity {
		return nil, errors.Join(err, errRouterVPNCandidatePreparation)
	}
	retained := e.prefixes[tag]
	target, err := routerVPNExecutionDestination(address)
	if err != nil || retained == nil {
		return nil, errors.Join(err, errRouterVPNCandidatePreparation)
	}
	original, dialErr := retained.DialContext(ctx, "tcp", target)
	actualTag, actualAddress, currentErr := request.Read(ctx, e, e.prep)
	observed, observeErr := e.ObservePreparationContext(ctx)
	if actualTag != tag || actualAddress != address || observed != identity || original == nil {
		currentErr = errors.Join(currentErr, errRouterVPNCandidatePreparation)
	}
	return original, errors.Join(dialErr, currentErr, observeErr, ctx.Err())
}
