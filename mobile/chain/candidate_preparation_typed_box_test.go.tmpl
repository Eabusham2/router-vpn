package box

import (
	"encoding/json"
	"fmt"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"strings"
	"testing"
)

// The exact saved source compilers and original preparation Box adapter run.
// Existing explicit TUN/physical/encrypted packet doubles remain documented
// by newCandidatePreparationNativeFixture; this is not installed acceptance.
func TestRouterVPNNodeChainCandidatePreparationNativeTypedSavedSuffix(t *testing.T) {
	for _, family := range []string{"socks", "http", "https"} {
		for _, count := range []int{3, 4, 8} {
			t.Run(fmt.Sprintf("%s/%d", family, count), func(t *testing.T) {
				var source string
				var originalSHA string
				var err error
				if family == "socks" {
					original := socksMTUSourcePrefixes(t, count-2)
					source, err = original.Source()
					_, metadata, readErr := original.ReadValidated()
					if readErr != nil {
						t.Fatal(readErr)
					}
					originalSHA = metadata.SourceSHA256
				} else {
					original := connectMTUSourcePrefixes(t, count-2, "wg", family+"-connect", "captured.example")
					source, err = original.Source()
					_, metadata, readErr := original.ReadValidated()
					if readErr != nil {
						t.Fatal(readErr)
					}
					originalSHA = metadata.SourceSHA256
				}
				if err != nil {
					t.Fatal(err)
				}
				candidate := chainNativeSourceModes(t, []string{"wg", "wg", "wg", "wg", "wg", "wg", "wg"})
				input, err := candidate.LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
				var record mobilemultihop.NodeChainSource
				if err := json.Unmarshal([]byte(input), &record); err != nil {
					t.Fatal(err)
				}
				inventory := chainNativeJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-native-typed-catalog", Inputs: []string{record.Nodes[len(record.Nodes)-1]}})
				var prep *mobilemultihop.NodeChainCandidatePreparation
				if family == "socks" {
					prep, err = mobilemultihop.NewNodeChainSOCKSCandidatePreparation(source, count-3, inventory)
				} else {
					prep, err = mobilemultihop.NewNodeChainCONNECTCandidatePreparation(source, count-3, inventory)
				}
				if err != nil {
					t.Fatal("typed saved prefix did not reach original native preparation", err)
				}
				if prep.OriginalSourceSHA256() != originalSHA || strings.Contains(prep.Config(), "203.0.113.20") || strings.Contains(prep.Config(), "original-middle-password") || strings.Contains(prep.Config(), "original-password") {
					t.Fatal("typed uncontacted suffix lost identity or acquired runtime endpoint")
				}
				round, err := mobilemultihop.ParseNodeChainCandidatePreparationCapture(prep.Source())
				if err != nil || round.Config() != prep.Config() {
					t.Fatal("typed native source did not reopen exactly", err)
				}
				candidatePreparationNativeClosedPrefixAndFifty(t, prep, "chain-native-7", "198.51.100.27:8388")
			})
		}
	}
}
