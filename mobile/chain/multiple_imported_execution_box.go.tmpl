type routerVPNMultipleImportedExecutionKey struct{}

type routerVPNMultipleImportedExecutionConstruction struct {
	self           *routerVPNMultipleImportedExecutionConstruction
	externalFinal  bool
	prep           *mobilemultihop.NodeChainExecutionPreparation
	source         *mobilemultihop.NodeChain
	physical       *mobilemultihop.DesktopNodeChainMultipleImportedExecutionPhysicalPolicy
	publicPhysical *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy
	inventory      []mobilemultihop.NodeChainPublicMeasurementCapture
	digest         string
	resolverTag    string
	mu             sync.Mutex
	attempted      bool
	instance       *Box
	outbounds      adapter.OutboundManager
	transports     adapter.DNSTransportManager
	dns            adapter.DNSRouter
	resolver       adapter.DNSTransport
	members        []*shadowsocks.Outbound
	close          *RouterVPNNativeCloseReceipt
}

func RouterVPNNodeMultipleImportedExecutionContext(ctx context.Context, prep *mobilemultihop.NodeChainExecutionPreparation) (context.Context, error) {
	return routerVPNMultipleImportedExecutionContext(ctx, prep, nil, nil, false)
}

func RouterVPNDesktopNodeMultipleImportedExecutionContext(ctx context.Context, prep *mobilemultihop.NodeChainExecutionPreparation, physical *mobilemultihop.DesktopNodeChainMultipleImportedExecutionPhysicalPolicy) (context.Context, error) {
	if physical == nil {
		return nil, errRouterVPNExecutionOwner
	}
	return routerVPNMultipleImportedExecutionContext(ctx, prep, physical, nil, false)
}

func RouterVPNNodeExternalFinalExecutionContext(ctx context.Context, prep *mobilemultihop.NodeChainExecutionPreparation) (context.Context, error) {
	if prep.RequiresDesktopExternalFinalExecutionObserver() {
		return nil, errRouterVPNExecutionOwner
	}
	return routerVPNMultipleImportedExecutionContext(ctx, prep, nil, nil, true)
}

func RouterVPNDesktopNodeExternalFinalExecutionContext(ctx context.Context, prep *mobilemultihop.NodeChainExecutionPreparation, physical *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy) (context.Context, error) {
	if !prep.RequiresDesktopExternalFinalExecutionObserver() || physical == nil {
		return nil, errRouterVPNExecutionOwner
	}
	return routerVPNMultipleImportedExecutionContext(ctx, prep, nil, physical, true)
}

func (c *routerVPNMultipleImportedExecutionConstruction) readOriginal() (*mobilemultihop.NodeChain, []mobilemultihop.NodeChainPublicMeasurementCapture, error) {
	if !c.externalFinal {
		return c.prep.ReadMultipleImportedNativeMembers()
	}
	return c.prep.ReadExternalFinalNativeMembers()
}

func routerVPNMultipleImportedExecutionContext(ctx context.Context, prep *mobilemultihop.NodeChainExecutionPreparation, physical *mobilemultihop.DesktopNodeChainMultipleImportedExecutionPhysicalPolicy, publicPhysical *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy, externalFinal bool) (context.Context, error) {
	if ctx == nil || ctx.Err() != nil || prep == nil || ctx.Value(routerVPNOrderedTypedConstructionKey{}) != nil || ctx.Value(routerVPNMultipleImportedExecutionKey{}) != nil {
		return nil, errRouterVPNExecutionOwner
	}
	c := &routerVPNMultipleImportedExecutionConstruction{prep: prep, physical: physical, publicPhysical: publicPhysical, externalFinal: externalFinal}
	source, inventory, err := c.readOriginal()
	if err != nil || source == nil {
		return nil, errRouterVPNExecutionOwner
	}
	dns, err := prep.DNSCapture()
	if err != nil || dns.DNS.ResolverTag == "" {
		return nil, errRouterVPNExecutionOwner
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(prep.Config()))
	if err != nil {
		return nil, err
	}
	c.source, c.inventory, c.resolverTag, c.digest = source, inventory, dns.DNS.ResolverTag, routerVPNNodeChainExecutionOptionsDigest(ctx, options)
	c.self = c
	if c.digest == "" || c.validateSource(ctx) != nil {
		return nil, errRouterVPNExecutionOwner
	}
	ctx = context.WithValue(ctx, routerVPNOrderedTypedConstructionKey{}, true)
	return context.WithValue(ctx, routerVPNMultipleImportedExecutionKey{}, c), nil
}

func (c *routerVPNMultipleImportedExecutionConstruction) validateSource(ctx context.Context) error {
	if c == nil || c.self != c || ctx == nil || ctx.Err() != nil || c.prep == nil || c.source == nil || c.externalFinal != c.prep.RequiresExternalFinalExecutionObserver() || (c.physical != nil) != c.prep.RequiresDesktopMultipleImportedExecutionObserver() || (c.publicPhysical != nil) != c.prep.RequiresDesktopExternalFinalExecutionObserver() {
		return errRouterVPNExecutionOwner
	}
	source, captured, err := c.readOriginal()
	if err != nil || source != c.source || !slices.Equal(captured, c.inventory) {
		return errRouterVPNExecutionOwner
	}
	if c.publicPhysical != nil {
		owner, err := c.prep.DesktopPhysicalPolicy()
		if err != nil || owner != c.publicPhysical {
			return errRouterVPNExecutionOwner
		}
		parent, _, err := owner.ReadOriginalValidated(c.prep)
		if err != nil || parent.OriginalChain() != source {
			return errRouterVPNExecutionOwner
		}
	}
	if c.physical != nil {
		_, original, _, err := c.physical.ReadOriginalSourceValidated(c.prep)
		if err != nil || original != source {
			return errRouterVPNExecutionOwner
		}
	}
	return ctx.Err()
}

func routerVPNMultipleImportedExecutionOptions(ctx context.Context, options option.Options) error {
	if ctx == nil || ctx.Value(routerVPNMultipleImportedExecutionKey{}) == nil {
		return nil
	}
	c, ok := ctx.Value(routerVPNMultipleImportedExecutionKey{}).(*routerVPNMultipleImportedExecutionConstruction)
	if !ok || c.validateSource(ctx) != nil || c.digest != routerVPNNodeChainExecutionOptionsDigest(ctx, options) {
		return errRouterVPNExecutionOwner
	}
	if err := adapter.RouterVPNLockContext(ctx, &c.mu); err != nil {
		return err
	}
	defer c.mu.Unlock()
	if c.attempted || ctx.Err() != nil {
		return errRouterVPNExecutionOwner
	}
	c.attempted = true
	return nil
}

// Bind exact native objects as the original Box is returned from construction.
// A partially constructed inventory remains ineligible for admission.
func routerVPNMultipleImportedExecutionBind(s *Box) {
	if s == nil || s.ctx == nil {
		return
	}
	c, ok := s.ctx.Value(routerVPNMultipleImportedExecutionKey{}).(*routerVPNMultipleImportedExecutionConstruction)
	if !ok || c.validateSource(s.ctx) != nil {
		return
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	if !c.attempted || c.instance != nil {
		return
	}
	c.instance = s
	c.close = s.RouterVPNCaptureCloseReceipt()
	if s.outbound == nil || s.dnsTransport == nil || s.dnsRouter == nil {
		return
	}
	c.outbounds, c.transports, c.dns = s.outbound, s.dnsTransport, s.dnsRouter
	resolver, found, err := adapter.RouterVPNTransportContext(s.ctx, c.transports, c.resolverTag)
	if err != nil || !found || resolver == nil {
		return
	}
	c.resolver = resolver
	members := make([]*shadowsocks.Outbound, 0, len(c.inventory))
	for _, member := range c.inventory {
		retained, found, err := adapter.RouterVPNOutboundContext(s.ctx, c.outbounds, member.Tag)
		actual, ok := retained.(*shadowsocks.Outbound)
		if err != nil || !found || !ok || actual == nil || actual.Tag() != member.Tag || slices.Contains(members, actual) {
			return
		}
		members = append(members, actual)
	}
	c.members = members
}

func (e *RouterVPNNodeChainExecutionEngine) multipleImportedConstruction(ctx context.Context, source *mobilemultihop.NodeChain) (*routerVPNMultipleImportedExecutionConstruction, error) {
	if e == nil || e.prep == nil || e.instance == nil || e.instance.ctx == nil || source == nil {
		return nil, errRouterVPNExecutionOwner
	}
	c, ok := e.instance.ctx.Value(routerVPNMultipleImportedExecutionKey{}).(*routerVPNMultipleImportedExecutionConstruction)
	if !ok || c == nil || c.prep != e.prep || source != c.source || c.validateSource(ctx) != nil {
		return nil, errRouterVPNExecutionOwner
	}
	if err := adapter.RouterVPNLockContext(ctx, &c.mu); err != nil {
		return nil, err
	}
	defer c.mu.Unlock()
	if !c.attempted || c.instance != e.instance || c.close == nil || len(c.members) != len(c.inventory) || c.outbounds != e.instance.outbound || c.transports != e.instance.dnsTransport ||
		c.dns != e.instance.dnsRouter || c.resolver == nil || c.resolver != e.resolver || e.originalResolvers[c.resolverTag] != c.resolver {
		return nil, errRouterVPNExecutionOwner
	}
	for i, member := range c.inventory {
		if c.members[i] == nil || c.members[i] != e.originalOutbounds[member.Tag] {
			return nil, errRouterVPNExecutionOwner
		}
	}
	return c, nil
}

func (e *RouterVPNNodeChainExecutionEngine) ObserveMultipleImportedExecutionContext(ctx context.Context, source *mobilemultihop.NodeChain) error {
	return e.observeCapturedImportedExecution(ctx, source, false)
}
func (e *RouterVPNNodeChainExecutionEngine) ObserveExternalFinalExecutionContext(ctx context.Context, source *mobilemultihop.NodeChain) error {
	return e.observeCapturedImportedExecution(ctx, source, true)
}

// Read the same original selector generation around the complete live
// observation, including native TUN ingress, resolver and every prefix.
func (e *RouterVPNNodeChainExecutionEngine) ObserveExternalFinalSelectionContext(ctx context.Context, source *mobilemultihop.NodeChain) (mobilemultihop.NodeChainIdentity, string, uint64, error) {
	return e.observeImportedSelection(ctx, source, true)
}

func (e *RouterVPNNodeChainExecutionEngine) ObserveRegisteredPrivateSelectionContext(ctx context.Context, source *mobilemultihop.NodeChain) (mobilemultihop.NodeChainIdentity, string, uint64, error) {
	return e.observeImportedSelection(ctx, source, false)
}

func (e *RouterVPNNodeChainExecutionEngine) observeImportedSelection(ctx context.Context, source *mobilemultihop.NodeChain, externalFinal bool) (mobilemultihop.NodeChainIdentity, string, uint64, error) {
	empty := mobilemultihop.NodeChainIdentity{}
	if e == nil || e.selector == nil || e.instance == nil || e.instance.ctx == nil {
		return empty, "", 0, errRouterVPNExecutionOwner
	}
	c, ok := e.instance.ctx.Value(routerVPNMultipleImportedExecutionKey{}).(*routerVPNMultipleImportedExecutionConstruction)
	if !ok || c == nil || c.externalFinal != externalFinal || c.source != source || c.prep != e.prep || !externalFinal && !e.prep.RequiresRegisteredPrivateFinalObservation() {
		return empty, "", 0, errRouterVPNExecutionOwner
	}
	state := e.state.Load()
	if state == nil || state.stage != 2 {
		return empty, "", 0, errRouterVPNExecutionOwner
	}
	epoch, tag := e.selector.RouterVPNNodeChainSelectionEpoch(), e.selector.Now()
	identity, err := e.ObserveChainContext(ctx)
	if err != nil {
		return empty, "", 0, err
	}
	if e.state.Load() != state || epoch == 0 || tag == "" || tag != e.selector.Now() || epoch != e.selector.RouterVPNNodeChainSelectionEpoch() || ctx.Err() != nil {
		return empty, "", 0, errRouterVPNExecutionOwner
	}
	return identity, tag, epoch, nil
}

// Keep the reader, permit and selector generation stable across both actual
// native observations. ApplicationOpenContext independently reads the gate.
func (e *RouterVPNNodeChainExecutionEngine) ObserveExternalFinalOpenSelectionContext(ctx context.Context, source *mobilemultihop.NodeChain) (mobilemultihop.NodeChainIdentity, string, uint64, bool, error) {
	return e.observeImportedOpenSelection(ctx, source, true)
}

func (e *RouterVPNNodeChainExecutionEngine) ObserveRegisteredPrivateOpenSelectionContext(ctx context.Context, source *mobilemultihop.NodeChain) (mobilemultihop.NodeChainIdentity, string, uint64, bool, error) {
	return e.observeImportedOpenSelection(ctx, source, false)
}

func (e *RouterVPNNodeChainExecutionEngine) observeImportedOpenSelection(ctx context.Context, source *mobilemultihop.NodeChain, externalFinal bool) (mobilemultihop.NodeChainIdentity, string, uint64, bool, error) {
	empty := mobilemultihop.NodeChainIdentity{}
	if e == nil || ctx == nil || ctx.Err() != nil {
		return empty, "", 0, false, errRouterVPNExecutionOwner
	}
	state, reader, permit := e.state.Load(), e.reader.Load(), e.permit.Load()
	if state == nil || reader == nil || permit == nil || permit.state != state {
		return empty, "", 0, false, errRouterVPNExecutionOwner
	}
	identity, tag, epoch, err := e.observeImportedSelection(ctx, source, externalFinal)
	if err != nil || permit.tag != tag || permit.epoch != epoch {
		return empty, "", 0, false, errors.Join(err, errRouterVPNExecutionOwner)
	}
	open, err := e.ApplicationOpenContext(ctx)
	if err != nil || !open || ctx.Err() != nil || e.state.Load() != state || e.reader.Load() != reader || e.permit.Load() != permit ||
		tag != e.selector.Now() || epoch != e.selector.RouterVPNNodeChainSelectionEpoch() {
		return empty, "", 0, false, errors.Join(err, errRouterVPNExecutionOwner)
	}
	return identity, tag, epoch, true, nil
}

func (e *RouterVPNNodeChainExecutionEngine) observeCapturedImportedExecution(ctx context.Context, source *mobilemultihop.NodeChain, externalFinal bool) error {
	c, err := e.multipleImportedConstruction(ctx, source)
	if err != nil || c.externalFinal != externalFinal {
		return errors.Join(err, errRouterVPNExecutionOwner)
	}
	s := e.instance
	if s.ctx.Err() != nil || s.done == nil {
		return errRouterVPNExecutionOwner
	}
	select {
	case <-s.done:
		return errRouterVPNExecutionOwner
	default:
	}
	for i, member := range c.inventory {
		actual, found, err := adapter.RouterVPNOutboundContext(ctx, c.outbounds, member.Tag)
		if err != nil || !found || actual != c.members[i] {
			return errors.Join(errRouterVPNExecutionOwner, err)
		}
	}
	actual, found, err := adapter.RouterVPNTransportContext(ctx, c.transports, c.resolverTag)
	if err != nil || !found || actual != c.resolver {
		return errors.Join(errRouterVPNExecutionOwner, err)
	}
	if s.ctx.Err() != nil {
		return errRouterVPNExecutionOwner
	}
	select {
	case <-s.done:
		return errRouterVPNExecutionOwner
	default:
		return ctx.Err()
	}
}

func (e *RouterVPNNodeChainExecutionEngine) observeTypedMultipleImported(ctx context.Context) error {
	if e == nil || e.prep == nil || e.instance == nil || e.instance.ctx == nil {
		return errRouterVPNExecutionOwner
	}
	raw := e.instance.ctx.Value(routerVPNMultipleImportedExecutionKey{})
	if !e.prep.RequiresMultipleImportedExecutionObserver() && !e.prep.RequiresExternalFinalExecutionObserver() {
		if raw != nil {
			return errRouterVPNExecutionOwner
		}
		return nil
	}
	c, ok := raw.(*routerVPNMultipleImportedExecutionConstruction)
	if !ok || c == nil {
		return errRouterVPNExecutionOwner
	}
	if e.prep.RequiresExternalFinalExecutionObserver() {
		return e.ObserveExternalFinalExecutionContext(ctx, c.source)
	}
	return e.ObserveMultipleImportedExecutionContext(ctx, c.source)
}

func (e *RouterVPNNodeChainExecutionEngine) MultipleImportedExecutionRetiredContext(ctx context.Context, source *mobilemultihop.NodeChain) error {
	return e.importedExecutionRetired(ctx, source, false)
}
func (e *RouterVPNNodeChainExecutionEngine) ExternalFinalExecutionRetiredContext(ctx context.Context, source *mobilemultihop.NodeChain) error {
	return e.importedExecutionRetired(ctx, source, true)
}
func (e *RouterVPNNodeChainExecutionEngine) importedExecutionRetired(ctx context.Context, source *mobilemultihop.NodeChain, externalFinal bool) error {
	c, err := e.multipleImportedConstruction(ctx, source)
	if err != nil || c.externalFinal != externalFinal {
		return errors.Join(err, errRouterVPNExecutionOwner)
	}
	state := e.state.Load()
	current := func() error {
		if state == nil || state.stage != 3 || e.state.Load() != state || e.control == nil || !e.revoked.Load() || e.permit.Load() != nil || e.opening.Load() || e.revoking.Load() != 0 || e.stops.Load() != 0 || e.busy.Load() {
			return errRouterVPNExecutionOwner
		}
		closed, err := e.control.ObserveClosedContext(ctx)
		if err != nil || !closed.Closed || closed.Open || !closed.Drained || closed.Identity != e.gateID {
			return errRouterVPNExecutionOwner
		}
		return ctx.Err()
	}
	if err := current(); err != nil {
		return err
	}
	if err := c.close.JoinContext(ctx, c.instance); err != nil {
		return err
	}
	retained, err := e.multipleImportedConstruction(ctx, source)
	if err != nil || retained != c {
		return errors.Join(errRouterVPNExecutionOwner, err)
	}
	return current()
}

var _ mobilemultihop.NodeChainMultipleImportedExecutionObserver = (*RouterVPNNodeChainExecutionEngine)(nil)
var _ mobilemultihop.NodeChainMultipleImportedExecutionRetiredObserver = (*RouterVPNNodeChainExecutionEngine)(nil)
