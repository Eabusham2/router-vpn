func multipleImportedNativeFixture(t *testing.T, name, execution string, concrete bool) (*executionNativeFixture, *mobilemultihop.NodeChain) {
	t.Helper()
	dir := os.Getenv("ROUTERVPN_MULTIPLE_IMPORTED_EXECUTION_NATIVE_FIXTURES")
	if dir == "" {
		t.Fatal("original independent Local and Server fixtures are required")
	}
	raw, err := os.ReadFile(filepath.Join(dir, name+".json"))
	var input struct{ Local, Server string }
	if err != nil || json.Unmarshal(raw, &input) != nil {
		t.Fatal("original multiple imported fixture", err)
	}
	original, err := mobilemultihop.ParseNodeChainLaunchInput(input.Local)
	if err != nil {
		t.Fatal(err)
	}
	prep, err := mobilemultihop.NewNodeChainMultipleImportedExecutionPreparation(original, execution)
	if err != nil {
		t.Fatal(err)
	}
	server, err := mobilemultihop.NewNodeChainMultipleImportedServerPolicy(input.Server)
	if err != nil {
		t.Fatal(err)
	}
	hook := executionNativeConstructionHook{
		context: func(ctx context.Context) (context.Context, error) {
			return RouterVPNNodeMultipleImportedExecutionContext(ctx, prep)
		},
		options: routerVPNNodeSOCKSOptions, created: func(s *Box) { routerVPNNodeSOCKSBind(s) },
	}
	if concrete {
		hook.registry = func(r *outbound.Registry) error { shadowsocks.RegisterOutbound(r); return nil }
	}
	return newExecutionNativeFixtureWithSources(t, prep, server, nil, hook), original
}

func TestRouterVPNMultipleImportedExecutionNativeOwners(t *testing.T) {
	for _, layout := range []string{"single", "adjacent", "separated", "maximum-public"} {
		for _, execution := range []string{"server", "auto"} {
			t.Run(layout+"/"+execution, func(t *testing.T) {
				f, source := multipleImportedNativeFixture(t, layout, execution, true)
				p := f.adopt(t)
				for _, selected := range []string{"local", "server"} {
					dns, err := p.DNSCapture(selected)
					if err != nil || f.engine.SelectContext(t.Context(), dns.SelectedTag) != nil {
						t.Fatal("selected route missing", err)
					}
					members, _, err := p.ImportedPublicMeasurementCaptures(selected)
					if err != nil || len(members) == 0 {
						t.Fatal("per-position public inventory missing", err)
					}
					if err = f.engine.ObserveMultipleImportedExecutionContext(t.Context(), source); err != nil {
						t.Fatal("original native owner", err)
					}
					if open, err := f.engine.ApplicationOpenContext(t.Context()); err != nil || open {
						t.Fatal("unproved public route opened", err)
					}
				}
			})
		}
	}
}

func TestRouterVPNMultipleImportedExecutionNativeAuthority(t *testing.T) {
	for _, fault := range []string{"equal-source", "copied-construction", "missing-member", "swapped-members", "manager-lookup", "resolver", "ordinary-outbound", "cancelled", "second-box"} {
		t.Run(fault, func(t *testing.T) {
			f, source := multipleImportedNativeFixture(t, "separated", "server", fault != "ordinary-outbound")
			e, err := f.capture(t.Context())
			if fault == "ordinary-outbound" {
				if err == nil {
					t.Fatal("non-Shadowsocks outbound acquired public ownership")
				}
				return
			}
			if err != nil {
				t.Fatal(err)
			}
			ctx := t.Context()
			c := f.ctx.Value(routerVPNMultipleImportedExecutionKey{}).(*routerVPNMultipleImportedExecutionConstruction)
			switch fault {
			case "equal-source":
				launch, err := source.LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
				source, err = mobilemultihop.ParseNodeChainLaunchInput(launch)
				if err != nil {
					t.Fatal(err)
				}
			case "copied-construction":
				before := f.box.ctx
				f.box.ctx = context.WithValue(before, routerVPNMultipleImportedExecutionKey{}, &routerVPNMultipleImportedExecutionConstruction{self: c})
				defer func() { f.box.ctx = before }()
			case "missing-member":
				members := c.members
				c.members = c.members[:1]
				defer func() { c.members = members }()
			case "swapped-members":
				c.members[0], c.members[1] = c.members[1], c.members[0]
				defer func() { c.members[0], c.members[1] = c.members[1], c.members[0] }()
			case "manager-lookup":
				tag := c.inventory[1].Tag
				before := e.originalOutbounds[tag]
				delete(e.originalOutbounds, tag)
				defer func() { e.originalOutbounds[tag] = before }()
			case "resolver":
				before := e.resolver
				e.resolver = nil
				defer func() { e.resolver = before }()
			case "cancelled":
				var cancel context.CancelFunc
				ctx, cancel = context.WithCancel(ctx)
				cancel()
			case "second-box":
				if _, err := RouterVPNNodeMultipleImportedExecutionContext(f.ctx, f.prep); err == nil {
					t.Fatal("second native construction acquired original graph")
				}
				options, err := SJ.UnmarshalExtendedContext[option.Options](f.ctx, []byte(f.prep.Config()))
				if err != nil {
					t.Fatal(err)
				}
				if err := routerVPNMultipleImportedExecutionOptions(f.ctx, options); err == nil {
					t.Fatal("original construction accepted a second Box")
				}
				return
			}
			if e.ObserveMultipleImportedExecutionContext(ctx, source) == nil {
				t.Fatal("lost original multiple-import owner accepted")
			}
		})
	}
}

func TestRouterVPNMultipleImportedExecutionNativePublicServer(t *testing.T) {
	for _, position := range []int{1, 3} {
		for _, fault := range []string{"original", "away-and-back", "foreign-tag", "foreign-address"} {
			t.Run(fmt.Sprintf("pos-%d/%s", position, fault), func(t *testing.T) {
				f, _ := multipleImportedNativeFixture(t, "separated", "server", true)
