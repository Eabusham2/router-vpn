}
func TestRouterVPNMultipleImportedExecutionNativeRetirement(t *testing.T) {
	for _, fault := range []string{"success", "original-error"} {
		t.Run(fault, func(t *testing.T) {
			f, original := multipleImportedNativeFixture(t, "adjacent", "server", true)
			f.adopt(t)
			e := f.engine
			if e.MultipleImportedExecutionRetiredContext(t.Context(), original) == nil {
				t.Fatal("live multiple-import owner fabricated native retirement")
			}
			if err := e.RetireContext(t.Context()); err != nil {
				t.Fatal(err)
			}
			f.engine = nil // The exact engine was explicitly retired above.
			if e.MultipleImportedExecutionRetiredContext(t.Context(), original) == nil {
				t.Fatal("closed multiple-import gate substituted for original Box close")
			}
			held := executionReadbackCloseFixture(t, f)
			sentinel := errors.New("original multiple-import native service close failed")
			if fault == "original-error" {
				held.failure = sentinel
			}
			var release sync.Once
			joined := make(chan struct{})
			done := make(chan error, 1)
			defer func() {
				release.Do(func() { close(held.release) })
				select {
				case <-joined:
				case <-time.After(3 * time.Second):
					t.Error("original multiple-import native close did not join")
				}
			}()
			go func() { defer close(joined); done <- f.box.Close() }()
			select {
			case <-held.entered:
			case <-time.After(3 * time.Second):
				t.Fatal("actual multiple-import Box close did not reach original service")
			}
			ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
			err := e.MultipleImportedExecutionRetiredContext(ctx, original)
			cancel()
			if !errors.Is(err, context.DeadlineExceeded) {
				t.Fatal("early multiple-import native done fabricated joined retirement", err)
			}
			release.Do(func() { close(held.release) })
			select {
			case err = <-done:
			case <-time.After(3 * time.Second):
				t.Fatal("original multiple-import Box close did not return")
			}
			if fault == "success" && err != nil || fault == "original-error" && !errors.Is(err, sentinel) {
				t.Fatal("original multiple-import Box close result changed", err)
			}
			f.current.Store(false)
			err = e.MultipleImportedExecutionRetiredContext(t.Context(), original)
			if fault == "success" && err != nil || fault == "original-error" && !errors.Is(err, sentinel) {
				t.Fatal("multiple-import retirement lost the original joined close result", err)
			}
			launch, err := original.LaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			foreign, err := mobilemultihop.ParseNodeChainLaunchInput(launch)
			if err != nil {
				t.Fatal(err)
			}
			if e.MultipleImportedExecutionRetiredContext(t.Context(), foreign) == nil {
				t.Fatal("equal foreign multiple-import source borrowed joined close")
			}
		})
	}
}

func TestRouterVPNMultipleImportedExecutionNativeLast(t *testing.T) {
	for _, winner := range []string{"local", "server"} {
		t.Run(winner, func(t *testing.T) {
			f, source := multipleImportedNativeFixture(t, "separated", "auto", true)
			last := executionLastRecord(t, f, winner)
			e, err := f.capture(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			if _, err = e.AdoptLastContext(t.Context(), last); err == nil {
				t.Fatal("saved selection bypassed discovery")
			}
			f.discovery(t)
			if _, err = e.DiscoverContext(t.Context()); err != nil {
				t.Fatal(err)
			}
			original, reader := e.discovery.Load(), e.reader.Load()
			plan, err := e.AdoptLastContext(t.Context(), last)
			if err != nil || plan.RequireJoinedContext(t.Context()) != nil || e.discovery.Load() != original || e.reader.Load() != reader || e.ObserveMultipleImportedExecutionContext(t.Context(), source) != nil {
				t.Fatal("Last lost original discovery, reader or member registry", err)
			}
			if open, err := e.ApplicationOpenContext(t.Context()); open || err != nil {
				t.Fatal("Last made an unproved route usable", err)
			}
		})
	}
}
