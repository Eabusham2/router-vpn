	connection := route.NewConnectionManager(logger)
	service.MustRegister[adapter.ConnectionManager](f.ctx, connection)
	router := route.NewRouter(f.ctx, factory, *options.Route, *options.DNS)
	service.MustRegister[adapter.Router](f.ctx, router)
