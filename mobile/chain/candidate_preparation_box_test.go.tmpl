func (f *candidatePreparationNativeFixture) capture(ctx context.Context) (*RouterVPNNodeChainCandidatePreparationEngine, error) {
	engine, err := f.box.RouterVPNNewNodeChainCandidatePreparationEngine(ctx, f.prep, strings.Repeat("c", 32), func(ctx context.Context) error {
		if !f.current.Load() {
			return errors.New("original native preparation replaced")
		}
		return ctx.Err()
	})
	f.engine = engine
	return engine, err
}

type candidatePreparationNativeOwner struct {
	*RouterVPNNodeChainCandidatePreparationEngine
	capture   string
	measuring atomic.Bool
	released  atomic.Int32
}

func (o *candidatePreparationNativeOwner) CandidateInventoryCurrentContext(ctx context.Context, capture string) error {
	if capture != o.capture {
		return errors.New("native fixture catalog changed")
	}
	return ctx.Err()
}
func (o *candidatePreparationNativeOwner) BeginMeasurementContext(ctx context.Context) (func(), error) {
	if ctx.Err() != nil || !o.measuring.CompareAndSwap(false, true) {
		return nil, errors.New("native measurement occupied")
	}
	return func() { o.released.Add(1); o.measuring.Store(false) }, nil
}
func TestRouterVPNNodeChainCandidatePreparationNativeClosedPrefixAndFifty(t *testing.T) {
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		t.Run(mode, func(t *testing.T) {
			prep := candidatePreparationNativeSource(t, mode)
			f := newCandidatePreparationNativeFixture(t, prep, nil)
			meta := adapter.InboundContext{Inbound: "routervpn-chain-tun", InboundType: C.TypeTun, Destination: M.ParseSocksaddr("192.168.50.133:53")}
			if !f.box.router.RouterVPNNodeChainGated() || f.box.router.PreMatch(meta, nil).Action != adapter.PreMatchDrop {
				t.Fatal("pending candidate preparation opened native DNS ingress")
			}
			for position, proof := range prep.ProofInventory() {
				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
					if r.URL.Path != "/health" || r.Host != "10.77.0.1:8787" || r.Header.Get("Authorization") != fmt.Sprintf("Bearer chain-native-token-%d", position) {
						t.Error("native prefix used another private proof")
						w.WriteHeader(401)
						return
					}
					_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "node_id": proof.NodeID, "proof": "router-vpn-private-agent-v1"})
				}))
				t.Cleanup(server.Close)
				f.prefixes[proof.Tag].dial = func(ctx context.Context) (net.Conn, error) {
					return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
				}
			}
			engine, err := f.capture(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			owner := &candidatePreparationNativeOwner{RouterVPNNodeChainCandidatePreparationEngine: engine, capture: prep.CaptureSHA256()}
			runtime, err := mobilemultihop.NewNodeChainCandidatePreparationRuntime(prep, owner)
			if err != nil {
				t.Fatal(err)
			}
			defer runtime.CloseContext(context.Background())
			if err := runtime.StartContext(t.Context()); err != nil {
				t.Fatal(err)
			}
			if f.box.router.PreMatch(meta, nil).Action != adapter.PreMatchDrop {
				t.Fatal("prepared candidate purpose opened native DNS ingress")
			}
			meta.Destination = M.ParseSocksaddr("203.0.113.10:443")
			if f.box.router.PreMatch(meta, nil).Action != adapter.PreMatchDrop {
				t.Fatal("prepared candidate purpose opened native application ingress")
			}
			measurement, err := runtime.NewMeasurementContext(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			defer measurement.Close()
			request := strings.Repeat("a", 32)
			deadline := time.Now().Add(hopmeasure.RequestTimeout)
			if err := measurement.Start(request, "chain-native-3"); err != nil {
				t.Fatal(err)
			}
			// Drain bounds one cleanup observation, not all fifty samples.
			// Retain the exact worker and retry within its existing full budget.
			for {
				if err := measurement.Drain(request); err == nil {
					break
				}
				if !time.Now().Before(deadline) {
					t.Fatal("native candidate worker exceeded its existing request budget", measurement.StatusJSON())
				}
				t.Log("original native candidate worker remains owned", f.prefixes[prep.ProofInventory()[1].Tag].candidateDials.Load())
			}
			var status hopmeasure.CandidateStatus
			if err := json.Unmarshal([]byte(measurement.StatusJSON()), &status); err != nil {
				t.Fatal(err)
			}
			if !status.Complete || !status.Drained || len(status.Results) != 1 || !status.Results[0].Ready || status.Results[0].Benchmark == nil || status.Results[0].Benchmark.Attempts != 50 || f.prefixes[prep.ProofInventory()[1].Tag].candidateDials.Load() != 50 {
				t.Fatal("native prefix lost original proofs or fifty candidate connections", status, f.prefixes[prep.ProofInventory()[1].Tag].candidateDials.Load())
			}
			if len(f.prefixes) != 2 || owner.measuring.Load() || owner.released.Load() != 1 {
				t.Fatal("native preparation acquired suffix or lost measurement hold")
			}
			for _, resolver := range f.resolvers {
				if resolver.calls.Load() != 0 {
					t.Fatal("candidate preparation queried saved DNS")
				}
			}
			connection, err := engine.Dial(t.Context(), prep.ProofInventory()[0].Tag, "198.51.100.23:8388")
			if connection != nil {
				_ = connection.Close()
			}
			if err == nil {
				t.Fatal("native candidate dial bypassed selected prefix")
			}
			connection, err = engine.Dial(t.Context(), prep.ProofInventory()[1].Tag, "1.1.1.1:443")
			if connection != nil {
				_ = connection.Close()
			}
			if err == nil {
				t.Fatal("native candidate dial acquired unselected public proof")
			}
		})
	}
}
func TestRouterVPNNodeChainCandidatePreparationNativeRejectsActualGraph(t *testing.T) {
	for _, fault := range []string{"mtu", "rule", "key"} {
		t.Run(fault, func(t *testing.T) {
			prep := candidatePreparationNativeSource(t, "wg")
			f := newCandidatePreparationNativeFixture(t, prep, func(graph map[string]any) {
				switch fault {
				case "mtu":
					graph["inbounds"].([]any)[0].(map[string]any)["mtu"] = 1281
				case "rule":
					graph["route"].(map[string]any)["rules"] = []any{}
				case "key":
					graph["endpoints"].([]any)[0].(map[string]any)["private_key"] = strings.Repeat("a", 43) + "="
				}
			})
			if engine, err := f.capture(t.Context()); err == nil || engine != nil {
				t.Fatal("changed actual prefix graph acquired preparation", fault)
			}
		})
	}
}
func TestRouterVPNNodeChainCandidatePreparationNativeKeepsExactGate(t *testing.T) {
	f := newCandidatePreparationNativeFixture(t, candidatePreparationNativeSource(t, "wg"), nil)
	engine, err := f.capture(t.Context())
	if err != nil {
		t.Fatal(err)
	}
	duplicate, err := f.box.RouterVPNNewNodeChainCandidatePreparationEngine(t.Context(), f.prep, strings.Repeat("d", 32), func(ctx context.Context) error { return ctx.Err() })
	if err == nil || duplicate != nil {
		t.Fatal("duplicate prefix owner borrowed original gate cleanup")
	}
	if _, err := engine.ObservePreparationContext(t.Context()); err != nil {
		t.Fatal("duplicate retired original preparation", err)
	}
	if err := engine.control.Open(t.Context()); err != nil {
		t.Fatal(err)
	}
	if _, err := engine.ObservePreparationContext(t.Context()); err == nil {
		t.Fatal("opened gate remained prefix-only preparation")
	}
	f.current.Store(false)
	if err := engine.RetireContext(t.Context()); err != nil {
		t.Fatal("retired source stranded exact native gate", err)
	}
	state, err := engine.control.ObserveClosedContext(t.Context())
	if err != nil || !state.Closed || !state.Drained || state.Open {
		t.Fatal("native prefix cleanup lost exact closed receipt", state, err)
	}
}

type candidatePreparationDeniedInput struct {
	entered, release chan struct{}
	once             sync.Once
	failed           atomic.Bool
	calls            atomic.Int32
}

var candidatePreparationDeniedFailure = errors.New("original denied native input close failed")

func (c *candidatePreparationDeniedInput) Close() error {
	c.calls.Add(1)
	c.once.Do(func() { close(c.entered) })
	<-c.release
	if c.failed.Load() {
		return candidatePreparationDeniedFailure
	}
	return nil
}
func TestRouterVPNNodeChainCandidatePreparationNativeDeniedInputRetainsRetirement(t *testing.T) {
	for _, kind := range []string{"held", "failed-close"} {
		t.Run(kind, func(t *testing.T) {
			f := newCandidatePreparationNativeFixture(t, candidatePreparationNativeSource(t, "wg"), nil)
			engine, err := f.capture(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			original := engine.control
			input := &candidatePreparationDeniedInput{entered: make(chan struct{}), release: make(chan struct{})}
			input.failed.Store(kind == "failed-close")
			var once sync.Once
			release := func() { once.Do(func() { close(input.release) }) }
			defer release()
			if _, err := engine.gate.RetireInbound(input); err != nil {
				t.Fatal(err)
			}
			<-input.entered
			if _, err := engine.ObservePreparationContext(t.Context()); err != nil {
				t.Fatal("closed denied input substituted for forwarding admission", err)
			}
			meta := adapter.InboundContext{Inbound: "routervpn-chain-tun", InboundType: C.TypeTun, Destination: M.ParseSocksaddr("192.168.50.133:53")}
			if f.box.router.PreMatch(meta, nil).Action != adapter.PreMatchDrop {
				t.Fatal("pending denied close opened candidate DNS ingress")
			}
			// Actual allowed-prefix dialing can continue; no application flow or
			// ordinary connected proof is derived from this low-level owner check.
			first, second := net.Pipe()
			defer second.Close()
			f.prefixes[f.prep.ProofInventory()[1].Tag].dial = func(context.Context) (net.Conn, error) { return first, nil }
			conn, err := engine.Dial(t.Context(), f.prep.ProofInventory()[1].Tag, "198.51.100.23:8388")
			if conn != nil {
				_ = conn.Close()
			}
			if err != nil {
				t.Fatal("closed denied input blocked captured candidate endpoint", err)
			}
			ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
			defer cancel()
			if err := engine.RetireContext(ctx); !errors.Is(err, context.DeadlineExceeded) {
				t.Fatal("unjoined denied input allowed native prefix retirement", err)
			}
			if engine.control != original {
				t.Fatal("failed retirement discarded original gate cleanup")
			}
			if _, err := engine.ObservePreparationContext(t.Context()); err == nil {
				t.Fatal("retiring prefix regained proof authority")
			}
			release()
			if kind == "failed-close" {
				if err := engine.RetireContext(t.Context()); !errors.Is(err, candidatePreparationDeniedFailure) {
					t.Fatal("failed denied input close became retirement", err)
				}
				input.failed.Store(false)
			}
			if err := engine.RetireContext(t.Context()); err != nil {
				t.Fatal("exact denied input retry failed", err)
			}
			state, err := original.ObserveClosedContext(t.Context())
			if err != nil || !state.Closed || !state.Drained || state.Open {
				t.Fatal("denied input lacked exact joined native receipt", state, err)
			}
		})
	}
}
