// Actual pinned managers, parsed prefix graph, selector and DNS/TUN gates run.
// Privileged TUN/physical monitor/encrypted packet I/O are explicit boundaries.
type candidatePreparationNativePrefix struct {
	*chainNativePrefix
	candidateDials atomic.Int32
}

func (p *candidatePreparationNativePrefix) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	if destination.String() == "198.51.100.23:8388" {
		p.candidateDials.Add(1)
	}
	return p.chainNativePrefix.DialContext(ctx, network, destination)
}

type candidatePreparationNativeFixture struct {
	prep      *mobilemultihop.NodeChainCandidatePreparation
	box       *Box
	engine    *RouterVPNNodeChainCandidatePreparationEngine
	prefixes  map[string]*candidatePreparationNativePrefix
	resolvers []*executionNativeDNS
	current   atomic.Bool
	ctx       context.Context
}

func candidatePreparationNativeSource(t *testing.T, mode string) *mobilemultihop.NodeChainCandidatePreparation {
	t.Helper()
	chain := chainNativeSourceModes(t, []string{mode, mode})
	source, err := chain.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var original mobilemultihop.NodeChainSource
	if err := json.Unmarshal([]byte(source), &original); err != nil {
		t.Fatal(err)
	}
	source = chainNativeJSON(t, original)
	candidate := chainNativeSourceModes(t, []string{"wg", "wg", "wg"})
	candidateInput, err := candidate.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var record mobilemultihop.NodeChainSource
	if err := json.Unmarshal([]byte(candidateInput), &record); err != nil {
		t.Fatal(err)
	}
	inventory := chainNativeJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-native-catalog", Inputs: []string{record.Nodes[len(record.Nodes)-1]}})
	prep, err := mobilemultihop.NewNodeChainCandidatePreparation(source, 1, inventory)
	if err != nil {
		t.Fatal(err)
	}
	if prep.OriginalSourceSHA256() != chain.SourceSHA256() {
		t.Fatal("fixture changed original saved source")
	}
	return prep
}

