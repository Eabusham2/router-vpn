func (m *RouterNodeChainCandidateAppendExecutionPreparation) SelectionJSON() string {
	if m == nil || m.local == nil || m.local.callbackActive.Load() {
		return ""
	}
	state := m.local.state.Load()
	if state == nil || state.execution.Load() == nil {
		return ""
	}
	ctx, cancel := context.WithTimeout(context.Background(), hopmeasure.ObservationTimeout)
	defer cancel()
	return state.execution.Load().SelectionContextJSON(ctx)
}
