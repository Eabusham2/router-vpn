// Pure source and exclusive process-owned execution are separate facade types.
// Neither is an ordinary complete/selected source or an application-ready path.
type RouterNodeChainCandidateAppendExecutionSource struct {
	source *mobilemultihop.NodeChainCandidateAppendExecutionPolicy
}
type RouterNodeChainCandidateAppendExecutionPreparation struct {
	preparation *mobilemultihop.NodeChainCandidateAppendExecutionPreparation
	local       *RouterNodeChainCandidatePreparation
}

func NewRouterNodeChainCandidateAppendExecutionSource(input string) (*RouterNodeChainCandidateAppendExecutionSource, error) {
	source, err := mobilemultihop.NewNodeChainCandidateAppendExecutionPolicy(input)
	if err != nil {
		return nil, err
	}
	return &RouterNodeChainCandidateAppendExecutionSource{source: source}, nil
}
func RouterNodeChainCandidateAppendExecutionInputFitsSource(source *RouterNodeChainCandidateAppendExecutionSource, input string) bool {
	return source != nil && source.source != nil && source.source.CandidateInputFitsSource(input)
}
func routerNodeAppendExecutionFacade(prep *mobilemultihop.NodeChainCandidateAppendExecutionPreparation) (*RouterNodeChainCandidateAppendExecutionPreparation, error) {
	if prep == nil || prep.SourceSHA256() == "" || prep.OriginalPreparation() == nil {
		return nil, errRouterCandidatePreparation()
	}
	var original struct {
		Inventory string `json:"inventory"`
	}
	if json.Unmarshal([]byte(prep.Source()), &original) != nil || original.Inventory == "" {
		return nil, errRouterCandidatePreparation()
	}
	digest := sha256.Sum256([]byte(original.Inventory))
	local := &RouterNodeChainCandidatePreparation{prep: prep.OriginalPreparation(), inventorySHA: hex.EncodeToString(digest[:]), execution: prep}
	return &RouterNodeChainCandidateAppendExecutionPreparation{preparation: prep, local: local}, nil
}
func NewRouterNodeChainCandidateAppendExecutionPreparation(input string) (*RouterNodeChainCandidateAppendExecutionPreparation, error) {
	prep, err := mobilemultihop.NewNodeChainCandidateAppendExecutionPreparation(input)
	if err != nil {
		return nil, err
	}
	return routerNodeAppendExecutionFacade(prep)
}
func RouterNodeChainCandidateAppendExecutionPreparationLaunch(input string) (*RouterNodeChainCandidateAppendExecutionPreparation, error) {
	prep, err := mobilemultihop.ParseNodeChainCandidateAppendExecutionPreparationCapture(input)
	if err != nil {
		return nil, err
	}
	return routerNodeAppendExecutionFacade(prep)
}
