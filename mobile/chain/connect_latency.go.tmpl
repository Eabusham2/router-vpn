package libbox

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/hopmeasure"
)

// This typed factory borrows the already captured host throughput service.
// It cannot construct, replace or close that service, and grants no external-
// final, candidate or ordinary launch scope.
func RouterNodeChainCONNECTNewLatencyBenchmark(m *RouterNodeChainCONNECT, server *CommandServer, measurement *RouterHopMeasurement) (*RouterOrderedLatency, error) {
	ctx, cancel := context.WithTimeout(context.Background(), hopmeasure.ObservationTimeout)
	defer cancel()
	return m.newCONNECTOrderedLatencyContext(ctx, server, measurement)
}
func (m *RouterNodeChainCONNECT) newCONNECTOrderedLatencyContext(ctx context.Context, server *CommandServer, measurement *RouterHopMeasurement) (*RouterOrderedLatency, error) {
	if m == nil || m.self != m || ctx == nil || server == nil || measurement == nil || measurement.service == nil {
		return nil, errRouterNodeChainCONNECT()
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.mu); err != nil {
		return nil, err
	}
	defer m.mu.Unlock()
	native, state := m.native.Load(), m.state.Load()
	if native == nil || native.server != server || state == nil || m.mtuOccupied() || m.healthyContext(ctx) != nil {
		return nil, errRouterNodeChainCONNECT()
	}
	_, meta, err := m.source.ReadValidated()
	if err != nil {
		return nil, err
	}
	service := m.measurement.Load()
	if service == nil || service != measurement.service {
		return nil, errRouterNodeChainCONNECT()
	}
	benchmark, err := hopmeasure.NewOrderedLatencyValidatedContext(ctx, service, meta.SourceSHA256, meta.ConfigSHA256, func(call context.Context) error {
		err := m.healthyContext(call)
		if err != nil || m.state.Load() != state || m.native.Load() != native || m.measurement.Load() != service || m.mtuOccupied() {
			return errors.Join(err, errRouterNodeChainCONNECT())
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	return &RouterOrderedLatency{service: benchmark}, nil
}
