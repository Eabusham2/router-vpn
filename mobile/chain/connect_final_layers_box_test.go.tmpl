// These use the actual typed final factories and native Box/manager/Last
// bindings. Packet-prefix I/O, TUN and resolver responses keep the existing
// explicit component boundaries; this is not encrypted packet-prefix proof.
func TestRouterVPNCONNECTFinalLayersNativeOwners(t *testing.T) {
	for _, count := range []int{3, 4, 8} {
		for _, protocol := range []string{"http-connect", "https-connect"} {
			for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				for _, execution := range []string{"server", "auto"} {
					t.Run(fmt.Sprintf("%d/%s/%s/%s", count, protocol, layer, execution), func(t *testing.T) {
						f, source, _ := newCONNECTExecutionNativePrefixLayerFixture(t, count-2, "wg", protocol, execution, layer)
						engine, err := f.capture(t.Context())
						if err != nil {
							t.Fatal("original layered capture", err)
						}
						if err = engine.ObserveCONNECTExecutionContext(t.Context(), source); err != nil {
							t.Fatal("original layered owner", err)
						}
						proofs := f.prep.ProofInventory()
						final, found := f.box.outbound.Outbound(proofs[count-1].Tag)
						if !found || proofs[count-1].StartLayer != layer {
							t.Fatal("captured final layer missing")
						}
						if layer == "aes-256-gcm" {
							if actual, ok := final.(*ss.Outbound); !ok || actual == nil {
								t.Fatal("AES final replaced actual SS owner")
							}
						} else {
							if actual, ok := final.(*whitening.Outbound); !ok || actual == nil {
								t.Fatal("XOR final replaced actual authenticated whitening owner")
							}
						}
						f.discovery(t)
						if _, err = engine.DiscoverContext(t.Context()); err != nil {
							t.Fatal(err)
						}
						projection, err := engine.AdoptContext(t.Context(), f.server.SourceSHA256(), 32003)
						if err != nil {
							t.Fatal("layered native discovery adoption", err)
						}
						for _, selected := range []string{"local", "server"} {
							inventory, e := projection.ProofInventory(selected)
							if e != nil || len(inventory) != count || inventory[count-1].StartLayer != layer || inventory[count-1].ProfileID != proofs[count-1].ProfileID {
								t.Fatal("execution changed original layered final proof", selected, e)
							}
						}
						if _, err = engine.ObserveChainContext(t.Context()); err != nil {
							t.Fatal("layered native post-adoption observation", err)
						}
						if open, err := engine.ApplicationOpenContext(t.Context()); err != nil || open {
							t.Fatal("source adoption fabricated forwarding", open, err)
						}
					})
				}
			}
		}
	}
}

func TestRouterVPNCONNECTFinalLayersNativeRefusesReplacement(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		for _, fault := range []string{"final-slot", "uot-owner", "uot-version", "uot-dialer"} {
			t.Run(layer+"/"+fault, func(t *testing.T) {
				f, source, _ := newCONNECTExecutionNativePrefixLayerFixture(t, 1, "wg", "https-connect", "auto", layer)
				engine, err := f.capture(t.Context())
				if err != nil {
					t.Fatal(err)
				}
				tag := f.prep.ProofInventory()[2].Tag
				final, ok := f.box.outbound.Outbound(tag)
				if !ok {
					t.Fatal("original native final missing")
				}
				slot := chainNativeField[*uot.Client](t, final, "uotClient")
				original := *slot
				if original == nil || original.Version != 2 {
					t.Fatal("original UoT-v2 missing")
				}
				restore := func() {}
				switch fault {
				case "final-slot":
					copy := reflect.New(reflect.TypeOf(final).Elem())
					copy.Elem().Set(reflect.ValueOf(final).Elem())
					foreign := copy.Interface().(adapter.Outbound)
					entries := chainNativeField[map[string]adapter.Outbound](t, f.box.outbound, "outboundByTag")
					(*entries)[tag] = foreign
					restore = func() { (*entries)[tag] = final }
				case "uot-owner":
					copy := *original
					*slot = &copy
					restore = func() { *slot = original }
				case "uot-version":
					original.Version = 1
					restore = func() { original.Version = 2 }
				case "uot-dialer":
					dialer := original.Dialer
					original.Dialer = nil
					restore = func() { original.Dialer = dialer }
				}
				failure := engine.ObserveCONNECTExecutionContext(t.Context(), source)
				restore()
				if failure == nil {
					t.Fatal("foreign final acquired original layered native proof", fault)
				}
				if err = engine.ObserveCONNECTExecutionContext(t.Context(), source); err != nil {
					t.Fatal("exact final restoration did not recover observation", err)
				}
			})
		}
	}
}

func TestRouterVPNCONNECTFinalLayersNativeLast(t *testing.T) {
	for _, count := range []int{3, 8} {
		for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, selected := range []string{"local", "server"} {
				t.Run(fmt.Sprintf("%d/%s/%s", count, layer, selected), func(t *testing.T) {
					f, source, _ := newCONNECTExecutionNativePrefixLayerFixture(t, count-2, "wg", "https-connect", "auto", layer)
					last := executionLastRecord(t, f, selected)
					engine, err := f.capture(t.Context())
					if err != nil {
						t.Fatal(err)
					}
					if _, err = engine.AdoptLastContext(t.Context(), last); err == nil {
						t.Fatal("layered Last skipped original discovery")
					}
					f.discovery(t)
					if _, err = engine.DiscoverContext(t.Context()); err != nil {
						t.Fatal(err)
					}
					originalBox, originalInbound, originalDiscovery := engine.instance, engine.inbound, engine.discovery.Load()
					plan, err := engine.AdoptLastContext(t.Context(), last)
					if err != nil {
						t.Fatal("layered Last adoption", err)
					}
					if engine.instance != originalBox || engine.inbound != originalInbound || engine.discovery.Load() != originalDiscovery {
						t.Fatal("Last replaced original native owner")
					}
					if err = engine.ObserveCONNECTExecutionContext(t.Context(), source); err != nil {
						t.Fatal(err)
					}
					projection, err := plan.Projection()
					if err != nil {
						t.Fatal(err)
					}
					proofs, err := projection.ProofInventory(selected)
					if err != nil || proofs[count-1].StartLayer != layer {
						t.Fatal("Last discarded original final layer", err)
					}
					runtime, err := mobilemultihop.NewNodeChainExecutionLastRuntime(t.Context(), plan, engine)
					if err != nil {
						t.Fatal(err)
					}
					if runtime.Progress().Ready || runtime.HealthyContext(t.Context()) == nil {
						t.Fatal("layered Last fabricated live proof")
					}
					if err = runtime.CloseContext(t.Context()); err != nil {
						t.Fatal(err)
					}
				})
			}
		}
	}
}
