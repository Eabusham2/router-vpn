// Actual OpenVPN endpoint, manager, selector, gate and shared discovery run
// here. The endpoint is unstarted: no native connection is claimed. The TUN,
// packet-prefix I/O and DNS retain the existing fixture's explicit boundaries.
func newOpenVPNExecutionNativeFixture(t *testing.T, name, execution string) (*executionNativeFixture, *mobilemultihop.NodeChain) {
	t.Helper()
	original, prep, server := openVPNExecutionNativeSources(t, name, execution)
	f := newExecutionNativeFixtureWithSources(t, prep, server, nil, executionNativeConstructionHook{
		endpoints: openvpn.RegisterEndpoint,
		context: func(ctx context.Context) (context.Context, error) {
			return RouterVPNNodeOpenVPNExecutionContext(ctx, prep)
		},
		options: routerVPNNodeSOCKSOptions, created: func(s *Box) { routerVPNNodeSOCKSBind(s) },
		close: func(s *Box) error {
			select {
			case <-s.done:
				return nil // The original Box.Close already owns endpoint retirement.
			default:
				return s.endpoint.Close()
			}
		},
	})
	return f, original
}

func openVPNExecutionNativeConstruction(t *testing.T, f *executionNativeFixture) *routerVPNOpenVPNExecutionConstruction {
	t.Helper()
	c, ok := f.ctx.Value(routerVPNOpenVPNExecutionKey{}).(*routerVPNOpenVPNExecutionConstruction)
	if !ok || c == nil || c.instance != f.box || c.endpoint == nil {
		t.Fatal("original concrete OpenVPN construction absent")
	}
	return c
}

type openVPNExecutionLookalike struct{ adapter.Endpoint }

func (*openVPNExecutionLookalike) RouterVPNConnectedCapacityContext(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
	return nativeopenvpn.RemoteReceipt{}, 1500, nil
}

func TestRouterVPNOpenVPNExecutionNativeOriginal(t *testing.T) {
	if _, err := routerVPNConcreteExecutionOpenVPN(&openVPNExecutionLookalike{}); err == nil {
		t.Fatal("lookalike reader acquired concrete OpenVPN execution authority")
	}
	for _, name := range []string{"3-tcp", "3-udp", "4-tcp", "4-udp", "8-tcp", "8-udp"} {
		for _, execution := range []string{"server", "auto"} {
			t.Run(name+"/"+execution, func(t *testing.T) {
				f, original := newOpenVPNExecutionNativeFixture(t, name, execution)
				c := openVPNExecutionNativeConstruction(t, f)
				endpoint := c.endpoint
				projection := f.adopt(t)
				if err := f.engine.ObserveOpenVPNExecutionContext(t.Context(), original); err != nil {
					t.Fatal("original native source refused", err)
				}
				if _, err := f.engine.OpenVPNMiddleStateContext(t.Context(), c.capture.Tag); !errors.Is(err, nativeopenvpn.ErrRemotePending) || c.state != nil {
					t.Fatal("configured OpenVPN endpoint manufactured connected state", err)
				}
				server, err := projection.DNSCapture("server")
				if err != nil || f.engine.SelectContext(t.Context(), server.SelectedTag) != nil {
					t.Fatal("original Server selection refused", err)
				}
				if _, err := f.engine.ObserveChainContext(t.Context()); err != nil || c.endpoint != endpoint || c.state != nil {
					t.Fatal("unused Local provider blocked Server ownership", err)
				}
				if open, err := f.engine.ApplicationOpenContext(t.Context()); err != nil || open {
					t.Fatal("native OpenVPN adoption opened traffic without proofs", err)
				}
			})
		}
	}
}

