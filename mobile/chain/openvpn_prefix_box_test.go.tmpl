func chainNativeOpenVPNPrefixSource(t *testing.T, count int) *mobilemultihop.NodeChain {
	t.Helper()
	original := chainNativeOpenVPNSource(t)
	oldLaunch, err := original.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var old mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(oldLaunch), &old) != nil {
		t.Fatal("original OpenVPN source absent")
	}
	modes := make([]string, count)
	for i := range modes {
		modes[i] = "wg"
	}
	pair := chainNativeSourceModes(t, modes)
	launch, err := pair.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(launch), &source) != nil {
		t.Fatal("complete packet source absent")
	}
	source.Schema = 5
	source.Nodes = append(source.Nodes[:count], old.Nodes[1], source.Nodes[count])
	source.IdentitySources = make([]string, count+2)
	for i := 0; i < count; i++ {
		var input map[string]any
		if json.Unmarshal([]byte(source.Nodes[i]), &input) != nil {
			t.Fatal("paired original prefix absent")
		}
		source.IdentitySources[i] = input["files"].(string)
	}
	client, _ := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{byte(20 + count)}, 32))
	server, _ := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{byte(70 + count)}, 32))
	text := fmt.Sprintf("[Interface]\nAddress=10.77.0.2/24\nPrivateKey=%s\n[Peer]\nPublicKey=%s\nEndpoint=198.51.100.%d:51820\nAllowedIPs=0.0.0.0/0,::/0\n", base64.StdEncoding.EncodeToString(client.Bytes()), base64.StdEncoding.EncodeToString(server.PublicKey().Bytes()), 20+count)
	source.IdentitySources[count+1] = chainNativeJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(text))})
	chain, err := mobilemultihop.NewNodeChain(chainNativeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	return chain
}

func chainNativeOpenVPNPrefixFixture(t *testing.T, count int) (*chainNativeFixture, *chainNativeOpenVPN) {
	t.Helper()
	chain := chainNativeOpenVPNPrefixSource(t, count)
	capture, err := chain.OpenVPNMiddleCapture()
	if err != nil {
		t.Fatal(err)
	}
	var native *chainNativeOpenVPN
	f := newChainNativeFixtureSource(t, chain, nil, func(reg *endpoint.Registry) {
		endpoint.Register[option.OpenVPNClientEndpointOptions](reg, "openvpn-client", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.OpenVPNClientEndpointOptions) (adapter.Endpoint, error) {
			native = &chainNativeOpenVPN{chainNativePrefix: chainNativePrefix{Adapter: outbound.NewAdapter("openvpn-client", tag, []string{"tcp", "udp"}, nil)}, state: nativeopenvpn.PacketObservation{Remote: nativeopenvpn.RemoteReceipt{Remote: capture.Remote, Generation: 7, ConnectedAt: 1}, MTU: 1500}}
			return native, nil
		})
	})
	return f, native
}

type openVPNPrefixReader struct {
	*chainNativeTUN
	fail bool
}

func (r *openVPNPrefixReader) Start(stage adapter.StartStage) error {
	if r.fail {
		return errors.New("captured candidate startup refused")
	}
	return r.chainNativeTUN.Start(stage)
}

// Actual native manager replacement/rollback and Box endpoint session pin.
// Kernel TUN and connected-capacity readback are explicit component fixtures;
// encrypted transport and full Run/DNS/reproof have their separate real gate.
func TestRouterVPNNodeChainOpenVPNPrefixMTUOriginalEndpoint(t *testing.T) {
	for _, count := range []int{2, 6} {
		for _, scenario := range []string{"candidate", "rollback", "generation", "capacity", "endpoint", "cancel", "stale-owner"} {
			t.Run(fmt.Sprintf("%d-%s", count, scenario), func(t *testing.T) {
				f, native := chainNativeOpenVPNPrefixFixture(t, count)
				capture, err := f.chain.OpenVPNMiddleCapture()
				if err != nil {
					t.Fatal(err)
				}
				engine, err := f.capture(t.Context())
				if err != nil {
					t.Fatal(err)
				}
				original, err := engine.OpenVPNMiddleStateContext(t.Context(), capture.Tag)
				if err != nil {
					t.Fatal(err)
				}
				for _, stage := range adapter.ListStartStages {
					if err := f.box.inbound.Start(stage); err != nil {
						t.Fatal(err)
					}
				}
				before, ok := f.box.inbound.Get(f.chain.DNSCapture().TUNTag)
				if !ok {
					t.Fatal("original reader absent")
				}
				candidate := &openVPNPrefixReader{chainNativeTUN: &chainNativeTUN{Adapter: inbound.NewAdapter("tun", before.Tag())}, fail: scenario == "rollback"}
				rollback := &openVPNPrefixReader{chainNativeTUN: &chainNativeTUN{Adapter: inbound.NewAdapter("tun", before.Tag())}}
				tx, changeErr := f.box.inbound.RouterVPNReplaceTunOwned(t.Context(), before, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
				if (scenario == "rollback") != (changeErr != nil) {
					t.Fatal("native candidate/rollback outcome changed", changeErr)
				}
				current, err := f.box.inbound.RouterVPNReadTunTransactionContext(t.Context(), tx, before)
				expected := adapter.Inbound(candidate)
				if scenario == "rollback" {
					expected = rollback
				}
				if err != nil || current != expected || current == before {
					t.Fatal("original transaction lost joined reader", err)
				}
				if _, err := engine.OpenVPNMiddleStateContext(t.Context(), capture.Tag); err == nil {
					t.Fatal("retired reader engine remained current")
				}
				// The shipping generic MTU bridge reparses the original launch for
				// each proof generation. A fresh source still cannot repin the Box.
				launch, err := f.chain.LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
				f.chain, err = mobilemultihop.ParseNodeChainLaunchInput(launch)
				if err != nil {
					t.Fatal(err)
				}
				fresh, err := f.capture(t.Context())
				if err != nil {
					t.Fatal(err)
				}
				if state, err := fresh.OpenVPNMiddleStateContext(t.Context(), capture.Tag); err != nil || state != original {
					t.Fatal("native TUN replacement lost original endpoint receipt", err)
				}
				ctx := t.Context()
				switch scenario {
				case "generation":
					native.state.Remote.Generation++
				case "capacity":
					native.state.MTU--
				case "endpoint":
					replacement := &chainNativeOpenVPN{chainNativePrefix: native.chainNativePrefix, state: original}
					mu := chainNativeField[sync.Mutex](t, f.box.endpoint, "access")
					mu.Lock()
					(*chainNativeField[map[string]adapter.Endpoint](t, f.box.endpoint, "endpointByTag"))[capture.Tag] = replacement
					rows := chainNativeField[[]adapter.Endpoint](t, f.box.endpoint, "endpoints")
					for i, owner := range *rows {
						if owner == native {
							(*rows)[i] = replacement
						}
					}
					mu.Unlock()
					fresh, err = f.capture(t.Context())
					if err != nil {
						t.Fatal(err)
					}
				case "cancel":
					var cancel context.CancelFunc
					ctx, cancel = context.WithCancel(ctx)
					cancel()
				case "stale-owner":
					f.current.Store(false)
				}
				state, err := fresh.OpenVPNMiddleStateContext(ctx, capture.Tag)
				if scenario == "candidate" || scenario == "rollback" {
					if err != nil || state != original {
						t.Fatal("original endpoint continuity refused", err)
					}
				} else if err == nil {
					t.Fatal("MTU reproof adopted foreign original endpoint state", scenario)
				}
			})
		}
	}
}
