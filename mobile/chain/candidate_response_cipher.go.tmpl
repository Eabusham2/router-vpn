func init() {
	wrapCandidateSS2022 = func(ctx context.Context, raw net.Conn, cipher, password, destination string) (net.Conn, error) {
		method, err := ssclient.CreateMethod(ctx, cipher, ssclient.MethodOptions{Password: password})
		if err != nil {
			return nil, err
		}
		return method.DialConn(raw, M.ParseSocksaddr(destination))
	}
	openCandidateHysteria2 = openNativeCandidateHysteria2
}

var errCandidateHysteria2 = errors.New("candidate Hysteria2 requires its original authenticated packet carrier")

// Every sample gets its own actual QUIC authentication and fresh challenge.
// The returned connection owns that whole client, including a late shared
// offer. Closing its stream cannot leave a reusable candidate carrier behind.
func openNativeCandidateHysteria2(ctx context.Context, request *NodeChainCandidatePacketRequest, destination string) (net.Conn, error) {
	if ctx == nil || request == nil || request.response.Hysteria2Options == "" {
		return nil, errCandidateHysteria2
	}
	_, _, endpoint, err := request.current(ctx)
	api, apiErr := privateAPI(request.response.API)
	if err != nil || apiErr != nil || api.Host != destination {
		return nil, errCandidateHysteria2
	}
	var captured struct {
		Type string `json:"type"`
		Tag  string `json:"tag"`
		option.Hysteria2OutboundOptions
	}
	if json.Unmarshal([]byte(request.response.Hysteria2Options), &captured) != nil {
		return nil, errCandidateHysteria2
	}
	options := captured.Hysteria2OutboundOptions
	if captured.Type != "hysteria2" || options.ServerOptions.Build().String() != endpoint || options.Password == "" ||
		options.TLS == nil || !options.TLS.Enabled || options.TLS.Insecure || options.Detour != "" ||
		options.DomainResolver != nil || options.Realm != nil || len(options.ServerPorts) != 0 {
		return nil, errCandidateHysteria2
	}
	owned, cancel := context.WithCancel(ctx)
	dialer := &candidatePacketDialer{request: request, endpoint: endpoint, ctx: owned}
	tlsConfig, err := boxtls.NewClient(owned, logger.NOP(), options.Server, *options.TLS)
	if err != nil {
		cancel()
		return nil, errCandidateHysteria2
	}
	var salamander, gecko string
	var geckoMin, geckoMax int
	if options.Obfs != nil {
		if options.Obfs.Password == "" {
			cancel()
			return nil, errCandidateHysteria2
		}
		switch options.Obfs.Type {
		case hy2.ObfsTypeSalamander:
			salamander = options.Obfs.Password
		case hy2.ObfsTypeGecko:
			gecko = options.Obfs.Password
			geckoMin, geckoMax = options.Obfs.GeckoOptions.MinPacketSize, options.Obfs.GeckoOptions.MaxPacketSize
		default:
			cancel()
			return nil, errCandidateHysteria2
		}
	}
	client, err := hy2.NewClient(hy2.ClientOptions{
		Context: owned, Dialer: dialer, Logger: logger.NOP(), BrutalDebug: options.BrutalDebug,
		ServerAddress: options.ServerOptions.Build(), SendBPS: uint64(options.UpMbps * hysteria.MbpsToBps),
		ReceiveBPS: uint64(options.DownMbps * hysteria.MbpsToBps), Password: options.Password,
		SalamanderPassword: salamander, GeckoPassword: gecko, GeckoMinPacketSize: geckoMin, GeckoMaxPacketSize: geckoMax,
		TLSConfig: tlsConfig, BBRProfile: options.BBRProfile, ChromeParrot: !options.DisableChromeParrot,
		// The private challenge needs a stream; this ephemeral owner cannot open
		// application UDP sessions or their separate message-delivery workers.
		UDPDisabled: true,
		QUICOptions: qtls.QUICOptions{IdleTimeout: options.IdleTimeout.Build(), KeepAlivePeriod: options.KeepAlivePeriod.Build(),
			StreamReceiveWindow: options.StreamReceiveWindow.Value(), ConnectionReceiveWindow: options.ConnectionReceiveWindow.Value(),
			MaxConcurrentStreams: options.MaxConcurrentStreams, InitialPacketSize: options.InitialPacketSize,
			DisablePathMTUDiscovery: options.DisablePathMTUDiscovery},
	})
	if err != nil {
		cancel()
		return nil, errCandidateHysteria2
	}
	var closeOnce sync.Once
	var closeErr error
	closeAll := func() error {
		closeOnce.Do(func() {
			cancel()
			// Mark the socket scope closed before retiring QUIC. An already
			// admitted late dial must close its exact result before it can join.
			dialer.beginClose()
			closeErr = client.RouterVPNCloseResponseCandidate(net.ErrClosed)
			closeErr = errors.Join(closeErr, dialer.join())
		})
		return closeErr
	}
	stop := context.AfterFunc(ctx, func() { _ = closeAll() })
	stream, err := client.DialConn(ctx, M.ParseSocksaddr(destination))
	if err != nil || stream == nil || ctx.Err() != nil {
		stop()
		if stream != nil {
			_ = stream.Close()
		}
		_ = closeAll()
		return nil, errors.Join(ctx.Err(), errCandidateHysteria2)
	}
	_, _, _, err = request.current(ctx)
	if err != nil {
		stop()
		_ = stream.Close()
		_ = closeAll()
		return nil, errCandidateHysteria2
	}
	return &candidateHysteria2Connection{Conn: stream, stop: stop, closeAll: closeAll}, nil
}

type candidateHysteria2Connection struct {
	net.Conn
	stop     func() bool
	closeAll func() error
	once     sync.Once
	err      error
}

func (c *candidateHysteria2Connection) Close() error {
	c.once.Do(func() {
		c.stop()
		streamErr := c.Conn.Close()
		if errors.Is(streamErr, net.ErrClosed) {
			streamErr = nil
		}
		c.err = errors.Join(streamErr, c.closeAll())
	})
	return c.err
}

// The private TCP stream and the physical UDP socket have separate owners.
type NativeCandidateDevice interface {
	DialContext(context.Context, string, M.Socksaddr) (net.Conn, error)
	Close() error
}

// The private methods keep this factory sealed to the original ordinary,
// prepared, selected-Local and registered Server request types in this package.
type nativePacketRequest interface {
	nativePacketCurrent(context.Context) error
	nativePacketSource() candidateResponseSource
	nativePacketMode() string
	nativePacketAddress() string
	dial(context.Context) (net.Conn, error)
}

func (r *NodeChainCandidatePacketRequest) nativePacketCurrent(ctx context.Context) error {
	_, _, _, err := r.current(ctx)
	if err == nil && r.appendHysteria != nil {
		return r.appendHysteria.validateRequest(ctx, r)
	}
	return err
}
func (r *NodeChainCandidatePacketRequest) nativePacketSource() candidateResponseSource {
	return r.response
}
func (r *NodeChainCandidatePacketRequest) nativePacketMode() string { return r.plan.responseMode }
func (r *NodeChainCandidatePacketRequest) nativePacketAddress() string {
	return r.response.Target.Address
}

type nativePacketCandidate struct {
	request  nativePacketRequest
	device   NativeCandidateDevice
	dialer   *candidatePacketDialer
	cancel   context.CancelFunc
	once     sync.Once
	closeErr error
}

func (r *NodeChainCandidatePacketRequest) OpenNativeEndpoint(ctx context.Context, reader NodeChainEngine, original *NodeChain, awg func(context.Context, AmneziaEndpointConfig, N.Dialer) (NativeCandidateDevice, error)) (NodeChainCandidateEndpoint, error) {
	if _, _, _, err := r.Read(ctx, reader, original); err != nil {
		return nil, err
	}
	return r.openNativeEndpoint(ctx, awg)
}

func (r *NodeChainCandidatePacketRequest) OpenPreparedNativeEndpoint(ctx context.Context, reader NodeChainPreparedPacketEngine, original *NodeChainCandidatePreparation, awg func(context.Context, AmneziaEndpointConfig, N.Dialer) (NativeCandidateDevice, error)) (NodeChainCandidateEndpoint, error) {
	if _, _, _, err := r.ReadPrepared(ctx, reader, original); err != nil {
		return nil, err
	}
	if r.appendHysteria != nil {
		if r.appendHysteria.validateRequest(ctx, r) != nil {
			return nil, errNodeChainAppendExecution
		}
		return openNativeAppendHysteriaEndpoint(ctx, r)
	}
	return r.openNativeEndpoint(ctx, awg)
}

func (r *NodeChainCandidatePacketRequest) OpenSelectedNativeEndpoint(ctx context.Context, reader NodeChainExecutionEngine, original *NodeChainExecutionProjection, awg func(context.Context, AmneziaEndpointConfig, N.Dialer) (NativeCandidateDevice, error)) (NodeChainCandidateEndpoint, error) {
	if _, _, _, err := r.ReadSelected(ctx, reader, original); err != nil {
		return nil, err
	}
	return r.openNativeEndpoint(ctx, awg)
}

func (r *NodeChainCandidatePacketRequest) openNativeEndpoint(ctx context.Context, awg func(context.Context, AmneziaEndpointConfig, N.Dialer) (NativeCandidateDevice, error)) (NodeChainCandidateEndpoint, error) {
	return openNativePacketEndpoint(ctx, r, awg)
}

func (r *NodeChainServerCandidatePacketRequest) OpenServerNativeEndpoint(ctx context.Context, reader NodeChainServerPacketEngine, original *NodeChainServerPolicy, capture multihoprelay.NodeChainCandidateCapture, awg func(context.Context, AmneziaEndpointConfig, N.Dialer) (NativeCandidateDevice, error)) (NodeChainCandidateEndpoint, error) {
	if _, _, err := r.ReadServer(ctx, reader, original, capture); err != nil {
		return nil, err
	}
	return openNativePacketEndpoint(ctx, r, awg)
}

func (r *NodeChainServerPrefixCandidatePacketRequest) OpenServerPrefixNativeEndpoint(ctx context.Context, reader NodeChainServerPrefixPacketEngine, original *NodeChainServerPrefixSession, capture multihoprelay.NodeChainPrefixCandidateCapture, awg func(context.Context, AmneziaEndpointConfig, N.Dialer) (NativeCandidateDevice, error)) (NodeChainCandidateEndpoint, error) {
	if _, _, err := r.ReadServerPrefix(ctx, reader, original, capture); err != nil {
