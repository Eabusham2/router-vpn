func openNativePacketEndpoint(ctx context.Context, r nativePacketRequest, awg func(context.Context, AmneziaEndpointConfig, N.Dialer) (NativeCandidateDevice, error)) (NodeChainCandidateEndpoint, error) {
	if ctx == nil || r == nil {
		return nil, errors.New("packet candidate has no original request")
	}
	err := r.nativePacketCurrent(ctx)
	if err != nil {
		return nil, err
	}
	source, address, mode := r.nativePacketSource(), r.nativePacketAddress(), r.nativePacketMode()
	if err != nil || !NodeChainPrefixMode(mode) || source.PacketOptions == "" || address == "" {
		return nil, errors.New("packet candidate lost its source or original prefix")
	}
	owned, cancel := context.WithCancel(ctx)
	dialer := &candidatePacketDialer{request: r, endpoint: address, ctx: owned}
	owner := &nativePacketCandidate{request: r, dialer: dialer, cancel: cancel}
	if mode == "wg" {
		owner.device, err = newCandidateWG(owned, source.PacketOptions, address, dialer)
	} else {
		var options AmneziaEndpointConfig
		runtime, captured := AmneziaRuntimeConfig(source.PacketOptions)
		if captured != nil || runtime.Remote.String() != address || awg == nil || json.Unmarshal([]byte(source.PacketOptions), &options) != nil || options.Detour != "" {
			err = errors.New("invalid captured AWG candidate")
		} else {
			owner.device, err = awg(owned, options, dialer)
		}
	}
	observed := r.nativePacketCurrent(ctx)
	if err != nil || owner.device == nil || observed != nil || ctx.Err() != nil {
		failure := errors.New("could not open the captured packet candidate through its original prefix")
		if closeErr := owner.Close(); closeErr != nil {
			return owner, errors.Join(failure, closeErr)
		}
		return nil, failure
	}
	return owner, nil
}

func newCandidateWG(ctx context.Context, raw, address string, carrier N.Dialer) (NativeCandidateDevice, error) {
	var captured struct {
		Type string `json:"type"`
		option.WireGuardEndpointOptions
	}
	bad := errors.New("invalid original WireGuard candidate")
	if json.Unmarshal([]byte(raw), &captured) != nil || captured.Type != "wireguard" || captured.System ||
		captured.Detour != "" || len(captured.Peers) != 1 || captured.MTU < 1280 {
		return nil, bad
	}
	peer := captured.Peers[0]
	target := M.ParseSocksaddrHostPort(peer.Address, peer.Port)
	if !target.IsIP() || target.String() != address {
		return nil, bad
	}
	device, err := wg.NewEndpoint(wg.EndpointOptions{Context: ctx, Logger: logger.NOP(), Tag: "candidate", Dialer: carrier,
		Address: captured.Address, MTU: captured.MTU, PrivateKey: captured.PrivateKey, ListenPort: captured.ListenPort, Workers: captured.Workers,
		Peers: []wg.PeerOptions{{Endpoint: target, PublicKey: peer.PublicKey, PreSharedKey: peer.PreSharedKey, AllowedIPs: peer.AllowedIPs,
			PersistentKeepaliveInterval: peer.PersistentKeepaliveInterval, Reserved: peer.Reserved}}})
	if err != nil || device == nil {
		if device != nil {
			return device, bad
		}
		return nil, bad
	}
	if err = device.Start(false); err != nil {
		return device, bad // Retain construction for joined retirement; IPC errors may include keys.
	}
	return device, nil
}

func (e *nativePacketCandidate) DialPrivate(ctx context.Context, address string) (net.Conn, error) {
	r := e.request
	if err := r.nativePacketCurrent(ctx); err != nil {
		return nil, err
	}
	api, err := privateAPI(r.nativePacketSource().API)
	destination := M.ParseSocksaddr(address)
	if err != nil || !destination.IsIP() || api.Host != address || destination.Port == 0 {
		return nil, errors.New("packet candidate requires its own original private API")
	}
	conn, err := e.device.DialContext(ctx, "tcp", destination)
	observed := r.nativePacketCurrent(ctx)
	if err != nil || observed != nil || ctx.Err() != nil {
		if conn != nil {
			_ = conn.Close()
		}
		return nil, errors.Join(err, observed, ctx.Err())
	}
	return conn, nil
}

func (e *nativePacketCandidate) appendExecutionPacketRequest() any {
	if e == nil {
		return nil
	}
	return e.request
}

// Append callers retain late nonnil streams on their original I/O owner.
// Ordinary DialPrivate retains its existing behavior and signature.
func (e *nativePacketCandidate) dialAppendExecutionPrivate(ctx context.Context, request any, address string) (net.Conn, error) {
	if e == nil || e.request == nil || e.device == nil || request != e.request || ctx == nil || ctx.Err() != nil {
		return nil, errNodeChainAppendExecution
	}
	if err := e.request.nativePacketCurrent(ctx); err != nil {
		return nil, err
	}
	api, err := privateAPI(e.request.nativePacketSource().API)
	destination := M.ParseSocksaddr(address)
	if err != nil || !destination.IsIP() || api.Host != address || destination.Port == 0 {
		return nil, errNodeChainAppendExecution
	}
	conn, err := e.device.DialContext(ctx, "tcp", destination)
	return conn, errors.Join(err, e.request.nativePacketCurrent(ctx), ctx.Err())
}

func (e *nativePacketCandidate) dialAppendExecutionPublic(ctx context.Context, grant *nodeChainAppendExecutionPacketGrant, address string) (net.Conn, error) {
	if e == nil || e.request == nil || e.device == nil || grant.validate(ctx, e.request, address) != nil {
		return nil, errNodeChainAppendExecution
	}
	if err := e.request.nativePacketCurrent(ctx); err != nil {
		return nil, err
	}
	destination := M.ParseSocksaddr(address)
	if !destination.IsIP() || destination.Port != 443 {
		return nil, errNodeChainAppendExecution
	}
	conn, err := e.device.DialContext(ctx, "tcp", destination)
	// The original trial/front owner retains this exact late result before
	// reporting any failure. Device retirement still joins its UDP carrier.
	return conn, errors.Join(err, e.request.nativePacketCurrent(ctx), grant.validate(ctx, e.request, address), ctx.Err())
}

func (e *nativePacketCandidate) Close() error {
	e.once.Do(func() {
		e.cancel()
		e.dialer.beginClose()
		if e.device != nil {
			e.closeErr = e.device.Close()
		}
		e.closeErr = errors.Join(e.closeErr, e.dialer.join())
	})
	return e.closeErr
}

type candidatePacketDialer struct {
	request  nativePacketRequest
	endpoint string
	ctx      context.Context
	mu       sync.Mutex
	closing  bool
	opening  sync.WaitGroup
	sockets  []*candidatePacketSocket
}

func (d *candidatePacketDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	if ctx == nil || ctx.Err() != nil || d.ctx.Err() != nil || network != "udp" || destination.String() != d.endpoint {
		return nil, errCandidateHysteria2
	}
	d.mu.Lock()
	if d.closing {
		d.mu.Unlock()
		return nil, net.ErrClosed
	}
	d.opening.Add(1)
	d.mu.Unlock()
	defer d.opening.Done()
	raw, err := d.request.dial(ctx)
	if raw == nil {
		return nil, errors.Join(err, errCandidateHysteria2)
	}
	socket := &candidatePacketSocket{Conn: raw, ctx: d.ctx}
	d.mu.Lock()
	d.sockets = append(d.sockets, socket)
	closing := d.closing
	d.mu.Unlock()
	if err != nil || closing || ctx.Err() != nil || d.ctx.Err() != nil {
		_ = socket.Close()
		return nil, errCandidateHysteria2
	}
	return socket, nil
}

func (*candidatePacketDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
	return nil, errCandidateHysteria2
}

func (d *candidatePacketDialer) beginClose() {
	d.mu.Lock()
	d.closing = true
	d.mu.Unlock()
}

func (d *candidatePacketDialer) join() error {
	d.beginClose()
	// The client join precedes this call, so no additional offer can enter.
	// Already admitted original native opens still own their late sockets.
	d.opening.Wait()
	d.mu.Lock()
	sockets := append([]*candidatePacketSocket(nil), d.sockets...)
	d.mu.Unlock()
	var failure error
	for _, socket := range sockets {
		failure = errors.Join(failure, socket.Close())
	}
	return failure
}

// The private client sees no unwrap/syscall escape around this socket owner.
// Close prevents new work, closes the original native socket, and joins every
// entered read, write and deadline call before the measurement hold can end.
type candidatePacketSocket struct {
	net.Conn
	ctx     context.Context
	mu      sync.Mutex
	closing bool
	io      sync.WaitGroup
	once    sync.Once
	err     error
}

func (s *candidatePacketSocket) begin() error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.closing || s.ctx.Err() != nil {
		return net.ErrClosed
	}
	s.io.Add(1)
	return nil
}
func (s *candidatePacketSocket) Read(p []byte) (int, error) {
	if err := s.begin(); err != nil {
		return 0, err
	}
	defer s.io.Done()
	return s.Conn.Read(p)
}
func (s *candidatePacketSocket) Write(p []byte) (int, error) {
	if err := s.begin(); err != nil {
		return 0, err
	}
	defer s.io.Done()
	return s.Conn.Write(p)
}
func (s *candidatePacketSocket) SetDeadline(t time.Time) error {
	if err := s.begin(); err != nil {
		return err
	}
	defer s.io.Done()
	return s.Conn.SetDeadline(t)
}
func (s *candidatePacketSocket) SetReadDeadline(t time.Time) error {
	if err := s.begin(); err != nil {
		return err
	}
	defer s.io.Done()
	return s.Conn.SetReadDeadline(t)
}
func (s *candidatePacketSocket) SetWriteDeadline(t time.Time) error {
	if err := s.begin(); err != nil {
		return err
	}
	defer s.io.Done()
	return s.Conn.SetWriteDeadline(t)
}
func (s *candidatePacketSocket) Close() error {
	s.once.Do(func() {
		s.mu.Lock()
		s.closing = true
		s.mu.Unlock()
		s.err = s.Conn.Close()
		s.io.Wait()
		if errors.Is(s.err, net.ErrClosed) {
			s.err = nil
		}
	})
	return s.err
}

// This distinct factory accepts only an original unfinished-prefix HY2 scope.
// The ordinary per-sample HY2 function above and WG/AWG factory stay unchanged.
func (r *NodeChainServerPrefixCandidateHysteriaRequest) OpenServerPrefixHysteriaEndpoint(ctx context.Context, reader NodeChainServerPrefixHysteriaEngine, original *NodeChainServerPrefixSession, capture multihoprelay.NodeChainPrefixCandidateCapture) (NodeChainCandidateEndpoint, error) {
 if _, _, err := r.ReadServerPrefixHysteria(ctx, reader, original, capture); err != nil { return nil, err }
 return openNativeAppendHysteriaEndpoint(ctx, r)
}

type nativeAppendHysteriaCandidate struct {
 request nativePacketRequest
 client *hy2.Client
 dialer *candidatePacketDialer
 ctx context.Context
 cancel context.CancelFunc
 mu sync.Mutex
 closing bool
 opening sync.WaitGroup
 streams []*candidatePacketSocket
 once sync.Once
 closeErr error
}

func openNativeAppendHysteriaEndpoint(ctx context.Context, request nativePacketRequest) (NodeChainCandidateEndpoint, error) {
 if ctx == nil || ctx.Err() != nil || request == nil || request.nativePacketCurrent(ctx) != nil || request.nativePacketMode() != "hysteria2" {
  return nil, errCandidateHysteria2
 }
 if _, bounded := ctx.Deadline(); !bounded { return nil, errCandidateHysteria2 }
 switch original := request.(type) {
 case *NodeChainCandidatePacketRequest:
  if original.appendHysteria == nil || original.appendHysteria.validateRequest(ctx, original) != nil { return nil, errCandidateHysteria2 }
 case *NodeChainServerPrefixCandidateHysteriaRequest:
  if original.HysteriaSHA256() == "" { return nil, errCandidateHysteria2 }
 default:
  return nil, errCandidateHysteria2
 }
 source := request.nativePacketSource()
 endpoint := request.nativePacketAddress()
 if source.Hysteria2Options == "" || source.PacketOptions != "" || source.Method != "" || source.Password != "" ||
  source.ClientKey != "" || source.ServerKey != "" { return nil, errCandidateHysteria2 }
 if _, err := privateAPI(source.API); err != nil { return nil, errCandidateHysteria2 }
 var captured struct {
  Type string `json:"type"`
  Tag string `json:"tag"`
  option.Hysteria2OutboundOptions
 }
 if json.Unmarshal([]byte(source.Hysteria2Options), &captured) != nil { return nil, errCandidateHysteria2 }
 options := captured.Hysteria2OutboundOptions
 if captured.Type != "hysteria2" || options.ServerOptions.Build().String() != endpoint || !options.ServerOptions.Build().IsIP() || options.Password == "" ||
  options.TLS == nil || !options.TLS.Enabled || options.TLS.Insecure || options.Detour != "" ||
  options.DomainResolver != nil || options.Realm != nil || len(options.ServerPorts) != 0 { return nil, errCandidateHysteria2 }
 owned, cancel := context.WithCancel(ctx)
 dialer := &candidatePacketDialer{request: request, endpoint: endpoint, ctx: owned}
 e := &nativeAppendHysteriaCandidate{request: request, dialer: dialer, ctx: owned, cancel: cancel}
 tlsConfig, err := boxtls.NewClient(owned, logger.NOP(), options.Server, *options.TLS)
 if err != nil { return e, errCandidateHysteria2 }
 var salamander, gecko string
 var geckoMin, geckoMax int
 if options.Obfs != nil {
  if options.Obfs.Password == "" { return e, errCandidateHysteria2 }
  switch options.Obfs.Type {
  case hy2.ObfsTypeSalamander: salamander = options.Obfs.Password
  case hy2.ObfsTypeGecko:
   gecko = options.Obfs.Password
   geckoMin, geckoMax = options.Obfs.GeckoOptions.MinPacketSize, options.Obfs.GeckoOptions.MaxPacketSize
  default: return e, errCandidateHysteria2
  }
 }
 e.client, err = hy2.NewClient(hy2.ClientOptions{
  Context: owned, Dialer: dialer, Logger: logger.NOP(), BrutalDebug: options.BrutalDebug,
  ServerAddress: options.ServerOptions.Build(), SendBPS: uint64(options.UpMbps * hysteria.MbpsToBps),
  ReceiveBPS: uint64(options.DownMbps * hysteria.MbpsToBps), Password: options.Password,
  SalamanderPassword: salamander, GeckoPassword: gecko, GeckoMinPacketSize: geckoMin, GeckoMaxPacketSize: geckoMax,
  TLSConfig: tlsConfig, BBRProfile: options.BBRProfile, ChromeParrot: !options.DisableChromeParrot,
  UDPDisabled: true,
  QUICOptions: qtls.QUICOptions{IdleTimeout: options.IdleTimeout.Build(), KeepAlivePeriod: options.KeepAlivePeriod.Build(),
   StreamReceiveWindow: options.StreamReceiveWindow.Value(), ConnectionReceiveWindow: options.ConnectionReceiveWindow.Value(),
   MaxConcurrentStreams: options.MaxConcurrentStreams, InitialPacketSize: options.InitialPacketSize,
   DisablePathMTUDiscovery: options.DisablePathMTUDiscovery},
