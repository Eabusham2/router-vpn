package routervpnwhitening

import (
	"context"
	"crypto/rand"
	"encoding/base64"
	"net"
	"sync"
	"testing"
	"time"

	U "github.com/sagernet/sing-box/common/uot"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/startwhitening"
	"github.com/sagernet/sing-box/log"
