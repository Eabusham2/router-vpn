}
func socksRunRequireProofs(t *testing.T,p *socksRunPeer,f *socksBridgeNativeFixture,lower *socksRunPhysical) socksRunReply{
 t.Helper()
 if err:=f.owner.Run(f.server);err!=nil{t.Fatal("actual encrypted typed Run failed",err)}
 if !f.owner.Healthy(){t.Fatal("actual proved original runtime is not healthy")}
 var progress mobilemultihop.NodeChainProgress
 if json.Unmarshal([]byte(f.owner.ProgressJSON()),&progress)!=nil||!progress.Complete||!progress.Ready||
  !progress.DNSProven||!progress.PublicProven||len(progress.Prefixes)!=3{t.Fatal("complete original prefix/DNS/public proof missing")}
 observed:=p.observe(t);record:=socksRunCounters(t,observed)
 prefixes,ok:=record["prefixes"].([]any);if !ok||len(prefixes)!=1{t.Fatal("original packet prefix inventory changed")}
 prefix:=prefixes[0].(map[string]any)
 final:=record["final"].(map[string]any)
 middle:=record["middle"].(map[string]any)
 if lower.calls.Load()<1||socksRunCounter(t,prefix,"raw_udp")<1||socksRunCounter(t,prefix,"proof_queries")<2||
  socksRunCounter(t,middle,"public_queries")<2||socksRunCounter(t,final,"router_queries")<2||
  socksRunCounter(t,final,"final_public_queries")<1||socksRunCounter(t,final,"final_udp")<1||
  observed.DNS<1||observed.FinalAuth!=0||socksRunCounter(t,final,"direct_router_queries")!=0{t.Fatal("proved runtime bypassed original encrypted prefix/DNS")}
 return observed
}
// Constructor-only MTU adoption uses the actual retained TUN readback. This
// boundary cannot create probe sockets or replace the native reader; those
// operation/rollback paths have their separate retained-transaction gate.
type socksRunMTUPlatform struct {
 routerMTUContextPlatform
 binds atomic.Int32
}
func (p *socksRunMTUPlatform) BeginMTUChange(*RouterMTUState) error {
 p.begins++;return errors.New("constructor-only fixture cannot replace original TUN")
}
func (p *socksRunMTUPlatform) BindMTUSocket(*RouterMTUState,int64) error {
 p.binds.Add(1);return errors.New("constructor-only fixture cannot open MTU probe")
}
func socksRunAdoptMTU(t *testing.T,f *socksBridgeNativeFixture)(*RouterMTU,*socksRunMTUPlatform,string){
 t.Helper()
 state:=f.owner.state.Load()
 if state==nil||!f.owner.Healthy(){t.Fatal("MTU adoption requires actual complete encrypted proof")}
 profile:=f.owner.MTUProfile()
 if profile==""||!json.Valid([]byte(profile))||profile!=state.runtime.MTUProfile(){t.Fatal("actual SOCKS MTU profile lost original complete source")}
 platform:=&socksRunMTUPlatform{routerMTUContextPlatform:routerMTUContextPlatform{state:RouterMTUState{
  Session:state.session,Path:"original-socks-run-physical",Interface:f.tun.name,MTU:f.tun.mtu.Load(),
 }}}
 optimizer,err:=RouterNodeChainSOCKSNewMTU(f.owner,f.server,platform)
 if err!=nil||optimizer==nil{t.Fatal("proved original encrypted graph did not adopt native MTU",err)}
 t.Cleanup(func(){if err:=optimizer.Close();err!=nil{t.Error("original adopted MTU cleanup",err)}})
 claim:=f.owner.mtu.Load()
 if claim==nil||claim.native!=optimizer.owner||claim.controller.Load()!=optimizer.controller||
  optimizer.owner.server!=f.server||optimizer.owner.instance!=f.instance||optimizer.owner.inbound!=f.tun||
  platform.reads<2||platform.begins!=0||platform.ends!=0||platform.aborts!=0||platform.binds.Load()!=0||
  !f.owner.Healthy()||f.owner.NativeClosed(){t.Fatal("actual MTU adoption changed native ownership or proof")}
 if duplicate,err:=RouterNodeChainSOCKSNewMTU(f.owner,f.server,platform);err==nil||duplicate!=nil||f.owner.mtu.Load()!=claim{
  t.Fatal("duplicate MTU constructor replaced original claim")
 }
 return optimizer,platform,profile
}

