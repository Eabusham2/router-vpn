 joined bool
 original socksRunReply
}
func socksRunStartPeer(t *testing.T,mode,fault string)*socksRunPeer{
 t.Helper()
 image:=os.Getenv("ROUTERVPN_SOCKS_RUN_PEER")
 if !filepath.IsAbs(image){t.Fatal("original separately compiled peer image missing")}
 // Cover the original proof (40s), measurement (90s), drain (5s), and
 // finite startup/observation/teardown overhead. The independent peer still
 // has its own earlier deadline and must join the captured process owner.
 ctx,cancel:=context.WithTimeout(context.Background(),175*time.Second)
 p:=&socksRunPeer{cancel:cancel,done:make(chan struct{})}
 p.command=exec.CommandContext(ctx,image,"-test.run=^TestRouterVPNDesktopNodeChainSOCKSRunReference$","-test.timeout=170s","-test.v=false")
 p.command.Env=append(os.Environ(),"ROUTERVPN_SOCKS_RUN_REFERENCE=1")
 p.command.SysProcAttr=&syscall.SysProcAttr{Setpgid:true}
 p.command.WaitDelay=2*time.Second
 p.command.Cancel=func()error{
  if p.command.Process==nil{return nil}
  err:=syscall.Kill(-p.command.Process.Pid,syscall.SIGKILL)
  if errors.Is(err,syscall.ESRCH){return os.ErrProcessDone};return err
 }
 input,err:=p.command.StdinPipe();if err!=nil{cancel();t.Fatal(err)};p.input=input
 output,writer,err:=os.Pipe();if err!=nil{cancel();t.Fatal(err)}
 p.command.Stdout=writer
 p.reader=bufio.NewReaderSize(output,mobilemultihop.NodeChainInputLimit+65536)
 t.Cleanup(func(){_=output.Close()})
 p.command.Stderr=&p.stderr
 if err=p.command.Start();err!=nil{_=writer.Close();_=output.Close();cancel();t.Fatal(err)}
 _=writer.Close()
 go func(){p.waitErr=p.command.Wait();close(p.done)}()
 t.Cleanup(func(){if err:=p.close();err!=nil{t.Error("original encrypted peer did not join",err)}})
 if err=json.NewEncoder(input).Encode(map[string]any{"schema":1,"mode":mode,"fault":fault});err!=nil{t.Fatal(err)}
 p.original=p.reply(t)
 address,err:=netip.ParseAddrPort(p.original.Address)
 if err!=nil||!address.Addr().Is4()||address.Addr()!=netip.MustParseAddr("127.0.0.1")||address.Port()==0||
  p.original.Source==""||p.original.PublicCA==""||p.original.Schema!=1{t.Fatal("original peer's bounded physical/source receipt changed")}
 return p
}
func(p *socksRunPeer) reply(t *testing.T)socksRunReply{
 t.Helper()
 type value struct{line []byte;err error}
 done:=make(chan value,1)
 go func(){line,err:=p.reader.ReadSlice('\n');done<-value{append([]byte(nil),line...),err}}()
 var result value
 select{
 case result=<-done:
 case <-time.After(3*time.Second):
  p.cancel();<-p.done;result=<-done;t.Fatal("original peer response did not join",result.err)
 }
 if result.err!=nil||len(result.line)>mobilemultihop.NodeChainInputLimit+65535{t.Fatal("original peer reply missing or oversized",result.err)}
 var response socksRunReply
 decoder:=json.NewDecoder(bytes.NewReader(result.line));decoder.DisallowUnknownFields()
 if decoder.Decode(&response)!=nil||decoder.Decode(new(any))!=io.EOF||response.Schema!=1{t.Fatal("original peer reply schema changed")}
 if p.original.Source!=""&&(response.SourceSHA256!=p.original.SourceSHA256||response.ConfigSHA256!=p.original.ConfigSHA256||response.Address!=p.original.Address){
  t.Fatal("original peer identity changed during observation")
 }
 return response
}
func(p *socksRunPeer) observe(t *testing.T)socksRunReply{
 t.Helper()
 if _,err:=io.WriteString(p.input,"snapshot\n");err!=nil{t.Fatal(err)}
 return p.reply(t)
}
func(p *socksRunPeer) close()error{
 p.mu.Lock();defer p.mu.Unlock()
 if p.joined{return p.waitErr}
 _,writeErr:=io.WriteString(p.input,"quit\n")
 _=p.input.Close()
 var tail []byte
 readDone:=make(chan struct{})
 go func(){tail,_=io.ReadAll(io.LimitReader(p.reader,65537));close(readDone)}()
 select{
 case <-p.done:
 case <-time.After(5*time.Second):p.cancel();<-p.done
 }
 <-readDone
 p.cancel();p.joined=true
 if p.waitErr!=nil||writeErr!=nil||len(tail)>65536||
  strings.Count(string(tail),"SOCKS_RUN_PEER_JOINED\n")!=1||
  strings.Contains(string(tail),"FAIL")||strings.Contains(p.stderr.String(),"WARNING: DATA RACE"){
  return errors.Join(p.waitErr,writeErr,errors.New("original peer cleanup receipt absent or failed"))
 }
 return nil
}

// Only this exact physical UDP tuple is translated to the separately owned
// loopback peer. Every WG/AWG/SOCKS/SS packet and proof above it is real.
type socksRunPhysical struct{
 adapter.Outbound
 virtual,original string
 calls atomic.Int64
}
func(p *socksRunPhysical)DialContext(ctx context.Context,network string,destination M.Socksaddr)(net.Conn,error){
 if network!="udp"||destination.String()!=p.virtual{return nil,errors.New("foreign physical tuple refused")}
 p.calls.Add(1);return (&net.Dialer{}).DialContext(ctx,network,p.original)
}
func(*socksRunPhysical)ListenPacket(context.Context,M.Socksaddr)(net.PacketConn,error){
 return nil,errors.New("physical fixture requires the original connected UDP tuple")
}
type socksRunPhysicalManager struct{adapter.OutboundManager;lower adapter.Outbound}
func(m *socksRunPhysicalManager)Outbound(tag string)(adapter.Outbound,bool){
 if tag=="captured-socks-run-physical"{return m.lower,true};return m.OutboundManager.Outbound(tag)
}
type socksRunEndpoint struct{adapter.Endpoint}
// The private physical mapping is not a new graph member. The wrapped native
// endpoint is checked before this explicit physical dependency boundary.
func(*socksRunEndpoint)Dependencies()[]string{return nil}

func socksRunNative(t *testing.T,p *socksRunPeer)(*socksBridgeNativeFixture,*socksRunPhysical){
 t.Helper()
 owner,err:=NewRouterNodeChainSOCKS(p.original.Source);if err!=nil{t.Fatal("original strict source",err)}
 if owner.SourceSHA256()!=p.original.SourceSHA256||owner.ConfigSHA256()!=p.original.ConfigSHA256{t.Fatal("peer source/config seal mismatch")}
 roots:=x509.NewCertPool()
 if !roots.AppendCertsFromPEM([]byte(p.original.PublicCA)){t.Fatal("original isolated TLS certificate missing")}
 // One selected case per fresh test process: production TLS verification uses
 // its real certificate path against this explicit isolated fixture root.
 if os.Getenv("GODEBUG")!="x509usefallbackroots=1"{t.Fatal("isolated TLS root process contract missing")}
 x509.SetFallbackRoots(roots)
 f:=socksBridgeNativeReserved(t,owner)
 _,meta,err:=owner.source.ReadValidated();if err!=nil||len(meta.Physical)!=1||len(meta.Proofs)!=3{t.Fatal("complete typed source missing",err)}
 physical:=meta.Physical[0]
 lower:=&socksRunPhysical{virtual:net.JoinHostPort(physical.Host,strconv.Itoa(physical.Port)),original:p.original.Address}
 ends,ok:=service.FromContext[adapter.EndpointRegistry](f.server.ctx).(*endpoint.Registry);if !ok{t.Fatal("original endpoint registry missing")}
 resolvers,ok:=service.FromContext[adapter.DNSTransportRegistry](f.server.ctx).(*BDNS.TransportRegistry);if !ok{t.Fatal("original DNS registry missing")}
 contextFor:=func(ctx context.Context,tag string)(context.Context,error){
  if tag!=meta.Proofs[0].Tag{return nil,errors.New("foreign first endpoint")}
  actual:=service.FromContext[adapter.OutboundManager](ctx);if actual==nil{return nil,errors.New("original manager absent")}
  child:=service.ExtendContext(ctx)
  physical:=&socksRunPhysicalManager{OutboundManager:actual,lower:lower}
  child=service.ContextWith[adapter.OutboundManager](child,physical)
  if service.FromContext[adapter.OutboundManager](ctx)!=actual||service.FromContext[adapter.OutboundManager](child)!=physical{return nil,errors.New("physical fixture replaced original Box manager")}
  return child,nil
 }
 capture:=func(native adapter.Endpoint,err error)(adapter.Endpoint,error){
  if err!=nil{return native,err}
  if native==nil||!reflect.DeepEqual(native.Dependencies(),[]string{"captured-socks-run-physical"}){
   if native!=nil{_=native.Close()};return nil,errors.New("original endpoint physical dependency changed")
  }
  return &socksRunEndpoint{native},nil
 }
 endpoint.Register[option.WireGuardEndpointOptions](ends,C.TypeWireGuard,func(ctx context.Context,r adapter.Router,l log.ContextLogger,tag string,o option.WireGuardEndpointOptions)(adapter.Endpoint,error){
  ctx,err:=contextFor(ctx,tag);if err!=nil{return nil,err}
  if o.Detour!=""{return nil,errors.New("first endpoint acquired a detour")}
  o.Detour="captured-socks-run-physical";return capture(WG.NewEndpoint(ctx,r,l,tag,o))
 })
 endpoint.Register[AWG.Options](ends,mobilemultihop.AmneziaType,func(ctx context.Context,r adapter.Router,l log.ContextLogger,tag string,o AWG.Options)(adapter.Endpoint,error){
  ctx,err:=contextFor(ctx,tag);if err!=nil{return nil,err}
  if o.Detour!=""{return nil,errors.New("first AWG endpoint acquired a detour")}
  o.Detour="captured-socks-run-physical";return capture(AWG.NewEndpoint(ctx,r,l,tag,o))
 })
 // Replace the object-only resolver boundary with the original UDP transport:
 // all selected DNS packets now traverse final SS, SOCKS UDP and WG/AWG.
 DNST.RegisterUDP(resolvers)
 config,err:=owner.Config();if err!=nil{t.Fatal(err)}
 if err=f.server.StartedService.StartOrReloadService(f.server.ctx,config,nil);err!=nil{t.Fatal("actual encrypted typed native start",err)}
 cache,err:=os.Lstat(filepath.Join(f.workingPath,"cache.db"))
 if err!=nil||!cache.Mode().IsRegular(){t.Fatal("actual encrypted Box omitted original owned cache",err)}
 f.instance=f.server.StartedService.Instance()
 if f.instance==nil||f.instance.Box()==nil||f.tun==nil{t.Fatal("original native Box/TUN capture absent")}
 f.box=f.instance.Box()
 if owner.Healthy()||owner.NativeClosed(){t.Fatal("native construction fabricated Ready or DOWN")}
 return f,lower
}
