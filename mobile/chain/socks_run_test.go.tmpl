func socksRunCounter(t *testing.T,record map[string]any,name string)float64{
 t.Helper()
 number,ok:=record[name].(float64)
 if !ok||number<0||math.IsNaN(number)||math.IsInf(number,0)||math.Trunc(number)!=number{t.Fatal("original peer counter changed",name)}
