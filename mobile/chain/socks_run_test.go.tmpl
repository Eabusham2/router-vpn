// Failure-only observations preserve the original measurement verdict and
// caller budgets. Fixed categories never print config, source or credentials.
func socksRunDiagnosticClass(err error) string {
 if err==nil{return "current"}
 if errors.Is(err,context.DeadlineExceeded){return "deadline"}
 if errors.Is(err,context.Canceled){return "cancelled"}
 if errors.Is(err,net.ErrClosed){return "closed"}
 return "rejected"
}
func socksRunMeasurementDiagnostic(t *testing.T,p *socksRunPeer,f *socksBridgeNativeFixture,lastCall time.Duration){
 t.Helper()
 state:=f.owner.state.Load()
 progress:=mobilemultihop.NodeChainProgress{}
 parsed:=json.Unmarshal([]byte(f.owner.ProgressJSON()),&progress)==nil
 t.Logf("SOCKS_RUN_DIAGNOSTIC status_call_ms=%.3f progress_parsed=%t stage=%q ready=%t complete=%t dns=%t public=%t failure=%q retired=%t closed=%t state_present=%t",
  float64(lastCall)/float64(time.Millisecond),parsed,progress.Stage,progress.Ready,progress.Complete,
  progress.DNSProven,progress.PublicProven,progress.Failure,f.owner.retired.Load(),f.owner.closed.Load(),state!=nil)
 if state!=nil{
  t.Logf("SOCKS_RUN_DIAGNOSTIC lifetime=%s original_instance=%t original_box=%t engine_present=%t",
   socksRunDiagnosticClass(state.lifetime.Err()),state.instance==f.instance,state.box==f.box,state.engine.Load()!=nil)
  observe:=func(label string,read func(context.Context)error){
   ctx,cancel:=context.WithTimeout(context.Background(),hopmeasure.ObservationTimeout)
   started:=time.Now();err:=read(ctx)
   t.Logf("SOCKS_RUN_DIAGNOSTIC observation=%s result=%s caller=%s elapsed_ms=%.3f",
    label,socksRunDiagnosticClass(err),socksRunDiagnosticClass(ctx.Err()),float64(time.Since(started))/float64(time.Millisecond))
   cancel()
  }
  observe("native-owner",func(ctx context.Context)error{return f.owner.nativeCurrent(ctx,state)})
  if engine:=state.engine.Load();engine!=nil{
   observe("native-engine",func(ctx context.Context)error{_,err:=engine.ObserveChainContext(ctx);return err})
  }
 }
 observed:=p.observe(t);record:=socksRunCounters(t,observed)
 prefixes,_:=record["prefixes"].([]any)
 var prefix map[string]any
 if len(prefixes)==1{prefix,_=prefixes[0].(map[string]any)}
 middle,_:=record["middle"].(map[string]any);final,_:=record["final"].(map[string]any)
 if prefix!=nil&&middle!=nil&&final!=nil{
  t.Logf("SOCKS_RUN_DIAGNOSTIC peer_prefix_proofs=%.0f middle_public=%.0f middle_download=%.0f middle_upload=%.0f final_proofs=%.0f final_download=%.0f final_upload=%.0f dns=%d public_dns=%d auth_failures=%d associations=%d",
   socksRunCounter(t,prefix,"proof_queries"),socksRunCounter(t,middle,"public_queries"),
   socksRunCounter(t,middle,"download_bytes"),socksRunCounter(t,middle,"upload_bytes"),
   socksRunCounter(t,final,"router_queries"),socksRunCounter(t,final,"download_bytes"),socksRunCounter(t,final,"upload_bytes"),
   observed.DNS,observed.PublicDNS,observed.FinalAuth,observed.Associations)
 }
}

func TestRouterNodeChainSOCKSEncryptedRun(t *testing.T){
 chosen:=os.Getenv("ROUTERVPN_SOCKS_RUN_CASE")
 if chosen==""{t.Skip("separate encrypted peer and exact captured case required")}
 allowed:=map[string]bool{"wg":true,"awg2-fast":true,"awg2-strong":true,"middle-password":true,"final-token":true,"selected-dns":true,"middle-public":true,"hold-prefix":true}
 if !allowed[chosen]{t.Fatal("exact composed test case required")}
 t.Run(chosen,func(t *testing.T){
  mode,fault:=chosen,"";if chosen!="wg"&&chosen!="awg2-fast"&&chosen!="awg2-strong"{mode,fault="wg",chosen}
  peer:=socksRunStartPeer(t,mode,fault);f,physical:=socksRunNative(t,peer)
  if fault!=""{
   done:=make(chan error,1);go func(){done<-f.owner.Run(f.server)}()
   if fault=="hold-prefix"{
    deadline:=time.Now().Add(3*time.Second)
    held:=false
    for time.Now().Before(deadline){if peer.observe(t).HeldProofs>0{held=true;break};time.Sleep(5*time.Millisecond)}
    if !held{t.Fatal("cancel control missed real first private HTTP")}
    f.owner.NetworkChanged()
   }
   bound:=15*time.Second;if fault=="hold-prefix"{bound=hopmeasure.ObservationTimeout}
   select{
   case err:=<-done:if err==nil{t.Fatal("wrong original encrypted proof was accepted",fault)}
   case <-time.After(bound):
    if fault=="hold-prefix"{t.Fatal("cancelled original proof did not join before observation deadline")}
    t.Fatal("failed original proof did not join")
   }
   if f.owner.Healthy(){t.Fatal("failed original proof remained Ready")}
   var progress mobilemultihop.NodeChainProgress;_=json.Unmarshal([]byte(f.owner.ProgressJSON()),&progress)
   if progress.Ready{t.Fatal("failed proof published ready progress")}
   observed:=peer.observe(t)
   if physical.calls.Load()==0{t.Fatal("negative never reached original packet prefix")}
   if fault=="final-token"&&observed.FinalAuth==0{t.Fatal("wrong final token missed actual private refusal")}
   if fault=="selected-dns"&&observed.DNS==0{t.Fatal("wrong DNS missed actual full-prefix packet query")}
   socksRunCloseNative(t,f)
   if err:=peer.close();err!=nil{t.Fatal(err)}
   return
  }
  before:=socksRunRequireProofs(t,peer,f,physical)
  optimizer,mtuPlatform,mtuProfile:=socksRunAdoptMTU(t,f)
  measurement,err:=RouterNodeChainSOCKSNewHopMeasurement(f.owner,f.server);if err!=nil{t.Fatal("original measurement adoption",err)}
  _,meta,err:=f.owner.source.ReadValidated();if err!=nil{t.Fatal(err)}
  id:=strings.Repeat("a",32)
  // This is the original three-member throughput API. The unrelated
  // external-final 50-sample endpoint must not adopt an intermediate node.
  if measurement.StartLatency(id,meta.Proofs[1].ProfileID)==nil{t.Fatal("middle borrowed external-final latency authority")}
  if err=measurement.Start(id,65536);err!=nil{t.Fatal("original routed measurement start",err)}
  var status hopmeasure.Status
  measurementStarted:=time.Now()
  // The original worker owns its full 90-second, fifty-sample budget. Allow
  // one bounded observation to report that worker's terminal state; this
  // observer does not change proof, sample, cancellation or drain deadlines.
  deadline:=time.Now().Add(hopmeasure.RequestTimeout+hopmeasure.ObservationTimeout)
  lastStage:="";var lastCall time.Duration
  for time.Now().Before(deadline){
   started:=time.Now();raw:=measurement.StatusJSON();lastCall=time.Since(started)
   if json.Unmarshal([]byte(raw),&status)!=nil{t.Fatal("original measurement status")}
   if status.Stage!=lastStage{
    t.Logf("SOCKS_RUN_STAGE stage=%q complete=%t results=%d elapsed_ms=%.3f status_call_ms=%.3f",
     status.Stage,status.Complete,len(status.Results),float64(time.Since(measurementStarted))/float64(time.Millisecond),float64(lastCall)/float64(time.Millisecond))
    lastStage=status.Stage
   }
   if status.Complete{break};time.Sleep(10*time.Millisecond)
  }
  if !status.Complete||status.Stage!="complete"||status.Failure!=""||len(status.Results)!=3{
   socksRunMeasurementDiagnostic(t,peer,f,lastCall)
   t.Fatal("complete real ordered measurement missing",status.Stage,status.Failure)
  }
  for position,result:=range status.Results{
   expected:="private-node";if position==1{expected="public-path"}
   if !result.Ready||result.Kind!=expected||result.ID!=meta.Proofs[position].ProfileID||
    result.Idle==nil||result.Download==nil||result.Upload==nil{t.Fatal("actual ordered result lost original identity/transfer",position,result.Failure)}
  }
  if err=measurement.Drain(id);err!=nil{t.Fatal("original measurement worker not joined",err)}
  if measurement.Start(id,65536)==nil{t.Fatal("completed measurement request replayed")}
  after:=peer.observe(t)
  peerRecord:=socksRunCounters(t,after)
  middle:=peerRecord["middle"].(map[string]any);final:=peerRecord["final"].(map[string]any)
  if after.PublicDNS<=before.PublicDNS||after.DNS<before.DNS||
   socksRunCounter(t,middle,"download_bytes")<65536||socksRunCounter(t,middle,"upload_bytes")!=65536||
   socksRunCounter(t,final,"download_bytes")!=65536||socksRunCounter(t,final,"upload_bytes")!=65536{
   t.Fatal("real measurement bypassed original selected DNS/byte sink")
  }
  if err=measurement.Close();err!=nil{t.Fatal("original measurement close",err)}
  if err=optimizer.Close();err!=nil{t.Fatal("original proved MTU owner did not join before plan Close",err)}
  if f.owner.mtu.Load()!=nil||!f.owner.Healthy()||f.owner.NativeClosed()||f.owner.MTUProfile()!=mtuProfile||
   mtuPlatform.begins!=0||mtuPlatform.ends!=0||mtuPlatform.aborts!=0||mtuPlatform.binds.Load()!=0{
   t.Fatal("idle MTU close changed original proved path or manufactured native DOWN")
  }
  socksRunCloseNative(t,f)
  // NativeClosed proves the client-side joins. The independent peer may
  // publish its EOF observation on a later scheduler turn; require that exact
  // terminal counter within the original observation allowance.
  observed:=peer.observe(t)
  joinedBy:=time.Now().Add(hopmeasure.ObservationTimeout)
  for observed.Associations!=0&&time.Now().Before(joinedBy){time.Sleep(time.Millisecond);observed=peer.observe(t)}
  if observed.Associations!=0{t.Fatal("original peer association did not observe joined native close")}
  if err:=peer.close();err!=nil{t.Fatal(err)}
 })
}
