// Original constructor/manager/selector/middle ownership is real. OS TUN
// acquisition/readback and shared runtime pause are explicit component
// boundaries; the libbox composition separately executes the actual pause.
type connectMTUReader struct {
	inbound.Adapter
	name                       string
	index, mtu                 int
	live                       atomic.Bool
	startFailure, closeFailure atomic.Bool
}

func connectMTUNewReader(name string, index, mtu int) *connectMTUReader {
	return &connectMTUReader{Adapter: inbound.NewAdapter(C.TypeTun, "routervpn-chain-tun"), name: name, index: index, mtu: mtu}
}
func (r *connectMTUReader) Start(stage adapter.StartStage) error {
	if r.startFailure.Load() {
		return errors.New("original MTU candidate startup refused")
	}
	if stage == adapter.StartStateStart {
		r.live.Store(true)
	}
	return nil
}
func (r *connectMTUReader) Close() error {
	if r.closeFailure.Load() {
		return errors.New("original unused MTU reader still unjoined")
	}
	r.live.Store(false)
	return nil
}
func (r *connectMTUReader) RouterVPNExecutionMTUReadbackContext(ctx context.Context) (string, int, int, error) {
	if !r.live.Load() {
		return "", 0, 0, errors.New("original native reader is not live")
	}
	if err := ctx.Err(); err != nil {
		return "", 0, 0, err
	}
	return r.name, r.index, r.mtu, nil
}

