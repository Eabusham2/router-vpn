func (f *connectMTUFixture) observe(ctx context.Context) error {
	if !f.current.Load() {
		return errors.New("original native source retired")
	}
	return ctx.Err()
}

type connectMTUPauseOwner struct {
	fixture    *connectMTUFixture
	engine     *RouterVPNNodeChainCONNECTEngine
	block      chan struct{}
	entered    chan struct{}
	pauseCalls atomic.Int32
	current    atomic.Bool
}

func newCONNECTMTUPauseOwner(f *connectMTUFixture) *connectMTUPauseOwner {
	p := &connectMTUPauseOwner{fixture: f, engine: f.engine}
	p.current.Store(true)
	return p
}
func (p *connectMTUPauseOwner) PauseCONNECTMTUContext(ctx context.Context, source *mobilemultihop.NodeChainCONNECTSource, engine *RouterVPNNodeChainCONNECTEngine) error {
	if source != p.fixture.source || engine != p.engine {
		return errors.New("foreign original proof pause")
	}
	p.pauseCalls.Add(1)
	if p.entered != nil {
		select {
		case p.entered <- struct{}{}:
		default:
		}
	}
	if p.block != nil {
		select {
		case <-p.block:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return ctx.Err()
}
func (p *connectMTUPauseOwner) ObserveCONNECTMTUContext(ctx context.Context, source *mobilemultihop.NodeChainCONNECTSource) error {
	if source != p.fixture.source || !p.current.Load() {
		return errors.New("foreign paused native owner")
	}
	return p.fixture.observe(ctx)
}
func connectMTUOperation(t *testing.T) (context.Context, context.CancelFunc) {
	t.Helper()
	ctx, done, err := mobilemtu.WithOperationContext(t.Context(), 5*time.Second, 3*time.Second)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(done)
	return ctx, done
}
func connectMTUBegin(t *testing.T, f *connectMTUFixture) (context.Context, *connectMTUPauseOwner, *RouterVPNNodeChainCONNECTMTU) {
	t.Helper()
	ctx, _ := connectMTUOperation(t)
	p := newCONNECTMTUPauseOwner(f)
	m, err := f.engine.BeginCONNECTMTUContext(ctx, p)
	if err != nil {
		t.Fatal(err)
	}
	if err = m.PauseContext(ctx); err != nil {
		t.Fatal(err)
	}
	return ctx, p, m
}
func connectMTUAcquire(f *connectMTUFixture, candidate, rollback *connectMTUReader, count *int) func(context.Context, adapter.Inbound, int) (*inbound.RouterVPNTunTransaction, error) {
	return func(ctx context.Context, original adapter.Inbound, _ int) (*inbound.RouterVPNTunTransaction, error) {
		(*count)++
		return f.box.inbound.RouterVPNReplaceTunOwned(ctx, original, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
	}
}
func TestRouterVPNNodeChainCONNECTMTUJoinedNativeReader(t *testing.T) {
	for _, scenario := range []string{"candidate", "rollback", "unchanged", "pending-close"} {
		t.Run(scenario, func(t *testing.T) {
			f := newCONNECTMTUFixture(t)
			ctx, p, m := connectMTUBegin(t, f)
			candidate, rollback := connectMTUNewReader("candidate-connect-tun", 73, 1300), connectMTUNewReader("rollback-connect-tun", 74, 1280)
			candidate.startFailure.Store(scenario == "rollback")
			rollback.closeFailure.Store(scenario == "pending-close")
			acquired := 0
			target := 1300
			if scenario == "unchanged" {
				target = 1280
			}
			value, err := m.changeContext(ctx, f.tun, target, connectMTUAcquire(f, candidate, rollback, &acquired))
			if scenario == "pending-close" {
				if err == nil || value != candidate || m.step == nil || m.step.joined || !m.RetainsCleanup() {
					t.Fatal("unjoined CONNECT MTU reader escaped its original operation", err)
				}
				if _, err = m.ResumeContext(ctx, f.observe); err == nil {
					t.Fatal("unjoined CONNECT MTU transaction authorized new proof")
				}
				if err = m.CloseContext(ctx); err == nil || !m.RetainsCleanup() {
					t.Fatal("failed CONNECT MTU retirement erased original cleanup", err)
				}
				rollback.closeFailure.Store(false)
				if err = m.PauseContext(ctx); err != nil {
					t.Fatal(err)
				}
				value, err = m.changeContext(ctx, f.tun, target, connectMTUAcquire(f, candidate, rollback, &acquired))
			}
			if scenario == "rollback" {
				if err == nil || value != rollback {
					t.Fatal("failed CONNECT MTU candidate lost actual rollback", err)
				}
			} else if err != nil {
				t.Fatal(err)
			}
			want := 1
			if scenario == "unchanged" {
				want = 0
			}
			if acquired != want || m.step == nil || !m.step.joined || m.Current() != value {
				t.Fatal("CONNECT MTU retried acquisition or lost joined reader")
			}
			next, err := m.ResumeContext(ctx, f.observe)
			if err != nil || next == nil {
				t.Fatal("exact joined reader could not resume proof", err)
			}
			p.engine = next
			if _, err = next.ObserveChainContext(ctx); err != nil {
				t.Fatal(err)
			}
			if _, err = f.engine.ObserveChainContext(ctx); err == nil {
				t.Fatal("old CONNECT proof engine survived reader handoff")
			}
			if err = m.FinishContext(ctx); err != nil || m.RetainsCleanup() {
				t.Fatal("joined current operation did not detach", err)
			}
			if _, err = next.ObserveChainContext(ctx); err != nil {
				t.Fatal("finished native receipt invalidated current proof", err)
			}
			if _, err = f.box.RouterVPNNewNodeChainCONNECTEngine(ctx, f.source, strings.Repeat("e", 64), f.observe); scenario != "rollback" && scenario != "unchanged" && err == nil {
				t.Fatal("initial constructor admitted changed MTU without continuation")
			}
		})
	}
}
func TestRouterVPNNodeChainCONNECTMTUHeldPauseAndForeignCaller(t *testing.T) {
	f := newCONNECTMTUFixture(t)
	ctx, _ := connectMTUOperation(t)
	p := newCONNECTMTUPauseOwner(f)
	p.block, p.entered = make(chan struct{}), make(chan struct{}, 1)
	m, err := f.engine.BeginCONNECTMTUContext(ctx, p)
	if err != nil {
		t.Fatal(err)
	}
	if _, err = f.engine.observation.ObserveChainContext(ctx); err == nil {
		t.Fatal("nested original proof observation escaped its MTU pause")
	}
	var releaseOnce sync.Once
	unblock := func() { releaseOnce.Do(func() { close(p.block) }) }
	joined := make(chan struct{})
	var pauseErr error
	go func() { pauseErr = m.PauseContext(ctx); close(joined) }()
	t.Cleanup(func() {
		unblock()
		cleanup, stop := context.WithTimeout(context.Background(), 2*time.Second)
		defer stop()
		select {
		case <-joined:
		case <-cleanup.Done():
			t.Error("original held CONNECT proof callback did not join")
			return
		}
		if m.RetainsCleanup() {
			if err := m.RetireContext(cleanup, p); err != nil {
				t.Error("original held CONNECT proof cleanup did not join", err)
			}
		}
	})
	// Admission to the held callback is causal evidence. A short timeout
	// spent in unrelated native observation cannot substitute for this join.
	select {
	case <-p.entered:
	case <-joined:
		t.Fatal("held original CONNECT proof pause released its MTU owner", pauseErr)
	case <-ctx.Done():
		t.Fatal("held original CONNECT proof pause released its MTU owner", ctx.Err())
	}
	short, stop := context.WithTimeout(ctx, 15*time.Millisecond)
	err = m.PauseContext(short)
	stop()
	if !errors.Is(err, context.DeadlineExceeded) || !m.RetainsCleanup() {
		t.Fatal("held original CONNECT proof pause released its MTU owner", err)
	}
	short, stop = context.WithTimeout(ctx, 15*time.Millisecond)
	_, err = m.ChangeContext(short, f.tun, 1300)
	stop()
	if !errors.Is(err, context.DeadlineExceeded) || m.Current() != f.tun {
		t.Fatal("unjoined original proof allowed native mutation", err)
	}
	if _, err = f.engine.BeginCONNECTMTUContext(ctx, p); err == nil {
		t.Fatal("same original engine admitted a second MTU owner")
	}
	unblock()
	select {
	case <-joined:
	case <-ctx.Done():
		t.Fatal("original held CONNECT proof callback did not join", ctx.Err())
	}
	if pauseErr != nil {
		t.Fatal(pauseErr)
	}
	if err = m.PauseContext(ctx); err != nil {
		t.Fatal(err)
	}
	foreign, _ := connectMTUOperation(t)
	if err = m.PauseContext(foreign); err == nil {
		t.Fatal("foreign MTU operation joined original proof")
	}
	if err = m.CloseContext(ctx); err != nil || m.RetainsCleanup() {
		t.Fatal("joined exact pause could not retire", err)
	}
}
func TestRouterVPNNodeChainCONNECTMTUResumeKeepsNativeReadback(t *testing.T) {
	for _, fault := range []string{"name", "index", "mtu", "source", "network", "caller"} {
		t.Run(fault, func(t *testing.T) {
			f := newCONNECTMTUFixture(t)
			ctx, p, m := connectMTUBegin(t, f)
			if _, err := m.ChangeContext(ctx, f.tun, 1280); err != nil {
				t.Fatal(err)
			}
			switch fault {
			case "name":
				f.tun.name = "foreign"
			case "index":
				f.tun.index++
			case "mtu":
				f.tun.mtu++
			case "source":
				p.current.Store(false)
			case "network":
				monitor := chainNativeField[tun.DefaultInterfaceMonitor](t, f.box.network, "interfaceMonitor")
				*monitor = &chainNativeMonitor{physical: &control.Interface{Name: "foreign", Index: 99}}
			case "caller":
				cancelled, stop := context.WithCancel(ctx)
				stop()
				ctx = cancelled
			}
			if _, err := m.ResumeContext(ctx, f.observe); err == nil {
				t.Fatal("changed original CONNECT reader or owner admitted resume", fault)
			}
			if !m.RetainsCleanup() {
				t.Fatal("rejected CONNECT resume dropped its cleanup owner")
			}
			// No new native reader was acquired by this test; explicit teardown
			// remains the original fixture manager's responsibility.
		})
	}
}
func TestRouterVPNNodeChainCONNECTMTUCleanupRestoresOnlyOriginalValue(t *testing.T) {
	f := newCONNECTMTUFixture(t)
	ctx, p, m := connectMTUBegin(t, f)
	candidate, rollback := connectMTUNewReader("candidate", 73, 1300), connectMTUNewReader("rollback", 74, 1280)
	acquired := 0
	if _, err := m.changeContext(ctx, f.tun, 1300, connectMTUAcquire(f, candidate, rollback, &acquired)); err != nil {
		t.Fatal(err)
	}
	cleanup, err := mobilemtu.OperationCleanupContext(ctx)
	if err != nil {
		t.Fatal(err)
	}
	if _, err = m.ResumeContext(cleanup, f.observe); err == nil {
		t.Fatal("cleanup context resumed unrestored CONNECT probe")
	}
	if _, err = m.ChangeContext(cleanup, candidate, 1320); err == nil {
		t.Fatal("cleanup context acquired another CONNECT MTU probe")
	}
	restored, backup := connectMTUNewReader("restored", 75, 1280), connectMTUNewReader("retained-probe", 76, 1300)
	if _, err = m.changeContext(cleanup, candidate, 1280, connectMTUAcquire(f, restored, backup, &acquired)); err != nil {
		t.Fatal(err)
	}
	next, err := m.ResumeContext(cleanup, f.observe)
	if err != nil {
		t.Fatal("exact original native MTU could not restore", err)
	}
	p.engine = next
	if err = m.FinishContext(cleanup); err != nil {
		t.Fatal(err)
	}
	if acquired != 2 {
		t.Fatal("cleanup repeated native acquisition")
	}
}

func TestRouterVPNNodeChainCONNECTMTULateOriginalResultRetainsReader(t *testing.T) {
	f := newCONNECTMTUFixture(t)
	ctx, p, m := connectMTUBegin(t, f)
	candidate, rollback := connectMTUNewReader("late-candidate", 73, 1300), connectMTUNewReader("late-backup", 74, 1280)
	child, cancel := context.WithCancel(ctx)
	defer cancel()
	acquired := 0
	acquire := connectMTUAcquire(f, candidate, rollback, &acquired)
	value, err := m.changeContext(child, f.tun, 1300, func(call context.Context, original adapter.Inbound, target int) (*inbound.RouterVPNTunTransaction, error) {
		receipt, failure := acquire(call, original, target)
		cancel()
		return receipt, errors.Join(failure, call.Err())
	})
	if err == nil || value != candidate || m.Current() != candidate || m.step == nil || m.step.transaction == nil || m.step.joined {
		t.Fatal("late original CONNECT MTU result lost partial reader authority", err)
	}
	cleanup, err := mobilemtu.OperationCleanupContext(child)
	if err != nil {
		t.Fatal(err)
	}
	restored, backup := connectMTUNewReader("late-restored", 75, 1280), connectMTUNewReader("late-probe", 76, 1300)
	if _, err = m.changeContext(cleanup, candidate, 1280, connectMTUAcquire(f, restored, backup, &acquired)); err != nil {
		t.Fatal(err)
	}
	next, err := m.ResumeContext(cleanup, f.observe)
	if err != nil {
		t.Fatal(err)
	}
	p.engine = next
	if err = m.FinishContext(cleanup); err != nil || acquired != 2 {
		t.Fatal("late original receipt did not restore exactly once", err)
	}
}
func TestRouterVPNNodeChainCONNECTMTUManagerAndLockRemainOwned(t *testing.T) {
	f := newCONNECTMTUFixture(t)
	ctx, _, m := connectMTUBegin(t, f)
	if _, err := m.ChangeContext(ctx, f.tun, 1280); err != nil {
		t.Fatal(err)
	}
	m.mu.Lock()
	short, stop := context.WithTimeout(ctx, 15*time.Millisecond)
	_, err := m.ChangeContext(short, f.tun, 1300)
	stop()
	m.mu.Unlock()
	if !errors.Is(err, context.DeadlineExceeded) {
		t.Fatal("held CONNECT MTU owner ignored caller deadline", err)
	}
	old := f.box.inbound
	f.box.inbound = inbound.NewManager(log.NewNOPFactory().Logger(), inbound.NewRegistry(), f.box.endpoint)
	if _, err = m.ResumeContext(ctx, f.observe); err == nil {
		t.Fatal("foreign native manager adopted original CONNECT MTU receipt")
	}
	if err = m.CloseContext(ctx); err != nil {
		t.Fatal("original cleanup followed substituted native manager", err)
	}
	f.box.inbound = old
}

func TestRouterVPNNodeChainCONNECTMTURetirementAfterWorkCannotRenewAuthority(t *testing.T) {
	f := newCONNECTMTUFixture(t)
	operation, finish := connectMTUOperation(t)
	original := newCONNECTMTUPauseOwner(f)
	retained, err := f.engine.BeginCONNECTMTUContext(operation, original)
	if err != nil {
		t.Fatal(err)
	}
	finish()
	call, cancel := context.WithTimeout(t.Context(), time.Second)
	defer cancel()
	if err = retained.PauseContext(call); err == nil {
		t.Fatal("expired CONNECT MTU operation regained proof-pause authority")
	}
	if _, err = retained.ChangeContext(call, f.tun, 1300); err == nil {
		t.Fatal("expired CONNECT MTU operation regained mutation authority")
	}
	if _, err = retained.ResumeContext(call, f.observe); err == nil {
		t.Fatal("expired CONNECT MTU operation regained proof authority")
	}
	if err = retained.FinishContext(call); err == nil {
		t.Fatal("expired CONNECT MTU operation published a winner")
	}
	foreign := newCONNECTMTUPauseOwner(f)
	if err = retained.RetireContext(call, foreign); err == nil {
		t.Fatal("replacement CONNECT MTU owner retired original handles")
	}
	if original.pauseCalls.Load() != 0 {
		t.Fatal("foreign cleanup reached original proof join")
	}
	if err = retained.RetireContext(call, original); err != nil || retained.RetainsCleanup() {
		t.Fatal("original expired operation could not join retained handles", err)
	}
	if original.pauseCalls.Load() != 1 {
		t.Fatal("retirement did not join original proof exactly once")
	}
	if err = retained.RetireContext(call, original); err != nil || original.pauseCalls.Load() != 1 {
		t.Fatal("joined retirement reacquired original work", err)
	}
}
func TestRouterVPNNodeChainCONNECTMTURetirementRetainsFailedJoin(t *testing.T) {
	f := newCONNECTMTUFixture(t)
	operation, finish := connectMTUOperation(t)
	original := newCONNECTMTUPauseOwner(f)
	original.block = make(chan struct{})
	retained, err := f.engine.BeginCONNECTMTUContext(operation, original)
	if err != nil {
		t.Fatal(err)
	}
	finish()
	call, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
	err = retained.RetireContext(call, original)
	cancel()
	if !errors.Is(err, context.DeadlineExceeded) || !retained.RetainsCleanup() {
		t.Fatal("expired-operation retirement erased failed original join", err)
	}
	close(original.block)
	call, cancel = context.WithTimeout(t.Context(), time.Second)
	defer cancel()
	if err = retained.RetireContext(call, original); err != nil || retained.RetainsCleanup() {
		t.Fatal("original retirement retry failed", err)
	}
}

// CONNECT MTU cannot borrow the source's separately captured final UoT-v2
// carrier or copy its original Box while the proof is paused.
func TestRouterVPNNodeChainCONNECTMTUKeepsCarrierAndBox(t *testing.T) {
	for _, fault := range []string{"uot-version", "copied-box"} {
		t.Run(fault, func(t *testing.T) {
			f := newCONNECTMTUFixture(t)
			ctx, p, m := connectMTUBegin(t, f)
			if _, err := m.changeContext(ctx, f.tun, 1280, nil); err == nil {
				t.Fatal("nil transaction factory acquired MTU authority")
			}
			if _, err := m.changeContext(ctx, f.tun, 1280, func(context.Context, adapter.Inbound, int) (*inbound.RouterVPNTunTransaction, error) {
				t.Fatal("unchanged native reader unexpectedly reconstructed")
				return nil, nil
			}); err != nil {
				t.Fatal(err)
			}
			original := m.original.observation.instance
			_, meta, err := f.source.ReadValidated()
			if err != nil {
				t.Fatal(err)
			}
			value, ok := f.box.outbound.Outbound(meta.Proofs[2].Tag)
			if !ok {
				t.Fatal("original final missing")
			}
			final, ok := value.(*ss.Outbound)
			if !ok {
				t.Fatal("original final is not real Shadowsocks")
			}
			client := *chainNativeField[*uot.Client](t, final, "uotClient")
			if client == nil || client.Version != 2 {
				t.Fatal("original final UoT-v2 missing")
			}
			restore := func() {}
			switch fault {
			case "uot-version":
				client.Version = 1
				restore = func() { client.Version = 2 }
			case "copied-box":
				copied := *original
				m.original.observation.instance = &copied
				restore = func() { m.original.observation.instance = original }
			}
			next, err := m.ResumeContext(ctx, f.observe)
			restore()
			if err == nil || next != nil {
				t.Fatal("CONNECT MTU resumed with replaced original carrier or Box")
			}
			next, err = m.ResumeContext(ctx, f.observe)
			if err != nil || next == nil {
				t.Fatal("restored exact CONNECT owner failed resume", err)
			}
			p.engine = next
			if err = m.FinishContext(ctx); err != nil {
				t.Fatal(err)
			}
		})
	}
}
