// Each peer authenticates its own actual SS2022 stream. The entry packet
// transport and selected DNS answer use the established native test boundaries.
type multipleImportedWirePeer struct {
	position    int
	nextSocket  string
	nextVirtual string
	served      atomic.Int64
	forwarded   atomic.Int64
}

func (p *multipleImportedWirePeer) NewConnection(ctx context.Context, conn net.Conn, meta M.Metadata) error {
	defer conn.Close()
	switch target := meta.Destination.String(); {
	case target == "93.184.216.34:443":
		if err := conn.SetDeadline(time.Now().Add(4 * time.Second)); err != nil {
			return err
		}
		line, err := bufio.NewReader(conn).ReadString('\n')
		if err != nil || line != "captured public prefix\n" {
			return errors.New("wrong prefix request")
		}
		p.served.Add(1)
		_, err = fmt.Fprintf(conn, "proved position %d\n", p.position)
		return err
	case target == p.nextVirtual && p.nextSocket != "":
		up, err := (&net.Dialer{}).DialContext(ctx, "tcp", p.nextSocket)
		if err != nil {
			return err
		}
		defer up.Close()
		p.forwarded.Add(1)
		done := make(chan struct{})
		go func() { defer close(done); io.Copy(up, conn); up.Close() }()
		io.Copy(conn, up)
		conn.Close()
		up.Close()
		<-done
		return nil
	default:
		return errors.New("foreign encrypted prefix target")
	}
}
func (*multipleImportedWirePeer) NewPacketConnection(context.Context, N.PacketConn, M.Metadata) error {
	return errors.New("TCP prefix required")
}
func (*multipleImportedWirePeer) NewError(context.Context, error) {}

func (p *multipleImportedWirePeer) listen(t *testing.T, method, password string) string {
	t.Helper()
	service, err := shadowaead_2022.NewServiceWithPassword(method, password, 10, p, nil)
	if err != nil {
		t.Fatal(err)
	}
	ln, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	var workers sync.WaitGroup
	var conns sync.Map
	accepted := make(chan struct{})
	go func() {
		defer close(accepted)
		for {
			conn, err := ln.Accept()
			if err != nil {
				return
			}
			conns.Store(conn, true)
			workers.Add(1)
			go func() {
				defer workers.Done()
				defer conn.Close()
				defer conns.Delete(conn)
				conn.SetDeadline(time.Now().Add(8 * time.Second))
				service.NewConnection(t.Context(), conn, M.Metadata{Source: M.SocksaddrFromNet(conn.RemoteAddr())})
			}()
		}
	}()
	t.Cleanup(func() {
		ln.Close()
		<-accepted
		conns.Range(func(key, value any) bool { key.(net.Conn).Close(); return true })
		workers.Wait()
	})
	return ln.Addr().String()
}

func TestRouterVPNMultipleImportedExecutionNativeLocalEncrypted(t *testing.T) {
	for _, fault := range []string{"original", "wrong-first-key", "wrong-second-key"} {
		t.Run(fault, func(t *testing.T) {
			f, source := multipleImportedNativeFixture(t, "adjacent", "auto", true)
			projection := f.adopt(t)
			dns, err := projection.DNSCapture("local")
			if err != nil || f.engine.SelectContext(t.Context(), dns.SelectedTag) != nil {
				t.Fatal("original Local selection", err)
			}
			captures, _, err := projection.ImportedPublicMeasurementCaptures("local")
			if err != nil || len(captures) != 2 {
				t.Fatal("two independently selected public hops required", err)
			}
			options, err := SJ.UnmarshalExtendedContext[option.Options](f.ctx, []byte(f.prep.Config()))
			if err != nil {
				t.Fatal(err)
			}
			peers := make([]*multipleImportedWirePeer, 2)
			var physical, virtual string
			for i := len(captures) - 1; i >= 0; i-- {
				m := captures[i]
				p := &multipleImportedWirePeer{position: m.Position, nextVirtual: virtual, nextSocket: physical}
				peers[i] = p
				var found bool
				for _, spec := range options.Outbounds {
					if spec.Tag != m.Tag {
						continue
					}
					o, ok := spec.Options.(*option.ShadowsocksOutboundOptions)
					if !ok || o == nil {
						t.Fatal("sealed imported outbound changed type")
					}
					password := o.Password
					if fault == "wrong-first-key" && i == 0 || fault == "wrong-second-key" && i == 1 {
						password = "QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE="
					}
					physical, virtual = p.listen(t, o.Method, password), o.ServerOptions.Build().String()
					found = true
				}
				if !found {
					t.Fatal("original imported outbound missing")
				}
			}
			entry := f.prefixes[source.ProofInventory()[0].Tag]
			entry.dialAddress = func(ctx context.Context, network string, addr M.Socksaddr) (net.Conn, error) {
				if network != "tcp" || addr.String() != virtual {
					return nil, errors.New("physical transport escaped original entry")
				}
				return (&net.Dialer{}).DialContext(ctx, "tcp", physical)
			}
			for i, m := range captures {
				ctx, cancel := context.WithTimeout(t.Context(), 6*time.Second)
				conn, err := f.engine.Dial(ctx, m.Tag, hopmeasure.PublicAddress)
				var line string
				if err == nil && conn != nil {
					conn.SetDeadline(time.Now().Add(4 * time.Second))
					if _, err = io.WriteString(conn, "captured public prefix\n"); err == nil {
						line, err = bufio.NewReader(conn).ReadString('\n')
					}
				}
				if conn != nil {
					conn.Close()
				}
				cancel()
				valid := fault == "original" || fault == "wrong-second-key" && i == 0
				if valid && (err != nil || line != fmt.Sprintf("proved position %d\n", m.Position) || peers[i].served.Load() != 1) {
					t.Fatal("original encrypted prefix not returned", i, err)
				}
				if !valid && (err == nil || line != "" || peers[i].served.Load() != 0) {
					t.Fatal("wrong independent key delivered public prefix response", i)
				}
			}
			if fault == "original" && (peers[0].forwarded.Load() != 1 || f.dns.calls.Load() < 2) {
				t.Fatal("later prefix escaped original encrypted predecessor or selected resolver")
			}
			if open, err := f.engine.ApplicationOpenContext(t.Context()); err != nil || open {
				t.Fatal("component traffic opened application route", err)
			}
		})
	}
}
