package libbox

import (
	"encoding/json"
	"testing"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	M "github.com/sagernet/sing/common/metadata"
)

// The actual SOCKS operation must use its own captured IPv6 choice, rather
// than the private packet member that happened to occupy old index one.
func TestRouterNodeChainSOCKSPrefixIPv6Ownership(t *testing.T) {
	for _, middleMode := range []string{"off", "on"} {
		t.Run(middleMode, func(t *testing.T) {
			original := socksBridgeSourcePrefixes(t, 3, "wg")
			raw, err := original.Source()
			if err != nil {
				t.Fatal(err)
			}
			var source mobilemultihop.NodeChainSource
			if json.Unmarshal([]byte(raw), &source) != nil {
				t.Fatal("source")
			}
			var imported map[string]any
			if json.Unmarshal([]byte(source.Nodes[3]), &imported) != nil {
				t.Fatal("member")
			}
			var graph, capture map[string]any
			if json.Unmarshal([]byte(imported["config"].(string)), &graph) != nil || json.Unmarshal([]byte(imported["capture"].(string)), &capture) != nil {
				t.Fatal("member capture")
			}
			profile := capture["profile"].(map[string]any)
			profile["ipv6_mode"], profile["endpoint"] = middleMode, "2001:db8::20"
			profile["external"].(map[string]any)["socks5"].(map[string]any)["host"] = "2001:db8::20"
			graph["outbounds"].([]any)[0].(map[string]any)["server"] = "2001:db8::20"
			source.Nodes[3], err = RouterNodeChainImportedSOCKSMemberInput(candidateBridgeJSON(t, graph), candidateBridgeJSON(t, capture))
			if err != nil {
				t.Fatal(err)
			}
			var prefix struct {
				Mode         string `json:"mode"`
				Files        string `json:"files"`
				ProfileJSON  string `json:"profile_json"`
				Start        string `json:"start"`
				DNSBootstrap string `json:"dns_bootstrap"`
			}
			if json.Unmarshal([]byte(source.Nodes[1]), &prefix) != nil {
				t.Fatal("prefix")
			}
			var pp map[string]any
			if json.Unmarshal([]byte(prefix.ProfileJSON), &pp) != nil {
				t.Fatal("prefix profile")
			}
			pp["ipv6_mode"] = "on"
			if middleMode == "on" {
				pp["ipv6_mode"] = "off"
			}
			node, err := mobilemultihop.NewNodeProfile(prefix.Mode, prefix.Files, candidateBridgeJSON(t, pp), prefix.Start, prefix.DNSBootstrap)
			if err != nil {
				t.Fatal(err)
			}
			source.Nodes[1], err = node.LaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			owner, err := NewRouterNodeChainSOCKS(candidateBridgeJSON(t, source))
			if err != nil {
				t.Fatal(err)
			}
			f := socksBridgeStarted(t, owner)
			_, meta, err := owner.source.ReadValidated()
			if err != nil {
				t.Fatal(err)
			}
			middle, found := f.box.Outbound().Outbound(meta.Proofs[3].Tag)
			if !found {
				t.Fatal("middle")
			}
			lower, found := f.box.Outbound().Outbound(meta.Proofs[2].Tag)
			if !found { t.Fatal("original last prefix") }
			retained := lower.(*socksBridgeNativePrefix)
			before := retained.calls.Load()
			conn, dialErr := middle.DialContext(t.Context(), "tcp", M.ParseSocksaddr("198.51.100.24:8388"))
			if conn != nil {
				conn.Close()
				t.Fatal("explicit refusing lower unexpectedly admitted connection")
			}
			if dialErr == nil {
				t.Fatal("explicit lower refusal was lost")
			}
			calls := retained.calls.Load() - before
			if (calls == 1) != (middleMode == "on") {
				t.Fatal("SOCKS control socket borrowed prefix IPv6 policy", middleMode, calls)
			}
		})
	}
}
