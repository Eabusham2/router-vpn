// Connected typed candidate handles retain the complete original runtime and
// native owner. They cannot borrow a dormant saved-prefix preparation.
type RouterNodeChainSOCKSCandidateMeasurement struct {
	self            *RouterNodeChainSOCKSCandidateMeasurement
	owner           *RouterNodeChainSOCKS
	state           *routerNodeChainSOCKSState
	runtime         *mobilemultihop.NodeChainSOCKSRuntime
	engine          *box.RouterVPNNodeChainSOCKSEngine
	plan            *mobilemultihop.NodeChainSOCKSConnectedCandidatePlan
	catalog         RouterNodeChainCandidateCatalog
	inventorySHA    string
	service         atomic.Pointer[hopmeasure.CandidateService]
	retired         atomic.Bool
	callbackActive  atomic.Bool
	observation     sync.Mutex
	pending         *routerNodeChainCatalogCall
	preparation     sync.Mutex
	prepareStarted  bool          // preparation; every admitted Prepare must join before slot release
	prepareDeadline time.Time     // immutable original construction observation deadline
	prepareDone     chan struct{} // preparation; closed by the original Prepare caller
}

func RouterNodeChainSOCKSNewCandidateMeasurement(owner *RouterNodeChainSOCKS, server *CommandServer, position int32, inventory string, catalog RouterNodeChainCandidateCatalog) (*RouterNodeChainSOCKSCandidateMeasurement, error) {
	ctx, cancel := context.WithTimeout(context.Background(), hopmeasure.ObservationTimeout)
	defer cancel()
	return owner.newConnectedCandidateMeasurementContext(ctx, server, int(position), inventory, catalog)
}
func (m *RouterNodeChainSOCKS) newConnectedCandidateMeasurementContext(ctx context.Context, server *CommandServer, position int, inventory string, catalog RouterNodeChainCandidateCatalog) (*RouterNodeChainSOCKSCandidateMeasurement, error) {
	if m == nil || m.self != m || ctx == nil || server == nil || catalog == nil {
		return nil, errors.New("typed candidate requires its original native owner and live catalog")
	}
	prepareDeadline := time.Now().Add(hopmeasure.ObservationTimeout)
	if deadline, bounded := ctx.Deadline(); bounded && deadline.Before(prepareDeadline) {
		prepareDeadline = deadline
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.mu); err != nil {
		return nil, err
	}
	native, state := m.native.Load(), m.state.Load()
	if native == nil || native.server != server || state == nil || state.runtime == nil || m.candidate.Load() != nil || m.healthyContext(ctx) != nil {
		m.mu.Unlock()
		return nil, errors.New("typed candidate lost its original server or proved complete runtime")
	}
	plan, err := mobilemultihop.NewNodeChainSOCKSConnectedCandidatePlan(state.runtime, position, inventory)
	if err != nil {
		m.mu.Unlock()
		return nil, err
	}
	digest := sha256.Sum256([]byte(inventory))
	candidate := &RouterNodeChainSOCKSCandidateMeasurement{owner: m, state: state, runtime: state.runtime, engine: state.engine.Load(), plan: plan, catalog: catalog, inventorySHA: hex.EncodeToString(digest[:]), prepareDeadline: prepareDeadline}
	candidate.self = candidate
	m.candidate.Store(candidate)
	m.mu.Unlock()
	// No fallible work follows publication: the caller receives the exact
	// reservation before any foreign catalog or measurement construction.
	return candidate, nil
}

// Prepare is one-shot. The host must retain this handle before calling it;
// failed construction is retired only through this exact handle's Close.
func (m *RouterNodeChainSOCKSCandidateMeasurement) Prepare() error {
	return m.prepareContext(context.Background())
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) prepareContext(ctx context.Context) error {
	if m == nil || ctx == nil || m.prepareDeadline.IsZero() {
		return errors.New("typed candidate lost its original construction deadline")
	}
	ctx, cancel := context.WithDeadline(ctx, m.prepareDeadline)
	defer cancel()
	if err := m.current(ctx); err != nil {
		return err
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.preparation); err != nil {
		return err
	}
	if m.prepareStarted || m.retired.Load() || m.owner.candidate.Load() != m {
		m.preparation.Unlock()
		return errors.New("typed candidate preparation requires its original unused reservation")
	}
	m.prepareStarted = true
	m.prepareDone = make(chan struct{})
	done := m.prepareDone
	m.preparation.Unlock()
	defer close(done)
	service, err := m.plan.NewMeasurementContext(ctx, m)
	if err == nil {
		m.service.Store(service)
		err = m.current(ctx)
	}
	return err
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) current(ctx context.Context) error {
	if ctx == nil || m == nil || m.self != m || m.owner == nil || m.owner.self != m.owner || m.state == nil || m.runtime == nil || m.engine == nil || m.retired.Load() || m.owner.candidate.Load() != m || m.owner.state.Load() != m.state || m.state.runtime != m.runtime || m.state.engine.Load() != m.engine {
		return errors.New("typed candidate lost its exact original runtime or native engine")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	return m.owner.nativeCurrent(ctx, m.state)
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) MeasurementSOCKSContext(ctx context.Context) (*mobilemultihop.NodeChainSOCKSRuntime, error) {
	if err := m.current(ctx); err != nil {
		return nil, err
	}
	original, err := m.owner.MeasurementSOCKSContext(ctx)
	if err != nil || original != m.runtime {
		return nil, errors.Join(err, errors.New("typed candidate replaced its original runtime"))
	}
	return original, m.current(ctx)
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) BeginMeasurementContext(ctx context.Context) (func(), error) {
	if err := m.current(ctx); err != nil {
		return nil, err
	}
	release, err := m.owner.BeginMeasurementContext(ctx)
	if err != nil {
		return release, err
	}
	if err := m.current(ctx); err != nil {
		release()
		return nil, err
	}
	return func() {
		// The activity release belongs to the worker: a canceled foreign
		// observation still owns this hold until its actual callback returns.
		_ = m.joinCatalog(context.Background())
		release()
	}, nil
}

func (m *RouterNodeChainSOCKSCandidateMeasurement) CandidateInventoryCurrentContext(parent context.Context, capture string) error {
	if parent == nil {
		return errors.New("candidate catalog observation has no original caller")
	}
	ctx, cancel := context.WithTimeout(parent, hopmeasure.ObservationTimeout)
	defer cancel()
	if err := m.current(ctx); err != nil {
		return err
	}
	if m.plan == nil || capture != m.plan.CaptureSHA256() || m.catalog == nil {
		return errors.New("candidate catalog differs from its original capture")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.observation); err != nil {
		return err
	}
	defer m.observation.Unlock()
	if m.pending != nil {
		select {
		case <-m.pending.done:
			m.pending = nil
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	if err := m.current(ctx); err != nil {
		return err
	}
	call := &routerNodeChainCatalogCall{done: make(chan struct{})}
	m.pending = call
	m.callbackActive.Store(true)
	go func() {
		defer func() { m.callbackActive.Store(false); close(call.done) }()
		call.digest = m.catalog.CurrentInventorySHA256()
	}()
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-call.done:
		m.pending = nil
		if err := m.current(ctx); err != nil {
			return err
		}
		if call.digest != m.inventorySHA {
			m.retired.Store(true)
			return errors.New("original candidate catalog revision or source changed")
		}
		return ctx.Err()
	}
}

func (m *RouterNodeChainSOCKSCandidateMeasurement) Metadata() string {
	if m == nil || m.self != m || m.plan == nil {
		return ""
	}
	return m.plan.Metadata()
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) CaptureSHA256() string {
	if m == nil || m.self != m || m.plan == nil {
		return ""
	}
	return m.plan.CaptureSHA256()
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) Start(request, candidateID string) error {
	if m == nil || m.self != m || m.service.Load() == nil {
		return errors.New("candidate measurement is unavailable")
	}
	return m.service.Load().Start(request, candidateID)
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) Cancel(request string) {
	if m != nil && m.self == m {
		if service := m.service.Load(); service != nil {
			service.Cancel(request)
		}
	}
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) Drain(request string) error {
	if m == nil || m.self != m || m.service.Load() == nil {
		return errors.New("candidate measurement is unavailable")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := m.service.Load().Drain(request); err != nil {
		return err
	}
	return m.joinCatalog(ctx)
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) StatusJSON() string {
	if m == nil || m.self != m || m.service.Load() == nil {
		return ""
	}
	raw := m.service.Load().StatusJSON()
	if !m.callbackActive.Load() {
		return raw
	}
	var status hopmeasure.CandidateStatus
	if json.Unmarshal([]byte(raw), &status) != nil {
		return ""
	}
	status.Complete, status.Drained, status.Stage, status.Results = false, false, "draining", []hopmeasure.Result{}
	encoded, _ := json.Marshal(status)
	return string(encoded)
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) NetworkChanged() {
	if m != nil && m.self == m {
		m.retired.Store(true)
		if service := m.service.Load(); service != nil {
			service.Invalidate()
		}
	}
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) Close() error {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	return m.closeContext(ctx)
}
func (m *RouterNodeChainSOCKSCandidateMeasurement) closeContext(ctx context.Context) error {
	if m == nil {
		return nil
	}
	if ctx == nil || m.self != m || m.owner == nil || m.owner.self != m.owner {
		return errors.New("typed candidate close requires its original owner and caller")
	}
	if retained := m.owner.candidate.Load(); retained != nil && retained != m {
		return errors.New("typed candidate close lost its original owner slot")
	}
	if err := adapter.RouterVPNLockContext(ctx, &m.preparation); err != nil {
		return err
	}
	m.retired.Store(true)
	started, done := m.prepareStarted, m.prepareDone
	m.preparation.Unlock()
	if started {
		select {
		case <-done:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	if service := m.service.Load(); service != nil {
		if err := service.CloseContext(ctx); err != nil {
			return err
		}
	}
	if err := m.joinCatalog(ctx); err != nil {
		return err
	}
	if m.owner != nil {
		m.owner.candidate.CompareAndSwap(m, nil)
	}
	return nil
}

func (m *RouterNodeChainSOCKSCandidateMeasurement) joinCatalog(ctx context.Context) error {
	if err := adapter.RouterVPNLockContext(ctx, &m.observation); err != nil {
		return err
	}
	defer m.observation.Unlock()
	if m.pending != nil {
		select {
		case <-m.pending.done:
			m.pending = nil
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return ctx.Err()
}

