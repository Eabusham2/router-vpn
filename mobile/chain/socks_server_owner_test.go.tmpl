package routervpnnodesocks

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/log"
	"github.com/sagernet/sing-box/route"
	"io"
	"net"
	"sync/atomic"
	"testing"
	"time"
)

type serverTrackedControl struct {
	net.Conn
	closes atomic.Int32
}

func (c *serverTrackedControl) Close() error  { c.closes.Add(1); return c.Conn.Close() }
func (c *serverTrackedControl) Upstream() any { return c.Conn }
func TestOriginalSOCKSServerTrackedControlKeepsHalfCloseAndOriginalOwner(t *testing.T) {
	listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
	if err != nil {
		t.Fatal(err)
	}
	defer listener.Close()
	client, err := net.DialTCP("tcp4", nil, listener.Addr().(*net.TCPAddr))
	if err != nil {
		t.Fatal(err)
	}
	defer client.Close()
	peer, err := listener.AcceptTCP()
	if err != nil {
		t.Fatal(err)
	}
	defer peer.Close()
	_ = peer.SetReadDeadline(time.Now().Add(2 * time.Second))
	raw := &serverTrackedControl{Conn: client}
	manager := route.NewConnectionManager(log.NewNOPFactory().Logger())
	tracked := manager.TrackConn(raw)
	captured, err := captureServerControl(tracked)
	if err != nil {
		t.Fatal(err)
	}
	original := newOriginalConn(nil, captured)
	original.enableControlClose()
	read := make(chan error, 1)
	readReady := make(chan struct{})
	t.Cleanup(func() {
		select {
		case <-readReady:
		default:
			close(readReady)
		}
	})
	go func() { <-readReady; var b [1]byte; _, err := original.Read(b[:]); read <- err }()
	closed := make(chan error, 1)
	go func() { closed <- original.Close() }()
	var b [1]byte
	if _, err := peer.Read(b[:]); !errors.Is(err, io.EOF) {
		t.Fatal("original tracked TCP half-close did not reach peer", err)
	}
	if raw.closes.Load() != 0 || manager.Count() != 1 {
		t.Fatal("tracking owner closed before remote EOF")
	}
	select {
	case err := <-closed:
		t.Fatal("tracked control abandoned remote EOF", err)
	default:
	}
	close(readReady)
	if err := peer.CloseWrite(); err != nil {
		t.Fatal(err)
	}
	select {
	case err := <-read:
		if !errors.Is(err, io.EOF) {
			t.Fatal(err)
		}
	case <-time.After(2 * time.Second):
		t.Fatal("original EOF observer did not join")
	}
	select {
	case err := <-closed:
		if err != nil {
			t.Fatal(err)
		}
	case <-time.After(2 * time.Second):
		t.Fatal("tracked original control did not retire")
	}
	if raw.closes.Load() != 1 || manager.Count() != 0 {
		t.Fatal("original full-close owner bypassed")
	}
	if err := original.Close(); err != nil || raw.closes.Load() != 1 {
		t.Fatal("retirement retry changed original owner", err)
	}
}
func TestOriginalSOCKSServerMissingHalfCloseRetainsFailedHandle(t *testing.T) {
	client, peer := net.Pipe()
	defer client.Close()
	defer peer.Close()
	raw := &serverTrackedControl{Conn: client}
	manager := route.NewConnectionManager(log.NewNOPFactory().Logger())
	tracked := manager.TrackConn(raw)
	original, err := captureServerControl(tracked)
	if err == nil || original != tracked || raw.closes.Load() != 0 || manager.Count() != 1 {
		t.Fatal("unproved control lost its retained failure handle")
	}
	if err := original.Close(); err != nil || raw.closes.Load() != 1 || manager.Count() != 0 {
		t.Fatal("failed original handle could not close", err)
	}
}

type serverControlCycle struct{ net.Conn }

func (c *serverControlCycle) Upstream() any { return c }
func TestOriginalSOCKSServerHalfCloseTraversalIsBounded(t *testing.T) {
	client, peer := net.Pipe()
	defer client.Close()
	defer peer.Close()
	cyclic := &serverControlCycle{Conn: client}
	if original, err := captureServerControl(cyclic); err == nil || original != cyclic {
		t.Fatal("cyclic wrapper gained unproved half-close")
	}
	var deep net.Conn = &serverHalfCloseFailure{Conn: client}
	for range 17 {
		deep = &serverTrackedControl{Conn: deep}
	}
	if original, err := captureServerControl(deep); err == nil || original != deep {
		t.Fatal("unbounded wrapper chain gained control authority")
	}
}

type serverHalfCloseFailure struct {
	net.Conn
	failure error
}

func (c *serverHalfCloseFailure) CloseWrite() error { return c.failure }
func TestOriginalSOCKSServerTrackedHalfCloseFailureRetainsReceipt(t *testing.T) {
	client, peer := net.Pipe()
	defer peer.Close()
	failure := errors.New("original tracked half-close failed")
	raw := &serverTrackedControl{Conn: &serverHalfCloseFailure{Conn: client, failure: failure}}
	manager := route.NewConnectionManager(log.NewNOPFactory().Logger())
	captured, err := captureServerControl(manager.TrackConn(raw))
	if err != nil {
		t.Fatal(err)
	}
	original := newOriginalConn(nil, captured)
	original.enableControlClose()
	err = original.Close()
	if !errors.Is(err, failure) || !errors.Is(err, errControlCloseUnproved) || raw.closes.Load() != 1 || manager.Count() != 0 {
		t.Fatal("failed tracked half-close lost original retirement receipt", err)
	}
	if again := original.Close(); again != err || raw.closes.Load() != 1 {
		t.Fatal("retry replaced original failure receipt")
	}
}

type serverFullCloseResult struct {
	net.Conn
	failure error
	closes  atomic.Int32
}

func (c *serverFullCloseResult) Close() error {
	c.closes.Add(1)
	return errors.Join(c.failure, c.Conn.Close())
}
func TestOriginalSOCKSServerCompletedClosePrecedesCancelledCaller(t *testing.T) {
	for _, failed := range []bool{false, true} {
		t.Run(map[bool]string{false: "success", true: "failure"}[failed], func(t *testing.T) {
			client, peer := net.Pipe()
			defer peer.Close()
			raw := &serverFullCloseResult{Conn: client}
			if failed {
				raw.failure = errors.New("retained original full-close failure")
			}
			owner := &Outbound{operations: make(map[*operation]struct{})}
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			constructed := make(chan struct{})
			close(constructed)
			op := &operation{owner: owner, ctx: ctx, cancel: cancel, network: "tcp", tcp: newOriginalConn(owner, raw), constructed: constructed, drained: make(chan struct{})}
			owner.operations[op] = struct{}{}
			capture := &Capture{server: &serverCapture{}, original: owner}
			capture.self = capture
			receipt := capture.CloseContext(context.Background())
			if failed && !errors.Is(receipt, raw.failure) || !failed && receipt != nil || raw.closes.Load() != 1 {
				t.Fatal("original close did not complete", receipt)
			}
			cancelled, stop := context.WithCancel(context.Background())
			stop()
			for range 256 {
				if actual := capture.CloseContext(cancelled); actual != receipt {
					t.Fatal("cancel replaced completed original result", actual)
				}
			}
			if raw.closes.Load() != 1 {
				t.Fatal("cancelled retry replaced original retirement")
			}
		})
	}
}
func TestOriginalSOCKSServerTypedNilControlRefusesWithoutMethodCall(t *testing.T) {
	var half *serverHalfCloseFailure
	var upstream *serverTrackedControl
	for _, original := range []net.Conn{half, upstream, &serverTrackedControl{Conn: half}, &serverTrackedControl{Conn: upstream}} {
		retained, err := captureServerControl(original)
		if err == nil || retained != original {
			t.Fatal("typed nil wrapper gained half-close authority or lost original handle")
		}
	}
}
