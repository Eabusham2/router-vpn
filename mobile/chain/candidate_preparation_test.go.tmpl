// Real source compiler, daemon instance lookup, callback lifetime and close
// methods run. Native Box/proof transport executes in the separate pinned Box
// suite; these component fixtures do not claim an Android VPN or packet path.
func candidatePreparationBridgeSource(t *testing.T) *RouterNodeChainCandidatePreparation {
	t.Helper()
	chain := candidateBridgeSource(t)
	source, err := chain.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var originalSource mobilemultihop.NodeChainSource
	if err := json.Unmarshal([]byte(source), &originalSource); err != nil {
		t.Fatal(err)
	}
	source = candidateBridgeJSON(t, originalSource)
	other := candidateBridgeSourceModes(t, []string{"wg", "wg", "wg"})
	input, err := other.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var record mobilemultihop.NodeChainSource
	if err := json.Unmarshal([]byte(input), &record); err != nil {
		t.Fatal(err)
	}
	inventory := candidateBridgeJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-catalog", Inputs: []string{record.Nodes[len(record.Nodes)-1]}})
	m, err := NewRouterNodeChainCandidatePreparation(source, 1, inventory)
	if err != nil {
		t.Fatal(err)
	}
	if m.OriginalSourceSHA256() != chain.SourceSHA256() {
		t.Fatal("fixture changed original saved source")
	}
	return m
}
func candidatePreparationReservedService(t *testing.T, m *RouterNodeChainCandidatePreparation, platform adapter.PlatformInterface) *CommandServer {
	t.Helper()
	if platform == nil {
		platform = &executionBridgePlatform{}
	}
	ctx := box.Context(service.ContextWith[adapter.PlatformInterface](context.Background(), platform), include.InboundRegistry(), include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
	started := daemon.NewStartedService(daemon.ServiceOptions{Context: ctx, LogMaxLines: 16})
	server := &CommandServer{StartedService: started, ctx: ctx}
	if err := m.BindNative(server); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = m.Close(); _ = started.CloseService(); started.Close() })
	return server
}
func candidatePreparationBridgeFixture(t *testing.T) (*RouterNodeChainCandidatePreparation, *routerCandidatePreparationState, *candidateBridgeCatalog) {
	t.Helper()
	m := candidatePreparationBridgeSource(t)
	server := candidatePreparationReservedService(t, m, nil)
	if err := server.StartedService.StartOrReloadService(server.ctx, executionBridgeEmptyNativeConfig, nil); err != nil {
		t.Fatal(err)
	}
	instance, err := m.native.Load().capture.InstanceContext(t.Context())
	if err != nil {
		t.Fatal(err)
	}
	lifetime, cancel := context.WithCancel(server.ctx)
	t.Cleanup(cancel)
	catalog := &candidateBridgeCatalog{digest: m.inventorySHA}
	state := &routerCandidatePreparationState{server: server, nativeService: server.StartedService, instance: instance, catalog: catalog, lifetime: lifetime, cancel: cancel, done: make(chan struct{})}
	close(state.done)
	m.state.Store(state)
	// Identity-fault cases restore only fixture pointers before owned cleanup;
	// the assertion is made while the original native pointer is still changed.
	t.Cleanup(func() {
		m.state.Store(state)
		server.StartedService = state.nativeService
		*routerMTUField[*daemon.Instance](t, state.nativeService, "instance") = instance
	})
	return m, state, catalog
}
func TestRouterNodeChainBridgeCandidatePreparationSourceAndIdentity(t *testing.T) {
	for _, fault := range []string{"source-only", "instance", "generation", "lifetime", "retired"} {
		t.Run(fault, func(t *testing.T) {
			m, state, _ := candidatePreparationBridgeFixture(t)
			if err := m.nativeCurrent(t.Context(), state); err != nil {
				t.Fatal(err)
			}
			if m.Healthy() || m.Start(strings.Repeat("a", 32), "chain-native-3") == nil {
				t.Fatal("source/native identity fabricated proved prefix candidates")
			}
			if strings.Contains(m.Config(), "routervpn-chain-2-") || m.SourceSHA256() == m.OriginalSourceSHA256() {
				t.Fatal("bridge reused complete saved suffix instead of separate preparation")
			}
			reconstructed, err := mobilemultihop.ParseNodeChainCandidatePreparation(m.LaunchInput())
			if err != nil || reconstructed.Config() != m.Config() || reconstructed.SourceSHA256() != m.SourceSHA256() {
				t.Fatal("private prefix session lost its exact reconstruction", err)
			}
			switch fault {
			case "source-only":
				return
			case "instance":
				*routerMTUField[*daemon.Instance](t, state.server.StartedService, "instance") = &daemon.Instance{}
			case "generation":
				m.state.Store(&routerCandidatePreparationState{lifetime: context.Background()})
			case "lifetime":
				state.cancel()
			case "retired":
				m.NetworkChanged()
			}
			if m.nativeCurrent(t.Context(), state) == nil {
				t.Fatal("prefix bridge accepted changed native owner", fault)
			}
		})
	}
}
func TestRouterNodeChainBridgeCandidatePreparationCatalogCloseRetainsCallback(t *testing.T) {
	m, _, catalog := candidatePreparationBridgeFixture(t)
	catalog.entered, catalog.release = make(chan struct{}), make(chan struct{})
	var releaseOnce sync.Once
	release := func() { releaseOnce.Do(func() { close(catalog.release) }) }
	defer release()
	done := make(chan error, 1)
	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
	defer cancel()
	go func() { done <- m.CandidateInventoryCurrentContext(ctx, m.CaptureSHA256()) }()
	<-catalog.entered
	if err := <-done; !errors.Is(err, context.DeadlineExceeded) {
		t.Fatal("held native host callback did not preserve caller deadline", err)
	}
	closeCtx, end := context.WithTimeout(context.Background(), 30*time.Millisecond)
	defer end()
	if err := m.closeContext(closeCtx); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatal("unjoined catalog callback allowed native retirement", err)
	}
	if !m.callbackActive.Load() || m.pending == nil {
		t.Fatal("timed-out original catalog callback lost retry handle")
	}
	release()
	joined, stop := context.WithTimeout(context.Background(), time.Second)
	defer stop()
	if err := m.closeContext(joined); err != nil {
		t.Fatal("original catalog cleanup retry failed", err)
	}
	if m.callbackActive.Load() || m.pending != nil || m.Healthy() {
		t.Fatal("joined callback revived prefix purpose")
	}
}
func TestRouterNodeChainBridgeCandidatePreparationStartupJoinIsMandatory(t *testing.T) {
	m, state, _ := candidatePreparationBridgeFixture(t)
	state.done = make(chan struct{})
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
	defer cancel()
	if err := m.closeContext(ctx); !errors.Is(err, context.DeadlineExceeded) {
		close(state.done)
		t.Fatal("pending original startup allowed native retirement", err)
	}
	if !m.retired.Load() || state.lifetime.Err() == nil {
		close(state.done)
		t.Fatal("cleanup did not cancel pending prefix lifetime")
	}
	close(state.done)
	if err := m.closeContext(context.Background()); err != nil {
		t.Fatal(err)
	}
}
func TestRouterNodeChainBridgeCandidatePreparationCatalogChangeIsSticky(t *testing.T) {
	m, state, catalog := candidatePreparationBridgeFixture(t)
	if err := m.CandidateInventoryCurrentContext(t.Context(), m.CaptureSHA256()); err != nil {
		t.Fatal(err)
	}
	catalog.change("changed")
	if err := m.CandidateInventoryCurrentContext(t.Context(), m.CaptureSHA256()); err == nil {
		t.Fatal("changed catalog retained candidate preparation")
	}
	catalog.change(m.inventorySHA)
	if err := m.CandidateInventoryCurrentContext(t.Context(), m.CaptureSHA256()); err == nil || !m.retired.Load() || state.lifetime.Err() == nil {
		t.Fatal("restored catalog revived retired prefix purpose")
	}
}
func TestRouterNodeChainBridgeCandidatePreparationNativeLookupKeepsDeadline(t *testing.T) {
	m, state, _ := candidatePreparationBridgeFixture(t)
	lock := routerMTUField[sync.RWMutex](t, state.server.StartedService, "serviceAccess")
	lock.Lock()
	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
	err := m.nativeCurrent(ctx, state)
	cancel()
	lock.Unlock()
	if !errors.Is(err, context.DeadlineExceeded) {
		t.Fatal("prefix owner lookup lost actual native deadline", err)
	}
	if err := m.nativeCurrent(t.Context(), state); err != nil {
		t.Fatal("expired observer retired native owner", err)
	}
}

func TestRouterNodeChainBridgeCandidatePreparationRunChecksOriginalCatalog(t *testing.T) {
	m, original, catalog := candidatePreparationBridgeFixture(t)
	m.state.Store(nil)
	catalog.change("changed-before-native-prefix-acquisition")
	if err := m.Run(original.server, catalog); err == nil {
		t.Fatal("changed startup source acquired native prefix")
	}
	state := m.state.Load()
	if catalog.calls.Load() != 1 || state == nil || state.engine.Load() != nil || !m.retired.Load() {
		t.Fatal("startup bypassed original catalog before prefix native acquisition")
	}
	if err := m.closeContext(context.Background()); err != nil {
		t.Fatal("changed startup failed exact cleanup", err)
	}
}

func TestRouterNodeChainBridgeCandidatePreparationLaunchIsExact(t *testing.T) {
	m, _, _ := candidatePreparationBridgeFixture(t)
	input := m.LaunchInput()
	reopened, err := RouterNodeChainCandidatePreparationLaunch(input)
	if err != nil || reopened.Config() != m.Config() || reopened.SourceSHA256() != m.SourceSHA256() || reopened.ConfigSHA256() != m.ConfigSHA256() || reopened.CaptureSHA256() != m.CaptureSHA256() || reopened.OriginalSourceSHA256() != m.OriginalSourceSHA256() || reopened.inventorySHA != m.inventorySHA || reopened.Metadata() != m.Metadata() || reopened.Healthy() {
		t.Fatal("strict prefix reopen changed captured source or invented live proof", err)
	}
	for _, fault := range []string{"noncanonical", "unknown", "kind", "source", "position", "inventory"} {
		t.Run(fault, func(t *testing.T) {
			var record map[string]any
			if err := json.Unmarshal([]byte(input), &record); err != nil {
				t.Fatal(err)
			}
			wrong := input
			switch fault {
			case "noncanonical":
				wrong = " " + input
			case "unknown":
				record["config"] = m.Config()
			case "kind":
				record["kind"] = "routervpn-node-chain-launch-input"
			case "source":
				record["original_source"] = "{}"
			case "position":
				record["prefix_position"] = 2
			case "inventory":
				record["inventory"] = "{}"
			}
			if fault != "noncanonical" {
				wrong = candidateBridgeJSON(t, record)
			}
			if value, err := RouterNodeChainCandidatePreparationLaunch(wrong); err == nil || value != nil {
				t.Fatal("strict prefix reopen admitted changed private capture", fault)
			}
		})
	}
}

// The actual daemon and Box construct/start/close. Only platform monitoring
// is controlled; an empty direct graph acquires no privileged TUN or packets.
type candidatePreparationClosePlatform struct {
	executionBridgePlatform
	initialize func() error
	close      func() error
}

func (p *candidatePreparationClosePlatform) Initialize(adapter.NetworkManager) error {
	if p.initialize != nil {
		return p.initialize()
	}
	return nil
}
func (p *candidatePreparationClosePlatform) CreateDefaultInterfaceMonitor(logger.Logger) tun.DefaultInterfaceMonitor {
	return &candidatePreparationCloseMonitor{close: p.close}
}

type candidatePreparationCloseMonitor struct {
	executionBridgeMonitor
	close func() error
}

func (m *candidatePreparationCloseMonitor) Close() error {
	if m.close != nil {
		return m.close()
	}
	return nil
}

func TestRouterNodeChainBridgeCandidatePreparationNativeCloseReceipt(t *testing.T) {
	for _, fault := range []string{"never-constructed", "constructed", "held-close", "failed-close", "foreign-service"} {
		t.Run(fault, func(t *testing.T) {
			m := candidatePreparationBridgeSource(t)
			entered, release := make(chan struct{}), make(chan struct{})
			var releaseOnce sync.Once
			unblock := func() { releaseOnce.Do(func() { close(release) }) }
			defer unblock()
			sentinel := errors.New("original prefix native monitor close failed")
			platform := &candidatePreparationClosePlatform{}
			if fault == "held-close" {
				platform.close = func() error { close(entered); <-release; return nil }
			}
			if fault == "failed-close" {
				platform.close = func() error { return sentinel }
			}
			server := candidatePreparationReservedService(t, m, platform)
			if m.NativeClosed() || m.BindNative(server) == nil {
				t.Fatal("active or replaceable binding fabricated native retirement")
			}
			if fault != "never-constructed" {
				if err := server.StartedService.StartOrReloadService(server.ctx, executionBridgeEmptyNativeConfig, nil); err != nil {
					t.Fatal(err)
				}
			}
			if err := m.Close(); err != nil {
				t.Fatal(err)
			}
			if fault == "never-constructed" {
				if !m.NativeClosed() {
					t.Fatal("sealed never-acquired prefix capture lost its positive empty receipt")
				}
				if server.StartedService.StartOrReloadService(server.ctx, executionBridgeEmptyNativeConfig, nil) == nil {
					t.Fatal("sealed prefix reservation admitted a later construction")
				}
				return
			}
			if m.NativeClosed() {
				t.Fatal("prefix Close fabricated original Box retirement")
			}
			if fault == "held-close" {
				done := make(chan error, 1)
				go func() { done <- server.CloseService() }()
				<-entered
				if actual, _ := server.StartedService.RouterVPNInstanceContext(t.Context()); actual != nil {
					t.Fatal("fixture did not exercise removed daemon slot during actual Box close")
				}
				ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
				err := m.nativeClosedContext(ctx)
				cancel()
				if !errors.Is(err, context.DeadlineExceeded) {
					t.Fatal("early Box done or nil daemon slot fabricated joined native close", err)
				}
				unblock()
				if err := <-done; err != nil {
					t.Fatal(err)
				}
			} else {
				err := server.CloseService()
				if fault == "failed-close" {
					if !errors.Is(err, sentinel) || m.NativeClosed() {
						t.Fatal("failed original native close released prefix ownership", err)
					}
					if err := server.CloseService(); err != nil {
						t.Fatal("fixture empty-slot retry changed", err)
					}
					if m.NativeClosed() {
						t.Fatal("empty daemon retry erased failed original Box receipt")
					}
					return
				}
				if err != nil {
					t.Fatal(err)
				}
			}
			if !m.NativeClosed() {
				t.Fatal("successful exact prefix native close lost its receipt")
			}
			if fault == "foreign-service" {
				original := server.StartedService
				server.StartedService = &daemon.StartedService{}
				accepted := m.NativeClosed()
				server.StartedService = original
				if accepted {
					t.Fatal("foreign daemon borrowed the original prefix close receipt")
				}
			}
		})
	}
}

func TestRouterNodeChainBridgeCandidatePreparationLateConstructionJoin(t *testing.T) {
	m := candidatePreparationBridgeSource(t)
	entered, release := make(chan struct{}), make(chan struct{})
	var once sync.Once
	unblock := func() { once.Do(func() { close(release) }) }
	defer unblock()
	server := candidatePreparationReservedService(t, m, &candidatePreparationClosePlatform{initialize: func() error { close(entered); <-release; return nil }})
	done := make(chan error, 1)
	go func() {
		done <- server.StartedService.StartOrReloadService(server.ctx, executionBridgeEmptyNativeConfig, nil)
	}()
	<-entered
	ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
	err := m.closeContext(ctx)
	cancel()
	if !errors.Is(err, context.DeadlineExceeded) || m.closed.Load() {
		t.Fatal("late native construction escaped the prefix close join", err)
	}
	ctx, cancel = context.WithTimeout(t.Context(), 20*time.Millisecond)
	if m.nativeClosedContext(ctx) == nil {
		cancel()
		t.Fatal("pending construction became empty prefix receipt")
	}
	cancel()
	unblock()
	if err := <-done; err != nil {
		t.Fatal(err)
	}
	if err := m.Close(); err != nil || m.NativeClosed() {
		t.Fatal("late acquired Box lost original prefix cleanup", err)
	}
	if err := server.CloseService(); err != nil || !m.NativeClosed() {
		t.Fatal("late constructed original Box did not complete exact close", err)
	}
}

func TestRouterNodeChainBridgeCandidatePreparationCancelledBinding(t *testing.T) {
	for _, closed := range []bool{false, true} {
		t.Run(map[bool]string{false: "cancelled", true: "already-closed"}[closed], func(t *testing.T) {
			m := candidatePreparationBridgeSource(t)
			m.NetworkChanged()
			if closed {
				if err := m.Close(); err != nil {
					t.Fatal(err)
				}
			}
			if m.NativeClosed() {
				t.Fatal("unbound prefix owner fabricated native DOWN")
			}
			started := daemon.NewStartedService(daemon.ServiceOptions{Context: context.Background(), LogMaxLines: 16})
			t.Cleanup(started.Close)
			server := &CommandServer{StartedService: started, ctx: context.Background()}
			if m.BindNative(server) == nil || m.native.Load() == nil {
				t.Fatal("cancelled prefix binding reopened admission or lost cleanup")
			}
			if err := m.Close(); err != nil || !m.NativeClosed() {
				t.Fatal("cancelled prefix binding lost sealed empty cleanup", err)
			}
			if started.StartOrReloadService(server.ctx, executionBridgeEmptyNativeConfig, nil) == nil {
				t.Fatal("cancelled prefix binding admitted native construction")
			}
			foreign := &CommandServer{StartedService: daemon.NewStartedService(daemon.ServiceOptions{Context: context.Background(), LogMaxLines: 16}), ctx: context.Background()}
			t.Cleanup(foreign.StartedService.Close)
			if m.BindNative(foreign) == nil || m.native.Load().server != server {
				t.Fatal("prefix cleanup retargeted a foreign service")
			}
		})
	}
}

func TestRouterNodeChainBridgeCandidatePreparationBindingIsRequired(t *testing.T) {
	bound := candidatePreparationBridgeSource(t)
	server := candidatePreparationReservedService(t, bound, nil)
	if err := server.StartedService.StartOrReloadService(server.ctx, executionBridgeEmptyNativeConfig, nil); err != nil {
		t.Fatal(err)
	}
	unbound := candidatePreparationBridgeSource(t)
	catalog := &candidateBridgeCatalog{digest: unbound.inventorySHA}
	if unbound.Run(server, catalog) == nil || unbound.state.Load() != nil || catalog.calls.Load() != 0 {
		t.Fatal("unreserved prefix Run adopted another native construction")
	}
	if unbound.NativeClosed() {
		t.Fatal("unreserved prefix capture borrowed another native close")
	}
}
