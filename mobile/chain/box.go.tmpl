// Capture the actual parsed graph at Box construction. Comparing a caller's
// metadata with itself cannot authorize prefix dials or an ambient DNS query.
func routerVPNNodeChainOptionsDigest(ctx context.Context, options option.Options) string {
	if options.Route == nil || options.Route.Final != mobilemultihop.SelectorTag ||
		len(options.Inbounds) != 1 || options.Inbounds[0].Type != C.TypeTun ||
		options.Inbounds[0].Tag != "routervpn-chain-tun" {
		return ""
	}
	services := make([]option.Service, 0, len(options.Services))
	for _, service := range options.Services {
		if service.Type != C.TypeOOMKiller {
			services = append(services, service)
		}
	}
	options.Log, options.Services = nil, services
	encoded, err := json.MarshalContext(ctx, options)
	if err != nil {
		return ""
	}
	sum := sha256.Sum256(encoded)
	clear(encoded)
	return hex.EncodeToString(sum[:])
}

// RouterVPNNodeChainEngine observes the one existing native connection owner.
// It owns no process, listener, TUN, or protection teardown. The original host
// cancels and joins chain proofs before retiring that same native connection.
type routerVPNNodeChainObservation struct {
	instance *Box
	dns      mobilemultihop.NodeChainDNSCapture
	finalTag string
	identity mobilemultihop.NodeChainIdentity
	current  func(context.Context) error
	inbound  adapter.Inbound
	resolver adapter.DNSTransport
	selector *group.Selector
	prefixes map[string]adapter.Outbound
}

// A private observation core is shared by separately typed source adapters.
// It retains no generic NodeChain and grants no source/parser authority.
type RouterVPNNodeChainEngine struct {
	openVPN     mobilemultihop.NodeChainOpenVPNCapture
	observation *routerVPNNodeChainObservation
	public      *routerVPNNodeChainPublicRoutes
}

// The ordinary Local adapter keeps the entire ordered public inventory. A
// public request never borrows whichever imported prefix happens to be last.
// Re-reading its original source also rejects replaced same-byte owners.
type routerVPNNodeChainPublicRoutes struct {
	self           *routerVPNNodeChainPublicRoutes
	observation    *routerVPNNodeChainObservation
	source         *mobilemultihop.NodeChain
	originalSource *mobilemultihop.NodeChain
	captured       []mobilemultihop.NodeChainPublicMeasurementCapture
	ipv6           bool
}

func (r *routerVPNNodeChainPublicRoutes) permit(owner *routerVPNNodeChainObservation, tag string) (bool, error) {
	bad := errors.New("ordered imported measurement requires its captured position, source and DNS")
	if r == nil || r.self != r || r.observation != owner || owner == nil || r.source == nil || r.source != r.originalSource ||
		r.source.SourceSHA256() != owner.identity.SourceSHA256 || r.source.ConfigSHA256() != owner.identity.ConfigSHA256 {
		return false, bad
	}
	actual, ipv6, err := r.source.PublicMeasurementCaptures()
	if err != nil || ipv6 != r.ipv6 || len(actual) != len(r.captured) {
		return false, errors.Join(err, bad)
	}
	found := false
	for position, capture := range actual {
		if capture != r.captured[position] || owner.prefixes[capture.Tag] == nil {
			return false, bad
		}
		found = found || capture.Tag == tag
	}
	if !found || owner.instance == nil || owner.instance.dnsRouter == nil || owner.resolver == nil {
		return false, bad
	}
	return ipv6, nil
}

var _ mobilemultihop.NodeChainEngine = (*RouterVPNNodeChainEngine)(nil)

func routerVPNNodeChainSession(value string) bool {
	if len(value) < 16 || len(value) > 128 || !utf8.ValidString(value) {
		return false
	}
	for _, ch := range value {
		if ch != '-' && ch != '_' && !(ch >= '0' && ch <= '9') &&
			!(ch >= 'a' && ch <= 'z') && !(ch >= 'A' && ch <= 'Z') {
			return false
		}
	}
	return true
}

// The current callback checks only the original outer native owner. It must
// retain the caller's context and must not call back into this proof engine.
func (s *Box) RouterVPNNewNodeChainEngine(ctx context.Context, chain *mobilemultihop.NodeChain,
	session string, current func(context.Context) error) (*RouterVPNNodeChainEngine, error) {
	if ctx == nil || s == nil || chain == nil || current == nil || !routerVPNNodeChainSession(session) {
		return nil, errors.New("ordered native chain needs its captured connection owner")
	}
	if _, err := chain.LaunchInput(); err != nil {
		return nil, err
	}
	public, ipv6, err := chain.PublicMeasurementCaptures()
	if err != nil {
		return nil, err
	}
	original, err := s.routerVPNNewNodeChainObservation(ctx, chain.Config(), chain.DNSCapture(),
		chain.PrefixTags(), chain.FinalTag(), chain.SourceSHA256(), chain.ConfigSHA256(), session, current)
	if err != nil {
		return nil, err
	}
	capture, err := chain.OpenVPNMiddleCapture()
	if err != nil {
		return nil, err
	}
	routes := &routerVPNNodeChainPublicRoutes{observation: original, source: chain, originalSource: chain,
		captured: append([]mobilemultihop.NodeChainPublicMeasurementCapture(nil), public...), ipv6: ipv6}
	routes.self = routes
	return &RouterVPNNodeChainEngine{observation: original, public: routes, openVPN: capture}, nil
}

func (s *Box) routerVPNNewNodeChainObservation(ctx context.Context, config string,
	dns mobilemultihop.NodeChainDNSCapture, tags []string, finalTag, sourceSHA256, configSHA256, session string,
	current func(context.Context) error) (*routerVPNNodeChainObservation, error) {
	if ctx == nil || s == nil || config == "" || finalTag == "" || current == nil || !routerVPNNodeChainSession(session) {
		return nil, errors.New("ordered native chain needs its captured connection owner")
	}
	if err := current(ctx); err != nil {
		return nil, err
	}
	if s.ctx == nil || s.ctx.Err() != nil || s.routerVPNNodeChainOptions == "" {
		return nil, errors.New("ordered native chain has no actual compiled graph")
	}
	compiled, err := json.UnmarshalExtendedContext[option.Options](s.ctx, []byte(config))
	if err != nil || routerVPNNodeChainOptionsDigest(s.ctx, compiled) != s.routerVPNNodeChainOptions {
		return nil, errors.New("ordered chain source differs from the running native graph")
	}
	engine := &routerVPNNodeChainObservation{instance: s, dns: dns, finalTag: finalTag, current: current,
		prefixes: make(map[string]adapter.Outbound),
		identity: mobilemultihop.NodeChainIdentity{EngineID: fmt.Sprintf("%p", s), SessionID: session,
			SourceSHA256: sourceSHA256, ConfigSHA256: configSHA256}}
	inbounds, err := adapter.RouterVPNInboundsContext(ctx, s.inbound)
	if err != nil || len(inbounds) != 1 || inbounds[0].Tag() != dns.TUNTag || inbounds[0].Type() != C.TypeTun {
		return nil, errors.Join(err, errors.New("ordered chain lost its one captured native TUN"))
	}
	engine.inbound = inbounds[0]
	resolver, found, err := adapter.RouterVPNTransportContext(ctx, s.dnsTransport, dns.ResolverTag)
	if err != nil || !found || resolver == nil {
		return nil, errors.Join(err, errors.New("ordered chain selected resolver is unavailable"))
	}
	engine.resolver = resolver
	for _, tag := range tags {
		outbound, found, err := adapter.RouterVPNOutboundContext(ctx, s.outbound, tag)
		if err != nil || !found || outbound == nil || engine.prefixes[tag] != nil {
			return nil, errors.Join(err, errors.New("ordered chain prefix is not its captured native outbound"))
		}
		engine.prefixes[tag] = outbound
	}
	outbound, found, err := adapter.RouterVPNOutboundContext(ctx, s.outbound, mobilemultihop.SelectorTag)
	selector, ok := outbound.(*group.Selector)
	if err != nil || !found || !ok || selector == nil || len(selector.All()) != 1 ||
		selector.All()[0] != finalTag || selector.Now() != finalTag {
		return nil, errors.Join(err, errors.New("ordered chain native selector has another candidate"))
	}
	engine.selector = selector
	if s.network == nil {
		return nil, errors.New("ordered chain has no native network owner")
	}
	engine.identity.NetworkID, err = s.network.RouterVPNNodeChainNetworkContext(ctx)
	if err != nil {
		return nil, err
	}
	if _, err := engine.ObserveChainContext(ctx); err != nil {
		return nil, err
	}
	return engine, nil
}

func (e *routerVPNNodeChainObservation) ObserveChainContext(ctx context.Context) (mobilemultihop.NodeChainIdentity, error) {
	empty := mobilemultihop.NodeChainIdentity{}
	if ctx == nil {
		return empty, errors.New("ordered native observation has no caller")
	}
	if err := ctx.Err(); err != nil {
		return empty, err
	}
	if e == nil || e.instance == nil || e.finalTag == "" || e.current == nil {
		return empty, errors.New("ordered native observation has no retained owner")
	}
	if err := e.current(ctx); err != nil {
		return empty, err
	}
	s := e.instance
	if s.ctx == nil || s.ctx.Err() != nil || s.done == nil || s.network == nil {
		return empty, errors.New("ordered native connection retired")
	}
	select {
	case <-s.done:
		return empty, errors.New("ordered native connection is closing")
	default:
	}
	network, err := s.network.RouterVPNNodeChainNetworkContext(ctx)
	if err != nil || network != e.identity.NetworkID {
		return empty, errors.Join(err, errors.New("ordered chain network generation changed"))
	}
	dns := e.dns
	inbounds, err := adapter.RouterVPNInboundsContext(ctx, s.inbound)
	if err != nil || len(inbounds) != 1 || inbounds[0] != e.inbound ||
		e.inbound.Tag() != dns.TUNTag || e.inbound.Type() != C.TypeTun {
		return empty, errors.Join(err, errors.New("ordered native TUN owner changed"))
	}
	resolver, found, err := adapter.RouterVPNTransportContext(ctx, s.dnsTransport, dns.ResolverTag)
	if err != nil || !found || resolver != e.resolver {
		return empty, errors.Join(err, errors.New("ordered native DNS owner changed"))
	}
	for tag, expected := range e.prefixes {
		actual, found, err := adapter.RouterVPNOutboundContext(ctx, s.outbound, tag)
		if err != nil || !found || actual != expected {
			return empty, errors.Join(err, errors.New("ordered native prefix owner changed"))
		}
	}
	selector, found, err := adapter.RouterVPNOutboundContext(ctx, s.outbound, mobilemultihop.SelectorTag)
	if err != nil || !found || selector != e.selector || e.selector.Now() != e.finalTag {
		return empty, errors.Join(err, errors.New("ordered native selected path changed"))
	}
	if err := e.current(ctx); err != nil {
		return empty, err
	}
	network, err = s.network.RouterVPNNodeChainNetworkContext(ctx)
	if err != nil || network != e.identity.NetworkID {
		return empty, errors.Join(err, errors.New("ordered chain network changed during observation"))
	}
	select {
	case <-s.done:
		return empty, errors.New("ordered native connection retired during observation")
	default:
	}
	if err := ctx.Err(); err != nil {
		return empty, err
	}
	return e.identity, nil
}

func (e *routerVPNNodeChainObservation) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return nil, err
	}
	outbound := e.prefixes[tag]
	if outbound == nil {
		return nil, errors.New("ordered chain cannot dial an uncaptured prefix")
	}
	host, port, err := net.SplitHostPort(address)
	ip, ipErr := netip.ParseAddr(host)
	if err != nil || ipErr != nil || ip.Zone() != "" || ip.IsUnspecified() || port == "" || strings.Contains(port, "+") {
		return nil, errors.New("ordered chain proofs require their literal destination")
	}
	destination := M.ParseSocksaddr(address)
	if !destination.IsValid() || destination.Port == 0 {
		return nil, errors.New("ordered chain proof destination is invalid")
	}
	connection, err := outbound.DialContext(ctx, "tcp", destination)
	_, observed := e.ObserveChainContext(ctx)
	if err != nil || observed != nil || ctx.Err() != nil {
		if connection != nil {
			err = errors.Join(err, connection.Close())
		}
		return nil, errors.Join(err, observed, ctx.Err())
	}
	if connection == nil {
		return nil, errors.New("ordered native prefix returned no connection")
	}
	return connection, nil
}

func (e *routerVPNNodeChainObservation) SelectedContext(ctx context.Context) (string, error) {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return "", err
	}
	return e.finalTag, nil
}

func (e *routerVPNNodeChainObservation) SelectContext(ctx context.Context, tag string) error {
	// The sealed selector has exactly one candidate, already started by Box.
	// Selection cannot widen the graph or switch back to an old pair candidate.
	if e == nil || e.finalTag == "" || tag != e.finalTag {
		return errors.New("ordered native selection requires its captured final prefix")
	}
	_, err := e.ObserveChainContext(ctx)
	return err
}

func (e *routerVPNNodeChainObservation) DNSProofContext(ctx context.Context, capture mobilemultihop.NodeChainDNSCapture) error {
	if e == nil || e.finalTag == "" || capture != e.dns {
		return errors.New("ordered native DNS proof has another source or resolver")
	}
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return err
	}
	if err := e.instance.RouterVPNStrategyDNSProofContext(ctx); err != nil {
		return err
	}
	_, err := e.ObserveChainContext(ctx)
	return err
}

func (e *RouterVPNNodeChainEngine) ObserveChainContext(ctx context.Context) (mobilemultihop.NodeChainIdentity, error) {
	if e == nil || e.observation == nil {
		return mobilemultihop.NodeChainIdentity{}, errors.New("ordered native engine lost its original observation")
	}
	return e.observation.ObserveChainContext(ctx)
}

// Only the ordinary Local observation owns this packet capability. Selected
// execution and temporary-prefix adapters deliberately do not implement it.
// The sealed core request binds the complete original source and exact target;
// it cannot supply a different prefix, native object or physical fallback.
func (e *RouterVPNNodeChainEngine) DialCandidatePacketContext(ctx context.Context, request *mobilemultihop.NodeChainCandidatePacketRequest) (net.Conn, error) {
	if e == nil || e.observation == nil || e.public == nil || e.public.self != e.public ||
		e.public.observation != e.observation || e.public.source != e.public.originalSource || e.observation.instance == nil ||
		e.observation.instance.routerVPNNodeChainExecutionOptions != "" {
		return nil, errors.New("candidate packet response lost its original Local source")
	}
	identity, tag, address, err := request.Read(ctx, e, e.public.source)
	if err != nil || identity != e.observation.identity {
		return nil, errors.Join(err, errors.New("candidate packet response changed its native identity"))
	}
	outbound := e.observation.prefixes[tag]
	destination := M.ParseSocksaddr(address)
	if outbound == nil || !destination.IsValid() || !destination.IsIP() || destination.Port == 0 {
		return nil, errors.New("candidate packet response has no captured literal prefix destination")
	}
	connection, dialErr := outbound.DialContext(ctx, "udp", destination)
	observed, actualTag, actualAddress, observeErr := request.Read(ctx, e, e.public.source)
	if observed != identity || actualTag != tag || actualAddress != address {
		observeErr = errors.Join(observeErr, errors.New("candidate packet response changed during its original dial"))
	}
	if connection == nil {
		dialErr = errors.Join(dialErr, errors.New("candidate packet response returned no original socket"))
	}
	// The candidate carrier retains every late nonnil result, including errors,
	// and joins that exact socket's Close before releasing the measurement hold.
	return connection, errors.Join(dialErr, observeErr, ctx.Err())
}

func (e *RouterVPNNodeChainEngine) OpenCandidatePacketEndpointContext(ctx context.Context, request *mobilemultihop.NodeChainCandidatePacketRequest) (mobilemultihop.NodeChainCandidatePacketEndpoint, error) {
	if e == nil || e.observation == nil || e.public == nil || e.public.self != e.public ||
		e.public.observation != e.observation || e.public.source != e.public.originalSource || e.observation.instance == nil ||
		e.observation.instance.routerVPNNodeChainExecutionOptions != "" {
		return nil, errors.New("candidate endpoint lost its original Local source")
	}
	identity, _, _, err := request.Read(ctx, e, e.public.source)
	if err != nil || identity != e.observation.identity {
		return nil, errors.New("candidate endpoint changed its original native identity")
	}
	return RouterVPNOpenCandidatePacketEndpoint(ctx, request, e, e.public.source)
}

type routerVPNCandidateEndpoint interface {
	DialContext(context.Context, string, M.Socksaddr) (net.Conn, error)
	Close() error
}

type routerVPNPacketCandidate struct {
	ctx       context.Context
	cancel    context.CancelFunc
	request   *mobilemultihop.NodeChainCandidatePacketRequest
	reader    mobilemultihop.NodeChainEngine
	chain     *mobilemultihop.NodeChain
	private   M.Socksaddr
	packet    *mobilemultihop.NativeCandidatePacketDialer
	life      sync.Mutex
	closing   bool
	inner     routerVPNCandidateEndpoint
	opening   sync.WaitGroup
	once      sync.Once
	err       error
	stop      func() bool
	watched   chan struct{}
	watchOnce sync.Once
}

// This helper still requires the opaque request and its exact original reader.
// It never receives arbitrary credentials, a physical dialer or a prefix tag.
func RouterVPNOpenCandidatePacketEndpoint(ctx context.Context, request *mobilemultihop.NodeChainCandidatePacketRequest, reader mobilemultihop.NodeChainEngine, chain *mobilemultihop.NodeChain) (mobilemultihop.NodeChainCandidatePacketEndpoint, error) {
	bad := errors.New("candidate requires its exact native WG/AWG packet endpoint")
	capture, err := request.ReadPacketEndpoint(ctx, reader, chain)
	if err != nil {
		return nil, bad
	}
	_, _, address, err := request.Read(ctx, reader, chain)
	private := M.ParseSocksaddr(capture.PrivateAddress)
	if err != nil || !private.IsIP() || private.Port == 0 {
		return nil, bad
	}
	owned, cancel := context.WithCancel(ctx)
	// No inherited router, DNS, pause callback or interface manager can attach
	// another owner. The sealed packet dialer alone reaches the retained prefix.
	owned = service.ContextWithRegistry(owned, service.NewRegistry())
	packet, err := mobilemultihop.NewNativeCandidatePacketDialer(owned, request, reader, chain)
	if err != nil {
		cancel()
		return nil, bad
	}
	e := &routerVPNPacketCandidate{ctx: owned, cancel: cancel, request: request, reader: reader, chain: chain, private: private, packet: packet, watched: make(chan struct{})}
	e.life.Lock()
	defer e.life.Unlock()
	e.stop = context.AfterFunc(ctx, func() {
		_ = e.retire()
		e.watchOnce.Do(func() { close(e.watched) })
	})
	if owned.Err() != nil {
		return e, bad
	}
	if capture.Mode == "wg" {
		var captured struct {
			Type string `json:"type"`
			Tag  string `json:"tag"`
			option.WireGuardEndpointOptions
		}
		if json.Unmarshal([]byte(capture.Options), &captured) != nil {
			return e, bad
		}
		o := captured.WireGuardEndpointOptions
		if captured.Type != "wireguard" || o.System || o.Name != "" || o.ListenPort != 0 || len(o.Peers) != 1 || o.Detour != "" || o.DomainResolver != nil {
			return e, bad
		}
		peer := o.Peers[0]
		destination := M.Socksaddr{Addr: M.ParseAddr(peer.Address), Port: peer.Port}
		if !destination.IsIP() || destination.String() != address {
			return e, bad
		}
		endpoint, err := wg.NewEndpoint(wg.EndpointOptions{Context: owned, Logger: logger.NOP(), System: false,
			Dialer: packet, MTU: o.MTU, Address: o.Address, PrivateKey: o.PrivateKey, Workers: o.Workers,
			Peers: []wg.PeerOptions{{Endpoint: destination, PublicKey: peer.PublicKey, PreSharedKey: peer.PreSharedKey,
				AllowedIPs: peer.AllowedIPs, PersistentKeepaliveInterval: peer.PersistentKeepaliveInterval, Reserved: peer.Reserved}}})
		if err != nil {
			return e, bad
		}
		e.inner = endpoint
		if endpoint.Start(false) != nil {
			return e, bad
		}
	} else if capture.Mode == "awg2-fast" || capture.Mode == "awg2-strong" {
		var options routervpnamnezia.Options
		if json.Unmarshal([]byte(capture.Options), &options) != nil || options.Type != mobilemultihop.AmneziaType || len(options.Peers) != 1 {
			return e, bad
		}
		peer := options.Peers[0]
		if M.ParseSocksaddr(net.JoinHostPort(peer.Address, fmt.Sprint(peer.Port))).String() != address {
			return e, bad
		}
		endpoint, err := routervpnamnezia.NewCandidateEndpoint(owned, logger.NOP(), options, packet)
		if err != nil {
			return e, bad
		}
		e.inner = endpoint
		if endpoint.Start(adapter.StartStateStart) != nil {
			return e, bad
		}
	} else {
		return e, bad
	}
	_, _, _, err = request.Read(ctx, reader, chain)
	return e, errors.Join(err, owned.Err())
}

func (e *routerVPNPacketCandidate) DialPrivateContext(ctx context.Context) (net.Conn, error) {
	if ctx == nil {
		return nil, net.ErrClosed
	}
	if _, _, _, err := e.request.Read(ctx, e.reader, e.chain); err != nil {
		return nil, err
	}
	e.life.Lock()
	if e.closing || e.ctx.Err() != nil || e.inner == nil {
		e.life.Unlock()
		return nil, net.ErrClosed
	}
	e.opening.Add(1)
	inner := e.inner
	e.life.Unlock()
	defer e.opening.Done()
	connection, err := inner.DialContext(ctx, "tcp", e.private)
	_, _, _, observed := e.request.Read(ctx, e.reader, e.chain)
	return e.packet.OwnConnection(ctx, connection, errors.Join(err, observed, ctx.Err()))
}

func (e *routerVPNPacketCandidate) retire() error {
	e.once.Do(func() {
		e.cancel()
		e.packet.BeginClose()
		e.life.Lock()
		e.closing = true
		inner := e.inner
		e.life.Unlock()
		if inner != nil {
			e.err = inner.Close()
		}
		e.opening.Wait()
		e.err = errors.Join(e.err, e.packet.Join())
	})
	return e.err
}

func (e *routerVPNPacketCandidate) Close() error {
	if e.stop() {
		e.watchOnce.Do(func() { close(e.watched) })
	}
	err := e.retire()
	<-e.watched
	return err
}

func (e *RouterVPNNodeChainEngine) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if e == nil {
		return nil, errors.New("ordered native engine lost its original observation")
	}
	if address != hopmeasure.PublicAddress {
		return e.observation.Dial(ctx, tag, address)
	}
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return nil, err
	}
	ipv6, err := e.public.permit(e.observation, tag)
	if err != nil {
		return nil, err
	}
	query, cancel := context.WithTimeout(ctx, 5*time.Second)
	defer cancel()
	query = adapter.WithContext(query, &adapter.InboundContext{
		Inbound: e.observation.dns.TUNTag, InboundType: C.TypeTun, Network: "udp", Protocol: "dns",
	})
	addresses, err := e.observation.instance.dnsRouter.Lookup(query, hopmeasure.PublicHost,
		adapter.DNSQueryOptions{Transport: e.observation.resolver, DisableCache: true, DisableOptimisticCache: true})
	_, observed := e.ObserveChainContext(ctx)
	if err != nil || observed != nil || ctx.Err() != nil {
		return nil, errors.Join(err, observed, ctx.Err(), errors.New("ordered imported captured DNS lookup failed"))
	}
	for _, ip := range addresses {
		if !ip.IsValid() || ip.Zone() != "" || ip.Is4In6() || !ip.IsGlobalUnicast() ||
			ip.IsPrivate() || ip.IsLoopback() || ip.IsLinkLocalUnicast() || ip.IsUnspecified() || ip.Is6() && !ipv6 {
			continue
		}
		connection, dialErr := e.observation.Dial(ctx, tag, net.JoinHostPort(ip.String(), "443"))
		if dialErr == nil && connection != nil {
			return connection, nil
		}
		if _, observeErr := e.ObserveChainContext(ctx); observeErr != nil {
