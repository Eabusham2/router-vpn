package libbox

import (
	"encoding/json"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

// Each member retains its own complete private assets and paired identity.
// This does not start a second system VPN or expose a caller-controlled dial.
func RouterNodeChainMemberInput(mode, files, profile, start, bootstrap string) (string, error) {
	node, err := mobilemultihop.NewNodeProfile(mode, files, profile, start, bootstrap)
	if err != nil {
		return "", err
	}
	return node.LaunchInput()
}

func NewRouterNodeChain(source string) (*RouterNodeChain, error) {
	chain, err := mobilemultihop.NewNodeChain(source)
	if err != nil {
		return nil, err
	}
	return &RouterNodeChain{chain: chain}, nil
}

func NewRouterNodeChainLaunch(input string) (*RouterNodeChain, error) {
	chain, err := mobilemultihop.ParseNodeChainLaunchInput(input)
	if err != nil {
		return nil, err
	}
	return &RouterNodeChain{chain: chain}, nil
}

func (m *RouterNodeChain) Config() string               { return m.chain.Config() }
func (m *RouterNodeChain) SourceSHA256() string         { return m.chain.SourceSHA256() }
func (m *RouterNodeChain) ConfigSHA256() string         { return m.chain.ConfigSHA256() }
func (m *RouterNodeChain) LaunchInput() (string, error) { return m.chain.LaunchInput() }
func (m *RouterNodeChain) ProgressJSON() string {
	chain := m.chain
	if state := m.state.Load(); state != nil {
		chain = state.chain
	}
	value, _ := json.Marshal(chain.Progress())
	return string(value)
}
