package libbox

import (
	"encoding/json"
	"errors"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

// Each member retains its own complete private assets and paired identity.
// This does not start a second system VPN or expose a caller-controlled dial.
func RouterNodeChainMemberInput(mode, files, profile, start, bootstrap string) (string, error) {
	node, err := mobilemultihop.NewNodeProfile(mode, files, profile, start, bootstrap)
	if err != nil {
		return "", err
	}
	return node.LaunchInput()
}

// Preserve original external kind and bytes; no paired credentials are created.
func RouterNodeChainImportedMemberInput(config, capture string) (string, error) {
	return mobilemultihop.NodeChainImportedMemberInput(config, capture)
}

// The final captures its actual source and selected resolver independently of each interior.
func RouterNodeChainExternalFinalInput(config, capture string) (string, error) {
	return mobilemultihop.NodeChainExternalFinalInput(config, capture)
}

func RouterNodeChainExternalFinalFromEntry(entry, imported string) (string, error) {
	return mobilemultihop.NodeChainExternalFinalFromEntry(entry, imported)
}

func NewRouterNodeChain(source string) (*RouterNodeChain, error) {
	chain, err := mobilemultihop.NewNodeChain(source)
	if err != nil {
		return nil, err
	}
	value := &RouterNodeChain{chain: chain}
	value.self = value
	return value, nil
}

// Keep this named factory outside gomobile's New<Type> constructor family:
// both the source constructor and launch parser take one string.
func RouterNodeChainLaunch(input string) (*RouterNodeChain, error) {
	chain, err := mobilemultihop.ParseNodeChainLaunchInput(input)
	if err != nil {
		return nil, err
	}
	value := &RouterNodeChain{chain: chain}
	value.self = value
	return value, nil
}

func (m *RouterNodeChain) Config() string               { return m.chain.Config() }
func (m *RouterNodeChain) SourceSHA256() string         { return m.chain.SourceSHA256() }
func (m *RouterNodeChain) ConfigSHA256() string         { return m.chain.ConfigSHA256() }
func (m *RouterNodeChain) LaunchInput() (string, error) { return m.chain.LaunchInput() }
func (m *RouterNodeChain) HasImportedEntry() bool {
	return m != nil && m.self == m && m.chain.HasImportedEntry()
}
func (m *RouterNodeChain) HasExternalFinal() bool {
	return m != nil && m.self == m && m.chain != nil && m.chain.HasExternalFinal()
}
func (m *RouterNodeChain) ExtendedLocalNodeCount() int32 {
	if m == nil || m.self != m {
		return 0
	}
	return int32(m.chain.ExtendedLocalNodeCount())
}
func (m *RouterNodeChain) ExtendedMixedLocalPacketCount() int32 {
	if m == nil || m.self != m {
		return 0
	}
	return int32(m.chain.ExtendedMixedLocalPacketCount())
}
func (m *RouterNodeChain) ExtendedLocalRolesJSON() string {
	if m == nil || m.self != m {
		return ""
	}
	return m.chain.ExtendedLocalRolesJSON()
}
func (m *RouterNodeChain) ExtendedLocalStatusLimit() int32 {
	if m == nil || m.self != m {
		return 0
	}
	return int32(m.chain.ExtendedLocalStatusLimit())
}
func (m *RouterNodeChain) ProgressJSON() string {
	chain := m.chain
	if state := m.state.Load(); state != nil {
		chain = state.chain
	}
	value, _ := json.Marshal(chain.Progress())
	return string(value)
}

func RouterNodeChainImportedOpenVPNMemberInput(config, capture string) (string, error) {
	return mobilemultihop.NodeChainImportedOpenVPNMemberInput(config, capture)
}

func (m *RouterNodeChain) ValidateMultipleImportedLatencyCapture(raw string) error {
	if m == nil || m.self != m || m.chain == nil {
		return errors.New("ordered latency capture lost its original Local chain")
	}
	return m.chain.ValidateMultipleImportedLatencyCapture(raw)
}

func (m *RouterNodeChain) ValidateExternalFinalLatencyCapture(raw string) error {
	if m == nil || m.self != m || m.chain == nil {
		return errors.New("ordered public-exit latency capture lost its original Local chain")
	}
	return m.chain.ValidateExternalFinalLatencyCapture(raw)
}
