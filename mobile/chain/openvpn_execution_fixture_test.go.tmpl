package box

import (
	"encoding/json"
	"os"
	"path/filepath"
	"testing"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

func openVPNExecutionNativeSources(t *testing.T, name, execution string) (*mobilemultihop.NodeChain, *mobilemultihop.NodeChainExecutionPreparation, *mobilemultihop.NodeChainServerPolicy) {
	t.Helper()
	directory := os.Getenv("ROUTERVPN_OPENVPN_EXECUTION_NATIVE_FIXTURES")
	if directory == "" {
		t.Fatal("actual shared OpenVPN execution fixtures are required")
	}
	raw, err := os.ReadFile(filepath.Join(directory, name+".json"))
	var source struct {
		Local  string `json:"local"`
		Server string `json:"server"`
	}
	if err != nil || json.Unmarshal(raw, &source) != nil || source.Local == "" || source.Server == "" {
		t.Fatal("original independent execution profiles are missing", err)
	}
	original, err := mobilemultihop.NewNodeChain(source.Local)
	if err != nil {
		t.Fatal(err)
	}
	prep, err := mobilemultihop.NewNodeChainOpenVPNExecutionPreparation(original, execution)
	if err != nil {
		t.Fatal(err)
	}
	server, err := mobilemultihop.NewNodeChainOpenVPNServerPolicy(source.Server)
	if err != nil {
		t.Fatal(err)
	}
	return original, prep, server
}
