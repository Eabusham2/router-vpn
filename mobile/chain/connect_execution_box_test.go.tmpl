// Actual typed CONNECT/SS factories and original execution managers run here.
// TUN, packet-prefix I/O and DNS retain executionNativeFixture's explicit
// component doubles. This is not encrypted or OS network acceptance.
func connectExecutionNativeSources(t *testing.T, mode, protocol, execution string) (*mobilemultihop.NodeChainCONNECTSource, *mobilemultihop.NodeChainExecutionPreparation, *mobilemultihop.NodeChainServerPolicy) {
	return connectExecutionNativeSourcesPrefixes(t, 1, mode, protocol, execution)
}

func connectExecutionNativeSourcesPrefixes(t *testing.T, prefixes int, mode, protocol, execution string) (*mobilemultihop.NodeChainCONNECTSource, *mobilemultihop.NodeChainExecutionPreparation, *mobilemultihop.NodeChainServerPolicy) {
	t.Helper()
	name := ""
	if protocol == "https-connect" {
		name = "original-connect.example"
	}
	original := connectMTUSourcePrefixes(t, prefixes, mode, protocol, name)
	prep, err := mobilemultihop.NewNodeChainCONNECTExecutionPreparation(original, execution)
	if err != nil {
		t.Fatal(err)
	}
	input, err := original.Source()
	if err != nil {
		t.Fatal(err)
	}
	var local mobilemultihop.NodeChainSource
	if err = json.Unmarshal([]byte(input), &local); err != nil {
		t.Fatal(err)
	}
	_, meta, err := original.ReadValidated()
	if err != nil {
		t.Fatal(err)
	}
	source := mobilemultihop.NodeChainServerSource{Schema: 4, EntryID: meta.Proofs[0].ProfileID, EntryNodeID: meta.Proofs[0].NodeID, EntryMode: meta.Proofs[0].Mode, Nodes: local.Nodes[1:], IdentitySources: local.IdentitySources[1:]}
	// These remote packet peers retain the same captured endpoint/node but
	// their own independent private keys; the client original is untouched.
	privateKey := regexp.MustCompile(`(?m)^(PrivateKey\s*=\s*)[^\r\n]+$`)
	rekey := func(files string, seed byte) string {
		var assets map[string]string
		if json.Unmarshal([]byte(files), &assets) != nil {
			t.Fatal("original packet assets")
		}
		for _, name := range []string{"wg.conf", "awg.conf"} {
			encoded, ok := assets[name]
			if !ok {
				continue
			}
			raw, err := base64.StdEncoding.DecodeString(encoded)
			if err != nil || len(privateKey.FindAll(raw, -1)) != 1 {
				t.Fatal("original packet key missing")
			}
			key := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{seed}, 32))
			assets[name] = base64.StdEncoding.EncodeToString(privateKey.ReplaceAll(raw, []byte("${1}"+key)))
		}
		return chainNativeJSON(t, assets)
	}
	for i := 0; i < len(source.Nodes)-2; i++ {
		var row struct {
			Mode      string `json:"mode"`
			Files     string `json:"files"`
			Profile   string `json:"profile_json"`
			Start     string `json:"start"`
			Bootstrap string `json:"dns_bootstrap"`
		}
		if json.Unmarshal([]byte(source.Nodes[i]), &row) != nil {
			t.Fatal("remote original prefix")
		}
		row.Files = rekey(row.Files, byte(181+i))
		node, err := mobilemultihop.NewNodeProfile(row.Mode, row.Files, row.Profile, row.Start, row.Bootstrap)
		if err != nil {
			t.Fatal(err)
		}
		source.Nodes[i], err = node.LaunchInput()
		if err != nil {
			t.Fatal(err)
		}
		if row.Mode == "wg" {
			source.IdentitySources[i] = row.Files
		} else {
			source.IdentitySources[i] = rekey(source.IdentitySources[i], byte(211+i))
		}
	}
	server, err := mobilemultihop.NewNodeChainCONNECTServerPolicy(chainNativeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	return original, prep, server
}
func newCONNECTExecutionNativeFixture(t *testing.T, mode, protocol, execution string, parents ...context.Context) (*executionNativeFixture, *mobilemultihop.NodeChainCONNECTSource, *ownedCONNECT.Capture) {
	return newCONNECTExecutionNativePrefixFixture(t, 1, mode, protocol, execution, parents...)
}

func newCONNECTExecutionNativePrefixFixture(t *testing.T, prefixes int, mode, protocol, execution string, parents ...context.Context) (*executionNativeFixture, *mobilemultihop.NodeChainCONNECTSource, *ownedCONNECT.Capture) {
	t.Helper()
	original, prep, server := connectExecutionNativeSourcesPrefixes(t, prefixes, mode, protocol, execution)
	parent := t.Context()
	if len(parents) > 0 {
		parent = parents[0]
	}
	capture, err := ownedCONNECT.NewCapture(parent, original)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
		defer cancel()
		if err := capture.CloseContext(ctx); err != nil {
			t.Error(err)
		}
	})
	f := newExecutionNativeFixtureWithSources(t, prep, server, nil, executionNativeConstructionHook{
		parent: capture.Context(), registry: capture.Register,
		context: func(ctx context.Context) (context.Context, error) {
			return RouterVPNNodeCONNECTExecutionContext(ctx, prep, capture)
		},
		options: routerVPNNodeCONNECTOptions, bind: func(s *Box) { routerVPNNodeCONNECTBind(s) },
	})
	return f, original, capture
}
func TestRouterVPNCONNECTExecutionNativeOriginalOwner(t *testing.T) {
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		for _, protocol := range []string{"http-connect", "https-connect"} {
			for _, execution := range []string{"server", "auto"} {
				t.Run(mode+"/"+protocol+"/"+execution, func(t *testing.T) {
					f, original, _ := newCONNECTExecutionNativeFixture(t, mode, protocol, execution)
					engine, err := f.capture(t.Context())
					if err != nil {
						t.Fatal("typed native capture", err)
					}
					if err = engine.ObserveCONNECTExecutionContext(t.Context(), original); err != nil {
						t.Fatal("original typed observer", err)
					}
					if _, err = engine.ObserveChainContext(t.Context()); err != nil {
						t.Fatal("closed preparation original owner", err)
					}
					if open, err := engine.ApplicationOpenContext(t.Context()); err != nil || open {
						t.Fatal("preparation opened application", open, err)
					}
					f.discovery(t)
					if _, err := engine.DiscoverContext(t.Context()); err != nil {
						t.Fatal("typed native discovery", err)
					}
					if _, err = engine.AdoptContext(t.Context(), f.server.SourceSHA256(), 32003); err != nil {
						t.Fatal("typed native adoption", err)
					}
					if _, err = engine.ObserveChainContext(t.Context()); err != nil {
						t.Fatal("adopted original owner", err)
					}
					if open, err := engine.ApplicationOpenContext(t.Context()); err != nil || open {
						t.Fatal("adoption opened application", open, err)
					}
				})
			}
		}
	}
}
func TestRouterVPNCONNECTExecutionNativeRefusesReplacement(t *testing.T) {
	for _, fault := range []string{"equal-source", "foreign-preparation", "foreign-box", "missing-construction", "retired-middle", "duplicate-options", "changed-options", "cancelled"} {
		t.Run(fault, func(t *testing.T) {
			f, original, capture := newCONNECTExecutionNativeFixture(t, "wg", "http-connect", "server")
			engine, err := f.capture(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			observed := original
			ctx := t.Context()
			switch fault {
			case "equal-source":
				input, _ := original.Source()
				observed, err = mobilemultihop.NewNodeChainCONNECTSource(input)
				if err != nil {
					t.Fatal(err)
				}
			case "foreign-preparation":
				other, err := mobilemultihop.NewNodeChainCONNECTExecutionPreparation(original, "server")
				if err != nil {
					t.Fatal(err)
				}
				old := engine.prep
				engine.prep = other
				defer func() { engine.prep = old }()
			case "foreign-box":
				c := f.ctx.Value(routerVPNCONNECTExecutionKey{}).(*routerVPNCONNECTExecutionConstruction)
				old := c.instance
				c.instance = &Box{}
				defer func() { c.instance = old }()
			case "missing-construction":
				old := f.box.ctx
				f.box.ctx = context.WithValue(old, routerVPNCONNECTExecutionKey{}, false)
				defer func() { f.box.ctx = old }()
			case "retired-middle":
				if err := capture.CloseContext(t.Context()); err != nil {
					t.Fatal(err)
				}
			case "duplicate-options", "changed-options":
				options, err := SJ.UnmarshalExtendedContext[option.Options](f.ctx, []byte(f.prep.Config()))
				if err != nil {
					t.Fatal(err)
				}
				if fault == "changed-options" {
					options.Route.Final = "foreign-selector"
					c := f.ctx.Value(routerVPNCONNECTExecutionKey{}).(*routerVPNCONNECTExecutionConstruction)
					c.attempted = false
					defer func() { c.attempted = true }()
				}
				if routerVPNNodeCONNECTOptions(f.ctx, options) == nil {
					t.Fatal("foreign or repeated construction accepted")
				}
				return
			case "cancelled":
				var cancel context.CancelFunc
				ctx, cancel = context.WithCancel(ctx)
				cancel()
			}
			if engine.ObserveCONNECTExecutionContext(ctx, observed) == nil {
				t.Fatal("replacement typed native owner accepted")
			}
		})
	}
}

type connectExecutionHeldConn struct {
	net.Conn
	entered, release chan struct{}
	once             sync.Once
}

func (c *connectExecutionHeldConn) CloseWrite() error {
	return c.Conn.(interface{ CloseWrite() error }).CloseWrite()
}
func (c *connectExecutionHeldConn) Close() error {
	c.once.Do(func() { close(c.entered) })
	<-c.release
	return c.Conn.Close()
}

// The only network double is the packet predecessor. The actual CONNECT
// handshake, native middle owner and tracked socket lifecycle remain shipping.
func connectExecutionHTTPPipe(t *testing.T, f *executionNativeFixture, held bool) (<-chan string, *connectExecutionHeldConn) {
	t.Helper()
	addresses := make(chan string, 2)
	var wrapper *connectExecutionHeldConn
	f.prefixes[f.prep.ProofInventory()[0].Tag].dial = func(ctx context.Context) (net.Conn, error) {
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			return nil, err
		}
		client, err := (&net.Dialer{}).DialContext(ctx, "tcp", listener.Addr().String())
		if err != nil {
			listener.Close()
			return nil, err
		}
		peer, err := listener.Accept()
		listener.Close()
		if err != nil {
			client.Close()
			return nil, err
		}
		t.Cleanup(func() { _ = peer.Close() })
		go func() {
			defer peer.Close()
			request, err := http.ReadRequest(bufio.NewReader(peer))
			if err != nil {
				return
			}
			addresses <- request.Host
			if _, err = fmt.Fprint(peer, "HTTP/1.1 200 Connection Established\r\n\r\n"); err != nil {
				return
			}
			_, _ = io.Copy(io.Discard, peer)
		}()
		if held {
			wrapper = &connectExecutionHeldConn{Conn: client, entered: make(chan struct{}), release: make(chan struct{})}
			return wrapper, nil
		}
		return client, nil
	}
	return addresses, wrapper
}
func TestRouterVPNCONNECTExecutionNativePrecloseOriginal(t *testing.T) {
	for _, fault := range []string{"original", "source-cancelled", "cancelled-wait", "foreign-instance", "held-join"} {
		t.Run(fault, func(t *testing.T) {
			parent, cancel := context.WithCancel(t.Context())
			defer cancel()
			f, original, _ := newCONNECTExecutionNativeFixture(t, "wg", "http-connect", "server", parent)
			engine, err := f.capture(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			var held *connectExecutionHeldConn
			if fault == "held-join" {
				entry := f.prefixes[f.prep.ProofInventory()[0].Tag]
				addresses, _ := connectExecutionHTTPPipe(t, f, false)
				underlying := entry.dial
				entry.dial = func(ctx context.Context) (net.Conn, error) {
					conn, err := underlying(ctx)
					if err != nil {
						return conn, err
					}
					held = &connectExecutionHeldConn{Conn: conn, entered: make(chan struct{}), release: make(chan struct{})}
					return held, nil
				}
				_, meta, _ := original.ReadValidated()
				// Dial the actual retained middle directly: no application/Ready is granted.
				middle, _ := f.box.outbound.Outbound(meta.Proofs[1].Tag)
				conn, err := middle.(*ownedCONNECT.Outbound).DialContext(t.Context(), "tcp", M.ParseSocksaddr("93.184.216.34:443"))
				if err != nil {
					t.Fatal(err)
				}
				_ = conn
				select {
				case <-addresses:
				case <-time.After(time.Second):
					t.Fatal("missing original CONNECT exchange")
				}
				budget, stop := context.WithCancel(t.Context())
				result := make(chan error, 1)
				go func() { result <- f.box.RouterVPNCloseCONNECTMiddleContext(budget) }()
				select {
				case <-held.entered:
				case <-time.After(time.Second):
					stop()
					close(held.release)
					t.Fatal("original raw Close never entered")
				}
				stop()
				if err := <-result; !errors.Is(err, context.Canceled) {
					close(held.release)
					t.Fatal("held original socket falsely joined", err)
				}

				close(held.release)
			}
			if fault == "source-cancelled" {
				cancel()
			}
			if fault == "cancelled-wait" {
				ctx, stop := context.WithCancel(t.Context())
				stop()
				if f.box.RouterVPNCloseCONNECTMiddleContext(ctx) == nil {
					t.Fatal("cancelled preclose accepted")
				}
			}
			if fault == "foreign-instance" {
				c := f.ctx.Value(routerVPNCONNECTExecutionKey{}).(*routerVPNCONNECTExecutionConstruction)
				c.instance = &Box{}
				if f.box.RouterVPNCloseCONNECTMiddleContext(t.Context()) == nil {
					t.Fatal("foreign instance preclose accepted")
				}
				c.instance = f.box
			}
			joined, stop := context.WithTimeout(t.Context(), time.Second)
			defer stop()
			if err := f.box.RouterVPNCloseCONNECTMiddleContext(joined); err != nil {
				t.Fatal("original preclose join", err)
			}
			if err := f.box.RouterVPNCloseCONNECTMiddleContext(joined); err != nil {
				t.Fatal("idempotent original join", err)
			}
			if engine.ObserveCONNECTExecutionContext(t.Context(), original) == nil {
				t.Fatal("retired middle still observable")
			}
		})
	}
}
func TestRouterVPNCONNECTExecutionNativePublicDNS(t *testing.T) {
	for _, fault := range []string{"original", "foreign-tag", "foreign-address", "changed-owner", "changed-selector", "mapped-answer", "private-answer"} {
		t.Run(fault, func(t *testing.T) {
			f, _, _ := newCONNECTExecutionNativeFixture(t, "wg", "http-connect", "auto")
			projection := f.adopt(t)
			engine := f.engine
			proofs, err := projection.ProofInventory("local")
			if err != nil {
				t.Fatal(err)
			}
			addresses, _ := connectExecutionHTTPPipe(t, f, false)
			tag, address := proofs[1].Tag, hopmeasure.PublicAddress
			switch fault {
			case "foreign-tag":
				tag = proofs[2].Tag
			case "foreign-address":
				address = "foreign.example:443"
			case "changed-owner":
				f.dns.during = func() { f.current.Store(false) }
				defer f.current.Store(true)
			case "mapped-answer":
				f.dns.answerIP = net.IPv4(93, 184, 216, 34)
			case "private-answer":
				f.dns.answerIP = net.IP{10, 77, 0, 1}
			case "changed-selector":
				f.dns.during = func() { _ = engine.SelectContext(t.Context(), engine.state.Load().server.Tag()) }
			}
			before := f.dns.calls.Load()
			conn, err := engine.Dial(t.Context(), tag, address)
			if fault != "original" {
				if conn != nil {
					_ = conn.Close()
				}
				if err == nil {
					t.Fatal("foreign DNS/selection accepted")
				}
				if (fault == "foreign-tag" || fault == "foreign-address") && f.dns.calls.Load() != before {
					t.Fatal("foreign target invoked DNS")
				}
				return
			}
			if err != nil || conn == nil {
				t.Fatal("original selected DNS/public CONNECT", err, "dnsCalls", f.dns.calls.Load()-before, "selected", engine.selector.Now(), "middle", proofs[1].Tag)
			}
			if f.dns.calls.Load() <= before {
				t.Fatal("public origin bypassed original resolver")
			}
			select {
			case got := <-addresses:
				if got != "93.184.216.34:443" {
					t.Fatal("wrong resolved CONNECT tuple", got)
				}
			case <-time.After(time.Second):
				t.Fatal("missing resolved CONNECT request")
			}
			if err := conn.Close(); err != nil {
				t.Fatal(err)
			}
		})
	}
}

// The native client SOCKS implementation reaches a modeled authenticated
// remote front. This pins its original credentials and hostname framing;
// actual remote resolution/encryption is required by the separate suffix gate.
func TestRouterVPNCONNECTExecutionNativeServerPublicAuthority(t *testing.T) {
	for _, fault := range []string{"original", "away-and-back", "foreign-tag", "foreign-address"} {
		t.Run(fault, func(t *testing.T) {
			f, _, _ := newCONNECTExecutionNativeFixture(t, "wg", "http-connect", "server")
			projection := f.adopt(t)
			engine := f.engine
			proofs, err := projection.ProofInventory("server")
			if err != nil {
				t.Fatal(err)
			}
			var source mobilemultihop.NodeChainExecutionSource
			if json.Unmarshal([]byte(projection.Source()), &source) != nil {
				t.Fatal("missing original request")
			}
			target, user := proofs[1].Tag, source.Request.Users[0]
			address := hopmeasure.PublicAddress
			if fault == "foreign-tag" {
				target = proofs[2].Tag
			}
			if fault == "foreign-address" {
				address = "foreign.example:443"
			}
			observed := make(chan error, 1)
			entry := f.prefixes[f.prep.ProofInventory()[0].Tag]
			entry.dial = func(ctx context.Context) (net.Conn, error) {
				client, peer := net.Pipe()
				t.Cleanup(func() { peer.Close() })
				go func() {
					defer peer.Close()
					reader := bufio.NewReader(peer)
					greeting, err := socks5.ReadAuthRequest(reader)
					if err != nil || len(greeting.Methods) != 1 || greeting.Methods[0] != socks5.AuthTypeUsernamePassword {
						observed <- fmt.Errorf("original front authentication method: %v", err)
						return
					}
					if err = socks5.WriteAuthResponse(peer, socks5.AuthResponse{Method: socks5.AuthTypeUsernamePassword}); err != nil {
						observed <- err
						return
					}
					credentials, err := socks5.ReadUsernamePasswordAuthRequest(reader)
					if err != nil || credentials.Username != user.Username || credentials.Password != user.Password {
						observed <- fmt.Errorf("original prefix credentials changed: %v", err)
						return
					}
					if err = socks5.WriteUsernamePasswordAuthResponse(peer, socks5.UsernamePasswordAuthResponse{Status: socks5.UsernamePasswordStatusSuccess}); err != nil {
						observed <- err
						return
					}
					request, err := socks5.ReadRequest(reader)
					if err != nil || request.Command != socks5.CommandConnect || request.Destination.String() != hopmeasure.PublicAddress {
						observed <- fmt.Errorf("original hostname front scope changed: %v", err)
						return
					}
					if fault == "away-and-back" {
						if !engine.selector.SelectOutbound(engine.state.Load().local.Tag()) || !engine.selector.SelectOutbound(engine.state.Load().server.Tag()) {
							observed <- errors.New("fixture selector change failed")
							return
						}
					}
					err = socks5.WriteResponse(peer, socks5.Response{ReplyCode: socks5.ReplyCodeSuccess, Bind: M.ParseSocksaddr("127.0.0.1:1234")})
					observed <- err
					if err == nil {
						_, _ = io.Copy(io.Discard, peer)
					}
				}()
				return client, nil
			}
			before := f.dns.calls.Load()
			conn, err := engine.Dial(t.Context(), target, address)
			if conn != nil {
				defer conn.Close()
			}
			if fault == "original" && (err != nil || conn == nil) {
				t.Fatal("original remote hostname authority", err)
			}
			if fault != "original" && err == nil {
				t.Fatal("foreign remote hostname/selection accepted")
			}
			if f.dns.calls.Load() != before {
				t.Fatal("client replaced remote selected DNS authority")
			}
			if fault == "original" || fault == "away-and-back" {
				select {
				case err := <-observed:
					if err != nil {
						t.Fatal(err)
					}
				case <-time.After(time.Second):
					t.Fatal("native original SOCKS exchange missing")
				}
			}
		})
	}
}

// Hide only construction keys to retain the original registry and capture token.
type connectExecutionUnconstructedContext struct{ context.Context }

func (c connectExecutionUnconstructedContext) Value(key any) any {
	switch key.(type) {
	case routerVPNCONNECTExecutionKey, routerVPNOrderedTypedConstructionKey:
		return nil
	}
	return c.Context.Value(key)
}
func TestRouterVPNCONNECTExecutionNativeConstructionFamily(t *testing.T) {
	f, original, capture := newCONNECTExecutionNativeFixture(t, "wg", "http-connect", "server")
	t.Run("local-on-execution", func(t *testing.T) {
		if _, err := RouterVPNNodeCONNECTContext(f.ctx, original, capture); err == nil {
			t.Fatal("local constructor accepted execution authority")
		}
	})
	clean := connectExecutionUnconstructedContext{f.ctx}
	local, err := RouterVPNNodeCONNECTContext(clean, original, capture)
	if err != nil {
		t.Fatal("original local context", err)
	}
	t.Run("execution-on-local", func(t *testing.T) {
		if _, err := RouterVPNNodeCONNECTExecutionContext(local, f.prep, capture); err == nil {
			t.Fatal("execution constructor accepted local authority")
		}
	})
	socks := socksMTUSource(t)
	sc, err := ownedSOCKS.NewCapture(f.ctx, socks)
	if err != nil {
		t.Fatal(err)
	}
	defer sc.CloseOriginal()
	t.Run("socks-on-execution", func(t *testing.T) {
		if _, err := RouterVPNNodeSOCKSContext(sc.Context(), socks, sc); err == nil {
			t.Fatal("SOCKS constructor accepted execution authority")
		}
	})
}

func TestRouterVPNExecutionNativeCONNECTLastUsesOriginalDiscovery(t *testing.T) {
	for _, execution := range []string{"local", "server"} {
		t.Run(execution, func(t *testing.T) {
			f, _, _ := newCONNECTExecutionNativeFixture(t, "wg", "https-connect", "auto")
			last := executionLastRecord(t, f, execution)
			e, err := f.capture(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			if _, err = e.AdoptLastContext(t.Context(), last); err == nil {
				t.Fatal("saved Last record replaced fresh native discovery")
			}
			f.discovery(t)
			if _, err = e.DiscoverContext(t.Context()); err != nil {
				t.Fatal(err)
			}
			originalOwner, originalBox, originalInbound := e.discovery.Load(), e.instance, e.inbound
			plan, err := e.AdoptLastContext(t.Context(), last)
			if err != nil {
				t.Fatal("typed native Last failed original discovery adoption", err)
			}
			projection, err := plan.Projection()
			if err != nil {
				t.Fatal(err)
			}
			if e.discovery.Load() != originalOwner || e.instance != originalBox || e.inbound != originalInbound || e.planned.Load() != projection {
				t.Fatal("Last replaced its original discovery, Box, reader or projection")
			}
			if err = plan.RequireJoinedContext(t.Context()); err != nil {
				t.Fatal(err)
			}
			if open, err := e.ApplicationOpenContext(t.Context()); err != nil || open {
				t.Fatal("saved Last record opened application traffic", err)
			}
			runtime, err := mobilemultihop.NewNodeChainExecutionLastRuntime(t.Context(), plan, e)
			if err != nil {
				t.Fatal(err)
			}
			if runtime.Progress().Ready || runtime.HealthyContext(t.Context()) == nil {
				t.Fatal("native Last adoption fabricated live execution proof")
			}
			if _, err = mobilemultihop.NewNodeChainExecutionLastRuntime(t.Context(), plan, e); err == nil {
				t.Fatal("one Last plan admitted another runtime")
			}
			if err = runtime.CloseContext(t.Context()); err != nil {
				t.Fatal(err)
			}
		})
	}
}

func TestRouterVPNExecutionNativeCONNECTCompletePrefixes(t *testing.T) {
	for _, count := range []int{4, 8} {
		for _, execution := range []string{"server", "auto"} {
			t.Run(fmt.Sprintf("%d/%s", count, execution), func(t *testing.T) {
				f, original, capture := newCONNECTExecutionNativePrefixFixture(t, count-2, "wg", "https-connect", execution)
				engine, err := f.capture(t.Context())
				if err != nil {
					t.Fatal("complete original native capture", err)
				}
				if err = engine.ObserveCONNECTExecutionContext(t.Context(), original); err != nil {
					t.Fatal("original last-prefix observation", err)
				}
				f.discovery(t)
				if _, err = engine.DiscoverContext(t.Context()); err != nil {
					t.Fatal("complete original discovery", err)
				}
				if _, err = engine.AdoptContext(t.Context(), f.server.SourceSHA256(), 32003); err != nil {
					t.Fatal("complete original native adoption", err)
				}
				if _, err = engine.ObserveChainContext(t.Context()); err != nil {
					t.Fatal("complete original post-adoption proof", err)
				}
				if open, err := engine.ApplicationOpenContext(t.Context()); err != nil || open {
					t.Fatal("adoption opened traffic before proofs")
				}
				source, _ := original.Source()
				foreign, err := mobilemultihop.NewNodeChainCONNECTSource(source)
				if err != nil || engine.ObserveCONNECTExecutionContext(t.Context(), foreign) == nil {
					t.Fatal("equal replacement borrowed original prefix owner")
				}
				if err = capture.CloseContext(t.Context()); err != nil {
					t.Fatal("original middle join", err)
				}
				if engine.ObserveCONNECTExecutionContext(t.Context(), original) == nil {
					t.Fatal("retired original prefix retained authority")
				}
			})
		}
	}
