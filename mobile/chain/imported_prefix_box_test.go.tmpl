func chainNativeImportedSSPrefixSource(t *testing.T, count int) *mobilemultihop.NodeChain {
	t.Helper()
	modes := make([]string, count)
	for i := range modes {
		modes[i] = "wg"
	}
	pair := chainNativeSourceModes(t, modes)
	launch, err := pair.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(launch), &source) != nil {
		t.Fatal("complete original paired source absent")
	}
	source.IdentitySources = make([]string, count+2)
	for i := 0; i < count; i++ {
		var input map[string]any
		if json.Unmarshal([]byte(source.Nodes[i]), &input) != nil {
			t.Fatal("paired source absent")
		}
		source.IdentitySources[i] = input["files"].(string)
	}
	client, _ := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{byte(20 + count)}, 32))
	server, _ := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{byte(70 + count)}, 32))
	text := fmt.Sprintf("[Interface]\nAddress=10.77.0.2/24\nPrivateKey=%s\n[Peer]\nPublicKey=%s\nEndpoint=198.51.100.%d:51820\nAllowedIPs=0.0.0.0/0,::/0\n", base64.StdEncoding.EncodeToString(client.Bytes()), base64.StdEncoding.EncodeToString(server.PublicKey().Bytes()), 20+count)
	source.IdentitySources[count+1] = chainNativeJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(text))})
	password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, 32))
	graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "interface_name": "router-vpn", "address": []string{"172.29.91.1/30", "fd29:91::1/126"}, "mtu": 1280, "auto_route": true, "strict_route": true, "stack": "system"}}, "endpoints": []any{}, "outbounds": []any{map[string]any{"type": "shadowsocks", "tag": mobilemultihop.ExternalFinalTag, "server": "203.0.113.24", "server_port": 8388, "method": mobilemultihop.NativeStartLayerMethod, "password": password}}, "route": map[string]any{"final": mobilemultihop.ExternalFinalTag, "rules": []any{}, "auto_detect_interface": true}}
	profile := map[string]any{"id": "native-ss-prefix-middle", "node_kind": "external", "endpoint": "203.0.113.24", "external": map[string]any{"protocol": "shadowsocks", "expected_public_ip": "203.0.113.88", "shadowsocks": map[string]any{"server": "203.0.113.24", "port": 8388, "method": mobilemultihop.NativeStartLayerMethod, "password": password}}, "dns_mode": "home", "start_layer": "off", "mtu_policy": "auto", "ipv6_mode": "on", "home_lan_access": false, "kill_switch_policy": "on-connect"}
	capture := map[string]any{"schema": 1, "exit_id": "native-ss-prefix-middle", "protocol": "shadowsocks", "expected_public_ip": "203.0.113.88", "profile": profile}
	middle, err := mobilemultihop.NodeChainImportedMemberInput(chainNativeJSON(t, graph), chainNativeJSON(t, capture))
	if err != nil {
		t.Fatal(err)
	}
	source.Nodes = append(source.Nodes[:count], middle, source.Nodes[count])
	source.Schema = 2
	chain, err := mobilemultihop.NewNodeChain(chainNativeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	return chain
}

type importedSSPrefixReader struct {
	*chainNativeTUN
	fail bool
}

func (r *importedSSPrefixReader) Start(adapter.StartStage) error {
	if r.fail {
		return errors.New("original SS candidate refused")
	}
	return nil
}

// Actual Box/manager ownership and reader replacement; packet and kernel I/O
// are declared component boundaries, exercised separately by encrypted gates.
func TestRouterVPNNodeChainImportedSSPrefixMTUOriginalOwners(t *testing.T) {
	for _, count := range []int{2, 6} {
		for _, scenario := range []string{"candidate", "rollback", "prefix", "middle", "final", "resolver", "cancel", "stale-owner"} {
			t.Run(fmt.Sprintf("%d-%s", count, scenario), func(t *testing.T) {
				f := newChainNativeFixtureSource(t, chainNativeImportedSSPrefixSource(t, count), nil, nil)
				engine, err := f.capture(t.Context())
				if err != nil {
					t.Fatal(err)
				}
				for _, stage := range adapter.ListStartStages {
					if err := f.box.inbound.Start(stage); err != nil {
						t.Fatal(err)
					}
				}
				before, ok := f.box.inbound.Get(f.chain.DNSCapture().TUNTag)
				if !ok {
					t.Fatal("original reader absent")
				}
				candidate := &importedSSPrefixReader{chainNativeTUN: &chainNativeTUN{Adapter: inbound.NewAdapter("tun", before.Tag())}, fail: scenario == "rollback"}
				rollback := &importedSSPrefixReader{chainNativeTUN: &chainNativeTUN{Adapter: inbound.NewAdapter("tun", before.Tag())}}
				tx, changeErr := f.box.inbound.RouterVPNReplaceTunOwned(t.Context(), before, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
				if (scenario == "rollback") != (changeErr != nil) {
					t.Fatal("original reader transaction outcome changed", changeErr)
				}
				next, err := f.box.inbound.RouterVPNReadTunTransactionContext(t.Context(), tx, before)
				expected := adapter.Inbound(candidate)
				if scenario == "rollback" {
					expected = rollback
				}
				if err != nil || next != expected || next == before {
					t.Fatal("native transaction did not retire original reader", err)
				}
				if _, err := engine.ObserveChainContext(t.Context()); err == nil {
					t.Fatal("retired reader remained current")
				}
				fresh, err := f.capture(t.Context())
				if err != nil {
					t.Fatal(err)
				}
				for tag, original := range engine.observation.prefixes {
					if fresh.observation.prefixes[tag] != original {
						t.Fatal("reader replacement recaptured another transport", tag)
					}
				}
				if fresh.observation.resolver != engine.observation.resolver {
					t.Fatal("reader replacement recaptured DNS")
				}
				ctx := t.Context()
				switch scenario {
				case "prefix", "middle", "final":
					pos := count - 1
					if scenario == "middle" {
						pos = count
					}
					if scenario == "final" {
						pos = count + 1
					}
					tag := f.chain.PrefixTags()[pos]
					if pos < count {
						mu := chainNativeField[sync.Mutex](t, f.box.endpoint, "access")
						mu.Lock()
						(*chainNativeField[map[string]adapter.Endpoint](t, f.box.endpoint, "endpointByTag"))[tag] = &chainNativePrefix{Adapter: f.prefixes[tag].Adapter}
						mu.Unlock()
					} else {
						mu := chainNativeField[sync.RWMutex](t, f.box.outbound, "access")
						mu.Lock()
						(*chainNativeField[map[string]adapter.Outbound](t, f.box.outbound, "outboundByTag"))[tag] = &chainNativePrefix{Adapter: f.prefixes[tag].Adapter}
						mu.Unlock()
					}
				case "resolver":
					mu := chainNativeField[sync.RWMutex](t, f.box.dnsTransport, "access")
					mu.Lock()
					(*chainNativeField[map[string]adapter.DNSTransport](t, f.box.dnsTransport, "transportByTag"))[f.chain.DNSCapture().ResolverTag] = &chainNativeDNS{}
					mu.Unlock()
				case "cancel":
					var cancel context.CancelFunc
					ctx, cancel = context.WithCancel(ctx)
					cancel()
				case "stale-owner":
					f.current.Store(false)
				}
				_, err = fresh.ObserveChainContext(ctx)
				if scenario == "candidate" || scenario == "rollback" {
					if err != nil {
						t.Fatal("original native owners lost through reader succession", err)
					}
				} else if err == nil {
					t.Fatal("reader succession adopted foreign SS native owner", scenario)
				}
			})
		}
	}
}
