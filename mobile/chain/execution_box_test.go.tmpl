}

func TestRouterVPNExecutionNativeRetainsOneGraphThroughDiscovery(t *testing.T) {
	for _, mode := range []string{"auto", "server"} {
		t.Run(mode, func(t *testing.T) {
			f := newExecutionNativeFixture(t, mode, nil)
			inbounds, _ := adapter.RouterVPNInboundsContext(t.Context(), f.box.inbound)
			p := f.adopt(t)
			e := f.engine
			identity, err := e.ObserveChainContext(t.Context())
			if err != nil || identity.SourceSHA256 != p.SourceSHA256() || identity.ConfigSHA256 != p.ConfigSHA256() {
				t.Fatal("final identity did not retain actual projected graph", err)
			}
			after, _ := adapter.RouterVPNInboundsContext(t.Context(), f.box.inbound)
			if len(after) != 1 || after[0] != inbounds[0] || e.instance != f.box || e.resolver != f.dns || e.entry != f.prefixes[f.prep.ProofInventory()[0].Tag] {
				t.Fatal("native adoption replaced original TUN/resolver/entry")
			}
			if f.requests.Load() != 2 {
				t.Fatal("discovery did not use exactly original authenticated health and GET")
			}
			if open, err := e.ApplicationOpenContext(t.Context()); err != nil || open {
				t.Fatal("discovery/adoption opened application traffic", err)
			}
			if epoch, err := e.SelectionEpochContext(t.Context()); err != nil || epoch == 0 {
				t.Fatal("admitted selection has no monotonic identity", err)
			}
			if _, err := e.AdoptContext(t.Context(), f.server.SourceSHA256(), 32003); err == nil {
				t.Fatal("same original native graph admitted a second extension")
			}
		})
	}
}

func TestRouterVPNExecutionNativeRejectsActualGraphSubstitution(t *testing.T) {
	for _, fault := range []string{"mtu", "dns", "rule", "entry-key"} {
		t.Run(fault, func(t *testing.T) {
			f := newExecutionNativeFixture(t, "auto", func(graph map[string]any) {
				switch fault {
				case "mtu":
					graph["inbounds"].([]any)[0].(map[string]any)["mtu"] = float64(1400)
				case "dns":
					graph["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)["server"] = "192.168.50.134"
				case "rule":
					graph["route"].(map[string]any)["rules"] = []any{}
				case "entry-key":
					graph["endpoints"].([]any)[0].(map[string]any)["private_key"] = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{99}, 32))
				}
			})
			if e, err := f.capture(t.Context()); err == nil || e != nil {
				t.Fatal("changed actual graph acquired native preparation")
			}
		})
	}
}

func TestRouterVPNExecutionNativeDNSRejectsAwayAndBackSelection(t *testing.T) {
	f := newExecutionNativeFixture(t, "auto", nil)
	p := f.adopt(t)
	e := f.engine
	local, _ := p.DNSCapture("local")
	server, _ := p.DNSCapture("server")
	if err := e.SelectContext(t.Context(), local.SelectedTag); err != nil {
		t.Fatal(err)
	}
	if err := e.DNSExecutionProofContext(t.Context(), local); err != nil {
		t.Fatal("original DNS proof", err)
	}
	f.dns.mu.Lock()
	f.dns.during = func() {
		if !e.selector.SelectOutbound(server.SelectedTag) || !e.selector.SelectOutbound(local.SelectedTag) {
			t.Error("actual selector change failed")
		}
	}
	f.dns.mu.Unlock()
	if err := e.DNSExecutionProofContext(t.Context(), local); err == nil {
		t.Fatal("away-and-back selected DNS proof was accepted")
	}
	if f.dns.calls.Load() != 2 {
		t.Fatal("native DNS owner was bypassed or cached")
	}
}

func TestRouterVPNExecutionNativeGateRejectsForeignProofAndRetiredSelection(t *testing.T) {
	f := newExecutionNativeFixture(t, "auto", nil)
	p := f.adopt(t)
	e := f.engine
	identity, err := e.ObserveChainContext(t.Context())
	if err != nil {
		t.Fatal(err)
	}
	local, _ := p.DNSCapture("local")
	server, _ := p.DNSCapture("server")
	wrong := identity
	wrong.SourceSHA256 = strings.Repeat("e", 64)
	if e.OpenApplicationContext(t.Context(), wrong, local.SelectedTag) == nil {
		t.Fatal("foreign capture opened original application gate")
	}
	ctx, cancel := context.WithCancel(t.Context())
	if err := e.OpenApplicationContext(ctx, identity, local.SelectedTag); err != nil {
		t.Fatal("original permit", err)
	}
	cancel()
	if open, err := e.ApplicationOpenContext(t.Context()); err != nil || !open {
		t.Fatal("finished observation timeout retired a valid owned connection", err)
	}
	if err := e.SelectContext(t.Context(), server.SelectedTag); err == nil {
		t.Fatal("selection changed while application traffic admitted")
	}
	if !e.selector.SelectOutbound(server.SelectedTag) || !e.selector.SelectOutbound(local.SelectedTag) {
		t.Fatal("actual selector mutation failed")
	}
	if open, err := e.ApplicationOpenContext(t.Context()); err == nil || open {
		t.Fatal("old permit survived away-and-back native selection")
	}
	if err := e.RevokeApplicationContext(t.Context()); err != nil {
		t.Fatal(err)
	}
	if open, err := e.ApplicationOpenContext(t.Context()); err != nil || open {
		t.Fatal("original traffic gate did not retire", err)
	}
}

func TestRouterVPNExecutionNativeOpenCannotFinishAfterRevoke(t *testing.T) {
	f := newExecutionNativeFixture(t, "auto", nil)
	p := f.adopt(t)
	e := f.engine
	identity, err := e.ObserveChainContext(t.Context())
	if err != nil {
		t.Fatal(err)
	}
	local, _ := p.DNSCapture("local")
	entered, release := make(chan struct{}), make(chan struct{})
	var once sync.Once
	f.guardMu.Lock()
	f.guard = func(ctx context.Context) error { once.Do(func() { close(entered); <-release }); return ctx.Err() }
	f.guardMu.Unlock()
	result := make(chan error, 1)
	go func() { result <- e.OpenApplicationContext(t.Context(), identity, local.SelectedTag) }()
	<-entered
	if err := e.RevokeApplicationContext(t.Context()); err != nil {
		close(release)
		t.Fatal(err)
	}
	close(release)
	if err := <-result; err == nil {
		t.Fatal("older pending native open completed after revoke")
	}
	f.guardMu.Lock()
	f.guard = nil
	f.guardMu.Unlock()
	if open, err := e.ApplicationOpenContext(t.Context()); err != nil || open {
		t.Fatal("late open escaped original cancellation", err)
	}
}

func TestRouterVPNExecutionNativeDiscoveryKeepsLiteralOriginalEntry(t *testing.T) {
	f := newExecutionNativeFixture(t, "auto", nil)
	e, err := f.capture(t.Context())
	if err != nil {
		t.Fatal(err)
	}
	f.discovery(t)
	capture, _ := f.prep.Discovery()
	if conn, err := e.Dial(t.Context(), capture.Entry.Tag, "10.77.0.2:8787"); err == nil || conn != nil {
		t.Fatal("preparation dial accepted another destination")
	}
	if conn, err := e.Dial(t.Context(), f.prep.ProofInventory()[1].Tag, capture.Address); err == nil || conn != nil {
		t.Fatal("preparation dial accepted another prefix")
	}
	if f.requests.Load() != 0 {
		t.Fatal("refused preparation dial reached native control")
	}
	if _, err := e.DiscoverContext(t.Context()); err != nil {
		t.Fatal(err)
	}
	f.current.Store(false)
