func TestRouterVPNExecutionNativeFailedAcquisitionRetainsSealedStop(t *testing.T) {
	f := newExecutionNativeFixture(t, "server", nil)
	var allowStop atomic.Bool
	var acquisitions, deletions atomic.Int64
	var requestMu sync.Mutex
	var original multihoprelay.NodeChainRequest
	f.control = func(w http.ResponseWriter, r *http.Request) bool {
		if r.Method != http.MethodPut && r.Method != http.MethodDelete {
			return false
		}
		if r.URL.Path != "/api/multihop/chain/lease" {
			t.Error("sealed native control changed original route")
			http.Error(w, "wrong route", 400)
			return true
		}
		var request multihoprelay.NodeChainRequest
		if json.NewDecoder(r.Body).Decode(&request) != nil {
			t.Error("original native control lost request")
			http.Error(w, "bad request", 400)
			return true
		}
		if r.Method == http.MethodPut {
			if f.engine.stops.Load() != 1 {
				t.Error("native acquisition preceded sealed original stop")
			}
			requestMu.Lock()
			original = request.Clone()
			requestMu.Unlock()
			acquisitions.Add(1)
			f.current.Store(false)
			http.Error(w, "acquisition reply lost after source retirement", 503)
			return true
		}
		requestMu.Lock()
		same := reflect.DeepEqual(original, request)
		requestMu.Unlock()
		if !same {
			t.Error("sealed native cleanup replaced original acquisition")
			http.Error(w, "foreign request", 400)
			return true
		}
		deletions.Add(1)
		_ = json.NewEncoder(w).Encode(map[string]any{"node_id": request.EntryNodeID, "session_id": request.SessionID, "stopped": allowStop.Load()})
		return true
	}
	projection := f.adopt(t)
	runtime, err := mobilemultihop.NewNodeChainExecutionRuntime(projection, f.engine)
	if err != nil {
		t.Fatal(err)
	}
	if runtime.Run(t.Context()) == nil {
		t.Fatal("failed native acquisition became ready")
	}
	if acquisitions.Load() != 1 || deletions.Load() == 0 || f.engine.stops.Load() != 1 {
		t.Fatal("failed native acquisition lost exact cleanup authority", acquisitions.Load(), deletions.Load(), f.engine.stops.Load())
	}
	if f.engine.RetireContext(t.Context()) == nil {
		t.Fatal("native owner retired before remote cleanup joined")
	}
	allowStop.Store(true)
	if err := runtime.CloseContext(t.Context()); err != nil {
		t.Fatal("retired source stranded original runtime cleanup", err)
	}
	if f.engine.stops.Load() != 0 || acquisitions.Load() != 1 || deletions.Load() < 2 {
		t.Fatal("native cleanup did not join same original stop")
	}
	if err := f.engine.RetireContext(t.Context()); err != nil {
		t.Fatal(err)
	}
}

// This is an explicit private-storage boundary, not a fabricated live proof.
// Build the canonical nonsecret Last wire record from actual captured source
// types, then pass it through the shipping parser. The native tests below must
// still perform fresh authenticated discovery and leave application I/O closed.
type executionNativeLastRecord struct {
	Schema          int                               `json:"schema"`
	LocalSource     string                            `json:"local_source_sha256"`
	LocalInput      string                            `json:"local_input_sha256"`
	Setting         string                            `json:"setting"`
	Execution       string                            `json:"execution"`
	Target          string                            `json:"target"`
	Descriptor      multihoprelay.NodeChainDescriptor `json:"descriptor"`
	DescriptorSHA   string                            `json:"descriptor_sha256"`
	DNSPolicySHA    string                            `json:"dns_policy_sha256"`
	EntryHost       string                            `json:"entry_host"`
	Peer            string                            `json:"peer"`
	FirstPort       int                               `json:"first_port"`
	LastPort        int                               `json:"last_port"`
	Port            int                               `json:"listen_port"`
	DesktopTargetOS string                            `json:"desktop_target_os,omitempty"`
	Digest          string                            `json:"digest"`
}

func executionNativeStoredLast(t *testing.T, f *executionNativeFixture, winner string, edit func(*executionNativeLastRecord)) mobilemultihop.NodeChainExecutionLast {
	t.Helper()
	discovery, err := f.prep.Discovery()
	if err != nil {
		t.Fatal(err)
	}
	host, _, err := net.SplitHostPort(discovery.Address)
	if err != nil {
		t.Fatal(err)
	}
	descriptor := f.server.Descriptor()
	descriptorSHA, err := descriptor.Digest()
	if err != nil {
		t.Fatal(err)
	}
	input := sha256.Sum256([]byte(f.prep.LocalSource()))
	record := executionNativeLastRecord{Schema: 1, LocalSource: f.prep.LocalSourceSHA256(), LocalInput: hex.EncodeToString(input[:]),
		Setting: f.prep.Execution(), Execution: winner, Target: mobilemultihop.Targets[0], Descriptor: descriptor,
		DescriptorSHA: descriptorSHA, DNSPolicySHA: descriptor.DNSPolicySHA256, EntryHost: host,
		Peer: "10.77.0.2", FirstPort: 32000, LastPort: 32007, Port: 32003}
	if edit != nil {
		edit(&record)
	}
	raw, err := json.Marshal(record)
	if err != nil {
		t.Fatal(err)
	}
	digest := sha256.Sum256(append([]byte("routervpn-node-chain-execution-last-v1\x00"), raw...))
	record.Digest = hex.EncodeToString(digest[:])
	raw, err = json.Marshal(record)
	if err != nil {
		t.Fatal(err)
	}
	last, err := mobilemultihop.ParseNodeChainExecutionLast(string(raw), f.prep)
	if err != nil {
		t.Fatal("stored Last boundary failed actual parser", err)
	}
	return last
}

