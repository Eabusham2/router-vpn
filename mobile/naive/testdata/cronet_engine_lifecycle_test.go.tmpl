func routerVPNRunningClient(engines ...Engine) *NaiveClient {
	client := &NaiveClient{ctx: context.Background(), engines: engines}
	client.state.Store(uint32(clientStateRunning))
	return client
}

func TestRouterVPNNaiveClientConcurrentCloseRetriesPartialShutdown(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		client := routerVPNRunningClient(Engine{1}, Engine{2}, Engine{3})
		retry := false
		shutting := make(chan struct{})
		resume := make(chan struct{})
		var swept, shutdown, destroyed []uintptr
		restore := native.RouterVPNFixtureEngineCalls(func(p uintptr) {
			swept = append(swept, p)
		}, func(p uintptr) int32 {
			shutdown = append(shutdown, p)
			if p == 2 && !retry {
				close(shutting)
				<-resume
				return -203
			}
			return 0
		}, func(p uintptr) { destroyed = append(destroyed, p) })
		defer restore()
		owner, joiner := make(chan error, 1), make(chan error, 1)
		go func() { owner <- client.Close() }()
		<-shutting
		go func() { joiner <- client.Close() }()
		synctest.Wait()
		var premature bool
		select {
		case <-joiner:
			premature = true
		default:
		}
		close(resume)
		err := <-owner
		if premature {
			t.Fatal("concurrent close returned before its owner's shutdown")
		}
		if err == nil || <-joiner != err {
			t.Fatal("concurrent callers did not receive the failed native shutdown")
		}
		if !slices.Equal(destroyed, []uintptr{1}) || clientState(client.state.Load()) != clientStateClosing {
			t.Fatal("failed shutdown destroyed an owned engine or announced closure", destroyed)
		}
		retry = true
		if err := client.Close(); err != nil {
			t.Fatal(err)
		}
		if !slices.Equal(destroyed, []uintptr{1, 2, 3}) ||
			!slices.Equal(shutdown, []uintptr{1, 2, 2, 3}) ||
			!slices.Equal(swept, []uintptr{1, 2, 3, 2, 3}) {
			t.Fatal("retry revisited a destroyed engine or omitted an owned engine", destroyed, shutdown, swept)
		}
		if err := client.Close(); !errors.Is(err, net.ErrClosed) {
			t.Fatal("completed close lost its existing result", err)
		}
	})
}

func TestRouterVPNNaiveClientSweepDuringStreamConstruction(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		client := routerVPNRunningClient(Engine{1})
		stream := &routerVPNNaivePendingClose{requested: make(chan struct{})}
		tracked := &trackedNaiveConn{NaiveConn: stream, client: client, stopOwner: func() {}}
		client.activeConnections.Add(1)
		swept := make(chan struct{})
		shutdown := false
		restore := native.RouterVPNFixtureEngineCalls(func(uintptr) { close(swept) },
			func(uintptr) int32 { shutdown = true; return 0 }, func(uintptr) {})
		defer restore()
		result := make(chan error, 1)
		go func() { result <- client.Close() }()
		<-swept
		conn, err := client.routerVPNPublish(context.Background(), tracked)
		synctest.Wait()
		select {
		case <-stream.requested:
		default:
			t.Error("publication left a stream alive after the retirement sweep")
		}
		if conn != nil || !errors.Is(err, net.ErrClosed) || shutdown {
			t.Error("late publication or premature native shutdown", err, shutdown)
		}
		tracked.release()
		if err := <-result; err != nil || !shutdown {
			t.Fatal("stream termination did not allow native shutdown", err)
		}
	})
}

func TestRouterVPNNaiveClientPublicSweepCannotOutliveEngine(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		client := routerVPNRunningClient(Engine{1})
		first := true
		entered, resume := make(chan struct{}), make(chan struct{})
		shutdown := false
		restore := native.RouterVPNFixtureEngineCalls(func(uintptr) {
			if first {
				first = false
				close(entered)
				<-resume
			}
		}, func(uintptr) int32 { shutdown = true; return 0 }, func(uintptr) {})
		defer restore()
		go client.CloseAllConnections()
		<-entered
		result := make(chan error, 1)
		go func() { result <- client.Close() }()
		synctest.Wait()
		if shutdown {
			t.Error("destroyed engine beneath an admitted public sweep")
		}
		close(resume)
		if err := <-result; err != nil || !shutdown {
			t.Fatal("finished sweep did not release engine", err)
		}
	})
}

func TestRouterVPNNaiveClientCallbackAndChildDrain(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		client := routerVPNRunningClient(Engine{1})
		if !client.routerVPNBeginProxy() {
			t.Fatal("running client refused the original native callback")
		}
		swept := make(chan struct{})
		shutdown := false
		restore := native.RouterVPNFixtureEngineCalls(func(uintptr) { close(swept) },
			func(uintptr) int32 { shutdown = true; return 0 }, func(uintptr) {})
		defer restore()
		result := make(chan error, 1)
		go func() { result <- client.Close() }()
		<-swept
		synctest.Wait()
		if shutdown {
			t.Error("native shutdown skipped its admitted relay callback")
		}
		if client.routerVPNBeginProxy() {
			client.proxyWaitGroup.Done()
			t.Error("retiring client admitted a new relay callback")
		}
		client.proxyWaitGroup.Add(1) // A previously admitted callback starts a child.
		client.proxyWaitGroup.Done()
		synctest.Wait()
		if shutdown {
			t.Error("native shutdown skipped a callback's child worker")
		}
		client.proxyWaitGroup.Done()
		if err := <-result; err != nil || !shutdown {
			t.Fatal("finished relay did not release engine", err)
		}
	})
}

func TestRouterVPNNaiveClientStartupRollbackRetainsHandle(t *testing.T) {
	client := routerVPNRunningClient(Engine{1})
	client.failedStartEngine = Engine{2}
	var swept, destroyed []uintptr
	fail := true
	restore := native.RouterVPNFixtureEngineCalls(func(p uintptr) { swept = append(swept, p) },
		func(p uintptr) int32 {
			if p == 2 && fail {
				return -203
			}
			return 0
		}, func(p uintptr) { destroyed = append(destroyed, p) })
	defer restore()
	if err := client.Close(); err == nil || client.failedStartEngine.ptr != 2 {
		t.Fatal("failed native rollback lost the partially started handle")
	}
	fail = false
	if err := client.Close(); err != nil || client.failedStartEngine.ptr != 0 ||
		!slices.Equal(swept, []uintptr{1}) || !slices.Equal(destroyed, []uintptr{1, 2}) {
		t.Fatal("startup rollback crossed engine ownership", swept, destroyed, err)
	}
}

func TestRouterVPNNaiveClientRetiresPublishedStream(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		client := routerVPNRunningClient(Engine{1})
		client.logger = logger.NOP()
		client.streamContext, client.proxyCancel = context.WithCancel(client.ctx)
		client.streamEngines = []StreamEngine{{1}}
		var events []string
		record := func(event string) { events = append(events, event) }
		restoreStream := native.RouterVPNFixtureStreamCalls(func(uintptr) { record("cancel") },
			func(uintptr) int32 { record("post-destroy"); return 0 })
		defer restoreStream()
		restoreEngine := native.RouterVPNFixtureEngineCalls(func(uintptr) {},
			func(uintptr) int32 { record("shutdown"); return 0 }, func(uintptr) { record("destroy") })
		defer restoreEngine()
		_, err := client.DialEarly(context.Background(), M.ParseSocksaddr("192.0.2.1:443"))
		if err != nil {
			t.Fatal(err)
		}
		closed := make(chan error, 1)
		go func() { closed <- client.Close() }()
		synctest.Wait()
		if !slices.Equal(events, []string{"cancel"}) {
			t.Error("explicit client close did not cancel its published original stream", events)
		}
		// Deliver the terminal event to the handler the pinned stream registered.
		bidirectionalStreamAccess.RLock()
		entry := bidirectionalStreamMap[42]
		bidirectionalStreamAccess.RUnlock()
		entry.callback.OnCanceled(BidirectionalStream{42})
		if err := <-closed; err != nil || !slices.Equal(events, []string{"cancel", "post-destroy", "shutdown", "destroy"}) {
			t.Fatal("stream terminal event and engine shutdown lost native call order", err, events)
		}
	})
}
