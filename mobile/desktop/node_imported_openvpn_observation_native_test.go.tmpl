func init() { importedOpenVPNNativeConnected = testImportedOpenVPNNativeConnected }

// Only the platform interface replacement is modeled. Current/claim use the
// actual Box manager, and the replacement remains registered there so DNS and
// the packet observer retain the same tagged TUN before and after MTU rollback.
type importedOpenVPNNativeTUNEngine struct{ *routerVPNNodeMTUBox }

func (engine *importedOpenVPNNativeTUNEngine) Change(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
	current, err := engine.CurrentContext(ctx)
	if err != nil || current != expected {
		return expected, errors.New("native fixture TUN owner changed")
	}
	if err := engine.instance.Inbound().Create(ctx, engine.instance.Router(), log.NewNOPFactory().Logger(), engine.tag, C.TypeTun, &option.TunInboundOptions{MTU: uint32(mtu)}); err != nil {
		return expected, err
	}
	return engine.CurrentContext(ctx)
}

// The provider, original mutual TLS/data endpoint, Box endpoint manager,
// connected capacity observation, selected DNS and mailbox are real. Only the
// public physical tuple maps to loopback, and the application TUN readback is
// the explicit platform fixture; this is not privileged TUN acceptance.
func testImportedOpenVPNNativeConnected(t *testing.T) {
	for _, network := range []string{"tcp", "udp"} {
		t.Run(network, func(t *testing.T) {
			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
			defer cancel()
			listener, err := net.Listen("tcp4", "127.0.0.1:0")
			if err != nil {
				t.Fatal(err)
			}
			var queries atomic.Int32
			var denied atomic.Bool
			dnsReady := make(chan struct{})
			server := &dns.Server{Listener: listener, Net: "tcp", NotifyStartedFunc: func() { close(dnsReady) }, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
				if len(q.Question) != 1 || q.Question[0].Name != "example.com." || q.Question[0].Qclass != dns.ClassINET ||
					q.Question[0].Qtype != dns.TypeA && q.Question[0].Qtype != dns.TypeAAAA {
					t.Error("native selected-DNS fixture received a substituted proof question")
					return
				}
				queries.Add(1)
				answer := new(dns.Msg).SetReply(q)
				if denied.Load() {
					answer.Rcode = dns.RcodeNameError
				} else if q.Question[0].Qtype == dns.TypeA {
					answer.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 300}, A: net.ParseIP("93.184.216.34")}}
				}
				if importedDNSFixtureInterval(ctx) == nil {
					_ = w.WriteMsg(answer)
				}
			})}
			dnsDone := make(chan error, 1)
			go func() { dnsDone <- server.ActivateAndServe() }()
			// Shutdown before ActivateAndServe enters is a no-op. Capture its
			// actual started acknowledgement before a failed native constructor
			// can unwind this fixture and otherwise wait forever on dnsDone.
			select {
			case <-dnsReady:
			case err := <-dnsDone:
				_ = listener.Close()
				t.Fatal("native selected-DNS fixture did not start", err)
			case <-ctx.Done():
				_ = listener.Close()
				_ = server.Shutdown()
				<-dnsDone
				t.Fatal("native selected-DNS fixture lost its original startup context", ctx.Err())
			}
			defer func() { _ = server.Shutdown(); <-dnsDone }()
			pki := remoteNativeOpenVPNNativePKI(t)
			port := remoteNativeProvider(t, pki, network, listener.Addr().(*net.TCPAddr).Port)
			physical := &remoteNativePhysical{second: port, network: network}
			profile := remoteNativeOpenVPNNativeProfile(pki, pki.local, pki.localKey, network, "")
			profile.Config = strings.Replace(profile.Config, "remote 192.0.2.1 1194 ", "remote 192.0.2.2 1443 ", 1)
			profile.Config = strings.Replace(profile.Config, "tun-mtu 1400", "tun-mtu 1280", 1)
			endpoint, err := nativeopenvpn.CompileProfile(profile, "entry-wg", "")
			if err != nil {
				t.Fatal(err)
			}
			graph := map[string]any{"log": map[string]any{"disabled": true}, "endpoints": []any{endpoint},
				"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "mtu": 1420}},
				"dns":      map[string]any{"servers": []any{map[string]any{"type": "tcp", "tag": "selected-dns", "server": "192.0.2.123", "server_port": 80, "detour": "entry-wg"}}, "final": "selected-dns"},
				"route":    map[string]any{"final": "entry-wg"}}
			raw, _ := json.Marshal(graph)
			var platformTUN *importedDNSNativeTUN
			instance, err := remoteNativeFactory(ctx, raw, physical, nil, func(nativeContext context.Context) {
				registry := service.FromContext[adapter.InboundRegistry](nativeContext).(*inbound.Registry)
				inbound.Register[option.TunInboundOptions](registry, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.TunInboundOptions) (adapter.Inbound, error) {
					next := &desktopMTUTUNFixture{index: 17, mtu: int(options.MTU), tag: tag}
					if platformTUN != nil {
						next.index = platformTUN.index + 1
						next.guard, next.guardContext = platformTUN.guard, platformTUN.guardContext
					}
					platformTUN = &importedDNSNativeTUN{next}
					return platformTUN, nil
				})
			})
			if err != nil {
				t.Fatal(err)
			}
			defer func() {
				if err := instance.Close(); !remoteNativeOnlyClosed(err) {
					t.Error("actual retained child did not join", err)
				}
			}()
			digest := sha256.Sum256(raw)
			engine := &importedOpenVPNNativeTUNEngine{&routerVPNNodeMTUBox{instance: instance.Box, tag: "tun-in"}}
			tun, err := newRouterVPNNodeMTUContext(ctx, engine, strings.Repeat("a", 32), hex.EncodeToString(digest[:]), strings.Repeat("c", 64), func(ctx context.Context) error { return ctx.Err() })
			if err != nil || tun.inbound != platformTUN {
				t.Fatal("actual tagged TUN was not captured by its native Box", err)
			}
			owner, err := newRouterVPNImportedOpenVPN(ctx, instance.Box, raw, tun)
			if err != nil || owner == nil {
				t.Fatal("actual native observer missing", err)
			}
			importedOpenVPNGuardFixture(owner)
			if _, err := owner.observe(ctx); err != nativeopenvpn.ErrRemotePending || owner.state != nil {
				t.Fatal("unstarted native endpoint gained admission", err)
			}
			if err := instance.Start(); err != nil {
				t.Fatal(err)
			}
			connected, stop := context.WithTimeout(ctx, 5*time.Second)
			original, err := owner.await(connected)
			stop()
			if err != nil {
				t.Fatal("actual original native TLS/data state never admitted", err)
			}
			native, _ := instance.Endpoint().Get("entry-wg")
			client := native.(*O.ClientEndpoint)
			if original.Validate() != nil || !original.Remote.Matches(endpoint) || original.MTU != client.PortMTU() || original.MTU == 1280 || physical.calls.Load() == 0 {
				t.Fatal("observation returned configured capacity instead of actual negotiated native readback", original, client.PortMTU(), physical.calls.Load())
			}
			files, request := importedDNSFiles(t, tun, raw)
			var generation uint64
			exchange := func(operation, want string, budget time.Duration) {
				t.Helper()
				request.Operation = operation
				request.Generation = generation + 1
				request.Request = fmt.Sprintf("%032x", request.Generation)
				request.Deadline = time.Now().Add(budget).UnixMilli()
				importedDNSWrite(t, files, "node-dns-request.json", request)
				var proofErr error
				if err := routerVPNConsumeImportedDNS(ctx, files, tun, &generation, func(query context.Context) error {
					proofErr = instance.RouterVPNStrategyDNSProofContext(query)
					return proofErr
				}, owner); err != nil {
					t.Fatal("actual native mailbox failed", err)
				}
				body, err := files.read("node-dns-result.json", 4096)
				var result routerVPNImportedDNSResult
				if err != nil || !routerVPNMTUStrict(body, &result) || result.Status != want {
					t.Fatal("actual native operation did not produce its own result", operation, want, result, err, "native proof", proofErr, "queries", queries.Load())
				}
				if operation == "openvpn-observe" && want == "passed" {
					if result.OpenVPN == nil || *result.OpenVPN != original {
						t.Fatal("native mailbox lost original connected tuple")
					}
				} else if result.OpenVPN != nil {
					t.Fatal("DNS/cancelled result borrowed packet observation")
				}
			}
			exchange("openvpn-observe", "passed", 2*time.Second)
			if queries.Load() != 0 {
				t.Fatal("packet observation falsely ran selected DNS")
			}
			for _, want := range []string{"passed", "failed", "passed"} {
				denied.Store(want == "failed")
				before := queries.Load()
				exchange("", want, 2*time.Second)
				if queries.Load() <= before {
					t.Fatal("selected DNS result reused cached or packet evidence", want)
				}
			}
			release := client.RouterVPNTestHoldStatus()
			func() {
				defer release()
				exchange("openvpn-observe", "cancelled", 20*time.Millisecond)
			}()
			if state, err := owner.observe(ctx); err != nil || state != original || owner.retired != nil {
				t.Fatal("native read timeout retired healthy TLS/data connection", state, err)
			}
			// The application TUN remains the explicit platform fixture. The
			// command's handoff must independently reobserve this actual native
			// mutual-TLS/data endpoint without changing its remote generation.
			desktopNodeMTUApply(t, tun, "begin", 0)
			desktopNodeMTUApply(t, tun, "set", 1380)
			if state, err := owner.observeMTU(ctx); err != nil || state != original || owner.pinned(ctx) == nil {
				t.Fatal("owned MTU handoff lost the actual native connection or admitted ordinary measurements", state, err)
			}
			desktopNodeMTUApply(t, tun, "rollback", 0)
			registered, ok := instance.Inbound().Get("tun-in")
			if !ok || registered != tun.inbound || tun.inbound != platformTUN || tun.record.Reader != 3 || platformTUN.mtu != 1420 {
				t.Fatal("MTU rollback detached packet and DNS observations from their registered TUN")
			}
			request.Reader, request.MTU = tun.record.Reader, tun.record.MTU
			exchange("openvpn-observe", "passed", 2*time.Second)
			exchange("", "passed", 2*time.Second)
			client.RouterVPNTestRestart()
			remoteNativeWait(t, func() bool {
				next, capacity, err := client.RouterVPNConnectedCapacityContext(ctx)
				return err == nil && next.Remote == original.Remote.Remote && next.Generation > original.Remote.Generation && capacity == original.MTU
			}, "same-address native reconnect never established a new generation")
			if _, err := owner.observe(ctx); err == nil || owner.retired == nil || *owner.state != original {
				t.Fatal("original child recaptured actual reconnected native endpoint", err)
			}
		})
	}
}
