//go:build darwin

package tun

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/routervpn/desktopnetwork"
	"os"
)

// The same lifecycle mutex used by Close and MTU replacement protects this
// capture. The returned duplicate pins the actual utun object, not its alias,
// while the independently running PF guardian takes its retained reference.
func (t *Inbound) RouterVPNDesktopTunnelControl(guard func() bool) (*os.File, error) {
	t.routervpnLifecycle.Lock()
	defer t.routervpnLifecycle.Unlock()
	if !t.routervpnDesktop || guard == nil || !guard() || t.platformInterface != nil {
		return nil, errors.New("Darwin tunnel control has no captured native reader")
	}
	if _, _, _, err := t.routervpnDesktopInterface(); err != nil {
		return nil, err
	}
	owned, ok := t.tunIf.(interface{ RouterVPNRetainControl() (*os.File, error) })
	if !ok {
		return nil, errors.New("Darwin native TUN has no retained control adapter")
	}
	file, err := owned.RouterVPNRetainControl()
	if err != nil || !guard() {
		if file != nil {
			file.Close()
		}
		return nil, errors.Join(err, errors.New("Darwin native control retired during capture"))
	}
	return file, nil
}

// The caller owns this lifecycle lock and the native duplicate; a late duplicate
// is closed before returning, never handed to a guardian as accepted evidence.
func (t *Inbound) RouterVPNDesktopTunnelControlContext(ctx context.Context, guard func(context.Context) error) (*os.File, error) {
	if err := desktopnetwork.LockContext(ctx, &t.routervpnLifecycle); err != nil {
		return nil, err
	}
	defer t.routervpnLifecycle.Unlock()
	if !t.routervpnDesktop || guard == nil || t.platformInterface != nil {
		return nil, errors.New("Darwin tunnel control has no captured native reader")
	}
	if err := guard(ctx); err != nil {
		return nil, err
	}
	if _, _, _, err := t.routervpnDesktopInterfaceContext(ctx); err != nil {
		return nil, err
	}
	native, ok := t.tunIf.(interface {
		RouterVPNRetainControlContext(context.Context) (*os.File, error)
	})
	if !ok {
		return nil, errors.New("Darwin native control omitted bounded ownership")
	}
	file, err := native.RouterVPNRetainControlContext(ctx)
	if err == nil {
		err = guard(ctx)
	}
	if err != nil || ctx.Err() != nil {
		if file != nil {
			file.Close()
		}
		return nil, errors.Join(err, ctx.Err())
	}
	return file, nil
}
