func retirementAdmissionCall(n *NativeTun, action string, ctx context.Context) error {
	switch action {
	case "retire":
		_, err := n.RouterVPNDesktopNetworkRetire(ctx)
		return err
	case "start":
		return n.Start()
	case "update":
		options := n.options
		options.RouterVPNNetworkContext = ctx
		options.MTU = 1450
		return n.UpdateRouteOptions(options)
	case "reset":
		return n.resetRules()
	}
	return errors.New("unknown native admission action")
}

