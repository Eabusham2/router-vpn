func TestRouterVPNNativeLinuxRoutingReceiptKeepsOriginalLifetimeAndCallerBudget(t *testing.T) {
	native, _, _ := retirementFixture(t)
	startup, endStartup := context.WithCancel(context.Background())
	endStartup()
	lifetime, endLifetime := context.WithCancel(context.Background())
	defer endLifetime()
	native.options.RouterVPNNetworkContext = startup
	native.options.RouterVPNNetworkLifetime = lifetime
	entered := 0
	sentinel := errors.New("original native capability reached")
	want := context.Context(lifetime)
	native.routervpnRetirement.original = func(ctx context.Context) error {
		entered++
		if ctx != want {
			t.Fatal("receipt changed its original read lifetime or explicit caller")
		}
		return sentinel
	}
	if _, err := native.RouterVPNDesktopNetworkReceipt(); !errors.Is(err, sentinel) || entered != 1 {
		t.Fatal("completed construction deadline incorrectly retired the original live reader", err)
	}
	if _, err := native.RouterVPNDesktopNetworkReceiptContext(context.Background()); err == nil || entered != 1 {
		t.Fatal("explicit native receipt accepted an unbounded caller")
	}
	bounded := retirementStop(t)
	want = bounded
	if _, err := native.RouterVPNDesktopNetworkReceiptContext(bounded); !errors.Is(err, sentinel) || entered != 2 {
		t.Fatal("explicit native receipt did not use its exact remaining operation", err)
	}
	endLifetime()
	if _, err := native.RouterVPNDesktopNetworkReceiptContext(bounded); err == nil || entered != 2 {
		t.Fatal("fresh operation resurrected the retired original read lifetime")
	}
	active, model, _ := retirementFixture(t)
	operation, finish := context.WithCancel(retirementStop(t))
	defer finish()
	active.options.RouterVPNNetworkContext = startup
	active.options.RouterVPNNetworkLifetime = context.Background()
	active.routervpnRetirement.watch = &retirementCancelOnDrain{retirementModel: model, cancel: finish}
	if _, err := active.RouterVPNDesktopNetworkReceiptContext(operation); !errors.Is(err, context.Canceled) {
		t.Fatal("native receipt inventory escaped cancellation after its original event barrier", err)
	}

	// Reach each actual inventory helper, not just the descriptor fence above.
	// A canceled caller stops linuxDumpRequest before opening a kernel socket.
	// The construction context is independently observed so substituting it
	// cannot pass by returning an unrelated inventory or permission failure.
	for _, read := range []func(*NativeTun, context.Context) error{
		func(n *NativeTun, ctx context.Context) error {
			_, _, err := n.routervpnNetworkInterfaceContext(ctx)
			return err
		},
		func(n *NativeTun, ctx context.Context) error {
			_, err := n.routervpnNetworkAddressesContext(ctx, &net.Interface{Index: 8})
			return err
		},
		func(n *NativeTun, ctx context.Context) error {
			_, err := n.routervpnNetworkObjectsContext(ctx, DesktopNetworkReceipt{Index: 8})
			return err
		},
	} {
		operation := &retirementReadContext{Context: bounded}
		construction := &retirementReadContext{Context: bounded}
		n := &NativeTun{options: Options{RouterVPNNetworkContext: construction}, routervpnOwnedIndex: 8}
		if err := read(n, operation); err == nil || operation.calls == 0 || construction.calls != 0 {
			t.Fatal("native inventory replaced its explicit operation with construction lifetime", err, operation.calls, construction.calls)
		}
	}
}

