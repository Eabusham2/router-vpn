// The separate process reuses the original peer providers. Its only client
// input is a finite mode/fault choice; it cannot proxy an arbitrary target.
type nodeSOCKSRunRequest struct {
 Schema int `json:"schema"`
 Mode string `json:"mode"`
 Fault string `json:"fault"`
 Native bool `json:"native,omitempty"`
}
type nodeSOCKSRunReply struct {
 Schema int `json:"schema"`
 Source string `json:"source,omitempty"`
 SourceSHA256 string `json:"source_sha256"`
 ConfigSHA256 string `json:"config_sha256"`
 Address string `json:"address"`
 PublicCA string `json:"public_ca,omitempty"`
 Peer desktopNodeChainImportedReply `json:"peer"`
 DNS uint64 `json:"dns"`
 PublicDNS uint64 `json:"public_dns"`
 FinalAuth uint64 `json:"final_auth"`
 HeldProofs uint64 `json:"held_proofs"`
 Associations int `json:"associations"`
}
type nodeSOCKSRunPrefix struct {
 *nodeSOCKSPrefixHandler
 first string
}
func(h *nodeSOCKSRunPrefix) JudgeFlow(protocol uint8, source,destination netip.AddrPort, packet []byte)tun.FlowVerdict{
 if protocol==6&&destination.String()==h.first{return tun.FlowVerdict{Action:tun.ActionAccept}}
 if h.server==nil||h.relays==nil{return tun.FlowVerdict{Action:tun.ActionReject}}
 return h.nodeSOCKSPrefixHandler.JudgeFlow(protocol,source,destination,packet)
}
func(h *nodeSOCKSRunPrefix) NewConnectionEx(ctx context.Context,c net.Conn,source,destination M.Socksaddr,done N.CloseHandlerFunc){
 if destination.String()==h.first{
  if _,ok:=h.original.rule("tcp",destination);ok{h.original.tcp.Add(1)}
  h.original.desktopReferenceHandler.newReciprocalConnectionEx(ctx,c,source,destination,done);return
 }
 h.nodeSOCKSPrefixHandler.NewConnectionEx(ctx,c,source,destination,done)
}

// This observes the actual first-proof socket. The reference must retain its
// upload reader after a target response EOF, until the original caller sends
// its reciprocal FIN or the bounded drain is explicitly cancelled.
type nodeSOCKSProofObservedConn struct {
	net.Conn
	eof, early atomic.Bool
	eofOnce, closeOnce sync.Once
	eofSeen, closed chan struct{}
}

func (c *nodeSOCKSProofObservedConn) Read(p []byte) (int, error) {
	n, err := c.Conn.Read(p)
	if err == io.EOF {
		c.eof.Store(true)
		c.eofOnce.Do(func() { close(c.eofSeen) })
	}
	return n, err
}

func (c *nodeSOCKSProofObservedConn) Close() error {
	if !c.eof.Load() {
		c.early.Store(true)
	}
	err := c.Conn.Close()
	c.closeOnce.Do(func() { close(c.closed) })
	return err
}

func (c *nodeSOCKSProofObservedConn) CloseWrite() error {
	return c.Conn.(interface{ CloseWrite() error }).CloseWrite()
}

func TestRouterVPNSOCKSReferenceFirstProofReciprocalClose(t *testing.T) {
	for _, phase := range []string{"reciprocal", "refused", "held", "cancelled"} {
		t.Run(phase, func(t *testing.T) {
			ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
			defer cancel()
			backend, err := net.Listen("tcp4", "127.0.0.1:0")
			if err != nil {
				t.Fatal(err)
			}
			defer backend.Close()
			listener, err := net.Listen("tcp4", "127.0.0.1:0")
			if err != nil {
				t.Fatal(err)
			}
			defer listener.Close()
			const first = "10.78.0.1:8787"
			owner := &desktopReferenceHandler{ctx: ctx, cancel: cancel, owned: make(map[io.Closer]bool), rules: map[string]desktopReferenceRule{
				"tcp/" + first: {Network: "tcp", Address: "10.78.0.1", Port: 8787, Target: backend.Addr().String()},
			}}
			handler := &nodeSOCKSRunPrefix{nodeSOCKSPrefixHandler: &nodeSOCKSPrefixHandler{original: &desktopNodeWGHandler{desktopReferenceHandler: owner}}, first: first}
			backendDone := make(chan error, 1)
			backendFinished := make(chan struct{})
			go func() {
				defer close(backendFinished)
				accepted, failure := backend.Accept()
				if failure != nil {
					backendDone <- failure
					return
				}
				defer accepted.Close()
				stop := context.AfterFunc(ctx, func() { _ = accepted.Close() })
				defer stop()
				request := make([]byte, len("request"))
				_, failure = io.ReadFull(accepted, request)
				if failure != nil || string(request) != "request" {
					backendDone <- errors.Join(failure, errors.New("original first-proof request changed"))
					return
				}
				if phase != "refused" {
					_, failure = io.WriteString(accepted, "response")
				}
				if failure == nil {
					failure = accepted.(*net.TCPConn).CloseWrite()
				}
				if failure == nil {
					_, failure = io.Copy(io.Discard, accepted)
				}
				backendDone <- failure
			}()
			captured := make(chan *nodeSOCKSProofObservedConn, 1)
			routeDone := make(chan error, 1)
			routeFinished := make(chan struct{})
			go func() {
				defer close(routeFinished)
				raw, failure := listener.Accept()
				if failure != nil {
					routeDone <- failure
					return
				}
				original := &nodeSOCKSProofObservedConn{Conn: raw, eofSeen: make(chan struct{}), closed: make(chan struct{})}
				captured <- original
				handler.NewConnectionEx(ctx, original, M.Socksaddr{}, M.ParseSocksaddr(first), func(err error) { routeDone <- err })
				owner.workers.Wait()
			}()
			client, err := (&net.Dialer{}).DialContext(ctx, "tcp", listener.Addr().String())
			if err != nil {
				t.Fatal(err)
			}
			defer client.Close()
			var original *nodeSOCKSProofObservedConn
			select {
			case original = <-captured:
			case <-ctx.Done():
				t.Fatal("original first-proof socket missing")
			}
			t.Cleanup(func() {
				cancel()
				_ = client.Close()
				_ = original.Close()
				for _, done := range []<-chan struct{}{routeFinished, backendFinished} {
					select {
					case <-done:
					case <-time.After(time.Second):
						t.Error("original first-proof regression worker did not join cleanup")
					}
				}
			})
			if _, err = io.WriteString(client, "request"); err != nil {
				t.Fatal(err)
			}
			body, err := io.ReadAll(client)
			expected := "response"
			if phase == "refused" {
				expected = ""
			}
			if err != nil || string(body) != expected {
				t.Fatal("original first-proof response/EOF changed", err)
			}
			clean := phase == "reciprocal" || phase == "refused"
			if clean {
				held := time.NewTimer(25 * time.Millisecond)
				select {
				case <-original.closed:
					held.Stop()
					t.Fatal("reference closed original first proof before reciprocal EOF")
				case <-held.C:
				}
				if original.eof.Load() {
					t.Fatal("reference invented first-proof EOF while caller held it")
				}
				if err = client.(*net.TCPConn).CloseWrite(); err != nil {
					t.Fatal(err)
				}
				select {
				case <-original.eofSeen:
				case <-ctx.Done():
					t.Fatal("original first-proof reciprocal FIN was not read")
				}
			} else if phase == "cancelled" {
				cancel()
			}
			var failure error
			select {
			case failure = <-routeDone:
			case <-time.After(1500 * time.Millisecond):
				t.Fatal("original first-proof close exceeded its one-second drain budget")
			}
			if clean {
				if failure != nil || !original.eof.Load() || original.early.Load() {
					t.Fatal("original reciprocal first proof lost its joined receipt", failure)
				}
			} else if phase == "held" {
				if !errors.Is(failure, context.DeadlineExceeded) || original.eof.Load() {
					t.Fatal("held first-proof close escaped original one-second budget", failure)
				}
			} else if !errors.Is(failure, context.Canceled) {
				t.Fatal("cancelled first proof lost original cause", failure)
			}
			select {
			case err = <-backendDone:
				if clean && err != nil {
					t.Fatal("original first-proof target half-close failed", err)
				}
			case <-time.After(time.Second):
				t.Fatal("original first-proof target copy did not join")
			}
			select {
			case <-routeFinished:
			case <-time.After(time.Second):
				t.Fatal("original first-proof reference worker did not join")
			}
			owner.mu.Lock()
			left := len(owner.owned)
			owner.mu.Unlock()
			if left != 0 || handler.original.tcp.Load() != 1 {
				t.Fatal("original first-proof owner or target count changed", left, handler.original.tcp.Load())
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainSOCKSRunReference(t *testing.T){
 if os.Getenv("ROUTERVPN_SOCKS_RUN_REFERENCE")==""{t.Skip("isolated inherited SOCKS Run peer only")}
 if os.Getenv("ROUTERVPN_SOCKS_RUN_REFERENCE")!="1"{t.Fatal("SOCKS Run peer requires original inherited invocation")}
 reader:=bufio.NewReaderSize(os.Stdin,4097)
 line,err:=reader.ReadSlice('\n')
 if err!=nil||len(line)>4096{t.Fatal("bounded original SOCKS Run request missing")}
 var input nodeSOCKSRunRequest
 decoder:=json.NewDecoder(bytes.NewReader(line));decoder.DisallowUnknownFields()
 if decoder.Decode(&input)!=nil||decoder.Decode(new(any))!=io.EOF||input.Schema!=1{t.Fatal("SOCKS Run request changed")}
 if input.Mode!="wg"&&input.Mode!="awg2-fast"&&input.Mode!="awg2-strong"{t.Fatal("uncaptured SOCKS Run mode")}
 switch input.Fault{case "", "middle-password","final-token","selected-dns","middle-public","hold-prefix":default:t.Fatal("uncaptured SOCKS Run fault")}
 // Registered first: this is emitted only after every original provider,
 // packet reader, association and HTTP/DNS server cleanup has returned.
 t.Cleanup(func(){if !t.Failed(){fmt.Fprintln(os.Stdout,"SOCKS_RUN_PEER_JOINED")}})
 physical,err:=nodeSOCKSRunPhysical(input.Native)
 if err!=nil{t.Fatal(err)}
 request,clients:=desktopNodeChainPeerFixture(t,1)
 desktopNodeChainSetModes(t,&request,[]string{input.Mode})
 finalKey,err:=ecdh.X25519().GenerateKey(rand.Reader);if err!=nil{t.Fatal(err)}
 finalPublic:=base64.StdEncoding.EncodeToString(finalKey.PublicKey().Bytes())
 proof:=sha256.Sum256([]byte("router-vpn-node-proof-v1\n"+finalPublic))
 request.FinalNodeProofID=hex.EncodeToString(proof[:])
 identity:=desktopNodeChainJSON(t,map[string]string{"wg.conf":base64.StdEncoding.EncodeToString([]byte(fmt.Sprintf(
  "[Interface]\nAddress=10.77.0.2/32\nPrivateKey=%s\nMTU=1420\n[Peer]\nPublicKey=%s\nEndpoint=10.77.0.1:51820\nAllowedIPs=0.0.0.0/0,::/0\n",clients[0],finalPublic)))})
 const control="10.79.0.1:1080"
 const password="captured-socks-run-password"
 var handler *nodeSOCKSRunPrefix
 var relays *desktopImportedSOCKSLayerRoutes
 hooks:=&desktopNodeChainImportedPeerHooks{
  decorate:func(original *desktopNodeWGHandler)tun.Handler{
   handler=&nodeSOCKSRunPrefix{nodeSOCKSPrefixHandler:&nodeSOCKSPrefixHandler{original:original,control:control},first:"10.78.0.1:8787"}
   return handler
  },
  middle:func(middle *desktopNodeLayerServer)desktopExternalInstalledSSPeer{
   provider,socks:=desktopStartImportedSOCKSProvider(t,middle,password,"")
   ctx,cancel:=context.WithCancel(context.Background())
   relays=&desktopImportedSOCKSLayerRoutes{parent:ctx,control:provider.address,private:"10.79.0.1",leases:map[string]*desktopImportedSOCKSRelayLease{},physical:map[string]string{}}
   socks.mu.Lock();socks.entryRelay=relays.relay;socks.mu.Unlock()
   server:=&desktopNodeLayerServer{ctx:ctx,cancel:cancel,connections:map[io.Closer]bool{},
    routes:[]desktopNodeLayerRoute{{Network:"tcp",Destination:control,Physical:provider.address}},ownedUDP:relays.acquire}
   handler.server,handler.relays=server,relays
   t.Cleanup(func(){relays.close();nodeSOCKSCloseServer(server)})
   return provider
  },
 }
 middleKey:=base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73},32))
 fixtureRequest:=desktopNodeChainImportedRequest{1,request,mobilemultihop.NativeStartLayerMethod,middleKey}
 loopback:=netip.MustParseAddr("127.0.0.1")
 if input.Native{loopback=physical}
 peer:=desktopNodeChainImportedPeerStartWithHooks(t,fixtureRequest,loopback,loopback,nil,hooks)
 // No obsolete SS-middle route is admitted by this captured SOCKS handler.
 delete(peer.paired.entry.rules,"tcp/10.79.0.1:8388")
 delete(peer.paired.entry.rules,"udp/10.79.0.1:8388")
 var selectedQueries,publicQueries,finalAuth,heldProofs atomic.Uint64
 var releaseHeld atomic.Bool
 prefixRule:=peer.paired.entry.rules["tcp/10.78.0.1:8787"]
 if prefixRule.Target==""{t.Fatal("original first private proof missing")}
 // Require the exact final token before forwarding to the original final
 // private service. Its original HTTP/body/proof implementation is reused.
 finalTarget,ok:=peer.paired.final.route("tcp",desktopNodeRouterHealthTarget);if !ok{t.Fatal("original final private proof missing")}
 forward:=func(target string)*http.Transport{
  transport:=&http.Transport{Proxy:nil,DisableKeepAlives:true,ResponseHeaderTimeout:2*time.Second,
   DialContext:func(ctx context.Context,network,address string)(net.Conn,error){
    if network!="tcp"||address!=target{return nil,errors.New("reference proof escaped original target")}
    return (&net.Dialer{}).DialContext(ctx,network,address)
   }}
  t.Cleanup(transport.CloseIdleConnections);return transport
 }
 serve:=func(w http.ResponseWriter,r *http.Request,target string,transport *http.Transport){
  copy:=r.Clone(r.Context());copy.RequestURI="";copy.URL.Scheme="http";copy.URL.Host=target
  response,err:=transport.RoundTrip(copy);if err!=nil{http.Error(w,"original proof unavailable",502);return}
  defer response.Body.Close()
  for key,values:=range response.Header{for _,value:=range values{w.Header().Add(key,value)}}
  w.WriteHeader(response.StatusCode);_,_=io.Copy(w,io.LimitReader(response.Body,16<<20+1))
 }
 finalTransport:=forward(finalTarget)
 finalHTTP:=desktopImportedWGSSHTTP(t,nil,http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){
  if r.Host!=desktopNodeRouterHealthTarget||r.Header.Get("Authorization")!="Bearer "+request.FinalAPIToken{
