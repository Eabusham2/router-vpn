 }
 respond(true)
 for{
  line,err=reader.ReadSlice('\n')
  if err!=nil||len(line)>64{t.Fatal("original SOCKS Run control pipe",err)}
  command:=strings.TrimSuffix(string(line),"\n")
  switch command{
