  if input.Fault=="hold-prefix"&&!releaseHeld.Load(){heldProofs.Add(1);<-r.Context().Done();return}
  serve(w,r,firstTarget,firstTransport)
 }))
 prefixRule.Target=firstHTTP;peer.paired.entry.rules["tcp/10.78.0.1:8787"]=prefixRule
 packet,err:=net.ListenPacket("udp4","127.0.0.1:0");if err!=nil{t.Fatal(err)}
 dnsServer:=&dns.Server{PacketConn:packet,Handler:dns.HandlerFunc(func(w dns.ResponseWriter,q *dns.Msg){
  reply:=new(dns.Msg).SetReply(q)
  if len(q.Question)!=1{reply.Rcode=dns.RcodeRefused}else{
   question:=q.Question[0]
   address:=""
   switch question.Name{
   case "example.com.":selectedQueries.Add(1);address="93.184.216.34"
   case "speed.cloudflare.com.":publicQueries.Add(1);address="1.1.1.1"
   default:reply.Rcode=dns.RcodeRefused
   }
   if input.Fault=="selected-dns"{reply.Rcode=dns.RcodeNameError;address=""}
   if address!=""&&question.Qtype==dns.TypeA{
    reply.Answer=[]dns.RR{&dns.A{Hdr:dns.RR_Header{Name:question.Name,Rrtype:dns.TypeA,Class:dns.ClassINET,Ttl:0},A:net.ParseIP(address)}}
   }
  }
  _=w.WriteMsg(reply)
 })}
 dnsDone:=make(chan error,1);go func(){dnsDone<-dnsServer.ActivateAndServe()}()
 t.Cleanup(func(){_=dnsServer.Shutdown();_=packet.Close();if err:=<-dnsDone;err!=nil{t.Error(err)}})
 for i:=range peer.paired.final.routes{
  route:=&peer.paired.final.routes[i]
  if route.Network=="tcp"&&route.Destination==desktopNodeRouterHealthTarget{route.Physical=finalHTTP}
  if route.Network=="udp"&&route.Destination=="192.168.50.133:53"{route.Physical=packet.LocalAddr().String()}
 }
 // The measurement engine must use a public literal returned by this final
 // resolver. The original middle HTTPS responder still checks its TLS/Host.
 if mustSOCKSRunRoute(t,peer.middle,"tcp","1.1.1.1:443")!=mustSOCKSRunRoute(t,peer.middle,"tcp","speed.cloudflare.com:443"){t.Fatal("public literal and TLS hostname escaped original middle responder")}
 if input.Fault=="middle-public"{peer.wrongPublic.Store(true)}
 socket:=netip.MustParseAddrPort(peer.paired.address)
 sourceRequest:=request
 if input.Fault=="final-token"{sourceRequest.FinalAPIToken="different-final-private-token"}
 base:=desktopNodeChainImportedSource(t,sourceRequest,clients,net.JoinHostPort(request.Address,strconv.Itoa(int(socket.Port()))),mobilemultihop.NativeStartLayerMethod,middleKey,identity)
 launch,err:=base.LaunchInput();if err!=nil{t.Fatal(err)}
 var source mobilemultihop.NodeChainSource
 if json.Unmarshal([]byte(launch),&source)!=nil{t.Fatal("original captured source vanished")}
 secret:=password;if input.Fault=="middle-password"{secret+="-wrong"}
 memberConfig:=map[string]any{
  "inbounds":[]any{map[string]any{"type":"tun","tag":"tun-in","interface_name":"router-vpn","address":[]string{"172.29.91.1/30","fd29:91::1/126"},"mtu":1280,"auto_route":true,"strict_route":true,"stack":"system"}},
  "endpoints":[]any{},"outbounds":[]any{map[string]any{"type":"socks","tag":"custom-exit","server":"10.79.0.1","server_port":1080,"version":"5","username":"captured-native-user","password":secret}},
  "route":map[string]any{"final":"custom-exit","rules":[]any{},"auto_detect_interface":true}}
 profile:=map[string]any{"id":"captured-socks-middle","node_kind":"external","external":map[string]any{"protocol":"socks5","expected_public_ip":"203.0.113.88","socks5":map[string]any{"host":"10.79.0.1","port":1080,"username":"captured-native-user","password":secret}},
  "endpoint":"10.79.0.1","dns_mode":"home","mtu_policy":"auto","ipv6_mode":"on","home_lan_access":false,"kill_switch_policy":"on-connect"}
 capture:=map[string]any{"schema":1,"exit_id":"captured-socks-middle","protocol":"socks5","expected_public_ip":"203.0.113.88","profile":profile}
 middle,err:=mobilemultihop.NodeChainImportedSOCKSMemberInput(desktopNodeChainJSON(t,memberConfig),desktopNodeChainJSON(t,capture));if err!=nil{t.Fatal("original SOCKS member",err)}
 source.Schema,source.Nodes[1]=3,middle
 sealed,err:=mobilemultihop.NewNodeChainSOCKSSource(desktopNodeChainJSON(t,source));if err!=nil{t.Fatal("original typed Run source",err)}
 _,meta,err:=sealed.ReadValidated();if err!=nil{t.Fatal(err)}
 original,err:=sealed.Source();if err!=nil{t.Fatal(err)}
 if meta.NativeAdmission!="closed"||len(meta.Physical)!=1||meta.DNS.ResolverTag==""{t.Fatal("peer source widened native admission")}
 respond:=func(include bool){
  relays.mu.Lock();associations:=len(relays.all);relays.mu.Unlock()
  peerReply:=peer.snapshot();peerReply.Middle.Method="socks5"
  reply:=nodeSOCKSRunReply{Schema:1,SourceSHA256:meta.SourceSHA256,ConfigSHA256:meta.ConfigSHA256,Address:peer.paired.address,
   Peer:peerReply,DNS:selectedQueries.Load(),PublicDNS:publicQueries.Load(),FinalAuth:finalAuth.Load(),HeldProofs:heldProofs.Load(),Associations:associations}
  if include{reply.Source=original;reply.PublicCA=peer.paired.ca}
