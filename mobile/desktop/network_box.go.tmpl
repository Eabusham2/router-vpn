package box

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/routervpn/desktopnetwork"
	"runtime"
)

// Optional absence is distinct from a failed observation. A legacy-only reader
// cannot satisfy a bounded request, and only explicit inventory unavailability
// disables comparison evidence while retaining the ordinary proved connection.
func routerVPNDesktopNetworkReceiptContext(ctx context.Context, inbound any, name string, index, mtu int) (string, error) {
	if ctx == nil {
		return "", errors.New("routing receipt requires its caller")
	}
	if err := ctx.Err(); err != nil {
		return "", err
	}
	reader, ok := inbound.(interface {
		RouterVPNDesktopNetworkReceiptContext(context.Context) (string, error)
	})
	if !ok {
		if _, legacy := inbound.(interface{ RouterVPNDesktopNetworkReceipt() (string, error) }); legacy {
			return "", errors.New("native routing receipt has no bounded reader")
		}
		return "", nil
	}
	raw, err := reader.RouterVPNDesktopNetworkReceiptContext(ctx)
	if errors.Is(err, desktopnetwork.ErrNetworkReceiptUnavailable) {
		return "", ctx.Err()
	}
	if err != nil {
		return "", err
	}
	receipt, err := desktopnetwork.ParseDesktopNetworkReceipt(raw)
	if err != nil || receipt.TargetOS != runtime.GOOS || name != "" && receipt.Name != name || index != 0 && receipt.Index != uint32(index) || mtu != 0 && receipt.MTU != mtu {
		return "", errors.New("native routing projection lost its original interface")
	}
	return raw, ctx.Err()
}
func routerVPNDesktopNetworkReceipt(inbound any, name string, index, mtu int) (string, error) {
	return routerVPNDesktopNetworkReceiptContext(context.Background(), inbound, name, index, mtu)
}
func (r *RouterVPNExternalProofRequest) DesktopNetworkReceipt() (string, error) {
	return r.DesktopNetworkReceiptContext(context.Background())
}
func (r *RouterVPNExternalProofRequest) DesktopNetworkReceiptContext(ctx context.Context) (string, error) {
	if err := r.HealthyContext(ctx); err != nil {
		return "", err
	}
	e := r.engine
	if err := desktopnetwork.RLockContext(ctx, &e.mu); err != nil {
		return "", err
	}
	defer e.mu.RUnlock()
	identity, err := e.identityLockedContext(ctx)
	if err != nil {
		return "", err
	}
	if identity == "" {
		return "", errors.New("external routing receipt lost its native graph")
	}
	raw, err := routerVPNDesktopNetworkReceiptContext(ctx, e.tun, "", 0, 0)
	if err != nil {
		return "", err
	}
	identity, err = e.identityLockedContext(ctx)
	if err != nil {
		return "", err
	}
	if identity == "" {
		return "", errors.New("external routing receipt retired during capture")
	}
	return raw, ctx.Err()
}
func (r *RouterVPNDesktopTor) DesktopNetworkReceipt() (string, error) {
	return r.DesktopNetworkReceiptContext(context.Background())
}
func (r *RouterVPNDesktopTor) DesktopNetworkReceiptContext(ctx context.Context) (string, error) {
	if err := r.HealthyContext(ctx); err != nil {
		return "", err
	}
	if err := desktopnetwork.RLockContext(ctx, &r.interfaceMu); err != nil {
		return "", err
	}
	defer r.interfaceMu.RUnlock()
	name, index, mtu, err := r.readbackLockedContext(ctx)
	if err != nil {
		return "", err
	}
	raw, err := routerVPNDesktopNetworkReceiptContext(ctx, r.tun, name, index, mtu)
	if err != nil {
		return "", err
	}
	if err := r.currentNativeContext(ctx); err != nil {
		return "", err
	}
	return raw, ctx.Err()
}
func (owner *RouterVPNDesktopNodePhysical) DesktopNetworkReceipt() (string, error) {
	return owner.DesktopNetworkReceiptContext(context.Background())
}
func (owner *RouterVPNDesktopNodePhysical) DesktopNetworkReceiptContext(ctx context.Context) (string, error) {
	if owner == nil {
		return "", errors.New("Router routing receipt has no original owner")
	}
	if err := desktopnetwork.LockContext(ctx, &owner.mu); err != nil {
		return "", err
	}
	defer owner.mu.Unlock()
	name, index, mtu, err := owner.readbackContext(ctx)
	if err != nil {
		return "", err
	}
	raw, err := routerVPNDesktopNetworkReceiptContext(ctx, owner.reader, name, index, mtu)
	if err != nil {
		return "", err
	}
	if err := owner.generationCurrentContext(ctx); err != nil {
		return "", err
	}
	return raw, ctx.Err()
}
