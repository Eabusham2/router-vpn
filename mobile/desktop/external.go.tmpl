var routerVPNExternalSession = regexp.MustCompile(`^[0-9a-f]{32}$`)
var routerVPNExternalFailure = errors.New("captured desktop external runtime failed; private credentials were not logged")

// Preserve typed constructor causes for ownership decisions without putting
// private parser/configuration text in the command's printable error.
type routerVPNPrivateCommandFailure struct{ public, cause error }

func (e routerVPNPrivateCommandFailure) Error() string { return e.public.Error() }
func (e routerVPNPrivateCommandFailure) Unwrap() error { return e.cause }

func init() { mainCommand.AddCommand(routerVPNNewExternalCommand()) }

func routerVPNNewExternalCommand() *cobra.Command {
	var directory, session, physicalSource, config, transfer, darwin string
	var linux routerVPNNodeLinuxParentOptions
	var journal routerVPNExternalJournalOptions
	command := &cobra.Command{Use: "routervpn-external", Short: "Run one captured Router VPN external session", Args: cobra.NoArgs, SilenceUsage: true,
		RunE: func(_ *cobra.Command, _ []string) error {
			ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
			defer cancel()
			if runtime.GOOS == "linux" {
				ctx = routerVPNRequireStartupEnvironment(ctx, os.Getenv(mobilemultihop.DesktopStartupAdmissionEnvironment))
			}
			return routerVPNRunExternalOwnedCommand(ctx, directory, session, physicalSource, config, transfer, linux, journal, darwin)
		}}
	command.Flags().StringVar(&directory, "runtime-dir", "", "absolute private session directory")
	command.Flags().StringVar(&session, "session", "", "captured session identity")
	command.Flags().StringVar(&physicalSource, "physical-source-sha256", "", "captured desktop physical source identity")
	command.Flags().StringVar(&config, "config-sha256", "", "captured desktop external configuration identity")
	command.Flags().StringVar(&transfer, "physical-transfer-sha256", "", "captured desktop external protection selection")
	command.Flags().StringVar(&darwin, "darwin-control", "", "original inherited Darwin controller")
	command.Flags().IntVar(&linux.ChannelFD, "linux-parent-channel", 0, "original inherited parent channel")
	command.Flags().IntVar(&linux.DirectoryFD, "linux-parent-directory", 0, "original inherited parent directory")
	command.Flags().StringVar(&linux.CaptureSHA256, "linux-parent-capture", "", "original inherited command capture")
	command.Flags().Uint64Var(&journal.ParentHandle, "journal-parent-handle", 0, "inherited original Windows controller handle")
	command.Flags().StringVar(&journal.ParentImage, "journal-parent-image", "", "captured original Windows controller image")
	command.Flags().StringVar(&journal.Pipe, "journal-pipe", "", "captured Windows protection journal channel")
	command.Flags().StringVar(&journal.CaptureSHA256, "journal-capture-sha256", "", "captured Windows protection journal identity")
	routerVPNExternalOwnedFlags(command.Flags())
	return command
}

// A directory handle fixes the session workspace even if its parent pathname
// later changes. Every input and output is a fixed basename; no imported path
// can name a configuration, script, log, socket or another session's file.
type routerVPNExternalFiles struct {
	root  *os.Root
	owned map[string]os.FileInfo
}

func routerVPNOpenExternalFiles(directory string) (*routerVPNExternalFiles, error) {
	if !filepath.IsAbs(directory) || filepath.Clean(directory) != directory {
		return nil, routerVPNExternalFailure
	}
	resolved, err := filepath.EvalSymlinks(directory)
	if err != nil {
		return nil, routerVPNExternalFailure
	}
	info, err := os.Lstat(directory)
	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
		return nil, routerVPNExternalFailure
	}
	// Windows short/long aliases and macOS's system temp-directory alias can
	// name the same owned directory. Compare file identities, not path text.
	canonical, err := os.Lstat(resolved)
	if err != nil || !os.SameFile(info, canonical) || !canonical.IsDir() || canonical.Mode()&os.ModeSymlink != 0 {
		return nil, routerVPNExternalFailure
	}
	root, err := os.OpenRoot(resolved)
	if err != nil {
		return nil, routerVPNExternalFailure
	}
	actual, err := root.Stat(".")
	if err != nil || !os.SameFile(info, actual) {
		_ = root.Close()
		return nil, routerVPNExternalFailure
	}
	return &routerVPNExternalFiles{root: root, owned: map[string]os.FileInfo{}}, nil
}

func (f *routerVPNExternalFiles) read(name string, limit int64) ([]byte, error) {
	info, err := f.root.Lstat(name)
	if err != nil {
		return nil, err
	}
	if !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > limit || runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
		return nil, routerVPNExternalFailure
	}
	file, err := f.root.Open(name)
	if err != nil {
		return nil, routerVPNExternalFailure
	}
	defer file.Close()
	opened, err := file.Stat()
	if err != nil || !os.SameFile(info, opened) {
		return nil, routerVPNExternalFailure
	}
	raw, err := io.ReadAll(io.LimitReader(file, limit+1))
	after, statErr := f.root.Lstat(name)
	if err != nil || statErr != nil || !os.SameFile(opened, after) || int64(len(raw)) != info.Size() || int64(len(raw)) > limit {
		return nil, routerVPNExternalFailure
	}
	return raw, nil
}

func (f *routerVPNExternalFiles) current(name string) bool {
	actual, err := f.root.Lstat(name)
	owned := f.owned[name]
	return owned == nil && errors.Is(err, os.ErrNotExist) || owned != nil && err == nil && actual.Mode().IsRegular() && os.SameFile(owned, actual)
}

func (f *routerVPNExternalFiles) publish(name string, value any) error {
	if !f.current(name) {
		return routerVPNExternalFailure
	}
	raw, err := json.Marshal(value)
	if err != nil || len(raw) > 64<<10 {
		return routerVPNExternalFailure
	}
	temporary := "." + name + ".pending"
	file, err := f.root.OpenFile(temporary, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
	if err != nil {
		return routerVPNExternalFailure
	}
	info, err := file.Stat()
	defer func() {
		if actual, e := f.root.Lstat(temporary); e == nil && info != nil && os.SameFile(info, actual) {
			_ = f.root.Remove(temporary)
		}
	}()
	if err == nil {
		_, err = file.Write(raw)
	}
	if err == nil {
		err = file.Sync()
	}
	closeErr := file.Close()
	if err != nil || closeErr != nil || !f.current(name) {
		return routerVPNExternalFailure
	}
	if err := f.root.Rename(temporary, name); err != nil {
		return routerVPNExternalFailure
	}
	actual, err := f.root.Lstat(name)
	if err != nil || !os.SameFile(info, actual) {
		return routerVPNExternalFailure
	}
	f.owned[name] = actual
	return nil
}

func (f *routerVPNExternalFiles) remove(name string) error {
	if f.owned[name] == nil {
		return nil
	}
	if !f.current(name) || f.root.Remove(name) != nil {
		return routerVPNExternalFailure
	}
	delete(f.owned, name)
	return nil
}

type routerVPNExternalStop struct {
	Schema       int    `json:"schema"`
	Session      string `json:"session_id"`
	SourceSHA256 string `json:"source_sha256"`
}

func (f *routerVPNExternalFiles) stopRequested(session, source string) bool {
	raw, err := f.read("stop.json", 1024)
	if err != nil {
		return false
	}
	object, err := applexray.Object(raw)
	if err != nil || len(object) != 3 {
		return false
	}
	var request routerVPNExternalStop
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.DisallowUnknownFields()
	return decoder.Decode(&request) == nil && request.Schema == 1 && request.Session == session && request.SourceSHA256 == source
}

type routerVPNExternalOwner interface {
	Start() error
	Run() (string, error)
	Cancel()
	Healthy() bool
	VerifyCurrentPath() error
	ProgressJSON() string
	Close() error
}

type routerVPNExternalFactory func(context.Context, *mobilemultihop.ExternalPolicy, *mobilemultihop.DesktopExternalPolicy, string, string, string) (routerVPNExternalOwner, error)

type routerVPNExternalNative struct {
	mu           sync.Mutex
	startup      context.Context
	box          *box.Box
	proof        *box.RouterVPNExternalProofRequest
	physical     *mobilemultihop.DesktopExternalPolicy
	preparation  *box.RouterVPNDesktopExternalPreparation
	cancel       context.CancelFunc
	source       string
	capture      string
	session      string
	boxClosed    bool
	boxCloseFail error
	joined       bool
	partial      []io.Closer
	mtu          *routerVPNDesktopMTU
	dns          *dnsmeasure.Service
	latency      *hopmeasure.Service
}

// Box.New registers each constructed component before constructing the next.
// Retain those exact private managers if construction fails before a Box is
// returned; a parser/startup error must not strand an unacknowledged owner.
func routerVPNExternalConstructed(ctx context.Context) []any {
	return []any{
		service.FromContext[adapter.ServiceManager](ctx),
		service.FromContext[adapter.InboundManager](ctx),
		service.FromContext[adapter.CertificateProviderManager](ctx),
		service.FromContext[adapter.EndpointManager](ctx),
		service.FromContext[adapter.OutboundManager](ctx),
		service.FromContext[adapter.Router](ctx),
		service.FromContext[adapter.ConnectionManager](ctx),
		service.FromContext[adapter.DNSRouter](ctx),
		service.FromContext[adapter.DNSTransportManager](ctx),
		service.FromContext[adapter.NetworkManager](ctx),
		service.FromContext[adapter.HTTPClientManager](ctx),
		service.FromContext[adapter.NetworkNamespaceManager](ctx),
		service.FromContext[adapter.CertificateStore](ctx),
		service.FromContext[log.Factory](ctx),
	}
}

func routerVPNNewExternalNative(ctx context.Context, policy *mobilemultihop.ExternalPolicy, physical *mobilemultihop.DesktopExternalPolicy, source, capture, session string) (routerVPNExternalOwner, error) {
	native, err := routerVPNNewExternalNativeWithPreparation(ctx, policy, physical, source, capture, session, nil)
	if native == nil {
		return nil, err
	}
	return native, err
}

// The retained Linux command supplies only its authenticated, typed physical
// preparation. The complete graph, proof, measurements and close stay here.
func routerVPNNewExternalNativeWithPreparation(ctx context.Context, policy *mobilemultihop.ExternalPolicy, physical *mobilemultihop.DesktopExternalPolicy,
	source, capture, session string, prepare func(*box.Box) error) (*routerVPNExternalNative, error) {
	if policy == nil {
		return nil, routerVPNExternalFailure
	}
	config := policy.Config()
	if physical != nil {
		captured, err := mobilemultihop.NewExternalPolicy(source, capture)
		if err != nil || physical.Validate() != nil || physical.OriginalPolicy() != policy ||
			captured.SourceSHA256() != policy.SourceSHA256() || captured.Config() != policy.Config() ||
			physical.Metadata().SessionID != session || physical.Metadata().TargetOS != runtime.GOOS {
			return nil, routerVPNExternalFailure
		}
		config = physical.Config()
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(config))
	if err != nil {
		return nil, routerVPNExternalFailure
	}
	// Logging is excluded from the shared configuration digest. The command
	// never sends private imported endpoint/credential failures to its parent.
	options.Log = &option.LogOptions{Disabled: true}
	owned, cancel := context.WithCancel(service.ContextWithDefaultRegistry(service.ExtendContext(ctx)))
	for _, previous := range routerVPNExternalConstructed(owned) {
		if previous != nil {
			cancel()
			return nil, routerVPNExternalFailure
		}
	}
	native := &routerVPNExternalNative{startup: routerVPNNativeStartupCaller(ctx), cancel: cancel, physical: physical, source: source, capture: capture, session: session}
	instance, err := box.New(box.Options{Context: owned, Options: options})
	if err != nil {
		for _, partial := range routerVPNExternalConstructed(owned) {
			if closer, ok := partial.(io.Closer); ok {
				native.partial = append(native.partial, closer)
			}
		}
		return native, routerVPNExternalFailure
	}
	native.box = instance
	if physical != nil {
		if prepare == nil {
			prepare = func(instance *box.Box) error {
				owner, err := instance.RouterVPNDesktopExternalPreparePhysicalOwned(physical)
				if owner != nil {
					native.preparation = owner
				}
				return err
			}
		}
		if err := prepare(instance); err != nil {
			return native, routerVPNExternalFailure
		}
	} else if prepare != nil {
		return native, routerVPNExternalFailure
	}
	return native, nil
}

func (n *routerVPNExternalNative) Start() error {
	if n.box == nil {
		return routerVPNExternalFailure
	}
	if runtime.GOOS == "linux" {
		if err := n.box.RouterVPNDesktopStartupContext(n.startup); err != nil {
			return errors.Join(routerVPNExternalFailure, err)
		}
	}
	if err := n.box.RouterVPNStrategyStart(); err != nil {
		return routerVPNExternalFailure
	}
	if err := n.startup.Err(); err != nil {
		return err
	}
	var proof *box.RouterVPNExternalProofRequest
	var err error
	if n.physical != nil {
		proof, err = n.box.RouterVPNDesktopExternalCreateProof(n.physical)
	} else {
		proof, err = n.box.RouterVPNExternalCreateProof(n.source, n.capture, n.session)
	}
	if err != nil {
		return routerVPNExternalFailure
	}
	n.mu.Lock()
	n.proof = proof
	n.mu.Unlock()
	return nil
}
func (n *routerVPNExternalNative) Run() (string, error) {
	n.mu.Lock()
	proof := n.proof
	n.mu.Unlock()
	if proof == nil {
		return "", routerVPNExternalFailure
	}
	return proof.Run()
}
func (n *routerVPNExternalNative) Cancel() {
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.latency != nil {
		n.latency.Invalidate()
	}
	if n.dns != nil {
		n.dns.Invalidate()
	}
	if n.mtu != nil {
		n.mtu.invalidate()
	}
	if n.proof != nil {
		n.proof.Cancel()
	} else {
		// No relay lease exists during native startup. Cancel its context so
		// partial-start teardown can complete without creating a new proof.
		n.cancel()
	}
}
func (n *routerVPNExternalNative) Healthy() bool {
	n.mu.Lock()
	defer n.mu.Unlock()
	return n.proof != nil && n.proof.Healthy()
}
func (n *routerVPNExternalNative) ProgressJSON() string {
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.proof == nil {
		return ""
	}
	return n.proof.ProgressJSON()
}

// Complete native retirement before closing any partial dependency. In
// particular a failed inbound must keep its original network namespace manager
// alive; remembering only that inbound cannot reconstruct the dependency.
func routerVPNClosePartialNativeContext(ctx context.Context, partials []io.Closer) error {
	if ctx == nil {
		return nil
	}
	for _, partial := range partials {
		if closer, ok := partial.(interface{ RouterVPNCloseNativeTunContext(context.Context) error }); ok {
			if err := closer.RouterVPNCloseNativeTunContext(ctx); err != nil {
				return err
			}
		}
	}
	return ctx.Err()
}

func (n *routerVPNExternalNative) Close() error { return n.CloseContext(nil) }
func (n *routerVPNExternalNative) CloseContext(ctx context.Context) error {
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.latency != nil {
		if err := n.latency.Close(); err != nil {
			return routerVPNExternalFailure
		}
	}
	if n.dns != nil {
		if err := n.dns.Close(); err != nil {
			return routerVPNExternalFailure
		}
	}
	if n.mtu != nil {
		if err := n.mtu.close(); err != nil {
			return routerVPNExternalFailure
		}
	}
	if n.box == nil {
		n.cancel()
		if err := routerVPNClosePartialNativeContext(ctx, n.partial); err != nil {
			return err
		}
		pending := n.partial[:0]
		for _, partial := range n.partial {
			if partial.Close() != nil {
				pending = append(pending, partial)
			}
		}
		n.partial = pending
		if len(pending) != 0 {
			return routerVPNExternalFailure
		}
		n.joined = true
		return nil
	}
	if n.proof != nil {
		// Preserve the active Box for authenticated remote lease deletion.
		// Failed deletion retains this owner and is retried by the command.
		if err := n.proof.Close(); err != nil {
			return routerVPNExternalFailure
		}
	}
	if !n.boxClosed {
		if ctx != nil {
			if closer, ok := any(n.box).(interface{ RouterVPNCloseNativeTunContext(context.Context) error }); ok {
				if err := closer.RouterVPNCloseNativeTunContext(ctx); err != nil {
					return err
				}
			}
		}
		n.cancel()
		n.boxCloseFail = n.box.Close()
		n.boxClosed = true
	}
	n.joined = n.boxCloseFail == nil
	return n.boxCloseFail
}

func (n *routerVPNExternalNative) RetainedProtection(ctx context.Context) (*mobiletor.DesktopWindowsProtectionTarget, bool, error) {
	if n == nil || ctx == nil || ctx.Err() != nil {
		return nil, false, routerVPNExternalFailure
	}
	n.mu.Lock()
	joined, preparation := n.joined, n.preparation
	n.mu.Unlock()
	if !joined {
		return nil, false, routerVPNExternalFailure
	}
	if preparation == nil {
		return nil, false, nil
	}
	return preparation.RetainedProtection(ctx)
}

type routerVPNExternalProofRecord struct {
	mobilemultihop.ExternalProofResult
	NetworkReceipt string                                  `json:"network_receipt,omitempty"`
	Physical       *mobilemultihop.DesktopExternalMetadata `json:"desktop_physical,omitempty"`
	Healthy        bool                                    `json:"healthy"`
	HeartbeatAt    int64                                   `json:"heartbeat_at"`
	Progress       mobilemultihop.Progress                 `json:"progress"`
}

type routerVPNExternalProgressRecord struct {
	Schema       int                                     `json:"schema"`
	Session      string                                  `json:"session_id"`
	SourceSHA256 string                                  `json:"source_sha256"`
	ConfigSHA256 string                                  `json:"config_sha256"`
	Stage        string                                  `json:"stage"`
	Progress     mobilemultihop.Progress                 `json:"progress"`
	Physical     *mobilemultihop.DesktopExternalMetadata `json:"desktop_physical,omitempty"`
}

func routerVPNExternalProgress(owner routerVPNExternalOwner) mobilemultihop.Progress {
	var result mobilemultihop.Progress
	if raw := owner.ProgressJSON(); len(raw) <= 64<<10 {
		_ = json.Unmarshal([]byte(raw), &result)
	}
	if result.Failure != "" {
		result.Failure = "captured path verification failed"
	}
	for i := range result.Measurements {
		if result.Measurements[i].Failure != "" {
			result.Measurements[i].Failure = "candidate could not be proved"
		}
	}
	return result
}

// routerVPNRunExternal owns one process/Box/proof, with no reload endpoint. The
// parent replaces the whole session on a network or profile generation change.
// It may report Connected only after matching proof.json and this child owner.
func routerVPNRunExternal(parent context.Context, directory, session, physicalSource string, factory routerVPNExternalFactory) (failure error) {
	return routerVPNRunExternalCaptured(parent, directory, session, physicalSource, "", "", factory, nil)
}

// Protected public Windows commands supply their authenticated journal. The
// private fixture form cannot select the independently guarded public Off path.
func routerVPNRunExternalCaptured(parent context.Context, directory, session, physicalSource, physicalConfig, physicalTransfer string,
	factory routerVPNExternalFactory, journal routerVPNExternalJournal) error {
	return routerVPNRunExternalCapturedPolicy(parent, directory, session, physicalSource, physicalConfig, physicalTransfer, factory, journal, false)
}

func routerVPNRunExternalCapturedPolicy(parent context.Context, directory, session, physicalSource, physicalConfig, physicalTransfer string,
	factory routerVPNExternalFactory, journal routerVPNExternalJournal, unprotected bool) (failure error) {
	if parent == nil || parent.Err() != nil || !routerVPNExternalSession.MatchString(session) || factory == nil {
		return routerVPNExternalFailure
	}
	if unprotected && (journal != nil || physicalSource != "" || physicalConfig != "" || physicalTransfer != "") {
		return routerVPNExternalFailure
	}
	if journal == nil && (physicalConfig != "" || physicalTransfer != "") || journal != nil &&
		(!routerVPNExternalSource.MatchString(physicalSource) || !routerVPNExternalSource.MatchString(physicalConfig) || !routerVPNExternalSource.MatchString(physicalTransfer)) {
		return routerVPNExternalFailure
	}
	files, err := routerVPNOpenExternalFiles(directory)
	if err != nil {
		return routerVPNExternalFailure
	}
	defer files.root.Close()
	if journal != nil {
		if err := journal.authenticate(parent, files); err != nil {
			return err
		}
		if !files.current("external-protection-retired.json") {
			return routerVPNExternalFailure
		}
	}
	for _, name := range []string{"proof.json", "progress.json", "stopped.json", "mtu-status.json", "path-status.json", "dns-status.json", "latency-status.json"} {
		if !files.current(name) {
			return routerVPNExternalFailure
		}
	}
	source, err := files.read("source.json", 4<<20)
	if err != nil {
		return routerVPNExternalFailure
	}
	capture, err := files.read("capture.json", 8<<20)
	if err != nil {
		return routerVPNExternalFailure
	}
	policy, err := mobilemultihop.NewExternalPolicy(string(source), string(capture))
	if err != nil {
		// No native constructor was called. Bind this no-resource acknowledgement
		// to the same raw source/capture identity used by the shared compiler.
		identity, _ := json.Marshal([]string{"routervpn-external-policy-v1", string(source), string(capture)})
		digest := sha256.Sum256(identity)
		if journal == nil && !unprotected {
			_ = files.publish("stopped.json", map[string]any{"schema": 1, "session_id": session, "source_sha256": hex.EncodeToString(digest[:]), "closed": true})
		}
		return routerVPNExternalFailure
	}
	if unprotected && routerVPNExternalUnprotectedPolicy(files, policy) != nil {
		return routerVPNExternalFailure
	}
	configDigest := sha256.Sum256([]byte(policy.Config()))
	configSHA := hex.EncodeToString(configDigest[:])
	var metadata struct {
		ExitID      string `json:"exit_id"`
		EntryID     string `json:"entry_id"`
		EntryNodeID string `json:"entry_node_id"`
		ExpectedIP  string `json:"expected_public_ip"`
		Execution   string `json:"execution"`
	}
	if json.Unmarshal([]byte(policy.Metadata()), &metadata) != nil {
		return routerVPNExternalFailure
	}
	closed := struct {
		routerVPNExternalStop
		Closed bool `json:"closed"`
	}{routerVPNExternalStop{Schema: 1, Session: session, SourceSHA256: policy.SourceSHA256()}, true}
	physical, err := routerVPNExternalCapturedPhysical(parent, files, policy, session, physicalSource)
	if err == nil && journal != nil && (physical == nil || physical.Metadata().TargetOS != "windows" || physical.Metadata().ConfigSHA256 != physicalConfig) {
		err = routerVPNExternalFailure
	}
	if err != nil {
		if journal == nil {
			_ = files.publish("stopped.json", closed)
		}
		return routerVPNExternalFailure
	}
	var protectionTransfer *mobiletor.DesktopProtectionTransferRecord
	if journal != nil {
		protectionTransfer, err = routerVPNExternalCommandTransfer(files, physical, physicalTransfer)
		if err != nil {
			return routerVPNExternalFailure
		}
	}
	retireProtection := func(owner routerVPNExternalOwner) error {
		if journal == nil {
			return nil
		}
		var retained routerVPNExternalProtectionOwner
		if owner != nil {
			var ok bool
			retained, ok = owner.(routerVPNExternalProtectionOwner)
			if !ok {
				return routerVPNExternalFailure
			}
		}
		return routerVPNRetireExternalProtection(files, physical, protectionTransfer, retained, routerVPNReadExternalProtectionExpected)
	}
	measurementSource, measurementConfig := policy.SourceSHA256(), configSHA
	var physicalMetadata *mobilemultihop.DesktopExternalMetadata
	if physical != nil {
		metadata := physical.Metadata()
		physicalMetadata = &metadata
		measurementSource, measurementConfig = metadata.SourceSHA256, metadata.ConfigSHA256
	}
	progress := routerVPNExternalProgressRecord{Schema: 1, Session: session, SourceSHA256: policy.SourceSHA256(), ConfigSHA256: configSHA, Stage: "starting"}
	progress.Physical = physicalMetadata
	if files.publish("progress.json", progress) != nil {
		return routerVPNExternalFailure
	}
	// Parent cancellation is handled by the captured proof first. Canceling the
	// Box context prematurely would prevent it deleting its authenticated lease.
	ctx := globalCtx
	if ctx == nil {
		ctx = context.Background()
	}
	ctx = context.WithoutCancel(ctx)
	var admission *routerVPNExternalAdmission
	if journal != nil {
		ctx, admission, err = journal.prepare(ctx, physical, protectionTransfer)
	} else {
		ctx, admission, err = routerVPNPrepareExternalAdmission(ctx, files, physical)
	}
	if err == nil && journal != nil && (ctx == nil || admission == nil) {
		err = routerVPNExternalFailure
	}
	if err != nil {
		if admission != nil {
			_ = admission.close()
		}
		if journal == nil {
			_ = files.publish("stopped.json", closed)
		}
		return routerVPNExternalFailure
	}
	defer func() {
		if admission.close() != nil {
			failure = routerVPNExternalFailure
		}
	}()
	if parent.Err() != nil || files.stopRequested(session, policy.SourceSHA256()) {
		if admission.close() != nil || retireProtection(nil) != nil {
			progress.Stage = "cleanup-pending"
			_ = files.publish("progress.json", progress)
			return routerVPNExternalFailure
		}
		progress.Stage = "closed"
		_ = files.publish("progress.json", progress)
		return files.publish("stopped.json", closed)
	}
	parent, joinStop := routerVPNWatchCommandStop(parent, files, session, policy.SourceSHA256())
	defer joinStop()
	ctx, startup, stopStartup, bindErr := routerVPNBindStartup(parent, ctx, "external", session, policy.SourceSHA256(), configSHA)
	var owner routerVPNExternalOwner
	factoryErr := bindErr
	if bindErr == nil {
		defer stopStartup()
		owner, factoryErr = factory(ctx, policy, physical, string(source), string(capture), session)
	}
	if owner == nil {
		// Factory errors with partial native ownership must return that owner.
		// A nil owner means native parsing failed before any construction.
		if admission.close() == nil && retireProtection(nil) == nil {
			_ = files.publish("stopped.json", closed)
		} else {
			progress.Stage = "cleanup-pending"
			_ = files.publish("progress.json", progress)
		}
		return routerVPNPrivateCommandFailure{routerVPNExternalFailure, errors.Join(routerVPNExternalFailure, factoryErr)}
	}
	type result struct {
		raw string
		err error
	}
	var completed result
	done := make(chan result, 1)
	go func() {
		if factoryErr != nil {
			done <- result{err: factoryErr}
			return
		}
		if err := owner.Start(); err != nil {
			done <- result{err: err}
			return
		}
		if !admission.admitted() {
			done <- result{err: routerVPNExternalFailure}
			return
		}
		raw, err := owner.Run()
		done <- result{raw: raw, err: err}
	}()
	ticker := time.NewTicker(100 * time.Millisecond)
	defer ticker.Stop()
	finished, connected, stopping := false, false, false
	cleanupJoined := false
	defer func() {
		// An acknowledged explicit Stop is successful only after this exact
		// owner has drained. Expired startup admission remains a failure.
		if !connected && !(cleanupJoined && parent.Err() == context.Canceled && startup.Err() == context.Canceled) {
			failure = errors.Join(failure, startup.Err())
		}
		if factoryErr != nil {
			failure = routerVPNPrivateCommandFailure{routerVPNExternalFailure, errors.Join(routerVPNExternalFailure, failure, factoryErr)}
		}
	}()
	var receipt routerVPNExternalProofRecord
	var heartbeat time.Time
	var mtuFiles *routerVPNDesktopMTUFiles
	var pathFiles *routerVPNDesktopPathFiles
	var dnsFiles *routerVPNDesktopDNSFiles
	var latencyFiles *routerVPNDesktopLatencyFiles
	for !stopping {
		select {
		case outcome := <-done:
			completed = outcome
			finished = true
			if parent.Err() == context.Canceled && startup.Err() == context.Canceled {
				stopping = true
				break
			}
			if outcome.err != nil || startup.Err() != nil || parent.Err() != nil || files.stopRequested(session, policy.SourceSHA256()) || routerVPNExternalHealthyContext(startup, owner) != nil {
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			var result mobilemultihop.ExternalProofResult
			if json.Unmarshal([]byte(outcome.raw), &result) != nil || result.Schema != 1 || result.SessionID != session || result.SourceSHA256 != policy.SourceSHA256() || result.ConfigSHA256 != configSHA || !result.DNSProven ||
				result.IP != metadata.ExpectedIP || result.ExitID != metadata.ExitID || result.EntryID != metadata.EntryID || result.EntryNodeID != metadata.EntryNodeID || result.EntryProven != (metadata.EntryID != "") || result.CheckedAt <= 0 ||
				metadata.Execution != "" && (result.Execution != "local" && result.Execution != "server") || metadata.Execution == "" && result.Execution != "" {
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			heartbeat = time.Now()
			receipt = routerVPNExternalProofRecord{ExternalProofResult: result, Physical: physicalMetadata, Healthy: true, HeartbeatAt: heartbeat.UnixMilli(), Progress: routerVPNExternalProgress(owner)}
			receipt.NetworkReceipt, err = routerVPNDesktopNetworkProjection(startup, owner)
			if err != nil {
				if parent.Err() != nil {
					stopping = true
					break
				}
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			if startup.Err() != nil || files.publish("proof.json", receipt) != nil || startup.Err() != nil {
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			connected, progress.Stage = true, "connected"
			pathFiles, err = routerVPNOpenDesktopPath(files, owner, session, measurementSource, measurementConfig)
			if err != nil {
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			mtuFiles, err = routerVPNOpenDesktopMTUContext(startup, files, owner, session, measurementSource, measurementConfig)
			if err != nil {
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			dnsFiles, err = routerVPNOpenDesktopDNS(files, owner, session, measurementSource, measurementConfig)
			if err != nil {
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			latencyFiles, err = routerVPNOpenDesktopLatency(files, owner, session, measurementSource, measurementConfig, metadata.ExitID)
			if err != nil {
				failure, stopping = routerVPNExternalFailure, true
				break
			}
		case <-parent.Done():
			stopping = true
		case <-ticker.C:
			if !connected && startup.Err() != nil || parent.Err() != nil || files.stopRequested(session, policy.SourceSHA256()) {
				stopping = true
				break
			}
			if connected && routerVPNExternalHealthyContext(parent, owner) != nil {
				if parent.Err() != nil {
					stopping = true
					break
				}
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			if connected && pathFiles != nil {
				if err := pathFiles.tick(); err != nil {
					failure, stopping = routerVPNExternalFailure, true
					break
				}
			}
			if connected && mtuFiles != nil {
				if err := mtuFiles.tickContext(parent); err != nil {
					failure, stopping = routerVPNExternalFailure, true
					break
				}
			}
			if connected && dnsFiles != nil {
				if err := dnsFiles.tick(); err != nil {
					failure, stopping = routerVPNExternalFailure, true
					break
				}
			}
			if connected && latencyFiles.tick() != nil {
				failure, stopping = routerVPNExternalFailure, true
				break
			}
			if !connected {
				progress.Stage = "proving"
			} else if time.Since(heartbeat) >= 500*time.Millisecond {
				heartbeat = time.Now()
				next := receipt
				next.HeartbeatAt, next.Progress = heartbeat.UnixMilli(), routerVPNExternalProgress(owner)
				var observationExpired bool
				next.NetworkReceipt, observationExpired, err = routerVPNDesktopNetworkHeartbeat(parent, owner)
				if observationExpired {
					break
				}
				if err != nil {
					if parent.Err() != nil {
						stopping = true
						break
					}
					failure, stopping = routerVPNExternalFailure, true
					break
				}
				receipt = next
				if files.publish("proof.json", receipt) != nil {
					failure, stopping = routerVPNExternalFailure, true
					break
				}
			}
			progress.Progress = routerVPNExternalProgress(owner)
			if files.publish("progress.json", progress) != nil {
				failure, stopping = routerVPNExternalFailure, true
			}
		}
	}
	owner.Cancel()
	if latencyFiles != nil {
		latencyFiles.service.Invalidate()
	}
	if dnsFiles != nil {
		dnsFiles.service.Invalidate()
	}
	if pathFiles.close() != nil {
		failure = routerVPNExternalFailure
	}
	if files.remove("proof.json") != nil {
		failure = routerVPNExternalFailure
	}
	progress.Stage = "stopping"
	_ = files.publish("progress.json", progress)
	if !finished {
		// Actual proof cancellation is bounded by the shared native request.
		// Retain the process and owner until it joins, even if a host times out.
		completed = <-done
	}
	// Cancellation does not erase an independently returned startup/proof
	// failure. Only a pure original-context cause can acknowledge clean Stop.
	if completed.err != nil && !mobiletor.ObservationContextExpired(parent, completed.err) {
		failure = routerVPNPrivateCommandFailure{routerVPNExternalFailure, errors.Join(routerVPNExternalFailure, failure, completed.err)}
	}
	for dnsFiles != nil && dnsFiles.service.Close() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-ticker.C
	}
	for owner.Close() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-ticker.C
	}
	for latencyFiles != nil && latencyFiles.service.Close() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-ticker.C
	}
	if latencyFiles.close() != nil {
		failure = routerVPNExternalFailure
	}
	if dnsFiles.close() != nil {
		failure = routerVPNExternalFailure
	}
	if admission.close() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		return routerVPNExternalFailure
	}
	if retireProtection(owner) != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		return routerVPNExternalFailure
	}
	progress.Stage, progress.Progress = "closed", mobilemultihop.Progress{}
	_ = files.publish("progress.json", progress)
	if files.publish("stopped.json", closed) != nil {
		return routerVPNExternalFailure
	}
	cleanupJoined = true
	return failure
}

func routerVPNExternalHealthyContext(ctx context.Context, owner routerVPNExternalOwner) error {
	if ctx == nil {
		return routerVPNExternalFailure
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	observed, ok := owner.(interface{ HealthyContext(context.Context) error })
	if !ok {
		return routerVPNExternalFailure
	}
	return observed.HealthyContext(ctx)
}
func (n *routerVPNExternalNative) HealthyContext(ctx context.Context) error {
	if n == nil {
		return routerVPNExternalFailure
	}
	if err := desktopnetwork.LockContext(ctx, &n.mu); err != nil {
		return err
	}
	proof, closed := n.proof, n.boxClosed
	n.mu.Unlock()
	if proof == nil || closed {
		return routerVPNExternalFailure
	}
	return proof.HealthyContext(ctx)
}

// The command owns and joins this watcher before closing its captured root.
// It observes only the original session/source Stop record, so a blocked
// receipt or health read remains interruptible without revoking another owner.
func routerVPNWatchCommandStop(parent context.Context, files *routerVPNExternalFiles, session, source string) (context.Context, func()) {
	ctx, cancel := context.WithCancel(parent)
	done := make(chan struct{})
	go func() {
		defer close(done)
		ticker := time.NewTicker(100 * time.Millisecond)
		defer ticker.Stop()
		for {
			if ctx.Err() != nil || files.stopRequested(session, source) {
				cancel()
				return
			}
			select {
			case <-ctx.Done():
				return
			case <-ticker.C:
			}
		}
	}()
	return ctx, func() { cancel(); <-done }
}
