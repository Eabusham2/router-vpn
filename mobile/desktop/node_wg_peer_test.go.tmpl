// WG and AWG share only fixed destinations, exact physical binding and the
// owned control pipe. Each constructor retains its separate real cipher.
type desktopNodeUDPReferenceDevice struct {
	close    func()
	readback func() (string, error)
}
type desktopNodeUDPReferenceFactory func(context.Context, wg.Device, *desktopNodeWGBind, string) (desktopNodeUDPReferenceDevice, error)

func startDesktopNodeWGReferenceDevice(ctx context.Context, stack wg.Device, bind *desktopNodeWGBind, ipc string) (desktopNodeUDPReferenceDevice, error) {
	device := wgdevice.NewDevice(ctx, stack, bind, &wgdevice.Logger{Verbosef: func(string, ...any) {}, Errorf: func(string, ...any) {}}, 0)
	stack.SetDevice(device)
	err := device.IpcSet(ipc)
	if err == nil {
		err = stack.Start()
	}
	if err == nil {
		err = device.Up()
	}
	if err != nil {
		device.Close()
		return desktopNodeUDPReferenceDevice{}, err
	}
	return desktopNodeUDPReferenceDevice{close: device.Close}, nil
}

func runDesktopNodeUDPReferenceProcess(t *testing.T, reader *bufio.Reader, request desktopNodeWGRequest,
	local, remote netip.Addr, ipc string, start desktopNodeUDPReferenceFactory) {
	t.Helper()
	runDesktopNodeUDPReferenceWithLayer(t, reader, request, local, remote, ipc, start, nil)
}

func runDesktopNodeUDPReferenceWithLayer(t *testing.T, reader *bufio.Reader, request desktopNodeWGRequest,
	local, remote netip.Addr, ipc string, start desktopNodeUDPReferenceFactory, layer *desktopNodeWGLayerCapture) {
	t.Helper()
	if layer != nil && (layer.request != request || layer.physicalClient != remote || layer.relaySource != local ||
		layer.layer != "aes-256-gcm" && layer.layer != "aes-256-gcm+xor-whitening") {
		t.Fatal("WireGuard layer lost its separate original source owners")
	}
	interfaces, err := net.Interfaces()
	found := false
	for _, iface := range interfaces {
		addresses, readErr := iface.Addrs()
		if readErr != nil {
			t.Fatal(readErr)
		}
		for _, address := range addresses {
			prefix, e := netip.ParsePrefix(address.String())
			found = found || e == nil && prefix.Addr() == local && iface.Flags&net.FlagUp != 0 && iface.Flags&net.FlagLoopback == 0
		}
	}
	if err != nil || !found {
		t.Fatal("WireGuard reference has no original private interface", err)
	}
	var failedDNS atomic.Bool
	var dnsQueries atomic.Uint32
	dnsListener, err := net.ListenPacket("udp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	dnsServer := &dns.Server{PacketConn: dnsListener, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
		dnsQueries.Add(1)
		answer := new(dns.Msg).SetReply(q)
		if len(q.Question) != 1 || q.Question[0].Name != "example.com." || q.Question[0].Qtype != dns.TypeA {
			answer.Rcode = dns.RcodeRefused
		} else if failedDNS.Load() {
			answer.Rcode = dns.RcodeNameError
		} else {
			answer.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: "example.com.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 300}, A: net.ParseIP("93.184.216.34")}}
		}
		_ = w.WriteMsg(answer)
	})}
	dnsJoined := make(chan error, 1)
	go func() { dnsJoined <- dnsServer.ActivateAndServe() }()
	t.Cleanup(func() {
		_ = dnsServer.Shutdown()
		_ = dnsListener.Close()
		if err := <-dnsJoined; err != nil {
			t.Error(err)
		}
	})
	health := desktopNodeWGHealth(t, request.NodeProofID)
	var direct *desktopNodeRouterHealth
	if request.DirectRouter {
		direct = startDesktopNodeRouterHealth(t, netip.MustParseAddr("10.77.0.1"), request.NodeProofID)
	}
	rules := map[string]desktopReferenceRule{}
	for _, rule := range []desktopReferenceRule{
		{Network: "udp", Address: "192.168.50.133", Port: 53, Target: dnsListener.LocalAddr().String()},
		{Network: "tcp", Address: "10.77.0.1", Port: 8787, Target: health.address()},
		{Network: "tcp", Address: "192.0.2.99", Port: 9999}, {Network: "udp", Address: "192.0.2.99", Port: 9999},
		{Network: "tcp", Address: "2001:db8::99", Port: 9999}, {Network: "udp", Address: "2001:db8::99", Port: 9999},
	} {
		rules[rule.Network+"/"+net.JoinHostPort(rule.Address, fmt.Sprint(rule.Port))] = rule
	}
	ctx, cancel := context.WithCancel(context.Background())
	handler := &desktopNodeWGHandler{desktopReferenceHandler: &desktopReferenceHandler{ctx: ctx, cancel: cancel, rules: rules, owned: map[io.Closer]bool{}}}
	if request.Cover {
		handler.cover = &desktopNodeRouterCover{}
		rules["udp/"+desktopNodeRouterCoverTarget] = desktopReferenceRule{Network: "udp", Address: "10.77.0.1", Port: 45999}
	}
	stack, err := wg.NewDevice(wg.DeviceOptions{Context: ctx, Logger: log.NewNOPFactory().Logger(), Handler: handler, UDPTimeout: 30 * time.Second, ICMPTimeout: time.Second, MTU: 1400, Address: []netip.Prefix{netip.MustParsePrefix("10.78.0.1/32"), netip.MustParsePrefix("fd78:78::1/128")}})
	if err != nil {
		cancel()
		t.Fatal(err)
	}
	immediate := remote
	if layer != nil {
		immediate = layer.relaySource
	}
	bind := &desktopNodeWGBind{local: local, remote: immediate}
	device, err := start(ctx, stack, bind, ipc)
	t.Cleanup(func() {
		handler.close()
		if device.close != nil {
			device.close()
		}
	})
	if err != nil {
		t.Fatal("UDP reference rejected its exact native device source", err)
	}
	ipc = ""
	request.PrivateKey = ""
	request.PreSharedKey = ""
	address := bind.address()
	if address == "" {
		t.Fatal("WireGuard reference lost its UDP listener")
	}
	baseAddress, aesAddress := address, ""
	var outer *desktopNodeLayerServer
	if layer != nil {
		base := netip.MustParseAddrPort(baseAddress)
		inner := netip.AddrPortFrom(netip.MustParseAddr("10.77.0.1"), base.Port()).String()
		outer = startDesktopNodeLayerRoutedServer(t, local, layer.aesPassword, []desktopNodeLayerRoute{{Network: "udp", Destination: inner, Physical: baseAddress}}, "")
		aesAddress = outer.udp.LocalAddr().String()
		address = aesAddress
		if layer.layer == "aes-256-gcm+xor-whitening" {
			password := layer.aesPassword
			if layer.whiteningMismatch {
				key, err := base64.StdEncoding.Strict().DecodeString(password)
				if err != nil || len(key) != 32 {
					t.Fatal("WireGuard whitening control lost its captured independent key")
				}
				key[0] ^= 0xff
				password = base64.StdEncoding.EncodeToString(key)
				clear(key)
			}
			address = startDesktopNodeLayerRelay(t, local, aesAddress, password)
		}
	}
	respond := func() {
		reply := desktopNodeLayerReply{Schema: 1, Address: address, BaseAddress: baseAddress, ProbeNetwork: "udp", RawUDP: bind.packets.Load(), PlainTCP: handler.tcp.Load(), PlainUDP: handler.udp.Load(), DNSQueries: dnsQueries.Load(), RouterQueries: health.count(), DirectQueries: direct.count()}
		if layer != nil {
			reply.AESAddress = aesAddress
			reply.PhysicalClientAddress, reply.RelaySourceAddress = layer.physicalClient.String(), layer.relaySource.String()
			reply.ProtocolRawUDP, reply.ProtocolTCP, reply.ProtocolUDP = reply.RawUDP, reply.PlainTCP, reply.PlainUDP
			reply.RawTCP, reply.RawUDP, reply.PlainTCP, reply.PlainUDP = outer.rawTCP.Load(), outer.rawUDP.Load(), outer.plainTCP.Load(), outer.plainUDP.Load()
			reply.RejectedUDP = outer.rejectedUDP.Load()
		}
		if handler.cover != nil {
			handler.cover.observe(&reply)
		}
		if device.readback != nil {
			var err error
			reply.ParametersSHA256, err = device.readback()
			if err != nil {
				t.Fatal("UDP reference changed its captured native parameters", err)
			}
		}
		if json.NewEncoder(os.Stdout).Encode(reply) != nil {
			t.Fatal("WireGuard reference lost its captured reply pipe")
		}
	}
	respond()
	for {
		line, err := reader.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 32 {
			t.Fatal("WireGuard reference control was replaced", err)
		}
		switch strings.TrimSuffix(string(line), "\n") {
		case "stats":
		case "fail-dns":
			failedDNS.Store(true)
		case "restore-dns":
			failedDNS.Store(false)
		case "wrong-node":
			health.wrongNode.Store(true)
		case "restore-node":
			health.wrongNode.Store(false)
		case "drop-cover":
			if handler.cover == nil {
				t.Fatal("WireGuard reference received uncaptured cover")
			}
			handler.cover.stopReplies()
		default:
			t.Fatal("WireGuard reference received another control operation")
		}
		respond()
	}
}

func desktopNodeWGReference(t *testing.T) *desktopNodeLayerReference {
	t.Helper()
	return desktopNodeWGReferenceWithOptions(t, desktopNodeWGReferenceOptions{})
}

type desktopNodeWGReferenceOptions struct {
	Layer                    string
	Cover, WhiteningMismatch bool
}

func desktopNodeWGReferenceWithOptions(t *testing.T, capture desktopNodeWGReferenceOptions) *desktopNodeLayerReference {
	t.Helper()
	if capture.Layer != "" && capture.Layer != "aes-256-gcm" && capture.Layer != "aes-256-gcm+xor-whitening" || capture.WhiteningMismatch && capture.Layer != "aes-256-gcm+xor-whitening" {
		t.Fatal("WireGuard reference changed its exact selected layer")
	}
	_, ip := desktopNodePeerInterface(t)
	config, options := desktopReferenceFixture(t)
	digest := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + options.Peers[0].PublicKey))
	request := desktopNodeWGRequest{Schema: 1, Address: ip.String(), ClientAddress: ip.String(), PrivateKey: config.PrivateKey,
		ClientPublicKey: config.Peers[0].PublicKey, PreSharedKey: config.Peers[0].PreSharedKey, NodeProofID: hex.EncodeToString(digest[:]), Cover: capture.Cover}
	var layerKey [32]byte
	password := ""
	if capture.Layer != "" {
		if _, err := rand.Read(layerKey[:]); err != nil {
			t.Fatal(err)
		}
		password = base64.StdEncoding.EncodeToString(layerKey[:])
		clear(layerKey[:])
	}
	executable, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 65*time.Second)
	p := &desktopNodeLayerReference{ctx: ctx, cancel: cancel, options: options, done: make(chan error, 1),
		request: desktopNodeLayerRequest{Schema: 1, Mode: "wg", Address: ip.String(), NodeProofID: request.NodeProofID, Configuration: config, Layer: capture.Layer, Password: password, Cover: capture.Cover, WhiteningMismatch: capture.WhiteningMismatch}}
	selector, childOwner := "TestRouterVPNDesktopNodeWireGuardReferenceProcess", "ROUTERVPN_NODE_WG_REFERENCE_CHILD=1"
	var input any = request
	if capture.Layer != "" {
		selector, childOwner = "TestRouterVPNDesktopNodeWireGuardLayerReferenceProcess", "ROUTERVPN_NODE_WG_LAYER_REFERENCE_CHILD=1"
		input = desktopNodeWGLayerRequest{desktopNodeWGRequest: request, Layer: capture.Layer, AESPassword: password, RelaySource: ip.String(), WhiteningMismatch: capture.WhiteningMismatch}
	}
	p.command = exec.CommandContext(ctx, executable, "-test.run=^"+selector+"$", "-test.count=1", "-test.timeout=60s")
	p.command.Env = append(os.Environ(), childOwner)
	p.input, err = p.command.StdinPipe()
	if err != nil {
		cancel()
		t.Fatal(err)
	}
	var writer *os.File
	p.output, writer, err = os.Pipe()
	if err != nil {
		cancel()
		_ = p.input.Close()
		t.Fatal(err)
	}
	p.reader = bufio.NewReaderSize(p.output, (64<<10)+1)
	p.command.Stdout, p.command.Stderr = writer, &p.diagnostic
	if err := p.command.Start(); err != nil {
		cancel()
		_ = p.input.Close()
		_ = p.output.Close()
		_ = writer.Close()
		t.Fatal(err)
	}
	_ = writer.Close()
	go func() { p.done <- p.command.Wait() }()
	t.Cleanup(func() {
		_ = p.input.Close()
		select {
		case err := <-p.done:
			if err != nil {
				t.Error("independent WireGuard peer failed", err, p.diagnostic.String())
			}
		case <-time.After(5 * time.Second):
			cancel()
			<-p.done
			t.Error("independent WireGuard peer did not join its owned control pipe", p.diagnostic.String())
		}
		cancel()
		_ = p.output.Close()
	})
	if err := json.NewEncoder(p.input).Encode(input); err != nil {
		t.Fatal(err)
	}
	p.reply, err = p.read()
	p.remote, _ = netip.ParseAddrPort(p.reply.Address)
	if err != nil || p.remote.Addr() != ip || p.remote.Port() == 0 || p.reply.ProbeNetwork != "udp" || p.reply.RawTCP != 0 {
		t.Fatal("independent WireGuard peer did not retain its original UDP socket", err, p.diagnostic.String())
	}
	if capture.Layer == "" {
		if p.reply.BaseAddress != p.reply.Address || p.reply.AESAddress != "" || p.reply.PhysicalClientAddress != "" || p.reply.RelaySourceAddress != "" {
			t.Fatal("plain WireGuard acquired another reference owner")
		}
	} else {
		base, baseErr := netip.ParseAddrPort(p.reply.BaseAddress)
		aes, aesErr := netip.ParseAddrPort(p.reply.AESAddress)
		if baseErr != nil || aesErr != nil || base.Addr() != ip || base.Port() == 0 || aes.Addr() != ip || aes.Port() == 0 || base == aes || base == p.remote ||
			capture.Layer == "aes-256-gcm" && aes != p.remote || capture.Layer == "aes-256-gcm+xor-whitening" && (p.remote.Port() != 8389 || aes == p.remote) ||
			p.reply.PhysicalClientAddress != request.ClientAddress || p.reply.RelaySourceAddress != request.Address {
			t.Fatal("layered WireGuard changed original physical client, inner relay or encrypted endpoint")
		}
	}
	return p
}

func TestRouterVPNDesktopNodeEncryptedPlainWireGuard(t *testing.T) {
	for _, fault := range []string{"proved", "wrong-peer", "wrong-psk"} {
		t.Run(fault, func(t *testing.T) { testDesktopNodeEncryptedUDP(t, desktopNodeWGReference(t), fault) })
	}
}

func testDesktopNodeEncryptedUDP(t *testing.T, peer *desktopNodeLayerReference, fault string) {
	t.Helper()
	fixtureFault := ""
	if fault == "wrong-peer" {
		fixtureFault = "base-key"
	}
	if fault == "wrong-aes" {
		fixtureFault = "aes-key"
	}
	if fault == "wrong-header" {
		peer.request.Configuration.Parameters["h1"] = "50000000-59999999"
	}
	if fault == "wrong-padding" {
		peer.request.Configuration.Parameters["s1"] = "57"
	}
	if fault == "wrong-psk" {
		peer.options.Peers[0].PreSharedKey = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x24}, 32))
	}
	f := newDesktopNodeLayerFixture(t, peer, fixtureFault)
	input, err := f.policy.OriginalProfile().LaunchInput()
	var source struct {
		Profile string `json:"profile_json"`
	}
	var captured struct {
		API    string `json:"router_api"`
		NodeID string `json:"node_proof_id"`
	}
	if err != nil || json.Unmarshal([]byte(input), &source) != nil || json.Unmarshal([]byte(source.Profile), &captured) != nil ||
		captured.API != "http://"+desktopNodeRouterHealthTarget || (captured.NodeID == peer.request.NodeProofID) != (fault != "wrong-peer") {
		t.Fatal("WG/AWG reference source lost its exact routed API or key-derived proof identity", err)
	}
	f.tun.beforeStart = func() error {
		deadline := time.NewTimer(5 * time.Second)
		defer deadline.Stop()
		tick := time.NewTicker(5 * time.Millisecond)
		defer tick.Stop()
		for {
			f.kernel.mu.Lock()
			observed := f.kernel.preTUN > 0
			f.kernel.mu.Unlock()
			if observed {
				return nil
			}
			select {
			case <-tick.C:
			case <-deadline.C:
				return errors.New("WG/AWG did not enter its captured eager socket owner before TUN startup")
			}
		}
	}
	if err := f.box.RouterVPNStrategyStart(); err != nil {
		t.Fatal("actual WG/AWG Box startup failed", err)
	}
	if fault != "proved" {
		if err := f.exchange("udp"); err == nil {
			t.Fatal("wrong WG/AWG credential delivered decrypted traffic")
		}
		actual := peer.observe(t, "stats")
		payloadTCP, payloadUDP := actual.PlainTCP, actual.PlainUDP
		if peer.request.Layer != "" {
			payloadTCP, payloadUDP = actual.ProtocolTCP, actual.ProtocolUDP
			if (fault == "wrong-peer" || fault == "wrong-psk") && actual.ProtocolRawUDP == 0 ||
				(fault == "wrong-aes" || fault == "wrong-whitening") && (actual.ProtocolRawUDP != 0 || actual.PlainUDP != 0) {
				t.Fatal("layered WG credential negative reached the wrong protocol boundary", actual)
			}
		}
		if actual.RawUDP == 0 || actual.RawTCP != 0 || payloadTCP != 0 || payloadUDP != 0 || actual.DNSQueries != 0 || actual.RouterQueries != 0 || f.network.Current() {
			t.Fatal("WG/AWG credential control missed the actual peer or fabricated a response", actual)
		}
		return
	}
	if peer.request.Layer != "" {
		capture, err := f.policy.Capture()
		kind := "shadowsocks"
		if peer.request.Layer == "aes-256-gcm+xor-whitening" {
			kind = "routervpn-aes-xor"
		}
		if err != nil || len(capture.PhysicalRoots) != 1 || capture.PhysicalRoots[0].Type != kind || len(capture.PhysicalRoots[0].Destinations) != 1 ||
			capture.PhysicalRoots[0].Destinations[0] != (mobilemultihop.PhysicalEgress{Host: peer.remote.Addr().String(), Port: int(peer.remote.Port()), Network: "udp"}) ||
			capture.SelectedDNS.Host != "192.168.50.133" || capture.SelectedDNS.Physical || capture.SelectedDNS.Detour != "proxy" || capture.ConfiguredMTU != 1280 || capture.KillSwitchPolicy != "always" {
			t.Fatal("layered WG changed exact outer UDP, selected DNS, MTU or protection", err)
		}
	}
	for _, network := range []string{"tcp", "udp"} {
		for _, host := range []string{"192.0.2.99", "2001:db8::99"} {
			if err := f.exchange(network, host); err != nil {
				t.Fatal("WG/AWG did not carry actual IPv4/IPv6 payload", network, host, err)
			}
		}
	}
	for _, action := range []string{"restore-dns", "fail-dns", "restore-dns"} {
		before := peer.observe(t, action)
		err := f.box.RouterVPNStrategyDNSProof()
		after := peer.observe(t, "stats")
		// The final WG UDP counter counts owned flows; repeated DNS queries
		// deliberately reuse that flow. Fresh query and encrypted-packet
		// receipts, rather than a newly created socket, prove each retest.
		if (err == nil) == (action == "fail-dns") || after.DNSQueries != before.DNSQueries+1 || after.RawUDP <= before.RawUDP || after.RawTCP != 0 || peer.request.Layer != "" && (after.ProtocolRawUDP <= before.ProtocolRawUDP || after.ProtocolUDP == 0) {
			t.Fatal("WG/AWG selected DNS escaped the encrypted peer or reused a stale answer", action, err, before, after)
		}
	}
	outer, found := f.box.Outbound().Outbound("proxy")
	if !found {
		t.Fatal("WG/AWG lost its exact native outbound")
	}
	for _, action := range []string{"restore-node", "wrong-node", "restore-node"} {
		before := peer.observe(t, action)
		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
		transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
			if network != "tcp" || address != desktopNodeRouterHealthTarget {
				return nil, errors.New("WG/AWG Router proof changed its original routed destination")
			}
			return outer.DialContext(ctx, network, M.ParseSocksaddr(address))
		}}
		client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("WG/AWG proof cannot redirect") }}
		request, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://"+desktopNodeRouterHealthTarget+"/health", nil)
		if err != nil {
			cancel()
			t.Fatal(err)
		}
		response, err := client.Do(request)
		if err != nil {
			cancel()
			transport.CloseIdleConnections()
			t.Fatal("WG/AWG Router response did not traverse actual encryption", err)
		}
		body, readErr := io.ReadAll(io.LimitReader(response.Body, 1025))
		closeErr := response.Body.Close()
		transport.CloseIdleConnections()
		cancel()
		var result struct {
			OK     bool   `json:"ok"`
			NodeID string `json:"node_id"`
			Proof  string `json:"proof"`
		}
		after := peer.observe(t, "stats")
		payloadTCP := after.PlainTCP == before.PlainTCP+1
		if peer.request.Layer != "" {
			payloadTCP = after.ProtocolTCP == before.ProtocolTCP+1 && after.ProtocolRawUDP > before.ProtocolRawUDP
		}
		if readErr != nil || closeErr != nil || len(body) > 1024 || response.StatusCode != http.StatusOK || json.Unmarshal(body, &result) != nil || !result.OK || result.Proof != "router-vpn-private-agent-v1" ||
			(result.NodeID == peer.request.NodeProofID) == (action == "wrong-node") || after.RouterQueries != before.RouterQueries+1 || after.DirectQueries != 0 || after.RawTCP != 0 || after.RawUDP <= before.RawUDP || !payloadTCP {
			t.Fatal("WG/AWG routed proof lost its independent captured identity or encrypted counters", action, readErr, closeErr, before, after)
		}
	}
	f.kernel.mu.Lock()
	requests, early := f.kernel.requests, f.kernel.preTUN
	for _, grant := range f.kernel.grants {
		if grant.Remote != peer.remote || grant.Network != "udp" {
			f.kernel.mu.Unlock()
			t.Fatal("WG/AWG acquired another protocol or physical endpoint")
		}
	}
	f.kernel.mu.Unlock()
	if requests == 0 || early == 0 || f.network.Current() {
		t.Fatal("WG/AWG bypassed captured eager physical ownership or fabricated native readiness")
	}
	f.network.InterfaceUpdated(context.Background())
	before := peer.observe(t, "stats")
	if f.network.SocketCurrent() || f.kernel.live.Load() || f.exchange("udp") == nil || f.box.RouterVPNStrategyDNSProof() == nil {
		t.Fatal("retired WG/AWG owner opened replacement encrypted traffic")
	}
	if err := f.close(); err != nil || !f.source.closed.Load() {
		t.Fatal("WG/AWG close did not join its original physical source", err)
	}
	after := peer.observe(t, "stats")
	payloadStable := after.PlainTCP == before.PlainTCP && after.PlainUDP == before.PlainUDP
	if peer.request.Layer != "" {
		payloadStable = after.ProtocolTCP == before.ProtocolTCP && after.ProtocolUDP == before.ProtocolUDP
	}
	if after.DNSQueries != before.DNSQueries || after.RouterQueries != before.RouterQueries || !payloadStable {
		t.Fatal("retired WG/AWG generation delivered decrypted traffic", before, after)
	}
}

func TestRouterVPNDesktopNodeWireGuardLayers(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		for _, fault := range []string{"proved", "wrong-peer", "wrong-psk", "wrong-aes", "wrong-whitening"} {
			if fault == "wrong-whitening" && layer != "aes-256-gcm+xor-whitening" {
