// This is a test-only independent WireGuard peer. It has one captured physical
// client, one cryptographic peer and fixed inner DNS/health/echo destinations.
// The application cannot launch it or supply an arbitrary forwarding rule.
type desktopNodeWGRequest struct {
	Schema          int    `json:"schema"`
	Address         string `json:"address"`
	ClientAddress   string `json:"client_address"`
	PrivateKey      string `json:"private_key"`
	ClientPublicKey string `json:"client_public_key"`
	PreSharedKey    string `json:"pre_shared_key"`
	NodeProofID     string `json:"node_proof_id"`
	DirectRouter    bool   `json:"direct_router"`
	Cover           bool   `json:"cover"`
}

func desktopNodeWGRequestIdentity(request desktopNodeWGRequest) (netip.Addr, netip.Addr, string, error) {
	bad := errors.New("WireGuard reference requires its exact captured physical and cryptographic peers")
	local, localErr := netip.ParseAddr(request.Address)
	remote, remoteErr := netip.ParseAddr(request.ClientAddress)
	if request.Schema != 1 || localErr != nil || remoteErr != nil || !local.Is4() || !remote.Is4() ||
		!local.IsPrivate() || !remote.IsPrivate() || local.String() != request.Address || remote.String() != request.ClientAddress ||
		local != remote && (local.String() != "192.168.210.2" || remote.String() != "192.168.210.1") {
		return netip.Addr{}, netip.Addr{}, "", bad
	}
	var values [3][]byte
	for index, value := range []string{request.PrivateKey, request.ClientPublicKey, request.PreSharedKey} {
		raw, err := base64.StdEncoding.Strict().DecodeString(value)
		if err != nil || len(raw) != 32 || base64.StdEncoding.EncodeToString(raw) != value || bytes.Equal(raw, make([]byte, 32)) {
			clear(raw)
			for _, previous := range values {
				clear(previous)
			}
			return netip.Addr{}, netip.Addr{}, "", bad
		}
		values[index] = raw
	}
	defer func() {
		for _, value := range values {
			clear(value)
		}
	}()
	private, err := ecdh.X25519().NewPrivateKey(values[0])
	if err != nil {
		return netip.Addr{}, netip.Addr{}, "", bad
	}
	public := base64.StdEncoding.EncodeToString(private.PublicKey().Bytes())
	identity := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + public))
	if request.NodeProofID != hex.EncodeToString(identity[:]) || public == request.ClientPublicKey {
		return netip.Addr{}, netip.Addr{}, "", bad
	}
	ipc := fmt.Sprintf("private_key=%x\npublic_key=%x\npreshared_key=%x\nallowed_ip=10.78.0.2/32\nallowed_ip=fd78:78::2/128\n", values[0], values[1], values[2])
	return local, remote, ipc, nil
}

type desktopNodeWGBind struct {
	mu            sync.Mutex
	local, remote netip.Addr
	connection    *net.UDPConn
	packets       atomic.Int64
}

func (b *desktopNodeWGBind) Open(port uint16) ([]wgconn.ReceiveFunc, uint16, error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.connection != nil || port != 0 {
		return nil, 0, errors.New("WireGuard reference attempted to replace its original UDP listener")
	}
	connection, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.AddrPortFrom(b.local, 0)))
	if err != nil {
		return nil, 0, err
	}
	b.connection = connection
	read := func(packets [][]byte, sizes []int, endpoints []wgconn.Endpoint) (int, error) {
		for {
			n, remote, err := connection.ReadFromUDPAddrPort(packets[0])
			if err != nil {
				return 0, err
			}
			if remote.Addr() != b.remote {
				continue
			}
			b.packets.Add(1)
			sizes[0], endpoints[0] = n, peerEndpoint(remote)
			return 1, nil
		}
	}
	return []wgconn.ReceiveFunc{read}, uint16(connection.LocalAddr().(*net.UDPAddr).Port), nil
}
func (b *desktopNodeWGBind) Close() error {
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.connection == nil {
		return nil
	}
	err := b.connection.Close()
	b.connection = nil
	return err
}
func (b *desktopNodeWGBind) Send(packets [][]byte, endpoint wgconn.Endpoint, offset int) error {
	remote, err := netip.ParseAddrPort(endpoint.DstToString())
	if err != nil || remote.Addr() != b.remote || remote.Port() == 0 {
		return errors.New("WireGuard reference tried another physical peer")
	}
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.connection == nil {
		return net.ErrClosed
	}
	for _, packet := range packets {
		if offset < 0 || offset > len(packet) {
			return errors.New("WireGuard reference lost its exact packet offset")
		}
		n, err := b.connection.WriteToUDPAddrPort(packet[offset:], remote)
		if err != nil {
			return err
		}
		if n != len(packet)-offset {
			return io.ErrShortWrite
		}
	}
	return nil
}
func (*desktopNodeWGBind) SetMark(mark uint32) error {
	if mark != 0 {
		return errors.New("WireGuard reference cannot acquire a routing mark")
	}
	return nil
}
func (*desktopNodeWGBind) BatchSize() int { return 1 }
func (b *desktopNodeWGBind) ParseEndpoint(value string) (wgconn.Endpoint, error) {
	remote, err := netip.ParseAddrPort(value)
	if err != nil || remote.Addr() != b.remote || remote.Port() == 0 {
		return nil, errors.New("WireGuard reference lost its one remote endpoint")
	}
	return peerEndpoint(remote), nil
}
func (*desktopNodeWGBind) SetReservedForEndpoint(_ netip.AddrPort, reserved [3]byte) {
	if reserved != [3]byte{} {
		panic("plain WireGuard reference has no reserved-byte policy")
	}
}
func (b *desktopNodeWGBind) address() string {
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.connection == nil {
		return ""
	}
	return b.connection.LocalAddr().String()
}

type desktopNodeWGHandler struct {
	*desktopReferenceHandler
	tcp, udp atomic.Int64
	cover    *desktopNodeRouterCover
}

func (h *desktopNodeWGHandler) NewConnectionEx(ctx context.Context, c net.Conn, source, destination M.Socksaddr, done N.CloseHandlerFunc) {
	if _, ok := h.rule("tcp", destination); ok {
		h.tcp.Add(1)
	}
	h.desktopReferenceHandler.NewConnectionEx(ctx, c, source, destination, done)
}
func (h *desktopNodeWGHandler) NewPacketConnectionEx(ctx context.Context, c N.PacketConn, source, destination M.Socksaddr, done N.CloseHandlerFunc) {
	if _, ok := h.rule("udp", destination); ok {
		h.udp.Add(1)
	}
	if destination.String() != desktopNodeRouterCoverTarget || h.cover == nil {
		h.desktopReferenceHandler.NewPacketConnectionEx(ctx, c, source, destination, done)
		return
	}
	if !h.adopt(c, true) {
		if done != nil {
			done(net.ErrClosed)
		}
		return
	}
	go func() {
		defer h.workers.Done()
		defer h.forget(c)
		err := h.cover.exchange(c, destination)
		if done != nil {
			done(err)
		}
	}()
}

func desktopNodeWGHealth(t *testing.T, nodeID string) *desktopNodeRouterHealth {
	t.Helper()
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	health := &desktopNodeRouterHealth{physical: listener.Addr().String()}
	server := &http.Server{ReadHeaderTimeout: 2 * time.Second, ReadTimeout: 2 * time.Second, WriteTimeout: 2 * time.Second, IdleTimeout: time.Second, MaxHeaderBytes: 8 << 10,
		Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if r.Method != http.MethodGet || r.URL.Path != "/health" || r.URL.RawQuery != "" || r.Host != desktopNodeRouterHealthTarget || r.ContentLength != 0 || len(r.TransferEncoding) != 0 {
				http.Error(w, "uncaptured Router health request", http.StatusNotFound)
				return
			}
			health.queries.Add(1)
			identity := nodeID
			if health.wrongNode.Load() {
				first := "0"
				if identity[0] == '0' {
					first = "1"
				}
				identity = first + identity[1:]
			}
			w.Header().Set("Content-Type", "application/json")
			_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "node_id": identity, "proof": "router-vpn-private-agent-v1"})
		})}
	joined := make(chan error, 1)
	go func() { joined <- server.Serve(listener) }()
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
		defer cancel()
		if err := server.Shutdown(ctx); err != nil {
			_ = server.Close()
			t.Error(err)
		}
		_ = listener.Close()
		if err := <-joined; !errors.Is(err, http.ErrServerClosed) {
			t.Error(err)
		}
	})
	return health
}

// The control pipe binds every observation and fault to this original peer.
// No HTTP response, packet success, DNS answer or count is supplied to the
// client; those values are produced by real authenticated native exchanges.
func TestRouterVPNDesktopNodeWireGuardReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NODE_WG_REFERENCE_CHILD") == "" {
		return
	}
	if os.Getenv("ROUTERVPN_NODE_WG_REFERENCE_CHILD") != "1" {
		t.Fatal("WireGuard reference has an unrelated owner")
	}
	reader := bufio.NewReaderSize(os.Stdin, (64<<10)+1)
	line, err := reader.ReadSlice('\n')
	if err != nil || len(line) > 64<<10 {
		t.Fatal("WireGuard reference requires one bounded request", err)
	}
	var request desktopNodeWGRequest
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	if decoder.Decode(&request) != nil || decoder.Decode(new(any)) != io.EOF {
		t.Fatal("WireGuard reference received another input shape")
	}
	local, remote, ipc, err := desktopNodeWGRequestIdentity(request)
	if err != nil {
		t.Fatal(err)
	}
	runDesktopNodeUDPReferenceProcess(t, reader, request, local, remote, ipc, startDesktopNodeWGReferenceDevice)
}

type desktopNodeWGLayerRequest struct {
	desktopNodeWGRequest
	Layer             string `json:"layer"`
	AESPassword       string `json:"aes_password"`
	RelaySource       string `json:"relay_source"`
	WhiteningMismatch bool   `json:"whitening_mismatch,omitempty"`
}

type desktopNodeWGLayerCapture struct {
	request                     desktopNodeWGRequest
	layer, aesPassword          string
	physicalClient, relaySource netip.Addr
	whiteningMismatch           bool
}

func desktopNodeWGLayerIdentity(request desktopNodeWGLayerRequest) (netip.Addr, netip.Addr, string, *desktopNodeWGLayerCapture, error) {
	bad := errors.New("layered WireGuard reference requires distinct original client, owned relay and exact authenticated layer")
	local, remote, ipc, err := desktopNodeWGRequestIdentity(request.desktopNodeWGRequest)
	if err != nil {
		return netip.Addr{}, netip.Addr{}, "", nil, err
	}
	relay, relayErr := netip.ParseAddr(request.RelaySource)
	key, keyErr := base64.StdEncoding.Strict().DecodeString(request.AESPassword)
	defer clear(key)
	if relayErr != nil || relay != local || relay.String() != request.RelaySource ||
		request.Layer != "aes-256-gcm" && request.Layer != "aes-256-gcm+xor-whitening" ||
		request.WhiteningMismatch && request.Layer != "aes-256-gcm+xor-whitening" ||
		keyErr != nil || len(key) != 32 || base64.StdEncoding.EncodeToString(key) != request.AESPassword || bytes.Equal(key, make([]byte, 32)) ||
		request.AESPassword == request.PreSharedKey || request.AESPassword == request.PrivateKey || request.AESPassword == request.ClientPublicKey {
		return netip.Addr{}, netip.Addr{}, "", nil, bad
	}
	capture := &desktopNodeWGLayerCapture{request: request.desktopNodeWGRequest, layer: request.Layer, aesPassword: request.AESPassword,
		physicalClient: remote, relaySource: relay, whiteningMismatch: request.WhiteningMismatch}
	return local, remote, ipc, capture, nil
}

