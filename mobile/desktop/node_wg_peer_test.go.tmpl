	}
}

func TestRouterVPNDesktopNodeWireGuardLayerCapture(t *testing.T) {
	config, options := desktopReferenceFixture(t)
	digest := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + options.Peers[0].PublicKey))
	original := desktopNodeWGLayerRequest{desktopNodeWGRequest: desktopNodeWGRequest{Schema: 1, Address: "192.168.210.2", ClientAddress: "192.168.210.1",
		PrivateKey: config.PrivateKey, ClientPublicKey: config.Peers[0].PublicKey, PreSharedKey: config.Peers[0].PreSharedKey, NodeProofID: hex.EncodeToString(digest[:])},
		Layer: "aes-256-gcm", AESPassword: base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x72}, 32)), RelaySource: "192.168.210.2"}
	for _, test := range []struct {
		name    string
		change  func(*desktopNodeWGLayerRequest)
		allowed bool
	}{
		{"captured", func(*desktopNodeWGLayerRequest) {}, true},
		{"whitening", func(r *desktopNodeWGLayerRequest) { r.Layer = "aes-256-gcm+xor-whitening" }, true},
		{"whitening-negative", func(r *desktopNodeWGLayerRequest) { r.Layer = "aes-256-gcm+xor-whitening"; r.WhiteningMismatch = true }, true},
		{"wrong-node", func(r *desktopNodeWGLayerRequest) { r.NodeProofID = strings.Repeat("b", 64) }, false},
		{"wrong-client", func(r *desktopNodeWGLayerRequest) { r.ClientAddress = "192.168.211.1" }, false},
		{"foreign-relay", func(r *desktopNodeWGLayerRequest) { r.RelaySource = r.ClientAddress }, false},
		{"loopback-relay", func(r *desktopNodeWGLayerRequest) { r.RelaySource = "127.0.0.1" }, false},
		{"plain-layer", func(r *desktopNodeWGLayerRequest) { r.Layer = "off" }, false},
		{"unknown-layer", func(r *desktopNodeWGLayerRequest) { r.Layer = "aes-256-gcm-xor" }, false},
		{"whitening-on-aes", func(r *desktopNodeWGLayerRequest) { r.WhiteningMismatch = true }, false},
		{"short-aes", func(r *desktopNodeWGLayerRequest) { r.AESPassword = base64.StdEncoding.EncodeToString([]byte("short")) }, false},
		{"same-psk", func(r *desktopNodeWGLayerRequest) { r.AESPassword = r.PreSharedKey }, false},
		{"same-private-key", func(r *desktopNodeWGLayerRequest) { r.AESPassword = r.PrivateKey }, false},
		{"self-peer", func(r *desktopNodeWGLayerRequest) { r.ClientPublicKey = options.Peers[0].PublicKey }, false},
	} {
		t.Run(test.name, func(t *testing.T) {
			request := original
			test.change(&request)
			local, remote, ipc, capture, err := desktopNodeWGLayerIdentity(request)
			if (err == nil) != test.allowed || (capture != nil) != test.allowed {
				t.Fatal("layered WG capture admitted another physical, crypto or relay owner", err)
			}
			if test.allowed && (local.String() != original.Address || remote.String() != original.ClientAddress || capture.physicalClient != remote || capture.relaySource != local || capture.request != request.desktopNodeWGRequest || ipc == "") {
				t.Fatal("layered WG replaced its independent source capture")
			}
		})
	}
	raw, err := json.Marshal(original)
	if err != nil {
		t.Fatal(err)
	}
	var plain desktopNodeWGRequest
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.DisallowUnknownFields()
	if decoder.Decode(&plain) == nil {
		t.Fatal("plain WG reference accepted a layer-specific input")
	}
}

// The worker and traffic are real; the common fixture retains its explicit
// modeled kernel/TUN boundary. Only the installed gate can prove native host
// activation and application Connected publication.
func TestRouterVPNDesktopNodeWireGuardLayerCover(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		for _, fault := range []string{"owned", "wrong-node", "drop-cover"} {
			t.Run(layer+"/"+fault, func(t *testing.T) {
				peer := desktopNodeWGReferenceWithOptions(t, desktopNodeWGReferenceOptions{Layer: layer, Cover: true})
				f := newDesktopNodeLayerFixture(t, peer, "")
				if err := f.box.RouterVPNStrategyStart(); err != nil {
					t.Fatal(err)
				}
				var cover *routervpnperformance.Service
				for _, service := range f.box.RouterVPNServices() {
					if actual, ok := service.(*routervpnperformance.Service); ok {
						if cover != nil {
							t.Fatal("multiple cover workers")
						}
						cover = actual
					}
				}
				if cover == nil || cover.Healthy() || peer.observe(t, "stats").CoverPackets != 0 {
					t.Fatal("WG layer started cover before its actual private-node proof")
				}
				if err := f.box.RouterVPNStrategyDNSProof(); err != nil {
					t.Fatal(err)
				}
				if fault != "owned" {
					peer.observe(t, fault)
				}
				err := cover.Activate()
				observed := peer.observe(t, "stats")
				if (err == nil) != (fault == "owned") || cover.Healthy() != (fault == "owned") || observed.RouterQueries == 0 || observed.DirectQueries != 0 || observed.DNSQueries != 1 || observed.RawTCP != 0 || observed.RawUDP == 0 || observed.ProtocolRawUDP == 0 || observed.ProtocolTCP == 0 || f.network.Current() {
					t.Fatal("WG cover changed its exact final protocol or source proof", err, observed)
				}
				if fault == "wrong-node" {
					if observed.CoverPackets != 0 {
						t.Fatal("wrong WG node started cover")
					}
				} else if observed.CoverPackets == 0 || observed.CoverBytes < 128 || observed.CoverMaximum > 1200 || (observed.CoverReplies > 0) != (fault == "owned") {
					t.Fatal("cover did not reach the final WG peer", observed)
				}
				if err := cover.Close(); err != nil || cover.Healthy() {
					t.Fatal("WG layered worker did not retire", err)
				}
				f.source.Cancel()
				if err := f.close(); err != nil || !f.source.closed.Load() {
					t.Fatal("WG layer retained its old cover/socket source", err)
				}
			})
		}
	}
}

// Knowing the captured AES key is insufficient to bypass WireGuard. The outer
// peer has exactly one inner UDP destination, and the captured host grants no
// physical TCP. Selected DNS and Router proof belong to the final WG peer.
func TestRouterVPNDesktopNodeWireGuardOuterCannotBypassFinal(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		t.Run(layer, func(t *testing.T) {
			peer := desktopNodeWGReferenceWithOptions(t, desktopNodeWGReferenceOptions{Layer: layer})
			f := newDesktopNodeLayerFixture(t, peer, "")
			if err := f.box.RouterVPNStrategyStart(); err != nil {
				t.Fatal(err)
			}
			// WG eagerly handshakes at startup. Establish a real inner flow
			// first so its handshake cannot masquerade as this negative's
			// outer-only packet receipt; final payload/DNS counts must stay
			// unchanged while the forbidden direct DNS request is sent.
			if err := f.exchange("udp"); err != nil {
				t.Fatal("WireGuard outer control lost its real encrypted positive path", err)
			}
			before := peer.observe(t, "stats")
			outer, found := f.box.Outbound().Outbound(mobilemultihop.NativeStartLayerTag)
			if !found {
				t.Fatal("missing captured WireGuard outer AES transport")
			}
			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
			defer cancel()
			connection, err := outer.DialContext(ctx, "tcp", M.ParseSocksaddr(desktopNodeRouterHealthTarget))
			if connection != nil {
				_ = connection.Close()
			}
			if err == nil {
				t.Fatal("WireGuard outer acquired an uncaptured physical TCP grant")
			}
			target := M.ParseSocksaddr("192.168.50.133:53")
			packet, err := outer.ListenPacket(ctx, target)
			if err != nil {
				t.Fatal("WireGuard outer negative missed its actual owned UDP transport", err)
			}
			_ = packet.SetDeadline(time.Now().Add(350 * time.Millisecond))
			query := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
			raw, err := query.Pack()
			if err != nil {
				_ = packet.Close()
				t.Fatal(err)
			}
			n, writeErr := packet.WriteTo(raw, target)
			answer := make([]byte, 512)
			_, _, readErr := packet.ReadFrom(answer)
			_ = packet.Close()
			observed := peer.observe(t, "stats")
			if writeErr != nil || n != len(raw) || readErr == nil || observed.RawTCP != 0 || observed.RawUDP <= before.RawUDP || observed.RejectedUDP != before.RejectedUDP+1 ||
				observed.ProtocolTCP != before.ProtocolTCP || observed.ProtocolUDP != before.ProtocolUDP || observed.RouterQueries != 0 || observed.DNSQueries != 0 {
				t.Fatal("WireGuard outer AES bypassed its sole captured inner UDP route", writeErr, readErr, observed)
			}
			if err := f.exchange("tcp"); err != nil || f.box.RouterVPNStrategyDNSProof() != nil {
				t.Fatal("outer rejection concealed an unavailable final WireGuard path", err)
			}
			observed = peer.observe(t, "stats")
			if observed.ProtocolRawUDP == 0 || observed.ProtocolTCP == 0 || observed.ProtocolUDP == 0 || observed.DNSQueries != 1 || f.network.Current() {
				t.Fatal("final WireGuard DNS positive control skipped its encrypted peer", observed)
			}
		})
	}
}
