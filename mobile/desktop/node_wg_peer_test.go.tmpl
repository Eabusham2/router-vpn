			}
			t.Run(layer+"/"+fault, func(t *testing.T) {
				peer := desktopNodeWGReferenceWithOptions(t, desktopNodeWGReferenceOptions{Layer: layer, WhiteningMismatch: fault == "wrong-whitening"})
