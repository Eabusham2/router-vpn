// Exercise the same installed reference carrier with real SS2022 ciphertext.
// The inner socket is an observed echo endpoint here; the installed TUN gate
// separately requires the actual HY2 TLS/DNS/public-proof service above it.
type desktopInstalledLayerClientWhitening struct {
	net.Conn
	key [32]byte
}

func (c *desktopInstalledLayerClientWhitening) Read(b []byte) (int, error) {
	n, e := c.Conn.Read(b)
	for i := range b[:n] {
		b[i] ^= c.key[i%len(c.key)]
	}
	return n, e
}
func (c *desktopInstalledLayerClientWhitening) Write(b []byte) (int, error) {
	copy := append([]byte(nil), b...)
	for i := range copy {
		copy[i] ^= c.key[i%len(c.key)]
	}
	return c.Conn.Write(copy)
}
func TestRouterVPNDesktopExternalInstalledLayerCarrier(t *testing.T) {
	for _, mode := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		t.Run(mode, func(t *testing.T) {
			faults := []string{"valid", "layer-key", "destination"}
			if mode == "aes-256-gcm+xor-whitening" {
				faults = append(faults, "whitening")
			}
			for _, fault := range faults {
				t.Run(fault, func(t *testing.T) {
					ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
					defer cancel()
					inner, err := net.ListenPacket("udp4", "127.0.0.1:0")
					if err != nil {
						t.Fatal(err)
					}
					defer inner.Close()
					innerAddress := netip.MustParseAddrPort(inner.LocalAddr().String())
					var innerCount atomic.Int32
					joined := make(chan struct{})
					go func() {
						defer close(joined)
						b := make([]byte, 2048)
						for {
							n, a, e := inner.ReadFrom(b)
							if e != nil {
								return
							}
							innerCount.Add(1)
							if _, e = inner.WriteTo(b[:n], a); e != nil {
								return
							}
						}
					}()
					defer func() { _ = inner.Close(); <-joined }()
					bind := "127.0.0.1:0"
					if mode == "aes-256-gcm+xor-whitening" {
						bind = "127.0.0.1:8389"
					}
					outer, err := net.ListenPacket("udp4", bind)
					if err != nil {
						t.Fatal(err)
					}
					var rawKey [32]byte
					if _, err = rand.Read(rawKey[:]); err != nil {
						t.Fatal(err)
					}
					password := base64.StdEncoding.EncodeToString(rawKey[:])
					clear(rawKey[:])
					serverFault := fault
					if fault == "valid" || fault == "destination" {
						serverFault = ""
					}
					peer, err := newDesktopExternalHysteriaLayerPeer(ctx, outer, innerAddress, mode, password, serverFault)
					if err != nil {
						_ = outer.Close()
						t.Fatal(err)
					}
					defer func() {
						if e := peer.Close(); e != nil {
							t.Error(e)
						}
					}()
					wire, err := net.Dial("udp4", outer.LocalAddr().String())
					if err != nil {
						t.Fatal(err)
					}
					defer wire.Close()
					var carrier net.Conn = wire
					if mode == "aes-256-gcm+xor-whitening" {
						carrier = &desktopInstalledLayerClientWhitening{Conn: wire, key: sha256.Sum256([]byte("router-vpn-xor-whitening-v1\x00" + password))}
					}
					method, err := shadowaead_2022.NewWithPassword("2022-blake3-aes-256-gcm", password, nil)
					if err != nil {
						t.Fatal(err)
					}
					client := method.DialPacketConn(carrier)
					defer client.Close()
					destination := net.UDPAddrFromAddrPort(netip.AddrPortFrom(netip.MustParseAddr("10.93.0.1"), innerAddress.Port()))
					if fault == "destination" {
						destination.IP = net.ParseIP("10.93.0.2")
					}
					payload := []byte("captured installed layer encrypted datagram")
					if err = wire.SetDeadline(time.Now().Add(250 * time.Millisecond)); err != nil {
						t.Fatal(err)
					}
					if n, e := client.WriteTo(payload, destination); e != nil || n != len(payload) {
						t.Fatal("encrypted carrier send", n, e)
					}
					body := make([]byte, 2048)
					n, from, readErr := client.ReadFrom(body)
					if fault == "valid" {
						if readErr != nil || !bytes.Equal(body[:n], payload) || from.String() != destination.String() {
							t.Fatal("encrypted carrier reply", from, readErr)
						}
					} else if readErr == nil {
						t.Fatal("negative carrier authenticated unexpected data")
					}
					if err = peer.Close(); err != nil {
						t.Fatal("joined carrier cleanup", err)
					}
					if peer.raw.Load() != 1 {
						t.Fatal("reference did not observe exact original datagram", peer.raw.Load())
					}
					if fault == "valid" {
						if peer.authenticated.Load() != 1 || peer.forwarded.Load() != 1 || peer.rejected.Load() != 0 || innerCount.Load() != 1 {
							t.Fatal("encrypted inner exchange counters changed")
						}
					} else if peer.authenticated.Load() != 0 || peer.forwarded.Load() != 0 || peer.rejected.Load() != 1 || innerCount.Load() != 0 {
						t.Fatal("refused carrier reached the inner socket")
					}
					rebound, e := net.ListenPacket("udp4", outer.LocalAddr().String())
					if e != nil {
						t.Fatal("carrier listener survived joined retirement", e)
					}
					_ = rebound.Close()
				})
			}
		})
	}
}
