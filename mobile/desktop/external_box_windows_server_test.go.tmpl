type desktopWFPRouterCloseWitness struct {
	net.Conn
	closed chan struct{}
	once   sync.Once
}

func (c *desktopWFPRouterCloseWitness) Close() error {
	c.once.Do(func() { close(c.closed) })
	return c.Conn.Close()
}

