	if err != nil {
		t.Fatal(err)
	}

	finalCtx, cancel := context.WithCancel(p.ctx)
	last := &desktopExternalIntegrationPeer{protocol: "shadowsocks", ctx: finalCtx, cancel: cancel, listener: tcp, packet: udp, certificate: p.certificate, connections: make(map[net.Conn]bool), packetConnections: make(map[N.PacketConn]bool), badDNS: q.Fault == "dns", badIP: q.Fault == "exit", publicEntered: p.publicEntered, publicRelease: p.publicRelease}
	t.Cleanup(last.close)

	last.ownedStream = func(ctx context.Context, c net.Conn, m M.Metadata) error {
		r.finalTCP.Add(1)
		return r.serveFinal(ctx, last, lane, c, m.Destination.String())
	}
	password := desktopWFPSSEntryPassword("2022-blake3-aes-256-gcm", 41)
	if q.Fault == "final-key" {
		password = desktopWFPSSEntryPassword("2022-blake3-aes-256-gcm", 42)
	}
	service, err := shadowaead_2022.NewServiceWithPassword("2022-blake3-aes-256-gcm", password, 60, &desktopWFPSSEntryFinalHandler{last}, nil)
	if err != nil {
		t.Fatal(err)
	}
	last.workers.Add(2)
	go func() {
		defer last.workers.Done()
		for {
			c, e := tcp.Accept()
			if e != nil {
				return
			}
			last.mu.Lock()
			if last.closing {
				last.mu.Unlock()
				_ = c.Close()
				return
			}
			last.connections[c] = true
			last.workers.Add(1)
			last.mu.Unlock()
			go func() {
				defer last.workers.Done()
				defer func() { _ = c.Close(); last.mu.Lock(); delete(last.connections, c); last.mu.Unlock() }()
				_ = c.SetDeadline(time.Now().Add(15 * time.Second))
				err := service.NewConnection(last.ctx, c, M.Metadata{Source: M.SocksaddrFromNet(c.RemoteAddr())})
				if desktopWFPSSEntryAuthError(err) {
					p.authFailures.Add(1)
				}
				last.recordFailure(err)
			}()
		}
	}()
	go func() {
		defer last.workers.Done()
		reader := B.NewPacketConn(udp)
		for {
			body := buf.NewPacket()
			from, e := reader.ReadPacket(body)
			if e != nil {
				body.Release()
				return
			}
			r.finalUDP.Add(1)
			if e = service.NewPacket(last.ctx, reader, body, M.Metadata{Source: from}); e != nil {
				body.Release()
				if desktopWFPSSEntryAuthError(e) {
					p.authFailures.Add(1)
				}
				last.recordFailure(e)
			}
		}
	}()
	return last
}

func desktopWFPStartRouterServerPeer(t *testing.T, p *desktopExternalIntegrationPeer, q desktopExternalWFPRequest) *desktopWFPRouterServer {
	t.Helper()
	if q.RouterServer == nil || q.Packet == nil || q.Packet.Protocol != "wireguard" || q.RouterServer.Token != desktopWFPRouterServerToken || len(q.RouterServer.NodeID) != 64 {
		t.Fatal("Router Server original capture missing")
	}
	switch q.Fault {
	case "", "entry-token", "entry-proof", "private-key", "psk", "final-key", "dns", "exit", "trust", "held", "lease-expired", "lease-credentials", "compare-local-reject", "compare-server-reject", "compare-both-reject", "compare-local-timeout", "compare-server-timeout", "compare-final-local", "compare-final-server", "compare-final-both", "compare-held-server":
	default:
		t.Fatal("unknown Router Server negative")
	}
	r := &desktopWFPRouterServer{peer: p, request: *q.RouterServer, fault: q.Fault, associations: make(map[uint16]*desktopWFPRouterAssociation)}
	r.finalPeer = desktopWFPStartRouterFinal(t, r, q, 1)
	r.localPeer = desktopWFPStartRouterFinal(t, r, q, 0)
	r.final, r.localFinal = r.finalPeer.listener.Addr().String(), r.localPeer.listener.Addr().String()
	last := r.finalPeer
	exit, err := multihoprelay.ExternalSelection("selected-external-native", "shadowsocks", desktopWFPRouterServerExternal(), nil)
	if err != nil {
		last.close()
		r.localPeer.close()
		t.Fatal(err)
	}
	r.manager, err = multihoprelay.New(multihoprelay.Config{ListenIP: "10.78.0.1", FirstPort: 26240, LastPort: 26271, TTLSeconds: 15, Exits: []multihoprelay.Exit{exit}}, r.request.NodeID, r)
	if err != nil {
		last.close()
		r.localPeer.close()
		t.Fatal(err)
	}
	p.ownedStream, p.ownedPacket = r.stream, r.packet
	p.ownedFlow = func(protocol uint8, source, destination netip.AddrPort) tun.FlowVerdict {
		if p.ctx.Err() != nil || source.Addr() != netip.MustParseAddr("10.78.0.2") {
			return tun.FlowVerdict{Action: tun.ActionReject}
		}
		if protocol == 6 && destination.String() == desktopWFPRouterServerAPI {
			return tun.FlowVerdict{Action: tun.ActionAccept}
		}
		if protocol != 6 && protocol != 17 {
			return tun.FlowVerdict{Action: tun.ActionReject}
		}
		if destination.String() == desktopWFPRouterServerFinal {
			return tun.FlowVerdict{Action: tun.ActionAccept}
		}
		if _, err := r.target(M.SocksaddrFromNetIP(destination), protocol == 17); err != nil {
			return tun.FlowVerdict{Action: tun.ActionReject}
		}
		return tun.FlowVerdict{Action: tun.ActionAccept}
	}
	fault := ""
	if q.Fault == "private-key" || q.Fault == "psk" {
		fault = q.Fault
	}
	desktopExternalWFPStartPacketPeer(t, p, q.Packet, fault)
	closeWG := p.closeProtocol
	p.closeProtocol = func() {
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		if err := r.manager.Close(ctx); err != nil {
			p.recordFailure(errors.New("original Router lease did not join"))
		}
		closeWG()
		last.close()
		r.localPeer.close()
	}
	return r
}

func desktopWFPRouterServerOriginal(t *testing.T, p *desktopExternalWFPReference, kill string, choices ...string) (*mobilemultihop.ExternalPolicy, string, string) {
	execution := "server"
	if len(choices) != 0 {
		execution = choices[0]
	}
	t.Helper()
	if p.packet == nil || p.packet.protocol != "wireguard" || p.initial.RouterServer == nil {
		t.Fatal("Router capture lost independent WG provider")
	}
	_, source, capture := desktopExternalWFPOriginal(t, p, kill)
	var graph, selected map[string]any
	if json.Unmarshal([]byte(source), &graph) != nil || json.Unmarshal([]byte(capture), &selected) != nil {
		t.Fatal("original graph decode")
	}
	ext := desktopWFPRouterServerExternal()
	graph["outbounds"] = []any{map[string]any{"type": "shadowsocks", "tag": mobilemultihop.ExternalFinalTag, "server": "198.51.100.240", "server_port": 8388, "method": "2022-blake3-aes-256-gcm", "password": desktopWFPSSEntryPassword("2022-blake3-aes-256-gcm", 41)}}
	profile := selected["profile"].(map[string]any)
	profile["external"], profile["multihop_enabled"], profile["multihop_entry_id"], profile["multihop_exit_id"], profile["multihop_exit_mode"], profile["multihop_execution"], profile["multihop_entry_mode"] = ext, true, "original-paired-router", profile["id"], "shadowsocks", execution, "wg"
	selected["protocol"] = "shadowsocks"
	node := desktopWFPRouterServerCapture(p.packet)
	if node.NodeID != p.initial.RouterServer.NodeID {
		t.Fatal("provider changed Router public key identity")
	}
	wg := fmt.Sprintf("[Interface]\nPrivateKey = %s\nAddress = 10.78.0.2/32\nDNS = 192.168.50.53\n\n[Peer]\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = 0.0.0.0/0, ::/0\nEndpoint = %s\nPersistentKeepalive = 25\n", p.packet.privateKey, p.packet.peerPublicKey, p.packet.presharedKey, p.remote)
	predecessor, err := mobilemultihop.WireGuardExitConfig(wg, node.NodeID)
	if err != nil {
		t.Fatal(err)
	}
	selected["entry"] = map[string]any{"id": "original-paired-router", "node_kind": "router-vpn", "node_proof_id": node.NodeID, "router_api": "http://" + desktopWFPRouterServerAPI, "api_token": node.Token, "mtu_policy": "auto", "ipv6_mode": "off", "home_lan_access": false}
	selected["entry_tag"], selected["predecessor_config"] = "external-entry", predecessor
	raw, _ := json.Marshal(graph)
	saved, _ := json.Marshal(selected)
	prepared, err := mobilemultihop.PrepareExternalPairedExecutionCapture(string(raw), string(saved), "")
	if err != nil {
		t.Fatal(err)
	}
	original, err := mobilemultihop.NewExternalPolicy(string(raw), prepared)
	if err != nil {
		t.Fatal(err)
	}
	return original, string(raw), prepared
}

func TestRouterVPNDesktopExternalWindowsRouterServerWFP(t *testing.T) {
	desktopWFPTestRouterExecution(t, "server")
}
func TestRouterVPNDesktopExternalWindowsRouterLocalWFP(t *testing.T) {
	desktopWFPTestRouterExecution(t, "local")
}
func desktopWFPTestRouterExecution(t *testing.T, execution string) {
	ca := newDesktopExternalIntegrationCA(t)
	roots := x509.NewCertPool()
	cert, err := x509.ParseCertificate(ca.der)
	if err != nil {
		t.Fatal(err)
	}
	roots.AddCert(cert)
	t.Setenv("GODEBUG", os.Getenv("GODEBUG")+",x509usefallbackroots=1")
	x509.SetFallbackRoots(roots)
	for _, name := range []string{"on-connect", "always", "successor-and-original-restore", "foreign-predecessor", "commit-refused", "reject/entry-token", "reject/entry-proof", "reject/private-key", "reject/psk", "reject/final-key", "reject/dns", "reject/exit", "reject/trust", "reject/lease-expired", "reject/lease-credentials", "cancelled-proof"} {
		if execution == "local" && (name == "reject/lease-expired" || name == "reject/lease-credentials") {
			continue
		}
		t.Run(name, func(t *testing.T) {
			fault, kill := "", "always"
			if name == "on-connect" {
				kill = name
			}
			if len(name) > 7 && name[:7] == "reject/" {
				fault = name[7:]
			}
			if name == "cancelled-proof" {
				fault = "held"
			}
			var retained mobiletor.DesktopWindowsProtectionTarget
			desktopExternalWFPCleanup(t, &retained)
			peer := desktopExternalWFPStartReferenceProtocol(t, ca, fault, "router-server")
			original, source, capture := desktopWFPRouterServerOriginal(t, peer, kill, execution)
			f := desktopExternalWFPBox(t, original, source, capture, nil, false)
			f.start(t)
			type result struct {
				raw string
				err error
			}
			done := make(chan result, 1)
			go func() { raw, err := f.proof.Run(); done <- result{raw, err} }()
			if fault == "held" || fault == "private-key" || fault == "psk" || fault == "final-key" {
				deadline := time.NewTimer(10 * time.Second)
				observed := false
				for !observed {
					reply := peer.call(t, "stats", "")
					observed = fault == "held" && reply.Attempts > 0 || (fault == "private-key" || fault == "psk") && reply.Packets > 0 || fault == "final-key" && reply.AuthFailures > 0
					if observed {
						break
					}
					select {
					case answer := <-done:
						done <- answer
						if fault == "held" || reply.AuthFailures == 0 && fault == "final-key" {
							failureReply := peer.call(t, "stats", "")
							t.Fatal("proof ended before actual held/authentication witness", answer.err, desktopWFPRouterServerDiagnostic(failureReply), desktopWFPRouterServerProgress(failureReply))
						}
						observed = true
					case <-deadline.C:
						f.proof.Cancel()
						t.Fatal("native negative did not reach original peer")
					case <-time.After(10 * time.Millisecond):
					}
				}
				deadline.Stop()
				f.proof.Cancel()
			}
			var outcome result
			select {
			case outcome = <-done:
			case <-time.After(20 * time.Second):
				f.proof.Cancel()
				select {
				case outcome = <-done:
				case <-time.After(5 * time.Second):
					t.Fatal("native Server proof did not join")
				}
				t.Fatal("native Server proof exceeded its bound", outcome.err)
			}
			raw, proofErr := outcome.raw, outcome.err
			if fault != "" {
				if proofErr == nil || f.proof.Healthy() || f.network.Current() {
					t.Fatal("invalid Server graph became healthy")
				}
				retained = f.drain(t)
				if execution == "local" {
					r := peer.call(t, "stats", "").RouterServer
					if r.Live || r.Creates != 0 || r.Deletes != 0 || r.RelayTCP != 0 || r.RelayUDP != 0 {
						t.Fatal("failed Local acquired a relay")
					}
				}
				desktopExternalWFPRequireBlocked(t, peer)
				return
			}
			var proof mobilemultihop.ExternalProofResult
			if proofErr != nil || json.Unmarshal([]byte(raw), &proof) != nil || proof.Execution != execution || !proof.EntryProven || proof.EntryNodeID != peer.initial.RouterServer.NodeID || !proof.DNSProven || proof.IP != desktopExternalIntegrationIP || !f.proof.Healthy() || !f.network.Current() {
				failureReply := peer.call(t, "stats", "")
				t.Fatal("actual Server proof failed", proofErr, desktopWFPRouterServerDiagnostic(failureReply), desktopWFPRouterServerProgress(failureReply))
			}
			reply := peer.call(t, "stats", "")
			r := reply.RouterServer
			if r == nil || r.Health == 0 || r.FinalTCP == 0 || r.FinalUDP == 0 || r.Responses == 0 || reply.DNS == 0 || reply.UDPDNS == 0 || reply.Public == 0 || reply.TLS == 0 {
				t.Fatal("Server proof bypassed original WG, lease, SS or selected DNS", reply)
			}
			if execution == "server" && (r.Discovery == 0 || r.Creates == 0 || !r.Live || r.RelayTCP == 0 || r.RelayUDP == 0 || r.LocalTCP != 0 || r.LocalUDP != 0) {
				t.Fatal("Server bypassed original lease", reply)
			}
			if execution == "local" && (r.LocalTCP == 0 || r.LocalUDP == 0 || r.Creates != 0 || r.Deletes != 0 || r.Live || r.RelayTCP != 0 || r.RelayUDP != 0) {
				t.Fatal("Local bypassed original final or acquired a relay", reply)
			}
			f.snapshot(t, peer)
			desktopExternalWFPRequireBlocked(t, peer)
			retained = f.drain(t)
			reply = peer.call(t, "stats", "")
			if reply.RouterServer.Live || execution == "server" && reply.RouterServer.Deletes == 0 || execution == "local" && (reply.RouterServer.Creates != 0 || reply.RouterServer.Deletes != 0) {
				t.Fatal("Server lease was not retired through original Router")
			}
			desktopExternalWFPRequireBlocked(t, peer)
			if name == "foreign-predecessor" || name == "commit-refused" {
				expected := retained
				if name == "foreign-predecessor" {
					expected.Capture.SourceSHA256 = hex.EncodeToString(bytes.Repeat([]byte{0xff}, 32))
				}
				before := peer.call(t, "stats", "")
				next := desktopExternalWFPBox(t, original, source, capture, &expected, name == "commit-refused")
				if err := next.box.RouterVPNStrategyStart(); err == nil || next.admitted != 0 || next.network.Current() || next.network.SocketCurrent() {
					t.Fatal("uncommitted Server successor acquired original WG socket")
				}
				if err := next.close(); err != nil {
					t.Fatal("failed Server successor did not join", err)
				}
				if err := mobiletor.DesktopWindowsNodeCompositionVerifyRetained(context.Background(), retained); err != nil {
					t.Fatal("failed Server successor changed original deny", err)
				}
				after := peer.call(t, "stats", "")
				if after.Packets != before.Packets || *after.RouterServer != *before.RouterServer {
					t.Fatal("refused Server successor sent handshake, lease or proof traffic")
				}
			}
			if name == "successor-and-original-restore" {
				previousCapture := capture
				for i := 0; i < 2; i++ {
					var fresh map[string]any
					if json.Unmarshal([]byte(capture), &fresh) != nil {
						t.Fatal("original restoration capture")
					}
					delete(fresh, "execution")
					private, _ := json.Marshal(fresh)
					nextCapture, err := mobilemultihop.PrepareExternalExecutionCapture(source, string(private), execution)
					if err != nil || nextCapture == previousCapture {
						t.Fatal("restoration reused lease proposal", err)
					}
					nextOriginal, err := mobilemultihop.NewExternalPolicy(source, nextCapture)
					if err != nil {
						t.Fatal(err)
					}
					next := desktopExternalWFPBox(t, nextOriginal, source, nextCapture, &retained, false)
					next.start(t)
					raw, err := next.proof.Run()
					var result mobilemultihop.ExternalProofResult
					if err != nil || json.Unmarshal([]byte(raw), &result) != nil || result.Execution != execution || result.EntryNodeID != proof.EntryNodeID || !result.EntryProven || !result.DNSProven || !next.proof.Healthy() || next.prepared == retained || next.commit.Previous == nil || *next.commit.Previous != retained {
						t.Fatal("actual Server successor/restoration changed original authority", err)
					}
					next.snapshot(t, peer)
					retained = next.drain(t)
					previousCapture = nextCapture
					r := peer.call(t, "stats", "").RouterServer
					if r.Live || execution == "local" && (r.Creates != 0 || r.Deletes != 0 || r.RelayTCP != 0 || r.RelayUDP != 0) {
						t.Fatal("restored lease did not join or Local acquired relay")
					}
				}
			}
		})
	}
}
