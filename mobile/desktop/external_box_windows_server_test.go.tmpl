const desktopWFPRouterServerAPI = "10.78.0.1:8787"
const desktopWFPRouterServerFinal = "198.51.100.240:8388"
const desktopWFPRouterServerToken = "original-router-server-private-token"

type desktopWFPRouterServerRequest struct{ NodeID, Token string }
type desktopWFPRouterLeaseDiagnostic struct {
	Method                     string
	Status                     int
	OperationError, StartError string
}
type desktopWFPRouterServerReceipt struct {
	Diagnostic                                                                                                 desktopWFPRouterLeaseDiagnostic
	NodeID                                                                                                     string
	Health, Discovery, Creates, Deletes, RelayTCP, RelayUDP, FinalTCP, FinalUDP, Responses, LocalTCP, LocalUDP int32
	Live                                                                                                       bool
	Lanes                                                                                                      [2]desktopWFPRouterLaneReceipt
}
type desktopWFPRouterServer struct {
	diagnostic                                                                                                 desktopWFPRouterLeaseDiagnostic
	peer                                                                                                       *desktopExternalIntegrationPeer
	finalPeer                                                                                                  *desktopExternalIntegrationPeer
	localPeer                                                                                                  *desktopExternalIntegrationPeer
	localFinal                                                                                                 string
	lanes                                                                                                      [2]desktopWFPRouterLaneReceipt
	request                                                                                                    desktopWFPRouterServerRequest
	manager                                                                                                    *multihoprelay.Manager
	mu                                                                                                         sync.Mutex
	process                                                                                                    *desktopWFPRouterRelayProcess
	associations                                                                                               map[uint16]*desktopWFPRouterAssociation
	final                                                                                                      string
	fault                                                                                                      string
	health, discovery, creates, deletes, relayTCP, relayUDP, finalTCP, finalUDP, responses, localTCP, localUDP atomic.Int32
}
type desktopWFPRouterRelayProcess struct {
	closeBox func() error
	box      *Box
	lease    multihoprelay.Lease
	mu       sync.Mutex
	alive    bool
	retiring bool
	owner    *desktopWFPRouterServer
}

type desktopWFPRouterAssociation struct {
	owner   *desktopWFPRouterServer
	process *desktopWFPRouterRelayProcess
	control net.Conn
	port    uint16
	ctx     context.Context
	cancel  context.CancelFunc
	mu      sync.Mutex
	closing bool
	workers sync.WaitGroup
	once    sync.Once
	done    chan struct{}
}

func (a *desktopWFPRouterAssociation) current() bool {
	if a.ctx.Err() != nil {
		return false
	}
	a.owner.mu.Lock()
	same := a.owner.associations[a.port] == a && a.owner.process == a.process
	a.owner.mu.Unlock()
	a.process.mu.Lock()
	live := a.process.alive && !a.process.retiring && a.process.lease.ExpiresAt.After(time.Now())
	a.process.mu.Unlock()
	return same && live && a.ctx.Err() == nil
}
func (a *desktopWFPRouterAssociation) enter() bool {
	a.mu.Lock()
	defer a.mu.Unlock()
	if a.closing || !a.current() {
		return false
	}
	a.workers.Add(1)
	return true
}
func (a *desktopWFPRouterAssociation) retire() {
	a.once.Do(func() {
		a.mu.Lock()
		a.closing = true
		a.cancel()
		if a.control != nil {
			_ = a.control.Close()
		}
		a.mu.Unlock()
		a.workers.Wait()
		a.owner.mu.Lock()
		if a.owner.associations[a.port] == a {
			delete(a.owner.associations, a.port)
		}
		a.owner.mu.Unlock()
		close(a.done)
	})
	<-a.done
}

func (p *desktopWFPRouterRelayProcess) Alive() bool {
	p.mu.Lock()
	defer p.mu.Unlock()
	return p.alive && !p.retiring
}
func (p *desktopWFPRouterRelayProcess) Stop(ctx context.Context) error {
	if ctx.Err() != nil {
		return ctx.Err()
	}
	p.mu.Lock()
	if !p.alive {
		p.mu.Unlock()
		return nil
	}
	p.retiring = true
	p.mu.Unlock()
	p.owner.mu.Lock()
	var associations []*desktopWFPRouterAssociation
	for _, a := range p.owner.associations {
		if a.process == p {
			associations = append(associations, a)
		}
	}
	p.owner.mu.Unlock()
	for _, a := range associations {
		a.retire()
	}
	if p.closeBox == nil {
		return errors.New("original relay listener owner missing")
	}
	if err := p.closeBox(); err != nil {
		return err
	}
	p.mu.Lock()
	p.alive = false
	p.mu.Unlock()
	return nil
}
func desktopWFPRouterServerCapture(p *desktopExternalWFPPacketCapture) *desktopWFPRouterServerRequest {
	sum := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + p.peerPublicKey))
	return &desktopWFPRouterServerRequest{hex.EncodeToString(sum[:]), desktopWFPRouterServerToken}
}
func desktopWFPRouterServerReplyIdentity(a, b desktopExternalWFPReply) bool {
	if a.RouterServer == nil || b.RouterServer == nil {
		return a.RouterServer == nil && b.RouterServer == nil
	}
	return a.RouterServer.NodeID == b.RouterServer.NodeID
}
func desktopWFPRouterServerInitialReceipt(q *desktopWFPRouterServerRequest, r *desktopWFPRouterServerReceipt) bool {
	if q == nil || r == nil {
		return q == nil && r == nil
	}
	return *r == (desktopWFPRouterServerReceipt{NodeID: q.NodeID})
}
func desktopWFPRouterServerDiagnostic(reply desktopExternalWFPReply) desktopWFPRouterLeaseDiagnostic {
	if reply.RouterServer == nil {
		return desktopWFPRouterLeaseDiagnostic{OperationError: "original provider diagnostic unavailable"}
	}
	return reply.RouterServer.Diagnostic
}
func desktopWFPRouterServerProgress(reply desktopExternalWFPReply) string {
	r := reply.RouterServer
	if r == nil {
		return "router-server progress receipt=missing"
	}
	return fmt.Sprintf("router-server progress health=%d discovery=%d creates=%d deletes=%d relay_tcp=%d relay_udp_attempts=%d final_tcp=%d final_udp_received=%d responses=%d local_tcp=%d local_udp=%d packets=%d auth_failures=%d dns=%d udp_dns=%d tls=%d public=%d attempts=%d",
		r.Health, r.Discovery, r.Creates, r.Deletes, r.RelayTCP, r.RelayUDP, r.FinalTCP, r.FinalUDP, r.Responses, r.LocalTCP, r.LocalUDP,
		reply.Packets, reply.AuthFailures, reply.DNS, reply.UDPDNS, reply.TLS, reply.Public, reply.Attempts)
}

func (r *desktopWFPRouterServer) receipt() *desktopWFPRouterServerReceipt {
	r.mu.Lock()
	p := r.process
	r.mu.Unlock()
	r.mu.Lock()
	lanes, diagnostic := r.lanes, r.diagnostic
	r.mu.Unlock()
	return &desktopWFPRouterServerReceipt{diagnostic, r.request.NodeID, r.health.Load(), r.discovery.Load(), r.creates.Load(), r.deletes.Load(), r.relayTCP.Load(), r.relayUDP.Load(), r.finalTCP.Load(), r.finalUDP.Load(), r.responses.Load(), r.localTCP.Load(), r.localUDP.Load(), p != nil && p.Alive(), lanes}
}

// Diagnostics belong only to this independent test provider's original
// operation. They never change its HTTP result or retry a lease/Box start.
func (r *desktopWFPRouterServer) recordLeaseFailure(method string, status int, operation, start error, q multihoprelay.Request) {
	clean := func(err error) string {
		if err == nil {
			return ""
		}
		value := err.Error()
		final, _ := desktopWFPRouterServerExternal()["shadowsocks"].(map[string]any)
		finalKey, _ := final["password"].(string)
		for _, secret := range []string{r.request.Token, q.Username, q.Password, q.ExternalAuthentication, q.ExternalEpoch, q.ExternalAttempt, finalKey} {
			if secret != "" {
				value = strings.ReplaceAll(value, secret, "[redacted]")
			}
		}
		if len(value) > 2048 {
			const suffix = " [truncated]"
			value = value[:2048-len(suffix)] + suffix
		}
		return value
	}
	operationText, startText := clean(operation), clean(start)
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.diagnostic.Status == 0 && status >= 400 {
		r.diagnostic.Method, r.diagnostic.Status, r.diagnostic.OperationError = method, status, operationText
	}
	if r.diagnostic.StartError == "" && startText != "" {
		r.diagnostic.StartError = startText
	}
}

// The independent Router owns a real relay Box compiled by the production
// lease manager. Only its fixture-local socket addresses are mapped: the WG
// handler checks the original tunnel peer before forwarding to this listener.
// Credentials, lease, SS transport and domain refusal stay compiler-owned.
func (r *desktopWFPRouterServer) Start(ctx context.Context, raw []byte, lease multihoprelay.Lease) (result multihoprelay.Process, failure error) {
	defer func() {
		if failure != nil {
			r.peer.recordFailure(failure)
			r.recordLeaseFailure("", 0, nil, failure, lease.Request)
		}
	}()
	if ctx.Err() != nil || r.peer.ctx.Err() != nil || lease.NodeID != r.request.NodeID || lease.Host != "10.78.0.1" {
		return nil, errors.New("Router relay lost original lease")
	}
	var graph map[string]any
	if json.Unmarshal(raw, &graph) != nil {
		return nil, errors.New("invalid compiled relay")
	}
	ins, ok := graph["inbounds"].([]any)
	if !ok || len(ins) != 1 {
		return nil, errors.New("relay listener count")
	}
	in, ok := ins[0].(map[string]any)
	if !ok || in["type"] != "socks" || in["listen"] != lease.Host || in["listen_port"] != float64(lease.Port) {
		return nil, errors.New("relay listener identity")
	}
	in["listen"] = "127.0.0.1"
	outs, ok := graph["outbounds"].([]any)
	if !ok || len(outs) != 1 {
		return nil, errors.New("relay final count")
	}
	out, ok := outs[0].(map[string]any)
	if !ok || out["type"] != "shadowsocks" || out["server"] != "198.51.100.240" || out["server_port"] != float64(8388) {
		return nil, errors.New("relay final identity")
	}
	target := netip.MustParseAddrPort(r.final)
	out["server"], out["server_port"] = target.Addr().String(), target.Port()
	route, ok := graph["route"].(map[string]any)
	if !ok {
		return nil, errors.New("relay route missing")
	}
	rules, ok := route["rules"].([]any)
	if !ok || len(rules) != 2 {
		return nil, errors.New("relay peer/domain refusal missing")
	}
	rule, ok := rules[0].(map[string]any)
	if !ok || rule["invert"] != true || rule["action"] != "reject" {
		return nil, errors.New("relay peer refusal changed")
	}
	peers, ok := rule["source_ip_cidr"].([]any)
	if !ok || len(peers) != 1 || peers[0] != "10.78.0.2/32" {
		return nil, errors.New("relay original peer changed")
	}
	rule["source_ip_cidr"] = []string{"127.0.0.1/32"}
	body, err := json.Marshal(graph)
	if err != nil {
		return nil, err
	}
	ir, or := inbound.NewRegistry(), outbound.NewRegistry()
	SOCKS.RegisterInbound(ir)
	SS.RegisterOutbound(or)
	// Match the packaged core registry for its required fallback construction.
	// The compiled relay graph still rejects domain targets from this client.
	resolvers := dns.NewTransportRegistry()
	DNSLocal.RegisterTransport(resolvers)
	runtime := Context(r.peer.ctx, ir, or, endpoint.NewRegistry(), resolvers, boxService.NewRegistry(), certificate.NewRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](runtime, body)
	if err != nil {
		return nil, err
	}
	instance, err := New(Options{Context: runtime, Options: options})
	if err != nil {
		return nil, err
	}
	if err = instance.Start(); err != nil {
		_ = instance.Close()
		return nil, err
	}
	process := &desktopWFPRouterRelayProcess{box: instance, lease: lease, alive: true, owner: r, closeBox: instance.Close}
	r.mu.Lock()
	r.process = process
	r.mu.Unlock()
	return process, nil
}

func (r *desktopWFPRouterServer) target(destination M.Socksaddr, packet bool) (string, error) {
	r.mu.Lock()
	p := r.process
	association := r.associations[destination.Port]
	r.mu.Unlock()
	if p == nil {
		return "", errors.New("Router has no lease")
	}
	p.mu.Lock()
	lease, alive := p.lease, p.alive && !p.retiring
	p.mu.Unlock()
	if !alive || !lease.ExpiresAt.After(time.Now()) || (!packet && int(destination.Port) != lease.Port) || (packet && (association == nil || association.process != p || association.ctx.Err() != nil)) || destination.Addr.String() != "10.78.0.1" && destination.Addr.String() != "127.0.0.1" {
		return "", errors.New("Router denies unowned relay destination")
	}
	return net.JoinHostPort("127.0.0.1", fmt.Sprint(destination.Port)), nil
}

type desktopWFPRouterControl struct {
	client, server net.Conn
	mu             sync.Mutex
	association    *desktopWFPRouterAssociation
	closing        bool
	once           sync.Once
}

func (c *desktopWFPRouterControl) close() {
	c.once.Do(func() {
		c.mu.Lock()
		c.closing = true
		association := c.association
		c.mu.Unlock()
		if association != nil {
			association.retire()
		}
		_ = c.client.Close()
		_ = c.server.Close()
	})
}
func (r *desktopWFPRouterServer) stream(ctx context.Context, c net.Conn, m M.Metadata) error {
	if r.peer.ctx.Err() != nil || ctx.Err() != nil || m.Source.Addr.String() != "10.78.0.2" {
		return errors.New("Router rejects foreign tunnel peer")
	}
	if m.Destination.String() == desktopWFPRouterServerFinal {
		return r.localStream(ctx, c)
	}
	if m.Destination.String() == desktopWFPRouterServerAPI {
		stop := context.AfterFunc(ctx, func() { _ = c.Close() })
		defer stop()
		return r.api(ctx, c)
	}
	r.mu.Lock()
	process := r.process
	r.mu.Unlock()
	target, err := r.target(m.Destination, false)
	if err != nil {
		return err
	}
	remote, err := (&net.Dialer{}).DialContext(ctx, "tcp", target)
	if err != nil {
		return err
	}
	control := &desktopWFPRouterControl{client: c, server: remote}
	defer control.close()
	stopPeer := context.AfterFunc(r.peer.ctx, control.close)
	defer stopPeer()
	stopFlow := context.AfterFunc(ctx, control.close)
	defer stopFlow()
	r.relayTCP.Add(1)
	if _, err = r.observeAssociation(ctx, control, process); err != nil {
		return err
	}
	done := make(chan struct{})
	go func() { _, _ = io.Copy(remote, c); control.close(); close(done) }()
	_, _ = io.Copy(c, remote)
	control.close()
	<-done
	return nil
}
func (r *desktopWFPRouterServer) packet(ctx context.Context, c N.PacketConn, m M.Metadata) error {
	if r.peer.ctx.Err() != nil || m.Source.Addr.String() != "10.78.0.2" {
		return errors.New("Router rejects foreign tunnel packet")
	}
	// Capture the original control before any validation that can race its
	// retirement. Never reload a successor after validating an earlier tuple.
	if m.Destination.String() == desktopWFPRouterServerFinal {
		return r.localPacket(ctx, c, m.Destination)
	}
	r.mu.Lock()
	association := r.associations[m.Destination.Port]
	r.mu.Unlock()
	target, err := r.target(m.Destination, true)
	if err != nil {
		return err
	}
	if association == nil || !association.enter() {
		return errors.New("original UDP association retired")
	}
	defer association.workers.Done()
	remote, err := (&net.Dialer{}).DialContext(association.ctx, "udp", target)
	if err != nil {
		return err
	}
	defer remote.Close()
	stop := context.AfterFunc(association.ctx, func() { _ = c.Close(); _ = remote.Close() })
	defer stop()
	done := make(chan struct{})
	go func() {
		defer close(done)
		defer c.Close()
		defer remote.Close()
		for {
			b := buf.NewPacket()
			destination, e := c.ReadPacket(b)
			if e == nil && (destination != m.Destination || !association.current()) {
				e = errors.New("Router UDP changed destination")
			}
			if e == nil {
				_, e = remote.Write(b.Bytes())
				r.relayUDP.Add(1)
			}
			b.Release()
			if e != nil {
				return
			}
		}
	}()
	for {
		b := buf.NewPacket()
		n, e := remote.Read(b.FreeBytes())
		if e != nil {
			b.Release()
			break
		}
		b.Truncate(n)
		if !association.current() {
			b.Release()
			break
		}
		if e = c.WritePacket(b, m.Destination); e != nil {
			break
		}
	}
	_ = c.Close()
	_ = remote.Close()
	<-done
	return nil
}

// Local forwarding preserves the exact independently captured encrypted final.
// The Router never decodes SS or fabricates an exit response on this path.
func (r *desktopWFPRouterServer) localStream(ctx context.Context, c net.Conn) error {
	remote, err := (&net.Dialer{}).DialContext(ctx, "tcp", r.localFinal)
	if err != nil {
		return err
	}
	closeBoth := func() { _ = c.Close(); _ = remote.Close() }
	stopFlow := context.AfterFunc(ctx, closeBoth)
	defer stopFlow()
	stopPeer := context.AfterFunc(r.peer.ctx, closeBoth)
	defer stopPeer()
	defer closeBoth()
	r.localTCP.Add(1)
	done := make(chan struct{})
	go func() { _, _ = io.Copy(remote, c); closeBoth(); close(done) }()
	_, _ = io.Copy(c, remote)
	closeBoth()
	<-done
	return nil
}
func (r *desktopWFPRouterServer) localPacket(ctx context.Context, c N.PacketConn, destination M.Socksaddr) error {
	remote, err := (&net.Dialer{}).DialContext(ctx, "udp", r.localFinal)
	if err != nil {
		return err
	}
	closeBoth := func() { _ = c.Close(); _ = remote.Close() }
	stopFlow := context.AfterFunc(ctx, closeBoth)
	defer stopFlow()
	stopPeer := context.AfterFunc(r.peer.ctx, closeBoth)
	defer stopPeer()
	defer closeBoth()
	done := make(chan struct{})
	go func() {
		defer close(done)
		defer closeBoth()
		for {
			b := buf.NewPacket()
			got, e := c.ReadPacket(b)
			if e == nil && (got != destination || ctx.Err() != nil || r.peer.ctx.Err() != nil) {
				e = errors.New("Local final changed original destination or owner")
			}
			if e == nil {
				_, e = remote.Write(b.Bytes())
				if e == nil {
					r.localUDP.Add(1)
				}
			}
			b.Release()
			if e != nil {
				return
			}
		}
	}()
	for {
		b := buf.NewPacket()
		n, e := remote.Read(b.FreeBytes())
		if e != nil {
			b.Release()
			break
		}
		b.Truncate(n)
		if ctx.Err() != nil || r.peer.ctx.Err() != nil {
			b.Release()
			break
		}
		if e = c.WritePacket(b, destination); e != nil {
			break
		}
	}
	closeBoth()
	<-done
	return nil
}

// Observe the real authenticated SOCKS reply. Only its validated fixture-local
// UDP bind address is mapped back to the captured lease host; authentication and
// the bound port stay original. A UDP tuple exists only until that exact control
// closes. No client supplied port, wildcard, guessed range or earlier session
// can authorize it.
func (r *desktopWFPRouterServer) observeAssociation(ctx context.Context, control *desktopWFPRouterControl, process *desktopWFPRouterRelayProcess) (*desktopWFPRouterAssociation, error) {
	client, server := control.client, control.server
	bad := errors.New("Router relay changed authenticated SOCKS association")
	relay := func(from, to net.Conn, n int) ([]byte, error) {
		b := make([]byte, n)
		if _, e := io.ReadFull(from, b); e != nil {
			return nil, e
		}
		if to != nil {
			if _, e := to.Write(b); e != nil {
				return nil, e
			}
		}
		return b, nil
	}
	greeting, e := relay(client, server, 2)
	if e != nil {
		return nil, e
	}
	if greeting[0] != 5 || greeting[1] == 0 || greeting[1] > 16 {
		return nil, bad
	}
	if _, e = relay(client, server, int(greeting[1])); e != nil {
		return nil, e
	}
	method, e := relay(server, client, 2)
	if e != nil {
		return nil, e
	}
	if method[0] != 5 || method[1] != 2 {
		return nil, bad
	}
	auth, e := relay(client, server, 2)
	if e != nil {
		return nil, e
	}
	if auth[0] != 1 || auth[1] == 0 {
		return nil, bad
	}
	if _, e = relay(client, server, int(auth[1])); e != nil {
		return nil, e
	}
	length, e := relay(client, server, 1)
	if e != nil {
		return nil, e
	}
	if length[0] == 0 {
		return nil, bad
	}
	if _, e = relay(client, server, int(length[0])); e != nil {
		return nil, e
	}
	verdict, e := relay(server, client, 2)
	if e != nil {
		return nil, e
	}
	if verdict[0] != 1 || verdict[1] != 0 {
		return nil, bad
	}
	address := func(from, to net.Conn) ([]byte, error) {
		h, e := relay(from, to, 4)
		if e != nil {
			return nil, e
		}
		if h[0] != 5 || h[2] != 0 {
			return nil, bad
		}
		n := 0
		switch h[3] {
		case 1:
			n = 6
		case 4:
			n = 18
		default:
			return nil, bad
		}
		body, e := relay(from, to, n)
		return append(h, body...), e
	}
	request, e := address(client, server)
	if e != nil {
		return nil, e
	}
	if request[1] != 1 && request[1] != 3 {
		return nil, bad
	}
	response, e := address(server, nil)
	if e != nil {
		return nil, e
	}
	if response[1] != 0 {
		return nil, bad
	}
	if request[1] != 3 {
		r.mu.Lock()
		current := r.process == process && process != nil && process.Alive()
		r.mu.Unlock()
		if !current || ctx.Err() != nil || r.peer.ctx.Err() != nil {
			return nil, bad
		}
		_, e := client.Write(response)
		return nil, e
	}
	if response[3] != 1 {
		return nil, bad
	}
	ip := netip.AddrFrom4([4]byte(response[4:8]))
	if !ip.IsUnspecified() && ip != netip.MustParseAddr("127.0.0.1") {
		return nil, bad
	}
	port := uint16(response[8])<<8 | uint16(response[9])
	if port == 0 {
		return nil, bad
	}
	control.mu.Lock()
	if control.closing || ctx.Err() != nil || r.peer.ctx.Err() != nil {
		control.mu.Unlock()
		return nil, bad
	}
	r.mu.Lock()
	if r.associations[port] != nil || r.process != process || process == nil || !process.Alive() {
		r.mu.Unlock()
		control.mu.Unlock()
		return nil, bad
	}
	process.mu.Lock()
	leaseHost, hostErr := netip.ParseAddr(process.lease.Host)
	process.mu.Unlock()
	if hostErr != nil || leaseHost != netip.MustParseAddr("10.78.0.1") {
		r.mu.Unlock()
		control.mu.Unlock()
		return nil, bad
	}
	lifetime, cancel := context.WithCancel(r.peer.ctx)
	association := &desktopWFPRouterAssociation{owner: r, process: process, control: client, port: port, ctx: lifetime, cancel: cancel, done: make(chan struct{})}
	r.associations[port] = association
	control.association = association
	r.mu.Unlock()
	control.mu.Unlock()
	// The client reaches this listener through the original WG peer, whose
	// network stack correctly rejects loopback destinations received from WG.
	addressBytes := leaseHost.As4()
	copy(response[4:8], addressBytes[:])
	if _, err := client.Write(response); err != nil {
		return nil, err
	}
	return association, nil
}
func (r *desktopWFPRouterServer) api(ctx context.Context, c net.Conn) error {
	request, err := http.ReadRequest(bufio.NewReader(c))
	if err != nil {
		return err
	}
	defer request.Body.Close()
	status := 200
	var operationError error
	var q multihoprelay.Request
	var response any
	if request.Host != desktopWFPRouterServerAPI || request.Header.Get("Authorization") != "Bearer "+r.request.Token || r.fault == "entry-token" {
		status = 403
	} else if request.Method == "GET" && request.URL.Path == "/health" {
		r.health.Add(1)
		node := r.request.NodeID
		if r.fault == "entry-proof" {
			node = string(bytes.Repeat([]byte{'f'}, 64))
		}
		response = map[string]any{"ok": true, "node_id": node, "proof": "router-vpn-private-agent-v1"}
	} else if request.URL.Path != "/api/multihop/lease" {
		status = 404
	} else if request.Method == "GET" {
		r.discovery.Add(1)
		catalog := map[string]any{"node_id": r.request.NodeID, "execution": "server", "exits": r.manager.Available()}
		if request.URL.RawQuery == "external_packet=1" {
			challenge, e := r.manager.PacketChallenge(netip.MustParseAddr("10.78.0.2"))
			if e != nil {
				status = 409
				operationError = e
			} else {
				catalog["external_packet_challenge"] = challenge
			}
		}
		response = catalog
	} else {
		decoder := json.NewDecoder(io.LimitReader(request.Body, 32<<10))
		decoder.DisallowUnknownFields()
		if e := decoder.Decode(&q); e != nil {
			operationError = e
			status = 400
		} else if request.Method == "PUT" {
			lease, e := r.manager.Create(ctx, netip.MustParseAddr("10.78.0.2"), q)
			if e != nil {
				status = 409
				operationError = e
			} else {
				r.creates.Add(1)
				r.mu.Lock()
				process := r.process
				r.mu.Unlock()
				if process != nil {
					process.mu.Lock()
					process.lease = lease
					process.mu.Unlock()
				}
				if r.fault == "lease-expired" {
					lease.ExpiresAt = time.Now().Add(-time.Second)
				}
				if r.fault == "lease-credentials" {
					lease.Password += "-changed"
				}
				response = lease
			}
		} else if request.Method == "DELETE" {
			if e := r.manager.Delete(ctx, netip.MustParseAddr("10.78.0.2"), q); e != nil {
				status = 409
				operationError = e
			} else {
				r.deletes.Add(1)
				response = map[string]any{"node_id": r.request.NodeID, "session_id": q.SessionID, "stopped": true}
			}
		} else {
			status = 405
		}
	}
	if status >= 400 {
		r.recordLeaseFailure(request.Method, status, operationError, nil, q)
	}
	raw, _ := json.Marshal(response)
	return (&http.Response{StatusCode: status, ProtoMajor: 1, ProtoMinor: 1, Header: http.Header{"Content-Type": []string{"application/json"}}, ContentLength: int64(len(raw)), Body: io.NopCloser(bytes.NewReader(raw)), Close: true}).Write(c)
}

