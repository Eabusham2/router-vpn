func TestRouterVPNDesktopNativeSOCKSPrefixSourcePositions(t *testing.T) {
	for count := 2; count <= 6; count++ {
		for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
			t.Run(fmt.Sprintf("%d-%s", count, mode), func(t *testing.T) {
				request, local := nativeSOCKSPrefixFixture(t, count, mode)
				policy, err := nativeSOCKSPrefixServerSource(local, request)
				if err != nil {
					t.Fatal(err)
				}
				original, err := mobilemultihop.NewNodeChainSOCKSSource(local)
				if err != nil {
					t.Fatal(err)
				}
				_, metadata, err := original.ReadValidated()
				if err != nil {
					t.Fatal(err)
				}
				inventory := metadata.Proofs
				var suffix mobilemultihop.NodeChainServerSource
				if json.Unmarshal([]byte(policy.Source()), &suffix) != nil {
					t.Fatal("source missing")
				}
				for position, p := range policy.ProofInventory() {
					index := position + 1
					if p.Position != index || p.NodeID != inventory[index].NodeID || p.ProfileID != inventory[index].ProfileID {
						t.Fatal("global private/public position changed")
					}
					if index < count {
						a, _ := mobilemultihop.ParseNodeLaunchInput(suffix.Nodes[position])
						var source mobilemultihop.NodeChainSource
						_ = json.Unmarshal([]byte(local), &source)
						b, _ := mobilemultihop.ParseNodeLaunchInput(source.Nodes[index])
						aKey, _ := a.PacketClientPublicKey()
						bKey, _ := b.PacketClientPublicKey()
						if aKey == bKey {
							t.Fatal("Server borrowed original Local client key")
						}
					}
				}
				if policy.NativeCarrierRequired() != (count > 1) || len(policy.ProofInventory()) != count+1 {
					t.Fatal("native carrier or full suffix count changed")
				}
			})
		}
	}
}
func TestRouterVPNDesktopNativeSOCKSPrefixProviderPositions(t *testing.T) {
	for count := 2; count <= 6; count++ {
		t.Run(strconv.Itoa(count), func(t *testing.T) {
			request, _ := nativeSOCKSPrefixFixture(t, count, "wg")
			provider := nativeSOCKSPrefixProviderStart(t, request, false)
			if len(provider.local.prefixes) != count || count > 1 && (provider.server == nil || provider.server.prefixes[0] != nil) {
				t.Fatal("original entry was omitted or fabricated in Server")
			}
			for position, prefix := range provider.local.prefixes {
				inner, _ := desktopNodeChainInner(position, count)
				if position > 0 {
					if _, ok := prefix.handler.rules["tcp/"+net.JoinHostPort(inner, "8787")]; !ok {
						t.Fatal("Local proof moved from its original global position")
					}
				}
			}
			if count > 1 {
				for position := 1; position < count; position++ {
					prefix := provider.server.prefixes[position]
					inner, _ := desktopNodeChainInner(position, count)
					if _, ok := prefix.handler.rules["tcp/"+net.JoinHostPort(inner, "8787")]; !ok {
						t.Fatal("Server proof renumbered relative to suffix")
					}
					if position < count-1 {
						next := desktopNodeChainNext(position + 1)
						if len(prefix.handler.rules) != 2 || prefix.handler.rules["udp/"+next].Target != provider.server.prefixes[position+1].bind.address() {
							t.Fatal("Server acquired next-hop bypass")
						}
					} else if len(prefix.handler.rules) != 2 || prefix.handler.rules["tcp/10.79.0.1:1080"].Target != provider.imported.provider.address {
						t.Fatal("Server final packet bypassed original import")
					}
				}
			}
		})
	}
}
func TestRouterVPNDesktopNativeSOCKSPrefixSourceRefusals(t *testing.T) {
	request, local := nativeSOCKSPrefixFixture(t, 6, "awg2-fast")
	for _, fault := range []string{"missing-key", "entry-key", "import-key", "copied-key", "short-source", "missing-identity", "moved-import", "wrong-node", "foreign-mode", "changed-client"} {
		t.Run(fault, func(t *testing.T) {
			r := request
			r.ServerPrivateKeys = append([]string(nil), request.ServerPrivateKeys...)
			var source mobilemultihop.NodeChainSource
			_ = json.Unmarshal([]byte(local), &source)
			switch fault {
			case "missing-key":
				r.ServerPrivateKeys = r.ServerPrivateKeys[:len(r.ServerPrivateKeys)-1]
			case "entry-key":
				r.ServerPrivateKeys[0] = r.ServerPrivateKeys[1]
			case "import-key":
				r.ServerPrivateKeys[6] = r.ServerPrivateKeys[1]
			case "copied-key":
				r.ServerPrivateKeys[2] = r.ServerPrivateKeys[1]
			case "short-source":
				source.Nodes = source.Nodes[:len(source.Nodes)-1]
			case "missing-identity":
				source.IdentitySources[2] = ""
			case "moved-import":
				source.Nodes[2], source.Nodes[6] = source.Nodes[6], source.Nodes[2]
			case "wrong-node":
				r.Peer.Paired.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Peer.Paired.Prefixes...)
				r.Peer.Paired.Prefixes[2].NodeProofID = strings.Repeat("f", 64)
			case "foreign-mode":
				r.Peer.Paired.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Peer.Paired.Prefixes...)
				r.Peer.Paired.Prefixes[2].Mode = "shadowsocks"
			case "changed-client":
				r.Peer.Paired.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Peer.Paired.Prefixes...)
				key, err := ecdh.X25519().GenerateKey(rand.Reader)
				if err != nil {
					t.Fatal(err)
				}
				r.Peer.Paired.Prefixes[2].ClientPublicKey = base64.StdEncoding.EncodeToString(key.PublicKey().Bytes())
			}
			if _, err := nativeSOCKSPrefixServerSource(desktopNodeChainJSON(t, source), r); err == nil {
				t.Fatal("changed captured source acquired native Server authority")
			}
		})
	}
}

// The component authenticates the actual provider and negotiates one UDP
// association. Only the separately required installed cases prove entry/carrier.
func TestRouterVPNDesktopNativeSOCKSPrefixAuthentication(t *testing.T) {
	for _, wrong := range []bool{false, true} {
		t.Run(fmt.Sprintf("wrong=%t", wrong), func(t *testing.T) {
			request, _ := nativeSOCKSPrefixFixture(t, 2, "wg")
			if wrong {
				request.Fault = "wrong-auth"
			}
			provider := nativeSOCKSPrefixProviderStart(t, request, false)
			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
			defer cancel()
			conn, err := (&net.Dialer{}).DialContext(ctx, "tcp4", provider.imported.provider.address)
			if err != nil {
				t.Fatal(err)
			}
			defer conn.Close()
			if deadline, ok := ctx.Deadline(); ok {
				if err = conn.SetDeadline(deadline); err != nil {
					t.Fatal(err)
				}
			}
			if _, err = conn.Write([]byte{5, 1, 2}); err != nil {
				t.Fatal(err)
			}
			header := make([]byte, 2)
			if _, err = io.ReadFull(conn, header); err != nil || header[0] != 5 || header[1] != 2 {
				t.Fatal("original authenticated SOCKS negotiation", err)
			}
			auth := append([]byte{1, byte(len(request.Username))}, []byte(request.Username)...)
			auth = append(auth, byte(len(request.Password)))
			auth = append(auth, []byte(request.Password)...)
			if _, err = conn.Write(auth); err != nil {
				t.Fatal(err)
			}
			if _, err = io.ReadFull(conn, header); err != nil || header[0] != 1 || (header[1] != 0) != wrong {
				t.Fatal("original SOCKS credential verdict", err)
			}
			if wrong {
				if provider.socks.authFailures.Load() != 1 {
					t.Fatal("original authentication counter missing")
				}
				return
			}
			if _, err = conn.Write([]byte{5, 3, 0, 1, 0, 0, 0, 0, 0, 0}); err != nil {
				t.Fatal(err)
			}
			reply := make([]byte, 10)
			if _, err = io.ReadFull(conn, reply); err != nil || reply[0] != 5 || reply[1] != 0 || reply[3] != 1 || !bytes.Equal(reply[4:8], []byte{10, 79, 0, 1}) || reply[8] == 0 && reply[9] == 0 {
				t.Fatal("original negotiated private UDP tuple absent", err)
			}
			provider.relays.mu.Lock()
			active := len(provider.relays.all)
			provider.relays.mu.Unlock()
			if active != 1 || provider.socks.authFailures.Load() != 0 {
				t.Fatal("negotiated association lost original control owner")
			}
			_ = conn.Close()
			for {
				provider.relays.mu.Lock()
				active = len(provider.relays.all)
				provider.relays.mu.Unlock()
				if active == 0 {
					break
				}
				select {
				case <-ctx.Done():
					t.Fatal("original SOCKS control did not revoke and join association", ctx.Err())
				case <-time.After(time.Millisecond):
				}
			}
		})
	}
}
