	calls   int
	failure error
}

func (f *externalJournalAuthenticationFixture) authenticate(context.Context, *routerVPNExternalFiles) error {
	f.calls++
	return f.failure
}
func (f *externalJournalAuthenticationFixture) prepare(context.Context, *mobilemultihop.DesktopExternalPolicy, *mobiletor.DesktopProtectionTransferRecord) (context.Context, *routerVPNExternalAdmission, error) {
