// Actual compiler, Box, native service and inbound manager execute. The source
// refuses public sockets and the pipe-backed TUN is explicitly a descriptor
// model, not native PF, utun or encrypted graph acceptance.
func desktopDarwinSingleBoxFixture(t *testing.T) (*Box, *mobilemultihop.DesktopNodePolicy, *routervpndesktoppt.NodeNetworkOwner, *desktopNodeDarwinControlSource) {
	t.Helper()
	graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "auto_route": true, "strict_route": true, "mtu": 1280}}, "outbounds": []any{map[string]any{"type": "shadowsocks", "tag": "proxy", "server": "192.0.2.44", "server_port": 443, "method": "2022-blake3-aes-256-gcm", "password": base64.StdEncoding.EncodeToString([]byte(strings.Repeat("s", 32)))}}, "route": map[string]any{"final": "proxy"}}
	raw, _ := json.Marshal(graph)
	assets, _ := json.Marshal(map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString(raw)})
	profile, _ := json.Marshal(map[string]any{"id": "captured-darwin-node", "node_kind": "router-vpn", "node_proof_id": strings.Repeat("a", 64), "router_api": "http://10.77.0.1:8787", "api_token": "captured-node-token", "endpoint": "192.0.2.44", "dns_mode": "home", "adguard_ipv4": "192.168.50.133", "kill_switch_policy": "always", "mtu_policy": "auto", "ipv6_mode": "off", "home_lan_access": false})
	original, err := mobilemultihop.NewNodeProfile("shadowsocks", string(assets), string(profile), "", "")
	if err != nil {
		t.Fatal(err)
	}
	policy, err := mobilemultihop.NewDesktopNodePolicy(original, desktopTorBoxSession, "darwin")
	if err != nil {
		t.Fatal(err)
	}
	instance, tun := desktopChainPhysicalBox(t, policy, nil)
	tun.name = "utun991"
	_, network, err := instance.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		t.Fatal(err)
	}
	source := &desktopNodeDarwinControlSource{desktopExternalBoxSource: newDesktopExternalBoxSource(), box: instance, tag: tun.Tag()}
	if err := network.PrepareNodePhysicalBroker(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		if tun.ready || tun.claimed || network.Current() {
			t.Error("single-node preparation began after TUN ownership")
		}
		source.capture = capture
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observe context.Context) error {
			return network.MatchesContext(observe, capture.SessionID, capture.SourceSHA256)
		})
		return broker, source, err
	}); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		source.failRetire = false
		if err := network.CloseDarwinNodePhysicalSource(context.Background(), policy); err != nil {
			t.Error(err)
		}
		if err := instance.inbound.Close(); err != nil {
			t.Error(err)
		}
	})
	for _, stage := range []adapter.StartStage{adapter.StartStateInitialize, adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
		if err := network.Start(stage); err != nil {
			t.Fatal(err)
		}
		if err := instance.inbound.Start(stage); err != nil {
			t.Fatal(err)
		}
	}
	return instance, policy, network, source
}

func TestRouterVPNDesktopNodeDarwinOriginalPhysical(t *testing.T) {
	for _, kind := range []string{"exact", "foreign-policy", "descriptor-refusal", "retirement-retry"} {
		t.Run(kind, func(t *testing.T) {
			instance, policy, network, source := desktopDarwinSingleBoxFixture(t)
			if !routerVPNDesktopDarwinNodeTarget(policy) {
				t.Fatal("sealed single-node graph lost Darwin target")
			}
			foreign, err := mobilemultihop.NewDesktopNodePolicy(policy.OriginalProfile(), policy.Metadata().SessionID, "darwin")
			if err != nil {
				t.Fatal(err)
			}
			if kind == "foreign-policy" {
				if owner, err := instance.RouterVPNDesktopDarwinNodeActivatePhysical(foreign); err == nil || owner != nil {
					t.Fatal("equal metadata replaced original physical policy")
				}
				if err := network.CloseDarwinNodePhysicalSource(t.Context(), foreign); err == nil {
					t.Fatal("foreign policy closed original source")
				}
				if source.closed.Load() {
					t.Fatal("foreign source retirement entered original closer")
				}
				return
			}
			if kind == "descriptor-refusal" {
				source.rejectFile = true
			}
			owner, err := instance.RouterVPNDesktopDarwinNodeActivatePhysical(policy)
			source.controls(t, 1)
			preparation := &RouterVPNDesktopDarwinNodePreparation{network: network, policy: policy}
			if kind == "descriptor-refusal" {
				if err == nil || owner != nil || network.Current() {
					t.Fatal("failed original descriptor acquired native authority")
				}
				if err := preparation.CloseSource(t.Context()); err != nil || !source.closed.Load() {
					t.Fatal("failed activation lost original cleanup", err)
				}
				return
			}
			if err != nil || owner == nil || !owner.Current() {
				t.Fatal("single node failed original descriptor activation", err)
			}
			if kind == "retirement-retry" {
				source.failRetire = true
				if err := preparation.CloseSource(t.Context()); err == nil || source.closed.Load() {
					t.Fatal("failed original source retirement fabricated closure")
				}
				source.failRetire = false
			}
			if err := preparation.CloseSource(t.Context()); err != nil || !source.closed.Load() {
				t.Fatal("original single-node source failed joined retirement", err)
			}
		})
	}
}

func TestRouterVPNDesktopNodeDarwinRejectsForeignControl(t *testing.T) {
	instance, policy, _, source := desktopDarwinSingleBoxFixture(t)
	owner, err := instance.RouterVPNDesktopDarwinNodeActivatePhysical(policy)
	if err != nil || owner == nil {
		t.Fatal(err)
	}
	foreign, writer, err := os.Pipe()
	if err != nil {
		t.Fatal(err)
	}
	if err := writer.Close(); err != nil {
		foreign.Close()
		t.Fatal(err)
	}
	replacement := desktopNodeDarwinControlReader{routerVPNDesktopTorTUN: owner.reader, capture: func(context.Context, func(context.Context) error) (*os.File, error) { return foreign, nil }}
	if err := owner.bindPhysicalTunnel(t.Context(), replacement, owner.name, uint32(owner.index)); err == nil {
		t.Fatal("foreign native description replaced the original single-node TUN")
	}
	if _, err := foreign.Stat(); !errors.Is(err, os.ErrClosed) {
		t.Fatal("rejected single-node control duplicate was retained", err)
	}
	source.controls(t, 2)
}
