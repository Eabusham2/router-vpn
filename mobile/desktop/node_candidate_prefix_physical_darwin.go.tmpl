//go:build darwin

package routervpndesktoppt

import (
	"context"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

func (n *NodeNetworkOwner) PrepareCandidatePrefixPhysicalPolicy(policy *mobilemultihop.DesktopNodeCandidatePreparationPolicy) error {
	return n.prepareNodePhysicalDarwin(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, options mobiletor.DesktopDarwinSocketOptions) (desktopDarwinPhysicalPolicy, error) {
		owned, err := mobiletor.NewDesktopDarwinSocketPolicy(ctx, capture, options)
		if owned == nil {
			return nil, err
		}
		return owned, err
	})
}

func (n *NodeNetworkOwner) CloseCandidatePrefixPhysicalSource(ctx context.Context, policy *mobilemultihop.DesktopNodeCandidatePreparationPolicy) error {
	return n.closeOrderedPhysicalSource(ctx, policy, "node-candidate-prefix")
}
