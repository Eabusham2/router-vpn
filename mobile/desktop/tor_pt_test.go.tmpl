type desktopPTDNS struct {
	adapter.DNSRouter
	calls  atomic.Int32
	lookup func(context.Context, string, adapter.DNSQueryOptions) ([]netip.Addr, error)
}

func (r *desktopPTDNS) Lookup(ctx context.Context, name string, options adapter.DNSQueryOptions) ([]netip.Addr, error) {
	r.calls.Add(1)
	if ctx.Value(torBootstrapDNSKey{}) != true {
		return nil, errors.New("native bootstrap marker missing")
	}
	if r.lookup != nil {
		return r.lookup(ctx, name, options)
	}
	return []netip.Addr{netip.MustParseAddr("192.0.2.77"), netip.MustParseAddr("2001:db8::77")}, nil
}

type desktopPTDNSManager struct {
	adapter.DNSTransportManager
	mu    sync.Mutex
	items map[string]adapter.DNSTransport
}

func (m *desktopPTDNSManager) Transport(tag string) (adapter.DNSTransport, bool) {
	m.mu.Lock()
	defer m.mu.Unlock()
	value, ok := m.items[tag]
	return value, ok
}
func (*desktopPTDNSManager) Default() adapter.DNSTransport { panic("PT used implicit default DNS") }
func (*desktopPTDNSManager) Transports() []adapter.DNSTransport {
	panic("PT enumerated DNS alternatives")
}
func (m *desktopPTDNSManager) replace(tag string, value adapter.DNSTransport) {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.items[tag] = value
}

type desktopPTOutboundManager struct{ adapter.OutboundManager }

func (*desktopPTOutboundManager) Outbound(string) (adapter.Outbound, bool) { return nil, false }

type desktopPTTransport struct {
	dns.TransportAdapter
	adapter.Lifecycle
}

func (*desktopPTTransport) Reset() {}
func (*desktopPTTransport) Exchange(context.Context, *mDNS.Msg) (*mDNS.Msg, error) {
	return nil, errors.New("fixture permits only explicit DNS callback")
}
func (*desktopPTTransport) ExchangeAsync(_ context.Context, _ *mDNS.Msg, callback func(*mDNS.Msg, error)) {
	callback(nil, errors.New("fixture permits only explicit DNS callback"))
}
func desktopPTRemote(tag, detour, server string) adapter.DNSTransport {
	options := option.RemoteDNSServerOptions{DNSServerAddressOptions: option.DNSServerAddressOptions{Server: server, ServerPort: 853}}
	options.Detour = detour
	return &desktopPTTransport{TransportAdapter: dns.NewTransportAdapterWithRemoteOptions(C.DNSTypeTLS, tag, options)}
}

