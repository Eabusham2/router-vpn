func newDesktopPTFixture(t *testing.T) *desktopPTFixture {
	t.Helper()
	parent, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx := service.ContextWithDefaultRegistry(parent)
	f := &desktopPTFixture{ctx: ctx, router: &desktopPTDNS{}, dns: &desktopPTDNSManager{items: map[string]adapter.DNSTransport{}}, lower: &desktopPTLower{}}
	f.network = &desktopPTNetwork{automatic: true, monitor: &desktopPTMonitor{own: []string{"router-vpn-tor"}}, finder: &desktopPTFinder{items: []control.Interface{
		{Index: 7, MTU: 1500, Name: "captured0", Flags: net.FlagUp, Addresses: []netip.Prefix{netip.MustParsePrefix("192.0.2.31/24"), netip.MustParsePrefix("2001:db8:1::31/64")}},
		{Index: 8, MTU: 1280, Name: "router-vpn-tor", Flags: net.FlagUp, Addresses: []netip.Prefix{netip.MustParsePrefix("172.29.0.1/30")}},
	}}}
	service.MustRegister[adapter.DNSRouter](ctx, f.router)
	service.MustRegister[adapter.DNSTransportManager](ctx, f.dns)
	service.MustRegister[adapter.OutboundManager](ctx, &desktopPTOutboundManager{})
	service.MustRegister[adapter.NetworkManager](ctx, f.network)
	f.dns.items["bootstrap"] = desktopPTRemote("bootstrap", "", "192.0.2.53")
	ttl := uint32(41)
	subnet := badoption.Prefixable(netip.MustParsePrefix("198.51.100.0/24"))
	f.options.DomainResolver = &option.DomainResolveOptions{Server: "bootstrap", Strategy: option.DomainStrategy(C.DomainStrategyPreferIPv6), DisableCache: true, DisableOptimisticCache: true, RewriteTTL: &ttl, Timeout: badoption.Duration(2 * time.Second), ClientSubnet: &subnet}
	query, err := adapter.DNSQueryOptionsFrom(ctx, f.options.DomainResolver)
	if err != nil {
		t.Fatal(err)
	}
	f.query = query
	f.active.Store(true)
	return f
}
func (f *desktopPTFixture) make(t *testing.T, plan mobiletor.Plan) *Owner {
	t.Helper()
	lower := dialer.NewResolveDialer(f.ctx, f.lower, false, "bootstrap", f.query, 0)
	owner, err := newOwner(f.ctx, plan, f.options, f.active.Load, lower)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { closeDesktopPT(t, owner) })
	return owner
}
func closeDesktopPT(t *testing.T, owner *Owner) {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	if err := owner.Close(ctx); err != nil {
		t.Error("native PT owner did not drain", err)
	}
}
