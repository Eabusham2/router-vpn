func desktopPTStart(t *testing.T, owner *Owner) map[string]string {
	t.Helper()
	if err := owner.Start(); err != nil {
		t.Fatal(err)
	}
	listeners, err := owner.Listeners()
	if err != nil {
		t.Fatal(err)
	}
	return listeners
}
func desktopPTSend(t *testing.T, client net.Conn, bridge mobiletor.Bridge) {
	t.Helper()
	client.SetDeadline(time.Now().Add(5 * time.Second))
	if _, err := client.Write([]byte{5, 1, 2}); err != nil {
		t.Fatal(err)
	}
	var response [2]byte
	if _, err := io.ReadFull(client, response[:]); err != nil || response != [2]byte{5, 2} {
		t.Fatal("PT argument negotiation failed", err, response)
	}
	keys := make([]string, 0, len(bridge.Arguments))
	for key := range bridge.Arguments {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	escape := strings.NewReplacer("\\", "\\\\", ";", "\\;", "=", "\\=")
	fields := make([]string, 0, len(keys))
	for _, key := range keys {
		fields = append(fields, escape.Replace(key)+"="+escape.Replace(bridge.Arguments[key]))
	}
	encoded := strings.Join(fields, ";")
	if len(encoded) == 0 || len(encoded) > 255 {
		t.Fatal("invalid fixture SOCKS argument length")
	}
	auth := append([]byte{1, byte(len(encoded))}, []byte(encoded)...)
	auth = append(auth, 1, 0)
	if _, err := client.Write(auth); err != nil {
		t.Fatal(err)
	}
	if _, err := io.ReadFull(client, response[:]); err != nil || response != [2]byte{1, 0} {
		t.Fatal("PT rejected argument negotiation", err, response)
	}
	target := netip.MustParseAddrPort(bridge.Target)
	kind := byte(1)
	if target.Addr().Is6() {
		kind = 4
	}
	request := append([]byte{5, 1, 0, kind}, target.Addr().AsSlice()...)
	request = binary.BigEndian.AppendUint16(request, target.Port())
	if _, err := client.Write(request); err != nil {
		t.Fatal(err)
	}
}
func desktopPTConnect(t *testing.T, address string, bridge mobiletor.Bridge) (net.Conn, byte) {
	t.Helper()
	client, err := net.DialTimeout("tcp4", address, time.Second)
	if err != nil {
		t.Fatal(err)
	}
	desktopPTSend(t, client, bridge)
	var response [10]byte
	if _, err := io.ReadFull(client, response[:]); err != nil || response[0] != 5 || response[2] != 0 || response[3] != 1 {
		client.Close()
		t.Fatal("PT connect response invalid", err, response)
	}
	return client, response[1]
}

func TestRouterVPNDesktopTorPTRealObfs4UsesCapturedNativeDialer(t *testing.T) {
	f := newDesktopPTFixture(t)
	plan, factory := desktopPTObfs4(t)
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	defer listener.Close()
	serverDone := make(chan error, 1)
	go func() {
		for range 2 {
			raw, err := listener.Accept()
			if err != nil {
				serverDone <- err
				return
			}
			raw.SetDeadline(time.Now().Add(5 * time.Second))
			remote, err := factory.WrapConn(raw)
			if err != nil {
				raw.Close()
				serverDone <- err
				return
			}
			_, err = io.Copy(remote, remote)
			remote.Close()
			if err != nil && !errors.Is(err, net.ErrClosed) {
				serverDone <- err
				return
			}
		}
		serverDone <- nil
	}()
	f.lower.dial = func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
		if network != "tcp" || destination.String() != plan.Bridges[0].Target {
			return nil, errors.New("PT changed captured bridge target")
		}
		// Only this fixture maps the unroutable TEST-NET target to an actual
		// local obfs4 server. Production owns the native bound socket dialer.
		return (&net.Dialer{}).DialContext(ctx, "tcp4", listener.Addr().String())
	}
	owner := f.make(t, plan)
	listeners := desktopPTStart(t, owner)
	for range 2 {
		client, reply := desktopPTConnect(t, listeners["obfs4"], plan.Bridges[0])
		if reply != 0 {
			client.Close()
			t.Fatalf("real obfs4 was rejected: %d", reply)
		}
		payload := bytes.Repeat([]byte("native-owned Tor PT data;"), 128)
		if _, err := client.Write(payload); err != nil {
			client.Close()
			t.Fatal(err)
		}
		actual := make([]byte, len(payload))
		_, err := io.ReadFull(client, actual)
		client.Close()
		if err != nil || !bytes.Equal(payload, actual) {
			t.Fatal("actual obfs4 data path failed", err)
		}
	}
	if err := <-serverDone; err != nil {
		t.Fatal("local obfs4 server failed", err)
	}
	if f.lower.calls.Load() != 2 || f.router.calls.Load() != 0 {
		t.Fatal("numeric bridges escaped captured native path")
	}
	closeDesktopPT(t, owner)
	if owner.Current() {
		t.Fatal("closed owner remained current")
	}
	if conn, err := net.DialTimeout("tcp4", listeners["obfs4"], time.Second); err == nil {
		conn.Close()
		t.Fatal("drained PT listener remained open")
	}
}

func TestRouterVPNDesktopTorPTAllFamiliesOwnExactPrivateListeners(t *testing.T) {
	f := newDesktopPTFixture(t)
	obfs, _ := desktopPTObfs4(t)
	plan := desktopPTPlan(t, obfs.Bridges[0].Line,
		"meek_lite 192.0.2.20:80 url=https://meek.azureedge.net/ front=ajax.aspnetcdn.com utls=HelloRandomizedALPN",
		"snowflake 192.0.2.3:80 2B280B23E1107BB62ABFC40DDCC8824814F80A72 fingerprint=2B280B23E1107BB62ABFC40DDCC8824814F80A72 url=https://snowflake-broker.example.net/ front=cdn.example.net ice=stun:stun.example.net:3478 utls-imitate=hellorandomizedalpn",
		"webtunnel 10.0.0.2:443 89ABCDEF0123456789ABCDEF0123456789ABCDEF url=https://bridge.example.net/secret ver=0.0.1")
	owner := f.make(t, plan)
	listeners := desktopPTStart(t, owner)
	if len(listeners) != 4 || f.lower.calls.Load() != 0 || f.router.calls.Load() != 0 {
		t.Fatal("transport admission opened an external network operation")
	}
	for _, bridge := range plan.Bridges {
		address, err := netip.ParseAddrPort(listeners[bridge.Transport])
		if err != nil || !address.Addr().IsLoopback() || !address.Addr().Is4() || address.Port() == 0 {
			t.Fatal("PT listener was not private", err)
		}
	}
	listeners["obfs4"] = "127.0.0.1:1"
	again, err := owner.Listeners()
	if err != nil || again["obfs4"] == listeners["obfs4"] {
		t.Fatal("listener copy changed the owner")
	}
	for _, change := range []string{"target", "arguments"} {
		request := plan.Bridges[0]
		request.Arguments = map[string]string{}
		for key, value := range plan.Bridges[0].Arguments {
			request.Arguments[key] = value
		}
		if change == "target" {
			request.Target = "203.0.113.45:443"
		} else {
			request.Arguments["iat-mode"] = "1"
		}
		client, reply := desktopPTConnect(t, again["obfs4"], request)
		client.Close()
		if reply == 0 || f.lower.calls.Load() != 0 {
			t.Fatalf("%s mutation used the physical dialer", change)
		}
	}
	if err := owner.Start(); err == nil {
		t.Fatal("owner admitted a second PT generation")
	}
	closeDesktopPT(t, owner)
	for _, address := range again {
		if conn, err := net.DialTimeout("tcp4", address, time.Second); err == nil {
			conn.Close()
			t.Fatal("closed transport retained its listener")
		}
	}
}

func TestRouterVPNDesktopTorPTPreservesSelectedBootstrapDNS(t *testing.T) {
	f := newDesktopPTFixture(t)
	plan, _ := desktopPTObfs4(t)
	owner := f.make(t, plan)
	if len(owner.options.Interfaces) != 1 || owner.options.Interfaces[0].Name != "captured0" {
		t.Fatal("Snowflake interface snapshot included its own TUN")
	}
	desktopPTStart(t, owner)
	*f.options.DomainResolver.RewriteTTL = 999
	f.options.DomainResolver.Server = "other-resolver"
	f.router.lookup = func(_ context.Context, name string, query adapter.DNSQueryOptions) ([]netip.Addr, error) {
		if name != "bridge.example" || query.Transport != f.query.Transport || query.Strategy != C.DomainStrategyPreferIPv6 || query.LookupStrategy != C.DomainStrategyIPv4Only || !query.DisableCache || !query.DisableOptimisticCache || query.RewriteTTL == nil || *query.RewriteTTL != 41 || query.Timeout != 2*time.Second || query.ClientSubnet != netip.MustParsePrefix("198.51.100.0/24") {
			t.Errorf("selected native DNS changed: %#v", query)
		}
		*query.RewriteTTL = 1234
		return []netip.Addr{netip.MustParseAddr("192.0.2.77"), netip.MustParseAddr("2001:db8::77"), netip.IPv4Unspecified()}, nil
	}
	for range 2 {
		values, err := owner.options.Resolve(context.Background(), "ip4", "bridge.example")
		if err != nil || !reflect.DeepEqual(values, []netip.Addr{netip.MustParseAddr("192.0.2.77")}) {
			t.Fatal("captured DNS lookup failed", values, err)
		}
	}
	f.dns.replace("bootstrap", desktopPTRemote("bootstrap", "", "192.0.2.54"))
	if values, err := owner.options.Resolve(context.Background(), "ip4", "bridge.example"); err == nil || values != nil || owner.Current() {
		t.Fatal("replaced DNS owner was accepted")
	}
	f.dns.replace("bootstrap", f.query.Transport)
	if owner.Current() {
		t.Fatal("restoring a resolver pointer revived a retired owner")
	}
}

func TestRouterVPNDesktopTorPTRejectsUnownedBootstrapAdmission(t *testing.T) {
	for _, name := range []string{"no-resolver", "detour", "recursive", "hostname", "implicit", "wrong-query", "no-physical"} {
		t.Run(name, func(t *testing.T) {
			f := newDesktopPTFixture(t)
			plan, _ := desktopPTObfs4(t)
			switch name {
			case "no-resolver":
				f.options.DomainResolver = nil
			case "detour":
				f.options.Detour = "entry"
			case "recursive":
				f.dns.replace("bootstrap", desktopPTRemote("bootstrap", mobiletor.ProfileOutboundTag, "192.0.2.53"))
			case "hostname":
				f.dns.replace("bootstrap", desktopPTRemote("bootstrap", "", "resolver.example"))
			case "implicit":
				f.dns.replace("bootstrap", &desktopPTTransport{TransportAdapter: dns.NewTransportAdapter(C.DNSTypeLocal, "bootstrap", nil)})
			case "wrong-query":
				f.query.Transport = desktopPTRemote("elsewhere", "", "192.0.2.55")
			case "no-physical":
				f.active.Store(false)
			}
			if name == "recursive" || name == "hostname" || name == "implicit" {
				// Keep the native dialer's selected transport equal to the
				// manager so each case reaches its intended graph/type guard.
				f.query.Transport, _ = f.dns.Transport("bootstrap")
			}
			lower := dialer.NewResolveDialer(f.ctx, f.lower, false, "bootstrap", f.query, 0)
			owner, err := newOwner(f.ctx, plan, f.options, f.active.Load, lower)
			if err == nil || owner != nil {
				if owner != nil {
					closeDesktopPT(t, owner)
				}
				t.Fatal("unowned native PT bootstrap was admitted")
			}
			if f.lower.calls.Load() != 0 || f.router.calls.Load() != 0 {
				t.Fatal("invalid admission caused network activity")
			}
		})
	}
	f := newDesktopPTFixture(t)
	plan, _ := desktopPTObfs4(t)
	f.network.automatic = false
	if owner, err := New(f.ctx, plan, *f.options.DomainResolver, f.active.Load); err == nil || owner != nil {
		t.Fatal("public native factory accepted an unbound network manager")
	}
}

func TestRouterVPNDesktopTorPTResetRejectsLateDNSAndCannotRevive(t *testing.T) {
	f := newDesktopPTFixture(t)
	plan, _ := desktopPTObfs4(t)
	observer, captured := testNetworkActivated(t, f.ctx)
	lower := dialer.NewResolveDialer(captured, f.lower, false, "bootstrap", f.query, 0)
	owner, err := newOwner(captured, plan, f.options, observer.Current, lower)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { closeDesktopPT(t, owner) })
	desktopPTStart(t, owner)
	entered, release := make(chan struct{}), make(chan struct{})
	defer func() {
		select {
		case <-release:
		default:
			close(release)
		}
	}()
	f.router.lookup = func(context.Context, string, adapter.DNSQueryOptions) ([]netip.Addr, error) {
		close(entered)
		<-release
		return []netip.Addr{netip.MustParseAddr("192.0.2.77")}, nil
	}
	result := make(chan error, 1)
	go func() {
		values, err := owner.options.Resolve(context.Background(), "ip4", "late.example")
		if err == nil || values != nil {
			result <- errors.New("late DNS returned a usable result")
		} else {
			result <- nil
		}
	}()
	select {
	case <-entered:
	case <-time.After(3 * time.Second):
		t.Fatal("DNS fixture did not begin")
	}
	observer.InterfaceUpdated(f.ctx) // The interface snapshot and address are unchanged.
	if owner.Current() {
		t.Fatal("same-address network reset retained a current PT owner")
	}
	close(release)
	if err := <-result; err != nil {
		t.Fatal(err)
	}
	if owner.Current() || owner.Context().Err() == nil {
		t.Fatal("late DNS completion revived the old generation")
	}
	if _, err := owner.Listeners(); err == nil {
		t.Fatal("retired PT listeners remained eligible for Tor")
	}
}

func TestRouterVPNDesktopTorPTLateSocketsRemainOwnedUntilActualClose(t *testing.T) {
	for _, kind := range []string{"tcp", "udp"} {
		t.Run(kind, func(t *testing.T) {
			f := newDesktopPTFixture(t)
			plan, _ := desktopPTObfs4(t)
			owner := f.make(t, plan)
			desktopPTStart(t, owner)
			entered, release := make(chan struct{}), make(chan struct{})
			var once sync.Once
			defer once.Do(func() { close(release) })
			var peer net.Conn
			var packet net.PacketConn
			if kind == "tcp" {
				late, other := net.Pipe()
				peer = other
				defer peer.Close()
				f.lower.dial = func(context.Context, string, M.Socksaddr) (net.Conn, error) {
					close(entered)
					<-release
					return late, nil
				}
			} else {
				var err error
				packet, err = net.ListenPacket("udp4", "127.0.0.1:0")
				if err != nil {
					t.Fatal(err)
				}
				defer packet.Close()
				f.lower.packet = func(context.Context, M.Socksaddr) (net.PacketConn, error) {
					close(entered)
					<-release
					return packet, nil
				}
			}
			// Exercise the same shared Network that PT Bridges uses. It, not an
			// error return or the test callback, must own and drain late sockets.
			network, err := mobiletor.NewNetwork(owner.Context(), owner.dial, owner.packets)
			if err != nil {
				t.Fatal(err)
			}
			done := make(chan error, 1)
			go func() {
				if kind == "tcp" {
					conn, err := network.DialContext(context.Background(), "tcp", "203.0.113.44:443")
					if conn != nil {
						conn.Close()
						done <- errors.New("retired TCP returned a socket")
					} else {
						done <- err
					}
				} else {
					conn, err := network.ListenPacket(context.Background(), "udp4", "0.0.0.0:0")
					if conn != nil {
						conn.Close()
						done <- errors.New("retired UDP returned a socket")
					} else {
						done <- err
					}
				}
			}()
			select {
			case <-entered:
			case <-time.After(3 * time.Second):
				t.Fatal("socket fixture did not begin")
			}
			f.active.Store(false)
			if owner.Current() {
				t.Fatal("observed retirement remained current")
			}
			f.active.Store(true)
			if owner.Current() {
				t.Fatal("physical witness revived the old owner")
			}
			wait, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
			err = network.Close(wait)
			cancel()
			if !errors.Is(err, context.DeadlineExceeded) {
				t.Fatal("pending lower socket was falsely acknowledged drained", err)
			}
			once.Do(func() { close(release) })
			if err := <-done; err == nil || strings.Contains(err.Error(), "returned a socket") {
				t.Fatal("stale socket was adopted", err)
			}
			wait, cancel = context.WithTimeout(context.Background(), 3*time.Second)
			err = network.Close(wait)
			cancel()
			if err != nil {
				t.Fatal("late socket did not drain", err)
			}
			if kind == "tcp" {
				peer.SetReadDeadline(time.Now().Add(time.Second))
				_, err = peer.Read(make([]byte, 1))
				if !errors.Is(err, io.EOF) {
					t.Fatal("late TCP socket was not actually closed", err)
				}
			} else {
				_, err = packet.WriteTo([]byte("late"), packet.LocalAddr())
				if !errors.Is(err, net.ErrClosed) {
					t.Fatal("late UDP socket was not actually closed", err)
				}
			}
		})
	}
}

func TestRouterVPNDesktopTorPTCloseWaitsForActualTransportDial(t *testing.T) {
	f := newDesktopPTFixture(t)
	plan, _ := desktopPTObfs4(t)
	entered, release := make(chan struct{}), make(chan struct{})
	var once sync.Once
	defer once.Do(func() { close(release) })
	late, peer := net.Pipe()
	defer peer.Close()
	f.lower.dial = func(context.Context, string, M.Socksaddr) (net.Conn, error) {
		close(entered)
		<-release
		return late, nil
	}
	owner := f.make(t, plan)
	listeners := desktopPTStart(t, owner)
	client, err := net.DialTimeout("tcp4", listeners["obfs4"], time.Second)
	if err != nil {
		t.Fatal(err)
	}
	defer client.Close()
	desktopPTSend(t, client, plan.Bridges[0])
	select {
	case <-entered:
	case <-time.After(3 * time.Second):
		t.Fatal("real PT worker never entered the captured native dial")
	}
	wait, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
	err = owner.Close(wait)
	cancel()
	if !errors.Is(err, context.DeadlineExceeded) {
		t.Fatal("PT worker was falsely acknowledged drained", err)
	}
	if owner.Current() {
		t.Fatal("draining owner allowed new admission")
	}
	once.Do(func() { close(release) })
	closeDesktopPT(t, owner)
	peer.SetReadDeadline(time.Now().Add(time.Second))
	if _, err := peer.Read(make([]byte, 1)); !errors.Is(err, io.EOF) {
		t.Fatal("real PT worker leaked its late native socket", err)
