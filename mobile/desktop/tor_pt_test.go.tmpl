func TestRouterVPNDesktopTorPTEntryCloseWaitsForPrivateProofDrain(t *testing.T) {
	f, entry, _ := desktopPTEntry(t)
	plan, _ := desktopPTObfs4(t)
	entered, release := make(chan struct{}), make(chan struct{})
	var releaseOnce sync.Once
	defer releaseOnce.Do(func() { close(release) })
	late, peer := net.Pipe()
	defer peer.Close()
	f.lower.dial = func(context.Context, string, M.Socksaddr) (net.Conn, error) {
		close(entered)
		<-release
		return late, nil
	}
	owner := desktopPTEntryOwner(t, f, entry, plan)
	proved := make(chan error, 1)
	go func() {
		receipt, err := owner.ProvePredecessor(context.Background())
		if receipt != nil {
			proved <- errors.New("late entry proof published receipt")
			return
		}
		proved <- err
	}()
	select {
	case <-entered:
	case <-time.After(3 * time.Second):
		t.Fatal("private entry dial never began")
	}
	wait, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
	err := owner.Close(wait)
	cancel()
	if !errors.Is(err, context.DeadlineExceeded) {
		t.Fatal("pending private proof falsely acknowledged drained", err)
	}
	releaseOnce.Do(func() { close(release) })
	select {
	case err := <-proved:
		if err == nil || strings.Contains(err.Error(), "published receipt") {
			t.Fatal("stale private proof adopted", err)
		}
	case <-time.After(3 * time.Second):
		t.Fatal("late private proof did not drain")
	}
	closeDesktopPT(t, owner)
	if err := peer.SetReadDeadline(time.Now().Add(time.Second)); err != nil && !errors.Is(err, io.ErrClosedPipe) {
		t.Fatal(err)
	}
	var one [1]byte
	if _, err := peer.Read(one[:]); !errors.Is(err, io.EOF) {
		t.Fatal("late private proof socket remained open", err)
	}
}
