type desktopPTLower struct {
	calls  atomic.Int32
	dial   func(context.Context, string, M.Socksaddr) (net.Conn, error)
	packet func(context.Context, M.Socksaddr) (net.PacketConn, error)
}

func (n *desktopPTLower) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	n.calls.Add(1)
	if ctx.Value(torBootstrapDNSKey{}) != true {
		return nil, errors.New("TCP native capture marker missing")
	}
	if n.dial == nil {
		return nil, errors.New("fixture denied external dial")
	}
	return n.dial(ctx, network, destination)
}
func (n *desktopPTLower) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
	n.calls.Add(1)
	if ctx.Value(torBootstrapDNSKey{}) != true {
		return nil, errors.New("UDP native capture marker missing")
	}
	if n.packet == nil {
		return nil, errors.New("fixture denied external packets")
	}
	return n.packet(ctx, destination)
}

