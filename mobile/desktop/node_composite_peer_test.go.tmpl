func TestRouterVPNDesktopNodeSIP003OuterCannotBypassFinal(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		t.Run(layer, func(t *testing.T) {
			_, ip := desktopNodePeerInterface(t)
			peer := startDesktopNodeLayerReference(t, "ss-v2ray", layer, ip, strings.Repeat("a", 64))
			f := newDesktopNodeLayerFixture(t, peer, "")
			if err := f.box.RouterVPNStrategyStart(); err != nil {
				t.Fatal(err)
			}
			if desktopNodeSIP003HTTP(t, f.box, nativecomposite.StartTag) == nil {
				t.Fatal("outer SIP003 layer bypassed final TCP protocol identity")
			}
			outer, found := f.box.Outbound().Outbound(nativecomposite.StartTag)
			if !found {
				t.Fatal("missing exact SIP003 outer owner")
			}
			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
			defer cancel()
			target := M.ParseSocksaddr("192.168.50.133:53")
			packet, err := outer.ListenPacket(ctx, target)
			if err != nil {
				t.Fatal("outer rejection missed real UDP owner", err)
			}
			_ = packet.SetDeadline(time.Now().Add(350 * time.Millisecond))
			query := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
			raw, err := query.Pack()
			if err != nil {
				t.Fatal(err)
			}
			n, writeErr := packet.WriteTo(raw, target)
			answer := make([]byte, 512)
			_, _, readErr := packet.ReadFrom(answer)
			_ = packet.Close()
			observed := peer.observe(t, "stats")
			if writeErr != nil || n != len(raw) || readErr == nil || observed.RawTCP == 0 || observed.RawUDP == 0 || observed.RejectedUDP != 1 || observed.PlainTCP != 0 || observed.PlainUDP != 0 || observed.ProtocolRawTCP != 0 || observed.UDPBranchRawUDP != 0 || observed.RouterQueries != 0 || observed.DNSQueries != 0 {
				t.Fatal("outer SIP003 layer bypassed exact two inner routes", writeErr, readErr, observed)
			}
			if err := desktopNodeSIP003HTTP(t, f.box, "proxy"); err != nil || f.box.RouterVPNStrategyDNSProof() != nil {
				t.Fatal("outer rejection hid unavailable final protocol paths", err)
			}
			observed = peer.observe(t, "stats")
			if observed.RouterQueries != 1 || observed.DNSQueries != 1 || observed.ProtocolTCP == 0 || observed.UDPBranchUDP == 0 || f.network.Current() {
				t.Fatal("SIP003 positive proof controls skipped final encrypted peers", observed)
			}
		})
	}
