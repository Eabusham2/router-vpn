						t.Fatal("SIP003 UDP failure hid or replaced independently working Router proof", httpErr, dnsErr, observed)
					}
				} else if httpErr == nil || dnsErr == nil || observed.RouterQueries != 0 || observed.DNSQueries != 0 {
					t.Fatal("wrong outer AES key reached a final SIP003 proof", httpErr, dnsErr, observed)
				}
			})
