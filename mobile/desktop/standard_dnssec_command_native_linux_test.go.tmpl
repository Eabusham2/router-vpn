func TestRouterVPNDNSSECCommandWorker(t *testing.T) {
	capture := os.Getenv("ROUTERVPN_DNSSEC_COMMAND_CAPTURE")
	if capture == "" {
		return
	}
	routerVPNDNSSECSHA = os.Getenv("ROUTERVPN_DNSSEC_COMMAND_SHA")
	routerVPNDNSSECBytes = os.Getenv("ROUTERVPN_DNSSEC_COMMAND_BYTES")
	ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
	defer cancel()
	if err := routerVPNRunDNSSECChild(ctx, capture); err != nil {
		t.Fatal(err)
	}
}
func TestRouterVPNDNSSECAuthenticatedCommand(t *testing.T) { dnssecAuthenticatedCommand(t, false) }
func TestRouterVPNDNSSECPrivateTLDCommand(t *testing.T)    { dnssecAuthenticatedCommand(t, true) }
func dnssecAuthenticatedCommand(t *testing.T, privateTLD bool) {
	libraryPath, peerPath := os.Getenv("ROUTERVPN_DNSSEC_NATIVE_LIBRARY"), os.Getenv("ROUTERVPN_DNSSEC_NATIVE_PEER")
	if privateTLD {
		peerPath = os.Getenv("ROUTERVPN_DNSSEC_PRIVATE_TLD_PEER")
	}
	if libraryPath == "" || peerPath == "" {
		t.Fatal("actual pinned library and signed peer required")
	}
	library, err := os.ReadFile(libraryPath)
	if err != nil {
		t.Fatal(err)
	}
	image, err := os.ReadFile("/proc/self/exe")
	if err != nil {
		t.Fatal(err)
	}
	sealedImage := dnssecNativeSeal(t, image)
	if err := sealedImage.Chmod(0500); err != nil {
		t.Fatal(err)
	}
	sealedLibrary := dnssecNativeSeal(t, library)
	peerCommand := exec.Command(peerPath)
	stdin, err := peerCommand.StdinPipe()
	if err != nil {
		t.Fatal(err)
	}
	stdout, err := peerCommand.StdoutPipe()
	if err != nil {
		t.Fatal(err)
	}
	if err = peerCommand.Start(); err != nil {
		t.Fatal(err)
	}
	defer func() {
		stdin.Close()
		done := make(chan error, 1)
		go func() { done <- peerCommand.Wait() }()
		select {
		case <-done:
		case <-time.After(3 * time.Second):
			peerCommand.Process.Kill()
			<-done
			t.Error("signed peer did not join")
		}
	}()
	line, err := bufio.NewReader(stdout).ReadBytes('\n')
	if err != nil {
		t.Fatal(err)
	}
	var info struct {
		Port   int    `json:"port"`
		Anchor string `json:"anchor"`
	}
	if json.Unmarshal(line, &info) != nil || info.Port < 1 || info.Anchor == "" {
		t.Fatal("actual signed authority omitted endpoint/anchor")
	}
	scenarios := []string{"secure", "bogus", "proven-unsigned", "captured-nta", "missing-signature", "cname-proof", "dname-proof", "cross-name-proof", "tampered-cname", "tampered-dname", "foreign-terminal-receipt", "closed-terminal-channel", "zero-anchor-unsigned", "zero-anchor-signed", "zero-anchor-tampered", "positive-island-secure", "positive-island-bogus", "positive-island-missing-signature"}
	if privateTLD {
		scenarios = []string{"root-secure", "root-forged", "root-expired", "root-insecure", "root-nodata", "root-wrong-name", "root-unrelated-nta", "root-alias-nxdomain"}
	}
	for _, scenario := range scenarios {
		t.Run(scenario, func(t *testing.T) {
			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
			defer cancel()
			name := "good.signed.test."
			if scenario == "bogus" || scenario == "captured-nta" || scenario == "zero-anchor-tampered" || scenario == "positive-island-bogus" {
				name = "bogus.signed.test."
			}
			if scenario == "proven-unsigned" {
				name = "host.child.signed.test."
			}
			if scenario == "missing-signature" || scenario == "zero-anchor-unsigned" || scenario == "positive-island-missing-signature" {
				name = "unsigned.signed.test."
			}
			capture := standardengine.DNSSECCapture{Schema: 1, Session: strings.Repeat("a", 32), DeadlineNS: time.Now().Add(8 * time.Second).UnixNano(), PlanSHA256: strings.Repeat("b", 64), Name: name, Type: 1, Anchors: []string{info.Anchor}}
			aliasName := map[string]string{"cname-proof": "alias.signed.test.", "dname-proof": "host.branch.signed.test.", "cross-name-proof": "crossalias.signed.test.", "tampered-cname": "tampered-alias.signed.test.", "tampered-dname": "host.badbranch.signed.test."}[scenario]
			if aliasName != "" {
				capture.Name, capture.Type = aliasName, 5
			}
			if scenario == "captured-nta" {
				capture.Insecure = []string{"signed.test."}
				// Match the shipping plan: an original NTA shadows positive exports
				// for the covered subtree; retaining both would change Unbound precedence.
				capture.Anchors = nil
			}
			if strings.HasPrefix(scenario, "zero-anchor-") || strings.HasPrefix(scenario, "positive-island-") {
				plan := dnssecCommandRootPlan(t, name, info.Anchor, strings.HasPrefix(scenario, "positive-island-"))
				inputs, err := plan.ValidatorInputs()
				if err != nil {
					t.Fatal(err)
				}
				capture.Anchors, capture.Insecure = inputs.TrustAnchors, inputs.InsecureDomains
				capture.PlanSHA256 = standardengine.SHA256(plan.Canonical())
			}
			var privateProof *standardengine.ResolvedPrivateTLDProof
			if privateTLD {
				target := map[string]string{"root-forged": "forged.", "root-expired": "expired.", "root-nodata": "exists.", "root-alias-nxdomain": "aliasproof."}[scenario]
				if target == "" {
					target = "private."
				}
				privateProof = dnssecCommandPrivateProof(t, target, info.Anchor, scenario == "root-unrelated-nta")
				input := privateProof.Inputs()
				capture.Name = privateProof.TLD()
				capture.Type = 1
				capture.Anchors = input.TrustAnchors
				capture.Insecure = input.InsecureDomains
				capture.PlanSHA256 = standardengine.SHA256(privateProof.Canonical())
				if scenario == "root-insecure" {
					capture.Anchors = nil
				}
				if scenario == "root-wrong-name" {
					capture.Name = "other."
				}
			}

			raw, err := capture.Canonical()
			if err != nil {
				t.Fatal(err)
			}
			sum := standardengine.SHA256(raw)
			sealedCapture := dnssecNativeSeal(t, raw)
			parent, err := linuxprocess.CaptureSelf(ctx)
			if err != nil {
				t.Fatal(err)
			}
			defer parent.Close(context.Background())
			directory, err := parent.DuplicateDirectory(ctx)
			if err != nil {
				t.Fatal(err)
			}
			defer directory.Close()
			channel, childChannel, err := linuxprocess.ChannelPair()
			if err != nil {
				t.Fatal(err)
			}
			defer childChannel.Close()
			identity, err := linuxprocess.CaptureSealedImage(sealedImage)
			if err != nil {
				t.Fatal(err)
			}
			padding, err := os.Open("/dev/null")
			if err != nil {
				t.Fatal(err)
			}
			defer padding.Close()
			command := exec.CommandContext(ctx, "/proc/self/fd/3", "-test.run=^TestRouterVPNDNSSECCommandWorker$", "-test.count=1", "-test.timeout=11s")
			command.Env = []string{"PATH=/usr/bin:/bin", "ROUTERVPN_DNSSEC_COMMAND_CAPTURE=" + sum, "ROUTERVPN_DNSSEC_COMMAND_SHA=" + standardengine.SHA256(library), "ROUTERVPN_DNSSEC_COMMAND_BYTES=" + strconv.Itoa(len(library))}
			command.ExtraFiles = []*os.File{sealedImage, padding, padding, padding, childChannel, directory, sealedCapture, sealedLibrary}
			var output bytes.Buffer
			command.Stdout = &output
			command.Stderr = &output
			pidfd := -1
			command.SysProcAttr = &syscall.SysProcAttr{PidFD: &pidfd}
			if err = command.Start(); err != nil {
				t.Fatal(err)
			}
			joined := make(chan struct{})
			var waitErr error
			go func() { waitErr = command.Wait(); close(joined) }()
			defer func() { cancel(); <-joined }()
			if pidfd < 0 {
				t.Fatal("original creation pidfd absent")
			}
			childChannel.Close()
			directory.Close()
			owner, err := linuxprocess.BindCreatedSealedChild(ctx, channel, parent, os.NewFile(uintptr(pidfd), "original-validator-child"), command.Process.Pid, identity, sum)
			if owner != nil {
				defer owner.Close(context.Background())
			}
			if err != nil {
				t.Fatal("actual original child authentication", err)
			}
			queried := 0
			for sequence := uint32(1); sequence <= standardengine.MaxDNSSECQueries+1; sequence++ {
				var frames [][]byte
				kind := ""
				for i := uint32(0); i < 8; i++ {
					body, err := owner.Receive(ctx)
					if err != nil {
						if scenario == "root-alias-nxdomain" {
							select {
							case <-joined:
							case <-ctx.Done():
								t.Fatal("alias target refusal did not join", ctx.Err())
							}
							if queried == 0 || waitErr == nil || !strings.Contains(output.String(), "DNSSEC query escaped its captured name, type or bounded wire shape") {
								t.Fatal("alias negative failed outside exact target authority", err, waitErr, output.String())
							}
							return
						}
						t.Fatal(err)
					}
					frame, err := standardengine.DecodeDNSSECFrame(body)
					if err != nil {
						t.Fatal(err)
					}
					if i == 0 {
						kind = frame.Kind
					}
					frames = append(frames, body)
					if i+1 == frame.Parts {
						break
					}
				}
				message, err := standardengine.DecodeDNSSECFrames(frames, sum, sequence, kind)
				if err != nil {
					t.Fatal(err)
				}
				if kind == "verdict" {
					// Causal receipt barrier: even a clean early exit is not a joined
					// acknowledgement of the original terminal message.
					select {
					case <-joined:
						t.Fatal("validator exited before authenticated terminal receipt", waitErr)
					case <-time.After(250 * time.Millisecond):
					}

					if queried == 0 {
						t.Fatal("validator omitted real signed exchange")
					}
					receipt, err := standardengine.DNSSECTerminalReceipt(sum, sequence, frames)
					if err != nil {
						t.Fatal(err)
					}
					if scenario == "foreign-terminal-receipt" {
						receipt = []byte(`{"foreign":true}`)
					}
					if scenario == "closed-terminal-channel" {
						if err = owner.Close(ctx); err != nil {
							t.Fatal(err)
						}
					}
					written, sendErr := owner.SendTerminalReceipt(ctx, receipt)
					select {
					case <-joined:
					case <-ctx.Done():
						t.Fatal("terminal child did not join", ctx.Err())
					}
					if scenario == "closed-terminal-channel" {
						if written || sendErr == nil || waitErr == nil {
							t.Fatal("failed write or child retirement admitted", written, sendErr, waitErr)
						}
						return
					}
					if scenario == "foreign-terminal-receipt" {
						if waitErr == nil {
							t.Fatal("foreign terminal receipt produced successful child")
						}
						return
					}
					if !written || waitErr != nil {
						t.Fatal("original terminal receipt/exit", written, sendErr, waitErr, output.String())
					}
					want := uint32(1)
					if scenario == "bogus" || scenario == "missing-signature" || scenario == "tampered-cname" || scenario == "tampered-dname" || scenario == "positive-island-bogus" || scenario == "positive-island-missing-signature" {
						want = 3
					}
					if scenario == "proven-unsigned" || scenario == "captured-nta" || strings.HasPrefix(scenario, "zero-anchor-") {
						want = 2
					}
					if privateTLD {
						want = 1
						if scenario == "root-forged" || scenario == "root-expired" {
							want = 3
						}
						if scenario == "root-insecure" {
							want = 2
						}
					}
					if message.State != want {
						t.Fatal("actual crypto verdict changed", message.State)
					}
					if privateTLD {
						q := new(dns.Msg)
						q.SetQuestion(capture.Name, dns.TypeA)
						q.Id = binary.BigEndian.Uint16(message.Packet)
						q.RecursionDesired = true
						raw, err := q.Pack()
						if err != nil {
							t.Fatal(err)
						}
						accepted := privateProof.CheckVerdict(raw, message) == nil
						if accepted != (scenario == "root-secure" || scenario == "root-unrelated-nta") {
							t.Fatal("private-TLD proof meaning escaped original association", scenario, accepted)
						}
					}
					return
				}
				if kind != "query" {
					t.Fatal("foreign child stream kind")
				}
				queried++
				if _, err = capture.Question(message.Packet); err != nil {
					t.Fatal(err)
				}
				connection, err := (&net.Dialer{}).DialContext(ctx, "tcp4", net.JoinHostPort("127.0.0.1", strconv.Itoa(info.Port)))
				if err != nil {
					t.Fatal(err)
				}
				deadline, _ := ctx.Deadline()
				connection.SetDeadline(deadline)
				var header [2]byte
				binary.BigEndian.PutUint16(header[:], uint16(len(message.Packet)))
				if _, err = connection.Write(append(header[:], message.Packet...)); err != nil {
					connection.Close()
					t.Fatal(err)
				}
				if _, err = io.ReadFull(connection, header[:]); err != nil {
					connection.Close()
					t.Fatal(err)
				}
				answer := make([]byte, binary.BigEndian.Uint16(header[:]))
				_, err = io.ReadFull(connection, answer)
				connection.Close()
				if err != nil {
					t.Fatal(err)
				}
				replies, err := standardengine.BuildDNSSECFrames(sum, sequence, "reply", standardengine.DNSSECVerdict{Packet: answer})
				if err != nil {
					t.Fatal(err)
				}
				for _, reply := range replies {
					if err = owner.Send(ctx, reply); err != nil {
						t.Fatal(err)
					}
				}
			}
			t.Fatal(fmt.Errorf("original validator query budget exhausted"))
		})
	}
}

// A source fixture proves the explicit typed policy-to-sealed-child boundary;
// actual retained-daemon decisions are tested independently by OriginalBroker.
func dnssecCommandRootPlan(t *testing.T, name, anchor string, island bool) *standardengine.ResolvedDNSSECPlan {
	t.Helper()
	name = strings.TrimSuffix(name, ".")
	server := standardengine.ResolvedDNS{Address: "192.0.2.53"}
	policy := standardengine.ResolvedPolicy{Schema: 1, Authority: standardengine.ResolvedAuthority{BusID: strings.Repeat("a", 32), UniqueOwner: ":1.42", PID: 42, NamespaceInode: 9, PhysicalSHA256: strings.Repeat("b", 64)}, LLMNRHostname: "original-host", Manager: standardengine.ResolvedScope{DNS: []standardengine.ResolvedDNS{server}, CurrentDNS: &server, DNSSEC: "allow-downgrade", DNSOverTLS: "no"}}
	raw, err := policy.Canonical()
	if err != nil {
		t.Fatal(err)
	}
	digest := standardengine.SHA256(raw)
	root := standardengine.ResolvedRootDSDecision{PolicySHA256: digest, Name: name, DNSSEC: "allow-downgrade", Selected: server, Outcome: "synthetic-unsigned"}
	questions, err := standardengine.ResolvedDNSSECQuestions(policy, name, 0)
	if err != nil {
		t.Fatal(err)
	}
	var rows []standardengine.ResolvedAnchorResult
	for _, q := range questions {
		if q.Name == "." && q.Type == 43 {
			continue
		}
		row := standardengine.ResolvedAnchorResult{PolicySHA256: digest, Name: q.Name, Type: q.Type}
		if island && q.Name == "signed.test" && q.Type == 48 {
			record, err := dns.NewRR(anchor)
			if err != nil {
				t.Fatal(err)
			}
			wire := make([]byte, 8192)
			n, err := dns.PackRR(record, wire, 0, nil, false)
			if err != nil {
				t.Fatal(err)
			}
			row.Present = true
			row.Flags = standardengine.ResolvedAnchorFlags
			row.Records = [][]byte{wire[:n]}
		}
		rows = append(rows, row)
	}
	plan, err := standardengine.BuildResolvedDNSSECPlanWithRootDS(policy, name, 0, root, rows)
	if err != nil {
		t.Fatal(err)
	}
	if err = plan.RecheckWithRootDS(root, rows); err != nil {
		t.Fatal(err)
	}
	return plan
}

func dnssecCommandPrivateProof(t *testing.T, tld, anchor string, unrelated bool) *standardengine.ResolvedPrivateTLDProof {
	t.Helper()
	name := "host." + strings.TrimSuffix(tld, ".")
	server := standardengine.ResolvedDNS{Address: "192.0.2.53"}
	policy := standardengine.ResolvedPolicy{Schema: 1, Authority: standardengine.ResolvedAuthority{BusID: strings.Repeat("a", 32), UniqueOwner: ":1.42", PID: 42, NamespaceInode: 9, PhysicalSHA256: strings.Repeat("b", 64)}, LLMNRHostname: "original-host", Manager: standardengine.ResolvedScope{DNS: []standardengine.ResolvedDNS{server}, CurrentDNS: &server, DNSSEC: "allow-downgrade", DNSOverTLS: "no"}}
	if unrelated {
		policy.Manager.NegativeTrustAnchors = []string{"unrelated"}
	}
	raw, err := policy.Canonical()
	if err != nil {
		t.Fatal(err)
	}
	digest := standardengine.SHA256(raw)
	record, err := dns.NewRR(anchor)
	if err != nil {
		t.Fatal(err)
	}
	key, ok := record.(*dns.DNSKEY)
	if !ok || key.Hdr.Name != "." {
		t.Fatal("root authority changed")
	}
	ds := key.ToDS(dns.SHA256)
	wire := make([]byte, 8192)
	n, err := dns.PackRR(ds, wire, 0, nil, false)
	if err != nil {
		t.Fatal(err)
	}
	observed := standardengine.ResolvedAnchorResult{PolicySHA256: digest, Name: ".", Type: 43, Present: true, Flags: standardengine.ResolvedAnchorFlags, Records: [][]byte{wire[:n]}}
	root := standardengine.ResolvedRootDSDecision{PolicySHA256: digest, Name: name, DNSSEC: "allow-downgrade", Selected: server, Outcome: "positive", Root: &observed}
	questions, err := standardengine.ResolvedDNSSECQuestions(policy, name, 0)
	if err != nil {
		t.Fatal(err)
	}
	var rows []standardengine.ResolvedAnchorResult
	for _, q := range questions {
		if q.Name == "." && q.Type == 43 {
			continue
		}
		rows = append(rows, standardengine.ResolvedAnchorResult{PolicySHA256: digest, Name: q.Name, Type: q.Type})
	}
	plan, err := standardengine.BuildResolvedDNSSECPlanWithRootDS(policy, name, 0, root, rows)
	if err != nil {
		t.Fatal(err)
	}
	proof, err := standardengine.NewResolvedPrivateTLDProof(policy, plan, 1, strings.Repeat("c", 64))
	if err != nil {
		t.Fatal(err)
	}
	return proof
}
