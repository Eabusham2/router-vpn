// Each UDP mapping belongs to the original authenticated SOCKS control; retiring
// that control cancels and joins its encrypted forwarding before its revoker returns.
type desktopImportedSOCKSEntryLayer struct {
	peer       desktopExternalInstalledSSPeer
	routes     *desktopImportedSOCKSLayerRoutes
	retired    atomic.Int64
	ciphertext desktopImportedDatagramObservation
}

func desktopStartImportedSOCKSEntryLayer(t *testing.T, ctx context.Context, socks *desktopExternalInstalledSOCKSPeer, raw map[string]any, privateTarget, physical, mode, fault string) *desktopImportedSOCKSEntryLayer {
	t.Helper()
	host, _, err := net.SplitHostPort(privateTarget)
	if err != nil {
		t.Fatal(err)
	}
	layerCtx, cancel := context.WithCancel(ctx)
	routes := &desktopImportedSOCKSLayerRoutes{parent: layerCtx, control: physical, private: host, leases: map[string]*desktopImportedSOCKSRelayLease{}, physical: map[string]string{}}
	owner := &desktopImportedSOCKSEntryLayer{routes: routes}
	server := &desktopNodeLayerServer{ctx: layerCtx, cancel: cancel, connections: map[io.Closer]bool{}, routes: []desktopNodeLayerRoute{{Network: "tcp", Destination: privateTarget, Physical: physical}}, ownedUDP: routes.acquire}
	socks.mu.Lock()
	socks.entryRelay = func(control net.Conn, packet net.PacketConn) (net.Addr, func(), error) {
		address, revoke, err := routes.relay(control, packet)
		if err != nil {
			return nil, nil, err
		}
		var once sync.Once
		return address, func() { once.Do(func() { revoke(); owner.retired.Add(1) }) }, nil
	}
	socks.mu.Unlock()
	providerFault := ""
	if fault == "entry-layer-key" {
		providerFault = "layer-key"
	}
	if fault == "entry-whitening" {
		providerFault = "whitening"
	}
	owner.peer = desktopImportedSOCKSLayerProvider(t, server, raw, providerFault, &owner.ciphertext)
	return owner
}
func (o *desktopImportedSOCKSEntryLayer) close(t *testing.T) {
	t.Helper()
	o.routes.mu.Lock()
	remaining := len(o.routes.leases)
	o.routes.mu.Unlock()
	o.routes.close()
	o.peer.close()
	if remaining != 0 {
		t.Error("encrypted entry retained an authenticated SOCKS association", remaining)
	}
}

