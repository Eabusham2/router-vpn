package main

import (
	"bytes"
	"crypto/sha256"
	"encoding/json"
	"errors"
	"os"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/applexray"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/hopmeasure"
)

type routerVPNDesktopLatencyRequest struct {
	Schema       int    `json:"schema"`
	Session      string `json:"session_id"`
	SourceSHA256 string `json:"source_sha256"`
	ConfigSHA256 string `json:"config_sha256"`
	Generation   uint64 `json:"generation"`
	Request      string `json:"request_id"`
	NodeID       string `json:"node_id"`
}

type routerVPNDesktopLatencyRecord struct {
	routerVPNDesktopLatencyRequest
	Status hopmeasure.Status `json:"status"`
}

type routerVPNDesktopLatencyProvider interface {
	DesktopLatency() (*hopmeasure.Service, error)
}

// The service uses the proved Box's actual DNS router and final outbound. The
// callback refers to that immutable proof, not this owner's mutex: service
// cancellation and Close may call Identity while holding their own locks.
func (n *routerVPNExternalNative) DesktopLatency() (*hopmeasure.Service, error) {
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.box == nil || n.boxClosed || n.proof == nil || !n.proof.Healthy() {
		return nil, routerVPNExternalFailure
	}
	if n.latency == nil {
		proof := n.proof
		service, err := n.box.RouterVPNExternalHopMeasurement(proof, n.source, n.capture, n.session, proof.Healthy)
		if err != nil {
			return nil, routerVPNExternalFailure
		}
		n.latency = service
	}
	return n.latency, nil
}

func (n *routerVPNTorNative) DesktopLatency() (*hopmeasure.Service, error) {
	if !n.Healthy() {
		return nil, routerVPNTorFailure
	}
	n.mu.Lock()
	tor := n.tor
	n.mu.Unlock()
	return tor.LatencyMeasurement()
}

// Only the native command loop reads, retires and publishes mailbox files.
// The retained service owns its workers and sockets, and reports Drained only
// after they have really joined. A busy measurement does not stop the VPN.
type routerVPNDesktopLatencyFiles struct {
	files   *routerVPNExternalFiles
	service *hopmeasure.Service
	record  routerVPNDesktopLatencyRecord
	inputs  map[string]routerVPNDesktopPathInput
	used    map[string]bool
	started bool
}

func routerVPNOpenDesktopLatency(files *routerVPNExternalFiles, owner any, session, source, config, node string) (*routerVPNDesktopLatencyFiles, error) {
	provider, ok := owner.(routerVPNDesktopLatencyProvider)
	if !ok {
		// Fixture or older owners must not manufacture a native Latency capability.
		return nil, nil
	}
	service, err := provider.DesktopLatency()
	if err != nil || service == nil {
		return nil, routerVPNExternalFailure
	}
	return routerVPNOpenDesktopLatencyService(files, service, session, source, config, node)
}

// Both ordinary external graphs and the standalone Tor owner pass their actual
// proved native service here. The file protocol and drain contract remain one
// implementation; no protocol is converted into the other proof interface.
func routerVPNOpenDesktopLatencyService(files *routerVPNExternalFiles, service *hopmeasure.Service, session, source, config, node string) (*routerVPNDesktopLatencyFiles, error) {
	if files == nil || service == nil {
		return nil, routerVPNExternalFailure
	}
	f := &routerVPNDesktopLatencyFiles{files: files, service: service, inputs: map[string]routerVPNDesktopPathInput{}, used: map[string]bool{}, record: routerVPNDesktopLatencyRecord{
		routerVPNDesktopLatencyRequest: routerVPNDesktopLatencyRequest{Schema: 1, Session: session, SourceSHA256: source, ConfigSHA256: config, NodeID: node},
	}}
	if json.Unmarshal([]byte(service.StatusJSON()), &f.record.Status) != nil || f.record.Status.Request != "" || f.record.Status.Stage != "idle" || !f.record.Status.Drained {
		return nil, routerVPNExternalFailure
	}
	f.record.Status.Complete, f.record.Status.Drained = true, true
	return f, f.publish()
}

func (f *routerVPNDesktopLatencyFiles) read(name string, matches func(routerVPNDesktopLatencyRequest) bool) (routerVPNDesktopLatencyRequest, bool) {
	raw, err := f.files.read(name, 2048)
	if err != nil {
		return routerVPNDesktopLatencyRequest{}, false
	}
	if _, err := applexray.Object(raw); err != nil {
		return routerVPNDesktopLatencyRequest{}, false
	}
	var request routerVPNDesktopLatencyRequest
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.DisallowUnknownFields()
	base := f.record.routerVPNDesktopLatencyRequest
	if decoder.Decode(&request) != nil || request.Schema != 1 || request.Session != base.Session || request.SourceSHA256 != base.SourceSHA256 || request.ConfigSHA256 != base.ConfigSHA256 || request.Generation == 0 || !routerVPNExternalSession.MatchString(request.Request) ||
		(request.NodeID != base.NodeID) || !matches(request) {
		return routerVPNDesktopLatencyRequest{}, false
	}
	info, err := f.files.root.Lstat(name)
	if err != nil {
		return routerVPNDesktopLatencyRequest{}, false
	}
	again, err := f.files.read(name, 2048)
	if err != nil || !bytes.Equal(raw, again) {
		return routerVPNDesktopLatencyRequest{}, false
	}
	input := routerVPNDesktopPathInput{info: info, digest: sha256.Sum256(raw)}
	if previous, exists := f.inputs[name]; exists && (!os.SameFile(previous.info, info) || previous.digest != input.digest) {
		return routerVPNDesktopLatencyRequest{}, false
	}
	f.inputs[name] = input
	return request, true
}

func (f *routerVPNDesktopLatencyFiles) retire() error {
	for name, owned := range f.inputs {
		info, err := f.files.root.Lstat(name)
		raw, readErr := f.files.read(name, 2048)
		if err != nil || readErr != nil || !os.SameFile(info, owned.info) || sha256.Sum256(raw) != owned.digest {
			return routerVPNExternalFailure
		}
		if err := f.files.root.Remove(name); err != nil {
			return routerVPNExternalFailure
		}
		delete(f.inputs, name)
	}
	return nil
}

func (f *routerVPNDesktopLatencyFiles) publish() error {
	return f.files.publish("latency-status.json", f.record)
}

func (f *routerVPNDesktopLatencyFiles) tick() error {
	if f == nil {
		return nil
	}
	if f.record.Status.Complete && f.record.Status.Drained {
		request, ok := f.read("latency-request.json", func(request routerVPNDesktopLatencyRequest) bool {
			return f.record.Generation != ^uint64(0) && request.Generation == f.record.Generation+1
		})
		if !ok {
			// A parent can cancel after an uncertain write or before its queued
			// request arrives. Retire the nonce without opening any sockets.
			request, ok = f.read("latency-cancel.json", func(request routerVPNDesktopLatencyRequest) bool {
				return f.record.Generation != ^uint64(0) && request.Generation == f.record.Generation+1
			})
		}
		if ok {
			f.record = routerVPNDesktopLatencyRecord{routerVPNDesktopLatencyRequest: request, Status: hopmeasure.Status{
				Request: request.Request, Stage: "starting", Results: []hopmeasure.Result{},
			}}
			f.started = false
		}
	}
	if f.record.Generation == 0 {
		return nil
	}
	_, cancelled := f.read("latency-cancel.json", func(request routerVPNDesktopLatencyRequest) bool {
		return request == f.record.routerVPNDesktopLatencyRequest
	})
	if !f.started && !f.record.Status.Complete {
		request := f.record.Request
		if cancelled || f.used[request] || len(f.used) >= 256 {
			f.service.Cancel(request)
			f.record.Status.Stage, f.record.Status.Failure = "cancelled", "Latency request was cancelled or already retired"
			f.record.Status.Complete, f.record.Status.Drained = true, true
		} else if err := f.service.StartLatency(request, f.record.NodeID); err != nil {
			f.record.Status.Stage, f.record.Status.Failure = "failed", "Native Latency activity is busy or its captured proof retired"
			f.record.Status.Complete, f.record.Status.Drained = true, true
		} else {
			f.started = true
		}
		if len(f.used) < 256 {
			f.used[request] = true
		}
	}
	if f.started {
		if cancelled {
			f.service.Cancel(f.record.Request)
		}
		var status hopmeasure.Status
		raw := f.service.StatusJSON()
		if len(raw) > 64<<10 || json.Unmarshal([]byte(raw), &status) != nil || status.Request != f.record.Request {
			return routerVPNExternalFailure
		}
		f.record.Status = status
	}
	if f.record.Status.Complete && f.record.Status.Drained {
		if err := f.retire(); err != nil {
			return err
		}
	}
	return f.publish()
}

// Called only after owner.Close has acknowledged all Latency workers and sockets.
// Preserve any replacement input; its pathname is never cleanup authority.
func (f *routerVPNDesktopLatencyFiles) close() error {
	if f == nil {
		return nil
	}
	if err := f.service.Close(); err != nil {
		return err
	}
	if f.started {
		if json.Unmarshal([]byte(f.service.StatusJSON()), &f.record.Status) != nil || !f.record.Status.Drained {
			return routerVPNExternalFailure
		}
	} else {
		f.record.Status.Stage, f.record.Status.Failure = "invalidated", "The captured native Latency path ended"
		f.record.Status.Complete, f.record.Status.Drained, f.record.Status.Results = true, true, []hopmeasure.Result{}
	}
	return errors.Join(f.retire(), f.publish())
}
