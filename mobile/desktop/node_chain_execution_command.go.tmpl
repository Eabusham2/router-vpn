package main

import (
	"encoding/json"
	"errors"
	"os"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

// Called only after the original platform parent authenticates. The physical
// source deliberately remains unchanged by execution; the distinct preparation
// digest is therefore mandatory to bind Server versus Compare as well as the
// original private graph. No Local parser fallback is permitted.
func routerVPNNodeChainExecutionCommandCapture(files *routerVPNExternalFiles, session, config, physicalSource, executionSource, target string) (*mobilemultihop.NodeChainExecutionPreparation, error) {
	if files == nil || files.root == nil || !routerVPNExternalSession.MatchString(session) ||
		!routerVPNExternalSource.MatchString(config) || !routerVPNExternalSource.MatchString(physicalSource) ||
		!routerVPNExternalSource.MatchString(executionSource) || target != "linux" && target != "windows" && target != "darwin" {
		return nil, routerVPNExternalFailure
	}
	for _, name := range []string{"node-source.json", "node-chain-source.json", "imported-source.json", "node-chain-socks-source.json", "node-chain-connect-source.json"} {
		if _, err := files.root.Lstat(name); !errors.Is(err, os.ErrNotExist) {
			return nil, routerVPNExternalFailure
		}
	}
	raw, err := files.read("node-chain-execution-source.json", mobilemultihop.NodeChainInputLimit)
	if err != nil {
		return nil, err
	}
	var header struct {
		Schema json.RawMessage `json:"schema"`
	}
	if json.Unmarshal(raw, &header) != nil {
		clear(raw)
		return nil, routerVPNExternalFailure
	}
	var prep *mobilemultihop.NodeChainExecutionPreparation
	if string(header.Schema) == "4" {
		prep, err = mobilemultihop.ParseDesktopNodeChainCONNECTExecutionPreparation(string(raw))
	} else {
		prep, err = mobilemultihop.ParseDesktopNodeChainExecutionPreparation(string(raw))
	}
	clear(raw)
	if err != nil || prep == nil || prep.SourceSHA256() != executionSource || prep.ConfigSHA256() != config {
		return nil, routerVPNExternalFailure
	}
	policy, err := routerVPNDesktopExecutionPhysicalPolicy(prep)
	if err != nil {
		return nil, err
	}
	_, meta, _, err := policy.PhysicalReadValidated()
	if err != nil || meta.Kind != routerVPNDesktopExecutionPhysicalKind(prep) || meta.TargetOS != target || meta.SessionID != session || meta.SourceSHA256 != physicalSource || meta.ConfigSHA256 != config {
		return nil, routerVPNExternalFailure
	}
	staged, err := files.read("sing-box.json", 4<<20)
	defer clear(staged)
	if err != nil || string(staged) != prep.Config() || policy.Validate() != nil {
		return nil, routerVPNExternalFailure
	}
	return prep, nil
}

// This selects one concrete constructor family. A failed typed capture cannot
// fall back to paired authority or use a caller-created metadata wrapper.
func routerVPNDesktopExecutionPhysicalPolicy(prep *mobilemultihop.NodeChainExecutionPreparation) (mobilemultihop.DesktopPhysicalPolicy, error) {
	if prep == nil {
		return nil, routerVPNExternalFailure
	}
	if prep.RequiresCONNECTExecutionObserver() {
		return prep.CONNECTDesktopPhysicalPolicy()
	}
	return prep.DesktopPhysicalPolicy()
}

func routerVPNDesktopExecutionPhysicalKind(prep *mobilemultihop.NodeChainExecutionPreparation) string {
	if prep == nil {
		return ""
	}
	if prep.RequiresCONNECTExecutionObserver() {
		return "node-chain-connect-execution"
	}
	return "node-chain-execution"
}
