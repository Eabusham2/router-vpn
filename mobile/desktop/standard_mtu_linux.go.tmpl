//go:build linux

package main

import (
	"context"
	"errors"
	box "github.com/sagernet/sing-box"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/adapter/inbound"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemtu"
	"github.com/sagernet/sing-box/protocol/tun"
	"github.com/sagernet/sing-box/routervpn/desktopnetwork"
	"github.com/sagernet/sing-box/routervpn/standardengine"
	"time"
)

type routerVPNStandardMTUBackend struct {
	instance *box.Box
	tag      string
}
type routerVPNStandardMTUTransaction struct {
	transaction *inbound.RouterVPNTunTransaction
}

func (b *routerVPNStandardMTUBackend) Current(ctx context.Context) (any, error) {
	current, present, err := adapter.RouterVPNInboundContext(ctx, b.instance.Inbound(), b.tag)
	if err != nil || !present {
		return nil, errors.Join(err, errors.New("standard MTU lost its original manager reader"))
	}
	return current, nil
}
func (b *routerVPNStandardMTUBackend) Change(ctx context.Context, expected any, mtu int) (standardengine.NativeMTUTransaction, error) {
	reader, ok := expected.(adapter.Inbound)
	if !ok {
		return nil, errors.New("standard MTU omitted actual original inbound")
	}
	tx, err := b.instance.RouterVPNChangeMTUTransaction(ctx, reader, mtu)
	if tx == nil {
		return nil, err
	}
	return &routerVPNStandardMTUTransaction{tx}, err
}
func (b *routerVPNStandardMTUBackend) Retry(ctx context.Context, transaction standardengine.NativeMTUTransaction) error {
	tx, ok := transaction.(*routerVPNStandardMTUTransaction)
	if !ok || tx == nil || tx.transaction == nil {
		return errors.New("standard MTU cleanup changed its original native transaction")
	}
	return b.instance.RouterVPNRetryMTUTransaction(ctx, tx.transaction)
}
func (t *routerVPNStandardMTUTransaction) Current() any { return t.transaction.Current() }
func (t *routerVPNStandardMTUTransaction) Evidence() [standardengine.OperationReaders]standardengine.NativeMTUEvidence {
	var result [standardengine.OperationReaders]standardengine.NativeMTUEvidence
	for index, e := range t.transaction.Evidence() {
		if index >= len(result) {
			break
		}
		result[index] = standardengine.NativeMTUEvidence{Reader: e.Inbound, Ready: e.Ready, Retirement: e.Retirement, Retired: e.Retired, Pending: e.Pending}
	}
	return result
}

// The startup receipt observes native ownership; it does not grant replacement
// authority. Claim that same ready reader through its bounded native API before
// advertising FD11 readiness, retaining the creating service's original guard.
func routerVPNStandardMTUAdmit(ctx context.Context, instance *box.Box, tag string, original adapter.Inbound, ready string, guard func(context.Context) error) error {
	if ctx == nil || instance == nil || original == nil || guard == nil || tag == "" {
		return errors.New("standard MTU admission lost its original startup owner")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if _, bounded := ctx.Deadline(); !bounded {
		return errors.New("standard MTU admission requires its original startup deadline")
	}
	reader, ok := original.(*tun.Inbound)
	if !ok || reader.Tag() != tag {
		return errors.New("standard MTU admission requires its original native TUN reader")
	}
	backend := &routerVPNStandardMTUBackend{instance, tag}
	current, err := backend.Current(ctx)
	if err != nil || current != original {
		return errors.Join(err, errors.New("standard MTU admission changed its original Box reader"))
	}
	receipt, err := desktopnetwork.ParseDesktopNetworkReceipt(ready)
	if err != nil || receipt.TargetOS != "linux" {
		return errors.Join(err, errors.New("standard MTU admission lost its original native receipt"))
	}
	name, index, mtu, err := reader.RouterVPNDesktopMTUContext(ctx, guard)
	if err != nil {
		return err
	}
	if name != receipt.Name || uint32(index) != receipt.Index || mtu != receipt.MTU {
		return errors.New("standard MTU claim differs from its original startup reader")
	}
	actual, err := reader.RouterVPNDesktopNetworkReceiptContext(ctx)
	if err != nil || actual != ready {
		return errors.Join(err, errors.New("standard MTU claim changed its original successful-call receipt"))
	}
	current, err = backend.Current(ctx)
	if err != nil || current != original {
		return errors.Join(err, errors.New("standard MTU claim replaced its original Box reader"))
	}
	return errors.Join(guard(ctx), ctx.Err())
}

func routerVPNStandardMTUWorker(ctx context.Context, file *standardengine.OperationFile, instance *box.Box, tag string, original adapter.Inbound, ready string, guard func(context.Context) error) (*standardengine.NativeMTUWorker, error) {
	if err := routerVPNStandardMTUAdmit(ctx, instance, tag, original, ready, guard); err != nil {
		return nil, err
	}
	return standardengine.NewNativeMTUWorkerWithRunCleanup(file, &routerVPNStandardMTUBackend{instance, tag}, original, ready, guard,
		func(ctx context.Context, deadline time.Time, cleanup time.Duration, provider func(context.Context) (time.Time, error)) (context.Context, context.CancelFunc, error) {
			// Retain the original admitted optimizer deadline and shared cleanup
			// clock across all native transactions.
			return mobilemtu.WithCapturedOperationContextProvider(ctx, deadline, cleanup, provider)
		}, mobilemtu.OperationCleanupContext)
}

func (b *routerVPNStandardMTUBackend) Observe(ctx context.Context, expected any) (string, int, error) {
	current, err := b.Current(ctx)
	if err != nil || current != expected {
		return "", 0, errors.Join(err, errors.New("standard run replaced exact original native reader"))
	}
	reader, ok := expected.(interface {
		RouterVPNDesktopMTUReceiptContext(context.Context) (string, string, error)
	})
	if !ok {
		return "", 0, errors.New("standard run lacks original bounded receipt capability")
	}
	ready, retired, err := reader.RouterVPNDesktopMTUReceiptContext(ctx)
	if err != nil || ready == "" || retired != "" {
		return "", 0, errors.Join(err, errors.New("standard run lost live actual Ready"))
	}
	receipt, err := desktopnetwork.ParseDesktopNetworkReceipt(ready)
	if err != nil {
		return "", 0, err
	}
	again, err := b.Current(ctx)
	if err != nil || again != expected {
		return "", 0, errors.Join(err, errors.New("standard run changed original native reader during observation"))
	}
	return ready, receipt.MTU, ctx.Err()
}
