func (t *NativeTun) routervpnNetworkInterface() (*net.Interface, uint64, error) {
	current, err := t.routervpnLinuxInterface()
	if err != nil || current.Index != t.routervpnOwnedIndex || t.routervpnOwnedIndex < 1 {
		return nil, 0, errors.New("native Linux routing receipt lost its original TUN")
	}
	return current, 0, nil
}

func routervpnLinuxNetworkObjects(kind string) ([]DesktopNetworkObject, error) {
	return routervpnLinuxNetworkObjectsContext(context.Background(), kind)
}

func (t *NativeTun) routervpnLinuxNetworkObjects(kind string) ([]DesktopNetworkObject, error) {
	ctx := t.options.RouterVPNNetworkContext
	if ctx == nil {
		ctx = context.Background()
	}
	return routervpnLinuxNetworkObjectsContext(ctx, kind)
}

func routervpnLinuxNetworkObjectsContext(ctx context.Context, kind string) ([]DesktopNetworkObject, error) {
	request, response := syscall.RTM_GETROUTE, uint16(syscall.RTM_NEWROUTE)
	if kind == "rule" {
		request, response = syscall.RTM_GETRULE, syscall.RTM_NEWRULE
	}
	messages, err := linuxDump(ctx, request, response)
	if err != nil {
		return nil, err
	}
	var objects []DesktopNetworkObject
	for _, message := range messages {
		object, err := ParseDesktopLinuxNetworkObject(kind, message.Data)
		if err != nil {
			return nil, err
		}
		objects = append(objects, object)
	}
	return objects, ctx.Err()
}

// Route additions can overlap the kernel's asynchronous publication of the
// configured or automatically generated IPv6 address's LOCAL host route. Keep
// the original interface and complete addresses alongside the earlier routing
// inventory. They are evidence only; neither readback changes configuration.
type routerVPNLinuxRouteAddress struct {
	prefix                         netip.Prefix
	flags, scope, preferred, valid int
	label, peer, broadcast         string
}

type routerVPNLinuxRouteOwner struct {
	index, mtu     int
	name, hardware string
	flags          net.Flags
	configured     []netip.Prefix
	addresses      []routerVPNLinuxRouteAddress
}

type routerVPNLinuxRoutingBefore struct {
	objects []DesktopNetworkObject
	owner   routerVPNLinuxRouteOwner
}

func routervpnLinuxIPPrefix(value *net.IPNet) (netip.Prefix, bool) {
	if value == nil {
		return netip.Prefix{}, false
	}
	address, ok := netip.AddrFromSlice(value.IP)
	bits, size := value.Mask.Size()
	if !ok {
		return netip.Prefix{}, false
	}
	address = address.Unmap()
	if size != address.BitLen() || bits < 0 || !address.IsValid() || address.IsUnspecified() || address.IsMulticast() {
		return netip.Prefix{}, false
	}
	return netip.PrefixFrom(address, bits), true
}

func (t *NativeTun) routervpnLinuxRouteOwner() (routerVPNLinuxRouteOwner, error) {
	bad := errors.New("native Linux route add lost its captured interface or addresses")
	current, _, err := t.routervpnNetworkInterface()
	if err != nil || current == nil || current.Name != t.options.Name || current.MTU != int(t.options.MTU) || current.Flags&net.FlagUp == 0 ||
		t.options.FileDescriptor != 0 || t.options.NetNs != "" || t.options.EXP_ExternalConfiguration {
		return routerVPNLinuxRouteOwner{}, bad
	}
	owner := routerVPNLinuxRouteOwner{index: current.Index, name: current.Name, mtu: current.MTU, flags: current.Flags, hardware: string(current.HardwareAddr)}
	owner.configured = append(append([]netip.Prefix{}, t.options.Inet4Address...), t.options.Inet6Address...)
	if len(owner.configured) == 0 || len(owner.configured) > 32 {
		return routerVPNLinuxRouteOwner{}, bad
	}
	sort.Slice(owner.configured, func(i, j int) bool { return owner.configured[i].String() < owner.configured[j].String() })
	expected := make(map[netip.Prefix]bool)
	for _, prefix := range owner.configured {
		if !prefix.IsValid() || prefix.Addr().Is4In6() || prefix.Addr().IsUnspecified() || prefix.Addr().IsMulticast() || expected[prefix] {
			return routerVPNLinuxRouteOwner{}, bad
		}
		expected[prefix] = true
	}
	addresses, err := t.routervpnLinuxAddresses(current.Index)
	if err != nil || len(addresses) == 0 || len(addresses) > 32 {
		return routerVPNLinuxRouteOwner{}, bad
	}
	seen := make(map[netip.Prefix]bool)
	for _, address := range addresses {
		prefix, ok := routervpnLinuxIPPrefix(address.IPNet)
		if !ok || address.LinkIndex != current.Index || seen[prefix] || !expected[prefix] && !prefix.Addr().IsLinkLocalUnicast() ||
			address.Flags&syscall.IFA_F_DADFAILED != 0 {
			return routerVPNLinuxRouteOwner{}, bad
		}
		seen[prefix] = true
		row := routerVPNLinuxRouteAddress{prefix: prefix, flags: address.Flags, scope: address.Scope, preferred: address.PreferedLft, valid: address.ValidLft, label: address.Label}
		if address.Peer != nil {
			peer, ok := routervpnLinuxIPPrefix(address.Peer)
			if !ok {
				return routerVPNLinuxRouteOwner{}, bad
			}
			row.peer = peer.String()
		}
		if len(address.Broadcast) != 0 {
			broadcast, ok := netip.AddrFromSlice(address.Broadcast)
			if !ok {
				return routerVPNLinuxRouteOwner{}, bad
			}
			row.broadcast = broadcast.Unmap().String()
		}
		owner.addresses = append(owner.addresses, row)
	}
	for prefix := range expected {
		if !seen[prefix] {
			return routerVPNLinuxRouteOwner{}, bad
		}
	}
	sort.Slice(owner.addresses, func(i, j int) bool { return owner.addresses[i].prefix.String() < owner.addresses[j].prefix.String() })
	after, _, err := t.routervpnNetworkInterface()
	if err != nil || after == nil || after.Index != current.Index || after.Name != current.Name || after.MTU != current.MTU ||
		after.Flags != current.Flags || string(after.HardwareAddr) != owner.hardware {
		return routerVPNLinuxRouteOwner{}, bad
	}
	return owner, nil
}

func (t *NativeTun) routervpnLinuxBefore(kind string) routerVPNLinuxRoutingBefore {
	objects, err := t.routervpnLinuxNetworkObjects(kind)
	if err != nil {
		t.routervpnNetworkFailure(fmt.Errorf("native Linux %s before inventory: %w", kind, err))
		return routerVPNLinuxRoutingBefore{}
	}
	// A non-nil empty slice preserves a successful empty inventory.
	if objects == nil {
		objects = []DesktopNetworkObject{}
	}
	before := routerVPNLinuxRoutingBefore{objects: objects}
	if kind == "route" {
		before.owner, err = t.routervpnLinuxRouteOwner()
		if err != nil {
			t.routervpnNetworkFailure(err)
			return routerVPNLinuxRoutingBefore{}
		}
	}
	return before
}

func (t *NativeTun) routervpnLinuxAdded(kind string, capture routerVPNLinuxRoutingBefore) {
	before := capture.objects
	after, err := t.routervpnLinuxNetworkObjects(kind)
	if err != nil {
		t.routervpnNetworkFailure(fmt.Errorf("native Linux %s after inventory: %w", kind, err))
		return
	}
	if before == nil {
		t.routervpnNetworkFailure(errors.New("native Linux routing call has no complete before/after readback"))
		return
	}
	counts := make(map[string]int)
	for _, object := range before {
		counts[object.Key()]++
	}
	var added []DesktopNetworkObject
	for _, object := range after {
		key := object.Key()
		if counts[key] > 0 {
			counts[key]--
		} else {
			added = append(added, object)
		}
	}
	var removed []DesktopNetworkObject
	for _, object := range before {
		if counts[object.Key()] != 0 {
			removed = append(removed, object)
		}
	}
	if kind == "rule" && len(removed) != 0 {
		if t.routervpnLinuxResolvedRules(removed, added) {
			return
		}
	}
	for _, count := range counts {
		if count != 0 {
			t.routervpnLinuxAdditionFailure(kind, fmt.Errorf("native Linux routing inventory changed during its own add (kind=%s removed=%d added=%d)", kind, len(removed), len(added)), added, removed)
			return
		}
	}
	valid := len(added) == 1
	var observation *routerVPNLinuxRouteAdditionObservation
	if kind == "route" {
		owner, ownerErr := t.routervpnLinuxRouteOwner()
		valid = ownerErr == nil && routervpnLinuxRouteAdditions(capture.owner, owner, before, added)
		observation = &routerVPNLinuxRouteAdditionObservation{before: capture.owner, after: owner, ownerError: ownerErr != nil}
	}
	if !valid {
		t.routervpnLinuxAdditionFailure(kind, errors.New("native Linux routing call has no unique owned addition"), added, removed, observation)
		return
	}
	for _, object := range before {
		for _, addition := range added {
			if object == addition {
				t.routervpnNetworkFailure(errors.New("native Linux routing call duplicated an existing object"))
				return
			}
		}
	}
	// Every admitted byte, including the separately proved address route, is
	// retained atomically. A later receipt must find each exact object again.
	t.routervpnLinuxRecordAdditions(added)
}

func (t *NativeTun) routervpnLinuxRecordAdditions(added []DesktopNetworkObject) {
	t.routervpnNetwork.mu.Lock()
	defer t.routervpnNetwork.mu.Unlock()
	if t.routervpnNetwork.failure != nil {
		return
	}
	seen := make(map[string]bool)
	for _, object := range added {
		key := object.Key()
		if _, exists := t.routervpnNetwork.objects[key]; exists || seen[key] {
			t.routervpnNetwork.failure = errors.New("native TUN routing call reused an earlier object")
			return
		}
		seen[key] = true
	}
	if t.routervpnNetwork.objects == nil {
		t.routervpnNetwork.objects = make(map[string]DesktopNetworkObject)
	}
	for _, object := range added {
		t.routervpnNetwork.objects[object.Key()] = object
	}
}

func routervpnLinuxSameRouteOwner(before, after routerVPNLinuxRouteOwner) bool {
	if before.index < 1 || before.index != after.index || before.name == "" || before.name != after.name || before.mtu != after.mtu ||
		before.mtu < 576 || before.flags != after.flags || before.flags&net.FlagUp == 0 || before.hardware != after.hardware ||
		len(before.configured) == 0 || !slices.Equal(before.configured, after.configured) || len(before.addresses) == 0 || len(before.addresses) != len(after.addresses) {
		return false
	}
	for i, old := range before.addresses {
		now := after.addresses[i]
		// DAD completion may only clear TENTATIVE. Address replacement, a new
		// tentative state, any other flag change, or failed DAD is not proof.
		if old.flags&syscall.IFA_F_DADFAILED != 0 || now.flags&syscall.IFA_F_DADFAILED != 0 ||
			old.flags&syscall.IFA_F_TENTATIVE == 0 && now.flags&syscall.IFA_F_TENTATIVE != 0 {
			return false
		}
		old.flags &^= syscall.IFA_F_TENTATIVE
		now.flags &^= syscall.IFA_F_TENTATIVE
		if old != now {
			return false
		}
	}
	return true
}

// Match the complete canonical body emitted for an IPv6 LOCAL /128 address
// route: AF_INET6, no source prefix/TOS, table LOCAL, protocol KERNEL, scope
// UNIVERSE, type LOCAL, flags zero, and exactly DST/OIF/PRIORITY/TABLE/PREF.
// Unknown attributes, alternate metrics, gateways, nexthops and cache flags
// cannot borrow this qualification. Cache ages were already normalized by
// the same canonical decoder used by the parent.
func routervpnLinuxKernelLocalAddressRoute(object DesktopNetworkObject, owner routerVPNLinuxRouteOwner) bool {
	if object.Kind != "route" || object.Family != 6 || object.Index != uint32(owner.index) || object.LUID != 0 ||
		object.Table != 255 || object.Priority != 0 || object.Gateway != "" || object.Flags != 0 || object.MTU != 0 {
		return false
	}
	prefix, err := netip.ParsePrefix(object.Destination)
	if err != nil || prefix.String() != object.Destination || prefix.Bits() != 128 || !prefix.Addr().Is6() || prefix.Addr().Is4In6() {
		return false
	}
	matches := 0
	for _, address := range owner.addresses {
		if address.prefix.Addr() != prefix.Addr() {
			continue
		}
		flags := syscall.IFA_F_PERMANENT
		if !slices.Contains(owner.configured, address.prefix) {
			// Linux addrconf creates a permanent /64 link-local address with
			// IFA_F_STABLE_PRIVACY (UAPI 0x800) in stable/random generation modes.
			// Its LOCAL /128 route can appear when DAD completes during this
			// add. Both complete owner snapshots must already contain the same
			// address; only TENTATIVE may clear. No arbitrary unselected address
			// or ordinary link-local prefix route receives this qualification.
			if !address.prefix.Addr().IsLinkLocalUnicast() || address.prefix.Bits() != 64 {
				return false
			}
			flags |= 0x800
		}
		scope := 0
		if address.prefix.Addr().IsLinkLocalUnicast() {
			scope = 253
		}
		if address.flags != flags || address.scope != scope || address.peer != "" || address.broadcast != "" || address.label != "" ||
			uint64(address.preferred) != uint64(^uint32(0)) || uint64(address.valid) != uint64(^uint32(0)) {
			return false
		}
		matches++
	}
	if matches != 1 {
		return false
	}
	body := []byte{syscall.AF_INET6, 128, 0, 0, 255, 2, 0, 2, 0, 0, 0, 0}
	attribute := func(id uint16, value []byte) {
		length := 4 + len(value)
		row := make([]byte, (length+3)&^3)
		binary.LittleEndian.PutUint16(row, uint16(length))
		binary.LittleEndian.PutUint16(row[2:], id)
		copy(row[4:], value)
		body = append(body, row...)
	}
	word := func(value uint32) []byte {
		raw := make([]byte, 4)
		binary.LittleEndian.PutUint32(raw, value)
		return raw
	}
	attribute(1, prefix.Addr().AsSlice())
	attribute(4, word(uint32(owner.index)))
	attribute(6, word(0))
	attribute(15, word(255))
	attribute(20, []byte{0})
	expected, err := ParseDesktopLinuxNetworkObject("route", body)
	return err == nil && object == expected
}

func routervpnLinuxRouteAdditions(before, after routerVPNLinuxRouteOwner, previous, added []DesktopNetworkObject) bool {
	if !routervpnLinuxSameRouteOwner(before, after) || len(added) < 1 || len(added) > len(after.addresses)+1 {
		return false
	}
	explicit := 0
	seen := make(map[string]bool)
	for _, object := range added {
		if slices.Contains(previous, object) || object.Validate("linux") != nil || object.Kind != "route" || object.Index != uint32(after.index) || seen[object.Key()] {
			return false
		}
		seen[object.Key()] = true
		if routervpnLinuxKernelLocalAddressRoute(object, after) {
			continue
		}
		explicit++
	}
	return explicit == 1
}

// Preserve the same sticky first failure. Record its bounded delta while the
// original constructor still owns these observations; a later recreated TUN
// cannot explain why this exact before/after pair was refused.
func (t *NativeTun) routervpnLinuxAdditionFailure(kind string, failure error, added, removed []DesktopNetworkObject, observation ...*routerVPNLinuxRouteAdditionObservation) {
	t.routervpnNetwork.mu.Lock()
	if t.routervpnNetwork.failure != nil {
		t.routervpnNetwork.mu.Unlock()
		return
	}
	t.routervpnNetwork.failure = failure
	t.routervpnNetwork.mu.Unlock()
	routervpnLinuxMTUDiagnostic(os.Stderr, kind, t.routervpnOwnedIndex, added, removed)
	if len(observation) == 1 && observation[0] != nil {
		routervpnLinuxRouteOwnerDiagnostic(os.Stderr, *observation[0], added)
	}
}

// Failure-only details of the same owner snapshots used by the admission
// predicate. Never obtain a replacement snapshot to explain a retired TUN;
// neither numeric diagnostics nor an identical later read grants authority.
type routerVPNLinuxRouteAdditionObservation struct {
	before, after routerVPNLinuxRouteOwner
	ownerError    bool
}

func routervpnLinuxRouteOwnerDiagnostic(output io.Writer, observation routerVPNLinuxRouteAdditionObservation, added []DesktopNetworkObject) {
	before, after := observation.before, observation.after
	fmt.Fprintf(output, "NODE-MTU-DIAGNOSTIC owner readback_error=%t same_owner=%t index_before=%d index_after=%d mtu_before=%d mtu_after=%d flags_before=%d flags_after=%d name_equal=%t hardware_equal=%t configured_equal=%t configured_before=%d configured_after=%d addresses_before=%d addresses_after=%d\n",
		observation.ownerError, !observation.ownerError && routervpnLinuxSameRouteOwner(before, after), before.index, after.index, before.mtu, after.mtu,
		uint(before.flags), uint(after.flags), before.name == after.name, before.hardware == after.hardware, slices.Equal(before.configured, after.configured),
		len(before.configured), len(after.configured), len(before.addresses), len(after.addresses))
	for i := 0; i < min(8, max(len(before.addresses), len(after.addresses))); i++ {
		var old, now routerVPNLinuxRouteAddress
		oldPresent, nowPresent := i < len(before.addresses), i < len(after.addresses)
		if oldPresent {
			old = before.addresses[i]
		}
		if nowPresent {
			now = after.addresses[i]
		}
		oldComparable, nowComparable := old, now
		oldComparable.flags &^= syscall.IFA_F_TENTATIVE
		nowComparable.flags &^= syscall.IFA_F_TENTATIVE
		fmt.Fprintf(output, "NODE-MTU-DIAGNOSTIC address ordinal=%d before=%t after=%t equal_except_tentative=%t prefix_equal=%t selected_before=%t selected_after=%t ipv6=%t link_local=%t prefix_bits=%d flags_before=%d flags_after=%d scope_before=%d scope_after=%d preferred_equal=%t valid_equal=%t infinite_after=%t label_equal=%t peer_equal=%t broadcast_equal=%t label_empty=%t peer_empty=%t broadcast_empty=%t\n",
			i, oldPresent, nowPresent, oldPresent && nowPresent && oldComparable == nowComparable, old.prefix == now.prefix,
			slices.Contains(before.configured, old.prefix), slices.Contains(after.configured, now.prefix), now.prefix.Addr().Is6(), now.prefix.Addr().IsLinkLocalUnicast(), now.prefix.Bits(),
			old.flags, now.flags, old.scope, now.scope, old.preferred == now.preferred, old.valid == now.valid,
			uint64(now.preferred) == uint64(^uint32(0)) && uint64(now.valid) == uint64(^uint32(0)), old.label == now.label, old.peer == now.peer, old.broadcast == now.broadcast,
			now.label == "", now.peer == "", now.broadcast == "")
	}
	for i, object := range added[:min(len(added), 8)] {
		prefix, prefixErr := netip.ParsePrefix(object.Destination)
		configured, addresses := 0, 0
		if prefixErr == nil {
			for _, selected := range after.configured {
				if selected.Addr() == prefix.Addr() {
					configured++
				}
			}
			for _, current := range after.addresses {
				if current.prefix.Addr() == prefix.Addr() {
					addresses++
				}
			}
		}
		body, decodeErr := base64.StdEncoding.Strict().DecodeString(object.Native)
		complete := decodeErr == nil && len(body) >= 12 && len(body) <= 8192 && object.Validate("linux") == nil
		family, sourceBits, tos, protocol, scope, routeType := -1, -1, -1, -1, -1, -1
		if complete {
			family, sourceBits, tos, protocol, scope, routeType = int(body[0]), int(body[2]), int(body[3]), int(body[5]), int(body[6]), int(body[7])
		}
		// Attribute values may contain private addresses. Only bounded native
		// attribute identifiers/lengths are emitted, never values or raw bytes.
		var attributes []string
		if complete {
			for offset := 12; offset+4 <= len(body) && len(attributes) < 16; {
				length := int(binary.LittleEndian.Uint16(body[offset:]))
				if length < 4 || offset+length > len(body) {
					break
				}
				attributes = append(attributes, fmt.Sprintf("%d:%d", binary.LittleEndian.Uint16(body[offset+2:]), length))
				offset += (length + 3) &^ 3
			}
		}
		fmt.Fprintf(output, "NODE-MTU-DIAGNOSTIC qualification ordinal=%d canonical_local=%t configured_matches=%d address_matches=%d link_local=%t prefix_bits=%d native_complete=%t native_family=%d source_bits=%d tos=%d protocol=%d scope=%d type=%d attributes=%v gateway_empty=%t luid_zero=%t mtu_zero=%t\n",
			i, !observation.ownerError && routervpnLinuxKernelLocalAddressRoute(object, after), configured, addresses, prefix.Addr().IsLinkLocalUnicast(), prefix.Bits(), complete,
			family, sourceBits, tos, protocol, scope, routeType, attributes, object.Gateway == "", object.LUID == 0, object.MTU == 0)
	}
}

func routervpnLinuxMTUDiagnostic(output io.Writer, kind string, index int, added, removed []DesktopNetworkObject) {
	if kind != "route" && kind != "rule" {
		kind = "other"
	}
	fmt.Fprintf(output, "NODE-MTU-DIAGNOSTIC delta kind=%s index=%d added=%d removed=%d\n", kind, index, len(added), len(removed))
	reported := 0
	for _, change := range []struct {
		name    string
		objects []DesktopNetworkObject
	}{{"added", added}, {"removed", removed}} {
		for _, object := range change.objects {
			if reported == 8 {
				return
			}
			reported++
			destination := "other"
			switch object.Destination {
			case "0.0.0.0/0":
				destination = "default4"
			case "::/0":
				destination = "default6"
			case "fe80::/64":
				destination = "linklocal6"
			case "ff00::/8":
				destination = "multicast6"
			}
			objectKind := object.Kind
			if objectKind != "route" && objectKind != "rule" {
				objectKind = "other"
			}
			fmt.Fprintf(output, "NODE-MTU-DIAGNOSTIC %s kind=%s family=%d index=%d table=%d priority=%d flags=%d destination=%s\n",
				change.name, objectKind, object.Family, object.Index, object.Table, object.Priority, object.Flags, destination)
		}
	}
}

// RuleAdd of our final NOP also resolves our earlier GOTO rules. Keep every
// changed byte strict, require each prior rule in this exact TUN's ledger, and
// admit one unique new target only. An unrelated/ambiguous delta still fails.
func (t *NativeTun) routervpnLinuxResolvedRules(removed, added []DesktopNetworkObject) bool {
	if len(removed) == 0 || len(added) != len(removed)+1 {
		return false
	}
	t.routervpnNetwork.mu.Lock()
	defer t.routervpnNetwork.mu.Unlock()
	if t.routervpnNetwork.failure != nil {
		return false
	}
	for _, old := range removed {
		if captured, ok := t.routervpnNetwork.objects[old.Key()]; !ok || captured != old {
			return false
		}
	}
	var target DesktopNetworkObject
	var replacements []DesktopNetworkObject
	matches := 0
	for candidate, to := range added {
		if _, exists := t.routervpnNetwork.objects[to.Key()]; exists {
			continue
		}
		used := map[int]bool{candidate: true}
		current := make([]DesktopNetworkObject, len(removed))
		valid := true
		for i, old := range removed {
			match := -1
			for j, now := range added {
				if !used[j] && DesktopLinuxRuleResolvedBy(old, now, to) {
					if match != -1 {
						valid = false
						break
					}
					match = j
				}
			}
			if !valid || match == -1 {
				valid = false
				break
			}
			used[match] = true
			current[i] = added[match]
		}
		if valid && len(used) == len(added) {
			matches++
			target = to
			replacements = current
		}
	}
	if matches != 1 {
		return false
	}
	for _, now := range replacements {
		if _, exists := t.routervpnNetwork.objects[now.Key()]; exists {
			return false
		}
	}
	for i, old := range removed {
		delete(t.routervpnNetwork.objects, old.Key())
		t.routervpnNetwork.objects[replacements[i].Key()] = replacements[i]
	}
	t.routervpnNetwork.objects[target.Key()] = target
	return true
}

func (t *NativeTun) routervpnNetworkObjects(receipt DesktopNetworkReceipt) ([]DesktopNetworkObject, error) {
	routes, err := t.routervpnLinuxNetworkObjects("route")
	if err != nil {
		return nil, err
	}
	rules, err := t.routervpnLinuxNetworkObjects("rule")
	if err != nil {
		return nil, err
	}
	all := append(append([]DesktopNetworkObject(nil), routes...), rules...)
	objects := append([]DesktopNetworkObject(nil), receipt.Objects...)
	for _, object := range receipt.Objects {
		if !routervpnNetworkHasObject(all, object) {
			return nil, errors.New("native Linux receipt lost its successful routing object")
		}
	}
	for _, route := range routes {
		if route.Index != receipt.Index || routervpnNetworkHasObject(objects, route) {
			continue
		}
		body, _ := base64.StdEncoding.Strict().DecodeString(route.Native)
		if len(body) < 12 || body[5] != 2 /* RTPROT_KERNEL */ || !routervpnNetworkAddressRoute(receipt, route) {
			return nil, errors.New("native Linux TUN has an unrelated route")
		}
		objects = append(objects, route)
	}
	return objects, nil
}
