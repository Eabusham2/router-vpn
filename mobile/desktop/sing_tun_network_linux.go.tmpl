//go:build linux

package tun

import (
	"encoding/base64"
	"errors"
	"fmt"
	"io"
	"net"
	"os"
	"syscall"
)

func (t *NativeTun) routervpnNetworkInterface() (*net.Interface, uint64, error) {
	current, err := net.InterfaceByName(t.options.Name)
	if err != nil || current.Index != t.routervpnOwnedIndex || t.routervpnOwnedIndex < 1 {
		return nil, 0, errors.New("native Linux routing receipt lost its original TUN")
	}
	return current, 0, nil
}

func routervpnLinuxNetworkObjects(kind string) ([]DesktopNetworkObject, error) {
	request, response := syscall.RTM_GETROUTE, uint16(syscall.RTM_NEWROUTE)
	if kind == "rule" {
		request, response = syscall.RTM_GETRULE, syscall.RTM_NEWRULE
	}
	raw, err := syscall.NetlinkRIB(request, syscall.AF_UNSPEC)
	if err != nil {
		return nil, err
	}
	if len(raw) > 4<<20 {
		return nil, errors.New("native Linux route inventory exceeded its bound")
	}
	messages, err := syscall.ParseNetlinkMessage(raw)
	if err != nil {
		return nil, err
	}
	var objects []DesktopNetworkObject
	for _, message := range messages {
		if message.Header.Flags&0x10 != 0 {
			return nil, errors.New("native Linux routing dump was interrupted")
		}
		if message.Header.Type == syscall.NLMSG_DONE {
			continue
		}
		if message.Header.Type != response {
			return nil, errors.New("native Linux routing dump contains an unknown result")
		}
		object, err := ParseDesktopLinuxNetworkObject(kind, message.Data)
		if err != nil {
			return nil, err
		}
		objects = append(objects, object)
	}
	return objects, nil
}

func (t *NativeTun) routervpnLinuxBefore(kind string) []DesktopNetworkObject {
	objects, err := routervpnLinuxNetworkObjects(kind)
	if err != nil {
		t.routervpnNetworkFailure(fmt.Errorf("native Linux %s before inventory: %w", kind, err))
		return nil
	}
	// A non-nil empty slice preserves a successful empty inventory.
	if objects == nil {
		objects = []DesktopNetworkObject{}
	}
	return objects
}

func (t *NativeTun) routervpnLinuxAdded(kind string, before []DesktopNetworkObject) {
	after, err := routervpnLinuxNetworkObjects(kind)
	if err != nil {
		t.routervpnNetworkFailure(fmt.Errorf("native Linux %s after inventory: %w", kind, err))
		return
	}
	if before == nil {
		t.routervpnNetworkFailure(errors.New("native Linux routing call has no complete before/after readback"))
		return
	}
	counts := make(map[string]int)
	for _, object := range before {
		counts[object.Key()]++
	}
	var added []DesktopNetworkObject
	for _, object := range after {
		key := object.Key()
		if counts[key] > 0 {
			counts[key]--
		} else {
			added = append(added, object)
		}
	}
	var removed []DesktopNetworkObject
	for _, object := range before {
		if counts[object.Key()] != 0 {
			removed = append(removed, object)
		}
	}
	if kind == "rule" && len(removed) != 0 {
		if t.routervpnLinuxResolvedRules(removed, added) {
			return
		}
	}
	for _, count := range counts {
		if count != 0 {
			t.routervpnLinuxAdditionFailure(kind, fmt.Errorf("native Linux routing inventory changed during its own add (kind=%s removed=%d added=%d)", kind, len(removed), len(added)), added, removed)
			return
		}
	}
	if len(added) != 1 || kind == "route" && added[0].Index != uint32(t.routervpnOwnedIndex) {
		t.routervpnLinuxAdditionFailure(kind, errors.New("native Linux routing call has no unique owned addition"), added, removed)
		return
	}
	for _, object := range before {
		if object == added[0] {
			t.routervpnNetworkFailure(errors.New("native Linux routing call duplicated an existing object"))
			return
		}
	}
	t.routervpnNetworkAdded(added[0])
}

// Preserve the same sticky first failure. Record its bounded delta while the
// original constructor still owns these observations; a later recreated TUN
// cannot explain why this exact before/after pair was refused.
func (t *NativeTun) routervpnLinuxAdditionFailure(kind string, failure error, added, removed []DesktopNetworkObject) {
	t.routervpnNetwork.mu.Lock()
	if t.routervpnNetwork.failure != nil {
		t.routervpnNetwork.mu.Unlock()
		return
	}
	t.routervpnNetwork.failure = failure
	t.routervpnNetwork.mu.Unlock()
	routervpnLinuxMTUDiagnostic(os.Stderr, kind, t.routervpnOwnedIndex, added, removed)
}

func routervpnLinuxMTUDiagnostic(output io.Writer, kind string, index int, added, removed []DesktopNetworkObject) {
	if kind != "route" && kind != "rule" {
		kind = "other"
	}
	fmt.Fprintf(output, "NODE-MTU-DIAGNOSTIC delta kind=%s index=%d added=%d removed=%d\n", kind, index, len(added), len(removed))
	reported := 0
	for _, change := range []struct {
		name    string
		objects []DesktopNetworkObject
	}{{"added", added}, {"removed", removed}} {
		for _, object := range change.objects {
			if reported == 8 {
				return
			}
			reported++
			destination := "other"
			switch object.Destination {
			case "0.0.0.0/0":
				destination = "default4"
			case "::/0":
				destination = "default6"
			case "fe80::/64":
				destination = "linklocal6"
			case "ff00::/8":
				destination = "multicast6"
			}
			objectKind := object.Kind
			if objectKind != "route" && objectKind != "rule" {
				objectKind = "other"
			}
			fmt.Fprintf(output, "NODE-MTU-DIAGNOSTIC %s kind=%s family=%d index=%d table=%d priority=%d flags=%d destination=%s\n",
				change.name, objectKind, object.Family, object.Index, object.Table, object.Priority, object.Flags, destination)
		}
	}
}

// RuleAdd of our final NOP also resolves our earlier GOTO rules. Keep every
// changed byte strict, require each prior rule in this exact TUN's ledger, and
// admit one unique new target only. An unrelated/ambiguous delta still fails.
func (t *NativeTun) routervpnLinuxResolvedRules(removed, added []DesktopNetworkObject) bool {
	if len(removed) == 0 || len(added) != len(removed)+1 {
		return false
	}
	t.routervpnNetwork.mu.Lock()
	defer t.routervpnNetwork.mu.Unlock()
	if t.routervpnNetwork.failure != nil {
		return false
	}
	for _, old := range removed {
		if captured, ok := t.routervpnNetwork.objects[old.Key()]; !ok || captured != old {
			return false
		}
	}
	var target DesktopNetworkObject
	var replacements []DesktopNetworkObject
	matches := 0
	for candidate, to := range added {
		if _, exists := t.routervpnNetwork.objects[to.Key()]; exists {
			continue
		}
		used := map[int]bool{candidate: true}
		current := make([]DesktopNetworkObject, len(removed))
		valid := true
		for i, old := range removed {
			match := -1
			for j, now := range added {
				if !used[j] && DesktopLinuxRuleResolvedBy(old, now, to) {
					if match != -1 {
						valid = false
						break
					}
					match = j
				}
			}
			if !valid || match == -1 {
				valid = false
				break
			}
			used[match] = true
			current[i] = added[match]
		}
		if valid && len(used) == len(added) {
			matches++
			target = to
			replacements = current
		}
	}
	if matches != 1 {
		return false
	}
	for _, now := range replacements {
		if _, exists := t.routervpnNetwork.objects[now.Key()]; exists {
			return false
		}
	}
	for i, old := range removed {
		delete(t.routervpnNetwork.objects, old.Key())
		t.routervpnNetwork.objects[replacements[i].Key()] = replacements[i]
	}
	t.routervpnNetwork.objects[target.Key()] = target
	return true
}

func (t *NativeTun) routervpnNetworkObjects(receipt DesktopNetworkReceipt) ([]DesktopNetworkObject, error) {
	routes, err := routervpnLinuxNetworkObjects("route")
	if err != nil {
		return nil, err
	}
	rules, err := routervpnLinuxNetworkObjects("rule")
	if err != nil {
		return nil, err
	}
	all := append(append([]DesktopNetworkObject(nil), routes...), rules...)
	objects := append([]DesktopNetworkObject(nil), receipt.Objects...)
	for _, object := range receipt.Objects {
		if !routervpnNetworkHasObject(all, object) {
			return nil, errors.New("native Linux receipt lost its successful routing object")
		}
	}
	for _, route := range routes {
		if route.Index != receipt.Index || routervpnNetworkHasObject(objects, route) {
			continue
		}
		body, _ := base64.StdEncoding.Strict().DecodeString(route.Native)
		if len(body) < 12 || body[5] != 2 /* RTPROT_KERNEL */ || !routervpnNetworkAddressRoute(receipt, route) {
			return nil, errors.New("native Linux TUN has an unrelated route")
		}
		objects = append(objects, route)
	}
	return objects, nil
}
