//go:build linux && !android

package routervpnamnezia

import (
	"errors"
	"net"
	"net/netip"
	"os"
	"regexp"
)

// This adapter admits only the two original ends of the existing disposable
// veth. The encrypted provider retains its original bound socket thereafter.
func connectExecutionPhysicalPeer(local, remote netip.Addr) error {
	if local != netip.MustParseAddr("192.168.210.2") || remote != netip.MustParseAddr("192.168.210.1") || os.Getenv("ROUTERVPN_LINUX_GUARDIAN_TEST_NS") != "1" {
		return errors.New("Linux CONNECT physical tuple changed")
	}
	parent := os.Getenv("ROUTERVPN_CONNECT_EXECUTION_PARENT_NETNS")
	current, err := os.Readlink("/proc/self/ns/net")
	if err != nil || !regexp.MustCompile(`^net:\[[0-9]+\]$`).MatchString(parent) || current == parent {
		return errors.New("Linux CONNECT peer lost its separate original namespace")
	}
	original, err := net.InterfaceByName("rvpn-peer")
	if err != nil || original.Index <= 0 || original.Name != "rvpn-peer" || original.Flags&net.FlagUp == 0 {
		return errors.New("Linux CONNECT peer interface changed")
	}
	addresses, err := original.Addrs()
	if err != nil {
		return err
	}
	found := 0
	for _, address := range addresses {
		prefix, err := netip.ParsePrefix(address.String())
		if err == nil && prefix.Addr() == local {
			if prefix.Bits() != 30 || !prefix.Contains(remote) {
				return errors.New("Linux CONNECT peer prefix changed")
			}
			found++
		}
	}
	if found != 1 {
		return errors.New("Linux CONNECT peer omitted original bound address")
	}
	return nil
}
