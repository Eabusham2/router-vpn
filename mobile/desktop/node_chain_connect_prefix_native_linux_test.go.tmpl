func nativeCONNECTPrefixProviderPositions(t *testing.T, protocol string) {
	for count := 2; count <= 6; count++ {
		t.Run(strconv.Itoa(count), func(t *testing.T) {
			request, _ := nativeCONNECTPrefixFixture(t, count, "wg", protocol)
			provider := nativeCONNECTPrefixProviderStart(t, request, false)
			if len(provider.local.prefixes) != count || count > 1 && (provider.server == nil || provider.server.prefixes[0] != nil) {
				t.Fatal("original entry was omitted or fabricated in Server")
			}
			for position, prefix := range provider.local.prefixes {
				inner, _ := desktopNodeChainInner(position, count)
				if position > 0 {
					if _, ok := prefix.handler.rules["tcp/"+net.JoinHostPort(inner, "8787")]; !ok {
						t.Fatal("Local proof moved from its original global position")
					}
				}
			}
			if count > 1 {
				for position := 1; position < count; position++ {
					prefix := provider.server.prefixes[position]
					inner, _ := desktopNodeChainInner(position, count)
					if _, ok := prefix.handler.rules["tcp/"+net.JoinHostPort(inner, "8787")]; !ok {
						t.Fatal("Server proof renumbered relative to suffix")
					}
					if position < count-1 {
						next := desktopNodeChainNext(position + 1)
						if len(prefix.handler.rules) != 2 || prefix.handler.rules["udp/"+next].Target != provider.server.prefixes[position+1].bind.address() {
							t.Fatal("Server acquired next-hop bypass")
						}
					} else if len(prefix.handler.rules) != 2 || prefix.handler.rules["tcp/10.79.0.1:8388"].Target != provider.imported.provider.address {
						t.Fatal("Server final packet bypassed original import")
					}
				}
			}
		})
	}
}
func TestRouterVPNDesktopNativeCONNECTPrefixSourceRefusals(t *testing.T) {
	request, local := nativeCONNECTPrefixFixture(t, 6, "awg2-fast", "https-connect")
	for _, fault := range []string{"missing-key", "entry-key", "import-key", "copied-key", "short-source", "missing-identity", "moved-import", "wrong-node", "foreign-mode", "changed-client"} {
		t.Run(fault, func(t *testing.T) {
			r := request
			r.ServerPrivateKeys = append([]string(nil), request.ServerPrivateKeys...)
			var source mobilemultihop.NodeChainSource
			_ = json.Unmarshal([]byte(local), &source)
			switch fault {
			case "missing-key":
				r.ServerPrivateKeys = r.ServerPrivateKeys[:len(r.ServerPrivateKeys)-1]
			case "entry-key":
				r.ServerPrivateKeys[0] = r.ServerPrivateKeys[1]
			case "import-key":
				r.ServerPrivateKeys[6] = r.ServerPrivateKeys[1]
			case "copied-key":
				r.ServerPrivateKeys[2] = r.ServerPrivateKeys[1]
			case "short-source":
				source.Nodes = source.Nodes[:len(source.Nodes)-1]
			case "missing-identity":
				source.IdentitySources[2] = ""
			case "moved-import":
				source.Nodes[2], source.Nodes[6] = source.Nodes[6], source.Nodes[2]
			case "wrong-node":
				r.Peer.Paired.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Peer.Paired.Prefixes...)
				r.Peer.Paired.Prefixes[2].NodeProofID = strings.Repeat("f", 64)
			case "foreign-mode":
				r.Peer.Paired.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Peer.Paired.Prefixes...)
				r.Peer.Paired.Prefixes[2].Mode = "shadowsocks"
			case "changed-client":
				r.Peer.Paired.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Peer.Paired.Prefixes...)
				key, err := ecdh.X25519().GenerateKey(rand.Reader)
				if err != nil {
					t.Fatal(err)
				}
				r.Peer.Paired.Prefixes[2].ClientPublicKey = base64.StdEncoding.EncodeToString(key.PublicKey().Bytes())
			}
			if _, err := nativeCONNECTPrefixServerSource(desktopNodeChainJSON(t, source), r); err == nil {
				t.Fatal("changed captured source acquired native Server authority")
			}
		})
	}
}

// Real proxy TCP/TLS authentication runs on the fixture's original loopback
// provider. This component does not claim packet-prefix or installed TUN proof;
// the mandatory isolated-host cases must prove those paths separately.
func TestRouterVPNDesktopNativeCONNECTPrefixAuthentication(t *testing.T) {
	for _, protocol := range []string{"http-connect", "https-connect"} {
		for _, wrong := range []bool{false, true} {
			t.Run(fmt.Sprintf("%s/wrong=%t", protocol, wrong), func(t *testing.T) {
				request, _ := nativeCONNECTPrefixFixture(t, 2, "wg", protocol)
				if wrong {
					request.Fault = "wrong-auth"
				}
				provider := nativeCONNECTPrefixProviderStart(t, request, false)
				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
				defer cancel()
				raw, err := (&net.Dialer{}).DialContext(ctx, "tcp4", provider.connect.address)
				if err != nil {
					t.Fatal(err)
				}
				defer raw.Close()
				if deadline, ok := ctx.Deadline(); ok {
					if err = raw.SetDeadline(deadline); err != nil {
						t.Fatal(err)
					}
				}
				conn := raw
				if protocol == "https-connect" {
					pool := x509.NewCertPool()
					if !pool.AppendCertsFromPEM([]byte(provider.ca)) {
						t.Fatal("captured provider TLS root missing")
					}
					secured := tls.Client(raw, &tls.Config{RootCAs: pool, ServerName: provider.serverName, MinVersion: tls.VersionTLS12})
					if err = secured.HandshakeContext(ctx); err != nil {
						t.Fatal(err)
					}
					conn = secured
				}
				auth := base64.StdEncoding.EncodeToString([]byte(request.Username + ":" + request.Password))
				if _, err = fmt.Fprintf(conn, "CONNECT speed.cloudflare.com:443 HTTP/1.1\r\nHost: speed.cloudflare.com:443\r\nProxy-Authorization: Basic %s\r\n\r\n", auth); err != nil {
					t.Fatal(err)
				}
				reply, err := http.ReadResponse(bufio.NewReader(conn), &http.Request{Method: http.MethodConnect})
				if err != nil {
					t.Fatal(err)
				}
				expected := http.StatusOK
				if wrong {
					expected = http.StatusProxyAuthRequired
				}
				if reply.StatusCode != expected {
					t.Fatal("original CONNECT authentication verdict", reply.StatusCode, expected)
				}
				if wrong && provider.connect.auth.Load() == 0 || !wrong && provider.connect.auth.Load() != 0 {
					t.Fatal("original authentication counter disagrees with actual response")
				}
				if provider.connect.denied.Load() != 0 || provider.connect.tlsRefused.Load() != 0 {
					t.Fatal("authentication component borrowed another refusal")
				}
				if !wrong {
					for provider.router.streams.Load() == 0 {
						select {
						case <-ctx.Done():
							t.Fatal("authenticated original TCP stream never entered its owner", ctx.Err())
						case <-time.After(time.Millisecond):
						}
					}
				}
				_ = conn.Close()
				for provider.router.streams.Load() != 0 {
					select {
					case <-ctx.Done():
						t.Fatal("original authenticated TCP stream did not retire", ctx.Err())
					case <-time.After(time.Millisecond):
					}
				}
			})
		}
	}
}
