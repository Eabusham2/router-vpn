// CONNECT keeps its own literal source, TCP authentication and final UoT
// authority. Only the existing encrypted packet/isolated-process test helpers
// are shared with imported SS. No portable carrier exemption is used.
type nativeCONNECTPrefixRequest struct {
	nativeImportedRequest
	Protocol string `json:"protocol"`
	Username string `json:"username"`
	Password string `json:"password"`
}

func nativeCONNECTPrefixRequestValid(r nativeCONNECTPrefixRequest) error {
	bad := errors.New("native CONNECT requires original complete packet identities and exact authenticated TCP source")
	base := r.nativeImportedRequest
	base.Fault = ""
	if nativeImportedRequestValid(base) != nil || len(r.Peer.Paired.Prefixes) < 2 ||
		(r.Protocol != "http-connect" && r.Protocol != "https-connect") || r.Username == "" || r.Password == "" {
		return bad
	}
	switch r.Fault {
	case "", "wrong-first-key", "wrong-later-key", "wrong-auth", "wrong-final-key", "wrong-public", "failed-dns", "replaced-source", "carrier-change", "held-cleanup":
	case "tls-name":
		if r.Protocol != "https-connect" {
			return bad
		}
	default:
		return bad
	}
	return nil
}

func nativeCONNECTPrefixServerSource(local string, r nativeCONNECTPrefixRequest) (*mobilemultihop.NodeChainServerPolicy, error) {
	bad := errors.New("native Server pairing lost original source or independent client key")
	if nativeCONNECTPrefixRequestValid(r) != nil {
		return nil, bad
	}
	chain, err := mobilemultihop.NewNodeChainCONNECTSource(local)
	if err != nil {
		return nil, err
	}
	var original mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(local), &original) != nil || original.Schema != 4 || len(original.Nodes) != len(r.Peer.Paired.Prefixes)+2 || len(original.IdentitySources) != len(original.Nodes) {
		return nil, bad
	}
	_, metadata, err := chain.ReadValidated()
	if err != nil {
		return nil, err
	}
	proofs := metadata.Proofs
	n := len(r.Peer.Paired.Prefixes)
	if len(proofs) != n+2 || proofs[0].NodeID != r.Peer.Paired.Prefixes[0].NodeProofID || proofs[n+1].NodeID != r.Peer.Paired.FinalNodeProofID {
		return nil, bad
	}
	for i, prefix := range r.Peer.Paired.Prefixes {
		node, err := mobilemultihop.ParseNodeLaunchInput(original.Nodes[i])
		if err != nil || proofs[i].NodeID != prefix.NodeProofID || proofs[i].Mode != prefix.Mode {
			return nil, bad
		}
		key, err := node.PacketClientPublicKey()
		if err != nil || key != prefix.ClientPublicKey {
			return nil, bad
		}
	}
	var imported struct {
		Capture string `json:"capture"`
	}
	var selected struct {
		Protocol         string `json:"protocol"`
		ExpectedPublicIP string `json:"expected_public_ip"`
		Profile          struct {
			External struct {
				HTTP  *connectExecutionProxyCapture `json:"http_connect"`
				HTTPS *connectExecutionProxyCapture `json:"https_connect"`
			} `json:"external"`
		} `json:"profile"`
	}
	if json.Unmarshal([]byte(original.Nodes[n]), &imported) != nil || json.Unmarshal([]byte(imported.Capture), &selected) != nil {
		return nil, bad
	}
	proxy := selected.Profile.External.HTTP
	expectedName := ""
	if r.Protocol == "https-connect" {
		proxy = selected.Profile.External.HTTPS
		expectedName = "speed.cloudflare.com"
	}
	if r.Fault == "tls-name" {
		expectedName = "wrong-original-connect.routervpn.test"
	}
	if proxy == nil || selected.Protocol != r.Protocol || selected.ExpectedPublicIP != "203.0.113.88" ||
		proxy.Host != "10.79.0.1" || proxy.Port != 8388 || proxy.Username != r.Username || proxy.Password != r.Password || proxy.TLSServerName != expectedName {
		return nil, bad
	}

	source := mobilemultihop.NodeChainServerSource{Schema: 4, EntryID: proofs[0].ProfileID, EntryNodeID: proofs[0].NodeID, EntryMode: proofs[0].Mode}
	replace := func(value, key string) (string, error) {
		var files map[string][]byte
		if json.Unmarshal([]byte(value), &files) != nil || len(files) == 0 {
			return "", bad
		}
		changed := 0
		for name, data := range files {
			if !strings.HasSuffix(name, ".conf") {
				continue
			}
			lines := strings.Split(string(data), "\n")
			for i, line := range lines {
				if strings.HasPrefix(strings.TrimSpace(line), "PrivateKey=") {
					lines[i] = "PrivateKey=" + key
					changed++
				}
			}
			files[name] = []byte(strings.Join(lines, "\n"))
		}
		if changed != 1 {
			return "", bad
		}
		raw, err := json.Marshal(files)
		return string(raw), err
	}
	for position := 1; position < len(original.Nodes); position++ {
		if position == n {
			source.Nodes = append(source.Nodes, original.Nodes[position])
			source.IdentitySources = append(source.IdentitySources, "")
			continue
		}
		var input struct {
			Mode    string `json:"mode"`
			Files   string `json:"files"`
			Profile string `json:"profile_json"`
			Start   string `json:"start"`
			DNS     string `json:"dns_bootstrap"`
		}
		if json.Unmarshal([]byte(original.Nodes[position]), &input) != nil {
			return nil, bad
		}
		key := r.ServerPrivateKeys[position]
		identity, err := replace(original.IdentitySources[position], key)
		if err != nil {
			return nil, err
		}
		files := input.Files
		if position < n {
			files, err = replace(files, key)
			if err != nil {
				return nil, err
			}
		}
		node, err := mobilemultihop.NewNodeProfile(input.Mode, files, input.Profile, input.Start, input.DNS)
		if err != nil {
			return nil, err
		}
		launch, err := node.LaunchInput()
		if err != nil {
			return nil, err
		}
		source.Nodes = append(source.Nodes, launch)
		source.IdentitySources = append(source.IdentitySources, identity)
	}
	raw, err := json.Marshal(source)
	if err != nil {
		return nil, err
	}
	policy, err := mobilemultihop.NewNodeChainCONNECTServerPolicy(string(raw))
	clear(raw)
	if err != nil || !policy.NativeCarrierRequired() {
		return nil, errors.Join(bad, err)
	}
	inventory := policy.ProofInventory()
	if len(inventory) != n+1 {
		return nil, bad
	}
	for i, p := range inventory {
		if p.Position != i+1 || p.NodeID != proofs[i+1].NodeID || p.ProfileID != proofs[i+1].ProfileID || p.Kind != proofs[i+1].Kind || p.Mode != proofs[i+1].Mode {
			return nil, bad
		}
	}
	return policy, nil
}

type nativeCONNECTPrefixProvider struct {
	*nativeImportedProvider
	connect        *desktopImportedCONNECTPeer
	router         *nodeCONNECTInstalledMiddleRouter
	ca, serverName string
}

func nativeCONNECTPrefixProviderStart(t *testing.T, r nativeCONNECTPrefixRequest, physical bool) *nativeCONNECTPrefixProvider {
	t.Helper()
	if err := nativeCONNECTPrefixRequestValid(r); err != nil {
		t.Fatal(err)
	}
	n := len(r.Peer.Paired.Prefixes)
	loop := netip.MustParseAddr("127.0.0.1")
	local, remote := loop, loop
	if physical {
		local, remote = netip.MustParseAddr("192.168.210.2"), netip.MustParseAddr("192.168.210.1")
		if err := connectExecutionPhysicalPeer(local, remote); err != nil {
			t.Fatal(err)
		}
	}
	p := &nativeCONNECTPrefixProvider{nativeImportedProvider: &nativeImportedProvider{}}
	api, peer := desktopNodeChainInner(0, n)
	decorate := func(original *desktopNodeWGHandler) tun.Handler {
		p.forward = &nativeImportedForward{desktopNodeWGHandler: original, api: netip.MustParseAddr(api), peer: netip.MustParseAddr(peer)}
		return p.forward
	}
	last := r.Peer
	last.Schema = 1
	last.Paired.Prefixes = r.Peer.Paired.Prefixes[n-1:]
	if r.Fault == "wrong-final-key" {
		key := make([]byte, 32)
		if _, err := rand.Read(key); err != nil {
			t.Fatal(err)
		}
		last.Paired.FinalPassword = base64.StdEncoding.EncodeToString(key)
		clear(key)
	}
	// The imported provider is behind the last original packet prefix. Only
	// prefix zero owns the controller's physical non-loopback tuple.
	boundLocal, boundRemote := loop, loop
	certificate, ca := desktopNodeChainImportedCertificate(t)
	p.ca, p.serverName = ca, "speed.cloudflare.com"
	if r.Protocol == "http-connect" {
		p.ca, p.serverName = "", ""
	}
	hooks := &desktopNodeChainImportedPeerHooks{decorate: func(original *desktopNodeWGHandler) tun.Handler {
		return &nodeCONNECTRunPacketHandler{desktopNodeWGHandler: original, control: M.ParseSocksaddr("10.79.0.1:8388")}
	}, middle: func(owner *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
		routes := make([]desktopNodeLayerRoute, 0, len(owner.routes))
		for _, route := range owner.routes {
			if route.Network == "tcp" {
				routes = append(routes, route)
			}
		}
		owner.routes = routes
		p.router = &nodeCONNECTInstalledMiddleRouter{nodeCONNECTRunMiddleRouter: &nodeCONNECTRunMiddleRouter{server: owner}}
		owner.streamRouter = p.router
		var secured *tls.Certificate
		if r.Protocol == "https-connect" {
			secured = &certificate
		}
		password := r.Password
		if r.Fault == "wrong-auth" {
			password += "-wrong-original-provider"
		}
		p.connect = desktopStartImportedCONNECTPeerAt(t, owner, r.Username, password, secured, func() { t.Error("unowned CONNECT prefix cancellation") }, "", loop)
		return desktopExternalInstalledSSPeer{address: p.connect.address, close: p.connect.close}
	}}
	p.imported = desktopNodeChainImportedPeerStartWithHooks(t, last, boundLocal, boundRemote, nil, hooks)
	p.imported.paired.final.streamRouter = UOT.NewRouter(&desktopImportedCONNECTRouter{server: p.imported.paired.final}, log.NewNOPFactory().Logger())
	p.local = &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, n), final: p.imported.paired}
	p.local.prefixes[n-1] = p.imported.prefix
	ipc, err := desktopNodeChainPeerIdentityBounds(r.Peer.Paired, 1, 6)
	if err != nil {
		t.Fatal(err)
	}
	desktopNodeChainStartCapturedPrefixRange(t, r.Peer.Paired, local, remote, p.local, ipc, n-1, 0, func(position int, h *desktopNodeWGHandler) tun.Handler {
		if position == 0 {
			return decorate(h)
		}
		return h
	})
	clear(ipc)
	if n > 1 {
		// The complete original positions are kept. Server has no fabricated entry.
		request := r.Peer.Paired
		request.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Prefixes...)
		for i := 1; i < n; i++ {
			raw, _ := base64.StdEncoding.DecodeString(r.ServerPrivateKeys[i])
			key, _ := ecdh.X25519().NewPrivateKey(raw)
			clear(raw)
			request.Prefixes[i].ClientPublicKey = base64.StdEncoding.EncodeToString(key.PublicKey().Bytes())
		}
		if r.Fault == "wrong-first-key" || r.Fault == "wrong-later-key" {
			position := 1
			if r.Fault == "wrong-later-key" {
				position = n - 1
			}
			key, err := ecdh.X25519().GenerateKey(rand.Reader)
			if err != nil {
				t.Fatal(err)
			}
			request.Prefixes[position].ClientPublicKey = base64.StdEncoding.EncodeToString(key.PublicKey().Bytes())
		}
		ipc, err = desktopNodeChainPeerIdentityBounds(request, 1, 6)
		if err != nil {
			t.Fatal(err)
		}
		p.server = &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, n), final: p.imported.paired}
		end := &desktopNodeChainPrefixPeer{}
		p.server.prefixes[n-1] = end
		ctx, cancel := context.WithCancel(context.Background())
		end.handler = &desktopNodeWGHandler{desktopReferenceHandler: &desktopReferenceHandler{ctx: ctx, cancel: cancel, owned: map[io.Closer]bool{}, rules: map[string]desktopReferenceRule{}}}
		for _, network := range []string{"tcp"} {
			end.handler.rules[network+"/10.79.0.1:8388"] = desktopReferenceRule{Network: network, Address: "10.79.0.1", Port: 8388, Target: p.imported.provider.address}
		}
		stack, err := wg.NewDevice(wg.DeviceOptions{Context: ctx, Logger: log.NewNOPFactory().Logger(), Handler: &nodeCONNECTRunPacketHandler{desktopNodeWGHandler: end.handler, control: M.ParseSocksaddr("10.79.0.1:8388")}, UDPTimeout: 5 * time.Second, ICMPTimeout: time.Second, MTU: 2000, Address: []netip.Prefix{netip.MustParsePrefix("10.78.0.1/32"), netip.MustParsePrefix("fd78:78::1/128")}})
		if err != nil {
			t.Fatal(err)
		}
		end.bind = &desktopNodeWGBind{local: loop, remote: loop}
		device, err := desktopNodeChainPrefixFactory(t, request.Prefixes[n-1], end)(ctx, stack, end.bind, ipc[n-1])
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() { end.handler.close(); device.close() })
		desktopNodeChainStartCapturedPrefixRange(t, request, loop, loop, p.server, ipc, n-1, 1, nil)
		clear(ipc)
		delayed := nativeImportedUDPStart(t, "127.0.0.1:0", p.local.prefixes[1].bind.address(), loop, &p.localDelay)
		p.delayed = delayed
		target := desktopNodeChainNext(1)
		rule := p.local.prefixes[0].handler.rules["udp/"+target]
		rule.Target = delayed.listener.LocalAddr().String()
		p.local.prefixes[0].handler.rules["udp/"+target] = rule
		if physical {
			p.carrier = nativeImportedUDPStart(t, desktopNodeChainNext(1), p.server.prefixes[1].bind.address(), netip.MustParseAddr("192.168.211.1"), nil)
		}
	}
	return p
}
func TestRouterVPNDesktopNativeCONNECTPrefixProviderProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NATIVE_IMPORTED_ROLE") == "" {
		t.Skip("isolated original native provider only")
	}
	if err := nativeImportedNamespace("provider"); err != nil {
		t.Fatal(err)
	}
	reader := bufio.NewReaderSize(os.Stdin, mobilemultihop.NodeChainInputLimit+1)
	var request nativeCONNECTPrefixRequest
	if importedExecutionRead(reader, 64<<10, &request) != nil || nativeCONNECTPrefixRequestValid(request) != nil {
		t.Fatal("original native provider capture refused")
	}
	p := nativeCONNECTPrefixProviderStart(t, request, true)
	send := func() {
		value := p.nativeImportedProvider.snapshot()
		peer := value["peer"].(desktopNodeChainImportedReply)
		peer.Middle.Method = request.Protocol
		if peer.Middle.RawUDP != 0 || peer.Middle.UDP != 0 || peer.Final.FinalRawUDP != 0 {
			t.Fatal("CONNECT prefix acquired raw UDP middle/final authority")
		}
		value["peer"] = nodeCONNECTInstalledReply{desktopNodeChainImportedReply: peer, ConnectProtocol: request.Protocol,
			ConnectCA: p.ca, ConnectServerName: p.serverName, ConnectAuthRefusals: p.connect.auth.Load(), ConnectTargetRefusals: p.connect.denied.Load(),
			ConnectTLSRefusals: p.connect.tlsRefused.Load(), OpenConnectStreams: p.router.streams.Load(), FinalUoTVersion: 2}
		value["carrier_tcp"] = uint64(0)
		if json.NewEncoder(os.Stdout).Encode(value) != nil {
			t.Fatal("original native CONNECT provider output closed")
		}
	}

	send()
	for {
		var control struct {
			Command string `json:"command"`
		}
		if importedExecutionRead(reader, 128, &control) != nil {
			t.Fatal("original native provider control closed")
		}
		switch control.Command {
		case "quit":
			return
		case "stats":
			if request.Fault == "tls-name" {
				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
				err := p.connect.awaitCertificateRefusal(ctx)
				cancel()
				if err != nil {
					t.Fatal(err)
				}
			}
		case "winner-local":
			p.forward.serverDelay.Store(int64(75 * time.Millisecond))
			p.localDelay.Store(0)
			p.forward.localDelay.Store(0)
		case "winner-server":
			p.forward.serverDelay.Store(0)
			p.localDelay.Store(int64(35 * time.Millisecond))
			p.forward.localDelay.Store(int64(75 * time.Millisecond))
		default:
			if err := p.imported.control(control.Command); err != nil {
				t.Fatal(err)
			}
		}
		send()
	}
}
func nativeCONNECTPrefixChildStart(t *testing.T, r nativeCONNECTPrefixRequest) *nativeImportedChild {
	t.Helper()
	image, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	file, info, digest, err := captureImportedExecutionImage(image)
	if err != nil {
		t.Fatal(err)
	}
	file.Close()
	command := exec.Command("ip", "netns", "exec", "rvpn-peer", image, "-test.run=^TestRouterVPNDesktopNativeCONNECTPrefixProviderProcess$", "-test.count=1", "-test.timeout=240s")
	command.Env = []string{"PATH=/usr/sbin:/usr/bin:/sbin:/bin", "GORACE=atexit_sleep_ms=0", "ROUTERVPN_LINUX_GUARDIAN_TEST_NS=1", "ROUTERVPN_NATIVE_IMPORTED_ROLE=provider", "ROUTERVPN_NATIVE_IMPORTED_PARENT_NETNS=" + os.Getenv("ROUTERVPN_NATIVE_IMPORTED_PARENT_NETNS"), "ROUTERVPN_CONNECT_EXECUTION_PARENT_NETNS=" + os.Getenv("ROUTERVPN_NATIVE_IMPORTED_PARENT_NETNS")}
	command.Stderr = os.Stderr
	inputRead, input, err := os.Pipe()
	if err != nil {
		t.Fatal(err)
	}
	output, outputWrite, err := os.Pipe()
	if err != nil {
		inputRead.Close()
		input.Close()
		t.Fatal(err)
	}
	command.Stdin, command.Stdout = inputRead, outputWrite
	child := &nativeImportedChild{command: command, input: input, output: output, reader: bufio.NewReaderSize(output, mobilemultihop.NodeChainInputLimit+1), done: make(chan struct{}), readDone: make(chan struct{})}
	if err = command.Start(); err != nil {
		inputRead.Close()
		input.Close()
		output.Close()
		outputWrite.Close()
		t.Fatal(err)
	}
	inputRead.Close()
	outputWrite.Close()
	go func() { child.outcome = command.Wait(); close(child.done) }()
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
		defer cancel()
		if err := child.close(ctx); err != nil {
			t.Error(err)
		}
	})
	current, err := os.Lstat(image)
	if err != nil || !os.SameFile(current, info) {
		t.Fatal("native provider executable replaced")
	}
	again, _, actual, err := captureImportedExecutionImage(image)
	if err != nil || actual != digest {
		t.Fatal("native provider executable content changed")
	}
	again.Close()
	if json.NewEncoder(input).Encode(r) != nil {
		t.Fatal("original provider request failed")
	}
	return child
}

// The independently launched native Server retains normal certificate
// verification. This ephemeral CA bind exists only inside the original worker's
// private mount namespace; source capture and production TLS are unchanged.
func nativeCONNECTPrefixInstallTrust(t *testing.T, request nativeCONNECTPrefixRequest, initial map[string]json.RawMessage) {
	t.Helper()
	if err := nativeImportedNamespace("worker"); err != nil {
		t.Fatal(err)
	}
	parent := os.Getenv("ROUTERVPN_NATIVE_CONNECT_PARENT_MOUNT_NS")
	current, err := os.Readlink("/proc/self/ns/mnt")
	if err != nil || !regexp.MustCompile(`^mnt:\[[0-9]+\]$`).MatchString(parent) || current == parent {
		t.Fatal("native CONNECT trust refused original parent mount namespace")
	}
	iface, err := net.InterfaceByName("rvpn-cp-net")
	if err != nil || iface.Index <= 0 || iface.Flags&net.FlagUp == 0 {
		t.Fatal("native CONNECT trust lost original worker interface")
	}
	addresses, err := iface.Addrs()
	if err != nil {
		t.Fatal(err)
	}
	found := 0
	for _, address := range addresses {
		if address.String() == "192.168.211.1/30" {
			found++
		}
	}
	if found != 1 {
		t.Fatal("native CONNECT trust lost original worker address")
	}
	var peer nodeCONNECTInstalledReply
	if json.Unmarshal(initial["peer"], &peer) != nil || peer.ConnectProtocol != request.Protocol || peer.PublicCA == "" || peer.FinalUoTVersion != 2 {
		t.Fatal("native CONNECT trust lost captured public/provider source")
	}
	pool := x509.NewCertPool()
	if !pool.AppendCertsFromPEM([]byte(peer.PublicCA)) {
		t.Fatal("native CONNECT public CA malformed")
	}
	trust := peer.PublicCA
	if request.Protocol == "https-connect" {
		if peer.ConnectCA == "" || peer.ConnectCA == peer.PublicCA || peer.ConnectServerName != "speed.cloudflare.com" || !pool.AppendCertsFromPEM([]byte(peer.ConnectCA)) {
			t.Fatal("native CONNECT proxy CA malformed")
		}
		trust += "\n" + peer.ConnectCA
	} else if peer.ConnectCA != "" || peer.ConnectServerName != "" {
		t.Fatal("plain CONNECT borrowed TLS trust")
	}
	const target = "/etc/ssl/certs/ca-certificates.crt"
	var original syscall.Stat_t
	if syscall.Lstat(target, &original) != nil || original.Mode&syscall.S_IFMT != syscall.S_IFREG || original.Uid != 0 {
		t.Fatal("native CONNECT trust requires original regular system root file")
	}
	directory := t.TempDir()
	source := filepath.Join(directory, "captured-ca.pem")
	if err = os.WriteFile(source, []byte(trust), 0644); err != nil {
		t.Fatal(err)
	}
	if err = syscall.Mount(source, target, "", syscall.MS_BIND, ""); err != nil {
		t.Fatal("isolated native CONNECT CA bind", err)
	}
	t.Cleanup(func() {
		if err := syscall.Unmount(target, 0); err != nil {
			t.Error("original CONNECT trust unmount", err)
			return
		}
		var restored syscall.Stat_t
		if syscall.Lstat(target, &restored) != nil || restored.Dev != original.Dev || restored.Ino != original.Ino {
			t.Error("original CONNECT system root inode was not restored")
		}
	})
	if err = syscall.Mount("", target, "", syscall.MS_BIND|syscall.MS_REMOUNT|syscall.MS_RDONLY, ""); err != nil {
		t.Fatal("isolated native CONNECT CA read-only bind", err)
	}
	if raw, err := os.ReadFile(target); err != nil || string(raw) != trust {
		t.Fatal("isolated native CONNECT trust readback changed", err)
	}
}

func TestRouterVPNDesktopNativeCONNECTPrefixExecutionProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NATIVE_IMPORTED_ROLE") == "" {
		t.Skip("isolated original installed execution only")
	}
	if err := nativeImportedNamespace("worker"); err != nil {
		t.Fatal(err)
	}
	reader := bufio.NewReaderSize(os.Stdin, mobilemultihop.NodeChainInputLimit+1)
	var request nativeCONNECTPrefixRequest
	if importedExecutionRead(reader, 64<<10, &request) != nil || nativeCONNECTPrefixRequestValid(request) != nil {
		t.Fatal("original installed execution request refused")
	}
	image, info, digest, err := captureImportedExecutionImage(request.Image)
	if err != nil || digest != request.ImageSHA || !filepath.IsAbs(request.Image) {
		t.Fatal("original native worker image changed")
	}
	image.Close()
	provider := nativeCONNECTPrefixChildStart(t, request)
	send := func(value any) {
		if json.NewEncoder(os.Stdout).Encode(value) != nil {
			t.Fatal("original installed output closed")
		}
	}
	initial := provider.read(t)
	nativeCONNECTPrefixInstallTrust(t, request, initial)
	send(initial)
	var configure struct {
		LocalSource string `json:"local_source"`
		Winner      string `json:"winner"`
	}
	if importedExecutionRead(reader, mobilemultihop.NodeChainInputLimit, &configure) != nil {
		t.Fatal("original installed local capture absent")
	}
	policy, err := nativeCONNECTPrefixServerSource(configure.LocalSource, request)
	if err != nil {
		t.Fatal("original independent Server source refused", err)
	}
	n := len(request.Peer.Paired.Prefixes)
	api, peer := desktopNodeChainInner(0, n)
	runtimeDir := t.TempDir()
	if os.Chmod(runtimeDir, 0700) != nil {
		t.Fatal("original private native worker root unavailable")
	}
	runner := &nativeImportedRunner{importedExecutionRunner: &importedExecutionRunner{policy: policy, image: request.Image, imageSHA: digest, imageInfo: info, runtime: runtimeDir}, prefixes: n}
	manager, err := multihoprelay.New(multihoprelay.Config{ListenIP: api, FirstPort: 28440, LastPort: 28447, TTLSeconds: 300, NodeChains: []multihoprelay.NodeChainDescriptor{policy.Descriptor()}}, request.Peer.Paired.Prefixes[0].NodeProofID, runner)
	if err != nil {
		t.Fatal(err)
	}
	admin := &nativeImportedAdmin{relay: manager, token: request.Peer.Paired.Prefixes[0].APIToken, api: netip.MustParseAddr(api), peer: netip.MustParseAddr(peer)}
	admin.cfg.NodeID = request.Peer.Paired.Prefixes[0].NodeProofID
	listener, err := net.Listen("tcp4", net.JoinHostPort(api, "8787"))
	if err != nil {
		t.Fatal(err)
	}
	server := &http.Server{ReadHeaderTimeout: 2 * time.Second, Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path == nativeImportedLeasePath {
			admin.multihopNodeChainLease(w, r)
		} else {
			admin.health(w, r)
		}
	})}
	done := make(chan struct{})
	var outcome error
	go func() { outcome = server.Serve(listener); close(done) }()
	closed := false
	closeAll := func(ctx context.Context) error {
		if err := manager.Close(ctx); err != nil {
			return err
		}
		if !runner.joined() {
			return errors.New("original native carrier workers did not join")
		}
		if err := server.Shutdown(ctx); err != nil {
			return err
		}
		if err := importedExecutionJoinHTTP(ctx, done, &outcome); err != nil {
			return err
		}
		if err := provider.close(ctx); err != nil {
			return err
		}
		closed = true
		return nil
	}
	t.Cleanup(func() {
		if !closed {
			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
			defer cancel()
			if err := closeAll(ctx); err != nil {
				t.Error(err)
			}
		}
	})
	if configure.Winner != "local" && configure.Winner != "server" {
		t.Fatal("captured timing arm absent")
	}
	provider.control(t, "winner-"+configure.Winner)
	send(map[string]any{"ready": true, "source_sha256": policy.Descriptor().SourceSHA256, "carrier_required": policy.NativeCarrierRequired(), "positions": len(policy.ProofInventory())})
	for {
		var control struct {
			Command string `json:"command"`
		}
		if importedExecutionRead(reader, 128, &control) != nil {
			t.Fatal("original installed worker control closed")
		}
		if control.Command == "quit" {
			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
			err := closeAll(ctx)
			cancel()
			if err != nil {
				t.Fatal(err)
			}
			send(map[string]any{"joined": true, "launches": runner.launches.Load()})
			return
		}
		command := control.Command
		if command == "carrier-change" {
			if n < 2 {
				t.Fatal("portable suffix has no native packet carrier")
			}
			change := exec.Command("ip", "route", "replace", "198.51.100.102/32", "via", "192.168.211.2", "dev", "rvpn-cp-net", "mtu", "1280")
			if err := change.Run(); err != nil {
				t.Fatal("original carrier mutation failed", err)
			}
			command = "stats"
		}
		value := provider.control(t, command)
		value["launches"], _ = json.Marshal(runner.launches.Load())
		value["workers_joined"], _ = json.Marshal(runner.joined())
		value["entry_proofs"], _ = json.Marshal(admin.queries.Load())
		send(value)
	}
}

func nativeCONNECTPrefixFixture(t *testing.T, count int, mode, protocol string) (nativeCONNECTPrefixRequest, string) {
	t.Helper()
	base, local := nativeImportedFixture(t, count, mode, "2022-blake3-aes-256-gcm")
	request := nativeCONNECTPrefixRequest{nativeImportedRequest: base, Protocol: protocol, Username: "captured-native-user", Password: base.Peer.MiddlePassword}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(local), &source) != nil {
		t.Fatal("original fixture source missing")
	}
	outbound := map[string]any{"type": "http", "tag": "custom-exit", "server": "10.79.0.1", "server_port": 8388, "username": request.Username, "password": request.Password}
	transport := map[string]any{"host": "10.79.0.1", "port": 8388, "username": request.Username, "password": request.Password}
	external := map[string]any{"protocol": protocol, "expected_public_ip": "203.0.113.88"}
	if protocol == "https-connect" {
		outbound["tls"] = map[string]any{"enabled": true, "server_name": "speed.cloudflare.com"}
		transport["tls_server_name"] = "speed.cloudflare.com"
		external["https_connect"] = transport
	} else {
		external["http_connect"] = transport
	}
	config := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "interface_name": "router-vpn", "address": []string{"172.29.91.1/30", "fd29:91::1/126"}, "mtu": 1280, "auto_route": true, "strict_route": true, "stack": "system"}}, "endpoints": []any{}, "outbounds": []any{outbound}, "route": map[string]any{"final": "custom-exit", "rules": []any{}, "auto_detect_interface": true}}
	profile := map[string]any{"id": "captured-connect-middle", "node_kind": "external", "external": external, "endpoint": "10.79.0.1", "dns_mode": "home", "mtu_policy": "auto", "ipv6_mode": "on", "home_lan_access": false, "kill_switch_policy": "on-connect"}
	capture := map[string]any{"schema": 1, "exit_id": "captured-connect-middle", "protocol": protocol, "expected_public_ip": "203.0.113.88", "profile": profile}
	middle, err := mobilemultihop.NodeChainImportedCONNECTMemberInput(desktopNodeChainJSON(t, config), desktopNodeChainJSON(t, capture))
	if err != nil {
		t.Fatal(err)
	}
	source.Schema, source.Nodes[count] = 4, middle
	var final struct {
		Mode    string `json:"mode"`
		Files   string `json:"files"`
		Profile string `json:"profile_json"`
		Start   string `json:"start"`
		DNS     string `json:"dns_bootstrap"`
	}
	if json.Unmarshal([]byte(source.Nodes[count+1]), &final) != nil {
		t.Fatal("original final missing")
	}
	var assets map[string][]byte
	if json.Unmarshal([]byte(final.Files), &assets) != nil {
		t.Fatal("original final assets missing")
	}
	raw := assets["sing-box.json"]
	var graph map[string]any
	var paired map[string]any
	if json.Unmarshal(raw, &graph) != nil || json.Unmarshal([]byte(final.Profile), &paired) != nil {
		t.Fatal("original final SS source missing")
	}
	out := graph["outbounds"].([]any)[0].(map[string]any)
	digest, key := sha256.Sum256(raw), sha256.Sum256([]byte(out["password"].(string)))
	declaration := map[string]any{"schema": 1, "node_id": paired["node_proof_id"], "configured_image": nativecomposite.SSServiceImage, "uot_version": 2, "endpoint": out["server"], "port": out["server_port"], "method": out["method"], "source_sha256": hex.EncodeToString(digest[:]), "key_sha256": hex.EncodeToString(key[:])}
	assets[nativecomposite.SSServiceAsset] = []byte(desktopNodeChainJSON(t, declaration))
	node, err := mobilemultihop.NewNodeProfile(final.Mode, desktopNodeChainJSON(t, assets), final.Profile, final.Start, final.DNS)
	if err != nil {
		t.Fatal(err)
	}
	source.Nodes[count+1], err = node.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	return request, desktopNodeChainJSON(t, source)
}
