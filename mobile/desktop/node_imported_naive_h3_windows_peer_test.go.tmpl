// This independent copied executable owns the real protocol servers. It has no
// client broker, modeled grant map or permission callback. Its AppID is outside
// the test process's actual BFE policy. Only exact captured destinations route.
const desktopImportedH3PeerLimit = 2 << 20
const desktopImportedH3DNS = "192.168.50.133:53"
const desktopImportedH3Echo = "192.0.2.99:33443"

type desktopImportedH3PeerRequest struct {
	Schema                                                         int
	Operation, Kind, EntryLayer, FinalLayer, Address, Fault, Nonce string
	Source                                                         []string
	Certificate, Key                                               []byte
}
type desktopImportedH3PeerReply struct {
	Schema                                                                          int
	Kind, EntryLayer, FinalLayer, Address, SourceSHA256, ConfigSHA256, Nonce, Probe string
	Source                                                                          []string
	AppID                                                                           []byte
	Observed, Bootstrap, Selected, TCP, UDP, Private, Public, QUIC, Rejected        int64
	SOCKS                                                                           []desktopExternalSOCKSWFPReceipt
	Closed                                                                          bool
}

func desktopImportedH3JSON(t *testing.T, value any) string {
	t.Helper()
	raw, err := json.Marshal(value)
	if err != nil {
		t.Fatal(err)
	}
	return string(raw)
}
func desktopImportedH3Object(t *testing.T, raw string) map[string]any {
	t.Helper()
	var value map[string]any
	if json.Unmarshal([]byte(raw), &value) != nil || value == nil {
		t.Fatal("imported H3 capture is not an object")
	}
	return value
}
func desktopImportedH3Read(reader *bufio.Reader, value any) error {
	raw, err := reader.ReadSlice('\n')
	if err != nil || len(raw) > desktopImportedH3PeerLimit {
		return errors.Join(err, errors.New("imported H3 peer message exceeded its original bound"))
	}
	d := json.NewDecoder(bytes.NewReader(raw))
	d.DisallowUnknownFields()
	if err = d.Decode(value); err != nil {
		return err
	}
	var extra any
	if d.Decode(&extra) != io.EOF {
		return errors.New("imported H3 peer message changed exact framing")
	}
	return nil
}
func desktopImportedH3LayerMode(mode string) bool {
	return mode == "off" || mode == "aes-256-gcm" || mode == "aes-256-gcm+xor-whitening"
}
func desktopImportedH3Kind(kind string) bool {
	switch kind {
	case "socks5", "shadowsocks", "hysteria2", "wireguard", "amneziawg", "openvpn-tcp", "openvpn-udp":
		return true
	}
	return false
}
func desktopImportedH3NativePeer(ctx context.Context, certificate tls.Certificate) *desktopExternalIntegrationPeer {
	own, cancel := context.WithCancel(ctx)
	return &desktopExternalIntegrationPeer{ctx: own, cancel: cancel, certificate: certificate, proxyCertificate: certificate, connections: map[net.Conn]bool{}, packetConnections: map[N.PacketConn]bool{}}
}

type desktopImportedH3Route struct{ network, destination, target string }
type desktopImportedH3Servers struct {
	probe                                                  *desktopExternalWFPDatagrams
	ctx                                                    context.Context
	cancel                                                 context.CancelFunc
	entry, final                                           *desktopExternalIntegrationPeer
	socks                                                  *desktopExternalSOCKSWFPProvider
	layers                                                 []*desktopExternalIntegrationPeer
	closeOnce                                              sync.Once
	closeErr                                               error
	closeFinal                                             func() error
	closes                                                 []io.Closer
	workers                                                sync.WaitGroup
	source                                                 []string
	sourceSHA, configSHA, physical                         string
	bootstrap, selected, tcp, udp, private, quic, rejected atomic.Int64
	mu                                                     sync.Mutex
	markers                                                map[string]int64
	holdBootstrap                                          bool
}

func (s *desktopImportedH3Servers) close() error {
	s.closeOnce.Do(func() {
		s.cancel()
		for _, c := range s.closes {
			s.closeErr = errors.Join(s.closeErr, c.Close())
		}
		for _, p := range s.layers {
			p.close()
		}
		if s.socks != nil {
			s.socks.close()
		} else if s.entry != nil {
			s.entry.close()
		}
		if s.closeFinal != nil {
			s.closeErr = errors.Join(s.closeErr, s.closeFinal())
		}
		if s.final != nil {
			s.final.close()
		}
		s.workers.Wait()
	})
	return s.closeErr
}

func desktopImportedH3ReplyPacket(writer N.PacketWriter, payload []byte) (*buf.Buffer, error) {
	front, rear := N.CalculateFrontHeadroom(writer), N.CalculateRearHeadroom(writer)
	if front < 0 || rear < 0 || front > 4096 || rear > 4096 || len(payload) > 65535 {
		return nil, errors.New("imported H3 reply exceeds captured native writer bounds")
	}
	reply := buf.NewSize(front + len(payload) + rear)
	reply.Resize(front, 0)
	_, _ = reply.Write(payload)
	return reply, nil
}

func (s *desktopImportedH3Servers) selectedPacket(ctx context.Context, c N.PacketConn, m M.Metadata) error {
	writer := c // Preserve the actual writer's header/trailer contract before owning its cached first packet.
	c = desktopWFPOwnInitialPacket(c)
	stop := context.AfterFunc(ctx, func() { _ = c.Close() })
	defer stop()
	for {
		body := buf.NewPacket()
		destination, err := c.ReadPacket(body)
		if err != nil {
			body.Release()
			return err
		}
		if destination != m.Destination {
			body.Release()
			return errors.New("H3 final changed its original datagram destination")
		}
		if destination.String() == desktopImportedH3DNS {
			question := new(mDNS.Msg)
			err = question.Unpack(body.Bytes())
			body.Release()
			if err != nil || len(question.Question) != 1 || question.Question[0].Name != "selected.routervpn.test." || question.Question[0].Qtype != mDNS.TypeA {
				s.rejected.Add(1)
				return errors.New("H3 selected DNS received a bootstrap or foreign question")
			}
			s.selected.Add(1)
			answer := new(mDNS.Msg).SetReply(question)
			answer.Answer = []mDNS.RR{&mDNS.A{Hdr: mDNS.RR_Header{Name: question.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 1}, A: net.IPv4(203, 0, 113, 77)}}
			raw, e := answer.Pack()
			if e != nil {
				return e
			}
			reply, e := desktopImportedH3ReplyPacket(writer, raw)
			if e != nil {
				return e
			}
			if e = c.WritePacket(reply, destination); e != nil {
				return e
			}
		} else if destination.String() == desktopImportedH3Echo {
			if string(body.Bytes()) != "captured-imported-h3-udp" {
				body.Release()
				return errors.New("H3 final UDP payload changed")
			}
			s.udp.Add(1)
			reply, e := desktopImportedH3ReplyPacket(writer, body.Bytes())
			body.Release()
			if e != nil {
				return e
			}
			if err = c.WritePacket(reply, destination); err != nil {
				return err
			}
		} else {
			body.Release()
			s.rejected.Add(1)
			return errors.New("H3 final refused an uncaptured application datagram")
		}
	}
}
func (s *desktopImportedH3Servers) selectedStream(ctx context.Context, c net.Conn, m M.Metadata) error {
	stop := context.AfterFunc(ctx, func() { _ = c.Close() })
	defer stop()
	switch m.Destination.String() {
	case desktopImportedH3Echo:
		body := make([]byte, len("captured-imported-h3-tcp"))
		if _, e := io.ReadFull(c, body); e != nil {
			return e
		}
		if string(body) != "captured-imported-h3-tcp" {
			return errors.New("H3 final TCP payload changed")
		}
		s.tcp.Add(1)
		_, e := c.Write(body)
		return e
	case "10.77.0.1:8787":
		r, e := http.ReadRequest(bufio.NewReader(c))
		if e != nil {
			return e
		}
		defer r.Body.Close()
		profile := desktopImportedH3ObjectNoTest(s.source[4])
		if r.Method != http.MethodGet || r.Host != "10.77.0.1:8787" || r.URL.Path != "/health" || r.Header.Get("Authorization") != "Bearer "+profile["api_token"].(string) {
			s.rejected.Add(1)
			return errors.New("H3 private proof changed captured authority")
		}
		s.private.Add(1)
		body, _ := json.Marshal(map[string]any{"ok": true, "node_id": profile["node_proof_id"], "proof": "router-vpn-private-agent-v1"})
		_, e = fmt.Fprintf(c, "HTTP/1.1 200 OK\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s", len(body), body)
		return e
	default:
		s.rejected.Add(1)
		return errors.New("H3 final refused an uncaptured application stream")
	}
}
func desktopImportedH3ObjectNoTest(raw string) map[string]any {
	var value map[string]any
	_ = json.Unmarshal([]byte(raw), &value)
	return value
}

