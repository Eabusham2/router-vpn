// This factory is installed only after the complete derived native options
// match this Box. The network service constructs its OS owner in Initialize,
// before a TUN can change the physical routes. Preparation is not proof.
func (s *Box) RouterVPNDesktopExternalPreparePhysical(policy *mobilemultihop.DesktopExternalPolicy) error {
	_, err := s.RouterVPNDesktopExternalPreparePhysicalOwned(policy)
	return err
}

// Capture this exact service before startup so partial failure and normal
// teardown can query the same joined protection owner after Box cancellation.
type RouterVPNDesktopExternalPreparation struct {
	network *routervpndesktoppt.ExternalNetworkOwner
	policy  *mobilemultihop.DesktopExternalPolicy
}

func (s *Box) RouterVPNDesktopExternalPreparePhysicalOwned(policy *mobilemultihop.DesktopExternalPolicy) (*RouterVPNDesktopExternalPreparation, error) {
	if !routerVPNDesktopExternalPhysicalAvailable(policy) {
		return nil, errors.New("this native operating system has no admitted ordinary external socket factory")
	}
	_, _, network, err := s.routerVPNDesktopExternalPhysical(policy)
	if err != nil {
		return nil, err
	}
	owner := &RouterVPNDesktopExternalPreparation{network: network, policy: policy}
	return owner, network.PrepareExternalPhysicalPolicy(policy)
}

func (p *RouterVPNDesktopExternalPreparation) RetainedProtection(ctx context.Context) (*mobiletor.DesktopWindowsProtectionTarget, bool, error) {
	if p == nil || p.network == nil || p.policy == nil {
		return nil, false, errors.New("ordinary external preparation has no captured retirement owner")
	}
	return p.network.RetainedPhysicalProtection(ctx, p.policy)
}

func (s *Box) routerVPNDesktopExternalPhysical(policy *mobilemultihop.DesktopExternalPolicy) (option.Options, mobilemultihop.ExternalDesktopCapture, *routervpndesktoppt.ExternalNetworkOwner, error) {
	var empty option.Options
	var absent mobilemultihop.ExternalDesktopCapture
	if s == nil || s.ctx == nil || s.ctx.Err() != nil || s.service == nil || s.routerVPNExternalOptions == "" || policy == nil || policy.Validate() != nil {
		return empty, absent, nil, errors.New("ordinary desktop physical preparation requires its complete native Box")
	}
	meta := policy.Metadata()
	compiled, err := json.UnmarshalExtendedContext[option.Options](s.ctx, []byte(policy.Config()))
	if err != nil || meta.TargetOS != runtime.GOOS || routerVPNExternalOptionsDigest(s.ctx, compiled) != s.routerVPNExternalOptions {
		return empty, absent, nil, errors.New("ordinary desktop physical policy differs from its actual derived native graph")
	}
	capture, err := policy.Capture()
	if err != nil {
		return empty, absent, nil, err
	}
	raw, found := s.service.Get(mobilemultihop.DesktopExternalNetworkTag)
	network, ok := raw.(*routervpndesktoppt.ExternalNetworkOwner)
	if !found || !ok || network == nil || !network.Matches(meta.SessionID, meta.SourceSHA256) {
		return empty, absent, nil, errors.New("ordinary desktop physical policy has another captured native service")
	}
	return compiled, capture, network, nil
}

// The original policy still governs node, selected DNS and public-exit proof.
// Its desktop adaptation has a different configuration identity, checked
// against the actual Box above. Neither identity is relabeled as the other.
// A successful proof also owns the exact activated physical service and TUN.
func (s *Box) RouterVPNDesktopExternalCreateProof(policy *mobilemultihop.DesktopExternalPolicy) (proof *RouterVPNExternalProofRequest, failure error) {
	if !routerVPNDesktopExternalPhysicalAvailable(policy) {
		return nil, errors.New("this native operating system has no admitted ordinary external socket factory")
	}
	compiled, capture, network, err := s.routerVPNDesktopExternalPhysical(policy)
	if err != nil {
		return nil, err
	}
	engine, err := s.routerVPNExternalEngine(capture.EntryTag, capture.TUNTag, compiled)
	if err != nil || engine.Identity() == "" {
		return nil, errors.New("ordinary desktop proof lost its actual native graph owners")
	}
	ctx, err := network.Activate(policy)
	if err != nil {
		return nil, err
	}
	defer func() {
		if failure != nil {
			// The Box retains this exact service for joined, retryable teardown.
			// Revoke admission now, including a source returned after failure.
			network.Cancel()
		}
	}()
	reader, ok := engine.tun.(routerVPNDesktopTorTUN)
	if !ok || len(compiled.Inbounds) != 1 {
		return nil, errors.New("ordinary desktop proof has no owned native TUN readback")
	}
	tunOptions, ok := compiled.Inbounds[0].Options.(*option.TunInboundOptions)
	if !ok {
		return nil, errors.New("ordinary desktop proof has no captured native TUN options")
	}
	binding := &routerVPNDesktopExternalBinding{ctx: ctx, policy: policy, network: network, interfaceName: tunOptions.InterfaceName}
	engine.physical = binding
	guard := binding.currentContext
	if runtime.GOOS == "windows" && (capture.Execution == "server" || capture.Execution == "auto") {
		binding.leaseControl,err = network.CaptureLeaseControl(ctx)
		if err != nil { return nil,err }
		guard = binding.leaseControl.Current
	}
	bounded, ok := reader.(interface {
		RouterVPNDesktopMTUContext(context.Context, func(context.Context) error) (string, int, int, error)
	})
	if !ok {
		return nil, errors.New("ordinary desktop TUN lacks its bounded generation guard")
	}
	name, index, mtu, err := bounded.RouterVPNDesktopMTUContext(ctx, guard)
	if err != nil || name == "" || index < 1 || mtu != capture.ConfiguredMTU || binding.interfaceName != "" && name != binding.interfaceName {
		return nil, errors.New("ordinary desktop native TUN differs from its captured interface policy")
	}
	if err := binding.bindTUN(ctx, reader, name, uint32(index)); err != nil {
		return nil, err
	}
	binding.inbound, binding.reader, binding.name, binding.index, binding.mtu = engine.tun, reader, name, index, mtu
	if engine.Identity() == "" {
		return nil, errors.New("ordinary desktop graph retired while binding its native TUN")
	}
	if runtime.GOOS == "windows" && (capture.Execution == "server" || capture.Execution == "auto") {
		engine.leaseCleanup = newRouterVPNExternalLeaseCleanup(engine,binding.sealLeaseCleanup)
	}
	request, err := mobilemultihop.NewExternalProofRequest(ctx, policy.OriginalPolicy(), policy.Metadata().SessionID, engine)
	if err != nil {
		return nil, err
	}
	return &RouterVPNExternalProofRequest{request: request, engine: engine}, nil
}

func routerVPNDesktopExternalPhysicalAvailable(policy *mobilemultihop.DesktopExternalPolicy) bool {
	if runtime.GOOS == "linux" {
		return true // Preserve the existing complete Linux factory contract.
	}
	if runtime.GOOS == "darwin" && policy != nil && policy.Validate() == nil {
		meta := policy.Metadata()
		return meta.TargetOS == "darwin" && meta.SOCKSUDPAssociationRequired == (meta.Protocol == "socks5") &&
			(meta.Protocol == "http-connect" || meta.Protocol == "https-connect" || meta.Protocol == "shadowsocks" || meta.Protocol == "hysteria2" || meta.Protocol == "socks5" || meta.Protocol == "wireguard" || meta.Protocol == "amneziawg" || meta.Protocol == "openvpn")
	}
	if runtime.GOOS != "windows" || policy == nil || policy.Validate() != nil {
		return false
	}
	meta := policy.Metadata()
	return meta.TargetOS == "windows" && meta.SOCKSUDPAssociationRequired == (meta.Protocol == "socks5") &&
		(meta.Protocol == "http-connect" || meta.Protocol == "https-connect" || meta.Protocol == "shadowsocks" || meta.Protocol == "hysteria2" || meta.Protocol == "socks5" || meta.Protocol == "wireguard" || meta.Protocol == "amneziawg" || meta.Protocol == "openvpn")
}

// Reader state is read or changed under the owning engine's lock after initial
// construction. current deliberately consults only the permanent generation;
// a TUN replacement calls it while that same engine lock is already held.
type routerVPNDesktopExternalBinding struct {
	ctx           context.Context
	policy        *mobilemultihop.DesktopExternalPolicy
	network       *routervpndesktoppt.ExternalNetworkOwner
	inbound       adapter.Inbound
	reader        routerVPNDesktopTorTUN
	interfaceName string
	name          string
	index, mtu    int
	detached      bool
	terminalCleanup *routerVPNDesktopExternalLeaseBarrier
	leaseControl *routervpndesktoppt.ExternalLeaseControl
}

func (b *routerVPNDesktopExternalBinding) current() bool {
	return b != nil && b.ctx != nil && b.ctx.Err() == nil && b.network != nil && b.network.Current()
}

func (b *routerVPNDesktopExternalBinding) currentContext(ctx context.Context) error {
	if ctx == nil {
		return errors.New("external physical observation has no caller")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if b == nil || b.ctx == nil || b.ctx.Err() != nil || b.network == nil {
		return errors.New("external physical generation is retired")
	}
	return b.network.CurrentContext(ctx)
}
func (b *routerVPNDesktopExternalBinding) readbackContext(ctx context.Context, expected adapter.Inbound) (string, int, int, error) {
	if err := b.currentContext(ctx); err != nil {
		return "", 0, 0, err
	}
	if b.detached || b.inbound != expected || b.reader == nil {
		return "", 0, 0, errors.New("external TUN readback has a retired or replaced owner")
	}
	reader, ok := b.reader.(interface {
		RouterVPNDesktopMTUInterfaceContext(context.Context) (string, int, int, error)
	})
	if !ok {
		return "", 0, 0, errors.New("external TUN has no bounded native readback")
	}
	name, index, mtu, err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
	if err != nil {
		return "", 0, 0, err
	}
	if name != b.name || index != b.index || mtu != b.mtu {
		return "", 0, 0, errors.New("external TUN no longer matches its proved readback")
	}
	if err := b.currentContext(ctx); err != nil {
		return "", 0, 0, err
	}
	return name, index, mtu, nil
}
func (b *routerVPNDesktopExternalBinding) validTUNContext(ctx context.Context, expected adapter.Inbound) error {
	_, _, _, err := b.readbackContext(ctx, expected)
	return err
}

// Revocation from a bounded observation cannot wait for the source's native
// cleanup. The captured network context stops admission immediately; its
// existing broker/lifecycle owner retains and joins every source afterward.
func (b *routerVPNDesktopExternalBinding) cancelObservation() {
	if b != nil && b.network != nil {
		b.network.CancelAdmission()
	}
}

func (b *routerVPNDesktopExternalBinding) cancel() {
	if b != nil && b.network != nil {
		b.network.Cancel()
	}
}

func (b *routerVPNDesktopExternalBinding) bindTUN(ctx context.Context, reader routerVPNDesktopTorTUN, name string, index uint32) error {
	if b.terminalCleanup != nil { return errors.New("ordinary desktop TUN entered terminal cleanup") }
	if err := b.currentContext(ctx); err != nil {
		return err
	}
	if reader == nil || name == "" || index == 0 {
		return errors.New("ordinary desktop physical TUN binding is retired")
	}
	if runtime.GOOS != "darwin" {
		return b.network.BindPhysicalTunnel(ctx, name, index)
	}
	control, ok := reader.(interface {
		RouterVPNDesktopTunnelControlContext(context.Context, func(context.Context) error) (*os.File, error)
	})
	if !ok {
		return errors.New("ordinary Darwin protection requires its actual owned utun control")
	}
	file, err := control.RouterVPNDesktopTunnelControlContext(ctx, b.currentContext)
	if file != nil {
		defer file.Close()
	}
	if err != nil || file == nil {
		return errors.Join(err, errors.New("ordinary Darwin protection lost its native control descriptor"))
	}
	return b.network.BindPhysicalTunnelFile(ctx, name, index, file)
}

func (b *routerVPNDesktopExternalBinding) readback(expected adapter.Inbound) (string, int, int, error) {
	if !b.current() || b.detached || b.inbound != expected || b.reader == nil {
		return "", 0, 0, errors.New("ordinary desktop TUN readback belongs to a retired or replaced owner")
	}
	name, index, mtu, err := b.reader.RouterVPNDesktopMTUInterface()
	if err != nil || name != b.name || index != b.index || mtu != b.mtu || !b.current() {
		return "", 0, 0, errors.New("ordinary desktop TUN no longer matches its proved readback")
	}
	return name, index, mtu, nil
}

func (b *routerVPNDesktopExternalBinding) validTUN(expected adapter.Inbound) bool {
	_, _, _, err := b.readback(expected)
	return err == nil
}

func (b *routerVPNDesktopExternalBinding) retireTUN(ctx context.Context, expected adapter.Inbound) error {
	name, index, _, err := b.readbackContext(ctx, expected)
	if err != nil {
		return err
	}
	if err := b.network.RetirePhysicalTunnel(ctx, name, uint32(index)); err != nil {
		// A cancelled acknowledgement may follow the actual permit removal. Keep
		// that original transition recoverable by re-binding only this same reader.
		if mobiletor.ObservationContextExpired(ctx, err) {
			b.detached = true
		}
		return err
	}
	b.detached = true
	return nil
}

func (b *routerVPNDesktopExternalBinding) adoptTUN(ctx context.Context, current adapter.Inbound) error {
	if b.terminalCleanup != nil { return errors.New("ordinary desktop TUN entered terminal cleanup") }
	if err := b.currentContext(ctx); err != nil {
		return err
	}
	if !b.detached && current == b.inbound {
		_, _, _, err := b.readbackContext(ctx, current)
		return err
	}
	if !b.detached || current == nil || current.Type() != C.TypeTun {
		return errors.New("ordinary desktop replacement lost its captured transaction")
	}
	reader, ok := current.(routerVPNDesktopTorTUN)
	if !ok {
		return errors.New("ordinary desktop replacement has no bounded native reader")
	}
	name, index, mtu, err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
	if err != nil {
		return err
	}
	if name == "" || index < 1 || mtu < 1280 || mtu > 9000 || b.interfaceName != "" && name != b.interfaceName {
		return errors.New("ordinary desktop replacement has an invalid actual TUN identity")
	}
	if err := b.bindTUN(ctx, reader, name, uint32(index)); err != nil {
		return err
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	b.inbound, b.reader, b.name, b.index, b.mtu, b.detached = current, reader, name, index, mtu, false
	return nil
}

func (b *routerVPNDesktopExternalBinding) mtuAuthority(config, authority string) (string, string, error) {
	if !b.current() || b.policy == nil || b.policy.Validate() != nil || config != b.policy.OriginalPolicy().Config() {
		return "", "", errors.New("ordinary desktop MTU authority belongs to another original graph")
	}
	// This JSON was produced by the successful shared proof, never accepted
	// from a host. Preserve every field while changing only the source binding
	// to the actual desktop graph supplied alongside it.
	var fields map[string]EJSON.RawMessage
	var source string
	if EJSON.Unmarshal([]byte(authority), &fields) != nil || len(fields) != 6 || EJSON.Unmarshal(fields["source_sha256"], &source) != nil || source != b.policy.Metadata().OriginalSourceSHA256 {
		return "", "", errors.New("ordinary desktop MTU authority lost its original source identity")
	}
	for _, key := range []string{"schema", "id", "expected_public_ip", "mtu_policy", "jumbo_tun"} {
		if _, exists := fields[key]; !exists {
			return "", "", errors.New("ordinary desktop MTU authority lost its captured policy fields")
		}
	}
	fields["source_sha256"], _ = EJSON.Marshal(b.policy.Metadata().SourceSHA256)
	raw, err := EJSON.Marshal(fields)
	if err != nil || !b.current() {
		return "", "", errors.New("ordinary desktop MTU authority retired before delivery")
	}
	return b.policy.Config(), string(raw), nil
}

// Measurements keep the successful original proof's source authority while
// verifying the actual, separately sealed desktop graph. Only the retained
// physical binding can perform this translation; imported options cannot.
func (b *routerVPNDesktopExternalBinding) mtuAuthorityContext(ctx context.Context, config, authority string) (string, string, error) {
	if err := b.currentContext(ctx); err != nil {
		return "", "", err
	}
	if b.policy == nil || b.policy.Validate() != nil || config != b.policy.OriginalPolicy().Config() {
		return "", "", errors.New("ordinary desktop MTU authority belongs to another original graph")
	}
	// This JSON was produced by the successful shared proof, never accepted
	// from a host. Preserve every field while changing only the source binding
	// to the actual desktop graph supplied alongside it.
	var fields map[string]EJSON.RawMessage
	var source string
	if EJSON.Unmarshal([]byte(authority), &fields) != nil || len(fields) != 6 || EJSON.Unmarshal(fields["source_sha256"], &source) != nil || source != b.policy.Metadata().OriginalSourceSHA256 {
		return "", "", errors.New("ordinary desktop MTU authority lost its original source identity")
	}
	for _, key := range []string{"schema", "id", "expected_public_ip", "mtu_policy", "jumbo_tun"} {
		if _, exists := fields[key]; !exists {
			return "", "", errors.New("ordinary desktop MTU authority lost its captured policy fields")
		}
	}
	fields["source_sha256"], _ = EJSON.Marshal(b.policy.Metadata().SourceSHA256)
	raw, err := EJSON.Marshal(fields)
	if err != nil {
		return "", "", errors.New("ordinary desktop MTU authority retired before delivery")
	}
	if err := b.currentContext(ctx); err != nil {
		return "", "", err
	}
	return b.policy.Config(), string(raw), nil
}

// Measurements keep the successful original proof's source authority while
// verifying the actual, separately sealed desktop graph. Only the retained
// physical binding can perform this translation; imported options cannot.
func (b *routerVPNDesktopExternalBinding) measurementConfig(original string) (string, error) {
	if !b.current() || b.policy == nil || b.policy.Validate() != nil || original != b.policy.OriginalPolicy().Config() {
		return "", errors.New("ordinary desktop measurement belongs to another original graph")
	}
	return b.policy.Config(), nil
}

// A desktop MTU host must preserve the TUN already claimed before physical
// proof. Existing nonphysical external paths still claim their native reader
// once using the host's captured network guard.
func (l *RouterVPNExternalMTULease) ClaimDesktopTUN(guard func() bool) (string, int, int, error) {
	if guard == nil || !guard() || !l.Healthy() {
		return "", 0, 0, errors.New("ordinary desktop MTU has no captured current owner")
	}
	e := l.proof.engine
	e.mu.RLock()
	defer e.mu.RUnlock()
	if e.identityLocked() == "" || l.ctx.Err() != nil || l.closed.Load() {
		return "", 0, 0, errors.New("ordinary desktop MTU reader retired during capture")
	}
	if e.physical != nil {
		binding, ok := e.physical.(*routerVPNDesktopExternalBinding)
		if !ok {
			return "", 0, 0, errors.New("ordinary desktop MTU has another physical reader owner")
		}
		return binding.readback(e.tun)
	}
	reader, ok := e.tun.(routerVPNDesktopTorTUN)
	if !ok {
		return "", 0, 0, errors.New("ordinary desktop MTU has no native reader")
	}
	return reader.RouterVPNDesktopMTU(guard)
}

func (l *RouterVPNExternalMTULease) ClaimDesktopTUNContext(ctx context.Context, guard func(context.Context) error) (string, int, int, error) {
	if guard == nil {
		return "", 0, 0, errors.New("MTU claim has no captured guard")
	}
	if err := guard(ctx); err != nil {
		return "", 0, 0, err
	}
	if err := l.HealthyContext(ctx); err != nil {
		return "", 0, 0, err
	}
	e := l.proof.engine
	if err := adapter.RouterVPNRLockContext(ctx, &e.mu); err != nil {
		return "", 0, 0, err
	}
	defer e.mu.RUnlock()
	if _, err := e.identityLockedContext(ctx); err != nil {
		return "", 0, 0, err
	}
	reader, ok := e.tun.(interface {
		RouterVPNDesktopMTUContext(context.Context, func(context.Context) error) (string, int, int, error)
		RouterVPNDesktopMTUInterfaceContext(context.Context) (string, int, int, error)
	})
	if !ok {
		return "", 0, 0, errors.New("MTU claim has no bounded native reader")
	}
	if e.physical != nil {
		binding, ok := e.physical.(*routerVPNDesktopExternalBinding)
		if !ok {
			return "", 0, 0, errors.New("ordinary desktop MTU has another physical reader owner")
		}
		return binding.readbackContext(ctx, e.tun)
	}
	return reader.RouterVPNDesktopMTUContext(ctx, guard)
}

type routerVPNDesktopExternalLeaseBarrier struct {
	binding *routerVPNDesktopExternalBinding
	control mobiletor.DesktopSocketLeaseCleanup
	discarded atomic.Bool
	// The owning engine lock protects the frozen native reader.
	frozen bool
	inbound adapter.Inbound
	reader routerVPNDesktopTorTUN
	name string
	index int
}
func (b *routerVPNDesktopExternalBinding) sealLeaseCleanup(ctx context.Context) (routerVPNExternalLeaseBarrier,error) {
	if runtime.GOOS != "windows" || b == nil || b.network == nil || b.leaseControl == nil {
		return nil,errors.New("ordinary desktop has no verified terminal lease barrier")
	}
	if err := b.currentContext(ctx); err != nil { return nil,err }
	control,err := b.leaseControl.SealLeaseCleanup(ctx)
	if err != nil { return nil,err }
	return &routerVPNDesktopExternalLeaseBarrier{binding:b,control:control},nil
}
func (c *routerVPNDesktopExternalLeaseBarrier) Quiesce(ctx context.Context, expected adapter.Inbound) error {
	if c == nil || c.discarded.Load() || c.control == nil { return errors.New("terminal lease barrier is retired") }
	b := c.binding
	if !c.frozen {
		if b.terminalCleanup != nil { return errors.New("terminal lease barrier belongs to another attempt") }
		if err := b.leaseControl.Current(ctx); err != nil { return err }
		if b.detached || b.inbound != expected || b.reader == nil { return errors.New("terminal lease barrier lost its captured TUN") }
		reader,ok := b.reader.(interface{RouterVPNDesktopMTUInterfaceContext(context.Context)(string,int,int,error)})
		if !ok { return errors.New("terminal lease barrier has no bounded native TUN readback") }
		name,index,mtu,err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
		if err != nil { return err }
		if name != b.name || index != b.index || mtu != b.mtu { return errors.New("terminal lease barrier changed its actual native TUN") }
		if err := b.leaseControl.Current(ctx); err != nil { return err }
		c.inbound,c.reader,c.name,c.index,c.frozen = expected,b.reader,name,index,true
		b.terminalCleanup = c
	}
	if b.terminalCleanup != c || expected != c.inbound || b.inbound != c.inbound ||
		b.reader != c.reader || b.name != c.name || b.index != c.index {
		return errors.New("terminal lease barrier changed its original reader")
	}
	if err := c.control.Quiesce(ctx,c.name,uint32(c.index)); err != nil { return err }
	b.detached = true
	return nil
}
func (c *routerVPNDesktopExternalLeaseBarrier) Current(ctx context.Context, expected adapter.Inbound) error {
	if c == nil || c.discarded.Load() || !c.frozen || c.control == nil { return errors.New("terminal lease barrier has no acknowledged reader") }
	b := c.binding
	if b.terminalCleanup != c || !b.detached || expected != c.inbound || b.inbound != c.inbound ||
		b.reader != c.reader || b.name != c.name || b.index != c.index {
		return errors.New("terminal lease barrier lost its original reader")
	}
	return c.control.Current(ctx)
}
func (c *routerVPNDesktopExternalLeaseBarrier) Discard() {
	if c == nil || c.discarded.Swap(true) { return }
	c.control.Discard()
	// A terminal barrier is irreversible. Never clear binding.terminalCleanup.
}

func (c *routerVPNDesktopExternalLeaseBarrier) RevokeData() {
	if c != nil && c.binding != nil && c.binding.leaseControl != nil {
		c.binding.leaseControl.RevokeData()
	}
}
