func desktopNodeCommandShadowsocksOriginal(t *testing.T, layer string) *mobilemultihop.NodeProfile {
	t.Helper()
	input, err := desktopNodeCommandOriginalWithLayer(t, layer).LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source struct {
		Profile string `json:"profile_json"`
	}
	if json.Unmarshal([]byte(input), &source) != nil || source.Profile == "" {
		t.Fatal("Shadowsocks command lost its exact original node policy")
	}
	graph, _ := json.Marshal(map[string]any{
		"inbounds": []any{map[string]any{"type": "tun", "auto_route": true, "strict_route": true}},
		"outbounds": []any{map[string]any{"type": "shadowsocks", "tag": "proxy", "server": "192.0.2.44", "server_port": 8388,
			"method": "2022-blake3-aes-256-gcm", "password": base64.StdEncoding.EncodeToString([]byte(strings.Repeat("s", 32)))}},
		"route": map[string]any{"final": "proxy"},
	})
	files, _ := json.Marshal(map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString(graph)})
	// Shadowsocks is its own selected AES source; a separate Start owner is invalid.
	original, err := mobilemultihop.NewNodeProfile("shadowsocks", string(files), source.Profile, "", "")
	if err != nil {
		t.Fatal(err)
	}
	return original
}

func desktopImportedCommandOriginal(t *testing.T, mode, layer string, autoMTU bool) *mobilemultihop.Controller {
	t.Helper()
	var final *mobilemultihop.NodeProfile
	switch mode {
	case "shadowsocks":
		final = desktopNodeCommandShadowsocksOriginal(t, layer)
	case "hysteria2":
		final = desktopNodeCommandHysteria2Original(t, layer)
	case "reality-vision":
		final = desktopNodeCommandXrayOriginal(t, mode, layer)
	default:
		t.Fatal("imported command fixture has another final protocol")
	}
	launch, err := final.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var input struct {
		Mode    string `json:"mode"`
		Files   string `json:"files"`
		Profile string `json:"profile_json"`
		Start   string `json:"start"`
		DNS     string `json:"dns_bootstrap"`
	}
	if json.Unmarshal([]byte(launch), &input) != nil || input.Mode != mode {
		t.Fatal("imported command fixture lost its original final inputs")
	}
	capture := desktopExternalCapture
	if autoMTU {
		var fields map[string]any
		if json.Unmarshal([]byte(capture), &fields) != nil {
			t.Fatal("imported command fixture lost its original entry capture")
		}
		profile := fields["profile"].(map[string]any)
		profile["mtu_policy"] = "auto"
		delete(profile, "manual_mtu")
		encoded, err := json.Marshal(fields)
		if err != nil {
			t.Fatal(err)
		}
		capture = string(encoded)
	}
	original, err := mobilemultihop.NewImportedEntry(desktopExternalSource, capture, input.Mode, input.Files, input.Profile, input.Start, input.DNS)
	if err != nil {
		t.Fatal("complete imported command source did not compile", err)
	}
	t.Cleanup(func() { _ = original.Close() })
	return original
}

func desktopImportedCommandFiles(t *testing.T, inputs map[string]string) *routerVPNExternalFiles {
	t.Helper()
	directory := t.TempDir()
	if err := os.Chmod(directory, 0700); err != nil {
		t.Fatal(err)
	}
	for name, value := range inputs {
		if err := os.WriteFile(filepath.Join(directory, name), []byte(value), 0600); err != nil {
			t.Fatal(err)
		}
	}
	files, err := routerVPNOpenExternalFiles(directory)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = files.root.Close() })
	return files
}

func TestRouterVPNDesktopNodePhysicalCommandImportedSourceBoundary(t *testing.T) {
	if runtime.GOOS != "windows" {
		if policy, err := routerVPNImportedCommandPhysicalWithMTU(nil, desktopExternalSession, strings.Repeat("b", 64), strings.Repeat("c", 64), 0); err == nil || policy != nil {
			t.Fatal("another native host borrowed the imported Windows factory")
		}
		return
	}
	for _, mode := range []string{"shadowsocks", "hysteria2", "reality-vision"} {
		for _, layer := range []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			label := layer
			if label == "" {
				label = "off"
			}
			t.Run(mode+"/"+label, func(t *testing.T) {
				original := desktopImportedCommandOriginal(t, mode, layer, false)
				policy, err := mobilemultihop.NewDesktopImportedPolicy(original, desktopExternalSession, "windows")
				if err != nil {
					t.Fatal(err)
				}
				launch, err := original.ImportedLaunchInput()
				if err != nil {
					t.Fatal(err)
				}
				files := desktopImportedCommandFiles(t, map[string]string{"imported-source.json": launch, "sing-box.json": policy.Config()})
				actual, err := routerVPNImportedCommandPhysicalWithMTU(files, desktopExternalSession, policy.Metadata().ConfigSHA256, policy.Metadata().SourceSHA256, 0)
				if err != nil || actual == nil || actual.Config() != policy.Config() || !reflect.DeepEqual(actual.Metadata(), policy.Metadata()) || actual.OriginalController() == original {
					t.Fatal("native command did not independently reconstruct both captured hops", err)
				}
				_ = actual.OriginalController().Close()
			})
		}
	}
	for _, fault := range []string{"missing-source", "ordinary-source", "entry-secret", "final-secret", "unknown-field", "source-hash", "config-hash", "session", "missing-flag", "graph-bytes", "graph-rehash", "restored-mtu", "invalid-mtu"} {
		t.Run(fault, func(t *testing.T) {
			original := desktopImportedCommandOriginal(t, "hysteria2", "", false)
			policy, err := mobilemultihop.NewDesktopImportedPolicy(original, desktopExternalSession, "windows")
			if err != nil {
				t.Fatal(err)
			}
			launch, err := original.ImportedLaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			staged, source, config, session := policy.Config(), policy.Metadata().SourceSHA256, policy.Metadata().ConfigSHA256, desktopExternalSession
			mtu := 0
			switch fault {
			case "ordinary-source":
				launch, err = desktopNodeCommandOriginal(t).LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
			case "entry-secret", "final-secret":
				secret := "private-proxy-secret"
				if fault == "final-secret" {
					secret = "private-fixture-token"
				}
				if !strings.Contains(launch, secret) {
					t.Fatal("negative control did not locate its original private fixture")
				}
				launch = strings.ReplaceAll(launch, secret, "changed-private-fixture")
			case "unknown-field":
				launch = strings.TrimSuffix(launch, "}") + `,"unowned":true}`
			case "source-hash":
				source = strings.Repeat("f", 64)
			case "config-hash":
				config = strings.Repeat("f", 64)
			case "session":
				session = strings.Repeat("f", 32)
			case "missing-flag":
				source = ""
			case "graph-bytes", "graph-rehash":
				staged += "\n"
				if fault == "graph-rehash" {
					sum := sha256.Sum256([]byte(staged))
					config = hex.EncodeToString(sum[:])
				}
			case "restored-mtu":
				mtu = 1392
			case "invalid-mtu":
				mtu = 1279
			}
			inputs := map[string]string{"sing-box.json": staged, "imported-source.json": launch}
			if fault == "missing-source" {
				delete(inputs, "imported-source.json")
			}
			files := desktopImportedCommandFiles(t, inputs)
			if actual, err := routerVPNImportedCommandPhysicalWithMTU(files, session, config, source, mtu); err == nil || actual != nil {
				t.Fatal("imported command adopted altered source or another command family", fault)
			}
		})
	}
}

func TestRouterVPNDesktopNodePhysicalCommandImportedRestoredMTU(t *testing.T) {
	if runtime.GOOS != "windows" {
		if policy, err := routerVPNImportedCommandPhysicalWithMTU(nil, desktopExternalSession, strings.Repeat("b", 64), strings.Repeat("c", 64), 1392); err == nil || policy != nil {
			t.Fatal("another native host adopted an imported restoration")
		}
		return
	}
	for _, fault := range []string{"original", "missing", "different", "source-dropped"} {
		t.Run(fault, func(t *testing.T) {
			original := desktopImportedCommandOriginal(t, "hysteria2", "", true)
			policy, err := mobilemultihop.NewDesktopImportedPolicyWithMTU(original, desktopExternalSession, "windows", 1392)
			if err != nil {
				t.Fatal(err)
			}
			launch, err := original.ImportedLaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			files := desktopImportedCommandFiles(t, map[string]string{"imported-source.json": launch, "sing-box.json": policy.Config()})
			mtu, source := 1392, policy.Metadata().SourceSHA256
			switch fault {
			case "missing":
				mtu = 0
			case "different":
				mtu = 1380
			case "source-dropped":
				source = ""
			}
			actual, err := routerVPNImportedCommandPhysicalWithMTU(files, desktopExternalSession, policy.Metadata().ConfigSHA256, source, mtu)
			if fault == "original" {
				if err != nil || actual == nil || actual.Config() != policy.Config() || !reflect.DeepEqual(actual.Metadata(), policy.Metadata()) {
					t.Fatal("native import restoration changed its immutable original capture", err)
				}
				_ = actual.OriginalController().Close()
			} else if err == nil || actual != nil {
				t.Fatal("unbound imported restoration gained native admission", fault)
			}
		})
	}
}

func TestRouterVPNDesktopNodePhysicalCommandImportedJournalBeforePrivateInputs(t *testing.T) {
	directory := t.TempDir()
	if err := os.Chmod(directory, 0700); err != nil {
		t.Fatal(err)
	}
	want := errors.New("original imported parent was not authenticated")
	journal := &routerVPNNodeJournalAuthenticationFixture{failure: want}
	err := routerVPNRunNodeMTUFamilyCaptured(context.Background(), directory, desktopExternalSession, strings.Repeat("b", 64), "", strings.Repeat("c", 64), strings.Repeat("d", 64), 0, journal)
	if runtime.GOOS == "windows" {
		if !errors.Is(err, want) || journal.calls != 1 {
			t.Fatal("imported private inputs preceded original parent authentication", err, journal.calls)
		}
	} else if !errors.Is(err, routerVPNExternalFailure) || journal.calls != 0 {
		t.Fatal("another target entered imported native admission", err, journal.calls)
	}
}

func TestRouterVPNDesktopNodePhysicalCommandImportedExclusiveFamily(t *testing.T) {
	for _, fault := range []string{"both-flags", "missing-journal", "public-missing-journal"} {
		t.Run(fault, func(t *testing.T) {
			directory := filepath.Join(t.TempDir(), "private-input-must-not-open")
			var err error
			if fault == "public-missing-journal" {
				err = routerVPNRunImportedMTUWithJournal(context.Background(), directory, desktopExternalSession, strings.Repeat("b", 64), strings.Repeat("c", 64), strings.Repeat("d", 64), 0, routerVPNNodeJournalOptions{})
			} else {
				source := ""
				var journal routerVPNNodeJournal
				if fault == "both-flags" {
					source = strings.Repeat("c", 64)
					journal = &routerVPNNodeJournalAuthenticationFixture{}
				}
				err = routerVPNRunNodeMTUFamilyCaptured(context.Background(), directory, desktopExternalSession, strings.Repeat("b", 64), source, strings.Repeat("c", 64), strings.Repeat("d", 64), 0, journal)
			}
			if !errors.Is(err, routerVPNExternalFailure) || errors.Is(err, os.ErrNotExist) {
				t.Fatal("invalid imported command family opened private input", err)
			}
		})
	}
}

func desktopLinuxImportedCommandOriginal(t *testing.T) *mobilemultihop.Controller {
	t.Helper()
	final, err := desktopNodeCommandShadowsocksOriginal(t, "").LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var input struct {
		Mode    string `json:"mode"`
		Files   string `json:"files"`
		Profile string `json:"profile_json"`
		Start   string `json:"start"`
		DNS     string `json:"dns_bootstrap"`
	}
	if json.Unmarshal([]byte(final), &input) != nil {
		t.Fatal("lost paired final")
	}
	key := func(value string) string { return base64.StdEncoding.EncodeToString([]byte(strings.Repeat(value, 32))) }
	entry := map[string]any{
		"inbounds":  []any{map[string]any{"type": "tun", "tag": "tun-in", "address": []string{"172.29.93.1/30", "fd29:93::1/126"}, "mtu": 1280, "auto_route": true, "strict_route": true, "stack": "system"}},
		"outbounds": []any{},
		"endpoints": []any{map[string]any{"type": "wireguard", "tag": "custom-exit", "address": []string{"10.78.0.2/32", "fd78:78::2/128"}, "private_key": key("d"), "mtu": 1280,
			"peers": []any{map[string]any{"address": "192.168.51.7", "port": 51820, "public_key": key("e"), "pre_shared_key": key("f"), "allowed_ips": []string{"0.0.0.0/0", "::/0"}, "persistent_keepalive_interval": 25}}}},
		"route": map[string]any{"final": "custom-exit", "auto_detect_interface": true},
	}
	capture := map[string]any{"schema": 1, "exit_id": "captured-imported-entry", "protocol": "wireguard", "expected_public_ip": "203.0.113.88", "profile": map[string]any{
		"id": "captured-imported-entry", "node_kind": "external", "dns_mode": "rescue", "mtu_policy": "auto", "ipv6_mode": "on", "home_lan_access": false,
		"external": map[string]any{"protocol": "wireguard", "expected_public_ip": "203.0.113.88", "wireguard": map[string]any{
			"endpoint": "192.168.51.7:51820", "private_key": key("d"), "peer_public_key": key("e"), "preshared_key": key("f"), "addresses": []string{"10.78.0.2/32", "fd78:78::2/128"},
			"allowed_ips": []string{"0.0.0.0/0", "::/0"}, "persistent_keepalive_interval": 25, "mtu": 1280}}}}
	encoded, _ := json.Marshal(entry)
	captured, _ := json.Marshal(capture)
	original, err := mobilemultihop.NewImportedEntry(string(encoded), string(captured), input.Mode, input.Files, input.Profile, input.Start, input.DNS)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = original.Close() })
	return original
}

func TestRouterVPNDesktopNodePhysicalCommandImportedLinuxSource(t *testing.T) {
	for _, fault := range []string{"valid", "source", "config", "entry", "final", "dns", "mtu", "target", "ordinary-source", "missing-source"} {
		t.Run(fault, func(t *testing.T) {
			original := desktopLinuxImportedCommandOriginal(t)
			policy, err := mobilemultihop.NewDesktopImportedPolicyWithMTU(original, desktopExternalSession, "linux", 1280)
			if err != nil {
				t.Fatal(err)
			}
			input, err := original.ImportedLaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			config, source, staged, target, mtu := policy.Metadata().ConfigSHA256, policy.Metadata().SourceSHA256, policy.Config(), "linux", 1280
			inputs := map[string]string{"imported-source.json": input, "sing-box.json": staged}
			switch fault {
			case "source":
				source = strings.Repeat("f", 64)
			case "config":
				config = strings.Repeat("f", 64)
			case "entry":
				inputs["imported-source.json"] = strings.Replace(input, "192.168.51.7", "192.168.51.8", 1)
			case "final":
				inputs["imported-source.json"] = strings.Replace(input, "192.0.2.44", "192.0.2.45", 1)
			case "dns":
				inputs["sing-box.json"] = staged + " "
			case "mtu":
				mtu = 1281
			case "target":
				target = "windows"
			case "ordinary-source":
				inputs["imported-source.json"], _ = desktopNodeCommandShadowsocksOriginal(t, "").LaunchInput()
			case "missing-source":
				delete(inputs, "imported-source.json")
			}
			files := desktopImportedCommandFiles(t, inputs)
			actual, err := routerVPNImportedCommandPhysicalTarget(files, desktopExternalSession, config, source, mtu, target)
			if fault != "valid" {
				if err == nil || actual != nil {
					t.Fatal("Linux imported parser adopted changed original or family", fault)
				}
				return
			}
			if err != nil || actual == nil {
				t.Fatal(err)
			}
			if !reflect.DeepEqual(actual.Metadata(), policy.Metadata()) || actual.Config() != policy.Config() {
				t.Fatal("Linux imported parser changed complete original source")
			}
			if original == actual.OriginalController() {
				t.Fatal("child parser borrowed parent constructor")
			}
			if err := actual.OriginalController().Close(); err != nil {
				t.Fatal(err)
			}
		})
	}
}
