const (
	desktopNodeRouterHealthTarget = "10.77.0.1:8787"
	desktopNodeRouterHealthPort   = 8787
)

// The optional private test service reproduces the shipping agent's public
// /health shape. The selected SS2022, Hysteria2 or SIP003 graph authenticates transport; /health
// does not require the bearer token used by the agent's administrative APIs.
// This mapping is separate from the bounded inner routes so enabling it can
// neither remove the selected Home DNS mapping nor add arbitrary forwarding.
func desktopNodeRouterHealthCaptureValid(request desktopNodeLayerRequest) bool {
	if request.NodeProofID == "" {
		return !request.DirectRouter && !request.Cover
	}
	raw, err := hex.DecodeString(request.NodeProofID)
	plain := request.Layer == "" || request.Layer == "off"
	return err == nil && len(raw) == 32 && hex.EncodeToString(raw) == request.NodeProofID &&
		((request.Mode == "hysteria2" || request.Mode == "shadowsocks" || request.Mode == "ss-v2ray") &&
			(plain || request.Layer == "aes-256-gcm" || request.Layer == "aes-256-gcm+xor-whitening"))
}

type desktopNodeRouterHealth struct {
	physical  string
	queries   atomic.Uint32
	wrongNode atomic.Bool
}

func (h *desktopNodeRouterHealth) address() string {
	if h == nil {
		return ""
	}
	return h.physical
}

func (h *desktopNodeRouterHealth) count() uint32 {
	if h == nil {
		return 0
	}
	return h.queries.Load()
}

func startDesktopNodeRouterHealth(t *testing.T, ip netip.Addr, nodeID string) *desktopNodeRouterHealth {
	t.Helper()
	if nodeID == "" {
		return nil
	}
	if !ip.Is4() || !ip.IsPrivate() || !desktopNodeRouterHealthCaptureValid(desktopNodeLayerRequest{Mode: "shadowsocks", NodeProofID: nodeID}) {
		t.Fatal("Router HTTP peer lost its captured private address or exact node identity")
	}
	interfaces, err := net.Interfaces()
	found := false
	for _, iface := range interfaces {
		addresses, readErr := iface.Addrs()
		if readErr != nil {
			t.Fatal("Router HTTP peer lost its native interface inventory", readErr)
		}
		for _, address := range addresses {
			prefix, parseErr := netip.ParsePrefix(address.String())
			found = found || parseErr == nil && prefix.Addr() == ip && iface.Flags&net.FlagUp != 0 && iface.Flags&net.FlagLoopback == 0
		}
	}
	if err != nil || !found {
		t.Fatal("Router HTTP peer cannot bind an unowned private interface", err)
	}
	physical := netip.AddrPortFrom(ip, desktopNodeRouterHealthPort).String()
	listener, err := net.Listen("tcp4", physical)
	if err != nil {
		desktopNodeLayerPreparationError(t, "captured Router HTTP listener", err)
	}
	health := &desktopNodeRouterHealth{physical: physical}
	server := &http.Server{ReadHeaderTimeout: 2 * time.Second, ReadTimeout: 2 * time.Second,
		WriteTimeout: 2 * time.Second, IdleTimeout: time.Second, MaxHeaderBytes: 8 << 10,
		Handler: http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
			if request.Method != http.MethodGet || request.URL.Path != "/health" || request.URL.RawQuery != "" ||
				request.Host != desktopNodeRouterHealthTarget || request.ContentLength != 0 || len(request.TransferEncoding) != 0 {
				http.Error(writer, "uncaptured Router health request", http.StatusNotFound)
				return
			}
			health.queries.Add(1)
			identity := nodeID
			if health.wrongNode.Load() {
				first := "0"
				if identity[0] == '0' {
					first = "1"
				}
				identity = first + identity[1:]
			}
			writer.Header().Set("Content-Type", "application/json")
			_ = json.NewEncoder(writer).Encode(struct {
				OK     bool   `json:"ok"`
				NodeID string `json:"node_id"`
				Proof  string `json:"proof"`
			}{true, identity, "router-vpn-private-agent-v1"})
		})}
	joined := make(chan error, 1)
	go func() { joined <- server.Serve(listener) }()
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
		defer cancel()
		// Shutdown joins active HTTP handlers; Close on failure still releases
		// this listener, but cannot turn a missed join into passing evidence.
		if err := server.Shutdown(ctx); err != nil {
			_ = server.Close()
			t.Error("captured Router HTTP handlers did not join", err)
		}
		_ = listener.Close()
		if err := <-joined; !errors.Is(err, http.ErrServerClosed) {
			t.Error("captured Router HTTP listener did not join", err)
		}
	})
	return health
}

func TestRouterVPNDesktopNodeRouterHealthCapture(t *testing.T) {
	valid := desktopNodeLayerRequest{Mode: "shadowsocks", NodeProofID: strings.Repeat("a", 64)}
	if !desktopNodeRouterHealthCaptureValid(valid) || !desktopNodeRouterHealthCaptureValid(desktopNodeLayerRequest{Mode: "wg"}) {
		t.Fatal("captured optional Router identity or an existing peer was rejected")
	}
	if desktopNodeRouterHealthCaptureValid(desktopNodeLayerRequest{Mode: "shadowsocks", DirectRouter: true}) {
		t.Fatal("direct Router control accepted an uncaptured identity")
	}
	if desktopNodeRouterHealthCaptureValid(desktopNodeLayerRequest{Mode: "shadowsocks", Cover: true}) {
		t.Fatal("private cover control accepted an uncaptured Router identity")
	}
	for _, layer := range []string{"", "off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		covered := valid
		covered.Cover, covered.Layer = true, layer
		if !desktopNodeRouterHealthCaptureValid(covered) {
			t.Fatal("captured private Router cover or exact Start Layer was rejected", layer)
		}
		covered.Mode = "hysteria2"
		if !desktopNodeRouterHealthCaptureValid(covered) {
			t.Fatal("Hysteria2 Router capture rejected its exact retained layer", layer)
		}
		covered.Mode = "ss-v2ray"
		if !desktopNodeRouterHealthCaptureValid(covered) {
			t.Fatal("SIP003 Router capture rejected its exact retained layer", layer)
		}
	}
	for _, change := range []struct {
		name string
		edit func(*desktopNodeLayerRequest)
	}{
		{"short", func(r *desktopNodeLayerRequest) { r.NodeProofID = r.NodeProofID[:63] }},
		{"upper-case", func(r *desktopNodeLayerRequest) { r.NodeProofID = strings.ToUpper(r.NodeProofID) }},
		{"non-hex", func(r *desktopNodeLayerRequest) { r.NodeProofID = strings.Repeat("g", 64) }},
		{"other-mode", func(r *desktopNodeLayerRequest) { r.Mode = "wg" }},
		{"uncaptured-layer", func(r *desktopNodeLayerRequest) { r.Layer = "aes-256-gcm-xor" }},
	} {
		t.Run(change.name, func(t *testing.T) {
			changed := valid
			change.edit(&changed)
			if desktopNodeRouterHealthCaptureValid(changed) {
				t.Fatal("Router reference accepted an uncaptured identity or graph")
			}
		})
	}
}

// This uses the actual compiled client, independent encrypted peer and shipping
// whitening relay. Kernel policy and TUN remain the existing explicit modeled
// boundary here; the installed gate separately requires the real native host.
func TestRouterVPNDesktopNodeEncryptedRouterHealthLayers(t *testing.T) {
	for _, test := range []struct{ mode, layer, label string }{
		{"shadowsocks", "", "off"}, {"shadowsocks", "aes-256-gcm", "aes-256-gcm"},
		{"shadowsocks", "aes-256-gcm+xor-whitening", "aes-256-gcm+xor-whitening"}, {"hysteria2", "", "hy2-off"},
		{"hysteria2", "aes-256-gcm", "hy2-aes"}, {"hysteria2", "aes-256-gcm+xor-whitening", "hy2-whitening"},
	} {
		t.Run(test.label, func(t *testing.T) {
			_, ip := desktopNodePeerInterface(t)
			nodeID := strings.Repeat("a", 64)
			peer := startDesktopNodeLayerReference(t, test.mode, test.layer, ip, nodeID)
			f := newDesktopNodeLayerFixture(t, peer, "")
			if err := f.box.RouterVPNStrategyStart(); err != nil {
				t.Fatal("captured Router reference did not enter actual encrypted startup", err)
			}
			outer, found := f.box.Outbound().Outbound("proxy")
			if !found {
				t.Fatal("captured Router reference lost its exact encrypted outbound")
			}
			for _, action := range []string{"restore-node", "wrong-node", "restore-node"} {
				before := peer.observe(t, action)
				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
				transport := &http.Transport{Proxy: nil, DisableKeepAlives: true,
					DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
						if network != "tcp" || address != desktopNodeRouterHealthTarget {
							return nil, errors.New("Router reference changed its captured routed destination")
						}
						return outer.DialContext(ctx, network, M.ParseSocksaddr(address))
					}}
				client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("Router reference cannot redirect") }}
				request, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://"+desktopNodeRouterHealthTarget+"/health", nil)
				if err != nil {
					cancel()
					t.Fatal(err)
				}
				response, err := client.Do(request)
				if err != nil {
					cancel()
					transport.CloseIdleConnections()
					t.Fatal("captured Router health did not cross its encrypted Start Layer", err)
				}
				body, readErr := io.ReadAll(io.LimitReader(response.Body, 1025))
				closeErr := response.Body.Close()
				transport.CloseIdleConnections()
				cancel()
				var actual struct {
					OK     bool   `json:"ok"`
					NodeID string `json:"node_id"`
					Proof  string `json:"proof"`
				}
				after := peer.observe(t, "stats")
				ciphertext := after.RawTCP > before.RawTCP
				plainTCP := after.PlainTCP == before.PlainTCP+1
				if test.mode == "hysteria2" {
					ciphertext = before.RawTCP == 0 && after.RawTCP == 0 && after.RawUDP > before.RawUDP && after.ProtocolRawUDP > before.ProtocolRawUDP
					plainTCP = after.ProtocolTCP == before.ProtocolTCP+1
				}
				if readErr != nil || closeErr != nil || len(body) > 1024 || response.StatusCode != http.StatusOK || json.Unmarshal(body, &actual) != nil ||
					!actual.OK || actual.Proof != "router-vpn-private-agent-v1" || (actual.NodeID == nodeID) == (action == "wrong-node") ||
					after.RouterQueries != before.RouterQueries+1 || after.DirectQueries != 0 || !ciphertext || !plainTCP {
					t.Fatal("captured layered Router response lost its original identity or encrypted counters", action, readErr, closeErr, before, after)
				}
			}
			for _, action := range []string{"restore-dns", "fail-dns", "restore-dns"} {
				before := peer.observe(t, action)
				err := f.box.RouterVPNStrategyDNSProof()
				after := peer.observe(t, "stats")
				if (err == nil) == (action == "fail-dns") || after.DNSQueries != before.DNSQueries+1 || after.RawUDP <= before.RawUDP || after.PlainUDP <= before.PlainUDP || test.mode == "hysteria2" && after.ProtocolUDP <= before.ProtocolUDP {
					t.Fatal("captured layered Router peer substituted the selected resolver or a cached answer", action, err, before, after)
				}
			}
			if test.mode == "hysteria2" {
				capture, err := f.policy.Capture()
				kind, destinations := "hysteria2", 1
				if test.layer != "" {
					kind, destinations = "shadowsocks", 1
				}
				if test.layer == "aes-256-gcm+xor-whitening" {
					kind = "routervpn-aes-xor"
				}
				if err != nil || len(capture.PhysicalRoots) != 1 || capture.PhysicalRoots[0].Type != kind ||
					len(capture.PhysicalRoots[0].Destinations) != destinations ||
					capture.SelectedDNS.Host != "192.168.50.133" || capture.SelectedDNS.Physical || capture.SelectedDNS.Detour != "proxy" ||
					capture.ConfiguredMTU != 1280 || capture.KillSwitchPolicy != "always" {
					t.Fatal("Hysteria2 Router graph changed its exact UDP lower, selected DNS, MTU or protection", err)
				}
				seen := map[string]bool{}
				for _, destination := range capture.PhysicalRoots[0].Destinations {
					if destination.Host != ip.String() || destination.Port != int(peer.remote.Port()) ||
						destination.Network != "udp" || seen[destination.Network] {
						t.Fatal("Hysteria2 layer opened an inner, DNS or unrelated physical destination")
					}
					seen[destination.Network] = true
				}
				for _, network := range []string{"tcp", "udp"} {
					for _, destination := range []string{"192.0.2.99", "2001:db8::99"} {
						if err := f.exchange(network, destination); err != nil {
							t.Fatal("Hysteria2 Router graph lost independent encrypted IPv4/IPv6 payload", network, destination, err)
						}
					}
				}
				f.kernel.mu.Lock()
				requests := f.kernel.requests
				for _, grant := range f.kernel.grants {
					if grant.Network != "udp" || grant.Remote != peer.remote || grant.Capture != f.kernel.capture {
						t.Error("Hysteria2 borrowed a TCP, DNS or foreign physical socket grant", grant.Network, grant.Remote)
					}
				}
				f.kernel.mu.Unlock()
				if requests == 0 || f.network.Current() {
					t.Fatal("Hysteria2 bypassed socket ownership or treated modeled kernel/TUN policy as ready")
				}
				f.source.Cancel()
				if f.exchange("udp") == nil {
					t.Fatal("cancelled Hysteria2 owner delivered replacement encrypted payload")
				}
				if err := f.close(); err != nil || !f.source.closed.Load() {
					t.Fatal("Hysteria2 Router graph did not join its original native socket owner", err)
				}
			}
		})
	}
}
