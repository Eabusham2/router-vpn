	testRouterVPNNodeChainExecutionDarwinEarlyStop(t, func(t *testing.T, choice string) (*routerVPNDarwinNodeChainExecutionControl, *routerVPNExternalFiles, *routerVPNDarwinChainCaptureRead, *routerVPNDarwinChainBootstrapRead) {
		return routerVPNDarwinExecutionControlFixtureFromPreparation(t, desktopSOCKSExecutionCommandPreparation(t, "darwin", choice))
	})
}

