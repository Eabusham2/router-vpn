// Type is only the shared dependency-cycle exclusion. This package registers no
// embedded Tor outbound and never launches an external PT executable.
const Type = "routervpn-tor"

// Owner keeps native PT listeners, physical sockets, selected bootstrap DNS and
// their real drain in the same Go engine as the desktop TUN. The caller supplies
// the exact Box/network-generation witness and must retain this owner after any
// Start attempt until Close succeeds.
type Owner struct {
	ctx           context.Context
	cancel        context.CancelFunc
	plan          mobiletor.Plan
	plain         bool
	proxy         *mobiletor.TCPProxy
	lower         N.Dialer
	network       *torNetworkCapture
	upstream      *torUpstreamCapture
	entry         *mobiletor.DesktopPredecessor
	entryNetwork  *mobiletor.Network
	entryProved   atomic.Bool
	entryWorkers  sync.WaitGroup
	entryJoinOnce sync.Once
	entryJoined   chan struct{}
	options       torpt.NetworkOptions
	physical      func() bool
	retired       atomic.Bool
	ready         atomic.Bool
	mu            sync.Mutex
	started       bool
	closing       bool
	bridges       *torpt.Bridges
	startDone     chan struct{}
	watchDone     chan struct{}
}

// New opens no socket. Its direct dialer is the pinned native core's actual
// per-socket interface-bound dialer, not net.Dialer or an external process that
// would route back into the TUN. The explicit resolver is captured with all
// native query options and checked for Tor cycles before PT admission.
func New(ctx context.Context, plan mobiletor.Plan, resolver option.DomainResolveOptions, current func() bool) (*Owner, error) {
	return newNativeOwner(ctx, plan, resolver, nil, current, false)
}

// NewWithPredecessor captures the same complete typed entry already matched
// to the started Box. It cannot substitute the default outbound or physical
// route for the saved entry, and ProvePredecessor must succeed before Start.
func NewWithPredecessor(ctx context.Context, plan mobiletor.Plan, resolver option.DomainResolveOptions, predecessor *mobiletor.DesktopPredecessor, current func() bool) (*Owner, error) {
	if predecessor == nil || predecessor.Kind() == "" || predecessor.Tag() == "" || predecessor.Tag() == mobiletor.ProfileOutboundTag {
		return nil, errors.New("desktop Tor PT requires its exact captured predecessor proof owner")
	}
	return newNativeOwner(ctx, plan, resolver, predecessor, current, false)
}

// NewPlain captures guard relay TCP into the same physical or proved predecessor
// graph. Its authenticated proxy owns every guard socket; the Tor process never
// receives an unrestricted native dialer or a caller-supplied proxy binding.
func NewPlain(ctx context.Context, resolver option.DomainResolveOptions, predecessor *mobiletor.DesktopPredecessor, current func() bool) (*Owner, error) {
	if predecessor != nil && (predecessor.Kind() == "" || predecessor.Tag() == "" || predecessor.Tag() == mobiletor.ProfileOutboundTag) {
		return nil, errors.New("plain desktop Tor requires its exact captured predecessor")
	}
	return newNativeOwner(ctx, mobiletor.Plan{}, resolver, predecessor, current, true)
}

func newNativeOwner(ctx context.Context, plan mobiletor.Plan, resolver option.DomainResolveOptions, predecessor *mobiletor.DesktopPredecessor, current func() bool, plain bool) (*Owner, error) {
	if ctx == nil || ctx.Err() != nil || current == nil || !current() || resolver.Server == "" {
		return nil, errors.New("desktop Tor PT requires the exact live native physical owner and explicit bootstrap DNS")
	}
	manager := service.FromContext[adapter.NetworkManager](ctx)
	if manager == nil || !manager.AutoDetectInterface() || service.FromContext[adapter.DNSTransportManager](ctx) == nil {
		return nil, errors.New("desktop Tor PT requires native interface binding and the captured DNS manager")
	}
	if resolver.RewriteTTL != nil {
		ttl := *resolver.RewriteTTL
		resolver.RewriteTTL = &ttl
	}
	if resolver.ClientSubnet != nil {
		subnet := *resolver.ClientSubnet
		resolver.ClientSubnet = &subnet
	}
	options := option.DialerOptions{}
	options.DomainResolver = &resolver
	if predecessor != nil {
		options.Detour = predecessor.Tag()
	}
	lower, err := dialer.NewWithOptions(dialer.Options{Context: ctx, Options: options, RemoteIsDomain: true, NewDialer: true})
	if err != nil {
		return nil, errors.New("desktop Tor physical native dialer could not be captured")
	}
	return captureOwner(ctx, plan, options, current, lower, predecessor, plain)
}

// This internal constructor shares the shipping capture/ownership path with
// tests whose final native socket operation is a local fixture.
func newOwner(ctx context.Context, plan mobiletor.Plan, options option.DialerOptions, current func() bool, lower N.Dialer) (*Owner, error) {
	return newCapturedOwner(ctx, plan, options, current, lower, nil)
}

func newCapturedOwner(ctx context.Context, plan mobiletor.Plan, options option.DialerOptions, current func() bool, lower N.Dialer, predecessor *mobiletor.DesktopPredecessor) (*Owner, error) {
	return captureOwner(ctx, plan, options, current, lower, predecessor, false)
}

func captureOwner(ctx context.Context, plan mobiletor.Plan, options option.DialerOptions, current func() bool, lower N.Dialer, predecessor *mobiletor.DesktopPredecessor, plain bool) (*Owner, error) {
	if ctx == nil || ctx.Err() != nil || current == nil || !current() || lower == nil || options.DomainResolver == nil || options.DomainResolver.Server == "" ||
		(predecessor == nil && options.Detour != "") || (predecessor != nil && options.Detour != predecessor.Tag()) {
		return nil, errors.New("desktop Tor PT physical capture is missing or retired")
	}
	lines := make([]string, len(plan.Bridges))
	for i, bridge := range plan.Bridges {
		lines[i] = bridge.Line
	}
	verified := mobiletor.Plan{}
	if plain {
		if len(lines) != 0 {
			return nil, errors.New("plain desktop Tor cannot discard a captured bridge plan")
		}
	} else {
		var err error
		verified, err = mobiletor.NewPlan(common.ExternalTorBridgeConfig{Transport: "custom", Bridges: lines})
		if err != nil {
			return nil, err
		}
	}
	owned, cancel := context.WithCancel(ctx)
	upstream, err := captureTorUpstream(owned, mobiletor.ProfileOutboundTag, options.Detour)
	if err != nil {
		cancel()
		return nil, err
	}
	if predecessor != nil {
		// Force the native detour to retain its actual object now. Matching the
		// manager again is insufficient if its first lazy lookup acquired a
		// replacement owner under the same label before admission.
		detour, ok := S.Cast[*dialer.DetourDialer](lower)
		if !ok || upstream == nil {
			cancel()
			return nil, errors.New("desktop Tor predecessor dialer is not the native captured detour")
		}
		selected, err := detour.Dialer()
		if err != nil || selected != upstream.owners[options.Detour].owner || upstream.current() != nil {
			cancel()
			return nil, errors.New("desktop Tor predecessor changed during native dialer capture")
		}
	}
	capture, err := captureTorNetwork(owned, mobiletor.ProfileOutboundTag, options, lower)
	if err != nil {
		cancel()
		return nil, err
	}
	network, err := capture.prepare()
	if err != nil {
		cancel()
		return nil, err
	}
	owner := &Owner{ctx: owned, cancel: cancel, plan: verified, plain: plain, lower: lower, network: capture, upstream: upstream, entry: predecessor, options: network, physical: current,
		startDone: make(chan struct{}), watchDone: make(chan struct{}), entryJoined: make(chan struct{})}
	owner.options.Resolve = owner.resolve
	if predecessor != nil {
		owner.entryNetwork, err = mobiletor.NewNetwork(owned, owner.dial, nil)
		if err != nil {
			cancel()
			return nil, err
		}
	}
	if err := owner.current(); err != nil {
		cancel()
		if owner.entryNetwork != nil {
			_ = owner.entryNetwork.Close(context.Background())
		}
		return nil, err
	}
	return owner, nil
}

func (o *Owner) Context() context.Context { return o.ctx }

// ProvePredecessor executes the immutable capture's exact typed proof: private
// Router authentication or the ordinary provider's routed public-address proof.
// The proof worker and all late sockets remain owned until actual Close drain.
func (o *Owner) ProvePredecessor(ctx context.Context) (*mobiletor.DesktopBridgeEntryProof, error) {
	if o == nil || ctx == nil || o.entry == nil || o.entryNetwork == nil {
		return nil, errors.New("desktop Tor has no captured predecessor proof")
	}
	o.mu.Lock()
	if o.closing || o.retired.Load() || o.ctx.Err() != nil || ctx.Err() != nil {
		o.mu.Unlock()
		return nil, errors.New("desktop Tor predecessor proof belongs to a retired owner")
	}
	o.entryWorkers.Add(1)
	o.mu.Unlock()
	defer o.entryWorkers.Done()
	if err := o.current(); err != nil {
		return nil, err
	}
	if err := o.entry.Prove(ctx, o.entryNetwork.DialContext); err != nil {
		return nil, err
	}
	if ctx.Err() != nil || o.current() != nil {
		return nil, errors.New("desktop Tor predecessor proof completed after retirement")
	}
	o.entryProved.Store(true)
	if o.current() != nil {
		return nil, errors.New("desktop Tor predecessor proof lost its native owner")
	}
	// Identity was already validated by the immutable source compiler. The
	// receipt uses its non-secret profile identity, never a mutable UI label.
	receipt := &mobiletor.DesktopBridgeEntryProof{EntryID: o.entry.ID(), EntrySHA256: o.entry.Fingerprint(), CheckedAt: time.Now()}
	if o.entry.IsExternal() {
		receipt.EntryKind = mobiletor.ExternalPredecessorProofKind
	}
	return receipt, nil
}

func (o *Owner) Start() error {
	o.mu.Lock()
	if o.started || o.retired.Load() || o.ctx.Err() != nil {
		o.mu.Unlock()
		return errors.New("desktop Tor PT owner was already started or retired")
	}
	o.started = true
	o.mu.Unlock()
	defer close(o.startDone)
	if err := o.current(); err != nil {
		close(o.watchDone)
		return err
	}
	if o.entry != nil && !o.entryProved.Load() {
		o.retire()
		close(o.watchDone)
		return errors.New("desktop Tor PT cannot start before its captured entry is proved")
	}
	var stopping <-chan struct{}
	if o.plain {
		proxy, err := mobiletor.StartTCPProxy(o.ctx, o.dial)
		if err != nil {
			o.retire()
			close(o.watchDone)
			return err
		}
		o.mu.Lock()
		o.proxy = proxy
		o.mu.Unlock()
		stopping = proxy.Stopping()
	} else {
		bridges, err := torpt.StartWithNetwork(o.ctx, o.plan, o.dial, o.packets, o.options)
		if err != nil {
			o.retire()
			close(o.watchDone)
			return err
		}
		o.mu.Lock()
		o.bridges = bridges
		o.mu.Unlock()
		stopping = bridges.Stopping()
	}
	go func() {
		defer close(o.watchDone)
		select {
		case <-stopping:
			o.retire()
		case <-o.ctx.Done():
		}
	}()
	if err := o.current(); err != nil {
		return err
	}
	o.ready.Store(true)
	if !o.Current() {
		return errors.New("desktop Tor PT admission completed after retirement")
	}
	return nil
}

// Proxy is the owned object, never a client-facing address or credentials.
func (o *Owner) Proxy() (*mobiletor.TCPProxy, error) {
	if !o.Current() || !o.plain {
		return nil, errors.New("plain desktop Tor guard proxy has no live captured owner")
	}
	o.mu.Lock()
	proxy := o.proxy
	o.mu.Unlock()
	if proxy == nil || !o.Current() {
		return nil, errors.New("plain desktop Tor guard proxy changed its capture")
	}
	select {
	case <-proxy.Stopping():
		return nil, errors.New("plain desktop Tor guard proxy is stopping")
	default:
		return proxy, nil
	}
}

func (o *Owner) Listeners() (map[string]string, error) {
	if !o.Current() || o.plain {
		return nil, errors.New("desktop Tor PT listeners belong to a retired capture")
	}
	o.mu.Lock()
	bridges := o.bridges
	o.mu.Unlock()
	if bridges == nil {
		return nil, errors.New("desktop Tor PT listeners are not started")
	}
	listeners := bridges.Listeners()
	if !o.Current() {
		return nil, errors.New("desktop Tor PT listener capture changed")
	}
	return listeners, nil
}

func (o *Owner) Current() bool {
	return o != nil && o.ready.Load() && o.current() == nil
}

func (o *Owner) current() error {
	if o == nil {
		return net.ErrClosed
	}
	if o.retired.Load() || o.ctx.Err() != nil || !o.physical() || o.network.current() != nil || o.upstream.current() != nil {
		o.retire()
		return errors.New("desktop Tor PT physical network, resolver or native owner retired")
	}
	return nil
}

func (o *Owner) retire() {
	o.retired.Store(true)
	o.ready.Store(false)
	o.entryProved.Store(false)
	o.cancel()
}

func (o *Owner) operation(ctx context.Context) error {
	if ctx == nil {
		return errors.New("desktop Tor PT operation has no captured context")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	return o.current()
}

func (o *Owner) dial(ctx context.Context, network, address string) (net.Conn, error) {
	if err := o.operation(ctx); err != nil {
		return nil, err
	}
	destination := M.ParseSocksaddr(address)
	if !destination.IsValid() || destination.Port == 0 {
		return nil, errors.New("desktop Tor PT destination is invalid")
	}
	if o.entry != nil && destination.IsDomain() {
		// The native ResolveDialer captures the right DNS transport, but its
		// serial dial loop cannot observe this PT owner's retirement between
		// a late lookup and entry admission. Resolve through the same owned
		// query callback used by Snowflake, then recheck before every numeric
		// entry dial. Never fall back to a default resolver or another owner.
		family := "ip"
		if network == "tcp4" || network == "udp4" {
			family = "ip4"
		} else if network == "tcp6" || network == "udp6" {
			family = "ip6"
		}
		addresses, err := o.resolve(ctx, family, destination.Fqdn)
		if err != nil {
			return nil, err
		}
		var failures []error
		for _, address := range addresses {
			connection, err := o.dialAddress(ctx, network, M.SocksaddrFrom(address, destination.Port))
			if connection != nil || err == nil {
				// A late/error socket still belongs to the PT network and must
				// reach its real drain; do not lose it in an address retry.
				return connection, err
			}
			failures = append(failures, err)
			if currentErr := o.operation(ctx); currentErr != nil {
				return nil, errors.Join(append(failures, currentErr)...)
			}
		}
		return nil, errors.Join(failures...)
	}
	return o.dialAddress(ctx, network, destination)
}

func (o *Owner) dialAddress(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	if err := o.operation(ctx); err != nil {
		return nil, err
	}
	connection, err := o.lower.DialContext(context.WithValue(ctx, torBootstrapDNSKey{}, true), network, destination)
	if currentErr := o.operation(ctx); currentErr != nil {
		// The PT network retains even a late failed socket, including its real
		// Close result and worker drain. Never discard it outside that owner.
		return connection, errors.Join(err, currentErr)
	}
	return connection, err
}

func (o *Owner) packets(ctx context.Context, network, address string) (net.PacketConn, error) {
	if err := o.operation(ctx); err != nil {
		return nil, err
	}
	if network != "udp" && network != "udp4" && network != "udp6" {
		return nil, errors.New("desktop Tor PT packet operation requires UDP")
	}
	destination := M.ParseSocksaddr(address)
	if !destination.IsValid() {
		return nil, errors.New("desktop Tor PT packet hint is invalid")
	}
	// Pion checks the actual returned local address. This native callback is a
	// protected destination/family hint, never a promise to bind a requested IP.
	connection, err := o.lower.ListenPacket(context.WithValue(ctx, torBootstrapDNSKey{}, true), destination)
	if currentErr := o.operation(ctx); currentErr != nil {
		return connection, errors.Join(err, currentErr)
	}
	return connection, err
}

func (o *Owner) resolve(ctx context.Context, network, host string) ([]netip.Addr, error) {
	if err := o.operation(ctx); err != nil {
		return nil, err
	}
	addresses, err := o.network.resolve(ctx, network, host)
	if currentErr := o.operation(ctx); currentErr != nil {
		return nil, errors.Join(err, currentErr)
	}
	return addresses, err
}

// Close is retryable. Context cancellation stops admission but cannot certify
// that a pending native dial, DNS callback, transport worker or socket closed.
func (o *Owner) Close(ctx context.Context) error {
	if o == nil {
		return nil
	}
	if ctx == nil {
		return errors.New("desktop Tor PT close requires a bounded caller context")
	}
	o.retire()
	o.mu.Lock()
	o.closing = true
	if !o.started {
		o.started = true
		close(o.startDone)
		close(o.watchDone)
	}
	o.mu.Unlock()
	o.entryJoinOnce.Do(func() { go func() { o.entryWorkers.Wait(); close(o.entryJoined) }() })
	select {
	case <-o.entryJoined:
	case <-ctx.Done():
		return ctx.Err()
	}
	if o.entryNetwork != nil {
		if err := o.entryNetwork.Close(ctx); err != nil {
			return err
		}
	}
	select {
	case <-o.startDone:
	case <-ctx.Done():
		return ctx.Err()
	}
	o.mu.Lock()
	bridges, proxy := o.bridges, o.proxy
	o.mu.Unlock()
	if proxy != nil {
		if err := proxy.Close(ctx); err != nil {
			return err
		}
	}
	if bridges != nil {
		if err := bridges.Close(ctx); err != nil {
			return err
		}
	}
	select {
	case <-o.watchDone:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}
