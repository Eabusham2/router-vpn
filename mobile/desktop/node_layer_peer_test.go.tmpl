	}
	policy, err := mobilemultihop.NewDesktopNodePolicy(peer.original(t, "always", fault), hex.EncodeToString(nonce[:]), runtime.GOOS)
	if err != nil {
		t.Fatal(err)
	}
	f := &desktopNodePeerFixture{policy: policy}
	ins := inbound.NewRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
		f.tun = &desktopNodePeerTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag)}
