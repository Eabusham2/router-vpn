		if listener != nil {
			_ = listener.Close()
		}
		if entryPeer.close != nil {
			entryPeer.close()
		}
		closeTransport()
		for _, connection := range connections {
			_ = connection.Close()
		}
		server.workers.Wait()
		if socksPeer != nil && socksPeer.joinFailed.Load() {
			t.Error("installed SOCKS provider did not join its original TCP observer")
		}
	})
	respond := func() {
		reply := desktopExternalInstalledPeerReply{Schema: 1, Protocol: request.Protocol, Address: address, CA: ca,
			Connections: server.rawTCP.Load(), Streams: server.plainTCP.Load(), PhysicalUDP: server.rawUDP.Load(), Packets: server.plainUDP.Load(),
			DNSQueries: dnsQueries.Load(), PublicAttempts: publicAttempts.Load(), PublicReplies: publicReplies.Load(), AuthFailures: authFailures.Load()}
		if entryPeer.stats != nil {
			value := entryPeer.stats()
			reply.PacketEntry = &value
		}
		if benchmark != nil {
			reply.Latency = benchmark.receipt()
		}
		if layerPeer.stats != nil {
			value := layerPeer.stats()
			reply.Layer, reply.PhysicalUDP = &value, value.Raw
		}
		if request.Protocol == "openvpn" {
			reply.OpenVPNNetwork, reply.OpenVPNProfile = request.OpenVPNNetwork, openvpnProfile
			if openvpnPeer.stats != nil {
				observed := openvpnPeer.stats()
				reply.Connections, reply.Streams, reply.PhysicalUDP, reply.Packets = observed.connections, observed.streams, observed.physicalUDP, observed.packets
				reply.AuthFailures = uint32(observed.authFailures)
