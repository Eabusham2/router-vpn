// This actual SOCKS provider has one retained listener per authenticated UDP
// control. Its only inner destinations are the existing private test DNS and
// HTTPS responders. The native client must negotiate its real port; there is
// no final-socket mapping or guessed UDP control-port permission.
type desktopExternalInstalledSOCKSPeer struct {
	server       *desktopNodeLayerServer
	request      desktopExternalInstalledPeerRequest
	authFailures *atomic.Uint32
	mu           sync.Mutex
	relays       []string
	rejected     atomic.Uint32
	joinFailed   atomic.Bool
	bindHost     string
	entryRelay   func(net.Conn, net.PacketConn) (net.Addr, func(), error)
}

type desktopExternalInstalledSOCKSControl struct {
	net.Conn
	peer        *desktopExternalInstalledSOCKSPeer
	associated  atomic.Bool
	readDone    chan struct{}
	readOnce    sync.Once
	authWritten bool
}

func (c *desktopExternalInstalledSOCKSControl) Read(body []byte) (int, error) {
	if c.associated.Load() {
		defer c.readOnce.Do(func() { close(c.readDone) })
	}
	return c.Conn.Read(body)
}
func (c *desktopExternalInstalledSOCKSControl) Write(body []byte) (int, error) {
	// Observe the pinned server's actual authentication response once, before
	// its TCP/UDP handler starts. Never turn a generic transport error into an
	// authentication counter or expose the server's credential-bearing error.
	if !c.authWritten && len(body) == 2 && body[0] == 1 {
		c.authWritten = true
		if body[1] == socks5.UsernamePasswordStatusFailure {
			c.peer.authFailures.Add(1)
		}
	}
	return c.Conn.Write(body)
}

type desktopExternalInstalledSOCKSListener struct {
	peer    *desktopExternalInstalledSOCKSPeer
	control *desktopExternalInstalledSOCKSControl
	relay   *desktopExternalInstalledSOCKSRelay
}
type desktopExternalInstalledSOCKSRelay struct {
	net.PacketConn
	listener    *desktopExternalInstalledSOCKSListener
	readStarted atomic.Bool
	closeOnce   sync.Once
	advertised  net.Addr
	revoke      func()
}

func (l *desktopExternalInstalledSOCKSListener) ListenPacket(config net.ListenConfig, ctx context.Context, network, address string) (net.PacketConn, error) {
	if ctx.Err() != nil || l.relay != nil || network != "udp" || l.control.LocalAddr().(*net.TCPAddr).IP.String() != l.peer.bindHost || address != net.JoinHostPort(l.peer.bindHost, "0") {
		return nil, errors.New("installed SOCKS peer changed its actual association bind")
	}
	var packet net.PacketConn
	var err error
	for attempt := 0; attempt < 3; attempt++ {
		packet, err = config.ListenPacket(ctx, network, address)
		if err != nil {
			return nil, err
		}
		if packet.LocalAddr().(*net.UDPAddr).Port != l.control.LocalAddr().(*net.TCPAddr).Port {
			break
		}
		_ = packet.Close()
		packet = nil
	}
	if packet == nil {
		return nil, errors.New("installed SOCKS fixture could not retain a distinct real relay port")
	}
	if !l.peer.server.enter(packet) {
		_ = packet.Close()
		return nil, net.ErrClosed
	}
	advertised := packet.LocalAddr()
	var revoke func()
	l.peer.mu.Lock()
	entryRelay := l.peer.entryRelay
	l.peer.mu.Unlock()
	if entryRelay != nil {
		advertised, revoke, err = entryRelay(l.control.Conn, packet)
		if err != nil {
			l.peer.server.leave(packet)
			return nil, err
		}
	}
	l.relay = &desktopExternalInstalledSOCKSRelay{PacketConn: packet, listener: l, advertised: advertised, revoke: revoke}
	if l.peer.request.SOCKSFault == "relay-route" {
		l.relay.advertised = net.UDPAddrFromAddrPort(netip.AddrPortFrom(netip.MustParseAddr("198.51.100.241"), uint16(packet.LocalAddr().(*net.UDPAddr).Port)))
	}
	l.control.associated.Store(true)
	l.peer.mu.Lock()
	l.peer.relays = append(l.peer.relays, advertised.String())
	l.peer.mu.Unlock()
	return l.relay, nil
}

func (r *desktopExternalInstalledSOCKSRelay) LocalAddr() net.Addr { return r.advertised }

func (r *desktopExternalInstalledSOCKSRelay) ReadFrom(body []byte) (int, net.Addr, error) {
	r.readStarted.Store(true)
	n, source, err := r.PacketConn.ReadFrom(body)
	if err == nil {
		r.listener.peer.server.rawUDP.Add(1)
		if r.listener.peer.request.SOCKSFault == "control-eof" {
			_ = r.listener.control.Conn.Close()
			return 0, nil, net.ErrClosed
		}
	}
	return n, source, err
}
func (r *desktopExternalInstalledSOCKSRelay) Close() error {
	r.closeOnce.Do(func() {
		if r.revoke != nil {
			r.revoke()
		}
		r.listener.peer.server.leave(r.PacketConn)
	})
	return nil
}

func (p *desktopExternalInstalledSOCKSPeer) NewConnectionEx(ctx context.Context, connection net.Conn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
	defer connection.Close()
	var err error
	if _, owned := p.server.route("tcp", destination.String()); !owned {
		err = errors.New("installed SOCKS peer refused an unowned TCP destination")
	} else if err = N.ReportConnHandshakeSuccess(connection, connection); err == nil {
		err = p.server.NewConnection(ctx, connection, M.Metadata{Source: source, Destination: destination})
	}
	if onClose != nil {
		onClose(err)
	}
}
func (p *desktopExternalInstalledSOCKSPeer) NewPacketConnectionEx(ctx context.Context, connection N.PacketConn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
	defer connection.Close()
	err := p.server.NewPacketConnection(ctx, connection, M.Metadata{Source: source, Destination: destination})
	if onClose != nil {
		onClose(err)
	}
}

func (p *desktopExternalInstalledSOCKSPeer) serve(connection net.Conn) error {
	control := &desktopExternalInstalledSOCKSControl{Conn: connection, peer: p, readDone: make(chan struct{})}
	listener := &desktopExternalInstalledSOCKSListener{peer: p, control: control}
	defer func() {
		_ = control.Conn.Close()
		if listener.relay != nil {
			_ = listener.relay.Close()
			if listener.relay.readStarted.Load() {
				select {
				case <-control.readDone:
				case <-time.After(3 * time.Second):
					p.joinFailed.Store(true)
				}
			}
		}
	}()
	if p.request.SOCKSFault == "auth-downgrade" || p.request.SOCKSFault == "relay-domain" {
		return p.refuse(control)
	}
	authenticator := auth.NewAuthenticator([]auth.User{{Username: "captured-native-user", Password: p.request.Password}})
	return socks.HandleConnectionEx(p.server.ctx, control, STD.NewReader(control), authenticator, p, listener,
		5*time.Second, M.SocksaddrFromNet(connection.RemoteAddr()), nil)
}

func (p *desktopExternalInstalledSOCKSPeer) refuse(connection net.Conn) error {
	reader := STD.NewReader(connection)
	offer, err := socks5.ReadAuthRequest(reader)
	if err != nil || len(offer.Methods) != 1 || offer.Methods[0] != socks5.AuthTypeUsernamePassword {
		return errors.New("installed SOCKS negative lost its exact offered method")
	}
	if p.request.SOCKSFault == "auth-downgrade" {
		if err := socks5.WriteAuthResponse(connection, socks5.AuthResponse{Method: socks5.AuthTypeNotRequired}); err != nil {
			return err
		}
	} else {
		if err := socks5.WriteAuthResponse(connection, socks5.AuthResponse{Method: socks5.AuthTypeUsernamePassword}); err != nil {
			return err
		}
		credentials, err := socks5.ReadUsernamePasswordAuthRequest(reader)
		if err != nil || credentials.Username != "captured-native-user" || credentials.Password != p.request.Password {
			return errors.New("installed SOCKS reply negative changed original authentication")
		}
		if err := socks5.WriteUsernamePasswordAuthResponse(connection, socks5.UsernamePasswordAuthResponse{Status: socks5.UsernamePasswordStatusSuccess}); err != nil {
			return err
		}
		request, err := socks5.ReadRequest(reader)
		if err != nil || request.Command != socks5.CommandUDPAssociate {
			return errors.New("installed SOCKS negative lost its UDP association request")
		}
		if err := socks5.WriteResponse(connection, socks5.Response{ReplyCode: socks5.ReplyCodeSuccess, Bind: M.ParseSocksaddr("unrequested-relay.example:5353")}); err != nil {
			return err
		}
	}
	var body [1]byte
	if n, err := reader.Read(body[:]); n != 0 || !errors.Is(err, io.EOF) {
		return errors.New("installed native client did not close its rejected SOCKS control")
	}
	p.rejected.Add(1)
	return nil
}

func desktopExternalInstalledPeerCertificate(t *testing.T, latency bool) (tls.Certificate, string) {
	t.Helper()
	rootKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	root := &x509.Certificate{SerialNumber: big.NewInt(73001), Subject: pkix.Name{CommonName: "isolated installed external root"},
		NotBefore: now.Add(-time.Hour), NotAfter: now.Add(time.Hour), IsCA: true, BasicConstraintsValid: true,
		KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature}
	rootDER, err := x509.CreateCertificate(rand.Reader, root, root, &rootKey.PublicKey, rootKey)
	if err != nil {
		t.Fatal(err)
	}
	leafKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	leaf := &x509.Certificate{SerialNumber: big.NewInt(73002), Subject: pkix.Name{CommonName: "captured installed external peer"},
		NotBefore: now.Add(-time.Hour), NotAfter: now.Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature,
		ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, IPAddresses: []net.IP{net.ParseIP("1.1.1.1")},
		DNSNames: []string{"captured-external.example"}}
	if latency {
		leaf.DNSNames = append(leaf.DNSNames, "speed.cloudflare.com")
	}
	leafDER, err := x509.CreateCertificate(rand.Reader, leaf, root, &leafKey.PublicKey, rootKey)
	if err != nil {
		t.Fatal(err)
	}
	return tls.Certificate{Certificate: [][]byte{leafDER, rootDER}, PrivateKey: leafKey}, string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: rootDER}))
}

// The external profile has the captured plain Hysteria2 TLS/password contract.
// Reuse the actual pinned service and routed handler, with no Salamander option
// invented from the independent Router fixture's private configuration.
func startDesktopExternalInstalledHysteria2(t *testing.T, server *desktopNodeLayerServer, packet net.PacketConn, cert tls.Certificate, password string) func() {
	t.Helper()
	private, err := x509.MarshalPKCS8PrivateKey(cert.PrivateKey)
	if err != nil {
		_ = packet.Close()
		t.Fatal(err)
	}
	var chain []string
	for _, der := range cert.Certificate {
		chain = append(chain, string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})))
	}
	logger := log.NewNOPFactory().NewLogger("captured-external-hysteria2")
	tlsConfig, err := boxTLS.NewServer(server.ctx, logger, option.InboundTLSOptions{Enabled: true, Certificate: chain,
		Key: []string{string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: private}))}})
	clear(private)
	if err != nil {
		_ = packet.Close()
		t.Fatal(err)
	}
	service, err := HYQUIC.NewService[int](HYQUIC.ServiceOptions{Context: server.ctx, Logger: logger, TLSConfig: tlsConfig,
		UDPTimeout: 10 * time.Second, Handler: desktopNodeHysteria2Handler{server}})
	if err == nil {
		service.UpdateUsers([]int{1}, []string{password})
		err = tlsConfig.Start()
	}
	if err == nil {
		err = service.Start(&desktopNodeHysteria2Packet{PacketConn: packet, server: server})
	}
	close := func() {
		_ = packet.Close()
		if service != nil {
			_ = service.Close()
		}
		_ = tlsConfig.Close()
	}
	if err != nil {
		close()
		t.Fatal("actual external Hysteria2 service did not start", err)
	}
	return close
}

// This provider is the pinned OpenVPN server endpoint, on an address that
// exists only in the installed fixture's original disconnected namespace.
// Its encrypted listener is native-owned. The existing DNS/HTTPS responders
// count only decrypted upper traffic; no fabricated raw counter is supplied.
func startDesktopExternalInstalledOpenVPN(t *testing.T, server *desktopNodeLayerServer, request desktopExternalInstalledPeerRequest, dnsAddress, publicAddress string) (string, string, func()) {
	t.Helper()
	rootKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	root := &x509.Certificate{SerialNumber: big.NewInt(74001), Subject: pkix.Name{CommonName: "isolated installed provider root"}, NotBefore: now.Add(-time.Hour), NotAfter: now.Add(time.Hour),
		IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature}
	rootDER, err := x509.CreateCertificate(rand.Reader, root, root, &rootKey.PublicKey, rootKey)
	if err != nil {
		t.Fatal(err)
	}
	ca := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: rootDER}))
	issue := func(serial int64, name string, usage x509.ExtKeyUsage) (string, string) {
		key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
		if err != nil {
			t.Fatal(err)
		}
		leaf := &x509.Certificate{SerialNumber: big.NewInt(serial), Subject: pkix.Name{CommonName: name}, NotBefore: root.NotBefore, NotAfter: root.NotAfter,
			DNSNames: []string{name}, KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{usage}}
		der, err := x509.CreateCertificate(rand.Reader, leaf, root, &key.PublicKey, rootKey)
		if err != nil {
			t.Fatal(err)
		}
		private, err := x509.MarshalPKCS8PrivateKey(key)
		if err != nil {
			t.Fatal(err)
		}
		return string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})), string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: private}))
	}
	provider, providerKey := issue(74002, "provider.routervpn.test", x509.ExtKeyUsageServerAuth)
	client, clientKey := issue(74003, "installed-client.routervpn.test", x509.ExtKeyUsageClientAuth)
	used := make(map[int]bool)
	port := func() int {
		for attempt := 0; attempt < 128; attempt++ {
			listener, err := net.Listen("tcp4", net.JoinHostPort(request.Address, "0"))
			if err != nil {
				t.Fatal(err)
			}
			value := listener.Addr().(*net.TCPAddr).Port
			if used[value] {
				_ = listener.Close()
				continue
			}
			packet, err := net.ListenPacket("udp4", net.JoinHostPort(request.Address, strconv.Itoa(value)))
			_ = listener.Close()
			if errors.Is(err, syscall.EADDRINUSE) {
				continue
			}
			if err != nil {
				t.Fatal(err)
			}
			_ = packet.Close()
			used[value] = true
			return value
		}
		t.Fatal("installed provider could not retain a distinct transport port")
		return 0
	}
	unavailable := 0
	if request.OpenVPNFallback {
		unavailable = port()
	}
	control := "tls-auth"
	if request.OpenVPNNetwork == "udp" {
		control = "tls-crypt"
	}
	controlKey := "-----BEGIN OpenVPN Static key V1-----\n" + strings.Repeat(strings.Repeat("a", 32)+"\n", 16) + "-----END OpenVPN Static key V1-----\n"
	wrap := map[string]any{"type": strings.ReplaceAll(control, "-", "_"), "key": []string{controlKey}}
	if control == "tls-auth" {
		wrap["direction"] = "server"
	}
	rule := func(network, inner, physical string) map[string]any {
		original, err := netip.ParseAddrPort(inner)
		if err != nil {
			t.Fatal(err)
		}
		actual, err := netip.ParseAddrPort(physical)
		if err != nil || !actual.Addr().IsLoopback() {
			t.Fatal("provider lost its owned decrypted service", err)
		}
		return map[string]any{"network": []string{network}, "ip_cidr": []string{original.Addr().String() + "/32"}, "port": []int{int(original.Port())},
			"action": "route", "outbound": "selected-services", "override_address": actual.Addr().String(), "override_port": int(actual.Port())}
	}
	var instance *box.Box
	var listenPort int
	for attempt := 0; attempt < 16; attempt++ {
		listenPort = port()
		graph := map[string]any{"log": map[string]any{"disabled": true}, "endpoints": []any{map[string]any{"type": "openvpn-server", "tag": "provider", "system": false,
			"listen": request.Address, "listen_port": listenPort, "network": request.OpenVPNNetwork, "address": []string{"10.211.18.1/24"}, "data_ciphers": []string{"AES-256-GCM", "AES-128-GCM"},
			"tls": map[string]any{"certificate": []string{provider}, "key": []string{providerKey}, "client_certificate": []string{ca}, "verify_client_certificate": "require", "remote_certificate_tls": "client", "control_wrap": wrap}}},
			"outbounds": []any{map[string]any{"type": "direct", "tag": "selected-services"}}, "route": map[string]any{"rules": []any{
				rule("udp", "203.0.113.53:5353", dnsAddress), rule("tcp", "1.1.1.1:443", publicAddress), map[string]any{"action": "reject"}}}}
		ins, outs, endpoints := inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry()
		DIRECT.RegisterOutbound(outs)
		OVPN.RegisterEndpoint(endpoints)
		transports := boxDNS.NewTransportRegistry()
		DNST.RegisterUDP(transports)
		DNST.RegisterTCP(transports)
		DNSL.RegisterTransport(transports)
		OVPN.RegisterDNSTransport(transports)
		ctx := box.Context(server.ctx, ins, outs, endpoints, transports, boxService.NewRegistry(), certificate.NewRegistry())
		raw, err := json.Marshal(graph)
		if err != nil {
			t.Fatal(err)
		}
		options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
		if err != nil {
			t.Fatal("actual installed provider options", err)
		}
		instance, err = box.New(box.Options{Context: ctx, Options: options})
		if err != nil {
			t.Fatal("actual installed provider construction", err)
		}
		if err = instance.Start(); err == nil {
			break
		}
		closeErr := instance.Close()
		instance = nil
		if closeErr != nil || !errors.Is(err, syscall.EADDRINUSE) {
			t.Fatal("actual installed provider startup", errors.Join(err, closeErr))
		}
	}
	if instance == nil {
		t.Fatal("installed provider could not bind its native transport")
	}
	var closeOnce sync.Once
	closeProvider := func() {
		closeOnce.Do(func() {
			if err := instance.Close(); err != nil {
				t.Error("actual installed provider failed joined close", err)
			}
		})
	}
	t.Cleanup(closeProvider)
	config := "\n# Complete installed external provider import\r\nclient\n"
	if unavailable != 0 {
		config += fmt.Sprintf("remote %s %d tcp\n", request.Address, unavailable)
	}
	config += fmt.Sprintf("remote %s %d %s\n", request.Address, listenPort, request.OpenVPNNetwork)
	config += "verify-x509-name provider.routervpn.test name\nremote-cert-tls server\ndata-ciphers AES-256-GCM:AES-128-GCM\ntun-mtu 1400\nhand-window 3\ntls-timeout 1\n<ca>\n" + ca + "</ca>\n<cert>\n" + client + "</cert>\n<key>\n" + clientKey + "</key>\n<" + control + ">\n" + controlKey + "</" + control + ">\n"
	if control == "tls-auth" {
		config += "key-direction 1\n"
	}
	if len(config) > 12<<10 {
		t.Fatal("installed provider import exceeded its bounded private reply")
	}
	if _, err := nativeopenvpn.CompileProfile(nativeopenvpn.Profile{Config: config}, mobilemultihop.ExternalFinalTag, ""); err != nil {
		t.Fatal("actual installed provider import compiler", err)
	}
	return net.JoinHostPort(request.Address, strconv.Itoa(listenPort)), config, closeProvider
}

func TestRouterVPNDesktopExternalInstalledReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_EXTERNAL_INSTALLED_REFERENCE_CHILD") == "" {
		return
	}
	if os.Getenv("ROUTERVPN_EXTERNAL_INSTALLED_REFERENCE_CHILD") != "1" {
		t.Fatal("unknown installed external reference owner")
	}
	desktopExternalInstalledReferenceProcess(t, "11.77.0.2", map[string]bool{
		"shadowsocks": true, "http-connect": true, "https-connect": true, "hysteria2": true,
		"wireguard": true, "amneziawg": true, "openvpn": true, "socks5": true,
	}, false)
}

// Each native runner independently captures its allowed address and protocols.
// The original Linux entry keeps its fixed namespace address and full set.
func desktopExternalInstalledReferenceProcess(t *testing.T, capturedAddress string, protocols map[string]bool, latency bool) {
	t.Helper()
	desktopExternalInstalledReferenceProcessWithLayer(t, capturedAddress, protocols, latency, false)
}
func desktopExternalInstalledReferenceProcessWithLayer(t *testing.T, capturedAddress string, protocols map[string]bool, latency, allowLayer bool) {
	t.Helper()
	reader := STD.NewReaderSize(os.Stdin, desktopNodeLayerReferenceLimit+1)
	line, err := reader.ReadSlice('\n')
	var request desktopExternalInstalledPeerRequest
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	var trailing any
	if err != nil || len(line) > desktopNodeLayerReferenceLimit || decoder.Decode(&request) != nil || decoder.Decode(&trailing) != io.EOF || request.Schema != 1 ||
		request.Address != capturedAddress || !protocols[request.Protocol] {
		t.Fatal("installed external reference lost its exact bounded request", err)
