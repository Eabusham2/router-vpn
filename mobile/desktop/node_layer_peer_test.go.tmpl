	endpoints := endpoint.NewRegistry()
	RegisterEndpoint(endpoints)
	WG.RegisterEndpoint(endpoints)
	dnsRegistry := boxDNS.NewTransportRegistry()
	DNST.RegisterUDP(dnsRegistry)
	DNST.RegisterTCP(dnsRegistry)
	services := boxService.NewRegistry()
	routervpnperformance.RegisterService(services)
	boxService.Register[routervpndesktoppt.NodeCaptureOptions](services, mobilemultihop.DesktopNodeNetworkType, func(ctx context.Context, logger log.ContextLogger, tag string, options routervpndesktoppt.NodeCaptureOptions) (adapter.Service, error) {
		owned, err := routervpndesktoppt.NewNodeNetworkOwner(ctx, logger, tag, options)
		if err == nil {
			f.network = owned.(*routervpndesktoppt.NodeNetworkOwner)
		}
		return owned, err
	})
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx = box.Context(ctx, ins, outs, endpoints, dnsRegistry, services, certificate.NewRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(policy.Config()))
	if err != nil {
		t.Fatal(err)
	}
	options.Log = &option.LogOptions{Disabled: true}
	if desktopNodeXrayMode(peer.request.Mode) || desktopNodeNaiveMode(peer.request.Mode) || desktopNodeCompositeMode(peer.request.Mode) {
		diagnostic := filepath.Join(t.TempDir(), "owned-native-graph.log")
		options.Log = &option.LogOptions{Level: "debug", Output: diagnostic}
		t.Cleanup(func() {
			if t.Failed() {
				if file, err := os.Open(diagnostic); err == nil {
					defer file.Close()
					raw, _ := io.ReadAll(io.LimitReader(file, 64<<10))
					t.Logf("captured native graph diagnostics: %s", raw)
				}
			}
		})
	}
	f.box, err = box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal(err)
	}
	f.kernel = &desktopNodePeerKernel{owner: mobiletor.DesktopSocketKernelOwner{Kind: "unix-isolated-uid", IdentitySHA256: strings.Repeat("d", 64), Generation: 1, ProcessID: uint32(os.Getpid())},
		iface: iface, local: ip, remote: peer.remote, network: f.network, tun: f.tun, grants: make(map[string]mobiletor.DesktopSocketGrant)}
	f.kernel.live.Store(true)
	f.source = &desktopNodePeerSource{desktopNodePeerKernel: f.kernel}
	t.Cleanup(func() {
		if err := f.close(); err != nil || !f.source.closed.Load() {
			t.Error("layered Box did not join its retained socket source", err)
		}
	})
	if err := f.network.PrepareNodePhysicalBroker(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		if f.tun.ready.Load() || f.network.SocketCurrent() || f.network.Current() {
			t.Error("layered physical factory ran after socket or TUN readiness")
		}
		f.kernel.capture = capture
		allowed := map[string]netip.AddrPort{"tcp": peer.remote, "udp": peer.remote}
		if desktopNodeCompositeMode(peer.request.Mode) {
			allowed = peer.compositeRemotes(t)
		}
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, &desktopNodeLayerKernel{desktopNodePeerKernel: f.kernel, allowed: allowed}, current)
		return broker, f.source, err
	}); err != nil {
		t.Fatal(err)
	}
	return f
}

func desktopNodeLayerCases(t *testing.T, test func(*testing.T, string, string)) {
	t.Helper()
	for _, mode := range []string{"shadowsocks", "hysteria2", "wg", "awg2-fast", "awg2-strong"} {
		for _, layer := range []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			if mode != "shadowsocks" && mode != "hysteria2" && layer == "" {
				continue // Existing encrypted base cases already prove the plain path.
			}
			label := layer
			if label == "" {
				label = "off"
			}
			t.Run(mode+"/"+label, func(t *testing.T) { test(t, mode, layer) })
		}
	}
}

func TestRouterVPNDesktopNodeEncryptedLayerTraffic(t *testing.T) {
	t.Run("paired-listeners", desktopNodeLayerPortPairTests)
	desktopNodeLayerCases(t, desktopNodeLayerTraffic)
}

type desktopNodeLayerFailedClosePacket struct {
	net.PacketConn
	failure error
}

func (p *desktopNodeLayerFailedClosePacket) Close() error {
	return errors.Join(p.PacketConn.Close(), p.failure)
}

func desktopNodeLayerPortPairTests(t *testing.T) {
	ip := netip.MustParseAddr("127.0.0.1")
	retired := func(t *testing.T, addresses []string) {
		t.Helper()
		for _, address := range addresses {
			packet, err := net.ListenPacket("udp4", address)
			if err != nil {
				t.Fatal("layer allocator retained a partial UDP owner", err)
			}
			if err := packet.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
	t.Run("candidate-selection", func(t *testing.T) {
		for _, test := range []struct {
			seed [4]byte
			want [3]uint16
		}{
			{[4]byte{}, [3]uint16{16384, 16385, 16386}},
			{[4]byte{255, 255, 255, 255}, [3]uint16{49151, 49150, 49149}},
			{[4]byte{127, 255, 128, 0}, [3]uint16{49151, 16384, 16385}},
		} {
			actual, err := desktopNodeLayerPortCandidates(true, bytes.NewReader(test.seed[:]))
			if err != nil || actual != test.want {
				t.Fatal("layer candidates lost their distinct bounded diversification", actual, err)
			}
		}
		for _, entropy := range []io.Reader{nil, bytes.NewReader([]byte{1, 2, 3})} {
			if actual, err := desktopNodeLayerPortCandidates(true, entropy); err == nil || actual != [3]uint16{} {
				t.Fatal("layer candidates concealed missing entropy", actual, err)
			}
		}
		if actual, err := desktopNodeLayerPortCandidates(false, nil); err != nil || actual != [3]uint16{} {
			t.Fatal("ordinary layer allocation changed its native port-zero selection", actual, err)
		}
		for _, invalid := range [][3]uint16{{0, 16384, 16385}, {16384, 16384, 16385}, {16383, 16384, 16385}, {49152, 16384, 16385}} {
			called := false
			listener, packet, err := desktopNodeLayerPortPairCandidates(ip, invalid,
				func(string, string) (net.PacketConn, error) { called = true; return nil, nil }, net.Listen)
			if err == nil || listener != nil || packet != nil || called {
				t.Fatal("invalid layer candidates reached a native bind", invalid, err)
			}
		}
	})
	type heldPair struct {
		listener net.Listener
		packet   net.PacketConn
		port     uint16
	}
	retainCandidates := func(t *testing.T) ([3]uint16, []heldPair) {
		t.Helper()
		var ports [3]uint16
		var held []heldPair
		for i := range ports {
			candidates, err := desktopNodeLayerPortCandidates(true, rand.Reader)
			if err != nil {
				t.Fatal(err)
			}
			listener, packet, err := desktopNodeLayerPortPairCandidates(ip, candidates, net.ListenPacket, net.Listen)
			if err != nil {
				t.Fatal("could not retain actual candidate ownership for the allocation control", err)
			}
			t.Cleanup(func() { _ = listener.Close(); _ = packet.Close() })
			actual, err := netip.ParseAddrPort(packet.LocalAddr().String())
			if err != nil {
				t.Fatal(err)
			}
			ports[i] = actual.Port()
			held = append(held, heldPair{listener, packet, actual.Port()})
		}
		return ports, held
	}
	t.Run("retry-both-protocols", func(t *testing.T) {
		candidates, held := retainCandidates(t)
		if err := errors.Join(held[0].listener.Close(), held[1].packet.Close(), held[2].listener.Close(), held[2].packet.Close()); err != nil {
			t.Fatal(err)
		}
		udpCalls, tcpCalls := 0, 0
		listener, packet, err := desktopNodeLayerPortPairCandidates(ip, candidates,
			func(network, address string) (net.PacketConn, error) {
				udpCalls++
				if udpCalls == 3 {
					// The second TCP bind was blocked by our retained listener;
					// its partial UDP owner must be joined before the third bind.
					retired(t, []string{netip.AddrPortFrom(ip, held[1].port).String()})
				}
				return net.ListenPacket(network, address)
			}, func(network, address string) (net.Listener, error) {
				tcpCalls++
				return net.Listen(network, address)
			})
		if listener != nil {
			t.Cleanup(func() { _ = listener.Close() })
		}
		if packet != nil {
			t.Cleanup(func() { _ = packet.Close() })
		}
		expected := netip.AddrPortFrom(ip, candidates[2]).String()
		if err != nil || listener == nil || packet == nil || listener.Addr().String() != expected || packet.LocalAddr().String() != expected || udpCalls != 3 || tcpCalls != 2 {
			t.Fatal("layer candidates did not join both blocked protocols before retaining the third exact pair", udpCalls, tcpCalls, err)
		}
		if err := errors.Join(listener.Close(), packet.Close()); err != nil {
			t.Fatal(err)
		}
		retired(t, []string{expected})
	})
	t.Run("udp-collision-bound", func(t *testing.T) {
		candidates, held := retainCandidates(t)
		calls := 0
		listener, packet, err := desktopNodeLayerPortPairCandidates(ip, candidates,
			func(network, address string) (net.PacketConn, error) {
				calls++
				return net.ListenPacket(network, address)
			},
			func(string, string) (net.Listener, error) {
				t.Fatal("blocked UDP candidate reached TCP")
				return nil, nil
			})
		if err == nil || listener != nil || packet != nil || calls != 3 || !desktopNodeLayerAllocationError(err) {
			t.Fatal("layer UDP allocation escaped its three actual blocked candidates", calls, err)
		}
		for _, owner := range held {
			if err := errors.Join(owner.listener.Close(), owner.packet.Close()); err != nil {
				t.Fatal("layer allocator closed another retained blocker", err)
			}
		}
	})
	for _, kind := range []string{"udp-access-denied-bound", "udp-fatal-error", "udp-foreign-pair", "partial-close-error"} {
		t.Run(kind, func(t *testing.T) {
			calls := 0
			fatal := errors.New("intentional UDP construction failure")
			closeFailure := errors.New("intentional partial UDP close failure")
			var addresses []string
			candidates := [3]uint16{16384, 16385, 16386}
			if kind == "udp-foreign-pair" || kind == "partial-close-error" {
				var held []heldPair
				candidates, held = retainCandidates(t)
				for _, owner := range held {
					if err := errors.Join(owner.listener.Close(), owner.packet.Close()); err != nil {
						t.Fatal(err)
					}
				}
			}
			listener, packet, err := desktopNodeLayerPortPairCandidates(ip, candidates,
				func(network, address string) (net.PacketConn, error) {
					calls++
					switch kind {
					case "udp-access-denied-bound":
						return nil, &net.OpError{Op: "listen", Net: network, Err: os.NewSyscallError("bind", syscall.Errno(10013))}
					case "udp-fatal-error":
						return nil, fatal
					default:
						actual := address
						if kind == "udp-foreign-pair" {
							actual = netip.AddrPortFrom(ip, candidates[1]).String()
						}
						owned, err := net.ListenPacket(network, actual)
						if owned != nil {
							addresses = append(addresses, owned.LocalAddr().String())
						}
						if kind == "partial-close-error" && err == nil {
							return &desktopNodeLayerFailedClosePacket{owned, closeFailure}, nil
						}
						return owned, err
					}
				}, func(string, string) (net.Listener, error) {
					if kind != "partial-close-error" {
						t.Fatal("unowned UDP candidate reached its TCP constructor")
					}
					return nil, fatal
				})
			count := 1
			if kind == "udp-access-denied-bound" && runtime.GOOS == "windows" {
				count = 3
			}
			if err == nil || listener != nil || packet != nil || calls != count {
				t.Fatal("layer UDP construction failure lost its bounded owner", kind, calls, err)
			}
			if kind == "udp-access-denied-bound" && !errors.Is(err, syscall.Errno(10013)) || kind == "udp-fatal-error" && !errors.Is(err, fatal) || kind == "partial-close-error" && (!errors.Is(err, fatal) || !errors.Is(err, closeFailure)) {
				t.Fatal("layer UDP construction lost its original error", err)
			}
			retired(t, addresses)
		})
	}
	t.Run("retained-pair", func(t *testing.T) {
		var address string
		listener, packet, err := desktopNodeLayerPortPair(ip, func(network, actual string) (net.Listener, error) {
			address = actual
			captured, err := netip.ParseAddrPort(actual)
			if err != nil || network != "tcp4" || captured.Addr() != ip || captured.Port() == 0 {
				return nil, errors.New("layer allocator did not capture its real UDP endpoint before TCP")
			}
			if runtime.GOOS == "windows" && (captured.Port() < 16384 || captured.Port() >= 49152) {
				return nil, errors.New("Windows layer allocator did not use its bounded independent candidates")
			}
			other, err := net.ListenPacket("udp4", actual)
			if err == nil {
				_ = other.Close()
				return nil, errors.New("layer allocator released its UDP owner before the TCP bind")
			}
			return net.Listen(network, actual)
		})
		if listener != nil {
			t.Cleanup(func() { _ = listener.Close() })
		}
		if packet != nil {
			t.Cleanup(func() { _ = packet.Close() })
		}
		if err != nil || listener == nil || packet == nil {
			t.Fatal("layer allocator failed its real same-port pair", err)
		}
		if listener.Addr().String() != address || packet.LocalAddr().String() != address {
			t.Fatal("layer allocator substituted a successfully retained endpoint")
		}
		if err := errors.Join(listener.Close(), packet.Close()); err != nil {
			t.Fatal(err)
		}
		retired(t, []string{address})
	})
	for _, kind := range []string{"collision-bound", "access-denied-bound", "fatal-error", "foreign-pair"} {
		t.Run(kind, func(t *testing.T) {
			var addresses []string
			var tcpAddresses []string
			fatal := errors.New("intentional non-allocation failure")
			listener, packet, err := desktopNodeLayerPortPair(ip, func(network, address string) (net.Listener, error) {
				addresses = append(addresses, address)
				switch kind {
				case "collision-bound":
					blocker, err := net.Listen(network, address)
					if err != nil {
						return nil, err
					}
					defer blocker.Close()
					return net.Listen(network, address)
				case "access-denied-bound":
					return nil, &net.OpError{Op: "listen", Net: network, Err: os.NewSyscallError("bind", syscall.Errno(10013))}
				case "foreign-pair":
					foreign, err := net.Listen(network, net.JoinHostPort(ip.String(), "0"))
					if err == nil && foreign.Addr().String() == address {
						// Keep the first TCP candidate held so port zero cannot
						// accidentally pick the intended UDP endpoint twice.
						other, nextErr := net.Listen(network, net.JoinHostPort(ip.String(), "0"))
						err = errors.Join(nextErr, foreign.Close())
						foreign = other
					}
					if foreign != nil {
						tcpAddresses = append(tcpAddresses, foreign.Addr().String())
					}
					return foreign, err
				default:
					return nil, fatal
				}
			})
			if listener != nil {
				t.Cleanup(func() { _ = listener.Close() })
			}
			if packet != nil {
				t.Cleanup(func() { _ = packet.Close() })
			}
			count := 1
			if kind == "collision-bound" || kind == "access-denied-bound" && runtime.GOOS == "windows" {
				count = 3
			}
			if err == nil || listener != nil || packet != nil || len(addresses) != count {
				var nativeErrno syscall.Errno
				_ = errors.As(err, &nativeErrno)
				t.Fatal("layer allocation failure escaped its bounded original ownership", kind, len(addresses), err, "native_errno", uint64(nativeErrno))
			}
			if kind == "collision-bound" && !desktopNodeLayerAddressInUse(err) || kind == "access-denied-bound" && !errors.Is(err, syscall.Errno(10013)) || kind == "fatal-error" && !errors.Is(err, fatal) {
				t.Fatal("layer allocator discarded its actual bind or constructor cause", err)
			}
			retired(t, addresses)
			for _, address := range tcpAddresses {
				other, err := net.Listen("tcp4", address)
				if err != nil {
					t.Fatal("layer allocator retained its rejected TCP owner", err)
				}
				if err := other.Close(); err != nil {
					t.Fatal(err)
				}
			}
		})
	}
}

func desktopNodeLayerTraffic(t *testing.T, mode, layer string) {
	t.Helper()
	_, ip := desktopNodePeerInterface(t)
	peer := startDesktopNodeLayerReference(t, mode, layer, ip)
	f := newDesktopNodeLayerFixture(t, peer, "")
	if err := f.box.RouterVPNStrategyStart(); err != nil {
		t.Fatal("actual layered native startup failed", err)
	}
	for _, network := range []string{"tcp", "udp"} {
		for _, host := range []string{"192.0.2.99", "2001:db8::99"} {
			firstXray := desktopNodeXrayMode(mode) && network == "tcp" && host == "192.0.2.99"
			started := time.Now()
			var err error
			if firstXray {
				// The pinned REALITY server may wait five seconds for its cold
				// camouflage detector. Match the native WFP first-transfer bound.
				err = f.exchangeWithin(10*time.Second, 8*time.Second, network, host)
			} else {
				err = f.exchange(network, host)
			}
			if err != nil {
				observed := peer.observe(t, "stats")
				t.Fatal("layered encrypted payload escaped or lost its exact native lower", network, host, err,
					"elapsed", time.Since(started), "socket_current", f.network.SocketCurrent(), "application_current", f.network.Current(),
					"outer_tcp", observed.RawTCP, "protocol_tcp", observed.ProtocolRawTCP, "echo", observed.ProtocolTCP)
			}
			if firstXray {
				t.Log("first authenticated Xray transfer", "elapsed", time.Since(started))
			}
		}
	}
	f.kernel.mu.Lock()
	requests := f.kernel.requests
	f.kernel.mu.Unlock()
	if requests == 0 {
		t.Fatal("layered graph bypassed its captured socket grants")
	}
	observed := peer.observe(t, "stats")
	tcpOuter := desktopNodeXrayMode(mode) || mode == "naive-h2"
	if tcpOuter && (observed.RawTCP == 0 || observed.PlainTCP == 0 || observed.ProtocolRawTCP == 0 || observed.ProtocolTCP == 0 || observed.ProtocolUDP == 0) ||
		!tcpOuter && (observed.RawUDP == 0 || observed.PlainUDP == 0 || mode == "shadowsocks" && (observed.RawTCP == 0 || observed.PlainTCP == 0)) || f.network.Current() {
		t.Fatal("layered payload omitted real ciphertext or fabricated readiness", observed)
	}
	if mode == "hysteria2" && (observed.ProtocolRawUDP == 0 || observed.ProtocolTCP == 0 || observed.ProtocolUDP == 0) {
		t.Fatal("captured Hysteria payload bypassed its authenticated protocol", observed)
	}
	if mode == "naive-h3" && (observed.ProtocolRawUDP == 0 || observed.ProtocolRawTCP != 0 || observed.ProtocolTCP == 0 || observed.ProtocolUDP == 0) {
		t.Fatal("captured Naive H3 payload downgraded or bypassed its authenticated QUIC stream protocol", observed)
	}
	if err := f.box.RouterVPNStrategyDNSProof(); err != nil || peer.observe(t, "stats").DNSQueries != 1 {
		t.Fatal("selected Home DNS did not traverse the actual layered graph", err)
	}
	peer.observe(t, "fail-dns")
	if err := f.box.RouterVPNStrategyDNSProof(); err == nil || peer.observe(t, "stats").DNSQueries != 2 {
		t.Fatal("layered selected DNS accepted a stale answer or skipped the captured resolver")
	}
	f.network.InterfaceUpdated(context.Background())
	if f.network.SocketCurrent() || f.kernel.live.Load() || f.exchange("udp") == nil {
		t.Fatal("retired layered node delivered another encrypted payload")
	}
	if err := f.close(); err != nil || !f.source.closed.Load() {
		t.Fatal("layered native graph did not join its retained owner", err)
	}
}

func TestRouterVPNDesktopNodeEncryptedLayerWrongCredential(t *testing.T) {
	for _, mode := range []string{"shadowsocks", "wg"} {
		for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			t.Run(mode+"/"+layer, func(t *testing.T) {
				_, ip := desktopNodePeerInterface(t)
				peer := startDesktopNodeLayerReference(t, mode, layer, ip)
				f := newDesktopNodeLayerFixture(t, peer, "aes-key")
				if err := f.box.RouterVPNStrategyStart(); err != nil {
					t.Fatal("wrong-key layer must reach actual encrypted startup", err)
				}
				if err := f.exchange("udp"); err == nil {
					t.Fatal("wrong AES/whitening credential delivered an encrypted payload")
				}
				observed := peer.observe(t, "stats")
				if observed.RawUDP == 0 || observed.PlainUDP != 0 || f.network.Current() {
					t.Fatal("layer credential negative missed the actual encrypted peer", observed)
				}
			})
		}
	}
}

