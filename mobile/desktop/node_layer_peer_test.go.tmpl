		_, _ = io.WriteString(w, "ip=203.0.113.88\n")
	})}
	proofDone := make(chan error, 1)
	go func() {
		proofDone <- proofServer.Serve(tls.NewListener(proofListener, &tls.Config{Certificates: []tls.Certificate{cert}, MinVersion: tls.VersionTLS12}))
	}()
	t.Cleanup(func() { _ = proofServer.Close(); _ = proofListener.Close(); <-proofDone })
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	server := &desktopNodeLayerServer{ctx: ctx, cancel: cancel, connections: make(map[io.Closer]bool), routes: []desktopNodeLayerRoute{
		{Network: "tcp", Destination: "203.0.113.53:5353", Physical: dnsListener.Addr().String()},
		{Network: "tcp", Destination: "1.1.1.1:443", Physical: proofListener.Addr().String()},
	}}
	if benchmark != nil {
		server.routes = append(server.routes, desktopNodeLayerRoute{Network: "tcp", Destination: "203.0.113.54:443", Physical: benchmark.listener.Addr().String()})
	}
	var listener net.Listener
	address := ""
	closeTransport := func() {}
	var wgPeer desktopExternalInstalledWGPeer
	var entryPeer desktopExternalInstalledPacketEntryPeer
	var openvpnProfile string
	var openvpnPeer desktopExternalInstalledOpenVPNPeer
	var socksPeer *desktopExternalInstalledSOCKSPeer
	var layerPeer desktopExternalInstalledLayerPeer
	if request.Protocol == "wireguard" || request.Protocol == "amneziawg" {
		server.routes = append(server.routes, desktopNodeLayerRoute{Network: "udp", Destination: "203.0.113.53:5353", Physical: dnsPacket.LocalAddr().String()})
		if request.Protocol == "amneziawg" {
			if entryRequested {
				wgPeer = desktopExternalInstalledAmneziaFinal(t, server, *request.Amnezia)
			} else {
				wgPeer = desktopExternalInstalledAmnezia(t, server, *request.Amnezia)
			}
			if wgPeer.parameters == nil {
