		if request.AmneziaEntry != nil {
			entryKeys = &request.AmneziaEntry.desktopExternalInstalledWGRequest
		}
		finalKeys, available := request.WireGuard, desktopExternalInstalledWireGuardFinal != nil
		if request.Protocol == "amneziawg" {
