			reply.SOCKSRejectedReplies = socksPeer.rejected.Load()
		}
		if wgPeer.stats != nil {
			reply.PhysicalUDP, reply.Streams, reply.Packets = wgPeer.stats()
		}
		if wgPeer.parameters != nil {
			var err error
			reply.ParametersSHA256, err = wgPeer.parameters()
			if err != nil || len(reply.ParametersSHA256) != 64 {
				t.Fatal("installed external AWG reference changed its actual complete native parameters")
			}
		}
		if err := json.NewEncoder(os.Stdout).Encode(reply); err != nil {
			t.Fatal(err)
		}
	}
	respond()
	for {
		line, err := reader.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 64 {
			t.Fatal("installed external peer lost its original control pipe", err)
		}
		switch string(line) {
		case "stats\n":
		case "hold-latency\n", "release-latency\n", "hold-mtu\n", "release-mtu\n":
			if benchmark == nil {
				t.Fatal("unselected latency responder")
			}
			if err := benchmark.control(string(line)); err != nil {
				t.Fatal(err)
			}
		case "fail-dns\n":
			failDNS.Store(true)
		case "release-proof\n":
			release.Do(func() { close(proofGate) })
		default:
			t.Fatal("installed external peer rejected an unrelated control")
		}
		respond()
	}
}

func desktopExternalIndependentPacketKeys(entry, final *desktopExternalInstalledWGRequest) bool {
	if entry == nil || final == nil {
		return false
	}
	seen := make(map[string]bool)
	for _, key := range []string{entry.PrivateKey, entry.ClientPublicKey, entry.PresharedKey, final.PrivateKey, final.ClientPublicKey, final.PresharedKey} {
		if key == "" || seen[key] {
			return false
		}
		seen[key] = true
	}
	return true
}
