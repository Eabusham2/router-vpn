type desktopNodeLayerRoute struct {
	Network, Destination, Physical string
}

type desktopNodeLayerServer struct {
	ctx                                        context.Context
	cancel                                     context.CancelFunc
	tcp                                        net.Listener
	udp                                        net.PacketConn
	routes                                     []desktopNodeLayerRoute
	dnsAddress                                 string
	routerAddress                              string
	cover                                      atomic.Pointer[desktopNodeRouterCover]
	mu                                         sync.Mutex
	closing                                    bool
	connections                                map[io.Closer]bool
	workers                                    sync.WaitGroup
	rawTCP, rawUDP                             atomic.Int64
	plainTCP, plainUDP                         atomic.Int64
	rejectedUDP                                atomic.Int64
	tlsRequests, websocketUpgrades, muxStreams atomic.Int64
	observation                                desktopNodePeerObservation
}

func (s *desktopNodeLayerServer) enter(c io.Closer) bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.closing {
		return false
	}
	s.connections[c] = true
	s.workers.Add(1)
	return true
}

func (s *desktopNodeLayerServer) leave(c io.Closer) {
	_ = c.Close()
	s.mu.Lock()
	delete(s.connections, c)
	s.mu.Unlock()
	s.workers.Done()
}

func desktopNodeLayerEcho(destination M.Socksaddr) bool {
	return destination.Port == 9999 && (destination.Addr == netip.MustParseAddr("192.0.2.99") || destination.Addr == netip.MustParseAddr("2001:db8::99"))
}

func (s *desktopNodeLayerServer) route(network, destination string) (string, bool) {
	for _, route := range s.routes {
		if route.Network == network && route.Destination == destination {
			return route.Physical, true
		}
	}
	return "", false
}

func (s *desktopNodeLayerServer) NewConnection(_ context.Context, connection net.Conn, metadata M.Metadata) error {
	var target string
	if s.routerAddress != "" && metadata.Destination.String() == desktopNodeRouterHealthTarget {
		target = s.routerAddress
	} else if len(s.routes) != 0 {
		var found bool
		target, found = s.route("tcp", metadata.Destination.String())
		if !found {
			return errors.New("layer peer rejected an unowned inner stream")
		}
	}
	if target != "" {
		peer, err := (&net.Dialer{}).DialContext(s.ctx, "tcp", target)
		if err != nil {
			return err
		}
		if !s.enter(peer) {
			_ = peer.Close()
			return net.ErrClosed
		}
		defer s.leave(peer)
		s.plainTCP.Add(1)
		joined := make(chan struct{})
		go func() {
			defer close(joined)
			_, _ = io.Copy(peer, connection)
			_ = peer.Close()
			_ = connection.Close()
		}()
		_, err = io.Copy(connection, peer)
		_ = peer.Close()
		_ = connection.Close()
		<-joined
		return err
	}
	if !desktopNodeLayerEcho(metadata.Destination) {
		return errors.New("layer peer rejected an unowned TCP destination")
	}
	s.plainTCP.Add(1)
	_, err := io.Copy(connection, connection)
	return err
}

func (*desktopNodeLayerServer) NewError(context.Context, error) {}

func (s *desktopNodeLayerServer) NewPacketConnection(_ context.Context, connection N.PacketConn, metadata M.Metadata) error {
	if !s.enter(connection) {
		return net.ErrClosed
	}
	defer s.leave(connection)
	stop := context.AfterFunc(s.ctx, func() { _ = connection.Close() })
	defer stop()
	if cover := s.cover.Load(); cover != nil && metadata.Destination.String() == desktopNodeRouterCoverTarget {
		return cover.exchange(connection, metadata.Destination)
	}
	var target string
	if len(s.routes) != 0 {
		var found bool
		target, found = s.route("udp", metadata.Destination.String())
		if !found {
			s.rejectedUDP.Add(1)
			return errors.New("layer peer rejected an unowned inner tunnel")
		}
	} else if metadata.Destination.String() == "192.168.50.133:53" {
		target = s.dnsAddress
	} else if !desktopNodeLayerEcho(metadata.Destination) {
		return errors.New("layer peer rejected an unowned UDP destination")
	}
	if target == "" {
		for {
			packet := buf.NewPacket()
			destination, err := connection.ReadPacket(packet)
			if err == nil && destination != metadata.Destination {
				err = errors.New("layer peer UDP changed its captured echo destination")
			}
			if err == nil {
				s.plainUDP.Add(1)
				reply := buf.NewSize(65535 + 2048)
				reply.Resize(2048, 0)
				_, _ = reply.Write(packet.Bytes())
				err = connection.WritePacket(reply, destination)
			}
			packet.Release()
			if err != nil {
				return err
			}
		}
	}
	peer, err := (&net.Dialer{}).DialContext(s.ctx, "udp", target)
	if err != nil {
		return err
	}
	defer peer.Close()
	stopPeer := context.AfterFunc(s.ctx, func() { _ = peer.Close() })
	defer stopPeer()
	joined := make(chan struct{})
	go func() {
		defer close(joined)
		defer peer.Close()
		for {
			packet := buf.NewPacket()
			destination, err := connection.ReadPacket(packet)
			if err == nil && destination != metadata.Destination {
				err = errors.New("layer peer UDP changed its captured forwarding destination")
			}
			if err == nil {
				s.plainUDP.Add(1)
				_, err = peer.Write(packet.Bytes())
			}
			packet.Release()
			if err != nil {
				return
			}
		}
	}()
	defer func() { _ = connection.Close(); _ = peer.Close(); <-joined }()
	for {
		packet := buf.NewSize(65535 + 2048)
		packet.Resize(2048, 0)
		n, err := peer.Read(packet.FreeBytes())
		packet.Truncate(n)
		if err == nil {
			err = connection.WritePacket(packet, metadata.Destination)
		} else {
			packet.Release()
		}
		if err != nil {
			return err
		}
	}
}

func startDesktopNodeLayerServer(t *testing.T, ip netip.Addr, password, inner, innerPhysical, innerNetwork, dnsAddress string, routerAddresses ...string) *desktopNodeLayerServer {
	t.Helper()
	var routes []desktopNodeLayerRoute
	if inner != "" {
		routes = []desktopNodeLayerRoute{{innerNetwork, inner, innerPhysical}}
	}
	return startDesktopNodeLayerRoutedServer(t, ip, password, routes, dnsAddress, routerAddresses...)
}

func desktopNodeLayerAddressInUse(err error) bool {
	if runtime.GOOS == "windows" {
		// Winsock returns WSAEADDRINUSE. Go's Windows EADDRINUSE is a
		// different, synthetic POSIX value and does not match a native bind.
		return errors.Is(err, syscall.Errno(10048))
	}
	return errors.Is(err, syscall.EADDRINUSE)
}

func desktopNodeLayerPortPair(ip netip.Addr, listenTCP func(string, string) (net.Listener, error)) (net.Listener, net.PacketConn, error) {
	candidates, err := desktopNodeLayerPortCandidates(runtime.GOOS == "windows", rand.Reader)
	if err != nil {
		return nil, nil, err
	}
	return desktopNodeLayerPortPairCandidates(ip, candidates, net.ListenPacket, listenTCP)
}

func desktopNodeLayerPortCandidates(windows bool, entropy io.Reader) ([3]uint16, error) {
	var result [3]uint16
	if !windows {
		return result, nil // Preserve the ordinary native port-zero allocator.
	}
	var seed [4]byte
	if entropy == nil {
		return result, errors.New("layer pair has no candidate entropy")
	}
	if _, err := io.ReadFull(entropy, seed[:]); err != nil {
		return result, fmt.Errorf("layer pair candidate entropy: %w", err)
	}
	// Port zero selects from independent TCP and UDP dynamic ranges. A run
	// of UDP-selected ports can all be forbidden to TCP. Diversify three
	// candidates outside the default Windows dynamic range; only retained
	// successful binds prove availability. No host reservation is changed.
	start := uint32(seed[0])<<8 | uint32(seed[1])
	stride := (uint32(seed[2])<<8 | uint32(seed[3])) | 1
	for i := range result {
		// An odd stride in this power-of-two ring makes the three distinct.
		result[i] = uint16(16384 + ((start + uint32(i)*stride) & 32767))
	}
	return result, nil
}

func desktopNodeLayerAllocationError(err error) bool {
	return desktopNodeLayerAddressInUse(err) || runtime.GOOS == "windows" && errors.Is(err, syscall.Errno(10013))
}

func desktopNodeLayerPortPairCandidates(ip netip.Addr, candidates [3]uint16, listenUDP func(string, string) (net.PacketConn, error), listenTCP func(string, string) (net.Listener, error)) (net.Listener, net.PacketConn, error) {
	if !ip.Is4() || listenUDP == nil || listenTCP == nil {
		return nil, nil, errors.New("layer pair requires its captured IPv4 listener constructors")
	}
	if candidates != [3]uint16{} {
		seen := make(map[uint16]bool)
		for _, port := range candidates {
			if port < 16384 || port >= 49152 || seen[port] {
				return nil, nil, errors.New("layer pair changed its three distinct candidate ports")
			}
			seen[port] = true
		}
	}
	var last error
	for attempt := 0; attempt < 3; attempt++ {
		requested := netip.AddrPortFrom(ip, candidates[attempt])
		packet, err := listenUDP("udp4", requested.String())
		if err != nil {
			if packet != nil {
				if closeErr := packet.Close(); closeErr != nil {
					return nil, nil, errors.Join(err, closeErr)
				}
			}
			last = fmt.Errorf("UDP listener: %w", err)
			if desktopNodeLayerAllocationError(err) {
				continue
			}
			return nil, nil, last
		}
		var actual netip.AddrPort
		if packet != nil && packet.LocalAddr() != nil {
			actual, err = netip.ParseAddrPort(packet.LocalAddr().String())
		}
		if packet == nil || err != nil || actual.Addr() != ip || actual.Port() == 0 || requested.Port() != 0 && actual.Port() != requested.Port() {
			var closeErr error
			if packet != nil {
				closeErr = packet.Close()
			}
			return nil, nil, errors.Join(errors.New("layer UDP listener replaced its captured candidate endpoint"), err, closeErr)
		}
		// Keep the original UDP owner throughout the matching TCP bind.
		listener, err := listenTCP("tcp4", actual.String())
		if err == nil && listener != nil && listener.Addr() != nil && listener.Addr().String() == actual.String() {
			return listener, packet, nil
		}
		if err == nil {
			err = errors.New("paired TCP listener replaced its retained UDP endpoint")
		}
		var closeErr error
		if listener != nil {
			closeErr = listener.Close()
		}
		closeErr = errors.Join(closeErr, packet.Close())
		if closeErr != nil {
			return nil, nil, errors.Join(err, closeErr)
		}
		last = fmt.Errorf("paired TCP listener: %w", err)
		if !desktopNodeLayerAllocationError(err) {
			return nil, nil, last
		}
	}
	return nil, nil, fmt.Errorf("layer pair exhausted three retained candidates: %w", last)
}

func startDesktopNodeLayerRoutedServer(t *testing.T, ip netip.Addr, password string, routes []desktopNodeLayerRoute, dnsAddress string, routerAddresses ...string) *desktopNodeLayerServer {
	t.Helper()
	var routerAddress string
	if len(routerAddresses) == 1 {
		routerAddress = routerAddresses[0]
	} else if len(routerAddresses) != 0 {
		t.Fatal("layer peer exceeded its captured Router HTTP mapping")
	}
	if routerAddress != "" {
		physical, err := netip.ParseAddrPort(routerAddress)
		if err != nil || physical.Addr() != ip || !ip.Is4() || !ip.IsPrivate() || physical.Port() != desktopNodeRouterHealthPort || len(routes) != 0 || dnsAddress == "" {
			t.Fatal("layer peer has an unrelated Router HTTP mapping")
		}
	}
	if len(routes) > 2 {
		t.Fatal("layer peer exceeded its captured inner route count")
	}
	seen := make(map[string]bool)
	for _, route := range routes {
		inner, err := netip.ParseAddrPort(route.Destination)
		physical, physicalErr := netip.ParseAddrPort(route.Physical)
		key := route.Network + "/" + route.Destination
		if route.Network != "tcp" && route.Network != "udp" || err != nil || physicalErr != nil || !inner.Addr().Is4() || inner.Port() == 0 || physical.Addr() != ip || physical.Port() != inner.Port() || seen[key] {
			t.Fatal("layer peer has an unowned or duplicate inner route")
		}
		seen[key] = true
	}
	listener, packet, err := desktopNodeLayerPortPair(ip, net.Listen)
	if err != nil {
		desktopNodeLayerPreparationError(t, "retained TCP/UDP listener pair", err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	s := &desktopNodeLayerServer{ctx: ctx, cancel: cancel, tcp: listener, udp: packet, routes: append([]desktopNodeLayerRoute(nil), routes...),
		dnsAddress: dnsAddress, routerAddress: routerAddress, connections: make(map[io.Closer]bool)}
	service, err := shadowaead_2022.NewServiceWithPassword(mobilemultihop.NativeStartLayerMethod, password, 10, s, nil)
	if err != nil {
		cancel()
		_ = listener.Close()
		_ = packet.Close()
		desktopNodeLayerPreparationError(t, "authenticated Start Layer service", err)
	}
	s.workers.Add(2)
	go func() {
		defer s.workers.Done()
		for {
			connection, err := listener.Accept()
			if err != nil {
				return
			}
			if !s.enter(connection) {
				_ = connection.Close()
				return
			}
			go func() {
				defer s.leave(connection)
				_ = connection.SetDeadline(time.Now().Add(30 * time.Second))
				reader := STD.NewReader(connection)
				if marker, err := desktopNodeXrayMarker(&s.observation, reader, connection); marker || err != nil {
					return
				}
				s.rawTCP.Add(1)
				_ = service.NewConnection(ctx, &desktopNodeLayerBufferedConn{Conn: connection, reader: reader}, M.Metadata{Source: M.SocksaddrFromNet(connection.RemoteAddr())})
			}()
		}
	}()
	go func() {
		defer s.workers.Done()
		reader := bufio.NewPacketConn(packet)
		for {
			body := buf.NewPacket()
			source, err := reader.ReadPacket(body)
			if err != nil {
				body.Release()
				return
			}
			if handled, _ := s.observation.receive(packet.(*net.UDPConn), body.Bytes(), source.AddrPort()); handled {
				body.Release()
				continue
			}
			s.rawUDP.Add(1)
			if service.NewPacket(ctx, reader, body, M.Metadata{Source: source}) != nil {
				body.Release()
			}
		}
	}()
	t.Cleanup(func() {
		s.mu.Lock()
		s.closing = true
		connections := make([]io.Closer, 0, len(s.connections))
		for connection := range s.connections {
			connections = append(connections, connection)
		}
		s.mu.Unlock()
		cancel()
		_ = listener.Close()
		_ = packet.Close()
		for _, connection := range connections {
			_ = connection.Close()
		}
		s.workers.Wait()
	})
	return s
}

func startDesktopNodeLayerRelay(t *testing.T, ip netip.Addr, target, password string) string {
	t.Helper()
	binary := os.Getenv("ROUTER_VPN_WHITENING_TEST_BINARY")
	if binary == "" || !filepath.IsAbs(binary) {
		t.Fatal("the exact built shipping whitening relay is required")
	}
	path := filepath.Join(t.TempDir(), "captured-aes.json")
	raw, _ := json.Marshal(map[string]any{"outbounds": []any{map[string]any{"type": "shadowsocks", "method": mobilemultihop.NativeStartLayerMethod, "password": password}}})
	if err := os.WriteFile(path, raw, 0600); err != nil {
		t.Fatal(err)
	}
	address := net.JoinHostPort(ip.String(), "8389") // The compiler's explicit whitening port contract.
	ctx, cancel := context.WithCancel(context.Background())
	command := exec.CommandContext(ctx, binary, "--mode", "server", "--listen", address, "--target", target, "--key-config", path)
	var diagnostic bytes.Buffer
	command.Stdout, command.Stderr = &diagnostic, &diagnostic
	if err := command.Start(); err != nil {
		cancel()
		t.Fatal(err)
	}
	joined := make(chan error, 1)
	go func() { joined <- command.Wait() }()
	t.Cleanup(func() { cancel(); <-joined })
	for deadline := time.Now().Add(3 * time.Second); time.Now().Before(deadline); {
		connection, err := net.DialTimeout("tcp4", address, 50*time.Millisecond)
		if err == nil {
			_ = connection.Close()
			return address
		}
		select {
		case err := <-joined:
			joined <- err
			t.Fatal("shipping whitening reference exited before readiness", err, diagnostic.String())
		default:
		}
		time.Sleep(10 * time.Millisecond)
	}
	t.Fatal("shipping whitening reference did not bind its captured port")
	return ""
}

func TestRouterVPNDesktopNodeLayerReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NODE_LAYER_REFERENCE_CHILD") == "" {
		return
	}
	if os.Getenv("ROUTERVPN_NODE_LAYER_REFERENCE_CHILD") != "1" {
		t.Fatal("unknown layer reference owner")
	}
	stage := "captured request"
	t.Cleanup(func() {
		if t.Failed() {
			fmt.Fprintf(os.Stderr, "retained layer reference failed during %s\n", stage)
		}
	})
	reader := STD.NewReaderSize(os.Stdin, desktopNodeLayerReferenceLimit+1)
	line, err := reader.ReadSlice('\n')
	if err != nil || len(line) > desktopNodeLayerReferenceLimit {
		t.Fatal("layer reference request is not bounded", err)
	}
	var request desktopNodeLayerRequest
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	var trailing any
	if decoder.Decode(&request) != nil || decoder.Decode(&trailing) != io.EOF || request.Schema != 1 ||
		!mobilemultihop.DesktopNodePhysicalGraphSupported(request.Mode, request.Layer) ||
		request.Mode != "shadowsocks" && request.Mode != "hysteria2" && !desktopNodeXrayMode(request.Mode) && !desktopNodeNaiveMode(request.Mode) && !desktopNodeCompositeMode(request.Mode) && request.Layer == "" || len(request.Configuration.Forward) != 0 || !desktopNodeRouterHealthCaptureValid(request) || !desktopNodeHysteria2CaptureValid(request) {
		t.Fatal("layer reference request escaped its captured fixture")
	}
	key, keyErr := base64.StdEncoding.Strict().DecodeString(request.Password)
	if keyErr != nil || len(key) != 32 {
		t.Fatal("layer reference has no exact AES credential")
	}
	clear(key)
	stage = "private interface"
	ip, err := netip.ParseAddr(request.Address)
	if err != nil || !ip.Is4() || !ip.IsPrivate() {
		t.Fatal("layer reference requires its actual private interface")
	}
	interfaces, err := net.Interfaces()
	found := false
	for _, iface := range interfaces {
		addresses, _ := iface.Addrs()
		for _, address := range addresses {
			prefix, parseErr := netip.ParsePrefix(address.String())
			found = found || parseErr == nil && prefix.Addr() == ip && iface.Flags&net.FlagUp != 0 && iface.Flags&net.FlagLoopback == 0
		}
	}
	if err != nil || !found {
		t.Fatal("layer reference selected an unrelated interface", err)
	}
	var failedDNS atomic.Bool
	var dnsQueries atomic.Uint32
	stage = "selected DNS listener"
	dnsListener, err := net.ListenPacket("udp4", "127.0.0.1:0")
	if err != nil {
		desktopNodeLayerPreparationError(t, stage, err)
	}
	dnsServer := &dns.Server{PacketConn: dnsListener, Handler: dns.HandlerFunc(func(writer dns.ResponseWriter, query *dns.Msg) {
		dnsQueries.Add(1)
		answer := new(dns.Msg).SetReply(query)
		if len(query.Question) != 1 || query.Question[0].Name != "example.com." || query.Question[0].Qtype != dns.TypeA {
			answer.Rcode = dns.RcodeRefused
		} else if failedDNS.Load() {
			answer.Rcode = dns.RcodeNameError
		} else {
			answer.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: "example.com.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 300}, A: net.ParseIP("93.184.216.34")}}
		}
		_ = writer.WriteMsg(answer)
	})}
	dnsJoined := make(chan error, 1)
	go func() { dnsJoined <- dnsServer.ActivateAndServe() }()
	t.Cleanup(func() { _ = dnsServer.Shutdown(); _ = dnsListener.Close(); <-dnsJoined })
	stage = "captured Router HTTP listener"
	routerHealth := startDesktopNodeRouterHealth(t, ip, request.NodeProofID)
	var directHealth *desktopNodeRouterHealth
	if request.DirectRouter {
		// The assembled host gate assigns this address only inside the peer's
		// private namespace. A same-identity direct response cannot increment
		// the independent encrypted Router mapping's counter.
		directHealth = startDesktopNodeRouterHealth(t, netip.MustParseAddr("10.77.0.1"), request.NodeProofID)
	}
	var inner, baseAddress, protocolFiles string
	innerNetwork, probeNetwork := "udp", "udp"
	var protocolServer *desktopNodeLayerServer
	var udpBranch *desktopNodeLayerServer
	var routes []desktopNodeLayerRoute
	stage = "authenticated protocol peers"
	if desktopNodeCompositeMode(request.Mode) {
		var routerAddresses []string
		innerAddress := netip.MustParseAddr("10.78.0.1")
		if request.NodeProofID != "" {
			// Only the final SIP003 TCP lane owns HTTP proof. The separate
			// HY2 lane owns selected DNS and cover; the outer owns neither.
			routerAddresses = []string{routerHealth.address()}
			innerAddress = netip.MustParseAddr("10.77.0.1")
		}
		protocolServer, udpBranch, protocolFiles = startDesktopNodeCompositeServer(t, request.Mode, ip, dnsListener.LocalAddr().String(), routerAddresses...)
		baseAddress = protocolServer.tcp.Addr().String()
		probeNetwork = "tcp"
		for _, route := range []desktopNodeLayerRoute{{Network: "tcp", Physical: baseAddress}, {Network: "udp", Physical: udpBranch.udp.LocalAddr().String()}} {
			physical := netip.MustParseAddrPort(route.Physical)
			route.Destination = netip.AddrPortFrom(innerAddress, physical.Port()).String()
			routes = append(routes, route)
		}
	} else if desktopNodeNaiveMode(request.Mode) {
		protocolServer, protocolFiles = startDesktopNodeNaiveServer(t, request.Mode, ip, dnsListener.LocalAddr().String())
		if request.Mode == "naive-h2" {
			baseAddress = protocolServer.tcp.Addr().String()
			innerNetwork, probeNetwork = "tcp", "tcp"
		} else {
			baseAddress = protocolServer.udp.LocalAddr().String()
		}
		base := netip.MustParseAddrPort(baseAddress)
		inner = netip.AddrPortFrom(netip.MustParseAddr("127.0.0.1"), base.Port()).String()
	} else if desktopNodeXrayMode(request.Mode) {
		protocolServer, protocolFiles = startDesktopNodeXrayServer(t, request.Mode, ip, dnsListener.LocalAddr().String())
		baseAddress = protocolServer.tcp.Addr().String()
		base := netip.MustParseAddrPort(baseAddress)
		inner = netip.AddrPortFrom(netip.MustParseAddr("10.78.0.1"), base.Port()).String()
		innerNetwork, probeNetwork = "tcp", "tcp"
	} else if request.Mode == "hysteria2" {
		// The private Router mapping is fixed before the actual QUIC service
		// starts. It grants no other TCP destination or DNS/physical exception.
		protocolServer, protocolFiles = startDesktopNodeHysteria2ServerWithIdentity(t, ip, dnsListener.LocalAddr().String(), request.HysteriaTLSIdentity, routerHealth.address())
		baseAddress = protocolServer.udp.LocalAddr().String()
		base := netip.MustParseAddrPort(baseAddress)
		inner = netip.AddrPortFrom(netip.MustParseAddr("127.0.0.1"), base.Port()).String()
	} else if request.Mode != "shadowsocks" {
		request.Configuration.Forward = []desktopReferenceRule{{Network: "udp", Address: "192.168.50.133", Port: 53, Target: dnsListener.LocalAddr().String()}}
		peer, err := startDesktopNodePeer(request.Configuration, request.Mode, ip)
		if err != nil {
			t.Fatal("actual layered encrypted base peer did not start", err)
		}
		t.Cleanup(peer.close)
		baseAddress = peer.bind.address()
		base := netip.MustParseAddrPort(baseAddress)
		inner = netip.AddrPortFrom(netip.MustParseAddr("10.78.0.1"), base.Port()).String()
	}
	server := protocolServer
	address, aesAddress := baseAddress, ""
	stage = "authenticated Start Layer"
	if request.Mode != "hysteria2" && !desktopNodeXrayMode(request.Mode) && !desktopNodeNaiveMode(request.Mode) && !desktopNodeCompositeMode(request.Mode) || request.Layer != "" {
		if len(routes) != 0 {
			server = startDesktopNodeLayerRoutedServer(t, ip, request.Password, routes, dnsListener.LocalAddr().String())
		} else {
			routerAddress := ""
			if inner == "" {
				routerAddress = routerHealth.address()
			}
			// A layered peer may forward only its captured inner transport.
			// Node proof, DNS, payload and cover terminate at the inner peer.
			server = startDesktopNodeLayerServer(t, ip, request.Password, inner, baseAddress, innerNetwork, dnsListener.LocalAddr().String(), routerAddress)
		}
		address = server.tcp.Addr().String()
		aesAddress = address
	}
	if request.Layer == "aes-256-gcm+xor-whitening" {
		stage = "shipping whitening relay"
		password := request.Password
		if request.WhiteningMismatch {
			key, err := base64.StdEncoding.Strict().DecodeString(password)
			if err != nil || len(key) != 32 {
				t.Fatal("whitening negative lost its captured key")
			}
			key[0] ^= 0xff
			password = base64.StdEncoding.EncodeToString(key)
			clear(key)
		}
		address = startDesktopNodeLayerRelay(t, ip, address, password)
	}
	coverServer := server
	if request.Mode == "hysteria2" {
		coverServer = protocolServer
	} else if request.Mode == "ss-v2ray" {
		coverServer = udpBranch
	}
	if request.Cover {
		coverServer.cover.Store(&desktopNodeRouterCover{})
	}
	stage = "native process scope"
	scope, err := desktopNodeLayerReferenceScope()
	if err != nil {
		desktopNodeLayerPreparationError(t, stage, err)
	}
	respond := func(nonce, target string, observer *desktopNodeLayerServer) {
		var count int64
		if nonce != "" {
			var err error
			count, err = observer.observation.count(nonce)
			if err != nil {
				t.Fatal(err)
			}
		}
		reply := desktopNodeLayerReply{Schema: 1, Address: address, AESAddress: aesAddress, BaseAddress: baseAddress, ProtocolFiles: protocolFiles,
			AppID: scope, RawTCP: server.rawTCP.Load(), RawUDP: server.rawUDP.Load(), PlainTCP: server.plainTCP.Load(), PlainUDP: server.plainUDP.Load(), DNSQueries: dnsQueries.Load(), Probe: nonce, ProbeCount: count, ProbeNetwork: probeNetwork, ProbeTarget: target}
		reply.RejectedUDP = server.rejectedUDP.Load()
		reply.RouterQueries = routerHealth.count()
		reply.DirectQueries = directHealth.count()
		if cover := coverServer.cover.Load(); cover != nil {
			cover.observe(&reply)
		}
		if protocolServer != nil {
			reply.ProtocolRawUDP, reply.ProtocolTCP, reply.ProtocolUDP = protocolServer.rawUDP.Load(), protocolServer.plainTCP.Load(), protocolServer.plainUDP.Load()
			reply.ProtocolRawTCP = protocolServer.rawTCP.Load()
			reply.ProtocolTLSHTTP, reply.ProtocolWebSocket, reply.ProtocolMux = protocolServer.tlsRequests.Load(), protocolServer.websocketUpgrades.Load(), protocolServer.muxStreams.Load()
		}
		if udpBranch != nil {
			reply.UDPBranchAddress, reply.UDPBranchRawUDP = udpBranch.udp.LocalAddr().String(), udpBranch.rawUDP.Load()
			reply.UDPBranchTCP, reply.UDPBranchUDP = udpBranch.plainTCP.Load(), udpBranch.plainUDP.Load()
		}
		err := json.NewEncoder(os.Stdout).Encode(reply)
		if err != nil {
			t.Fatal("layer reference lost its retained reply pipe", err)
		}
	}
	stage = "captured reply and control"
	respond("", "", server)
	for {
		line, err := reader.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 64 {
			t.Fatal("layer reference received another control operation", err)
		}
		if string(line) == "stats\n" || string(line) == "fail-dns\n" || string(line) == "restore-dns\n" {
			if string(line) == "fail-dns\n" {
				failedDNS.Store(true)
			} else if string(line) == "restore-dns\n" {
				failedDNS.Store(false)
			}
			respond("", "", server)
			continue
		}
		if string(line) == "wrong-node\n" || string(line) == "restore-node\n" {
			if routerHealth == nil {
				t.Fatal("layer reference received an uncaptured Router identity operation")
			}
			routerHealth.wrongNode.Store(string(line) == "wrong-node\n")
			respond("", "", server)
			continue
		}
		if string(line) == "drop-cover\n" {
			cover := coverServer.cover.Load()
			if cover == nil {
				t.Fatal("layer reference received an uncaptured private cover operation")
			}
			cover.stopReplies()
			respond("", "", server)
			continue
		}
		action, nonce, found := strings.Cut(strings.TrimSuffix(string(line), "\n"), " ")
		target := ""
		observer, probeAddress, network := server, address, probeNetwork
		if prefix, suffix, selected := strings.Cut(action, "-"); selected {
			if !desktopNodeCompositeMode(request.Mode) || suffix != "tcp" && suffix != "udp" {
				t.Fatal("layer reference received an uncaptured branch observation")
			}
			action, target, network = prefix, suffix, suffix
			if request.Layer == "" && suffix == "udp" {
				observer, probeAddress = udpBranch, udpBranch.udp.LocalAddr().String()
			}
		}
		if !found || len(nonce) != 32 || action != "arm" && action != "observe" && action != "positive" {
			t.Fatal("layer reference received an unrelated observation")
		}
		if action != "observe" {
			if err := observer.observation.arm(nonce); err != nil {
				t.Fatal(err)
			}
		}
		if action == "positive" {
			if ok, err := desktopNodeLayerProbeExchange(netip.MustParseAddrPort(probeAddress), nonce, network, request.Layer, request.Password); err != nil || !ok {
				t.Fatal("actual independent layer observer could not reach its socket", err)
			}
		}
		respond(nonce, target, observer)
	}
}

type desktopNodeLayerReference struct {
	command    *exec.Cmd
	input      io.WriteCloser
	output     *os.File
	reader     *STD.Reader
	done       chan error
	cancel     context.CancelFunc
	ctx        context.Context
	diagnostic bytes.Buffer
	request    desktopNodeLayerRequest
	options    Options
	remote     netip.AddrPort
	reply      desktopNodeLayerReply
}

func (p *desktopNodeLayerReference) read() (desktopNodeLayerReply, error) {
	type result struct {
		reply desktopNodeLayerReply
		err   error
	}
	joined := make(chan result, 1)
	go func() {
		var reply desktopNodeLayerReply
		raw, err := p.reader.ReadSlice('\n')
		if err == nil && len(raw) > desktopNodeLayerReferenceLimit {
			err = errors.New("layer peer reply exceeded its captured read")
		}
		if err == nil {
			decoder := json.NewDecoder(bytes.NewReader(raw))
			decoder.DisallowUnknownFields()
			var trailing any
			if decoder.Decode(&reply) != nil || decoder.Decode(&trailing) != io.EOF || reply.Schema != 1 {
				err = errors.New("layer peer returned an invalid captured record")
			}
		}
		joined <- result{reply, err}
	}()
	ctx, cancel := context.WithTimeout(p.ctx, 10*time.Second)
	defer cancel()
	select {
	case value := <-joined:
		return value.reply, value.err
	case <-ctx.Done():
		p.cancel()
		_ = p.output.Close()
		<-joined
		return desktopNodeLayerReply{}, ctx.Err()
	}
}

func desktopNodeLayerProbeExchange(remote netip.AddrPort, nonce, network, layer, password string) (bool, error) {
	if network != "udp" && network != "tcp" {
		return false, errors.New("layer observer has no captured transport")
	}
	connection, err := net.DialTimeout(network+"4", remote.String(), 750*time.Millisecond)
	if err != nil {
		return false, err
	}
	defer connection.Close()
	if err := connection.SetDeadline(time.Now().Add(750 * time.Millisecond)); err != nil {
		return false, err
	}
	payload := []byte(desktopNodePeerProbePrefix + nonce)
	if layer == "aes-256-gcm+xor-whitening" {
		key, err := startwhitening.Key(mobilemultihop.NativeStartLayerMethod, password)
		if err != nil {
			return false, err
		}
		for i := range payload {
			payload[i] ^= key[i%len(key)]
		}
		clear(key[:])
	}
	if n, err := connection.Write(payload); err != nil || n != len(payload) {
		return false, errors.Join(err, io.ErrShortWrite)
	}
	answer := make([]byte, len(payload)+1)
	var n int
	if network == "tcp" {
		n, err = io.ReadFull(connection, answer[:len(payload)])
	} else {
		n, err = connection.Read(answer)
	}
	if err != nil {
		return false, err
	}
	if !bytes.Equal(answer[:n], payload) {
		return false, errors.New("actual layer observer returned another marker")
	}
	return true, nil
}

func (p *desktopNodeLayerReference) probe(t *testing.T, action, nonce string) int64 {
	t.Helper()
	if _, err := io.WriteString(p.input, action+" "+nonce+"\n"); err != nil {
		t.Fatal(err)
	}
	result, err := p.read()
	if err != nil || result.Address != p.reply.Address || result.ProbeNetwork != p.reply.ProbeNetwork || !bytes.Equal(result.AppID, p.reply.AppID) || result.Probe != nonce || result.ProbeCount < 0 {
		t.Fatal("layer observation changed its original process, socket or nonce", err)
	}
	return result.ProbeCount
}

func (p *desktopNodeLayerReference) observe(t *testing.T, action string) desktopNodeLayerReply {
	t.Helper()
	if action != "stats" && action != "fail-dns" && action != "restore-dns" && !(action == "drop-cover" && p.request.Cover) && (p.request.NodeProofID == "" || action != "wrong-node" && action != "restore-node") {
		t.Fatal("unexpected layer observation operation")
	}
	if _, err := io.WriteString(p.input, action+"\n"); err != nil {
		t.Fatal(err)
	}
	result, err := p.read()
	if err != nil || result.Address != p.reply.Address || result.AESAddress != p.reply.AESAddress || result.BaseAddress != p.reply.BaseAddress || result.UDPBranchAddress != p.reply.UDPBranchAddress || result.ProtocolFiles != p.reply.ProtocolFiles || result.ParametersSHA256 != p.reply.ParametersSHA256 || result.PhysicalClientAddress != p.reply.PhysicalClientAddress || result.RelaySourceAddress != p.reply.RelaySourceAddress || result.ProbeNetwork != p.reply.ProbeNetwork || !bytes.Equal(result.AppID, p.reply.AppID) {
		t.Fatal("layer peer observation changed its original owner", err)
	}
	return result
}

func startDesktopNodeLayerReference(t *testing.T, mode, layer string, ip netip.Addr, proofIDs ...string) *desktopNodeLayerReference {
	t.Helper()
	var proofID string
	if len(proofIDs) == 1 {
		proofID = proofIDs[0]
		if proofID == "" || !desktopNodeRouterHealthCaptureValid(desktopNodeLayerRequest{Mode: mode, Layer: layer, NodeProofID: proofID}) {
			t.Fatal("layer reference lost its optional exact Router identity")
		}
	} else if len(proofIDs) != 0 {
		t.Fatal("layer reference exceeded its captured Router identity")
	}
	return startDesktopNodeLayerReferenceConfigured(t, mode, layer, ip, desktopNodeLayerReferenceOptions{NodeProofID: proofID})
}

type desktopNodeLayerReferenceOptions struct {
	NodeProofID, HysteriaTLSIdentity string
	WhiteningMismatch, Cover         bool
}

func startDesktopNodeLayerReferenceConfigured(t *testing.T, mode, layer string, ip netip.Addr, capture desktopNodeLayerReferenceOptions) *desktopNodeLayerReference {
	t.Helper()
	config, options := desktopReferenceFixture(t)
	if mode == "awg2-strong" {
		config.Parameters["jc"], config.Parameters["jmax"] = "8", "1200"
	}
	config.Echo = append(config.Echo,
		desktopReferenceRule{Network: "tcp", Address: "2001:db8::99", Port: 9999},
		desktopReferenceRule{Network: "udp", Address: "2001:db8::99", Port: 9999})
	var key [32]byte
	if _, err := rand.Read(key[:]); err != nil {
		t.Fatal(err)
	}
	executable, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	copyPath := filepath.Join(t.TempDir(), "node-layer-reference"+filepath.Ext(executable))
	raw, err := os.ReadFile(executable)
	if err != nil || os.WriteFile(copyPath, raw, 0700) != nil {
		t.Fatal("layer peer executable could not be retained", err)
	}
	clear(raw)
	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
	p := &desktopNodeLayerReference{ctx: ctx, cancel: cancel, options: options, done: make(chan error, 1),
		request: desktopNodeLayerRequest{Schema: 1, Mode: mode, Layer: layer, Address: ip.String(), NodeProofID: capture.NodeProofID, HysteriaTLSIdentity: capture.HysteriaTLSIdentity, WhiteningMismatch: capture.WhiteningMismatch, Cover: capture.Cover, Password: base64.StdEncoding.EncodeToString(key[:]), Configuration: config}}
	clear(key[:])
	p.command = exec.CommandContext(ctx, copyPath, "-test.run=^TestRouterVPNDesktopNodeLayerReferenceProcess$", "-test.count=1", "-test.timeout=85s")
	p.command.Env = append(os.Environ(), "ROUTERVPN_NODE_LAYER_REFERENCE_CHILD=1")
	p.input, err = p.command.StdinPipe()
	if err != nil {
		cancel()
		t.Fatal(err)
	}
	var childOutput *os.File
	p.output, childOutput, err = os.Pipe()
	if err != nil {
		cancel()
		_ = p.input.Close()
		t.Fatal(err)
	}
	p.reader = STD.NewReaderSize(p.output, desktopNodeLayerReferenceLimit+1)
	p.command.Stdout, p.command.Stderr = childOutput, &p.diagnostic
	if err := p.command.Start(); err != nil {
		cancel()
		_ = p.input.Close()
		_ = p.output.Close()
		_ = childOutput.Close()
		t.Fatal(err)
	}
	_ = childOutput.Close()
	go func() { p.done <- p.command.Wait() }()
	t.Cleanup(func() {
		_ = p.input.Close()
		select {
		case err := <-p.done:
			if err != nil {
				t.Error("actual layer reference failed", err, p.diagnostic.String())
			}
		case <-time.After(5 * time.Second):
			cancel()
			<-p.done
			t.Error("actual layer reference did not join its captured pipe shutdown", p.diagnostic.String())
		}
		cancel()
		_ = p.output.Close()
		if t.Failed() && p.diagnostic.Len() != 0 {
			t.Logf("retained layer reference diagnostics: %s", p.diagnostic.String())
		}
	})
	if err := json.NewEncoder(p.input).Encode(p.request); err != nil {
		t.Fatal(err)
	}
	p.reply, err = p.read()
	p.remote, _ = netip.ParseAddrPort(p.reply.Address)
	expectedNetwork := "udp"
	if desktopNodeXrayMode(mode) || desktopNodeCompositeMode(mode) || mode == "naive-h2" {
		expectedNetwork = "tcp"
	}
	if err != nil || p.remote.Addr() != ip || p.remote.Port() == 0 || p.reply.ProbeNetwork != expectedNetwork {
		t.Fatal("layer reference did not return its exact physical endpoint", err)
	}
	return p
}

func (p *desktopNodeLayerReference) original(t *testing.T, kill, fault string) *mobilemultihop.NodeProfile {
	t.Helper()
	password := p.request.Password
	if fault == "aes-key" {
		password = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{53}, 32))
	}
	var aesFiles []byte
	if p.reply.AESAddress != "" {
		aesAddress := netip.MustParseAddrPort(p.reply.AESAddress)
		aesGraph := map[string]any{
			"inbounds":  []any{map[string]any{"type": "tun", "tag": "tun-in", "auto_route": true, "strict_route": true}},
			"outbounds": []any{map[string]any{"type": "shadowsocks", "tag": "proxy", "server": p.request.Address, "server_port": int(aesAddress.Port()), "method": mobilemultihop.NativeStartLayerMethod, "password": password}},
			"route":     map[string]any{"final": "proxy", "rules": []any{}},
		}
		aesJSON, _ := json.Marshal(aesGraph)
		aesFiles, _ = json.Marshal(map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString(aesJSON)})
	}
	files, start := string(aesFiles), ""
	profile := map[string]any{"id": "captured-layered-node", "node_kind": "router-vpn", "node_proof_id": strings.Repeat("a", 64),
		"router_api": "http://10.78.0.1:8787", "api_token": "captured-layer-node-token", "endpoint": p.request.Address,
		"start_layer": p.request.Layer, "dns_mode": "home", "adguard_ipv4": "192.168.50.133", "kill_switch_policy": kill,
		"ipv6_mode": "on", "home_lan_access": false, "mtu_policy": "auto"}
	if desktopNodeCompositeMode(p.request.Mode) {
		files = desktopNodeCompositeAssets(t, p.reply.ProtocolFiles, fault)
		if p.request.Layer != "" {
			start = string(aesFiles)
		}
	} else if desktopNodeNaiveMode(p.request.Mode) {
		files = desktopNodeNaiveAssets(t, p.reply.ProtocolFiles, fault)
		if p.request.Layer != "" {
			start = string(aesFiles)
		}
	} else if desktopNodeXrayMode(p.request.Mode) {
		files = desktopNodeXrayAssets(t, p.reply.ProtocolFiles, fault)
		if p.request.Layer != "" {
			start = string(aesFiles)
		}
	} else if p.request.Mode == "hysteria2" {
		files = desktopNodeHysteria2Assets(t, p.reply.ProtocolFiles, fault)
		if p.request.Layer != "" {
			start = string(aesFiles)
		}
	} else if p.request.Mode != "shadowsocks" {
		base := desktopNodePeerOriginal(t, p.request.Mode, p.request.Configuration, p.options, netip.MustParseAddr(p.request.Address),
			netip.MustParseAddrPort(p.reply.BaseAddress), fault == "base-key", false, kill)
		input, err := base.LaunchInput()
		if err != nil {
			t.Fatal(err)
		}
		var record struct {
			Files   string `json:"files"`
			Profile string `json:"profile_json"`
		}
		if json.Unmarshal([]byte(input), &record) != nil || json.Unmarshal([]byte(record.Profile), &profile) != nil {
			t.Fatal("layered base lost its original private inputs")
		}
		profile["start_layer"] = p.request.Layer
		files, start = record.Files, string(aesFiles)
	}
	if p.request.NodeProofID != "" {
		// The optional health responder is part of this original private
		// profile. WG retains the key-derived identity, including a deliberate
		// wrong-peer control; SS/Hysteria2 use the captured Router identity.
		profile["router_api"] = "http://" + desktopNodeRouterHealthTarget
		if p.request.Mode == "shadowsocks" || p.request.Mode == "hysteria2" || p.request.Mode == "ss-v2ray" {
			profile["node_proof_id"] = p.request.NodeProofID
		}
	}
	if p.request.Cover {
		profile["daita_enabled"], profile["daita_host"], profile["daita_rate_kbps"] = true, "10.77.0.1", 64
	}
	captured, _ := json.Marshal(profile)
	original, err := mobilemultihop.NewNodeProfile(p.request.Mode, files, string(captured), start, "")
	if err != nil {
		t.Fatal("actual layer source failed its complete private compiler", err)
	}
	return original
}

type desktopNodeLayerKernel struct {
	*desktopNodePeerKernel
	allowed map[string]netip.AddrPort
}

func (p *desktopNodeLayerKernel) Select(ctx context.Context, c mobiletor.DesktopSocketCapture, network string, remote netip.AddrPort) (mobiletor.DesktopSocketBinding, error) {
	if ctx.Err() != nil || !p.Current(c, p.owner) || network != "tcp" && network != "udp" || remote != p.allowed[network] {
		return mobiletor.DesktopSocketBinding{}, errors.New("layer peer fixture rejected another outer tuple")
	}
	return mobiletor.DesktopSocketBinding{Owner: p.owner, InterfaceName: p.iface.Name, InterfaceIndex: uint32(p.iface.Index), LocalAddress: p.local}, nil
}

func (p *desktopNodeLayerKernel) Bind(ctx context.Context, c mobiletor.DesktopSocketCapture, b mobiletor.DesktopSocketBinding, network string, raw syscall.RawConn) error {
	if ctx.Err() != nil || !p.Current(c, b.Owner) || b.LocalAddress != p.local || b.InterfaceIndex != uint32(p.iface.Index) || b.InterfaceName != p.iface.Name ||
		network != "udp4" && network != "tcp4" || raw == nil {
		return errors.New("layer peer fixture lost its actual captured binding")
	}
	return raw.Control(func(uintptr) {})
}

func (p *desktopNodeLayerKernel) Grant(ctx context.Context, q mobiletor.DesktopSocketGrant) (mobiletor.DesktopSocketReceipt, error) {
	if ctx.Err() != nil || !p.Current(q.Capture, q.Binding.Owner) || q.Network != "tcp" && q.Network != "udp" || q.Remote != p.allowed[q.Network] ||
		q.Local.Addr() != p.local || q.Local.Port() == 0 || !p.network.SocketCurrent() {
		return mobiletor.DesktopSocketReceipt{}, errors.New("layer socket preceded captured native admission")
	}
	p.mu.Lock()
	defer p.mu.Unlock()
	if old, ok := p.grants[q.SocketID]; ok {
		identity := q
		identity.Sequence = old.Sequence
		if old != identity {
			return mobiletor.DesktopSocketReceipt{}, errors.New("layer socket renewal changed its exact owner")
		}
	}
	p.grants[q.SocketID] = q
	p.requests++
	if !p.tun.ready.Load() && !p.network.Current() {
		p.preTUN++
	}
	now := time.Now()
	return mobiletor.DesktopSocketReceipt{Grant: q, ObservedAt: now.UnixMilli(), ExpiresAt: now.Add(10 * time.Second).UnixMilli()}, nil
}

func newDesktopNodeLayerFixture(t *testing.T, peer *desktopNodeLayerReference, fault string) *desktopNodePeerFixture {
	t.Helper()
	if desktopNodeNaiveMode(peer.request.Mode) {
		desktopNodeNaiveLibrary(t)
	}
