		if entryPeer.address == "" || entryPeer.close == nil || entryPeer.stats == nil {
			t.Fatal("entry peer omitted actual original device")
		}
		if socksPeer != nil {
			if entryPeer.relay == nil {
				t.Fatal("SOCKS entry omitted original association route owner")
			}
			socksPeer.mu.Lock()
			socksPeer.entryRelay = entryPeer.relay
