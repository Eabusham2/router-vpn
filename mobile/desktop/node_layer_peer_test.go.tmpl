	if request.Layer != nil {
		key, err := base64.StdEncoding.Strict().DecodeString(request.Layer.Password)
		valid := err == nil && len(key) == 32 && (request.Layer.Mode == "aes-256-gcm" || request.Layer.Mode == "aes-256-gcm+xor-whitening") &&
			(request.Layer.Fault == "" || request.Layer.Fault == "whitening" && request.Layer.Mode == "aes-256-gcm+xor-whitening")
