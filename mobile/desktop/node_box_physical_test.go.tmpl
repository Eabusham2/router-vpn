// Actual compiler/Box/native manager/MTU transactions execute here. The stated
// fixture boundary is a harmless TUN and an OS source that refuses public
// traffic. Successful preparation is not node/DNS or physical kernel proof.
type desktopNodeBoxFixture struct {
	box     *Box
	policy  *mobilemultihop.DesktopNodePolicy
	network *routervpndesktoppt.NodeNetworkOwner
	tun     *desktopTorBoxTUN
	source  *desktopExternalBoxSource
}

func newDesktopNodeBoxFixture(t *testing.T, edit func(map[string]any)) *desktopNodeBoxFixture {
	return newDesktopNodeBoxFixtureWithMTU(t, edit, 0)
}

func newDesktopNodeBoxFixtureWithMTU(t *testing.T, edit func(map[string]any), restoredMTU int) *desktopNodeBoxFixture {
	return newDesktopNodeBoxFixtureWithOptions(t, edit, restoredMTU, nil, nil)
}

func newDesktopNodeBoxFixtureWithOptions(t *testing.T, edit func(map[string]any), restoredMTU int,
	profileEdit func(map[string]any), registryEdit func(*boxService.Registry)) *desktopNodeBoxFixture {
	t.Helper()
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("node native composition fixture requires Linux or Windows")
	}
	graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "auto_route": true, "strict_route": true, "mtu": 1280}},
		"outbounds": []any{map[string]any{"type": "shadowsocks", "tag": "proxy", "server": "192.0.2.44", "server_port": 443,
			"method": "2022-blake3-aes-256-gcm", "password": base64.StdEncoding.EncodeToString([]byte(strings.Repeat("s", 32)))}},
		"route": map[string]any{"final": "proxy", "rules": []any{}}}
	config, _ := json.Marshal(graph)
	files, _ := json.Marshal(map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString(config)})
	profileOptions := map[string]any{"id": "captured-router", "node_kind": "router-vpn", "node_proof_id": strings.Repeat("a", 64),
		"router_api": "http://10.77.0.1:8787", "api_token": "captured-node-token", "endpoint": "192.0.2.44", "dns_mode": "home", "adguard_ipv4": "192.168.50.133",
		"kill_switch_policy": "always", "mtu_policy": "auto", "ipv6_mode": "off", "home_lan_access": false}
	if profileEdit != nil {
		profileEdit(profileOptions)
	}
	profile, _ := json.Marshal(profileOptions)
	original, err := mobilemultihop.NewNodeProfile("shadowsocks", string(files), string(profile), "", "")
	if err != nil {
		t.Fatal(err)
	}
	policy, err := mobilemultihop.NewDesktopNodePolicyWithMTU(original, desktopTorBoxSession, runtime.GOOS, restoredMTU)
	if err != nil {
		t.Fatal(err)
	}
	f := &desktopNodeBoxFixture{policy: policy, source: newDesktopExternalBoxSource()}
	raw := policy.Config()
	if edit != nil {
		var graph map[string]any
		if err := json.Unmarshal([]byte(raw), &graph); err != nil {
			t.Fatal(err)
		}
		edit(graph)
		body, err := json.Marshal(graph)
		if err != nil {
			t.Fatal(err)
		}
		raw = string(body)
	}
	ins := inbound.NewRegistry()
	mixed.RegisterInbound(ins)
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.TunInboundOptions) (adapter.Inbound, error) {
		f.tun = &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag), name: options.InterfaceName, index: 771, mtu: int(options.MTU)}
		return f.tun, nil
	})
	outs := outbound.NewRegistry()
	group.RegisterSelector(outs)
	shadowsocks.RegisterOutbound(outs)
	routervpnwhitening.RegisterOutbound(outs)
	routervpndesktoppt.RegisterNodePhysicalOutbound(outs)
	routervpndesktoppt.RegisterExternalSOCKSOutbound(outs)
	dnsRegistry := dns.NewTransportRegistry()
	DNST.RegisterUDP(dnsRegistry)
	DNST.RegisterTCP(dnsRegistry)
	services := boxService.NewRegistry()
	routervpndesktoppt.RegisterNodeNetworkOwner(services)
	routervpnperformance.RegisterService(services)
	if registryEdit != nil {
		registryEdit(services)
	}
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx = Context(ctx, ins, outs, endpoint.NewRegistry(), dnsRegistry, services, certificate.NewRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(raw))
	if err != nil {
		t.Fatal(err)
	}
	options.Log = &option.LogOptions{Disabled: true}
	f.box, err = New(Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.box.Close(); err != nil {
			t.Error("node Box did not join its native owners", err)
		}
	})
	service, found := f.box.service.Get(mobilemultihop.DesktopNodeNetworkTag)
	var ok bool
	f.network, ok = service.(*routervpndesktoppt.NodeNetworkOwner)
	if !found || !ok {
		t.Fatal("compiled node lost its separate native network service")
	}
	return f
}

func (f *desktopNodeBoxFixture) start(t *testing.T) *RouterVPNDesktopNodePhysical {
	return f.startWithSource(t, f.source)
}

func (f *desktopNodeBoxFixture) startWithSource(t *testing.T, source interface {
	mobiletor.DesktopSocketSource
	mobiletor.DesktopSocketPolicy
}) *RouterVPNDesktopNodePhysical {
	t.Helper()
	if _, _, err := f.box.routerVPNDesktopNodePhysical(f.policy); err != nil {
		t.Fatal(err)
	}
	if err := f.network.PrepareNodePhysicalBroker(f.policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		if f.tun.ready || f.tun.claimed || f.network.SocketCurrent() || f.network.Current() {
			t.Error("node source was constructed after native admission")
		}
		f.source.capture = capture
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observeCtx context.Context) error {
			return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
		})
		return broker, source, err
	}); err != nil {
		t.Fatal(err)
	}
	if err := f.box.RouterVPNStrategyStart(); err != nil {
		t.Fatal("actual node startup", err)
	}
	if f.network.Current() || f.tun.claimed || !f.network.SocketCurrent() {
		t.Fatal("handshake phase fabricated completed node readiness")
	}
	owner, err := f.box.routerVPNDesktopNodeActivatePhysical(f.policy)
	if err != nil {
		t.Fatal("actual node TUN ownership", err)
	}
	if !owner.Current() || !f.tun.claimed || f.source.binds != 1 {
		t.Fatal("node activation omitted its exact TUN binding")
	}
	return owner
}

func TestRouterVPNDesktopNodePhysicalBoxRejectsSubstitutedGraph(t *testing.T) {
	for _, field := range []string{"credential", "dns", "lan", "mtu", "interface", "source"} {
		t.Run(field, func(t *testing.T) {
			f := newDesktopNodeBoxFixture(t, func(graph map[string]any) {
				switch field {
				case "credential":
					graph["outbounds"].([]any)[0].(map[string]any)["password"] = base64.StdEncoding.EncodeToString([]byte(strings.Repeat("f", 32)))
				case "dns":
					graph["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)["server"] = "192.168.50.134"
				case "lan":
					graph["route"].(map[string]any)["rules"] = []any{}
				case "mtu":
					graph["inbounds"].([]any)[0].(map[string]any)["mtu"] = float64(1392)
				case "interface":
					graph["inbounds"].([]any)[0].(map[string]any)["interface_name"] = "foreign-tunnel"
				case "source":
					graph["services"].([]any)[0].(map[string]any)["source_sha256"] = strings.Repeat("f", 64)
				}
			})
			if _, _, err := f.box.routerVPNDesktopNodePhysical(f.policy); err == nil {
				t.Fatal("substituted native graph acquired a node lower factory")
			}
			if owner, err := f.box.routerVPNDesktopNodeActivatePhysical(f.policy); err == nil || owner != nil {
				t.Fatal("substituted graph acquired an actual TUN owner")
			}
			if f.tun.ready || f.tun.claimed {
				t.Fatal("rejected graph entered native TUN lifecycle")
			}
		})
	}
}

func TestRouterVPNDesktopNodePhysicalBoxRequiresPreparedOwner(t *testing.T) {
	f := newDesktopNodeBoxFixture(t, nil)
	if owner, err := f.box.routerVPNDesktopNodeActivatePhysical(f.policy); err == nil || owner != nil {
		t.Fatal("unstarted Box acquired physical TUN authority")
	}
	if err := f.box.RouterVPNStrategyStart(); err == nil {
		t.Fatal("node JSON bypassed its actual prepared OS factory")
	}
	if f.tun.ready || f.tun.claimed || f.network.SocketCurrent() {
		t.Fatal("missing factory reached native handshake or TUN startup")
	}
}

func (f *desktopNodeBoxFixture) replacement(owner *RouterVPNDesktopNodePhysical, callback func(adapter.StartStage) error, candidate, rollback **desktopTorMTUCandidate) func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) {
	return func(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
		reader, ok := expected.(routerVPNDesktopTorTUN)
		if !ok {
			return expected, errors.New("another reader family")
		}
		name, index, oldMTU, err := reader.RouterVPNDesktopMTUInterface()
		if err != nil {
			return expected, err
		}
		makeReader := func(value, nextIndex int) *desktopTorMTUCandidate {
			return &desktopTorMTUCandidate{desktopTorBoxTUN: &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, expected.Tag()), name: name, index: nextIndex, mtu: value, claimed: true, guard: owner.generationCurrent, guardContext: owner.generationCurrentContext}}
		}
		*candidate, *rollback = makeReader(mtu, index+1), makeReader(oldMTU, index+2)
		(*candidate).afterStart = callback
		return f.box.inbound.RouterVPNReplaceTun(ctx, expected, *candidate, *rollback)
	}
}

func TestRouterVPNDesktopNodePhysicalBoxRetainsMTUAndExactRollback(t *testing.T) {
	f := newDesktopNodeBoxFixture(t, nil)
	owner := f.start(t)
	joined := make(chan error, 1)
	go func() { _, _, _, err := owner.ClaimTUN(owner.Current); joined <- err }()
	select {
	case err := <-joined:
		if err != nil {
			t.Fatal(err)
		}
	case <-time.After(time.Second):
		t.Fatal("composite MTU guard deadlocked its same retained owner")
	}
	original := owner.inbound
	var candidate, rollback *desktopTorMTUCandidate
	next, err := owner.changeMTU(context.Background(), original, 1400, f.replacement(owner, nil, &candidate, &rollback))
	if err != nil || next != candidate || !owner.Current() {
		t.Fatal("native MTU candidate lost exact physical ownership", err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	next, err = owner.changeMTU(ctx, next, 1500, f.replacement(owner, func(stage adapter.StartStage) error {
		if stage == adapter.StartStateStarted {
			cancel()
		}
		return nil
	}, &candidate, &rollback))
	if err == nil || next != rollback || !owner.Current() {
		t.Fatal("cancelled native MTU lost its actual valid rollback", err)
	}
	name, index, mtu, err := owner.ClaimTUN(owner.Current)
	if err != nil || name != "router-vpn" || index != 774 || mtu != 1400 || f.source.binds != 3 || f.source.retires != 2 || f.source.index != 774 {
		t.Fatal("native rollback adopted another TUN or skipped exact retire/rebind", name, index, mtu, err)
	}
	called := false
	if _, err := owner.changeMTU(context.Background(), original, 1450, func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) { called = true; return nil, nil }); err == nil || called {
		t.Fatal("stale original TUN changed its replacement")
	}
	if _, err := owner.changeMTU(context.Background(), next, 1450, func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) { return original, nil }); err == nil || owner.Current() || f.network.SocketCurrent() {
		t.Fatal("unrelated replacement result retained the live physical generation")
	}
}

func TestRouterVPNDesktopNodePhysicalBoxMTUOriginalCleanup(t *testing.T) {
	for _, expired := range []bool{false, true} {
		t.Run(fmt.Sprint(expired), func(t *testing.T) {
			f := newDesktopNodeBoxFixture(t, nil)
			owner := f.start(t)
			budget := time.Second
			if expired {
				budget = 40 * time.Millisecond
			}
			accepted, finish, err := mobilemtu.WithOperationContext(context.Background(), time.Minute, budget)
			if err != nil {
				t.Fatal(err)
			}
			defer finish()
			work, cancel := context.WithCancel(accepted)
			defer cancel()
			var candidate, rollback *desktopTorMTUCandidate
			var cleanup context.Context
			observations := 0
			change := f.replacement(owner, func(stage adapter.StartStage) error {
				if stage == adapter.StartStateStarted {
					cancel()
				}
				return nil
			}, &candidate, &rollback)
			next, failure := owner.changeMTU(work, owner.inbound, 1400, func(call context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
				if !mobilemtu.SameOperationContext(work, call) {
					t.Fatal("physical replacement substituted the admitted MTU operation")
				}
				next, failure := change(call, expected, mtu)
				cleanup, err = mobilemtu.OperationCleanupContext(call)
				if err != nil || next != rollback {
					t.Fatal("native transaction did not retain its exact rollback and original allowance", err)
				}
				rollback.guardContext = func(observe context.Context) error {
					observations++
					if observe != cleanup || !mobilemtu.SameOperationContext(work, observe) {
						return errors.New("physical adoption renewed the native rollback allowance")
					}
					return owner.generationCurrentContext(observe)
				}
				if expired {
					<-cleanup.Done()
				}
				return next, failure
			})
			if failure == nil || next != rollback || !errors.Is(failure, context.Canceled) {
				t.Fatal("cancelled work claimed a measured winner or lost the actual returned rollback", failure)
			}
			if expired {
				if !errors.Is(failure, context.DeadlineExceeded) || owner.Current() || f.network.SocketCurrent() || f.source.binds != 1 || f.source.retires != 1 || observations != 0 {
					t.Fatal("expired original cleanup renewed a physical grant or observed a replacement", failure, observations)
				}
			} else if !owner.Current() || f.source.binds != 2 || f.source.retires != 1 || observations < 2 {
				t.Fatal("valid original cleanup did not bind and read the exact rollback", failure, observations)
			}
		})
	}
}

type desktopNodeMTUObservedContext struct {
	context.Context
	entered chan struct{}
	once    sync.Once
}

func (c *desktopNodeMTUObservedContext) Err() error {
	// Capture before notifying cancellation, so even the old unbounded path
	// necessarily passes its first check and then encounters the held lock.
	err := c.Context.Err()
	c.once.Do(func() { close(c.entered) })
	return err
}

func TestRouterVPNDesktopNodePhysicalBoxMTULocksHonorCaller(t *testing.T) {
	for _, held := range []string{"physical-owner", "native-reader"} {
		t.Run(held, func(t *testing.T) {
			f := newDesktopNodeBoxFixture(t, nil)
			owner := f.start(t)
			accepted, finish, err := mobilemtu.WithOperationContext(context.Background(), time.Minute, time.Second)
			if err != nil {
				t.Fatal(err)
			}
			defer finish()
			work, cancel := context.WithCancel(accepted)
			defer cancel()
			observed := &desktopNodeMTUObservedContext{Context: work, entered: make(chan struct{})}
			lock := &owner.mu
			if held == "native-reader" {
				lock = &f.tun.mu
			}
			lock.Lock()
			called := false
			joined := make(chan error, 1)
			go func() {
				_, err := owner.changeMTU(observed, owner.inbound, 1400, func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) {
					called = true
					return nil, errors.New("cancelled caller reached native mutation")
				})
				joined <- err
			}()
			<-observed.entered
			cancel()
			select {
			case err := <-joined:
				lock.Unlock()
				if !errors.Is(err, context.Canceled) || called || f.source.binds != 1 || f.source.retires != 0 || !owner.Current() {
					t.Fatal("cancelled lock admission changed native TUN ownership", err)
				}
			case <-time.After(time.Second):
				lock.Unlock()
				<-joined
				t.Fatal("cancelled physical MTU retained a waiter behind another owner's lock")
			}
		})
	}
}

type desktopNodeEnteredRetirement struct {
	*desktopExternalBoxSource
	cancel context.CancelFunc
}

func (s *desktopNodeEnteredRetirement) RetireTunnel(ctx context.Context, capture mobiletor.DesktopSocketCapture, name string, index uint32) error {
	if err := s.desktopExternalBoxSource.RetireTunnel(ctx, capture, name, index); err != nil {
		return err
	}
	s.cancel()
	return ctx.Err()
}

func TestRouterVPNDesktopNodePhysicalBoxMTURetireFailureInvalidatesOwner(t *testing.T) {
	f := newDesktopNodeBoxFixture(t, nil)
	work, cancel := context.WithCancel(context.Background())
	defer cancel()
	source := &desktopNodeEnteredRetirement{desktopExternalBoxSource: f.source, cancel: cancel}
	owner := f.startWithSource(t, source)
	called := false
	_, err := owner.changeMTU(work, owner.inbound, 1400, func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) {
		called = true
		return nil, nil
	})
	if !errors.Is(err, context.Canceled) || called || f.source.retires != 1 || f.source.binds != 1 || owner.Current() || f.network.SocketCurrent() {
		t.Fatal("uncertain entered retirement retained a supposedly usable physical path", err)
	}
	if err := f.network.Close(); err != nil || !f.source.cancelled.Load() || !f.source.closed.Load() {
		t.Fatal("failed entered retirement did not join its exact original source", err)
	}
}

func TestRouterVPNDesktopNodePhysicalBoxRestoresCapturedMTU(t *testing.T) {
	for _, restored := range []int{1280, 1392} {
		t.Run(fmt.Sprint(restored), func(t *testing.T) {
			f := newDesktopNodeBoxFixtureWithMTU(t, nil, restored)
			capture, err := f.policy.Capture()
			if err != nil || capture.ConfiguredMTU != 1280 || f.policy.Metadata().RestoredMTU != restored {
				t.Fatal("restoration replaced the saved MTU contract", err)
			}
			owner := f.start(t)
			_, _, actual, err := owner.ClaimTUN(owner.Current)
			if err != nil || actual != restored {
				t.Fatal("sealed restored MTU did not match the actual started TUN", err, actual)
			}
			// The same valid policy cannot adopt a different live interface MTU.
			f.tun.mtu++
			if owner.Current() {
				t.Fatal("restored native TUN accepted another live MTU")
			}
		})
	}
}

type desktopStartupBoundTUN struct {
	desktopTorBoxTUN
	caller context.Context
	admit  func(context.Context) error
}

func (t *desktopStartupBoundTUN) RouterVPNDesktopMTUStartupContext(ctx context.Context) error {
	t.caller = ctx
	if t.admit != nil {
		return t.admit(ctx)
	}
	return ctx.Err()
}

func TestRouterVPNDesktopStartupKeepsCallerAndLifetime(t *testing.T) {
	for _, mode := range []string{"original", "expired", "late-success", "missing-reader", "no-deadline"} {
		t.Run(mode, func(t *testing.T) {
			lifetime, stop := context.WithCancel(context.Background())
			defer stop()
			ctx, cancel := context.WithTimeout(lifetime, time.Second)
			defer cancel()
			f := &desktopStartupBoundTUN{desktopTorBoxTUN: desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, "original")}}
			registry := inbound.NewRegistry()
			inbound.Register[option.TunInboundOptions](registry, C.TypeTun, func(context.Context, adapter.Router, log.ContextLogger, string, option.TunInboundOptions) (adapter.Inbound, error) {
				if mode == "missing-reader" {
					return &f.desktopTorBoxTUN, nil
				}
				return f, nil
			})
			manager := inbound.NewManager(nil, registry, nil)
			if err := manager.Create(lifetime, nil, nil, "original", C.TypeTun, &option.TunInboundOptions{}); err != nil {
				t.Fatal(err)
			}
			b := &Box{ctx: lifetime, inbound: manager}
			if mode == "expired" {
				cancel()
			}
			if mode == "late-success" {
				f.admit = func(call context.Context) error { cancel(); return nil }
			}
			if mode == "no-deadline" {
				ctx = lifetime
			}
			err := b.RouterVPNDesktopStartupContext(ctx)
			if mode == "original" {
				if err != nil || f.caller != ctx {
					t.Fatal("startup replaced original caller", err)
				}
				cancel()
				if lifetime.Err() != nil || b.ctx != lifetime {
					t.Fatal("startup canceled or replaced connection lifetime")
				}
			} else if err == nil {
				t.Fatal("invalid or expired startup admitted", mode)
			}
			if (mode == "expired" || mode == "late-success") && !errors.Is(err, context.Canceled) {
				t.Fatal("lost original cancellation", err)
			}
			if (mode == "expired" || mode == "no-deadline") && f.caller != nil {
				t.Fatal("expired or unbounded caller reached admission")
			}
		})
	}
}
