//go:build (linux && !android) || (darwin && routervpn_darwin_node_chain)

package routervpnamnezia

import (
	"context"
	"crypto/sha256"
	"encoding/base64"
	"errors"
	"io"
	"net"
	"net/netip"
	"strings"
	"testing"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

type importedExecutionLayers struct {
	Entry         string `json:"entry"`
	Final         string `json:"final"`
	EntryPassword string `json:"entry_password,omitempty"`
	Fault         string `json:"fault,omitempty"`
}

func importedExecutionLayerMode(value string) bool {
	return value == "off" || value == "aes-256-gcm" || value == "aes-256-gcm+xor-whitening"
}
func (p *importedExecutionLayers) validate(request desktopNodeChainImportedRequest) error {
	if p == nil {
		return nil
	}
	bad := errors.New("independent imported execution layers lost exact original sources")
	if !importedExecutionLayerMode(p.Entry) || !importedExecutionLayerMode(p.Final) {
		return bad
	}
	if p.Entry == "off" {
		if p.EntryPassword != "" {
			return bad
		}
	} else {
		key, err := base64.StdEncoding.Strict().DecodeString(p.EntryPassword)
		defer clear(key)
		if err != nil || len(key) != 32 || base64.StdEncoding.EncodeToString(key) != p.EntryPassword || strings.Trim(string(key), "\x00") == "" {
			return bad
		}
		first := request.Paired.Prefixes[0]
		if p.EntryPassword == first.PrivateKey || p.EntryPassword == first.PreSharedKey || p.EntryPassword == first.ClientPublicKey || p.EntryPassword == request.MiddlePassword || p.EntryPassword == request.Paired.FinalPassword {
			return bad
		}
	}
	switch p.Fault {
	case "":
	case "entry-layer-key":
		if p.Entry == "off" {
			return bad
		}
	case "entry-whitening":
		if p.Entry != "aes-256-gcm+xor-whitening" {
			return bad
		}
	case "final-layer-key":
		if p.Final == "off" {
			return bad
		}
	case "final-whitening":
		if p.Final != "aes-256-gcm+xor-whitening" {
			return bad
		}
	default:
		return bad
	}
	return nil
}

type importedExecutionLayerPeers struct {
	entry, final             *desktopExternalInstalledSSPeer
	entrySource, finalSource string
}

func (p *importedExecutionLayerPeers) snapshot() map[string]any {
	result := map[string]any{"entry": p.entrySource, "final": p.finalSource}
	if p.entry != nil {
		result["entry_transport"] = p.entry.stats()
	}
	if p.final != nil {
		result["final_transport"] = p.final.stats()
	}
	return result
}
func (p *importedExecutionLayerPeers) close() {
	if p.entry != nil {
		p.entry.close()
	}
	if p.final != nil {
		p.final.close()
	}
}
func importedExecutionDifferentLayerKey(t *testing.T, password string) string {
	t.Helper()
	key, err := base64.StdEncoding.Strict().DecodeString(password)
	if err != nil || len(key) != 32 {
		t.Fatal("original layer key absent")
	}
	defer clear(key)
	key[0] ^= 255
	return base64.StdEncoding.EncodeToString(key)
}
func (p *importedExecutionLayerPeers) finalProvider(t *testing.T, request importedExecutionPeerRequest) func(*desktopNodeLayerServer) desktopExternalInstalledSSPeer {
	if request.Layers == nil {
		return nil
	}
	p.entrySource, p.finalSource = request.Layers.Entry, request.Layers.Final
	return func(owner *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
		password := request.Peer.Paired.FinalPassword
		if request.Layers.Fault == "final-layer-key" {
			password = importedExecutionDifferentLayerKey(t, password)
		}
		var stream func(net.Conn) net.Conn
		var packet func(net.PacketConn) net.PacketConn
		if request.Layers.Final == "aes-256-gcm+xor-whitening" {
			key := sha256.Sum256([]byte("router-vpn-xor-whitening-v1\x00" + request.Peer.Paired.FinalPassword))
			if request.Layers.Fault == "final-whitening" {
				key[0] ^= 255
			}
			stream = func(c net.Conn) net.Conn { return &desktopSSLayerStream{Conn: c, key: key} }
			packet = func(c net.PacketConn) net.PacketConn { return &desktopSSLayerPacket{PacketConn: c, key: key} }
		}
		provider := desktopStartSSProviderBoundTransport(t, owner, mobilemultihop.NativeStartLayerMethod, password, netip.MustParseAddr("127.0.0.1"), 0, stream, packet)
		p.final = &provider
		return provider
	}
}
func (p *importedExecutionLayerPeers) entryProvider(t *testing.T, request importedExecutionPeerRequest, peer *desktopNodeChainImportedPeer, physical netip.Addr) {
	if request.Layers == nil {
		return
	}
	if request.Layers.Final == "aes-256-gcm+xor-whitening" {
		for i := range peer.middle.routes {
			if peer.middle.routes[i].Destination == "10.77.0.1:8388" {
				peer.middle.routes[i].Destination = "10.77.0.1:8389"
			}
		}
	}
	if request.Layers.Entry == "off" {
		return
	}
	base, err := netip.ParseAddrPort(peer.paired.address)
	if err != nil || base.Addr() != physical {
		t.Fatal("original packet base address changed", err)
	}
	password := request.Layers.EntryPassword
	if request.Layers.Fault == "entry-layer-key" {
		password = importedExecutionDifferentLayerKey(t, password)
	}
	var stream func(net.Conn) net.Conn
	var packet func(net.PacketConn) net.PacketConn
	port := uint16(0)
	if request.Layers.Entry == "aes-256-gcm+xor-whitening" {
		port = 8389
		key := sha256.Sum256([]byte("router-vpn-xor-whitening-v1\x00" + request.Layers.EntryPassword))
		if request.Layers.Fault == "entry-whitening" {
			key[0] ^= 255
		}
		stream = func(c net.Conn) net.Conn { return &desktopSSLayerStream{Conn: c, key: key} }
		packet = func(c net.PacketConn) net.PacketConn { return &desktopSSLayerPacket{PacketConn: c, key: key} }
	}
	ctx, cancel := context.WithCancel(peer.paired.entry.ctx)
	private := netip.AddrPortFrom(netip.MustParseAddr("10.78.0.1"), base.Port()).String()
	owner := &desktopNodeLayerServer{ctx: ctx, cancel: cancel, connections: map[io.Closer]bool{}, routes: []desktopNodeLayerRoute{{Network: "udp", Destination: private, Physical: base.String()}}}
	provider := desktopStartSSProviderBoundTransport(t, owner, mobilemultihop.NativeStartLayerMethod, password, physical, port, stream, packet)
	p.entry = &provider
}
