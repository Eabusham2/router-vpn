package routervpndesktoppt

import (
	"context"
	"errors"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// This callback is an owned native capability installed by the command before
// constructing its Box. Imported options cannot approve a protection handoff.
type NodePhysicalPrepared struct {
	Capture        mobiletor.DesktopSocketCapture
	Policy         string
	BaselineSHA256 string
}

type NodePhysicalAdmission func(context.Context, NodePhysicalPrepared) error
type nodePhysicalAdmissionKey struct{}
type nodePhysicalAdmissionOwner struct {
	policy *mobilemultihop.DesktopNodePolicy
	admit  NodePhysicalAdmission
}

func WithNodePhysicalAdmission(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy, admit NodePhysicalAdmission) (context.Context, error) {
	if ctx == nil || ctx.Err() != nil || policy == nil || policy.Validate() != nil || admit == nil ||
		policy.Metadata().TargetOS != "windows" || ctx.Value(nodePhysicalAdmissionKey{}) != nil {
		return nil, errors.New("Router node physical handoff requires its unique captured native policy")
	}
	return context.WithValue(ctx, nodePhysicalAdmissionKey{}, &nodePhysicalAdmissionOwner{policy, admit}), nil
}

func nodePhysicalAdmissionFor(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy) (NodePhysicalAdmission, error) {
	if ctx == nil || ctx.Err() != nil || policy == nil {
		return nil, errors.New("Router node physical handoff lost its native lifetime")
	}
	owner, ok := ctx.Value(nodePhysicalAdmissionKey{}).(*nodePhysicalAdmissionOwner)
	if !ok || owner == nil || owner.policy != policy || owner.admit == nil {
		return nil, errors.New("Router node physical handoff has no captured native admission")
	}
	return owner.admit, nil
}

// CompleteNodePhysicalAdmission consumes only a previously installed
// native capability for this same policy object. It does not create or verify
// kernel policy; the Windows factory supplies its independently read baseline.
func CompleteNodePhysicalAdmission(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy, prepared NodePhysicalPrepared) error {
	admit, err := nodePhysicalAdmissionFor(ctx, policy)
	if err != nil {
		return err
	}
	metadata := policy.Metadata()
	if prepared.Capture.SessionID != metadata.SessionID || prepared.Capture.SourceSHA256 != metadata.SourceSHA256 ||
		prepared.Policy != metadata.KillSwitchPolicy || !networkSessionID.MatchString(prepared.Capture.NetworkID) || !networkSourceID.MatchString(prepared.BaselineSHA256) {
		return errors.New("Router node physical handoff substituted its captured native baseline")
	}
	return admit(ctx, prepared)
}
