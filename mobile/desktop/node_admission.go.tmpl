package routervpndesktoppt

import (
	"context"
	"errors"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// This callback is an owned native capability installed by the command before
// constructing its Box. Imported options cannot approve a protection handoff.
type NodePhysicalPrepared struct {
	Capture        mobiletor.DesktopSocketCapture
	Policy         string
	BaselineSHA256 string
}

type NodePhysicalAdmission func(context.Context, NodePhysicalPrepared) error
type nodePhysicalAdmissionKey struct{}
type nodePhysicalAdmissionOwner struct {
	policy      *mobilemultihop.DesktopNodePolicy
	admit       NodePhysicalAdmission
	predecessor *mobiletor.DesktopWindowsProtectionTarget
	commit      mobiletor.DesktopWindowsProtectionCommitBarrier
}

// WithNodePhysicalJournalAdmission binds the authenticated parent's durable
// intent acknowledgment to this exact compiled policy and prepared admission.
// A staged transfer file is comparison data; it cannot construct this callback.
func WithNodePhysicalJournalAdmission(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy,
	predecessor *mobiletor.DesktopWindowsProtectionTarget, commit mobiletor.DesktopWindowsProtectionCommitBarrier,
	admit NodePhysicalAdmission) (context.Context, error) {
	if commit == nil || predecessor != nil && predecessor.Validate() != nil {
		return nil, errors.New("Router node journal admission has no exact durable transaction")
	}
	var previous *mobiletor.DesktopWindowsProtectionTarget
	if predecessor != nil {
		copy := *predecessor
		previous = &copy
	}
	owned, err := withNodePhysicalAdmission(ctx, policy, previous, admit)
	if err != nil {
		return nil, err
	}
	owned.Value(nodePhysicalAdmissionKey{}).(*nodePhysicalAdmissionOwner).commit = commit
	return owned, nil
}

func nodePhysicalCommitFor(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy) (mobiletor.DesktopWindowsProtectionCommitBarrier, error) {
	if _, err := nodePhysicalAdmissionFor(ctx, policy); err != nil {
		return nil, err
	}
	return ctx.Value(nodePhysicalAdmissionKey{}).(*nodePhysicalAdmissionOwner).commit, nil
}

func WithNodePhysicalAdmission(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy, admit NodePhysicalAdmission) (context.Context, error) {
	return withNodePhysicalAdmission(ctx, policy, nil, admit)
}

// WithNodePhysicalSuccessorAdmission captures the exact already-drained native
// predecessor alongside this particular compiled graph. The Windows factory
// independently verifies it under the native BFE lock before replacement.
// Imported JSON and a later selected profile cannot supply or change it.
func WithNodePhysicalSuccessorAdmission(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy, predecessor mobiletor.DesktopWindowsProtectionTarget, admit NodePhysicalAdmission) (context.Context, error) {
	if err := predecessor.Validate(); err != nil {
		return nil, err
	}
	return withNodePhysicalAdmission(ctx, policy, &predecessor, admit)
}

func withNodePhysicalAdmission(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy, predecessor *mobiletor.DesktopWindowsProtectionTarget, admit NodePhysicalAdmission) (context.Context, error) {
	if ctx == nil || ctx.Err() != nil || policy == nil || policy.Validate() != nil || admit == nil ||
		policy.Metadata().TargetOS != "windows" || ctx.Value(nodePhysicalAdmissionKey{}) != nil {
		return nil, errors.New("Router node physical handoff requires its unique captured native policy")
	}
	return context.WithValue(ctx, nodePhysicalAdmissionKey{}, &nodePhysicalAdmissionOwner{policy: policy, admit: admit, predecessor: predecessor}), nil
}

func nodePhysicalAdmissionFor(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy) (NodePhysicalAdmission, error) {
	if ctx == nil || ctx.Err() != nil || policy == nil {
		return nil, errors.New("Router node physical handoff lost its native lifetime")
	}
	owner, ok := ctx.Value(nodePhysicalAdmissionKey{}).(*nodePhysicalAdmissionOwner)
	if !ok || owner == nil || owner.policy != policy || owner.admit == nil {
		return nil, errors.New("Router node physical handoff has no captured native admission")
	}
	return owner.admit, nil
}

func nodePhysicalPredecessorFor(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy) (*mobiletor.DesktopWindowsProtectionTarget, error) {
	if _, err := nodePhysicalAdmissionFor(ctx, policy); err != nil {
		return nil, err
	}
	owner := ctx.Value(nodePhysicalAdmissionKey{}).(*nodePhysicalAdmissionOwner)
	if owner.predecessor == nil {
		return nil, nil // Explicit initial absence, never arbitrary recovery.
	}
	captured := *owner.predecessor
	if err := captured.Validate(); err != nil {
		return nil, err
	}
	return &captured, nil
}

// CompleteNodePhysicalAdmission consumes only a previously installed
// native capability for this same policy object. It does not create or verify
// kernel policy; the Windows factory supplies its independently read baseline.
func CompleteNodePhysicalAdmission(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy, prepared NodePhysicalPrepared) error {
	admit, err := nodePhysicalAdmissionFor(ctx, policy)
	if err != nil {
		return err
	}
	metadata := policy.Metadata()
	if prepared.Capture.SessionID != metadata.SessionID || prepared.Capture.SourceSHA256 != metadata.SourceSHA256 ||
		prepared.Policy != metadata.KillSwitchPolicy || !networkSessionID.MatchString(prepared.Capture.NetworkID) || !networkSourceID.MatchString(prepared.BaselineSHA256) {
		return errors.New("Router node physical handoff substituted its captured native baseline")
	}
	return admit(ctx, prepared)
}
