type physicalTunnelCall struct {
	capture mobiletor.DesktopSocketCapture
	name    string
	index   uint32
	retire  bool
}
type physicalTunnelSource struct {
	*physicalFactorySource
	mu     sync.Mutex
	calls  []physicalTunnelCall
	before func()
	err    error
}

func (s *physicalTunnelSource) change(ctx context.Context, capture mobiletor.DesktopSocketCapture, name string, index uint32, retire bool) error {
	deadline, bounded := ctx.Deadline()
	if !bounded || time.Until(deadline) > 3*time.Second || ctx.Err() != nil {
		return errors.New("physical tunnel operation lost its bounded caller")
	}
	s.mu.Lock()
	s.calls = append(s.calls, physicalTunnelCall{capture, name, index, retire})
	s.mu.Unlock()
	if s.before != nil {
		s.before()
	}
	return s.err
}
func (s *physicalTunnelSource) BindTunnel(ctx context.Context, capture mobiletor.DesktopSocketCapture, name string, index uint32) error {
	return s.change(ctx, capture, name, index, false)
}
func (s *physicalTunnelSource) RetireTunnel(ctx context.Context, capture mobiletor.DesktopSocketCapture, name string, index uint32) error {
	return s.change(ctx, capture, name, index, true)
}
func physicalTunnelNetwork(t *testing.T, source mobiletor.DesktopSocketSource, policy mobiletor.DesktopSocketPolicy, activate bool) *NetworkOwner {
	t.Helper()
	n := physicalFactoryNetwork(t)
	if err := n.PreparePhysicalBroker(func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, policy, current, func(observeCtx context.Context) error {
			return n.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
		})
		return broker, source, err
	}); err != nil {
		t.Fatal(err)
	}
	if err := n.Start(adapter.StartStateInitialize); err != nil {
		t.Fatal(err)
	}
	if activate {
		if err := n.Start(adapter.StartStateStarted); err != nil {
			t.Fatal(err)
		}
		options := testNetworkOptions()
		if _, err := n.Activate(options.SessionID, options.SourceSHA256); err != nil {
			t.Fatal(err)
		}
	}
	return n
}
func physicalTunnelTestSource() *physicalTunnelSource {
	return &physicalTunnelSource{physicalFactorySource: &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()}}
}
func TestRouterVPNPhysicalTunnelCapturesAndRetiresExactReader(t *testing.T) {
	source := physicalTunnelTestSource()
	n := physicalTunnelNetwork(t, source, source, true)
	ctx := context.Background()
	for _, call := range []physicalTunnelCall{
		{n.brokerCapture(), "RouterVPN-TUN", 301, false},
		{n.brokerCapture(), "RouterVPN-TUN", 301, true},
		{n.brokerCapture(), "RouterVPN-TUN", 304, false},
	} {
		var err error
		if call.retire {
			err = n.RetirePhysicalTunnel(ctx, call.name, call.index)
		} else {
			err = n.BindPhysicalTunnel(ctx, call.name, call.index)
		}
		if err != nil {
			t.Fatal(err)
		}
	}
	source.mu.Lock()
	defer source.mu.Unlock()
	if len(source.calls) != 3 || source.calls[0].retire || !source.calls[1].retire || source.calls[2].retire ||
		source.calls[0].capture != n.brokerCapture() || source.calls[1].index != 301 || source.calls[2].index != 304 {
		t.Fatal("native tunnel grant did not preserve captured retirement and replacement order", source.calls)
	}
}
func TestRouterVPNPhysicalTunnelRejectsUnstartedAndInvalidReaders(t *testing.T) {
	for _, activated := range []bool{false, true} {
		source := physicalTunnelTestSource()
		n := physicalTunnelNetwork(t, source, source, activated)
		for _, call := range []physicalTunnelCall{{name: "", index: 301}, {name: "RouterVPN-TUN", index: 0}} {
			if err := n.BindPhysicalTunnel(context.Background(), call.name, call.index); err == nil {
				t.Fatal("invalid native tunnel reader reached policy")
			}
		}
		if !activated && n.BindPhysicalTunnel(context.Background(), "RouterVPN-TUN", 301) == nil {
			t.Fatal("unstarted tunnel reader reached policy")
		}
		source.mu.Lock()
		if len(source.calls) != 0 {
			t.Error("invalid tunnel reader caused a policy operation")
		}
		source.mu.Unlock()
	}
}
func TestRouterVPNPhysicalTunnelRejectsNativePolicyFailure(t *testing.T) {
	for _, retire := range []bool{false, true} {
		source := physicalTunnelTestSource()
		source.err = errors.New("actual native policy rejection")
		n := physicalTunnelNetwork(t, source, source, true)
		if err := n.changePhysicalTunnel(context.Background(), "RouterVPN-TUN", 301, retire); !errors.Is(err, source.err) {
			t.Fatal("native tunnel policy failure was reported as acknowledged", err)
		}
	}
}
func TestRouterVPNPhysicalTunnelRejectsLateNetworkCompletion(t *testing.T) {
	source := physicalTunnelTestSource()
	entered, release := make(chan struct{}), make(chan struct{})
	source.before = func() { close(entered); <-release }
	n := physicalTunnelNetwork(t, source, source, true)
	result := make(chan error, 1)
	go func() { result <- n.BindPhysicalTunnel(context.Background(), "RouterVPN-TUN", 301) }()
	<-entered
	n.InterfaceUpdated(context.Background())
	close(release)
	select {
	case err := <-result:
		if err == nil {
			t.Fatal("late tunnel grant acknowledged a retired physical generation")
		}
	case <-time.After(time.Second):
		t.Fatal("late tunnel operation did not return")
	}
}
func TestRouterVPNPhysicalTunnelPreservesExistingOSBoundary(t *testing.T) {
	source := &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()}
	n := physicalTunnelNetwork(t, source, source, true)
	err := n.BindPhysicalTunnel(context.Background(), "RouterVPN-TUN", 301)
	if runtime.GOOS == "windows" || runtime.GOOS == "darwin" {
		if err == nil {
			t.Fatal("native OS accepted a source without its actual owned tunnel lifecycle")
		}
	} else if err != nil {
		t.Fatal("existing non-WFP baseline behavior changed", err)
	}
	ordinary := &NetworkOwner{}
	if err := ordinary.BindPhysicalTunnel(nil, "", 0); err != nil {
		t.Fatal("ordinary native path acquired a physical WFP requirement", err)
	}
}

type physicalTunnelFileSource struct {
	*physicalTunnelSource
	file *os.File
}

func (s *physicalTunnelFileSource) BindTunnelFile(ctx context.Context, capture mobiletor.DesktopSocketCapture, name string, index uint32, file *os.File) error {
	if file == nil {
		return errors.New("missing actual control file")
	}
	if _, err := file.Stat(); err != nil {
		return err
	}
	s.file = file
	return s.change(ctx, capture, name, index, false)
}

func TestRouterVPNPhysicalTunnelCapturesExactControlFile(t *testing.T) {
	source := &physicalTunnelFileSource{physicalTunnelSource: physicalTunnelTestSource()}
	n := physicalTunnelNetwork(t, source, source, true)
	file, err := os.Open(os.DevNull)
	if err != nil {
		t.Fatal(err)
	}
	defer file.Close()
	if err := n.BindPhysicalTunnelFile(context.Background(), "utun-owned", 301, file); err != nil {
		t.Fatal(err)
	}
	if source.file != file || len(source.calls) != 1 || source.calls[0].capture != n.brokerCapture() {
		t.Fatal("actual control file/capture was substituted")
	}
	if _, err := file.Stat(); err != nil {
		t.Fatal("network transfer prematurely closed the caller's retained file", err)
	}
	if err := n.RetirePhysicalTunnel(context.Background(), "utun-owned", 301); err != nil {
		t.Fatal(err)
	}
	if len(source.calls) != 2 || !source.calls[1].retire {
		t.Fatal("actual control retirement was omitted")
	}
}

func TestRouterVPNPhysicalTunnelRejectsMissingControlAdapterAndLateCapture(t *testing.T) {
	file, err := os.Open(os.DevNull)
	if err != nil {
		t.Fatal(err)
	}
	defer file.Close()
	source := physicalTunnelTestSource()
	n := physicalTunnelNetwork(t, source, source, true)
	if n.BindPhysicalTunnelFile(context.Background(), "utun-owned", 301, file) == nil {
		t.Fatal("a name-only policy claimed actual control ownership")
	}
	owned := &physicalTunnelFileSource{physicalTunnelSource: physicalTunnelTestSource()}
	n = physicalTunnelNetwork(t, owned, owned, true)
	owned.before = func() { n.InterfaceUpdated(context.Background()) }
	if n.BindPhysicalTunnelFile(context.Background(), "utun-owned", 301, file) == nil {
		t.Fatal("late file-control completion acknowledged a retired native generation")
	}
}

// Both real native owner adapters must finish admission and acknowledgement
// under the original operation. The source is the explicit kernel boundary;
// it cannot release a held owner mutex on behalf of an expired caller.
func TestRouterVPNPhysicalTunnelOriginalMutationContext(t *testing.T) {
	for _, family := range []string{"tor", "external"} {
		for _, phase := range []string{"admission", "acknowledgement", "native-failure"} {
			for _, retire := range []bool{false, true} {
				name := family + "/" + phase + "/bind"
				if retire {
					name = family + "/" + phase + "/retire"
				}
				t.Run(name, func(t *testing.T) {
					source := physicalTunnelTestSource()
					var mutex *sync.Mutex
					var lifetime context.Context
					var change func(context.Context) error
					if family == "tor" {
						n := physicalTunnelNetwork(t, source, source, true)
						t.Cleanup(func() { _ = n.Close() })
						mutex, lifetime = &n.mu, n.ctx
						change = func(ctx context.Context) error { return n.changePhysicalTunnel(ctx, "exact-tun", 77, retire) }
					} else {
						policy := externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, runtime.GOOS)
						f := newExternalPhysicalFixture(t, policy)
						n := f.network
						if err := n.PrepareExternalPhysicalBroker(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
							broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observe context.Context) error {
								return n.MatchesContext(observe, capture.SessionID, capture.SourceSHA256)
							})
							return broker, source, err
						}); err != nil {
							t.Fatal(err)
						}
						for _, stage := range []adapter.StartStage{adapter.StartStateInitialize, adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
							if err := n.Start(stage); err != nil {
								t.Fatal(err)
							}
						}
						if _, err := n.Activate(policy); err != nil {
							t.Fatal(err)
						}
						t.Cleanup(func() { _ = n.Close() })
						mutex, lifetime = &n.mu, n.ctx
						change = func(ctx context.Context) error { return n.changePhysicalTunnel(ctx, "exact-tun", 77, nil, retire) }
					}
					var ctx context.Context
					var cancel context.CancelFunc
					entered, release := make(chan struct{}), make(chan struct{})
					if phase == "admission" {
						ctx, cancel = context.WithTimeout(context.Background(), 20*time.Millisecond)
						mutex.Lock()
					} else {
						ctx, cancel = context.WithCancel(context.Background())
						source.before = func() { mutex.Lock(); close(entered); <-release }
					}
					defer cancel()
					failure := errors.New("original native tunnel policy failure")
					if phase == "native-failure" {
						source.err = failure
					}
					done := make(chan error, 1)
					go func() { done <- change(ctx) }()
					if phase != "admission" {
						select {
						case <-entered:
						case err := <-done:
							t.Fatal("native policy was not reached", err)
						case <-time.After(time.Second):
							t.Fatal("native policy was not reached")
						}
						cancel()
						close(release)
					}
					var result error
					select {
					case result = <-done:
						mutex.Unlock()
					case <-time.After(time.Second):
						mutex.Unlock()
						<-done
						t.Fatal("expired mutation waited for the held original owner")
					}
					want := error(context.Canceled)
					if phase == "admission" {
						want = context.DeadlineExceeded
					}
					if !errors.Is(result, want) {
						t.Fatal("mutation lost its original context error", result)
					}
					if phase == "native-failure" {
						if !errors.Is(result, failure) || mobiletor.ObservationContextOnly(result) {
							t.Fatal("native failure was laundered into cancellation", result)
						}
					} else if !mobiletor.ObservationContextOnly(result) {
						t.Fatal("pure expiry gained a fabricated policy failure", result)
					}
					if lifetime.Err() != nil {
						t.Fatal("pure operation expiry retired the connection owner")
					}
					source.mu.Lock()
					calls := len(source.calls)
					source.mu.Unlock()
					if phase == "admission" && calls != 0 || phase != "admission" && calls != 1 {
						t.Fatal("expired mutation changed native policy admission", calls)
					}
				})
			}
		}
	}
}
