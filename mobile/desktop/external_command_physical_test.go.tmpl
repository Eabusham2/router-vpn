func desktopExternalPhysicalTransportCommand(t *testing.T, protocol, variant string) {
	t.Helper()
	var graph, captured map[string]any
	if json.Unmarshal([]byte(desktopPhysicalCommandSource), &graph) != nil || json.Unmarshal([]byte(desktopPhysicalCommandCapture), &captured) != nil {
		t.Fatal("invalid original command fixture")
	}
	key := func(value byte) string { return base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{value}, 32)) }
	captured["protocol"] = protocol
	private := map[string]any{"protocol": protocol, "expected_public_ip": "203.0.113.88"}
	faults := []string{"valid", "source", "credential", "tls-name", "session", "original-config"}
	var parameters map[string]string
	if protocol == "socks5" {
		graph["outbounds"] = []any{map[string]any{"type": "socks", "tag": mobilemultihop.ExternalFinalTag,
			"server": "203.0.113.20", "server_port": 1080, "version": "5", "username": "captured-user", "password": "captured-secret"}}
		private["socks5"] = map[string]any{"host": "203.0.113.20", "port": 1080, "username": "captured-user", "password": "captured-secret"}
		faults = []string{"valid", "source", "credential", "username", "endpoint", "socks-version", "socks-native-root", "session", "original-config"}
	} else if protocol == "openvpn" {
		primary, fallback := variant, variant
		if variant == "mixed" {
			primary, fallback = "tcp", "udp"
		}
		config := "client\ndev tun\nproto " + primary + "\nremote 203.0.113.20 8443 " + primary + "\nremote 198.51.100.25 1195 " + fallback + "\n" +
			"auth-user-pass\nremote-cert-tls server\nverify-x509-name captured-openvpn.example name\npeer-fingerprint " + strings.Repeat("ab", 32) +
			"\ntun-mtu 1280\ndata-ciphers AES-256-GCM:AES-128-GCM\n"
		endpoint, err := nativeopenvpn.CompileEndpoint(config, "captured-user", "captured-secret", mobilemultihop.ExternalFinalTag, "")
		var compiled map[string]any
		if err != nil || json.Unmarshal([]byte(endpoint), &compiled) != nil {
			t.Fatal("OpenVPN command fixture lost its actual inline compiler", err)
		}
		graph["outbounds"], graph["endpoints"] = []any{}, []any{compiled}
		private["openvpn"] = map[string]any{"config": config, "username": "captured-user", "password": "captured-secret"}
		faults = []string{"valid", "source", "credential", "username", "endpoint", "tls-name", "fingerprint", "remote-order", "remote-network", "remote-removed", "session", "original-config"}
	} else if protocol == "wireguard" || protocol == "amneziawg" {
		graph["outbounds"] = []any{}
		endpoint := map[string]any{"type": "wireguard", "tag": mobilemultihop.ExternalFinalTag,
			"address": []string{"10.78.0.2/32", "fd78:78::2/128"}, "private_key": key(17), "mtu": 1280,
			"peers": []any{map[string]any{"address": "203.0.113.20", "port": 8443, "public_key": key(18), "pre_shared_key": key(19),
				"allowed_ips": []string{"0.0.0.0/0", "::/0"}, "persistent_keepalive_interval": 25}}}
		settings := map[string]any{"endpoint": "203.0.113.20:8443", "private_key": key(17),
			"addresses": []string{"10.78.0.2/32", "fd78:78::2/128"}, "peer_public_key": key(18), "preshared_key": key(19), "mtu": 1280,
			"allowed_ips": []string{"0.0.0.0/0", "::/0"}, "persistent_keepalive_interval": 25}
		faults = []string{"valid", "source", "credential", "peer-key", "psk", "endpoint", "allowed-ips", "session", "original-config"}
		if protocol == "amneziawg" {
			parameters = map[string]string{"jc": "3", "jmin": "40", "jmax": "900", "s1": "56", "s2": "48", "s3": "24", "s4": "32",
				"h1": "10000000-19999999", "h2": "20000000-29999999", "h3": "30000000-39999999", "h4": "40000000-49999999"}
			if variant == "fast" {
				parameters["jc"], parameters["jmin"], parameters["jmax"], parameters["s4"] = "0", "20", "40", "8"
			}
			endpoint["type"], endpoint["amnezia"], settings["parameters"] = mobilemultihop.AmneziaType, parameters, parameters
			for _, parameter := range []string{"jc", "jmin", "jmax", "s1", "s2", "s3", "s4", "h1", "h2", "h3", "h4"} {
				faults = append(faults, "parameter/"+parameter)
			}
		}
		graph["endpoints"], private[protocol] = []any{endpoint}, settings
	} else {
		graph["outbounds"] = []any{map[string]any{"type": "hysteria2", "tag": mobilemultihop.ExternalFinalTag,
			"server": "203.0.113.20", "server_port": 8443, "password": "captured-secret",
			"tls": map[string]any{"enabled": true, "server_name": "captured-hy2.example"}}}
		private["hysteria2"] = map[string]any{"server": "203.0.113.20", "port": 8443, "password": "captured-secret", "tls_server_name": "captured-hy2.example"}
	}
	captured["profile"].(map[string]any)["external"] = private
	rawSource, _ := json.Marshal(graph)
	rawCapture, _ := json.Marshal(captured)
	source, capture := string(rawSource), string(rawCapture)
	original, err := mobilemultihop.NewExternalPolicy(source, capture)
	if err != nil {
		t.Fatal(err)
	}
	physical, err := mobilemultihop.NewDesktopExternalPolicy(original, desktopExternalSession, "linux")
	if err != nil {
		t.Fatal(err)
	}
	for _, fault := range faults {
		t.Run(fault, func(t *testing.T) {
			directory := t.TempDir()
			if err := os.Chmod(directory, 0700); err != nil {
				t.Fatal(err)
			}
			config, expected, session := physical.Config(), physical.Metadata().SourceSHA256, desktopExternalSession
			switch fault {
			case "source":
				expected = strings.Repeat("f", 64)
			case "credential":
				if protocol == "wireguard" || protocol == "amneziawg" {
					config = strings.Replace(config, key(17), key(20), 1)
				} else {
					config = strings.Replace(config, "captured-secret", "foreign-secret", 1)
				}
			case "username":
				config = strings.Replace(config, "captured-user", "foreign-user", 1)
			case "socks-version":
				config = strings.Replace(config, `"version":"5"`, `"version":"4"`, 1)
			case "socks-native-root":
				config = strings.Replace(config, mobilemultihop.DesktopExternalSOCKSType, "socks", 1)
			case "peer-key":
				config = strings.Replace(config, key(18), key(20), 1)
			case "psk":
				config = strings.Replace(config, key(19), key(20), 1)
			case "endpoint":
				config = strings.Replace(config, "203.0.113.20", "203.0.113.21", 1)
			case "allowed-ips":
				config = strings.Replace(config, "0.0.0.0/0", "192.0.2.0/24", 1)
			case "tls-name":
				if protocol == "openvpn" {
					config = strings.Replace(config, "captured-openvpn.example", "foreign-openvpn.example", 1)
				} else {
					config = strings.Replace(config, "captured-hy2.example", "foreign-hy2.example", 1)
				}
			case "fingerprint":
				config = strings.Replace(config, strings.Repeat("ab", 32), strings.Repeat("cd", 32), 1)
			case "remote-order", "remote-network", "remote-removed":
				var changed map[string]any
				if json.Unmarshal([]byte(config), &changed) != nil {
					t.Fatal("invalid compiled OpenVPN mutation fixture")
				}
				endpoint := changed["endpoints"].([]any)[0].(map[string]any)
				remotes := endpoint["servers"].([]any)
				switch fault {
				case "remote-order":
					remotes[0], remotes[1] = remotes[1], remotes[0]
					endpoint["network"] = remotes[0].(map[string]any)["network"]
				case "remote-network":
					remote := remotes[1].(map[string]any)
					if remote["network"] == "tcp" {
						remote["network"] = "udp"
					} else {
						remote["network"] = "tcp"
					}
				case "remote-removed":
					endpoint["servers"] = remotes[:1]
				}
				body, err := json.Marshal(changed)
				if err != nil {
					t.Fatal(err)
				}
				config = string(body)
			case "session":
				session = strings.Repeat("b", 32)
			case "original-config":
				config = original.Config()
			default:
				if parameter, ok := strings.CutPrefix(fault, "parameter/"); ok {
					value, exists := parameters[parameter]
					if !exists {
						t.Fatal("unknown captured Amnezia parameter control")
					}
					changed := "50000000-59999999"
					if !strings.HasPrefix(parameter, "h") {
						number, err := strconv.Atoi(value)
						if err != nil {
							t.Fatal(err)
						}
						changed = strconv.Itoa(number + 1)
					}
					config = strings.Replace(config, `"`+parameter+`":"`+value+`"`, `"`+parameter+`":"`+changed+`"`, 1)
				}
			}
			if fault != "valid" && fault != "source" && fault != "session" && config == physical.Config() {
				t.Fatal("physical command negative did not alter its captured source", protocol, fault)
			}
			if err := os.WriteFile(filepath.Join(directory, "sing-box.json"), []byte(config), 0600); err != nil {
				t.Fatal(err)
			}
			files, err := routerVPNOpenExternalFiles(directory)
			if err != nil {
				t.Fatal(err)
			}
			defer files.root.Close()
			selected, err := routerVPNExternalCommandPhysical(files, original, session, expected)
			if runtime.GOOS != "linux" || fault != "valid" {
				if err == nil || selected != nil {
					t.Fatal("foreign host or changed transport source reached native command admission", protocol)
				}
				return
			}
			if err != nil || selected == nil || selected.Metadata() != physical.Metadata() || selected.OriginalPolicy() != original {
				t.Fatal("Linux command lost its exact transport policy", protocol, err)
			}
		})
	}
	if runtime.GOOS != "linux" {
		return
	}
	registry := include.InboundRegistry()
	inbound.Register[option.TunInboundOptions](registry, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
		return &desktopExternalTUN{inbound.NewAdapter(C.TypeTun, tag)}, nil
	})
	ctx := box.Context(context.Background(), registry, include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
	owner, err := routerVPNNewExternalNative(ctx, original, physical, source, capture, desktopExternalSession)
	if err != nil || owner == nil {
		t.Fatal("actual Linux transport factory failed before startup", protocol, err)
	}
	defer func() {
		owner.Cancel()
		if err := owner.Close(); err != nil {
			t.Error("actual transport native construction did not join", protocol, err)
		}
	}()
	native := owner.(*routerVPNExternalNative)
	if native.physical != physical || native.box == nil || native.Healthy() || native.box.RouterVPNDesktopExternalPreparePhysical(physical) == nil {
		t.Fatal("transport native factory lost physical preparation or fabricated connection proof", protocol)
	}
}
