// Actual Box, native manager transaction, paused continuation and source are
// retained. TUN readers and the physical confirmation callback are explicit
// component boundaries; no PF/utun or native network acceptance is claimed.

func TestRouterVPNDesktopCONNECTDarwinMTUContinuation(t *testing.T) {
	for _, scenario := range []string{"renamed", "same-alias", "unchanged", "rollback", "foreign-before", "foreign-result", "same-index", "unjoined", "receipt-replaced", "physical-refused", "source-changed", "cancelled", "late-cancel"} {
		t.Run(scenario, func(t *testing.T) {
			f := newCONNECTMTUFixture(t)
			ctx, _, m := connectMTUBegin(t, f)
			candidate, rollback := connectMTUNewReader("utun72", 73, 1300), connectMTUNewReader("utun74", 74, 1280)
			if scenario == "same-alias" {
				candidate.name = f.tun.name
			}
			candidate.startFailure.Store(scenario == "rollback")
			target := 1300
			if scenario == "unchanged" {
				target = 1280
			}
			count := 0
			next, changeErr := m.changeContext(ctx, f.tun, target, connectMTUAcquire(f, candidate, rollback, &count))
			if changeErr != nil && scenario != "rollback" {
				t.Fatal(changeErr)
			}
			if next == nil || m.step == nil || !m.step.joined {
				t.Fatal("fixture lost actual joined native transition")
			}
			actual := m.step.result
			old := m.step.before
			previous := adapter.Inbound(f.tun)
			name, index, mtu := actual.name, actual.index, actual.mtu
			call, cancel := context.WithCancel(ctx)
			defer cancel()
			physicalCalls := 0
			physical := func() error {
				physicalCalls++
				switch scenario {
				case "receipt-replaced":
					copy := *m.step
					m.step = &copy
				case "physical-refused":
					return errors.New("original physical readback refused")
				case "source-changed":
					f.current.Store(false)
				case "late-cancel":
					cancel()
				}
				return call.Err()
			}
			switch scenario {
			case "foreign-before":
				previous = rollback
			case "foreign-result":
				next = rollback
			case "same-index":
				actual.index = old.index
				next.(*connectMTUReader).index = old.index
				index = old.index
			case "unjoined":
				m.step.joined = false
			case "cancelled":
				cancel()
			}
			err := m.confirmDarwinMTUReader(call, previous, next, old.name, old.index, old.mtu, name, index, mtu, physical)
			good := scenario == "renamed" || scenario == "same-alias" || scenario == "unchanged" || scenario == "rollback"
			if (err == nil) != good {
				t.Fatal("typed original continuation verdict changed", scenario, err)
			}
			if good && physicalCalls != 1 {
				t.Fatal("original physical confirmation omitted")
			}
			if m.phase.Load() != routerVPNCONNECTMTUPaused {
				t.Fatal("confirmation resumed traffic or proof")
			}
		})
	}
}

