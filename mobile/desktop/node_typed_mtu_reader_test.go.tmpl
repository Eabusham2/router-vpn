func TestRouterVPNDesktopExecutionDarwinMTUContinuation(t *testing.T) {
	for _, selected := range []string{"local", "server"} {
		t.Run(selected, func(t *testing.T) {
			for _, scenario := range []string{"renamed", "same-alias", "unchanged", "rollback", "foreign-before", "foreign-result", "same-index", "unjoined", "receipt-replaced", "physical-refused", "source-changed", "cancelled", "late-cancel", "foreign-operation", "cleanup-unchanged"} {
				t.Run(scenario, func(t *testing.T) {
					mode := selected
					if mode == "local" {
						mode = "auto"
					}
					f := newExecutionNativeFixture(t, mode, nil)
					p := f.adopt(t)
					e := f.engine
					capture, err := p.DNSCapture(selected)
					if err != nil {
						t.Fatal(err)
					}
					if err := e.SelectContext(t.Context(), capture.SelectedTag); err != nil {
						t.Fatal(err)
					}
					for _, stage := range adapter.ListStartStages {
						if err := f.box.inbound.Start(stage); err != nil {
							t.Fatal(err)
						}
					}
					binding := executionMTUBinding(t, f, p)
					before := e.reader.Load()
					candidate, rollback := executionMTUReader(), executionMTUReader()
					candidate.failStart.Store(scenario == "rollback")
					workParent, cancelWork := context.WithCancel(t.Context())
					defer cancelWork()
					work, finish, workErr := mobilemtu.WithOperationContext(workParent, 5*time.Second, 3*time.Second)
					if workErr != nil {
						t.Fatal(workErr)
					}
					defer finish()
					name := "utun72"
					if scenario == "same-alias" {
						name = "utun71"
					}
					records := map[adapter.Inbound]routerVPNExecutionMTUReadback{before.inbound: {"utun71", 71, 1400}, candidate: {name, 72, 1300}, rollback: {"utun73", 73, 1400}}
					read := func(ctx context.Context, r adapter.Inbound) (routerVPNExecutionMTUReadback, error) {
						v, ok := records[r]
						if !ok {
							return v, errRouterVPNExecutionOwner
						}
						return v, ctx.Err()
					}
					acquire := func(ctx context.Context, r adapter.Inbound, value int) (*inbound.RouterVPNTunTransaction, error) {
						return f.box.inbound.RouterVPNReplaceTunOwned(ctx, r, func() (adapter.Inbound, adapter.Inbound, error) { return candidate, rollback, nil })
					}
					value := 1300
					if scenario == "unchanged" || scenario == "cleanup-unchanged" {
						value = 1400
					}
					next, changeErr := e.changeExecutionMTUContext(work, binding, before.inbound, value, acquire, read)
					if changeErr != nil && scenario != "rollback" {
						t.Fatal(changeErr)
					}
					transition := e.mtu.Load()
					if transition == nil || !transition.joined {
						t.Fatal("fixture lost actual native transaction")
					}
					old, actual := transition.original, transition.observed
					previous := before.inbound
					call, cancel := context.WithCancel(work)
					defer cancel()
					if scenario == "foreign-operation" {
						fresh, finishFresh, freshErr := mobilemtu.WithOperationContext(t.Context(), 5*time.Second, 3*time.Second)
						if freshErr != nil {
							t.Fatal(freshErr)
						}
						defer finishFresh()
						call = fresh
					}
					if scenario == "cleanup-unchanged" {
						cancelWork()
						if work.Err() == nil {
							t.Fatal("cleanup fixture failed to cancel original work")
						}
						cleanup, cleanupErr := mobilemtu.OperationCleanupContext(work)
						if cleanupErr != nil {
							t.Fatal(cleanupErr)
						}
						call = cleanup
					}
					physicalCalls := 0
					physical := func() error {
						physicalCalls++
						switch scenario {
						case "receipt-replaced":
							copy := *e.mtu.Load()
							e.mtu.Store(&copy)
						case "physical-refused":
							return errors.New("original physical readback refused")
						case "source-changed":
							e.revoked.Store(false)
						case "late-cancel":
							cancel()
						}
						return call.Err()
					}
					switch scenario {
					case "foreign-before":
						previous = rollback
					case "foreign-result":
						next = rollback
					case "same-index":
						actual.index = old.index
						transition.observed = actual
						records[next] = actual
					case "unjoined":
						transition.joined = false
					case "cancelled":
						cancel()
					}
					err = e.confirmDarwinMTUReader(call, binding, previous, next, old.name, old.index, old.mtu, actual.name, actual.index, actual.mtu, read, physical)
					good := scenario == "renamed" || scenario == "same-alias" || scenario == "unchanged" || scenario == "rollback" || scenario == "cleanup-unchanged"
					if (err == nil) != good {
						t.Fatal("execution original continuation verdict changed", scenario, err)
					}
					if good && physicalCalls != 1 {
						t.Fatal("original execution physical confirmation omitted")
					}
					if e.mtu.Load().admitted {
						t.Fatal("confirmation admitted execution without full proof")
					}
				})
			}
		})
	}
}
