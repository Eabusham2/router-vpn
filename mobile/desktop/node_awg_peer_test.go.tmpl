func TestRouterVPNDesktopNodeAmneziaLayers(t *testing.T) {
	for _, mode := range []string{"awg2-fast", "awg2-strong"} {
		for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, fault := range []string{"proved", "wrong-peer", "wrong-psk", "wrong-header", "wrong-padding", "wrong-aes", "wrong-whitening"} {
				if fault == "wrong-whitening" && layer != "aes-256-gcm+xor-whitening" {
					continue
				}
				t.Run(mode+"/"+layer+"/"+fault, func(t *testing.T) {
					peer := desktopNodeAWGReferenceWithOptions(t, mode, desktopNodeWGReferenceOptions{Layer: layer, WhiteningMismatch: fault == "wrong-whitening"})
					testDesktopNodeEncryptedUDP(t, peer, fault)
				})
			}
		}
	}
}

func TestRouterVPNDesktopNodeAmneziaLayerCapture(t *testing.T) {
	for _, mode := range []string{"awg2-fast", "awg2-strong"} {
		for _, fault := range []string{"captured", "whitening", "whitening-negative", "wrong-node", "wrong-client", "foreign-relay", "loopback-relay",
			"plain-layer", "unknown-layer", "whitening-on-aes", "short-aes", "same-psk", "same-private-key", "self-peer", "private-alias-self-peer",
			"wrong-mode", "missing", "extra", "overlap", "wg-header", "noncanonical-key"} {
			t.Run(mode+"/"+fault, func(t *testing.T) {
				config, options := desktopReferenceFixture(t)
				if mode == "awg2-strong" {
					config.Parameters["jc"], config.Parameters["jmax"] = "8", "1200"
				}
				digest := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + options.Peers[0].PublicKey))
				request := desktopNodeAWGLayerRequest{desktopNodeAWGRequest: desktopNodeAWGRequest{desktopNodeWGRequest: desktopNodeWGRequest{
					Schema: 1, Address: "192.168.210.2", ClientAddress: "192.168.210.1", PrivateKey: config.PrivateKey, ClientPublicKey: config.Peers[0].PublicKey,
					PreSharedKey: config.Peers[0].PreSharedKey, NodeProofID: hex.EncodeToString(digest[:])}, Mode: mode, Parameters: config.Parameters},
					Layer: "aes-256-gcm", AESPassword: base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x72}, 32)), RelaySource: "192.168.210.2"}
				switch fault {
				case "whitening":
					request.Layer = "aes-256-gcm+xor-whitening"
				case "whitening-negative":
					request.Layer, request.WhiteningMismatch = "aes-256-gcm+xor-whitening", true
				case "wrong-node":
					request.NodeProofID = strings.Repeat("f", 64)
				case "wrong-client":
					request.ClientAddress = "192.168.211.1"
				case "foreign-relay":
					request.RelaySource = request.ClientAddress
				case "loopback-relay":
					request.RelaySource = "127.0.0.1"
				case "plain-layer":
					request.Layer = "off"
				case "unknown-layer":
					request.Layer = "aes-256-gcm-xor"
				case "whitening-on-aes":
					request.WhiteningMismatch = true
				case "short-aes":
					request.AESPassword = base64.StdEncoding.EncodeToString([]byte("short"))
				case "same-psk":
					request.AESPassword = request.PreSharedKey
				case "same-private-key":
					request.AESPassword = request.PrivateKey
				case "self-peer":
					request.ClientPublicKey = options.Peers[0].PublicKey
				case "private-alias-self-peer":
					raw, err := base64.StdEncoding.Strict().DecodeString(request.PrivateKey)
					if err != nil || len(raw) != 32 {
						t.Fatal(err)
					}
					raw[0] ^= 1 // X25519 clamps this bit; canonical public identity is unchanged.
					request.PrivateKey, request.ClientPublicKey = base64.StdEncoding.EncodeToString(raw), options.Peers[0].PublicKey
					clear(raw)
				case "wrong-mode":
					request.Mode = "wg"
				case "missing":
					delete(request.Parameters, "s4")
				case "extra":
					request.Parameters["i1"] = "<b 0x01>"
				case "overlap":
					request.Parameters["h2"] = request.Parameters["h1"]
				case "wg-header":
					request.Parameters["h1"] = "1"
				case "noncanonical-key":
					request.PrivateKey = base64.RawStdEncoding.EncodeToString(bytes.Repeat([]byte{1}, 32))
				}
				allowed := fault == "captured" || fault == "whitening" || fault == "whitening-negative"
				local, remote, ipc, capture, err := desktopNodeAWGLayerIdentity(request)
				if (err == nil) != allowed || (capture != nil) != allowed {
					t.Fatal("layered AWG admitted a foreign source, parameters, canonical identity or layer owner", err)
				}
				if !allowed {
					return
				}
				parameters, parameterErr := awgpolicy.ParametersUAPI(config.Parameters)
				if parameterErr != nil || local.String() != request.Address || remote.String() != request.ClientAddress ||
					capture.physicalClient != remote || capture.relaySource != local || capture.request != request.desktopNodeWGRequest ||
					!strings.Contains(ipc, "\n"+parameters+"public_key=") || len(request.Parameters) != 11 {
					t.Fatal("layered AWG lost its complete exact native configuration or independent source", parameterErr)
				}
				raw, err := json.Marshal(request)
				if err != nil {
					t.Fatal(err)
				}
				var plain desktopNodeAWGRequest
				decoder := json.NewDecoder(bytes.NewReader(raw))
				decoder.DisallowUnknownFields()
				if decoder.Decode(&plain) == nil {
					t.Fatal("plain AWG reference accepted layered peer input")
				}
			})
		}
	}
}

func TestRouterVPNDesktopNodeAmneziaLayerCover(t *testing.T) {
	for _, mode := range []string{"awg2-fast", "awg2-strong"} {
		for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, fault := range []string{"owned", "wrong-node", "drop-cover"} {
				t.Run(mode+"/"+layer+"/"+fault, func(t *testing.T) {
					peer := desktopNodeAWGReferenceWithOptions(t, mode, desktopNodeWGReferenceOptions{Layer: layer, Cover: true})
					f := newDesktopNodeLayerFixture(t, peer, "")
					if err := f.box.RouterVPNStrategyStart(); err != nil {
						t.Fatal(err)
					}
					var cover *routervpnperformance.Service
					for _, service := range f.box.RouterVPNServices() {
						if actual, ok := service.(*routervpnperformance.Service); ok {
							if cover != nil {
								t.Fatal("multiple cover workers")
							}
							cover = actual
						}
					}
					if cover == nil || cover.Healthy() || peer.observe(t, "stats").CoverPackets != 0 {
						t.Fatal("AWG layer started cover before its actual private-node proof")
					}
					if err := f.box.RouterVPNStrategyDNSProof(); err != nil {
						t.Fatal(err)
					}
					if fault != "owned" {
						peer.observe(t, fault)
					}
					err := cover.Activate()
					observed := peer.observe(t, "stats")
					if (err == nil) != (fault == "owned") || cover.Healthy() != (fault == "owned") || observed.RouterQueries == 0 || observed.DirectQueries != 0 || observed.DNSQueries != 1 || observed.RawTCP != 0 || observed.RawUDP == 0 || observed.ProtocolRawUDP == 0 || observed.ProtocolTCP == 0 || f.network.Current() {
						t.Fatal("AWG cover changed its exact final protocol or source proof", err, observed)
					}
					if fault == "wrong-node" {
						if observed.CoverPackets != 0 {
							t.Fatal("wrong AWG node started cover")
						}
					} else if observed.CoverPackets == 0 || observed.CoverBytes < 128 || observed.CoverMaximum > 1200 || (observed.CoverReplies > 0) != (fault == "owned") {
						t.Fatal("cover did not reach the final AWG peer", observed)
					}
					if err := cover.Close(); err != nil || cover.Healthy() {
						t.Fatal("AWG layered worker did not retire", err)
					}
					f.source.Cancel()
					if err := f.close(); err != nil || !f.source.closed.Load() {
						t.Fatal("AWG layer retained its old cover/socket source", err)
					}
				})
			}
		}
	}
}

func TestRouterVPNDesktopNodeAmneziaOuterCannotBypassFinal(t *testing.T) {
	for _, mode := range []string{"awg2-fast", "awg2-strong"} {
		for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			t.Run(mode+"/"+layer, func(t *testing.T) {
				peer := desktopNodeAWGReferenceWithOptions(t, mode, desktopNodeWGReferenceOptions{Layer: layer})
				f := newDesktopNodeLayerFixture(t, peer, "")
				if err := f.box.RouterVPNStrategyStart(); err != nil {
					t.Fatal(err)
				}
				// AWG eagerly handshakes at startup. Establish a real inner flow
				// first so its handshake cannot masquerade as this negative's
				// outer-only packet receipt; final payload/DNS counts must stay
				// unchanged while the forbidden direct DNS request is sent.
				if err := f.exchange("udp"); err != nil {
					t.Fatal("AWG outer control lost its real encrypted positive path", err)
				}
				before := peer.observe(t, "stats")
				outer, found := f.box.Outbound().Outbound(mobilemultihop.NativeStartLayerTag)
				if !found {
					t.Fatal("missing captured AWG outer AES transport")
				}
				ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
				defer cancel()
				connection, err := outer.DialContext(ctx, "tcp", M.ParseSocksaddr(desktopNodeRouterHealthTarget))
				if connection != nil {
					_ = connection.Close()
				}
				if err == nil {
					t.Fatal("AWG outer acquired an uncaptured physical TCP grant")
				}
				target := M.ParseSocksaddr("192.168.50.133:53")
				packet, err := outer.ListenPacket(ctx, target)
				if err != nil {
					t.Fatal("AWG outer negative missed its actual owned UDP transport", err)
				}
				_ = packet.SetDeadline(time.Now().Add(350 * time.Millisecond))
				query := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
				raw, err := query.Pack()
				if err != nil {
					_ = packet.Close()
					t.Fatal(err)
				}
				n, writeErr := packet.WriteTo(raw, target)
				answer := make([]byte, 512)
				_, _, readErr := packet.ReadFrom(answer)
				_ = packet.Close()
				observed := peer.observe(t, "stats")
				if writeErr != nil || n != len(raw) || readErr == nil || observed.RawTCP != 0 || observed.RawUDP <= before.RawUDP || observed.RejectedUDP != before.RejectedUDP+1 ||
					observed.ProtocolTCP != before.ProtocolTCP || observed.ProtocolUDP != before.ProtocolUDP || observed.RouterQueries != 0 || observed.DNSQueries != 0 {
					t.Fatal("AWG outer AES bypassed its sole captured inner UDP route", writeErr, readErr, observed)
				}
				if err := f.exchange("tcp"); err != nil || f.box.RouterVPNStrategyDNSProof() != nil {
					t.Fatal("outer rejection concealed an unavailable final AWG path", err)
				}
				observed = peer.observe(t, "stats")
				if observed.ProtocolRawUDP == 0 || observed.ProtocolTCP == 0 || observed.ProtocolUDP == 0 || observed.DNSQueries != 1 || f.network.Current() {
					t.Fatal("final AWG DNS positive control skipped its encrypted peer", observed)
				}
			})
		}
	}
}
