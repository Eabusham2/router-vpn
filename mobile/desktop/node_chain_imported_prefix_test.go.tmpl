// Actual encrypted transports and selected DNS, with component engine/session
// identity and private test TLS trust. This does not report installed TUN/PF
// acceptance. SS imports never borrow an OpenVPN endpoint or CONNECT UoT owner.
type nodeChainImportedSSPrefixFixture struct {
	chain              *mobilemultihop.NodeChain
	peer               *desktopNodeChainImportedPeer
	complete           *desktopNodeChainPeer
	request            desktopNodeChainPeerRequest
	ctx                context.Context
	cancel             context.CancelFunc
	engine             *nodeChainImportedSSPrefixComponent
	closeNative        func() error
	closed             bool
	testTLS            *tls.Config
	measuring          atomic.Bool
	acquired, released atomic.Int32
	queries            atomic.Uint64
	form               string
}
type nodeChainImportedSSPrefixComponent struct {
	chain    *mobilemultihop.NodeChain
	identity mobilemultihop.NodeChainIdentity
	owners   map[string]adapter.Outbound
	resolver adapter.DNSTransport
	closed   atomic.Bool
	mu       sync.Mutex
	selected string
}

var _ mobilemultihop.NodeChainEngine = (*nodeChainImportedSSPrefixComponent)(nil)

func (e *nodeChainImportedSSPrefixComponent) ObserveChainContext(ctx context.Context) (mobilemultihop.NodeChainIdentity, error) {
	if ctx == nil || ctx.Err() != nil || e.closed.Load() {
		return mobilemultihop.NodeChainIdentity{}, errors.New("original component owner retired")
	}
	return e.identity, nil
}
func (e *nodeChainImportedSSPrefixComponent) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return nil, err
	}
	out := e.owners[tag]
	if out == nil {
		return nil, errors.New("foreign ordered component prefix")
	}
	return out.DialContext(ctx, "tcp", M.ParseSocksaddr(address))
}
func (e *nodeChainImportedSSPrefixComponent) SelectContext(ctx context.Context, tag string) error {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return err
	}
	if tag != e.chain.FinalTag() {
		return errors.New("foreign selected final")
	}
	e.mu.Lock()
	defer e.mu.Unlock()
	e.selected = tag
	return nil
}
func (e *nodeChainImportedSSPrefixComponent) SelectedContext(ctx context.Context) (string, error) {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return "", err
	}
	e.mu.Lock()
	defer e.mu.Unlock()
	return e.selected, nil
}
func (e *nodeChainImportedSSPrefixComponent) DNSProofContext(ctx context.Context, capture mobilemultihop.NodeChainDNSCapture) error {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return err
	}
	if capture != e.chain.DNSCapture() || e.resolver == nil {
		return errors.New("foreign original resolver")
	}
	q := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
	r, err := e.resolver.Exchange(ctx, q)
	if err != nil {
		return err
	}
	if r == nil || r.Id != q.Id || r.Rcode != dns.RcodeSuccess || len(r.Answer) != 1 {
		return errors.New("selected final DNS did not answer")
	}
	a, ok := r.Answer[0].(*dns.A)
	if !ok || a.Hdr.Name != "example.com." || !a.A.Equal(net.ParseIP("93.184.216.34")) {
		return errors.New("selected final DNS answer changed")
	}
	return ctx.Err()
}
func desktopNodeChainImportedSSPairedPrefixSource(t *testing.T, r desktopNodeChainPeerRequest, clients []string, physical, finalIdentity string) mobilemultihop.NodeChainSource {
	t.Helper()
	base := desktopNodeChainPeerSource(t, r, clients, physical)
	launch, err := base.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(launch), &source) != nil || len(source.Nodes) != len(r.Prefixes)+1 {
		t.Fatal("original complete packet source absent")
	}
	identities := make([]string, len(r.Prefixes)+2)
	for i, prefix := range r.Prefixes {
		private, _ := base64.StdEncoding.DecodeString(prefix.PrivateKey)
		server, err := ecdh.X25519().NewPrivateKey(private)
		clear(private)
		if err != nil {
			t.Fatal(err)
		}
		_, client := desktopNodeChainInner(i, len(r.Prefixes))
		target := desktopNodeChainNext(i)
		if i == 0 {
			target = physical
		}
		text := fmt.Sprintf("[Interface]\nAddress=%s/32,fd78:78::2/128\nPrivateKey=%s\nDNS=192.168.50.133\nMTU=2000\n[Peer]\nPublicKey=%s\nPresharedKey=%s\nEndpoint=%s\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n", client, clients[i], base64.StdEncoding.EncodeToString(server.PublicKey().Bytes()), prefix.PreSharedKey, target)
		identities[i] = desktopNodeChainJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(text))})
	}
	count := len(r.Prefixes)
	identities[count+1] = finalIdentity
	source.IdentitySources = identities
	source.Nodes = append(source.Nodes[:count], "", source.Nodes[count])
	source.Schema = 2
	return source
}

// The old trio constructor remains byte-identical. Only this new helper inserts
// its original imported member into the full independently paired source.
func desktopNodeChainImportedSSPrefixSource(t *testing.T, r desktopNodeChainPeerRequest, clients []string, physical, method, password, finalIdentity string) *mobilemultihop.NodeChain {
	t.Helper()
	count := len(r.Prefixes)
	if count < 1 || count > 6 || len(clients) != count {
		t.Fatal("uncaptured SS prefix inventory")
	}
	if count == 1 {
		return desktopNodeChainImportedSource(t, r, clients, physical, method, password, finalIdentity)
	}
	tail := r
	tail.Prefixes = append([]desktopNodeChainPrefixRequest(nil), r.Prefixes[count-1:]...)
	trio := desktopNodeChainImportedSource(t, tail, clients[count-1:], physical, method, password, finalIdentity)
	launch, err := trio.LaunchInput()
	var old mobilemultihop.NodeChainSource
	if err != nil || json.Unmarshal([]byte(launch), &old) != nil {
		t.Fatal("original SS tail source absent", err)
	}
	source := desktopNodeChainImportedSSPairedPrefixSource(t, r, clients, physical, finalIdentity)
	source.Nodes[count] = old.Nodes[1]
	chain, err := mobilemultihop.NewNodeChain(desktopNodeChainJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	return chain
}

func desktopNodeChainImportedSSPrefixPeerStart(t *testing.T, request desktopNodeChainImportedRequest, local, remote netip.Addr) (*desktopNodeChainImportedPeer, *desktopNodeChainPeer) {
	return desktopNodeChainImportedSSPrefixPeerStartPrepared(t, request, local, remote, nil)
}

// Optional test-only allowlists are fixed before the original peer device starts.
// The callback retains the original handler and every captured provider key.
func desktopNodeChainImportedSSPrefixPeerStartPrepared(t *testing.T, request desktopNodeChainImportedRequest, local, remote netip.Addr, prepare func(int, *desktopNodeWGHandler), middleRoutes ...desktopNodeLayerRoute) (*desktopNodeChainImportedPeer, *desktopNodeChainPeer) {
	t.Helper()
	count := len(request.Paired.Prefixes)
	ipcs, err := desktopNodeChainPeerIdentityBounds(request.Paired, 1, 6)
	if err != nil {
		t.Fatal(err)
	}
	defer clear(ipcs)
	tail := request
	tail.Paired.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Paired.Prefixes[count-1:]...)
	var peer *desktopNodeChainImportedPeer
	if prepare == nil && len(middleRoutes) == 0 {
		peer = desktopNodeChainImportedPeerStart(t, tail, local, remote)
	} else {
		peer = desktopNodeChainImportedPeerStartWithHooks(t, tail, local, remote, nil, &desktopNodeChainImportedPeerHooks{
			decorate: func(handler *desktopNodeWGHandler) tun.Handler {
				if prepare != nil {
					prepare(count-1, handler)
				}
				return handler
			},
			middle: func(server *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
				server.routes = append(server.routes, middleRoutes...)
				return desktopStartSSProvider(t, server, request.MiddleMethod, request.MiddlePassword, netip.MustParseAddr("127.0.0.1"))
			},
		})
	}
	if count == 1 {
		return peer, nil
	}
	complete := &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, count), final: peer.paired}
	complete.prefixes[count-1] = peer.prefix
	if prepare == nil {
		desktopNodeChainStartCapturedPrefixes(t, request.Paired, local, remote, complete, ipcs, count-2)
	} else {
		desktopNodeChainStartCapturedPrefixRange(t, request.Paired, local, remote, complete, ipcs, count-2, 0, func(position int, handler *desktopNodeWGHandler) tun.Handler {
			prepare(position, handler)
			return handler
		})
	}
	return peer, complete
}

func nodeChainImportedSSPrefixStart(t *testing.T, mode, form, method, fault string, count int, budget time.Duration) *nodeChainImportedSSPrefixFixture {
	return nodeChainImportedSSPrefixStartPrepared(t, mode, form, method, fault, count, budget, nil)
}

func nodeChainImportedSSPrefixStartPrepared(t *testing.T, mode, form, method, fault string, count int, budget time.Duration, prepare func(int, *desktopNodeWGHandler), middleRoutes ...desktopNodeLayerRoute) *nodeChainImportedSSPrefixFixture {
	t.Helper()
	ctx, cancel := context.WithTimeout(pause.WithDefaultManager(context.Background()), budget)
	t.Cleanup(cancel)
	f := &nodeChainImportedSSPrefixFixture{ctx: ctx, cancel: cancel, form: form}
	request, clients := desktopNodeChainPeerFixture(t, count)
	modes := make([]string, count)
	for i := range modes {
		modes[i] = mode
	}
	desktopNodeChainSetModes(t, &request, modes)
	final, err := ecdh.X25519().GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	finalPublic := base64.StdEncoding.EncodeToString(final.PublicKey().Bytes())
	proof := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + finalPublic))
	request.FinalNodeProofID = hex.EncodeToString(proof[:])
	f.request = request
	finalWG := fmt.Sprintf("[Interface]\nAddress=10.77.0.2/32\nPrivateKey=%s\nMTU=1420\n[Peer]\nPublicKey=%s\nEndpoint=10.77.0.1:51820\nAllowedIPs=0.0.0.0/0,::/0\n", clients[0], finalPublic)
	identity := desktopNodeChainJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(finalWG))})
	size := 32
	if method == "2022-blake3-aes-128-gcm" {
		size = 16
	}
	password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, size))
	loopback := netip.MustParseAddr("127.0.0.1")
	f.peer, f.complete = desktopNodeChainImportedSSPrefixPeerStartPrepared(t, desktopNodeChainImportedRequest{1, request, method, password}, loopback, loopback, prepare, middleRoutes...)
	physical := f.peer.paired.bind.address()
	if f.complete != nil {
		physical = f.complete.prefixes[0].bind.address()
	}
	socket := netip.MustParseAddrPort(physical)
	f.chain = desktopNodeChainImportedSSPrefixSource(t, request, clients, net.JoinHostPort(request.Address, strconv.Itoa(int(socket.Port()))), method, password, identity)
	if form == "hostname" {
		f.installHostname(t, fault)
	} else if form != "literal" {
		t.Fatal("uncaptured SS address form")
	}
	mutate := func(position int, row map[string]any) {
		if fault == "wrong-intermediate-key" && position == count-1 {
			peers := row["peers"].([]any)
			peer := peers[0].(map[string]any)
			peer["pre_shared_key"] = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{93}, 32))
		}
		if fault == "omit-last-prefix" && position == count {
			row["detour"] = f.chain.PrefixTags()[count-2]
		}
		if fault == "wrong-middle-key" && position == count {
			row["password"] = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{94}, size))
		}
	}
	out, _, manager, closeNative := desktopImportedHostnameOwnersOwned(t, ctx, f.chain, physical, mutate)
	f.closeNative = closeNative
	engine := &nodeChainImportedSSPrefixComponent{chain: f.chain, owners: map[string]adapter.Outbound{}, identity: mobilemultihop.NodeChainIdentity{EngineID: "original-ss-prefix-component", SessionID: "original-imported-ss-prefix", NetworkID: "original-first-udp-tuple", SourceSHA256: f.chain.SourceSHA256(), ConfigSHA256: f.chain.ConfigSHA256()}}
	for i, tag := range f.chain.PrefixTags() {
		engine.owners[tag] = out[i]
	}
	engine.resolver, _ = manager.Transport(f.chain.DNSCapture().ResolverTag)
	if engine.resolver == nil {
		t.Fatal("original selected DNS owner absent")
	}
	roots := x509.NewCertPool()
	if !roots.AppendCertsFromPEM([]byte(f.peer.paired.ca)) {
		t.Fatal("reference CA absent")
	}
	f.testTLS = &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}
	field := reflect.ValueOf(f.chain).Elem().FieldByName("runtime").FieldByName("testTLS")
	*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.testTLS.Clone()
	f.engine = engine
	if fault == "wrong-final-identity" {
		if err := f.peer.control("wrong-node"); err != nil {
			t.Fatal(err)
		}
	}
	if fault == "selected-dns-failure" {
		if err := f.peer.control("fail-dns"); err != nil {
			t.Fatal(err)
		}
	}
	t.Cleanup(func() {
		if err := f.close(); err != nil {
			t.Error("original SS path did not join", err)
		}
	})
	return f
}

func (f *nodeChainImportedSSPrefixFixture) installHostname(t *testing.T, fault string) {
	t.Helper()
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	server := &dns.Server{Listener: listener, Net: "tcp", Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
		if len(q.Question) != 1 || !strings.EqualFold(q.Question[0].Name, desktopImportedHostname+".") || q.Question[0].Qclass != dns.ClassINET || (q.Question[0].Qtype != dns.TypeA && q.Question[0].Qtype != dns.TypeAAAA) {
			t.Error("foreign transport DNS question")
			return
		}
		f.queries.Add(1)
		answer := new(dns.Msg).SetReply(q)
		if fault == "wrong-transport-dns" {
			answer.Rcode = dns.RcodeNameError
		} else if q.Question[0].Qtype == dns.TypeA {
			answer.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 0}, A: net.ParseIP("10.79.0.1")}}
		}
		_ = w.WriteMsg(answer)
	})}
	done := make(chan error, 1)
	go func() { done <- server.ActivateAndServe() }()
	t.Cleanup(func() {
		_ = server.Shutdown()
		if err := <-done; err != nil {
			t.Error(err)
		}
	})
	f.peer.paired.entry.rules["tcp/"+desktopImportedHostnameDNS] = desktopReferenceRule{Network: "tcp", Address: "10.78.0.53", Port: 5353, Target: listener.Addr().String()}
	launch, err := f.chain.LaunchInput()
	var source mobilemultihop.NodeChainSource
	if err != nil || json.Unmarshal([]byte(launch), &source) != nil {
		t.Fatal("original source absent", err)
	}
	position := len(source.Nodes) - 2
	var member struct {
		Kind    string `json:"kind"`
		Schema  int    `json:"schema"`
		Config  string `json:"config"`
		Capture string `json:"capture"`
	}
	if json.Unmarshal([]byte(source.Nodes[position]), &member) != nil {
		t.Fatal("original import absent")
	}
	var graph, capture map[string]any
	if json.Unmarshal([]byte(member.Config), &graph) != nil || json.Unmarshal([]byte(member.Capture), &capture) != nil {
		t.Fatal("original import malformed")
	}
	row := graph["outbounds"].([]any)[0].(map[string]any)
	profile := capture["profile"].(map[string]any)
	ss := profile["external"].(map[string]any)["shadowsocks"].(map[string]any)
	row["server"], ss["server"], profile["endpoint"] = desktopImportedHostname, desktopImportedHostname, desktopImportedHostname
	profile["dns_mode"], profile["dns_protocol"], profile["dns_host"], profile["dns_port"] = "custom", "tcp", "10.78.0.53", 5353
	profile["ipv6_mode"] = "off"
	source.Nodes[position], err = mobilemultihop.NodeChainImportedMemberInput(desktopNodeChainJSON(t, graph), desktopNodeChainJSON(t, capture))
	if err != nil {
		t.Fatal(err)
	}
	f.chain, err = mobilemultihop.NewNodeChain(desktopNodeChainJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
}
func (f *nodeChainImportedSSPrefixFixture) close() error {
	if f.closed {
		return nil
	}
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()
	if err := f.chain.CloseContext(ctx); err != nil {
		return err
	}
	f.engine.closed.Store(true)
	if err := f.closeNative(); err != nil {
		return err
	}
	f.cancel()
	f.closed = true
	return nil
}
func (f *nodeChainImportedSSPrefixFixture) MeasurementChainContext(ctx context.Context) (*mobilemultihop.NodeChain, error) {
	if ctx == nil || ctx.Err() != nil || f.engine.closed.Load() {
		return nil, errors.New("original measurement component retired")
	}
	return f.chain, nil
}

func (f *nodeChainImportedSSPrefixFixture) BeginMeasurementContext(ctx context.Context) (func(), error) {
	if _, err := f.MeasurementChainContext(ctx); err != nil {
		return nil, err
	}
	if !f.measuring.CompareAndSwap(false, true) {
		return nil, errors.New("original measurement component already borrowed")
	}
	f.acquired.Add(1)
	var once sync.Once
	return func() { once.Do(func() { f.released.Add(1); f.measuring.Store(false) }) }, nil
}

func (f *nodeChainImportedSSPrefixFixture) snapshot() desktopNodeChainImportedReply {
	snapshot := f.peer.snapshot()
	if f.complete != nil {
		snapshot.Prefixes = f.complete.snapshot().Prefixes
		snapshot.Address = f.complete.prefixes[0].bind.address()
	}
	return snapshot
}
func (f *nodeChainImportedSSPrefixFixture) samples() []uint64 {
	count := len(f.request.Prefixes)
	samples := make([]uint64, count+2)
	for i := 0; i < count; i++ {
		if i == count-1 {
			samples[i] = f.peer.measuredFirstHealth.Load()
		} else {
			samples[i] = f.complete.prefixes[i].measuredHealth.Load()
		}
	}
	samples[count] = f.peer.snapshot().Middle.DownloadBytes
	samples[count+1] = f.peer.paired.measuredHealth.Load()
	return samples
}

func (f *nodeChainImportedSSPrefixFixture) prove(t *testing.T) {
	t.Helper()
	if err := f.chain.Run(f.ctx, f.engine); err != nil {
		t.Fatal("actual imported SS prefix Run", err, f.chain.Progress(), f.snapshot())
	}
	progress, stats := f.chain.Progress(), f.snapshot()
	if !progress.Ready || !progress.DNSProven || !progress.PublicProven || len(progress.Prefixes) != len(f.request.Prefixes)+2 || stats.Final.RouterQueries < 2 || stats.Final.DNSQueries < 1 || stats.Middle.PublicQueries < 2 {
		t.Fatal("original SS proof incomplete", progress, stats)
	}
	for i, p := range stats.Prefixes {
		if p.RawUDP == 0 || p.ProofQueries < 2 {
			t.Fatal("unproved encrypted prefix", i, p)
		}
	}
	if f.form == "hostname" && f.queries.Load() == 0 {
		t.Fatal("hostname bypassed captured last-prefix TCP resolver")
	}
	plan, err := f.chain.MTUPlan()
	if err != nil || len(plan.Prefixes) != len(f.request.Prefixes)+2 {
		t.Fatal("complete MTU envelope absent", err, plan)
	}
	if _, err = f.chain.PlanForMTU(f.chain.Config(), plan.Original); err != nil {
		t.Fatal("original MTU capture changed", err)
	}
}
func (f *nodeChainImportedSSPrefixFixture) fiftyPrefixGroup(t *testing.T, group int) {
	t.Helper()
	service, err := f.chain.NewHopMeasurementContext(f.ctx, f)
	if err != nil {
		t.Fatal("original encrypted measurement source", err)
	}
	t.Cleanup(func() {
		if err := service.Close(); err != nil {
			t.Error(err)
		}
	})
	// The private reference CA is the only replacement at TLS validation.
	field := reflect.ValueOf(service).Elem().FieldByName("publicTLS")
	*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.testTLS.Clone()
	facade, err := hopmeasure.NewOrderedLatencyContext(f.ctx, service, f.chain.SourceSHA256(), f.chain.ConfigSHA256())
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := facade.Close(); err != nil {
			t.Error(err)
		}
	})
	proofs := f.chain.ProofInventory()
	for position := group * 2; position < group*2+2; position++ {
		proof := proofs[position]
		t.Logf("IMPORTED_SS_PREFIX_FIFTY position=%d phase=start", position)
		started := time.Now()
		before := f.samples()
		request := fmt.Sprintf("%032x", position+1)
		if err := facade.StartContext(f.ctx, request, proof.ProfileID); err != nil {
			t.Fatal(err)
		}
		if err := facade.DrainContext(f.ctx, request); err != nil {
			t.Fatal("original fifty-response worker did not drain", err)
		}
		var status hopmeasure.Status
		if json.Unmarshal([]byte(facade.StatusJSON()), &status) != nil || !status.Complete || !status.Drained || status.Failure != "" || len(status.Results) != 1 {
			t.Fatal("encrypted fifty-response result absent", facade.StatusJSON())
		}
		row := status.Results[0]
		kind, metric := "private-node", "routed-private-response-including-connection"
		if position == len(proofs)-2 {
			kind, metric = "public-path", "routed-https-response-after-tls"
		}
		if !row.Ready || row.ID != proof.ProfileID || row.Kind != kind || row.Benchmark == nil || row.Benchmark.Measurement != metric || row.Benchmark.Attempts != 50 || row.Benchmark.Failed != 0 || row.Benchmark.Distribution == nil || row.Benchmark.Distribution.Samples != 50 || row.Benchmark.TrimmedMean <= 0 || row.Download != nil || row.Upload != nil || row.Idle != nil {
			t.Fatal("original fifty-response metric changed", row)
		}
		var saved hopmeasure.OrderedLatencyReceipt
		if json.Unmarshal([]byte(facade.SavedJSON(proof.ProfileID)), &saved) != nil || saved.Position != position || saved.NodeID != proof.ProfileID || saved.SourceSHA256 != f.chain.SourceSHA256() || saved.ConfigSHA256 != f.chain.ConfigSHA256() {
			t.Fatal("fifty-response history lost original path", saved)
		}
		after := f.samples()
		for i := range after {
			want := uint64(0)
			if i == position {
				want = 50
			}
			if after[i]-before[i] != want {
				t.Fatal("fifty responses borrowed another prefix", position, i, before, after)
			}
		}
		t.Logf("IMPORTED_SS_PREFIX_FIFTY position=%d phase=complete elapsed=%s", position, time.Since(started))
		if f.measuring.Load() || f.acquired.Load() != int32(position-group*2+1) || f.released.Load() != f.acquired.Load() {
			t.Fatal("fifty-response completion did not release original scope")
		}
	}

	previous := facade.CommittedJSON(proofs[group*2+1].ProfileID)
	f.engine.closed.Store(true)
	if facade.StartContext(f.ctx, strings.Repeat("f", 32), proofs[group*2+1].ProfileID) == nil || facade.CommittedJSON(proofs[group*2+1].ProfileID) != previous || f.measuring.Load() {
		t.Fatal("retired original SS owner replaced saved measurement")
	}
}

func importedSSPrefixMethod(mode string) string {
	switch mode {
	case "wg":
		return "2022-blake3-aes-128-gcm"
	case "awg2-fast":
		return "2022-blake3-aes-256-gcm"
	case "awg2-strong":
		return "2022-blake3-chacha20-poly1305"
	default:
		return ""
	}
}
func TestRouterVPNDesktopNodeChainImportedSSPrefixTraffic(t *testing.T) {
	chosen := os.Getenv("ROUTERVPN_IMPORTED_SS_PREFIX_CASE")
	if chosen == "" {
		t.Skip("captured imported SS prefix case required")
	}
	parts := strings.Split(chosen, "/")
	if len(parts) != 4 {
		t.Fatal("uncaptured SS prefix selector")
	}
	mode, form := parts[0], parts[1]
	method := importedSSPrefixMethod(mode)
	count, err := strconv.Atoi(parts[2])
	if err != nil || strconv.Itoa(count) != parts[2] || (count != 2 && count != 6) || method == "" || (form != "literal" && form != "hostname") {
		t.Fatal("uncaptured SS prefix shape")
	}
	group, err := strconv.Atoi(parts[3])
	if err != nil || strconv.Itoa(group) != parts[3] || group < 0 || group >= (count+2)/2 {
		t.Fatal("uncaptured SS measurement group")
	}
	t.Run(strings.ReplaceAll(chosen, "/", "-"), func(t *testing.T) {
		f := nodeChainImportedSSPrefixStart(t, mode, form, method, "", count, 170*time.Second)
		f.prove(t)
		f.fiftyPrefixGroup(t, group)
		if err := f.close(); err != nil {
			t.Fatal("original SS prefix retirement", err)
		}
		if f.chain.Progress().Ready || f.chain.HealthyContext(context.Background()) == nil {
			t.Fatal("closed original SS path remained current")
		}
	})
}
func TestRouterVPNDesktopNodeChainImportedSSPrefixRefusal(t *testing.T) {
	fault := os.Getenv("ROUTERVPN_IMPORTED_SS_PREFIX_REFUSAL")
	if fault == "" {
		t.Skip("captured SS refusal required")
	}
	switch fault {
	case "wrong-intermediate-key", "omit-last-prefix", "wrong-middle-key", "wrong-final-identity", "selected-dns-failure", "wrong-transport-dns":
	default:
		t.Fatal("uncaptured SS refusal")
	}
	t.Run(fault, func(t *testing.T) {
		f := nodeChainImportedSSPrefixStart(t, "awg2-strong", "hostname", importedSSPrefixMethod("awg2-strong"), fault, 6, 12*time.Second)
		ctx, cancel := context.WithTimeout(f.ctx, 5*time.Second)
		defer cancel()
		if err := f.chain.Run(ctx, f.engine); err == nil || f.chain.Progress().Ready {
			t.Fatal("invalid original SS prefix became ready", fault)
		}
		stats := f.snapshot()
		if stats.Prefixes[0].RawUDP == 0 {
			t.Fatal("refusal never reached original physical prefix")
		}
		if fault == "wrong-final-identity" || fault == "selected-dns-failure" {
			if stats.Final.RouterQueries == 0 {
				t.Fatal("refusal never reached paired final")
			}
		} else if stats.Final.RouterQueries != 0 {
			t.Fatal("invalid SS prefix acquired final authority")
		}
	})
}
