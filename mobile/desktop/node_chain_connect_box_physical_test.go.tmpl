func desktopCONNECTPhysicalPolicy(t *testing.T, target string) *mobilemultihop.DesktopNodeChainCONNECTPolicy {
	t.Helper()
	policy, err := mobilemultihop.NewDesktopNodeChainCONNECTPolicy(connectMTUSource(t), desktopTorBoxSession, target, 0)
	if err != nil {
		t.Fatal("original typed desktop source", err)
	}
	return policy
}

// Original real endpoint, CONNECT, SS, selector, DNS, network and Box factories
// execute. Only privileged TUN creation is doubled. Nothing here starts a
// physical socket or constitutes native interface acceptance.
func desktopCONNECTPhysicalBox(t *testing.T, policy *mobilemultihop.DesktopNodeChainCONNECTPolicy, change func(map[string]any)) (*Box, *desktopTorBoxTUN, error) {
	t.Helper()
	source, err := policy.NativeSource()
	if err != nil {
		t.Fatal(err)
	}
	capture, err := ownedCONNECT.NewCapture(t.Context(), source)
	if err != nil {
		t.Fatal(err)
	}
	var tun *desktopTorBoxTUN
	ins := inbound.NewRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.TunInboundOptions) (adapter.Inbound, error) {
		tun = &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag), name: options.InterfaceName, index: 772, mtu: int(options.MTU)}
		return tun, nil
	})
	outs := outbound.NewRegistry()
	group.RegisterSelector(outs)
	shadowsocks.RegisterOutbound(outs)
	if err := capture.Register(outs); err != nil {
		t.Fatal(err)
	}
	routervpndesktoppt.RegisterNodePhysicalOutbound(outs)
	ends := endpoint.NewRegistry()
	wireguard.RegisterEndpoint(ends)
	AWG.RegisterEndpoint(ends)
	ds := dns.NewTransportRegistry()
	DNST.RegisterUDP(ds)
	services := boxService.NewRegistry()
	routervpndesktoppt.RegisterNodeNetworkOwner(services)
	ctx := Context(capture.Context(), ins, outs, ends, ds, services, certificate.NewRegistry())
	ctx, err = RouterVPNNodeCONNECTContext(ctx, source, capture)
	if err != nil {
		t.Fatal(err)
	}
	var graph map[string]any
	if err := json.Unmarshal([]byte(policy.Config()), &graph); err != nil {
		t.Fatal(err)
	}
	if change != nil {
		change(graph)
	}
	raw, err := json.Marshal(graph)
	if err != nil {
		t.Fatal(err)
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
	if err != nil {
		return nil, tun, err
	}
	options.Log = &option.LogOptions{Disabled: true}
	instance, err := New(Options{Context: ctx, Options: options})
	if instance != nil {
		t.Cleanup(func() {
			if err := instance.Close(); err != nil {
				t.Error("original typed Box failed close", err)
			}
		})
	}
	return instance, tun, err
}

func TestRouterVPNDesktopNodeChainCONNECTPhysicalActualBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" && runtime.GOOS != "darwin" {
		t.Fatal("typed physical gate requires an original desktop target")
	}
	policy := desktopCONNECTPhysicalPolicy(t, runtime.GOOS)
	instance, tun, err := desktopCONNECTPhysicalBox(t, policy, nil)
	if err != nil || instance == nil || tun == nil {
		t.Fatal("original typed desktop Box construction failed", err)
	}
	if !routerVPNDesktopNodeChainCONNECTPhysicalTarget(policy, runtime.GOOS) || instance.routerVPNNodeOptions == "" {
		t.Fatal("typed desktop Box lost physical source receipt")
	}
	_, network, err := instance.routerVPNDesktopNodePhysical(policy)
	if err != nil || network == nil || network.Current() || network.SocketCurrent() || tun.ready || tun.claimed {
		t.Fatal("typed Box fabricated native preparation or TUN proof", err)
	}
	if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
		t.Fatal("unprepared typed Box acquired physical authority")
	}
	if err := instance.RouterVPNStrategyStart(); err == nil {
		t.Fatal("typed graph bypassed original physical preparation")
	}
	if tun.ready || tun.claimed || network.SocketCurrent() {
		t.Fatal("unprepared typed Box started a socket or TUN")
	}
}

func TestRouterVPNDesktopNodeChainCONNECTPhysicalRejectsGraphDrift(t *testing.T) {
	for _, fault := range []string{"middle-user", "middle-password", "middle-detour", "final-detour", "final-carrier", "dns", "physical-source", "mtu", "interface"} {
		t.Run(fault, func(t *testing.T) {
			policy := desktopCONNECTPhysicalPolicy(t, runtime.GOOS)
			_, meta, physical, err := policy.ReadValidated()
			if err != nil {
				t.Fatal(err)
			}
			instance, tun, err := desktopCONNECTPhysicalBox(t, policy, func(graph map[string]any) {
				find := func(tag string) map[string]any {
					for _, item := range graph["outbounds"].([]any) {
						row := item.(map[string]any)
						if row["tag"] == tag {
							return row
						}
					}
					t.Fatal("exact captured outbound missing")
					return nil
				}
				switch fault {
				case "middle-user":
					find(meta.Prefixes[1].Tag)["username"] = "foreign-user"
				case "middle-password":
					find(meta.Prefixes[1].Tag)["password"] = "foreign-password"
				case "middle-detour":
					delete(find(meta.Prefixes[1].Tag), "detour")
				case "final-detour":
					find(meta.Prefixes[2].Tag)["detour"] = meta.Prefixes[0].Tag
				case "final-carrier":
					delete(find(meta.Prefixes[2].Tag), "udp_over_tcp")
				case "dns":
					found := false
					for _, item := range graph["dns"].(map[string]any)["servers"].([]any) {
						row := item.(map[string]any)
						if row["tag"] == physical.SelectedDNS.Tag {
							row["server"] = "192.168.50.134"
							found = true
						}
					}
					if !found {
						t.Fatal("original selected DNS missing")
					}
				case "physical-source":
					graph["services"].([]any)[0].(map[string]any)["source_sha256"] = strings.Repeat("f", 64)
				case "mtu":
					row := graph["inbounds"].([]any)[0].(map[string]any)
					row["mtu"] = row["mtu"].(float64) + 16
				case "interface":
					graph["inbounds"].([]any)[0].(map[string]any)["interface_name"] = "foreign-connect"
				}
			})
			if err == nil || instance != nil || tun != nil {
				t.Fatal("changed typed graph reached original native construction", err)
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainCONNECTPhysicalExactTargets(t *testing.T) {
	for _, target := range []string{"linux", "windows", "darwin"} {
		t.Run(target, func(t *testing.T) {
			policy := desktopCONNECTPhysicalPolicy(t, target)
			if !routerVPNDesktopNodeChainCONNECTPhysicalTarget(policy, target) {
				t.Fatal("typed original source lost its physical target")
			}
			for _, other := range []string{"linux", "windows", "darwin", "android"} {
				if other != target && routerVPNDesktopNodeChainCONNECTPhysicalTarget(policy, other) {
					t.Fatal("typed physical owner borrowed another target")
				}
			}
			_, _, physical, err := policy.ReadValidated()
			if err != nil {
				t.Fatal(err)
			}
			for _, root := range physical.PhysicalRoots {
				if root.Type == "http" || root.Type == "socks" || root.DynamicSOCKSUDP {
					t.Fatal("CONNECT middle acquired physical relay authority")
				}
			}
		})
	}
}
