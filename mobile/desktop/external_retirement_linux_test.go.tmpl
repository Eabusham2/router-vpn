//go:build linux

package main

import (
	"context"
	"errors"
	"io"
	"os"
	"testing"
	"time"
)

type routerVPNPartialRetirementWitness struct {
	file             *os.File
	allow            bool
	attempts, closes int
}

func (w *routerVPNPartialRetirementWitness) RouterVPNCloseNativeTunContext(ctx context.Context) error {
	w.attempts++
	if ctx.Err() != nil {
		return ctx.Err()
	}
	if !w.allow {
		return errors.New("original native deletion awaits repair")
	}
	return nil
}
func (w *routerVPNPartialRetirementWitness) Close() error { w.closes++; return w.file.Close() }

func TestRouterVPNRawCommandNativePartialDependenciesRetention(t *testing.T) {
	for _, kind := range []string{"external", "tor"} {
		t.Run(kind, func(t *testing.T) {
			files := make([]*os.File, 3)
			for i := range files {
				file, err := os.CreateTemp(t.TempDir(), "original-dependency")
				if err != nil {
					t.Fatal(err)
				}
				files[i] = file
				t.Cleanup(func() { file.Close() })
			}
			original := &routerVPNPartialRetirementWitness{file: files[1]}
			partial := []io.Closer{files[0], original, files[2]}
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			var closeOwner func(context.Context) error
			var current func() []io.Closer
			if kind == "external" {
				owner := &routerVPNExternalNative{cancel: cancel, partial: partial}
				closeOwner = owner.CloseContext
				current = func() []io.Closer { return owner.partial }
			} else {
				owner := &routerVPNTorNative{ctx: ctx, cancel: cancel, partial: partial}
				closeOwner = owner.Close
				current = func() []io.Closer { return owner.partial }
			}
			stop, done := context.WithTimeout(context.Background(), time.Second)
			defer done()
			if err := closeOwner(stop); err == nil {
				t.Fatal("failed original native deletion reported complete cleanup")
			}
			if len(current()) != 3 || original.closes != 0 || original.attempts != 1 {
				t.Fatal("partial dependency identity disappeared before native retirement")
			}
			for i, file := range files {
				if _, err := file.Stat(); err != nil {
					t.Fatal("failed native cleanup closed an original partial dependency", i, err)
				}
			}
			original.allow = true
			if err := closeOwner(stop); err != nil {
				t.Fatal("original partial dependency retry failed", err)
			}
			if len(current()) != 0 || original.closes != 1 || original.attempts != 2 {
				t.Fatal("retry did not retire the exact dependency set once")
			}
			for i, file := range files {
				if _, err := file.Stat(); !errors.Is(err, os.ErrClosed) {
					t.Fatal("original partial dependency did not join", i, err)
				}
			}
		})
	}
}
