// Shared encrypted provider/proof operations retain the pinned OpenVPN engine.
// Carriers supply an actual captured numeric interface; OS admission/identity
// and TUN creation remain explicit separate kernel-test boundaries.

var desktopOpenVPNCompositionCases = []string{
	"tcp-proof-mtu-latency50", "udp-proof-mtu-latency50", "tcp-fallback", "mixed-fallback",
	"tcp-reconnect-rejects-old-proof", "udp-reconnect-rejects-old-proof", "reconnect-during-public-proof",
	"cancelled-proof", "wrong-provider-trust", "wrong-control-key", "selected-dns-failure", "captured-tuple-set",
}

type desktopOpenVPNCompositionPKI struct{ ca, provider, providerKey, client, clientKey string }

func desktopOpenVPNCompositionCertificates(t *testing.T) desktopOpenVPNCompositionPKI {
	t.Helper()
	root := newDesktopExternalIntegrationCA(t)
	pki := desktopOpenVPNCompositionPKI{ca: string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: root.der}))}
	issue := func(serial int64, name string, usage x509.ExtKeyUsage) (string, string) {
		key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
		if err != nil {
			t.Fatal(err)
		}
		leaf := &x509.Certificate{SerialNumber: big.NewInt(serial), Subject: pkix.Name{CommonName: name},
			NotBefore: root.root.NotBefore, NotAfter: root.root.NotAfter, KeyUsage: x509.KeyUsageDigitalSignature,
			ExtKeyUsage: []x509.ExtKeyUsage{usage}, DNSNames: []string{name}}
		der, err := x509.CreateCertificate(rand.Reader, leaf, root.root, &key.PublicKey, root.key)
		if err != nil {
			t.Fatal(err)
		}
		private, err := x509.MarshalPKCS8PrivateKey(key)
		if err != nil {
			t.Fatal(err)
		}
		return string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})), string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: private}))
	}
	pki.provider, pki.providerKey = issue(2, "provider.routervpn.test", x509.ExtKeyUsageServerAuth)
	pki.client, pki.clientKey = issue(3, "captured-client.routervpn.test", x509.ExtKeyUsageClientAuth)
	return pki
}

func desktopOpenVPNCompositionControlKey() string {
	return "-----BEGIN OpenVPN Static key V1-----\n" + strings.Repeat(strings.Repeat("a", 32)+"\n", 16) + "-----END OpenVPN Static key V1-----\n"
}

