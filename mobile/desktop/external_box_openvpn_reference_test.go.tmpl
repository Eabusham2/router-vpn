func (f *desktopOpenVPNCompositionFixture) grants(t *testing.T, requireCurrent bool) {
	t.Helper()
	// OpenVPN owns this immutable exact tuple set. Do not call the generic
	// dynamic-SOCKS predicate while holding its grant mutex: that predicate
	// reads its separate relay map under the same lock and cannot authorize an
	// OpenVPN destination in any case.
	allowed := make(map[desktopExternalIntegrationTuple]bool, len(f.remotes))
	for _, remote := range f.remotes {
		if err := remote.Validate(); err != nil {
			t.Fatal("OpenVPN grant lost its original remote", err)
		}
		allowed[desktopExternalIntegrationTuple{network: remote.Network, remote: netip.AddrPortFrom(netip.MustParseAddr(remote.Host), uint16(remote.Port))}] = true
	}
	f.kernel.mu.Lock()
	defer f.kernel.mu.Unlock()
	if len(f.kernel.issued) == 0 {
		t.Fatal("real provider never requested a physical socket")
	}
	for _, issued := range f.kernel.issued {
		q := issued.grant
		if q.Capture != f.source.capture || q.Binding.Owner != f.source.owner || q.Binding.LocalAddress != f.kernel.local ||
			q.Binding.InterfaceName != f.kernel.name || q.Binding.InterfaceIndex != f.kernel.index || !allowed[desktopExternalIntegrationTuple{network: q.Network, remote: q.Remote}] ||
			q.Local.Addr() != f.kernel.local || q.Local.Port() == 0 {
			t.Fatal("provider issued a grant outside its exact captured tuple set")
		}
	}
	if requireCurrent {
		if len(f.kernel.grants) != 1 {
			t.Fatal("connected provider lost its one actual transport grant", len(f.kernel.grants))
		}
		last := f.remotes[len(f.remotes)-1]
		for _, q := range f.kernel.grants {
			if q.Network != last.Network || q.Remote.String() != net.JoinHostPort(last.Host, strconv.Itoa(last.Port)) {
