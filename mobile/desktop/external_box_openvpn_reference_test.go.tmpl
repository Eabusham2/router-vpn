func desktopOpenVPNCompositionProviderBox(ctx context.Context, graph map[string]any) (*Box, error) {
	ins, outs, endpoints := inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry()
	DIRECT.RegisterOutbound(outs)
	OVPN.RegisterEndpoint(endpoints)
	transports := dns.NewTransportRegistry()
	DNST.RegisterUDP(transports)
	DNST.RegisterTCP(transports)
	DNSL.RegisterTransport(transports)
	OVPN.RegisterDNSTransport(transports)
	ctx = Context(ctx, ins, outs, endpoints, transports, boxService.NewRegistry(), certificate.NewRegistry())
	raw, err := json.Marshal(graph)
	if err != nil {
		return nil, err
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
	if err != nil {
		return nil, err
	}
	return New(Options{Context: ctx, Options: options})
}

// Reserve distinct port numbers in this fixture; only genuine bind collisions
// are retried. Both TCP and UDP are checked before the native server opens one.
func desktopOpenVPNCompositionPort(address string, used map[int]bool) (int, error) {
	for attempt := 0; attempt < 128; attempt++ {
		listener, err := net.Listen("tcp4", address+":0")
		if err != nil {
			return 0, err
		}
		port := listener.Addr().(*net.TCPAddr).Port
		if used[port] {
			_ = listener.Close()
			continue
		}
		packet, packetErr := net.ListenPacket("udp4", net.JoinHostPort(address, strconv.Itoa(port)))
		_ = listener.Close()
		if errors.Is(packetErr, syscall.EADDRINUSE) {
			continue
		}
		if packetErr != nil {
			return 0, packetErr
		}
		_ = packet.Close()
		used[port] = true
		return port, nil
	}
	return 0, errors.New("owned OpenVPN provider has no distinct available port")
}

func desktopOpenVPNCompositionServeStream(p *desktopExternalIntegrationPeer, listener net.Listener, destination string) {
	p.workers.Add(1)
	go func() {
		defer p.workers.Done()
		for {
			connection, err := listener.Accept()
			if err != nil {
				return
			}
			p.mu.Lock()
			if p.closing {
				p.mu.Unlock()
				_ = connection.Close()
				return
			}
			p.connections[connection] = true
			p.workers.Add(1)
			p.mu.Unlock()
			go func() {
				defer p.workers.Done()
				defer func() { _ = connection.Close(); p.mu.Lock(); delete(p.connections, connection); p.mu.Unlock() }()
				_ = connection.SetDeadline(time.Now().Add(15 * time.Second))
				p.recordFailure(p.serve(connection, destination))
			}()
		}
	}()
}

func desktopOpenVPNCompositionServeDNS(p *desktopExternalIntegrationPeer) {
	p.workers.Add(1)
	go func() {
		defer p.workers.Done()
		buffer := make([]byte, 4096)
		for {
			n, source, err := p.packet.ReadFrom(buffer)
			if err != nil {
				return
			}
			query := new(mDNS.Msg)
			if query.Unpack(buffer[:n]) != nil || len(query.Question) != 1 {
				p.recordFailure(errors.New("provider received malformed selected DNS"))
				continue
			}
			latency := query.Question[0].Name == "speed.cloudflare.com."
			if !latency && query.Question[0].Name != "example.com." || query.Question[0].Qtype != mDNS.TypeA && !(latency && query.Question[0].Qtype == mDNS.TypeAAAA) {
				p.recordFailure(errors.New("provider received unowned selected DNS question"))
				continue
			}
			p.dnsQueries.Add(1)
			answer := new(mDNS.Msg).SetReply(query)
			ip := net.IPv4(93, 184, 216, 34)
			if p.badDNS {
				ip = net.IPv4(192, 168, 50, 1)
			}
			answer.Answer = []mDNS.RR{&mDNS.A{Hdr: mDNS.RR_Header{Name: query.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60}, A: ip}}
			if latency {
				p.latency.answer(query, answer)
			}
			raw, err := answer.Pack()
			if err == nil {
				_, err = p.packet.WriteTo(raw, source)
			}
			p.recordFailure(err)
		}
	}()
}

func desktopOpenVPNReferenceServe(address string) (failure error) {
	return desktopOpenVPNReferenceServeOwned(address, nil)
}

func desktopOpenVPNReferenceServeOwned(address string, appID []byte) (failure error) {
	// stdout belongs to strict JSON replies; keep startup failures on stderr.
	// Emit fixed phase names and optional numeric errno without error text.
	fail := func(phase string, err error) error {
		var errno syscall.Errno
		if errors.As(err, &errno) {
			fmt.Fprintf(os.Stderr, "routervpn-openvpn-provider phase=%s class=syscall errno=%d\n", phase, uint64(errno))
		} else {
			fmt.Fprintf(os.Stderr, "routervpn-openvpn-provider phase=%s class=error\n", phase)
		}
		return err
	}
	reader := json.NewDecoder(io.LimitReader(os.Stdin, 512<<10))
	reader.DisallowUnknownFields()
	var request desktopOpenVPNCompositionPeerInput
	if err := reader.Decode(&request); err != nil || request.Schema != 1 || request.Network != "tcp" && request.Network != "udp" ||
		request.Control != "tls-auth" && request.Control != "tls-crypt" || request.Fault != "" && request.Fault != "held-proof" && request.Fault != "dns" {
		return fail("request", errors.New("provider lost complete captured request"))
	}
	public, err := tls.X509KeyPair([]byte(request.PublicCertificate), []byte(request.PublicKey))
	if err != nil {
		return fail("public-tls-identity", errors.New("provider lost captured public TLS identity"))
	}
	ctx, cancel := context.WithCancel(context.Background())
	peer := &desktopExternalIntegrationPeer{protocol: "openvpn", certificate: public, ctx: ctx, cancel: cancel,
		connections: make(map[net.Conn]bool), packetConnections: make(map[N.PacketConn]bool)}
	peer.latency = &desktopExternalLatencyPeer{certificate: public}
	peer.badDNS = request.Fault == "dns"
	if request.Fault == "held-proof" {
		peer.publicEntered, peer.publicRelease = make(chan struct{}), make(chan struct{})
	}
	var provider *Box
	var latency net.Listener
	defer func() {
		cancel()
		if provider != nil {
			failure = errors.Join(failure, provider.Close())
		}
		if latency != nil {
			_ = latency.Close()
		}
		peer.close()
	}()
	peer.listener, err = net.Listen("tcp4", address+":0")
	if err != nil {
		return fail("public-listener", err)
	}
	latency, err = net.Listen("tcp4", address+":0")
	if err != nil {
		return fail("latency-listener", err)
	}
	peer.packet, err = net.ListenPacket("udp4", address+":0")
	if err != nil {
		return fail("dns-listener", err)
	}
	desktopOpenVPNCompositionServeStream(peer, peer.listener, "1.1.1.1:443")
	desktopOpenVPNCompositionServeStream(peer, latency, desktopExternalLatencyAddress)
	desktopOpenVPNCompositionServeDNS(peer)
	used := make(map[int]bool)
	unavailable, err := desktopOpenVPNCompositionPort(address, used)
	if err != nil {
		return fail("unavailable-port-reservation", err)
	}
	var port int
	for attempt := 0; attempt < 16; attempt++ {
		port, err = desktopOpenVPNCompositionPort(address, used)
		if err != nil {
			return fail("provider-port-reservation", err)
		}
		control := map[string]any{"type": strings.ReplaceAll(request.Control, "-", "_"), "key": []string{request.ControlKey}}
		if request.Control == "tls-auth" {
			control["direction"] = "server"
		}
		rule := func(network, destination string, original, actual int) map[string]any {
			return map[string]any{"network": []string{network}, "ip_cidr": []string{destination + "/32"}, "port": []int{original},
				"action": "route", "outbound": "selected-services", "override_address": address, "override_port": actual}
		}
		graph := map[string]any{"log": map[string]any{"disabled": true},
			"endpoints": []any{map[string]any{"type": "openvpn-server", "tag": "provider", "system": false,
				"listen": address, "listen_port": port, "network": request.Network,
				"address": []string{"10.211.18.1/24"}, "data_ciphers": []string{"AES-256-GCM", "AES-128-GCM"},
				"tls": map[string]any{"certificate": []string{request.Certificate}, "key": []string{request.Key},
					"client_certificate": []string{request.CA}, "verify_client_certificate": "require", "remote_certificate_tls": "client", "control_wrap": control}}},
			"outbounds": []any{map[string]any{"type": "direct", "tag": "selected-services"}},
			"route": map[string]any{"rules": []any{
				rule("udp", "192.168.50.53", 5353, peer.packet.LocalAddr().(*net.UDPAddr).Port),
				rule("tcp", "1.1.1.1", 443, peer.listener.Addr().(*net.TCPAddr).Port),
				rule("tcp", "93.184.216.34", 443, latency.Addr().(*net.TCPAddr).Port), map[string]any{"action": "reject"}}}}
		provider, err = desktopOpenVPNCompositionProviderBox(ctx, graph)
		if err != nil {
			return fail("native-provider-build", err)
		}
		if err = provider.Start(); err == nil {
			break
		}
		closeErr := provider.Close()
		provider = nil
		if closeErr != nil || !errors.Is(err, syscall.EADDRINUSE) {
			return fail("native-provider-start", errors.Join(err, closeErr))
		}
	}
	if provider == nil {
		return fail("provider-bind-exhausted", errors.New("actual OpenVPN provider could not bind"))
	}
	reply := func() desktopOpenVPNCompositionPeerReply {
		return desktopOpenVPNCompositionPeerReply{Schema: 1, Network: request.Network, AppID: appID,
			Remote: net.JoinHostPort(address, strconv.Itoa(port)), UnavailableRemote: net.JoinHostPort(address, strconv.Itoa(unavailable)),
			DNS: peer.dnsQueries.Load(), PublicAttempts: peer.publicAttempts.Load(), PublicRequests: peer.publicRequests.Load(), TLS: peer.tlsHandshakes.Load(),
			LatencyDNS: peer.latency.queries.Load(), LatencyRequests: peer.latency.requests.Load(), LatencyTLS: peer.latency.handshakes.Load()}
	}
	writer := json.NewEncoder(os.Stdout)
	if err := writer.Encode(reply()); err != nil {
		return fail("initial-receipt", err)
	}
	var release sync.Once
	for {
		var command struct {
			Action string `json:"action"`
		}
		if err := reader.Decode(&command); err != nil {
			if errors.Is(err, io.EOF) {
				return nil
			}
			return err
		}
		switch command.Action {
		case "stats":
		case "release":
			if peer.publicRelease == nil {
				return errors.New("provider has no captured held proof")
			}
			release.Do(func() { close(peer.publicRelease) })
		case "close":
			return nil
		default:
			return errors.New("provider refused unowned fixture operation")
		}
		if err := writer.Encode(reply()); err != nil {
			return err
		}
	}
}

type desktopOpenVPNCompositionProcess struct {
	address string
	command *exec.Cmd
	input   io.WriteCloser
	output  *os.File
	reader  *bufio.Reader
	done    chan struct{}
	waitErr error
	cancel  context.CancelFunc
	initial desktopOpenVPNCompositionPeerReply
}

func (p *desktopOpenVPNCompositionProcess) read(t *testing.T) desktopOpenVPNCompositionPeerReply {
	t.Helper()
	type readResult struct {
		raw []byte
		err error
	}
	done := make(chan readResult, 1)
	go func() { raw, err := p.reader.ReadSlice('\n'); done <- readResult{raw, err} }()
	var raw []byte
	var err error
	select {
	case result := <-done:
		raw, err = result.raw, result.err
	case <-time.After(10 * time.Second):
		p.cancel()
		_ = p.output.Close()
		<-done
		t.Fatal("owned OpenVPN provider reply did not join its original pipe")
	}
	var reply desktopOpenVPNCompositionPeerReply
	decoder := json.NewDecoder(strings.NewReader(string(raw)))
	decoder.DisallowUnknownFields()
	var trailing any
	if err != nil || len(raw) > 16<<10 || decoder.Decode(&reply) != nil || decoder.Decode(&trailing) != io.EOF || reply.Schema != 1 || reply.Network != "tcp" && reply.Network != "udp" {
		t.Fatal("owned OpenVPN provider lost bounded reply", err)
	}
	remote, e1 := netip.ParseAddrPort(reply.Remote)
	unavailable, e2 := netip.ParseAddrPort(reply.UnavailableRemote)
	if e1 != nil || e2 != nil || remote.Addr().String() != p.address || unavailable.Addr() != remote.Addr() || remote.Port() == 0 || unavailable.Port() == 0 || unavailable == remote ||
		p.initial.Schema != 0 && (reply.Network != p.initial.Network || reply.Remote != p.initial.Remote || reply.UnavailableRemote != p.initial.UnavailableRemote || !reflect.DeepEqual(reply.AppID, p.initial.AppID)) {
		t.Fatal("owned OpenVPN provider changed captured transport")
	}
	return reply
}

func (p *desktopOpenVPNCompositionProcess) observe(t *testing.T, action string) desktopOpenVPNCompositionPeerReply {
	t.Helper()
	if action != "stats" && action != "release" {
		t.Fatal("unowned provider observation")
	}
	if err := json.NewEncoder(p.input).Encode(map[string]string{"action": action}); err != nil {
		t.Fatal(err)
	}
	return p.read(t)
}

func desktopOpenVPNReferenceStart(t *testing.T, request desktopOpenVPNCompositionPeerInput, address string, build func(context.Context) *exec.Cmd) *desktopOpenVPNCompositionProcess {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Second)
	p := &desktopOpenVPNCompositionProcess{address: address, cancel: cancel, done: make(chan struct{})}
	p.command = build(ctx)
	if p.command.Env == nil {
		p.command.Env = os.Environ()
	}
	p.command.Env = append(p.command.Env, "GORACE=atexit_sleep_ms=0")
	p.command.Stderr = os.Stderr
	var err error
	p.input, err = p.command.StdinPipe()
	if err != nil {
		cancel()
		t.Fatal(err)
	}
	var writer *os.File
	p.output, writer, err = os.Pipe()
	if err != nil {
		cancel()
		_ = p.input.Close()
		t.Fatal(err)
	}
	p.reader = bufio.NewReaderSize(p.output, (16<<10)+1)
	p.command.Stdout = writer
	if err := p.command.Start(); err != nil {
		cancel()
		_ = writer.Close()
		_ = p.input.Close()
		_ = p.output.Close()
		t.Fatal(err)
	}
	_ = writer.Close()
	go func() { p.waitErr = p.command.Wait(); close(p.done) }()
	t.Cleanup(func() {
		_ = p.input.Close()
		select {
		case <-p.done:
			if p.waitErr != nil {
				t.Error("actual OpenVPN provider failed", p.waitErr)
			}
		case <-time.After(8 * time.Second):
			cancel()
			<-p.done
			t.Error("actual OpenVPN provider failed joined shutdown")
		}
		cancel()
		_ = p.output.Close()
	})
	if err := json.NewEncoder(p.input).Encode(request); err != nil {
		t.Fatal(err)
	}
	p.initial = p.read(t)
	if p.initial.Network != request.Network || p.initial.DNS != 0 || p.initial.PublicRequests != 0 || p.initial.TLS != 0 || p.initial.LatencyRequests != 0 {
		t.Fatal("provider reported traffic before captured native connection")
	}
	return p
}

type desktopOpenVPNCompositionFixture struct {
	*desktopExternalIntegrationFixture
	endpoint                    *OVPN.ClientEndpoint
	process                     *desktopOpenVPNCompositionProcess
	remotes                     []nativeopenvpn.Remote
	originalEndpoint            map[string]any
	sourceDigest, captureDigest string
	closeOnce                   sync.Once
	closeError                  error
	cancel                      context.CancelFunc
}

func desktopOpenVPNCompositionHash(value string) string {
	digest := sha256.Sum256([]byte(value))
	return hex.EncodeToString(digest[:])
}

func desktopOpenVPNCompositionProfile(pki desktopOpenVPNCompositionPKI, remotes []nativeopenvpn.Remote, control, fault string) nativeopenvpn.Profile {
	// Preserve this exact original import, including its comments/newline form.
	// A provider comparison URL is deliberately absent: transport generation
	// must bind an ordinary imported connection independently of Compare.
	config := "\n# Complete original provider import\r\nclient\n"
	for _, remote := range remotes {
		config += fmt.Sprintf("remote %s %d %s\n", remote.Host, remote.Port, remote.Network)
	}
	ca := pki.ca
	key := desktopOpenVPNCompositionControlKey()
	if fault == "wrong-control-key" {
		key = strings.ReplaceAll(key, strings.Repeat("a", 32), strings.Repeat("b", 32))
	}
	config += "verify-x509-name provider.routervpn.test name\nremote-cert-tls server\ndata-ciphers AES-256-GCM:AES-128-GCM\ntun-mtu 1400\nhand-window 3\ntls-timeout 1\n<ca>\n" + ca + "</ca>\n<cert>\n" + pki.client + "</cert>\n<key>\n" + pki.clientKey + "</key>\n<" + control + ">\n" + key + "</" + control + ">\n"
	if control == "tls-auth" {
		config += "key-direction 1\n"
	}
	return nativeopenvpn.Profile{Config: config}
}

func desktopOpenVPNReferenceNew(t *testing.T, process *desktopOpenVPNCompositionProcess, profile nativeopenvpn.Profile, remotes []nativeopenvpn.Remote, session, target string, address netip.Addr, iface net.Interface) *desktopOpenVPNCompositionFixture {
	t.Helper()
	observed, err := net.InterfaceByIndex(iface.Index)
	if err != nil || observed.Name != iface.Name || observed.Flags&net.FlagUp == 0 || observed.Flags&net.FlagLoopback != 0 {
		t.Fatal("OpenVPN reference lost its original physical interface", err)
	}
	values, err := observed.Addrs()
	if err != nil {
		t.Fatal(err)
	}
	found := false
	for _, value := range values {
		prefix, err := netip.ParsePrefix(value.String())
		if err == nil && prefix.Addr() == address {
			found = true
		}
	}
	if !found {
		t.Fatal("OpenVPN reference lost its original physical address")
	}
	ctx, cancel := context.WithCancel(context.Background())
	f := &desktopOpenVPNCompositionFixture{desktopExternalIntegrationFixture: &desktopExternalIntegrationFixture{}, process: process, remotes: append([]nativeopenvpn.Remote(nil), remotes...), cancel: cancel}
	f.source = &desktopExternalIntegrationSource{owner: mobiletor.DesktopSocketKernelOwner{Kind: "unix-isolated-uid", IdentitySHA256: strings.Repeat("c", 64), Generation: 1, ProcessID: uint32(os.Getpid())}}
	if target == "windows" {
		f.source.owner.Kind = "windows-isolated-token"
	}
	f.source.live.Store(true)
	f.kernel = &desktopExternalIntegrationKernel{source: f.source, local: address, name: iface.Name, index: uint32(iface.Index), grants: make(map[string]mobiletor.DesktopSocketGrant)}
	f.source.kernel = f.kernel
	for _, remote := range remotes {
