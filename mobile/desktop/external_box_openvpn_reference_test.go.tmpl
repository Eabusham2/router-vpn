			// The pinned native client classifies a control-key handshake timeout
			// as retryable. Require the actual first socket to retire and a distinct
			// later socket to be admitted for that same captured UDP tuple. Waiting
			// for a terminal status would invent an engine behavior it does not have.
			f.kernel.mu.Lock()
			retried := false
			if len(f.kernel.grants) == 1 {
				for currentID, current := range f.kernel.grants {
					currentIssued := f.kernel.issued[currentID]
					for priorID, prior := range f.kernel.issued {
						_, priorCurrent := f.kernel.grants[priorID]
						if priorID != currentID && !priorCurrent && currentIssued != nil && prior.at.Before(currentIssued.at) &&
							prior.grant.Network == "udp" && current.Network == prior.grant.Network && current.Remote == prior.grant.Remote {
							retried = true
						}
					}
				}
			}
			f.kernel.mu.Unlock()
			if retried {
				if status.State != adapter.OpenVPNStateConnecting || status.Error != "" {
					t.Fatal("retryable control handshake changed native status category")
				}
				break
			}
		} else if status.State == adapter.OpenVPNStateError && status.Error != "" {
			break
		}
		select {
		case result := <-done:
			if result.err == nil || result.raw != "" {
				t.Fatal("wrong provider authentication returned a proof")
			}
			t.Fatal("proof stopped before native authentication failure observation")
		case <-changed:
		case <-tick.C:
		case <-deadline.C:
			t.Fatal("wrong provider trust/control did not produce actual native rejection")
		}
	}
	f.grants(t, false)
	f.proof.Cancel()
	f.rejected(t, done)
	stats := f.process.observe(t, "stats")
	if stats.DNS != 0 || stats.PublicAttempts != 0 || stats.PublicRequests != 0 || stats.TLS != 0 {
		t.Fatal("wrong provider authentication delivered inner DNS or public proof bytes", stats)
	}
}

func (f *desktopOpenVPNCompositionFixture) tuples(t *testing.T) {
	t.Helper()
	if len(f.remotes) != 2 || f.remotes[0].Network != "tcp" || f.remotes[1].Network != "udp" || f.remotes[0].Port == f.remotes[1].Port {
		t.Fatal("tuple negative lost mixed ordered transports")
	}
	for _, remote := range f.remotes {
		actual := netip.AddrPortFrom(netip.MustParseAddr(remote.Host), uint16(remote.Port))
		if _, err := f.kernel.Select(context.Background(), f.source.capture, remote.Network, actual); err != nil {
			t.Fatal("exact captured tuple was refused", err)
		}
		other := "tcp"
		if remote.Network == "tcp" {
			other = "udp"
		}
		if _, err := f.kernel.Select(context.Background(), f.source.capture, other, actual); err == nil {
			t.Fatal("mixed provider multiplied network/port permissions")
		}
	}
	for _, remote := range []string{"192.168.50.53:5353", "198.18.0.1:443", "198.18.0.2:443"} {
		if _, err := f.kernel.Select(context.Background(), f.source.capture, "udp", netip.MustParseAddrPort(remote)); err == nil {
			t.Fatal("provider granted uncaptured or selected-inner DNS physical access")
		}
	}
	if !f.proof.Healthy() {
		t.Fatal("negative tuple checks mutated valid provider proof")
	}
}

func desktopOpenVPNCompositionRun(t *testing.T, start func(*testing.T, desktopOpenVPNCompositionPeerInput) *desktopOpenVPNCompositionProcess,
	create func(*testing.T, *desktopOpenVPNCompositionProcess, nativeopenvpn.Profile, []nativeopenvpn.Remote, string) *desktopOpenVPNCompositionFixture) {
	ca := newDesktopExternalIntegrationCA(t)
	if runtime.GOOS == "windows" {
		roots := x509.NewCertPool()
		cert, err := x509.ParseCertificate(ca.der)
		if err != nil {
			t.Fatal(err)
		}
		roots.AddCert(cert)
		t.Setenv("GODEBUG", os.Getenv("GODEBUG")+",x509usefallbackroots=1")
		x509.SetFallbackRoots(roots)
	}
	directory := t.TempDir()
	rootPath := filepath.Join(directory, "public-proof-ca.pem")
	if err := os.WriteFile(rootPath, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: ca.der}), 0600); err != nil {
		t.Fatal(err)
	}
	t.Setenv("SSL_CERT_FILE", rootPath)
	t.Setenv("SSL_CERT_DIR", directory)
	for _, name := range desktopOpenVPNCompositionCases {
		t.Run(name, func(t *testing.T) {
			network, control := "tcp", "tls-auth"
			if strings.HasPrefix(name, "udp-") || name == "mixed-fallback" || name == "captured-tuple-set" || name == "wrong-control-key" {
				network, control = "udp", "tls-crypt"
			}
			pki := desktopOpenVPNCompositionCertificates(t)
			certificate := ca.certificate(t, true)
			private, err := x509.MarshalPKCS8PrivateKey(certificate.PrivateKey)
			if err != nil {
				t.Fatal(err)
			}
			fault := ""
			if name == "cancelled-proof" || name == "reconnect-during-public-proof" {
				fault = "held-proof"
			}
			if name == "selected-dns-failure" {
				fault = "dns"
			}
			process := start(t, desktopOpenVPNCompositionPeerInput{Schema: 1, Network: network, Control: control, ControlKey: desktopOpenVPNCompositionControlKey(), CA: pki.ca,
				Certificate: pki.provider, Key: pki.providerKey, PublicCertificate: string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificate.Certificate[0]})), PublicKey: string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: private})), Fault: fault})
			remote, err := nativeopenvpn.ParseRemote(process.initial.Remote, network)
			if err != nil {
				t.Fatal(err)
			}
			remotes := []nativeopenvpn.Remote{remote}
			if name == "tcp-fallback" || name == "mixed-fallback" || name == "captured-tuple-set" {
				unavailable, err := nativeopenvpn.ParseRemote(process.initial.UnavailableRemote, "tcp")
				if err != nil {
					t.Fatal(err)
				}
				remotes = append([]nativeopenvpn.Remote{unavailable}, remotes...)
			}
			if name == "wrong-provider-trust" {
				pki.ca = desktopOpenVPNCompositionCertificates(t).ca
			}
			profile := desktopOpenVPNCompositionProfile(pki, remotes, control, name)
			f := create(t, process, profile, remotes, desktopTorBoxSession)
			switch name {
			case "tcp-proof-mtu-latency50", "udp-proof-mtu-latency50":
				receipt := f.prove(t)
				f.mtu(t, receipt)
				f.latency(t, receipt)
			case "tcp-fallback", "mixed-fallback":
				f.prove(t)
				f.kernel.mu.Lock()
				first := false
				for _, issued := range f.kernel.issued {
					if issued.grant.Network == "tcp" && int(issued.grant.Remote.Port()) == remotes[0].Port {
						first = true
					}
				}
				f.kernel.mu.Unlock()
				if !first {
					t.Fatal("provider fallback skipped the original first transport")
				}
			case "tcp-reconnect-rejects-old-proof", "udp-reconnect-rejects-old-proof":
				f.reconnect(t, profile)
			case "reconnect-during-public-proof":
				f.heldProof(t, true)
			case "cancelled-proof":
				f.heldProof(t, false)
			case "wrong-provider-trust", "wrong-control-key":
				f.authenticationFailure(t, name == "wrong-control-key")
			case "selected-dns-failure":
				done := f.runAsync(t)
				f.rejected(t, done)
				stats := f.process.observe(t, "stats")
				if stats.DNS == 0 || stats.PublicAttempts != 0 || stats.PublicRequests != 0 || stats.TLS != 0 {
					t.Fatal("selected DNS negative bypassed its actual encrypted resolver", stats)
				}
			case "captured-tuple-set":
				f.prove(t)
				f.tuples(t)
			default:
				t.Fatal("unimplemented mandatory OpenVPN composition case")
			}
			f.assertCapture(t)
		})
	}
}
