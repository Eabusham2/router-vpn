			}
			if _, err := owner.observe(context.Background()); err == nil || owner.state == nil || *owner.state != original {
				t.Fatal("retired child re-adopted a connection", fault, err)
			}
		})
	}
}

func TestRouterVPNImportedOpenVPNCallerContext(t *testing.T) {
	for _, fault := range []string{"owner-held", "native-held", "late-success"} {
		t.Run(fault, func(t *testing.T) {
			owner, _, endpoint, _ := importedOpenVPNFixture(t)
			original, err := owner.observe(context.Background())
			if err != nil {
				t.Fatal(err)
			}
			observed := owner.observedAt.Load()
			if observed == nil {
				t.Fatal("original connected observation has no freshness")
			}
			type key struct{}
			ctx, cancel := context.WithTimeout(context.WithValue(context.Background(), key{}, "original"), 20*time.Millisecond)
			defer cancel()
			if fault == "owner-held" {
				owner.mu.Lock()
			} else {
				endpoint.read = func(call context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
					expected, _ := ctx.Deadline()
					actual, ok := call.Deadline()
					if !ok || !actual.Equal(expected) || call.Value(key{}) != "original" {
						t.Error("actual native observation lost caller")
					}
					<-call.Done()
					if fault == "late-success" {
						next := original
						next.Remote.Generation++
						return next.Remote, next.MTU, nil
					}
					return nativeopenvpn.RemoteReceipt{}, 0, call.Err()
				}
			}
			_, err = owner.observe(ctx)
			if fault == "owner-held" {
				owner.mu.Unlock()
			}
			if !errors.Is(err, context.DeadlineExceeded) || owner.retired != nil || owner.state == nil || *owner.state != original || owner.observedAt.Load() != observed {
				t.Fatal("expiry retired or replaced healthy connection", fault, err)
			}
			endpoint.read = func(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
				return original.Remote, original.MTU, nil
			}
			if state, err := owner.observe(context.Background()); err != nil || state != original {
				t.Fatal("original connection could not resume observation", err)
			}
		})
	}
}

func TestRouterVPNImportedOpenVPNMailbox(t *testing.T) {
	for _, fault := range []string{"observe", "dns", "dns-failed", "reconnect-during-dns", "unknown-operation", "foreign-observer", "missing-observer"} {
		t.Run(fault, func(t *testing.T) {
			owner, _, endpoint, raw := importedOpenVPNFixture(t)
			files, request := importedDNSFiles(t, owner.tun, raw)
			tun := owner.tun
			if fault == "observe" {
				request.Operation = "openvpn-observe"
			}
			if fault == "unknown-operation" {
				request.Operation = "unowned"
			}
			if fault == "foreign-observer" {
				owner, _, _, _ = importedOpenVPNFixture(t)
			}
			if fault == "missing-observer" {
				request.Operation, owner = "openvpn-observe", nil
			}
			importedDNSWrite(t, files, "node-dns-request.json", request)
			calls := 0
			var generation uint64
			err := routerVPNConsumeImportedDNS(context.Background(), files, tun, &generation, func(context.Context) error {
				calls++
				if fault == "dns-failed" {
					return errors.New("selected resolver refused")
				}
				if fault == "reconnect-during-dns" {
					next := importedOpenVPNStateFixture()
					next.Remote.Generation++
					endpoint.read = func(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) { return next.Remote, next.MTU, nil }
				}
				return nil
			}, owner)
			body, readErr := files.read("node-dns-result.json", 4096)
			if fault == "unknown-operation" || fault == "foreign-observer" || fault == "missing-observer" {
				if err == nil || readErr == nil || calls != 0 {
					t.Fatal("unknown operation acquired proof")
				}
				return
			}
			var result routerVPNImportedDNSResult
			if err != nil || readErr != nil || !routerVPNMTUStrict(body, &result) {
				t.Fatal(err, readErr)
			}
			want := "passed"
			if fault == "dns-failed" || fault == "reconnect-during-dns" {
				want = "failed"
			}
			if result.Status != want || generation != 1 {
				t.Fatal("observation lent DNS authority", result.Status, generation)
			}
			if fault == "observe" {
				if calls != 0 || result.OpenVPN == nil || *result.OpenVPN != importedOpenVPNStateFixture() {
					t.Fatal("observation used DNS or lost real readback")
				}
			} else if calls != 1 || result.OpenVPN != nil {
				t.Fatal("DNS and packet receipt conflated", calls, result.OpenVPN)
			}
		})
	}
}

func TestRouterVPNImportedOpenVPNCancellationJoins(t *testing.T) {
	owner, _, endpoint, raw := importedOpenVPNFixture(t)
	original, err := owner.observe(context.Background())
	if err != nil {
		t.Fatal(err)
	}
	files, request := importedDNSFiles(t, owner.tun, raw)
	request.Operation = "openvpn-observe"
	importedDNSWrite(t, files, "node-dns-request.json", request)
	entered, cancelled, release := make(chan struct{}), make(chan struct{}), make(chan struct{})
	endpoint.read = func(ctx context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
		close(entered)
		<-ctx.Done()
		close(cancelled)
		<-release
		next := original
		next.Remote.Generation++
		return next.Remote, next.MTU, nil
	}
	var generation uint64
	var dns atomic.Int32
	done := make(chan error, 1)
	go func() {
		done <- routerVPNConsumeImportedDNS(context.Background(), files, owner.tun, &generation, func(context.Context) error { dns.Add(1); return nil }, owner)
	}()
	<-entered
	importedDNSWrite(t, files, "node-dns-cancel.json", request)
	select {
	case <-cancelled:
	case <-time.After(time.Second):
		t.Fatal("mailbox cancellation blocked behind native observation")
	}
	select {
	case err := <-done:
		t.Fatal("native query returned before its worker joined", err)
	default:
	}
	if _, err := files.root.Lstat("node-dns-result.json"); !errors.Is(err, os.ErrNotExist) {
		t.Fatal("receipt published before worker joined")
	}
	close(release)
	if err := <-done; err != nil {
		t.Fatal(err)
	}
	body, err := files.read("node-dns-result.json", 4096)
	var result routerVPNImportedDNSResult
	if err != nil || !routerVPNMTUStrict(body, &result) || result.Status != "cancelled" || result.OpenVPN != nil || dns.Load() != 0 || owner.retired != nil || *owner.state != original {
		t.Fatal("late success adopted after cancellation", err, result)
	}
	endpoint.read = func(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
		return original.Remote, original.MTU, nil
	}
	if state, err := owner.observe(context.Background()); err != nil || state != original {
		t.Fatal("cancelled read retired original endpoint", err)
	}
}

