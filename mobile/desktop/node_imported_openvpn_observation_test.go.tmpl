func importedOpenVPNGuardFixture(owner *routerVPNImportedOpenVPN) {
	original := owner.tun.guardContext
	owner.tun.openVPN = owner
	owner.tun.guardContext = func(ctx context.Context) error {
		if err := original(ctx); err != nil {
			return err
		}
		return owner.pinnedMTU(ctx)
	}
}

func TestRouterVPNNodeMTUImportedOpenVPNRetainsOwnedReaderHandoff(t *testing.T) {
	for _, ending := range []string{"commit", "rollback", "expiry", "unconfirmed-revert"} {
		t.Run(ending, func(t *testing.T) {
			observer, _, _, _ := importedOpenVPNFixture(t)
			original, err := observer.observe(context.Background())
			if err != nil {
				t.Fatal(err)
			}
			owner := observer.tun
			first := owner.inbound
			desktopNodeMTUApply(t, owner, "begin", 0)
			if observer.pinned(context.Background()) == nil {
				t.Fatal("ordinary DNS or measurement admitted during the owned MTU lease")
			}
			if actual, err := observer.observeMTU(context.Background()); err != nil || actual != original {
				t.Fatal("exact MTU lease could not reobserve its original packet endpoint", actual, err)
			}
			desktopNodeMTUApply(t, owner, "set", 1380)
			if owner.inbound == first || observer.inbound != owner.inbound || observer.record.Reader != owner.record.Reader || observer.record.MTU != 1380 || *observer.state != original {
				t.Fatal("owned mutation did not hand off only the returned TUN reader")
			}
			switch ending {
			case "commit":
				desktopNodeMTUApply(t, owner, "commit", 0)
			case "rollback":
				desktopNodeMTUApply(t, owner, "rollback", 0)
			case "expiry":
				if err := owner.expire(owner.deadline.Add(time.Second)); err != nil {
					t.Fatal("original lease expiry could not restore its owned reader", err)
				}
				// Expiry publishes its terminal failure receipt; normal measurements
				// must still reject that retired operation.
				if !owner.record.Restored || observer.inbound != owner.inbound || owner.record.MTU != 1420 {
					t.Fatal("expiry lost actual returned original-value reader")
				}
				if actual, err := observer.observeMTU(context.Background()); err != nil || actual != original || observer.pinned(context.Background()) == nil {
					t.Fatal("expired rollback could not publish its exact receipt or admitted ordinary proof", err)
				}
				return
			case "unconfirmed-revert":
				commit := desktopNodeMTURequest(owner, "commit", 0)
				commit.RevertToken = strings.Repeat("f", 32)
				if err := owner.command(commit); err != nil {
					t.Fatal(err)
				}
				owner.record.Generation, owner.record.Request = commit.Generation, commit.Request
				revert := desktopNodeMTURequest(owner, "revert-unconfirmed-commit", 1420)
				revert.CommitRequest, revert.CommitGeneration, revert.RevertToken = commit.Request, commit.Generation, commit.RevertToken
				if err := owner.command(revert); err != nil {
					t.Fatal("exact unconfirmed commit could not return its owned TUN reader", err)
				}
			}
			if actual, err := observer.observe(context.Background()); err != nil || actual != original || observer.inbound != owner.inbound {
				t.Fatal("completed lease changed the original authenticated packet connection", actual, err)
			}
			if ending != "commit" && (owner.record.MTU != 1420 || !owner.record.Restored) {
				t.Fatal("owned cancellation did not restore the original measured interface")
			}
		})
	}
}

func TestRouterVPNNodeMTUImportedOpenVPNCancelledChangeKeepsReturnedRollback(t *testing.T) {
	observer, _, _, _ := importedOpenVPNFixture(t)
	original, err := observer.observe(context.Background())
	if err != nil {
		t.Fatal(err)
	}
	owner := observer.tun
	desktopNodeMTUApply(t, owner, "begin", 0)
	desktopNodeMTUApply(t, owner, "set", 1360)
	previous := owner.inbound
	parent, cancel := context.WithCancel(owner.ctx)
	defer cancel()
	engine := owner.engine.(*desktopNodeMTUEngineFixture)
	engine.change = func(_ context.Context, previous adapter.Inbound, _ int) (adapter.Inbound, error) {
		old := previous.(*desktopMTUTUNFixture)
		next := &desktopMTUTUNFixture{index: old.index + 1, mtu: old.mtu, guard: old.guard, guardContext: old.guardContext}
		engine.current = next
		cancel()
		return next, context.Canceled
	}
	request := desktopNodeMTURequest(owner, "set", 1280)
	if err := owner.commandContext(parent, request); err == nil || owner.inbound == previous || observer.inbound != owner.inbound || owner.record.MTU != 1360 || observer.record.Reader != owner.record.Reader || *observer.state != original {
		t.Fatal("cancelled native transaction lost its exact returned rollback reader", err)
	}
	owner.record.Generation, owner.record.Request = request.Generation, request.Request
	owner.record.Failure = "captured TUN operation rejected"
	engine.change = nil
	desktopNodeMTUApply(t, owner, "rollback", 0)
	owner.record.Failure = "" // The shipping file consumer clears an accepted command.
	if actual, err := observer.observe(context.Background()); err != nil || actual != original || owner.record.MTU != 1420 || !owner.record.Restored || owner.record.Active {
		t.Fatal("original cancellation could not restore its retained packet connection", err)
	}
}

func TestRouterVPNNodeMTUImportedOpenVPNRejectsForeignHandoff(t *testing.T) {
	for _, fault := range []string{"lease", "reader", "generation", "capacity", "endpoint", "path", "cancelled"} {
		t.Run(fault, func(t *testing.T) {
			observer, instance, endpoint, _ := importedOpenVPNFixture(t)
			if _, err := observer.observe(context.Background()); err != nil {
				t.Fatal(err)
			}
			owner := observer.tun
			desktopNodeMTUApply(t, owner, "begin", 0)
			before, reader := observer.record, observer.inbound
			originalContext, cancelOriginal := context.WithCancel(owner.ctx)
			defer cancelOriginal()
			owner.ctx = originalContext
			engine := owner.engine.(*desktopNodeMTUEngineFixture)
			engine.change = func(ctx context.Context, previous adapter.Inbound, value int) (adapter.Inbound, error) {
				old := previous.(*desktopMTUTUNFixture)
				next := &desktopMTUTUNFixture{index: old.index + 1, mtu: value, guard: old.guard, guardContext: old.guardContext}
				engine.current = next
				switch fault {
				case "lease":
					owner.record.Lease = strings.Repeat("0", 32)
				case "reader":
					owner.record.Reader++
				case "generation", "capacity":
					endpoint.read = func(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
						s := importedOpenVPNStateFixture()
						if fault == "generation" {
							s.Remote.Generation++
						} else {
							s.MTU++
						}
						return s.Remote, s.MTU, nil
					}
				case "endpoint":
					if err := instance.Endpoint().Remove("entry-wg"); err != nil {
						t.Error(err)
					}
				case "path":
					observer.path = func(context.Context) error { return errors.New("original physical path changed") }
				case "cancelled":
					cancelOriginal()
					return next, context.Canceled
				}
				return next, nil
			}
			if err := owner.command(desktopNodeMTURequest(owner, "set", 1380)); err == nil {
				t.Fatal("foreign or cancelled reader acquired the original OpenVPN observer", fault)
			}
			if observer.record != before || observer.inbound != reader {
				t.Fatal("failed handoff replaced the original captured observer", fault)
			}
		})
	}
}

func TestRouterVPNImportedOpenVPNConstructor(t *testing.T) {
	for _, fault := range []string{"original", "digest", "duplicate-entry", "system", "multiple-remotes", "nonliteral", "capacity", "expired", "replacement-before-ready"} {
		t.Run(fault, func(t *testing.T) {
			instance, raw, tun, endpoint := importedOpenVPNBoxFixture(t)
			ctx := context.Background()
			switch fault {
			case "digest":
				tun.record.Config = strings.Repeat("f", 64)
			case "duplicate-entry":
				raw = []byte(strings.Replace(string(raw), `],"outbounds"`, `,{"type":"direct","tag":"entry-wg"}],"outbounds"`, 1))
			case "system":
				raw = []byte(strings.Replace(string(raw), `"system":false`, `"system":true`, 1))
			case "multiple-remotes":
				raw = []byte(strings.Replace(string(raw), `"server":"203.0.113.24","server_port":1194`, `"servers":[{"server":"203.0.113.24","server_port":1194,"network":"udp"},{"server":"203.0.113.25","server_port":1194,"network":"udp"}]`, 1))
			case "nonliteral":
				raw = []byte(strings.Replace(string(raw), `203.0.113.24`, `provider.example`, 1))
			case "capacity":
				raw = []byte(strings.Replace(string(raw), `"mtu":1420`, `"mtu":1279`, 1))
			case "expired":
				var cancel context.CancelFunc
				ctx, cancel = context.WithCancel(ctx)
				cancel()
			}
			if fault != "digest" {
				digest := sha256.Sum256(raw)
				tun.record.Config = hex.EncodeToString(digest[:])
			}
			owner, err := newRouterVPNImportedOpenVPN(ctx, instance, raw, tun)
			if fault != "original" && fault != "replacement-before-ready" {
				if err == nil || owner != nil {
					t.Fatal("unowned constructor admitted", fault)
				}
				if fault == "expired" && !errors.Is(err, context.Canceled) {
					t.Fatal("constructor lost original cancellation", err)
				}
				return
			}
			if err != nil || owner == nil {
				t.Fatal(err)
			}
			if fault == "replacement-before-ready" {
				endpoint.read = func(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
					return nativeopenvpn.RemoteReceipt{}, 0, nativeopenvpn.ErrRemotePending
				}
				if _, err := owner.observe(ctx); !errors.Is(err, nativeopenvpn.ErrRemotePending) {
					t.Fatal("initial pending changed", err)
				}
				if err := instance.Endpoint().Remove("entry-wg"); err != nil {
					t.Fatal(err)
				}
				endpoint.read = func(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
					state := importedOpenVPNStateFixture()
					return state.Remote, state.MTU, nil
				}
				if err := instance.Endpoint().Create(ctx, instance.Router(), log.NewNOPFactory().Logger(), "entry-wg", "openvpn-client", &option.OpenVPNClientEndpointOptions{}); err != nil {
					t.Fatal(err)
				}
				// The manager is the real captured manager. A replacement under the same
				// tag must fail even before the first successful native TLS observation.
				if _, err := owner.observe(ctx); err == nil || errors.Is(err, nativeopenvpn.ErrRemotePending) {
					t.Fatal("replacement endpoint acquired the original pending owner", err)
				}
				if owner.state != nil || owner.retired == nil {
					t.Fatal("pending owner was recaptured")
				}
				return
			}
			state, err := owner.observe(ctx)
			if err != nil || state != importedOpenVPNStateFixture() {
				t.Fatal("original capacity not retained", state, err)
			}
		})
	}
}

func TestRouterVPNImportedOpenVPNOriginalTuple(t *testing.T) {
	for _, fault := range []string{"generation", "remote", "port", "network", "connected-at", "capacity", "too-small", "pending", "reader", "reader-pointer", "interface", "index", "tun-mtu", "path", "source", "active", "failure"} {
		t.Run(fault, func(t *testing.T) {
			owner, _, endpoint, _ := importedOpenVPNFixture(t)
			original, err := owner.observe(context.Background())
			if err != nil {
				t.Fatal(err)
			}
			record := owner.tun.record
			inbound := owner.tun.inbound
			next := original
			switch fault {
			case "generation":
				next.Remote.Generation++
			case "remote":
				next.Remote.Host = "203.0.113.25"
			case "port":
				next.Remote.Port++
			case "network":
				next.Remote.Network = "tcp"
			case "connected-at":
				next.Remote.ConnectedAt++
			case "capacity":
				next.MTU++
			case "too-small":
				next.MTU = 1280
			case "reader":
				owner.tun.record.Reader++
			case "reader-pointer":
				owner.tun.inbound = &desktopMTUTUNFixture{index: 17, mtu: 1420}
			case "interface":
				owner.tun.record.Interface = "foreign"
			case "index":
				owner.tun.record.Index++
			case "tun-mtu":
				owner.tun.record.MTU++
			case "path":
				owner.tun.record.Path = strings.Repeat("f", 64)
			case "source":
				owner.tun.record.Config = strings.Repeat("f", 64)
			case "active":
				owner.tun.record.Active = true
			case "failure":
				owner.tun.record.Failure = "unconfirmed"
			}
			endpoint.read = func(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
				if fault == "pending" {
					return nativeopenvpn.RemoteReceipt{}, 0, nativeopenvpn.ErrRemotePending
				}
