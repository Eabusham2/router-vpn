func importedOpenVPNBoxFixture(t *testing.T) (*box.Box, []byte, *routerVPNNodeMTU, *importedOpenVPNEndpointFixture) {
	t.Helper()
	registry := include.EndpointRegistry()
	endpoint := &importedOpenVPNEndpointFixture{tag: "entry-wg"}
	endpoint.read = func(ctx context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
		s := importedOpenVPNStateFixture()
		return s.Remote, s.MTU, ctx.Err()
	}
	var created atomic.Int32
	E.Register[option.OpenVPNClientEndpointOptions](registry, "openvpn-client", func(context.Context, adapter.Router, log.ContextLogger, string, option.OpenVPNClientEndpointOptions) (adapter.Endpoint, error) {
		if created.Add(1) > 1 {
			replacement := *endpoint
			return &replacement, nil
		}
		return endpoint, nil
	})
	ctx := box.Context(context.Background(), include.InboundRegistry(), include.OutboundRegistry(), registry, include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
	raw := []byte(`{"log":{"disabled":true},"endpoints":[{"type":"openvpn-client","tag":"entry-wg","system":false,"server":"203.0.113.24","server_port":1194,"network":"udp","mtu":1420}],"outbounds":[{"type":"direct","tag":"proxy"}],"route":{"final":"proxy"}}`)
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
	if err != nil {
		t.Fatal(err)
	}
	instance, err := box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := instance.Close(); err != nil {
			t.Error(err)
		}
	})
	tun, _, _ := desktopNodeMTUFixture(t)
	digest := sha256.Sum256(raw)
	tun.record.Config = hex.EncodeToString(digest[:])
	return instance, raw, tun, endpoint
}
func importedOpenVPNFixture(t *testing.T) (*routerVPNImportedOpenVPN, *box.Box, *importedOpenVPNEndpointFixture, []byte) {
	t.Helper()
