func desktopCandidatePrefixCommandPolicy(t *testing.T, target string) *mobilemultihop.DesktopNodeCandidatePreparationPolicy {
	t.Helper()
	original := desktopNodeChainCommandPolicy(t, 3, target, 0)
	input, err := original.OriginalChain().LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(input), &source) != nil {
		t.Fatal("fixture lost original source")
	}
	raw, err := json.Marshal(source)
	if err != nil {
		t.Fatal(err)
	}
	inventory, err := json.Marshal(mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-desktop-catalog", Inputs: []string{source.Nodes[2]}})
	if err != nil {
		t.Fatal(err)
	}
	base, err := mobilemultihop.NewNodeChainCandidatePreparation(string(raw), 1, string(inventory))
	if err != nil {
		t.Fatal(err)
	}
	policy, err := mobilemultihop.NewDesktopNodeCandidatePreparationPolicy(base, desktopExternalSession, target, 0)
	if err != nil {
		t.Fatal(err)
	}
	return policy
}

func TestRouterVPNDesktopCandidatePrefixCommandJournalAttribution(t *testing.T) {
	for _, target := range []string{"linux", "windows"} {
		t.Run(target, func(t *testing.T) {
			policy := desktopCandidatePrefixCommandPolicy(t, target)
			meta := policy.Metadata()
			if meta.PolicyProfileID != "ordered-router-2" || meta.ProfileID != "ordered-router-1" || meta.KillSwitchPolicy != "always" {
				t.Fatal("prefix journal fixture lost distinct saved control and native proof")
			}
			transfer := mobiletor.DesktopProtectionTransferRecord{Schema: 1, Kind: "routervpn-windows-protection-transfer-v1",
				SessionID: meta.SessionID, SourceSHA256: meta.SourceSHA256, ConfigSHA256: meta.ConfigSHA256, Policy: meta.KillSwitchPolicy}
			physical, digest, err := routerVPNNodeJournalPolicyBinding(policy, meta.PolicyProfileID, &transfer, &transfer)
			if err != nil || digest == "" || physical.ProfileID != meta.ProfileID || physical.NodeID != meta.NodeID {
				t.Fatal("journal lost full saved control or changed actual prefix proof", err)
			}
			for _, fault := range []string{"prefix-profile", "foreign-profile", "session", "source", "config", "policy", "captured-transfer", "nil-expected", "nil-captured"} {
				t.Run(fault, func(t *testing.T) {
					profile, expected, captured := meta.PolicyProfileID, transfer, transfer
					switch fault {
					case "prefix-profile":
						profile = meta.ProfileID
					case "foreign-profile":
						profile = "foreign-original-control"
					case "session":
						expected.SessionID = strings.Repeat("f", 32)
						captured = expected
					case "source":
						expected.SourceSHA256 = strings.Repeat("f", 64)
						captured = expected
					case "config":
						expected.ConfigSHA256 = strings.Repeat("f", 64)
						captured = expected
					case "policy":
						expected.Policy = "on-connect"
						captured = expected
					case "captured-transfer":
						captured.SessionID = strings.Repeat("f", 32)
					}
					wanted, original := &expected, &captured
					if fault == "nil-expected" {
						wanted = nil
					}
					if fault == "nil-captured" {
						original = nil
					}
					if _, _, err := routerVPNNodeJournalPolicyBinding(policy, profile, wanted, original); err == nil {
						t.Fatal("journal accepted foreign saved control or physical transfer", fault)
					}
				})
			}
			// Existing complete-graph journal attribution remains its physical
			// final profile; prefix support grants no alternative ordinary ID.
			ordinary := desktopNodeChainCommandPolicy(t, 3, target, 0)
			_, ordinaryMeta, _, err := mobilemultihop.ReadDesktopPhysicalPolicy(ordinary)
			if err != nil {
				t.Fatal(err)
			}
			ordinaryTransfer := transfer
			ordinaryTransfer.SourceSHA256, ordinaryTransfer.ConfigSHA256 = ordinaryMeta.SourceSHA256, ordinaryMeta.ConfigSHA256
			if _, _, err := routerVPNNodeJournalPolicyBinding(ordinary, ordinaryMeta.ProfileID, &ordinaryTransfer, &ordinaryTransfer); err != nil {
				t.Fatal("ordinary journal lost original profile binding", err)
			}
			if _, _, err := routerVPNNodeJournalPolicyBinding(ordinary, meta.ProfileID, &ordinaryTransfer, &ordinaryTransfer); err == nil {
				t.Fatal("ordinary journal borrowed prefix profile")
			}
		})
	}
}

func TestRouterVPNDesktopCandidatePrefixCommandExactSourceReplay(t *testing.T) {
	for _, target := range []string{"linux", "windows"} {
		t.Run(target, func(t *testing.T) {
			policy := desktopCandidatePrefixCommandPolicy(t, target)
			meta := policy.Metadata()
			files := desktopImportedCommandFiles(t, map[string]string{"node-candidate-prefix-source.json": policy.Source(), "sing-box.json": policy.Config()})
			actual, err := routerVPNNodeCandidatePrefixCommandCapture(files, meta.SessionID, meta.ConfigSHA256, meta.SourceSHA256, meta.CaptureSHA256, target, 0)
			if err != nil || actual == nil || actual == policy || actual.Preparation() == policy.Preparation() || actual.Source() != policy.Source() || actual.Config() != policy.Config() {
				t.Fatal("child did not independently replay original prefix source", err)
			}
		})
	}
}

func TestRouterVPNDesktopCandidatePrefixCommandRejectsSubstitution(t *testing.T) {
	policy := desktopCandidatePrefixCommandPolicy(t, "linux")
	for _, fault := range []string{"missing", "ordinary", "generic", "source", "capture", "config", "session", "target", "darwin", "restore", "graph", "ambiguous-node", "ambiguous-chain", "ambiguous-execution", "ambiguous-imported"} {
		t.Run(fault, func(t *testing.T) {
			meta := policy.Metadata()
			input, graph, target, restore := policy.Source(), policy.Config(), "linux", 0
			extra := map[string]string{}
			switch fault {
			case "missing":
				input = ""
			case "ordinary":
				input, _ = desktopNodeChainCommandPolicy(t, 3, "linux", 0).NodeChain().LaunchInput()
			case "generic":
				var raw struct {
					Preparation string `json:"preparation"`
				}
				if json.Unmarshal([]byte(input), &raw) != nil || raw.Preparation == "" {
					t.Fatal("fixture lost generic source")
				}
				input = raw.Preparation
			case "source":
				meta.SourceSHA256 = strings.Repeat("f", 64)
			case "capture":
				meta.CaptureSHA256 = strings.Repeat("f", 64)
			case "config":
				meta.ConfigSHA256 = strings.Repeat("f", 64)
			case "session":
				meta.SessionID = strings.Repeat("f", 32)
			case "target":
				target = "windows"
			case "darwin":
				target = "darwin"
			case "restore":
				restore = 1300
			case "graph":
				graph += " "
			case "ambiguous-node":
				extra["node-source.json"] = "{}"
			case "ambiguous-chain":
				extra["node-chain-source.json"] = "{}"
			case "ambiguous-execution":
				extra["node-chain-execution-source.json"] = "{}"
			case "ambiguous-imported":
				extra["imported-source.json"] = "{}"
			}
			extra["sing-box.json"] = graph
			if input != "" {
				extra["node-candidate-prefix-source.json"] = input
			}
			files := desktopImportedCommandFiles(t, extra)
			if _, err := routerVPNNodeCandidatePrefixCommandCapture(files, meta.SessionID, meta.ConfigSHA256, meta.SourceSHA256, meta.CaptureSHA256, target, restore); err == nil {
				t.Fatal("prefix child accepted foreign or ambiguous source")
			}
		})
	}
}
