func desktopPhysicalBoxFixture(t *testing.T) *desktopTorBoxFixture {
	t.Helper()
	return newDesktopTorBoxCapturedFixture(t, func(profile map[string]any) {
		profile["external"] = map[string]any{"protocol": "tor"}
		profile["kill_switch_policy"] = "always"
	}, nil, routervpndesktoppt.RegisterPhysicalOutbound)
}

func TestRouterVPNDesktopTorPhysicalBoxCapturesExactFactoryBeforeStartup(t *testing.T) {
	if runtime.GOOS != "linux" {
		t.Skip("Linux isolated socket factory")
	}
	f := desktopPhysicalBoxFixture(t)
	if !f.policy.PhysicalBroker() {
		t.Fatal("strict dynamic source did not retain the required physical factory")
	}
	for _, fault := range []string{"session", "source", "resolver"} {
		var profile map[string]any
		if err := json.Unmarshal([]byte(f.policy.Profile()), &profile); err != nil {
			t.Fatal(err)
		}
		session := desktopTorBoxSession
		switch fault {
		case "session":
			session = strings.Repeat("f", 32)
		case "source":
			profile["id"] = "another-captured-source"
		case "resolver":
			profile["dns_port"] = 5354
		}
		raw, err := json.Marshal(profile)
		if err != nil {
			t.Fatal(err)
		}
		foreign, err := mobiletor.NewDesktopBridgePolicy(string(raw), session, desktopTorBoxIsolation, "linux")
		if err != nil {
			t.Fatal(err)
		}
		if err := f.box.RouterVPNDesktopTorPreparePhysical(foreign); err == nil {
			t.Fatal("foreign source installed a native physical factory", fault)
		}
	}
	// Preparing uses the real compiled Box/service/outbound graph and launches
	// no process. Privileged creation occurs only in native Initialize, whose
	// real Linux kernel behavior is verified in the isolated namespace suite.
	if err := f.box.RouterVPNDesktopTorPreparePhysical(f.policy); err != nil {
		t.Fatal(err)
	}
	if err := f.box.RouterVPNDesktopTorPreparePhysical(f.policy); err == nil {
		t.Fatal("a second host preparation replaced the physical factory")
	}
	if _, err := f.box.RouterVPNDesktopTorCreate(f.policy); err == nil {
		t.Fatal("prepared factory was mistaken for a started/proved native path")
	}
	if f.tun.ready || f.tun.claimed {
		t.Fatal("physical preparation started or claimed the TUN")
	}
}

func TestRouterVPNDesktopTorPhysicalBoxRefusesUnprovisionedStart(t *testing.T) {
	if runtime.GOOS != "linux" {
		t.Skip("Linux isolated socket factory")
	}
	f := desktopPhysicalBoxFixture(t)
	if err := f.box.RouterVPNStrategyStart(); err == nil {
		t.Fatal("a JSON flag started a protected path without its OS factory")
	}
	if f.tun.ready || f.tun.claimed {
		t.Fatal("an unprovisioned physical owner reached TUN admission")
	}
	if _, err := f.box.RouterVPNDesktopTorCreate(f.policy); err == nil {
		t.Fatal("failed physical initialization acquired Connected authority")
	}
}

func TestRouterVPNDesktopTorFixedPhysicalBoxRequiresCapturedFactory(t *testing.T) {
	if runtime.GOOS != "linux" {
		t.Skip("Linux isolated socket factory")
	}
	for _, provision := range []bool{false, true} {
		t.Run(map[bool]string{false: "missing-factory", true: "captured-factory"}[provision], func(t *testing.T) {
			f := newDesktopTorBoxCapturedFixture(t, func(profile map[string]any) {
				profile["kill_switch_policy"] = "always"
			}, nil, routervpndesktoppt.RegisterPhysicalOutbound)
			if !f.policy.PhysicalBroker() || f.policy.Mode() != "tor-bridge" {
				t.Fatal("fixed bridge retained the legacy endpoint-policy path")
			}
			if provision {
				if err := f.box.RouterVPNDesktopTorPreparePhysical(f.policy); err != nil {
					t.Fatal("fixed bridge did not bind its exact native factory", err)
				}
				if err := f.box.RouterVPNDesktopTorPreparePhysical(f.policy); err == nil {
					t.Fatal("fixed bridge replaced its captured native factory")
				}
			} else if err := f.box.RouterVPNStrategyStart(); err == nil {
				t.Fatal("fixed bridge started without an owned physical factory")
			}
			if f.tun.ready || f.tun.claimed {
				t.Fatal("unstarted fixed-bridge factory acquired tunnel authority")
			}
			if _, err := f.box.RouterVPNDesktopTorCreate(f.policy); err == nil {
				t.Fatal("fixed bridge reported a proved path before native initialization")
			}
		})
	}
}

func TestRouterVPNDesktopTorPhysicalRegistrationContext(t *testing.T) {
	if runtime.GOOS != "linux" {
		t.Skip("Linux isolated socket factory")
	}
	for _, mode := range []string{"expired", "no-deadline", "live"} {
		t.Run(mode, func(t *testing.T) {
			f := desktopPhysicalBoxFixture(t)
			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
			defer cancel()
			if mode == "expired" {
				cancel()
			}
			var err error
			if mode == "no-deadline" {
				err = f.box.RouterVPNDesktopTorPreparePhysicalContext(context.Background(), f.policy)
			} else {
				err = f.box.RouterVPNDesktopTorPreparePhysicalContext(ctx, f.policy)
			}
			if mode == "live" {
				if err != nil {
					t.Fatal(err)
				}
				cancel()
			} else {
				if err == nil {
					t.Fatal("Box registered with no original budget")
				}
				if mode == "expired" && !errors.Is(err, context.Canceled) {
					t.Fatal("Box lost original cancellation", err)
				}
			}
			fresh, stop := context.WithTimeout(context.Background(), time.Second)
			defer stop()
			if mode != "live" {
				if err := f.box.RouterVPNDesktopTorPreparePhysicalContext(fresh, f.policy); err != nil {
					t.Fatal("expired observer poisoned original Box registration", err)
				}
			}
			if err := f.box.RouterVPNDesktopTorPreparePhysicalContext(fresh, f.policy); err == nil {
				t.Fatal("Box replaced captured factory")
			}
			if f.tun.ready || f.tun.claimed {
				t.Fatal("registration granted native TUN startup")
			}
		})
	}
}
