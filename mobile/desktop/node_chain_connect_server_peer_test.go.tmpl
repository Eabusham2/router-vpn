func TestRouterVPNDesktopNodeChainCONNECTServerReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NODE_CHAIN_CONNECT_SERVER_REFERENCE_CHILD") == "" {
		t.Skip("isolated inherited custom reference only")
	}
	if os.Getenv("ROUTERVPN_NODE_CHAIN_CONNECT_SERVER_REFERENCE_CHILD") != "1" {
		t.Fatal("uncaptured custom reference")
	}
	reader := bufio.NewReaderSize(os.Stdin, 32<<10+1)
	line, err := reader.ReadSlice('\n')
	if err != nil || len(line) > 32<<10 {
		t.Fatal("bounded custom reference request required")
	}
	var request struct {
		Schema   int                         `json:"schema"`
		Paired   desktopNodeChainPeerRequest `json:"paired"`
		Protocol string                      `json:"protocol"`
		Username string                      `json:"username"`
		Password string                      `json:"password"`
	}
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	if decoder.Decode(&request) != nil || decoder.Decode(new(any)) != io.EOF || (request.Schema != 1 && request.Schema != 2) || request.Protocol != "http-connect" && request.Protocol != "https-connect" || request.Username == "" || request.Password == "" {
		t.Fatal("custom reference source changed")
	}
	// The existing peer topology helper carries an unused SS fixture marker;
	// its imported provider is replaced below by the actual authenticated CONNECT
	// endpoint. No SS marker enters the compiled client or worker source.
	topology := desktopNodeChainImportedRequest{request.Schema, request.Paired, mobilemultihop.NativeStartLayerMethod, base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, 32))}
	if desktopNodeChainImportedServerRequestValid(topology) != nil {
		t.Fatal("original paired topology invalid")
	}
	local, remote := netip.MustParseAddr(request.Paired.Address), netip.MustParseAddr(request.Paired.ClientAddress)
	interfaces, err := net.Interfaces()
	found := false
	for _, iface := range interfaces {
		addresses, e := iface.Addrs()
		if e != nil {
			t.Fatal(e)
		}
		for _, value := range addresses {
			prefix, e := netip.ParsePrefix(value.String())
			found = found || e == nil && prefix.Addr() == local && iface.Flags&net.FlagUp != 0 && iface.Flags&net.FlagLoopback == 0
		}
	}
	if err != nil || !found {
		t.Fatal("custom reference requires original physical namespace")
	}
	// Bind the original captured CONNECT endpoint on the owned namespace
	// address. Never rewrite a compiled physical tuple or substitute a dialer.
	var peer *desktopNodeChainImportedPeer
	var provider *desktopImportedCONNECTPeer
	var proxyCA string
	var chain *desktopNodeChainPeer
	if request.Schema == 2 {
		peer, provider, proxyCA, chain = desktopNodeChainCONNECTServerPrefixes(t, topology, request.Protocol, request.Username, request.Password, local, remote)
	} else {
		peer, provider, proxyCA = desktopNodeChainCONNECTServerPeerStart(t, topology, request.Protocol, request.Username, request.Password, local, remote)
	}
	respond := func() {
		snapshot, middle := peer.snapshot(), peer.provider.address
		if chain != nil {
			actual := chain.snapshot()
			snapshot.Address, snapshot.Prefixes = actual.Address, actual.Prefixes
			middle = "10.79.0.1:8388"
		}
		if json.NewEncoder(os.Stdout).Encode(map[string]any{"peer": snapshot, "middle_address": middle, "protocol": request.Protocol, "proxy_ca": proxyCA, "middle_auth": provider.auth.Load(), "tls_refused": provider.tlsRefused.Load()}) != nil {
			t.Fatal("custom reply pipe failed")
		}
	}
	respond()
	for {
		line, err = reader.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 64 {
			t.Fatal("custom control pipe failed")
		}
		command := strings.TrimSuffix(string(line), "\n")
		if command == "quit" {
			return
		}
		if peer.control(command) != nil {
			t.Fatal("uncaptured custom control")
		}
		respond()
	}
}

// Both the inherited native process and this component use the same actual
// provider construction. CONNECT is TCP-only; final selected DNS/UDP belongs
// to the original authenticated Shadowsocks UoT-v2 stream router.
func desktopNodeChainCONNECTServerPeerStart(t *testing.T, topology desktopNodeChainImportedRequest, protocol, username, password string, local, remote netip.Addr) (*desktopNodeChainImportedPeer, *desktopImportedCONNECTPeer, string) {
	t.Helper()
	certificate, proxyCA := desktopNodeChainImportedCertificate(t)
	var provider *desktopImportedCONNECTPeer
	peer := desktopNodeChainImportedPeerStartWithHooks(t, topology, local, remote, nil, &desktopNodeChainImportedPeerHooks{
		decorate: func(original *desktopNodeWGHandler) tun.Handler { return original },
		middle: func(owner *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
			owner.streamRouter = &nodeCONNECTRunMiddleRouter{server: owner}
			var secured *tls.Certificate
			if protocol == "https-connect" {
				secured = &certificate
			} else {
				proxyCA = ""
			}
			provider = desktopStartImportedCONNECTPeerAt(t, owner, username, password, secured, func() { t.Error("unowned cancellation") }, "", local)
			return desktopExternalInstalledSSPeer{address: provider.address, close: provider.close}
		},
	})
	peer.paired.final.streamRouter = UOT.NewRouter(&desktopImportedCONNECTRouter{server: peer.paired.final}, log.NewNOPFactory().Logger())
	return peer, provider, proxyCA
}

// Every remote packet prefix is the actual retained reference device. Only
// the last one grants TCP to the captured CONNECT address; earlier devices
// retain the existing next-packet UDP and private-proof grants.
func desktopNodeChainCONNECTServerPrefixes(t *testing.T, request desktopNodeChainImportedRequest, protocol, username, password string, local, remote netip.Addr) (*desktopNodeChainImportedPeer, *desktopImportedCONNECTPeer, string, *desktopNodeChainPeer) {
	t.Helper()
	if request.Schema != 2 || desktopNodeChainImportedServerRequestValid(request) != nil {
		t.Fatal("invalid CONNECT Server prefix source")
	}
	count := len(request.Paired.Prefixes)
	ipcs, err := desktopNodeChainPeerIdentityBounds(request.Paired, 1, 5)
	if err != nil {
		t.Fatal(err)
	}
	last := request
	last.Schema = 1
	last.Paired.Prefixes = request.Paired.Prefixes[count-1:]
	loopback := netip.MustParseAddr("127.0.0.1")
	bindLocal, bindRemote := loopback, loopback
	if count == 1 {
		bindLocal, bindRemote = local, remote
	}
	peer, provider, ca := desktopNodeChainCONNECTServerPeerStart(t, last, protocol, username, password, bindLocal, bindRemote)
	chain := &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, count), final: peer.paired}
	chain.prefixes[count-1] = peer.prefix
	desktopNodeChainStartCapturedPrefixes(t, request.Paired, local, remote, chain, ipcs, count-1)
	clear(ipcs)
	return peer, provider, ca, chain
}

// Real loopback CONNECT authentication, optional proxy TLS, final SS2022
// ciphertext and selected DNS/UoT-v2 framing. No namespace, remote worker,
// entry API, client Compare or host kernel acceptance is modeled here.
func TestRouterVPNDesktopNodeChainCONNECTServerFinalUoT(t *testing.T) {
	for _, protocol := range []string{"http-connect", "https-connect"} {
		t.Run(protocol, func(t *testing.T) {
			request, _ := desktopNodeChainPeerFixture(t, 1)
			topology := desktopNodeChainImportedRequest{1, request, mobilemultihop.NativeStartLayerMethod, base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, 32))}
			address := netip.MustParseAddr("127.0.0.1")
			peer, provider, ca := desktopNodeChainCONNECTServerPeerStart(t, topology, protocol, "original-user", "original-password", address, address)
			c, err := net.DialTimeout("tcp4", provider.address, 2*time.Second)
			if err != nil {
				t.Fatal(err)
			}
			defer c.Close()
			if err = c.SetDeadline(time.Now().Add(3 * time.Second)); err != nil {
				t.Fatal(err)
			}
			if protocol == "https-connect" {
				roots := x509.NewCertPool()
				if !roots.AppendCertsFromPEM([]byte(ca)) {
					t.Fatal("missing original proxy CA")
				}
				secured := tls.Client(c, &tls.Config{RootCAs: roots, ServerName: "speed.cloudflare.com", MinVersion: tls.VersionTLS12})
				if err = secured.Handshake(); err != nil {
					t.Fatal(err)
				}
				c = secured
			}
			q, _ := http.NewRequest(http.MethodConnect, "http://10.77.0.1:8388", nil)
			q.URL.Scheme = ""
			q.URL.Host = ""
			q.URL.Opaque = "10.77.0.1:8388"
			q.Host = "10.77.0.1:8388"
			q.Header.Set("Proxy-Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte("original-user:original-password")))
			if err = q.Write(c); err != nil {
				t.Fatal(err)
			}
			reader := bufio.NewReader(c)
			response, err := http.ReadResponse(reader, q)
			if err != nil || response.StatusCode != 200 {
				t.Fatal("original CONNECT authentication failed", err)
			}
			method, err := shadowaead_2022.NewWithPassword(mobilemultihop.NativeStartLayerMethod, request.FinalPassword, nil)
			if err != nil {
				t.Fatal(err)
			}
			encrypted, err := method.DialConn(&desktopNodeLayerBufferedConn{Conn: c, reader: reader}, uot.RequestDestination(2))
			if err != nil {
				t.Fatal(err)
			}
			target := M.ParseSocksaddr("192.168.50.133:53")
			packetRequest := uot.Request{IsConnect: true, Destination: target}
			if err = uot.WriteRequest(encrypted, packetRequest); err != nil {
				t.Fatal(err)
			}
			packets := uot.NewConn(encrypted, packetRequest)
			defer packets.Close()
			question := new(dns.Msg)
			question.SetQuestion("example.com.", dns.TypeA)
			question.Id = 27491
			raw, _ := question.Pack()
			if n, e := packets.WriteTo(raw, target); e != nil || n != len(raw) {
				t.Fatal("original CONNECT final UoT DNS write failed", e)
			}
			buffer := make([]byte, 2048)
			n, from, err := packets.ReadFrom(buffer)
			if err != nil {
				t.Fatal("original CONNECT final UoT DNS reply failed", err)
			}
			reply := new(dns.Msg)
			if reply.Unpack(buffer[:n]) != nil || reply.Id != question.Id || !reply.Response || len(reply.Answer) == 0 || from.String() != target.String() {
				t.Fatal("original selected DNS identity changed")
			}
			snapshot := peer.snapshot()
			if snapshot.Final.DNSQueries != 1 || snapshot.Final.FinalRawTCP == 0 || snapshot.Final.FinalRawUDP != 0 || snapshot.Middle.RawTCP != 1 || snapshot.Middle.RawUDP != 0 {
				t.Fatal("CONNECT DNS escaped original TCP/UoT owners")
			}
			if err = packets.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
				t.Fatal(err)
			}
		})
	}
}
