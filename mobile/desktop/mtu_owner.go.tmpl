type routerVPNDesktopMTULease interface {
	Healthy() bool
	Close()
	Config() string
	Authority() string
	Inbound() (adapter.Inbound, error)
	ChangeMTU(context.Context, adapter.Inbound, int) (adapter.Inbound, error)
	Lifetime(context.Context) (context.Context, context.CancelFunc, error)
	Verify(context.Context, func(context.Context, string, string) (net.Conn, error)) error
	Resolve(context.Context, string) ([]netip.Addr, error)
}

type routerVPNDesktopMTUReadbackLease interface {
	MTUReadback() (mobiletor.DesktopBridgeMTUReadback, error)
}

type routerVPNDesktopMTUClaimLease interface {
	ClaimDesktopTUN(func() bool) (string, int, int, error)
}

type routerVPNDesktopMTUMeasurementLease interface {
	BeginMeasurement(context.Context) (context.Context, context.CancelFunc, error)
}

// This adapter reads the interface actually owned by the Box. It never picks
// a route by guessing an interface name or lets net.Dial fall back to the LAN.
type routerVPNDesktopMTUTUN interface {
	adapter.Inbound
	RouterVPNDesktopMTU(func() bool) (string, int, int, error)
	RouterVPNDesktopMTUInterface() (string, int, int, error)
}

type routerVPNDesktopMTUOwner struct {
	mu              sync.Mutex
	invalid         atomic.Bool
	lease           routerVPNDesktopMTULease
	inbound         routerVPNDesktopMTUTUN
	session, path   string
	physical        func() string
	physicalContext func(context.Context) (string, error)
	pendingBefore   *mobilemtu.State
	pendingReader   routerVPNDesktopMTUTUN
	pendingContext  context.Context
}

func routerVPNDesktopPhysicalPath(instance *box.Box) string {
	if instance == nil || instance.Network() == nil {
		return ""
	}
	manager := instance.Network()
	selected := manager.DefaultNetworkInterface()
	if selected == nil || selected.Index < 1 || selected.Name == "" {
		return ""
	}
	current, err := net.InterfaceByIndex(selected.Index)
	if err != nil || current.Name != selected.Name || current.Flags&net.FlagUp == 0 || current.Flags&net.FlagLoopback != 0 {
		return ""
	}
	addresses, err := current.Addrs()
	if err != nil || len(addresses) == 0 {
		return ""
	}
	parts := []string{current.Name, fmt.Sprint(current.Index), fmt.Sprint(current.MTU)}
	for _, address := range addresses {
		parts = append(parts, address.String())
	}
	for _, gateway := range selected.Gateways {
		parts = append(parts, "gateway:"+gateway.String())
	}
	sort.Strings(parts)
	digest := sha256.Sum256([]byte(strings.Join(parts, "\x00")))
	return hex.EncodeToString(digest[:])
}

func newRouterVPNDesktopMTUOwner(lease routerVPNDesktopMTULease, session string, physical func() string) (*routerVPNDesktopMTUOwner, error) {
	if lease == nil || !lease.Healthy() || !routerVPNExternalSession.MatchString(session) || physical == nil {
		return nil, routerVPNExternalFailure
	}
	path := physical()
	if len(path) != 64 {
		return nil, routerVPNExternalFailure
	}
	current, err := lease.Inbound()
	if err != nil {
		return nil, routerVPNExternalFailure
	}
	inbound, ok := current.(routerVPNDesktopMTUTUN)
	if !ok || inbound.Type() != "tun" {
		return nil, routerVPNExternalFailure
	}
	owner := &routerVPNDesktopMTUOwner{lease: lease, inbound: inbound, session: session, path: path, physical: physical}
	if retained, ok := lease.(routerVPNDesktopMTUReadbackLease); ok {
		// Tor claimed this reader before its first proof. Preserve that exact
		// permanent network-generation guard instead of claiming it again.
		readback, readErr := retained.MTUReadback()
		name, index, mtu, nativeErr := inbound.RouterVPNDesktopMTUInterface()
		if readErr != nil || nativeErr != nil || readback.InterfaceName != name || readback.InterfaceIndex != index || readback.EffectiveMTU != mtu {
			return nil, routerVPNExternalFailure
		}
	} else if retained, ok := lease.(routerVPNDesktopMTUClaimLease); ok {
		// A protected ordinary path also claims its TUN before proof. Let the
		// actual native lease preserve that guard, or claim a legacy external
		// reader exactly once when it has no physical owner.
		name, index, mtu, readErr := retained.ClaimDesktopTUN(owner.pathCurrent)
		actualName, actualIndex, actualMTU, nativeErr := inbound.RouterVPNDesktopMTUInterface()
		if readErr != nil || nativeErr != nil || name != actualName || index != actualIndex || mtu != actualMTU {
			return nil, routerVPNExternalFailure
		}
	} else {
		if _, _, _, err = inbound.RouterVPNDesktopMTU(owner.pathCurrent); err != nil {
			return nil, routerVPNExternalFailure
		}
	}
	if _, err = owner.Capture(); err != nil {
		return nil, err
	}
	return owner, nil
}

type routerVPNDesktopMTUContextLease interface {
	HealthyContext(context.Context) error
	InboundContext(context.Context) (adapter.Inbound, error)
}
type routerVPNDesktopMTUContextTUN interface {
	routerVPNDesktopMTUTUN
	RouterVPNDesktopMTUContext(context.Context, func(context.Context) error) (string, int, int, error)
	RouterVPNDesktopMTUInterfaceContext(context.Context) (string, int, int, error)
}

func newRouterVPNDesktopMTUOwnerContext(ctx context.Context, lease routerVPNDesktopMTULease, session string, physical func(context.Context) (string, error)) (*routerVPNDesktopMTUOwner, error) {
	capability, ok := lease.(routerVPNDesktopMTUContextLease)
	if !ok || physical == nil || !routerVPNExternalSession.MatchString(session) {
		return nil, routerVPNExternalFailure
	}
	if err := capability.HealthyContext(ctx); err != nil {
		return nil, err
	}
	path, err := physical(ctx)
	if err != nil {
		return nil, err
	}
	if len(path) != 64 {
		return nil, routerVPNExternalFailure
	}
	current, err := capability.InboundContext(ctx)
	if err != nil {
		return nil, err
	}
	reader, ok := current.(routerVPNDesktopMTUContextTUN)
	if !ok || reader.Type() != "tun" {
		return nil, routerVPNExternalFailure
	}
	owner := &routerVPNDesktopMTUOwner{lease: lease, inbound: reader, session: session, path: path, physicalContext: physical}
	// Legacy read callers still observe this retained lifetime; bounded calls
	// always enter the explicit physicalContext capability below.
	owner.physical = func() string { value, _ := physical(context.Background()); return value }
	if retained, ok := lease.(interface {
		MTUReadbackContext(context.Context) (mobiletor.DesktopBridgeMTUReadback, error)
	}); ok {
		state, err := retained.MTUReadbackContext(ctx)
		if err != nil {
			return nil, err
		}
		name, index, mtu, err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
		if err != nil {
			return nil, err
		}
		if state.InterfaceName != name || state.InterfaceIndex != index || state.EffectiveMTU != mtu {
			return nil, routerVPNExternalFailure
		}
	} else if retained, ok := lease.(interface {
		ClaimDesktopTUNContext(context.Context, func(context.Context) error) (string, int, int, error)
	}); ok {
		name, index, mtu, err := retained.ClaimDesktopTUNContext(ctx, owner.pathCurrentContext)
		if err != nil {
			return nil, err
		}
		actualName, actualIndex, actualMTU, err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
		if err != nil {
			return nil, err
		}
		if name != actualName || index != actualIndex || mtu != actualMTU {
			return nil, routerVPNExternalFailure
		}
	} else {
		if _, _, _, err := reader.RouterVPNDesktopMTUContext(ctx, owner.pathCurrentContext); err != nil {
			return nil, err
		}
	}
	if _, err := owner.CaptureContext(ctx); err != nil {
		return nil, err
	}
	return owner, nil
}
func (o *routerVPNDesktopMTUOwner) pathCurrentContext(ctx context.Context) error {
	if ctx == nil {
		return routerVPNExternalFailure
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if o == nil || o.invalid.Load() || o.physicalContext == nil || o.path == "" {
		return routerVPNExternalFailure
	}
	path, err := o.physicalContext(ctx)
	if err != nil {
		return err
	}
	if path != o.path {
		o.invalid.Store(true)
		return routerVPNExternalFailure
	}
	return ctx.Err()
}
func (o *routerVPNDesktopMTUOwner) captureLockedContext(ctx context.Context) (mobilemtu.State, error) {
	fail := func(err error) (mobilemtu.State, error) {
		if err != nil && !mobiletor.ObservationContextExpired(ctx, err) {
			o.invalid.Store(true)
		}
		return mobilemtu.State{}, err
	}
	if err := o.pathCurrentContext(ctx); err != nil {
		return fail(err)
	}
	lease, ok := o.lease.(routerVPNDesktopMTUContextLease)
	if !ok {
		return fail(routerVPNExternalFailure)
	}
	if err := lease.HealthyContext(ctx); err != nil {
		return fail(err)
	}
	current, err := lease.InboundContext(ctx)
	if err != nil {
		return fail(err)
	}
	if current != o.inbound {
		o.invalid.Store(true)
		return fail(routerVPNExternalFailure)
	}
	reader, ok := o.inbound.(routerVPNDesktopMTUContextTUN)
	if !ok {
		return fail(routerVPNExternalFailure)
	}
	name, index, mtu, err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
	if err != nil {
		return fail(err)
	}
	if name == "" || index < 1 || mtu < 1280 || mtu > 9000 {
		o.invalid.Store(true)
		return fail(routerVPNExternalFailure)
	}
	if err := o.pathCurrentContext(ctx); err != nil {
		return fail(err)
	}
	if err := lease.HealthyContext(ctx); err != nil {
		return fail(err)
	}
	if err := ctx.Err(); err != nil {
		return fail(err)
	}
	return mobilemtu.State{Session: o.session, Path: o.path, Interface: fmt.Sprintf("%s/%d", name, index), MTU: mtu}, nil
}
func (o *routerVPNDesktopMTUOwner) CaptureContext(ctx context.Context) (mobilemtu.State, error) {
	if err := desktopnetwork.LockContext(ctx, &o.mu); err != nil {
		return mobilemtu.State{}, err
	}
	defer o.mu.Unlock()
	return o.captureLockedContext(ctx)
}
func (o *routerVPNDesktopMTUOwner) RollbackStateContext(ctx context.Context, expected mobilemtu.State) (mobilemtu.State, error) {
	if err := desktopnetwork.LockContext(ctx, &o.mu); err != nil {
		return mobilemtu.State{}, err
	}
	defer o.mu.Unlock()
	actual, err := o.captureLockedContext(ctx)
	if err != nil {
		return actual, err
	}
	if actual == expected {
		return actual, nil
	}
	if !mobilemtu.SameOperationContext(ctx, o.pendingContext) || o.pendingBefore == nil || *o.pendingBefore != expected || o.pendingReader != o.inbound || actual.Session != expected.Session || actual.Path != expected.Path {
		return mobilemtu.State{}, routerVPNExternalFailure
	}
	return actual, nil
}

func (o *routerVPNDesktopMTUOwner) pathCurrent() bool {
	return o != nil && !o.invalid.Load() && o.physical != nil && o.path != "" && o.physical() == o.path
}

func (o *routerVPNDesktopMTUOwner) captureLocked() (mobilemtu.State, error) {
	if !o.pathCurrent() || o.lease == nil || !o.lease.Healthy() {
		return mobilemtu.State{}, routerVPNExternalFailure
	}
	current, err := o.lease.Inbound()
	if err != nil || current != o.inbound {
		return mobilemtu.State{}, routerVPNExternalFailure
	}
	name, index, mtu, err := o.inbound.RouterVPNDesktopMTUInterface()
	if err != nil || name == "" || index < 1 || mtu < 1280 || mtu > 9000 || !o.pathCurrent() || !o.lease.Healthy() {
		return mobilemtu.State{}, routerVPNExternalFailure
	}
	return mobilemtu.State{Session: o.session, Path: o.path, Interface: fmt.Sprintf("%s/%d", name, index), MTU: mtu}, nil
}

func (o *routerVPNDesktopMTUOwner) Capture() (mobilemtu.State, error) {
	o.mu.Lock()
	defer o.mu.Unlock()
	return o.captureLocked()
}

func (o *routerVPNDesktopMTUOwner) ChangeMTU(ctx context.Context, expected mobilemtu.State, mtu int) (mobilemtu.State, error) {
	if o.physicalContext == nil {
		return o.changeMTULegacy(ctx, expected, mtu)
	}
	if err := desktopnetwork.LockContext(ctx, &o.mu); err != nil {
		return expected, err
	}
	defer o.mu.Unlock()
	before, err := o.captureLockedContext(ctx)
	if err != nil {
		return before, err
	}
	if before != expected || mtu < 1280 || mtu > 9000 {
		return before, routerVPNExternalFailure
	}
	original := expected
	o.pendingBefore = &original
	o.pendingContext = ctx
	o.pendingReader = o.inbound
	current, changeErr := o.lease.ChangeMTU(ctx, o.inbound, mtu)
	reader, ok := current.(routerVPNDesktopMTUTUN)
	if !ok || reader.Tag() != o.inbound.Tag() || reader.Type() != "tun" {
		o.invalid.Store(true)
		return mobilemtu.State{}, errors.Join(changeErr, ctx.Err(), routerVPNExternalFailure)
	}
	// Retain the native result even when its caller expired. Only the separate
	// rollback context can now read that same pending pointer; no late winner.
	o.inbound = reader
	o.pendingReader = reader
	if err := ctx.Err(); err != nil {
		return before, errors.Join(changeErr, err)
	}
	after, err := o.captureLockedContext(ctx)
	if err != nil {
		return before, errors.Join(changeErr, err)
	}
	if changeErr != nil || after.MTU != mtu {
		return after, errors.Join(changeErr, routerVPNExternalFailure)
	}
	o.pendingBefore = nil
	o.pendingContext = nil
	o.pendingReader = nil
	return after, nil
}
func (o *routerVPNDesktopMTUOwner) changeMTULegacy(ctx context.Context, expected mobilemtu.State, mtu int) (mobilemtu.State, error) {
	o.mu.Lock()
	defer o.mu.Unlock()
	before, err := o.captureLocked()
	if err != nil || before != expected || ctx == nil || ctx.Err() != nil || mtu < 1280 || mtu > 9000 {
		return before, routerVPNExternalFailure
	}
	current, changeErr := o.lease.ChangeMTU(ctx, o.inbound, mtu)
	reader, ok := current.(routerVPNDesktopMTUTUN)
	if !ok || reader.Tag() != o.inbound.Tag() || reader.Type() != "tun" {
		o.invalid.Store(true)
		return mobilemtu.State{}, routerVPNExternalFailure
	}
	// Only the native transaction can supply its candidate or rollback reader.
	o.inbound = reader
	after, err := o.captureLocked()
	if err != nil {
		o.invalid.Store(true)
		return mobilemtu.State{}, routerVPNExternalFailure
	}
	if changeErr != nil || ctx.Err() != nil || after.MTU != mtu {
		return after, routerVPNExternalFailure
	}
	return after, nil
}

func (o *routerVPNDesktopMTUOwner) VerifyExternal(ctx context.Context, expected mobilemtu.State) error {
	state, err := o.observe(ctx)
	if err != nil || ctx.Err() != nil {
		return errors.Join(err, ctx.Err())
	}
	if state != expected {
		return routerVPNExternalFailure
	}
	proofTag, proofAddress, err := o.verificationTarget()
	if err != nil {
		return err
	}
	err = o.lease.Verify(ctx, func(call context.Context, tag, address string) (net.Conn, error) {
		if tag != proofTag || address != proofAddress {
			return nil, routerVPNExternalFailure
		}
		return o.DialThroughTunnel(call, expected, "tcp", address)
	})
	after, captureErr := o.observe(ctx)
	if err != nil || captureErr != nil || ctx.Err() != nil {
		return errors.Join(err, captureErr, ctx.Err())
	}
	if after != expected {
		return routerVPNExternalFailure
	}
	return nil
}

func (o *routerVPNDesktopMTUOwner) verificationTarget() (string, string, error) {
	if captured, ok := o.lease.(interface{ VerificationTarget() (string, string) }); ok {
		tag, address := captured.VerificationTarget()
		if tag != mobiletor.ProfileOutboundTag || address != "check.torproject.org:443" {
			return "", "", routerVPNExternalFailure
		}
		return tag, address, nil
	}
	return "custom-exit", "1.1.1.1:443", nil
}

func (o *routerVPNDesktopMTUOwner) BeginExternalMeasurement(parent context.Context, expected mobilemtu.State) (context.Context, context.CancelFunc, error) {
	if parent == nil {
		return nil, nil, routerVPNExternalFailure
	}
	state, err := o.observe(parent)
	if err != nil || parent.Err() != nil {
		return nil, nil, errors.Join(err, parent.Err())
	}
	if state != expected {
		return nil, nil, routerVPNExternalFailure
	}
	var ctx context.Context
	var release context.CancelFunc
	if captured, ok := o.lease.(routerVPNDesktopMTUMeasurementLease); ok {
		ctx, release, err = captured.BeginMeasurement(parent)
	} else {
		ctx, release = context.WithCancel(parent)
	}
	after, captureErr := o.observe(parent)
	if err != nil || captureErr != nil || ctx == nil || release == nil || ctx.Err() != nil || after != expected {
		if release != nil {
			release()
		}
		if err != nil || captureErr != nil || parent.Err() != nil {
			return nil, nil, errors.Join(err, captureErr, parent.Err())
		}
		return nil, nil, routerVPNExternalFailure
	}
	return ctx, release, nil
}

func (o *routerVPNDesktopMTUOwner) DialThroughTunnel(parent context.Context, expected mobilemtu.State, network, address string) (net.Conn, error) {
	_, proofAddress, proofErr := o.verificationTarget()
	if proofErr != nil || network != "tcp" || address != hopmeasure.PublicAddress && address != proofAddress {
		return nil, routerVPNExternalFailure
	}
	ctx, release, err := o.lease.Lifetime(parent)
	if err != nil {
		return nil, err
	}
	retained := false
	defer func() {
		if !retained {
			release()
		}
	}()
	targets := []string{address}
	host, port, splitErr := net.SplitHostPort(address)
	if splitErr != nil || port != "443" {
		return nil, routerVPNExternalFailure
	}
	if _, parseErr := netip.ParseAddr(host); parseErr != nil {
		addresses, err := o.lease.Resolve(ctx, host)
		if err != nil {
			return nil, err
		}
		targets = nil
		for _, ip := range addresses {
			if ip.IsValid() && ip.IsGlobalUnicast() && !ip.IsPrivate() && !ip.Is4In6() && ip.Zone() == "" {
				targets = append(targets, net.JoinHostPort(ip.String(), "443"))
			}
		}
	}
	for _, target := range targets {
		conn, err := o.dialBound(ctx, expected, target)
		if err == nil && conn != nil {
			owned := &routerVPNDesktopMTUSocket{Conn: conn, release: release, closed: make(chan struct{})}
			owned.stop = context.AfterFunc(ctx, owned.closeOwned)
			if healthErr := o.healthyContext(ctx); healthErr != nil {
				_ = owned.Close()
				return nil, healthErr
			}
			retained = true
			return owned, nil
		}
		if conn != nil {
			_ = conn.Close()
		}
		if healthErr := o.healthyContext(ctx); healthErr != nil {
			return nil, healthErr
		}
	}
	return nil, routerVPNExternalFailure
}

func (o *routerVPNDesktopMTUOwner) dialBound(ctx context.Context, expected mobilemtu.State, address string) (net.Conn, error) {
	host, port, err := net.SplitHostPort(address)
	ip, parseErr := netip.ParseAddr(host)
	if err != nil || parseErr != nil || port != "443" || !ip.IsGlobalUnicast() || ip.IsPrivate() || ip.Is4In6() || ip.Zone() != "" {
		return nil, routerVPNExternalFailure
	}
	network := "tcp4"
	if ip.Is6() {
		network = "tcp6"
	}
	dialer := net.Dialer{ControlContext: func(call context.Context, network, address string, raw syscall.RawConn) error {
		if err := desktopnetwork.LockContext(call, &o.mu); err != nil {
			return err
		}
		defer o.mu.Unlock()
		before, err := o.captureLockedContext(call)
		if err != nil || call.Err() != nil {
			return errors.Join(err, call.Err())
		}
		if before != expected {
			return routerVPNExternalFailure
		}
		name, index, _, err := o.inbound.(routerVPNDesktopMTUContextTUN).RouterVPNDesktopMTUInterfaceContext(call)
		if err != nil {
			return err
		}
		if err := control.BindToInterface(nil, name, index)(network, address, raw); err != nil {
			return routerVPNExternalFailure
		}
		after, err := o.captureLockedContext(call)
		if err != nil || call.Err() != nil {
			return errors.Join(err, call.Err())
		}
		if after != expected {
			return routerVPNExternalFailure
		}
		return nil
	}}
	conn, err := dialer.DialContext(ctx, network, address)
	if err != nil {
		return nil, err
	}
	after, err := o.CaptureContext(ctx)
	if err != nil || after != expected || ctx.Err() != nil {
		_ = conn.Close()
		if err != nil || ctx.Err() != nil {
			return nil, errors.Join(err, ctx.Err())
		}
		return nil, routerVPNExternalFailure
	}
	return conn, nil
}

type routerVPNDesktopMTUSocket struct {
	net.Conn
	release context.CancelFunc
	stop    func() bool
	once    sync.Once
	closed  chan struct{}
	err     error
}

func (c *routerVPNDesktopMTUSocket) closeOwned() {
	c.once.Do(func() { c.err = c.Conn.Close(); close(c.closed) })
}
func (c *routerVPNDesktopMTUSocket) Close() error {
	c.stop()
	c.closeOwned()
	<-c.closed
	c.release()
	return c.err
}

var _ mobilemtu.ExternalOwner = (*routerVPNDesktopMTUOwner)(nil)
var _ routerVPNDesktopMTUTUN = (*ntun.Inbound)(nil)

func routerVPNDesktopPhysicalPathContext(ctx context.Context, instance *box.Box) (string, error) {
	if ctx == nil || instance == nil || instance.Network() == nil {
		return "", routerVPNExternalFailure
	}
	selected, err := adapter.RouterVPNDefaultNetworkInterfaceContext(ctx, instance.Network())
	if err != nil {
		return "", err
	}
	if selected == nil || selected.Index < 1 || selected.Name == "" {
		return "", routerVPNExternalFailure
	}
	current, addresses, err := desktopnetwork.InterfaceContext(ctx, selected.Index)
	if err != nil {
		return "", err
	}
	if current.Name != selected.Name || current.Flags&net.FlagUp == 0 || current.Flags&net.FlagLoopback != 0 || len(addresses) == 0 {
		return "", routerVPNExternalFailure
	}
	parts := []string{current.Name, fmt.Sprint(current.Index), fmt.Sprint(current.MTU)}
	for _, address := range addresses {
		parts = append(parts, address.String())
	}
	for _, gateway := range selected.Gateways {
		parts = append(parts, "gateway:"+gateway.String())
	}
	sort.Strings(parts)
	digest := sha256.Sum256([]byte(strings.Join(parts, "\x00")))
	return hex.EncodeToString(digest[:]), ctx.Err()
}

func (o *routerVPNDesktopMTUOwner) healthyContext(ctx context.Context) error {
	lease, ok := o.lease.(routerVPNDesktopMTUContextLease)
	if !ok {
		return routerVPNExternalFailure
	}
	return lease.HealthyContext(ctx)
}

// Legacy owners retain their compatibility path. Strict desktop constructors
// install physicalContext; their observations never enter a legacy callback.
func (o *routerVPNDesktopMTUOwner) observe(ctx context.Context) (mobilemtu.State, error) {
	if o.physicalContext != nil {
		return o.CaptureContext(ctx)
	}
	if ctx == nil {
		return mobilemtu.State{}, routerVPNExternalFailure
	}
	if err := ctx.Err(); err != nil {
		return mobilemtu.State{}, err
	}
	state, err := o.Capture()
	return state, errors.Join(err, ctx.Err())
}
