package main

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"os"
	"reflect"
	"time"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/hopmeasure"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

const routerVPNExecutionMeasurementRequestFile = "node-chain-execution-measure-request.json"
const routerVPNExecutionMeasurementCancelFile = "node-chain-execution-measure-cancel.json"
const routerVPNExecutionThroughputResultFile = "node-chain-execution-throughput-result.json"
const routerVPNExecutionMeasurementResultFile = "node-chain-execution-measure-result.json"

type routerVPNExecutionMeasurementRequest struct {
	Schema     int                                                 `json:"schema"`
	Operation  string                                              `json:"operation"`
	Request    string                                              `json:"request_id"`
	Generation uint64                                              `json:"generation"`
	Deadline   int64                                               `json:"deadline_at"`
	Path       string                                              `json:"path_id"`
	NodeID     string                                              `json:"node_id"`
	Position   int                                                 `json:"position"`
	Bytes      int                                                 `json:"bytes,omitempty"`
	Samples    int                                                 `json:"samples,omitempty"`
	Capture    mobilemultihop.DesktopNodeChainExecutionReadyRecord `json:"capture"`
	Selected   string                                              `json:"selected_capture"`
}

type routerVPNExecutionMeasurementResult struct {
	routerVPNExecutionMeasurementRequest
	Saved       *hopmeasure.OrderedLatencyReceipt `json:"saved,omitempty"`
	CompletedAt int64                             `json:"completed_at"`
	Status      hopmeasure.Status                 `json:"status"`
}

type routerVPNDesktopExecutionMeasurementOperation struct {
	owner             *routerVPNDesktopExecutionMeasurement
	request           routerVPNExecutionMeasurementRequest
	raw               []byte
	info, cancelInfo  os.FileInfo
	facade            *mobilemultihop.NodeChainExecutionLatency
	throughput        *mobilemultihop.NodeChainExecutionMeasurement
	cancel            context.CancelFunc
	started           bool
	retirementFailure error
	issued            routerVPNSelectedCandidateFile
	terminal          *routerVPNExecutionMeasurementResult
}

func (op *routerVPNDesktopExecutionMeasurementOperation) inputCurrent(ctx context.Context) error {
	if op == nil || ctx == nil || ctx.Err() != nil || op.owner == nil || op.owner.op.Load() != op {
		return routerVPNExternalFailure
	}
	info, err := op.owner.owner.files.root.Lstat(routerVPNExecutionMeasurementRequestFile)
	raw, readErr := op.owner.owner.files.read(routerVPNExecutionMeasurementRequestFile, op.owner.wireLimit(routerVPNExecutionMeasurementRequestLimit))
	if err != nil || readErr != nil || !os.SameFile(info, op.info) || !bytes.Equal(raw, op.raw) {
		return routerVPNExternalFailure
	}
	return ctx.Err()
}

func (op *routerVPNDesktopExecutionMeasurementOperation) cancelWorker() {
	if op != nil {
		if op.cancel != nil {
			op.cancel()
		}
		if op.throughput != nil {
			op.throughput.Cancel(op.request.Request)
		} else if op.facade != nil {
			op.facade.Cancel(op.request.Request)
		}
	}
}

func (op *routerVPNDesktopExecutionMeasurementOperation) closeFacade(ctx context.Context) error {
	if op != nil && op.throughput != nil {
		return op.throughput.CloseContext(ctx)
	}
	if op == nil || op.facade == nil {
		return routerVPNExternalFailure
	}
	if op.retirementFailure != nil {
		return op.retirementFailure
	}
	if err := op.facade.CloseContext(ctx); err != nil {
		op.retirementFailure = err
		return err
	}
	return nil
}

func routerVPNExecutionMeasurementDecode(raw []byte) (routerVPNExecutionMeasurementRequest, error) {
	return (*routerVPNDesktopExecutionMeasurement)(nil).decodeMeasurement(raw)
}
func (m *routerVPNDesktopExecutionMeasurement) decodeMeasurement(raw []byte) (routerVPNExecutionMeasurementRequest, error) {
	var request routerVPNExecutionMeasurementRequest
	var fields map[string]json.RawMessage
	if len(raw) == 0 || int64(len(raw)) > m.wireLimit(routerVPNExecutionMeasurementRequestLimit) || !routerVPNMTUStrict(raw, &request) || json.Unmarshal(raw, &fields) != nil {
		return request, routerVPNExternalFailure
	}
	for _, field := range []string{"schema", "operation", "request_id", "generation", "deadline_at", "path_id", "node_id", "position", "capture", "selected_capture"} {
		if value, ok := fields[field]; !ok || bytes.Equal(value, []byte("null")) {
			return request, routerVPNExternalFailure
		}
	}
	switch request.Operation {
	case "selected-latency-50":
		if request.Schema != 1 || len(fields) != 10 {
			return request, routerVPNExternalFailure
		}
	case "selected-path-throughput":
		if request.Schema != 2 || len(fields) != 11 || request.Bytes != 8<<20 || !m.throughputFinal(request) {
			return request, routerVPNExternalFailure
		}
	case "selected-private-response":
		if request.Schema != 3 || len(fields) != 11 || request.Samples < 1 || request.Samples > 10 || !m.throughputFinal(request) {
			return request, routerVPNExternalFailure
		}
	default:
		return request, routerVPNExternalFailure
	}
	if !routerVPNExternalSession.MatchString(request.Request) || request.Generation == 0 ||
		!routerVPNExternalSource.MatchString(request.Path) || !m.latencyNode(request.Selected, request.NodeID, request.Position) {
		return request, routerVPNExternalFailure
	}
	return request, nil
}

// The throughput operation covers every position through the retained final.
// A latency target and a complete-path byte transfer have disjoint wire forms.
func (m *routerVPNDesktopExecutionMeasurement) throughputFinal(request routerVPNExecutionMeasurementRequest) bool {
	var capture struct {
		Nodes []json.RawMessage `json:"nodes"`
	}
	return json.Unmarshal([]byte(request.Selected), &capture) == nil && len(capture.Nodes) >= 2 &&
		(len(capture.Nodes) <= 8 || m != nil && m.self == m && len(capture.Nodes) == m.extendedCount && request.Selected == m.capture.Selected) && request.Position == len(capture.Nodes)-1
}

func (m *routerVPNDesktopExecutionMeasurement) requestCurrent(ctx context.Context, request routerVPNExecutionMeasurementRequest) error {
	if m == nil || m.readyCurrent(ctx) != nil || !reflect.DeepEqual(request.Capture, m.capture.Capture) || request.Selected != m.capture.Selected {
		return routerVPNExternalFailure
	}
	mtu := m.owner.mtu.Load()
	// The command loop owns this mutable MTU record. Worker callbacks never read it.
	if mtu == nil || mtu.raw == nil || mtu.raw.record.Active || mtu.raw.record.Failure != "" || request.Path != mtu.raw.record.Path ||
		request.Capture.Reader != mtu.raw.record.Reader || request.Capture.InterfaceName != mtu.raw.record.Interface ||
		request.Capture.InterfaceIndex != uint32(mtu.raw.record.Index) || request.Capture.MTU != mtu.raw.record.MTU {
		return routerVPNExternalFailure
	}
	return ctx.Err()
}

func (owner *routerVPNNodeChainExecutionRuntime) pollMeasurement(ctx context.Context) error {
	if owner == nil {
		return nil
	}
	if ctx == nil || ctx.Err() != nil {
		return routerVPNExternalFailure
	}
	// An active MTU transaction owns the reader. It may not acquire or reuse a
	// measurement until its new proof/controller and actual readback are ready.
	if mtu := owner.mtu.Load(); mtu != nil && (mtu.raw.record.Active || mtu.raw.record.Failure != "") {
		return nil
	}
	m := owner.measurement.Load()
	if m != nil && (m.state != owner.state.Load() || m.state.controller.Load() != m.controller || m.state.projection.Load() != m.projection) {
		if err := m.close(ctx); err != nil {
			return err
		}
		m = nil
	}
	if m == nil {
		if _, err := owner.files.root.Lstat("node-chain-execution-ready.json"); errors.Is(err, os.ErrNotExist) {
			return nil
		}
		var err error
		m, err = owner.captureMeasurement(ctx)
		if err != nil {
			return err
		}
	}
	if m.pollSelectedCandidate(ctx) {
		return nil
	}
	if m.op.Load() == nil {
		info, err := owner.files.root.Lstat(routerVPNExecutionMeasurementRequestFile)
		if errors.Is(err, os.ErrNotExist) {
			return m.current(ctx)
		}
		raw, readErr := owner.files.read(routerVPNExecutionMeasurementRequestFile, m.wireLimit(routerVPNExecutionMeasurementRequestLimit))
		request, decodeErr := m.decodeMeasurement(raw)
		now := time.Now()
		if err != nil || readErr != nil || decodeErr != nil || request.Request == owner.measurementLast || owner.measurementGeneration == ^uint64(0) || request.Generation != owner.measurementGeneration+1 ||
			request.Deadline <= now.UnixMilli() || request.Operation == "selected-private-response" && request.Deadline > now.Add(hopmeasure.PathResponseTimeout).UnixMilli() || request.Deadline > now.Add(hopmeasure.RequestTimeout).UnixMilli() || m.requestCurrent(ctx, request) != nil {
			return routerVPNExternalFailure
		}
		if request.Schema == 1 && m.facade == nil {
			if err := m.renewFacade(ctx); err != nil {
				return err
			}
		}
		work, cancel := context.WithDeadline(owner.ctx, time.UnixMilli(request.Deadline))
		op := &routerVPNDesktopExecutionMeasurementOperation{owner: m, request: request, raw: raw, info: info, cancel: cancel}
		if !m.op.CompareAndSwap(nil, op) {
			cancel()
			return routerVPNExternalFailure
		}
		if request.Schema != 1 {
			// Create only a measurement handle against the already selected runtime.
			// Retain even partial construction for original socket and MTU cleanup.
			op.throughput, err = m.runtime.NewHopMeasurementContext(work, m)
			if err != nil || op.throughput == nil || op.throughput.VerifySelectedCaptureContext(work, request.Selected) != nil {
				op.cancelWorker()
				return errors.Join(err, routerVPNExternalFailure)
			}
		} else {
			op.facade = m.facade
		}
		if err := op.inputCurrent(ctx); err != nil {
			op.cancelWorker()
			return err
		}
		if info, err := owner.files.root.Lstat(routerVPNExecutionMeasurementCancelFile); !errors.Is(err, os.ErrNotExist) {
			body, readErr := owner.files.read(routerVPNExecutionMeasurementCancelFile, m.wireLimit(routerVPNExecutionMeasurementRequestLimit))
			if err != nil || readErr != nil || !bytes.Equal(body, raw) {
				op.cancelWorker()
				return routerVPNExternalFailure
			}
			op.cancelInfo = info
			op.cancelWorker()
		} else {
			var startErr error
			if request.Operation == "selected-private-response" {
				startErr = op.throughput.StartOrderedResponseContext(work, request.Request, request.Samples)
			} else if op.throughput != nil {
				startErr = op.throughput.StartContext(work, request.Request, request.Bytes)
			} else {
				startErr = op.facade.StartContext(work, request.Request, request.NodeID)
			}
			if startErr != nil {
				op.cancelWorker()
				return startErr
			}
			op.started = true
		}
	}
	op := m.op.Load()
	if op == nil || op.inputCurrent(ctx) != nil || m.requestCurrent(ctx, op.request) != nil {
		if op != nil {
			op.cancelWorker()
		}
		return routerVPNExternalFailure
	}
	if info, err := owner.files.root.Lstat(routerVPNExecutionMeasurementCancelFile); !errors.Is(err, os.ErrNotExist) {
		raw, readErr := owner.files.read(routerVPNExecutionMeasurementCancelFile, m.wireLimit(routerVPNExecutionMeasurementRequestLimit))
		if err != nil || readErr != nil || !bytes.Equal(raw, op.raw) || op.cancelInfo != nil && !os.SameFile(info, op.cancelInfo) {
			op.cancelWorker()
			return routerVPNExternalFailure
		}
		op.cancelInfo = info
		op.cancelWorker()
	}
	if op.terminal != nil {
		return op.finishThroughput(ctx)
	}
	var status hopmeasure.Status
	if !op.started {
		status = routerVPNExecutionMeasurementCancelled(op.request.Request)
	} else {
		var raw string
		if op.throughput != nil {
			raw = op.throughput.StatusContextJSON(ctx)
		} else {
			raw = op.facade.StatusJSON()
		}
		if !routerVPNMTUStrict([]byte(raw), &status) || status.Request != op.request.Request {
			return routerVPNExternalFailure
		}
	}
	if !status.Complete || !status.Drained {
		return nil
	}
	if op.started {
		var err error
		if op.throughput != nil {
			err = op.throughput.Drain(op.request.Request)
		} else {
			err = op.facade.Drain(op.request.Request)
		}
		if err != nil {
			return err
		}
	}
	if owner.activity.Load() != nil || op.inputCurrent(ctx) != nil || m.requestCurrent(ctx, op.request) != nil {
		return routerVPNExternalFailure
	}
	result := routerVPNExecutionMeasurementResult{routerVPNExecutionMeasurementRequest: op.request, Status: status}
	throughputComplete := op.throughput != nil && status.Stage == "complete" && status.Failure == ""
	if throughputComplete && op.request.Operation == "selected-private-response" {
		proved, err := op.throughput.CompletedOrderedResponseContext(ctx, op.request.Request, op.request.Selected, op.request.Samples)
		if err != nil || !reflect.DeepEqual(proved, status) {
			return errors.Join(err, routerVPNExternalFailure)
		}
	} else if throughputComplete {
		proved, err := op.throughput.CompletedThroughputContext(ctx, op.request.Request, op.request.Selected, op.request.Bytes)
		if err != nil || !reflect.DeepEqual(proved, status) {
			// A completed worker can report a failed individual transfer. Join
			// normally and acknowledge the original request without any speed rows.
			result.Status = hopmeasure.Status{Request: op.request.Request, Stage: "failed", Complete: true, Drained: true,
				Failure: "An original selected upload or download could not be verified", Results: []hopmeasure.Result{}}
			throughputComplete = false
		}
	} else if op.facade != nil && status.Stage == "complete" && status.Failure == "" && len(status.Results) == 1 && status.Results[0].Ready {
		var saved hopmeasure.OrderedLatencyReceipt
		if !routerVPNMTUStrict([]byte(op.facade.SavedJSON(op.request.NodeID)), &saved) || saved.Request != op.request.Request || saved.NodeID != op.request.NodeID || saved.Position != op.request.Position || !reflect.DeepEqual(saved.Result, status.Results[0]) {
			return routerVPNExternalFailure
		}
		result.Saved = &saved
	}
	if err := op.closeFacade(ctx); err != nil {
		return err
	}
	if result.Saved != nil {
		if err := op.facade.ValidateClosedCaptureContext(ctx, op.request.Request, op.request.Selected); err != nil {
			return err
		}
	}
	// Keep the original shared measurement alive across closed-facade validation
	// and publication. Closing the service first destroys the required authority.
	if op.inputCurrent(ctx) != nil || m.requestCurrent(ctx, op.request) != nil || owner.activity.Load() != nil {
		return routerVPNExternalFailure
	}
	result.CompletedAt = time.Now().UnixMilli()
	if result.CompletedAt > op.request.Deadline || op.cancelInfo != nil {
		result.Saved = nil
		result.Status = routerVPNExecutionMeasurementCancelled(op.request.Request)
	}
	if op.throughput != nil {
		op.terminal = &result
		return op.finishThroughput(ctx)
	}
	if err := owner.files.publish(routerVPNExecutionMeasurementResultFile, result); err != nil {
		return err
	}
	if op.inputCurrent(ctx) != nil || m.requestCurrent(ctx, op.request) != nil {
		return errors.Join(routerVPNExternalFailure, owner.files.remove(routerVPNExecutionMeasurementResultFile))
	}
	if op.cancelInfo != nil {
		info, err := owner.files.root.Lstat(routerVPNExecutionMeasurementCancelFile)
		if err != nil || !os.SameFile(info, op.cancelInfo) || owner.files.root.Remove(routerVPNExecutionMeasurementCancelFile) != nil {
			return errors.Join(routerVPNExternalFailure, owner.files.remove(routerVPNExecutionMeasurementResultFile))
		}
	}
	info, err := owner.files.root.Lstat(routerVPNExecutionMeasurementRequestFile)
	if err != nil || !os.SameFile(info, op.info) || owner.files.root.Remove(routerVPNExecutionMeasurementRequestFile) != nil {
		return errors.Join(routerVPNExternalFailure, owner.files.remove(routerVPNExecutionMeasurementResultFile))
	}
	op.cancel()
	owner.measurementGeneration, owner.measurementLast = op.request.Generation, op.request.Request
	m.op.Store(nil)
	if op.facade != nil {
		m.facade = nil
	}
	return nil
}

// Keep a provisional terminal result private to this operation until its
// original request is retired. Never replace an existing result or remove
// a foreign cancellation/request during cleanup.
func (op *routerVPNDesktopExecutionMeasurementOperation) finishThroughput(ctx context.Context) error {
	m, files := op.owner, op.owner.owner.files
	if op.terminal == nil || m.owner.activity.Load() != nil || op.inputCurrent(ctx) != nil || m.requestCurrent(ctx, op.request) != nil {
		return routerVPNExternalFailure
	}
	for {
		if info, err := files.root.Lstat(routerVPNExecutionMeasurementCancelFile); !errors.Is(err, os.ErrNotExist) {
			if err != nil {
				return err
			}
			cancel := routerVPNSelectedCandidateFile{name: routerVPNExecutionMeasurementCancelFile, limit: op.owner.wireLimit(routerVPNExecutionMeasurementRequestLimit), info: info, raw: op.raw}
			if cancel.current(files) != nil || op.cancelInfo != nil && !os.SameFile(op.cancelInfo, info) {
				return routerVPNExternalFailure
			}
			op.cancelInfo = info
		}
		scored := op.terminal.Status.Stage == "complete" && op.terminal.Status.Failure == ""
		if op.cancelInfo != nil || time.Now().UnixMilli() > op.request.Deadline {
			if scored && op.issued.info != nil {
				// Withdraw only this request's own provisional success. Replacing
				// the result or consuming the request revokes this authority.
				if op.inputCurrent(ctx) != nil || op.issued.current(files) != nil || files.root.Remove(op.issued.name) != nil {
					return routerVPNExternalFailure
				}
				op.issued = routerVPNSelectedCandidateFile{}
			}
			op.terminal.Status = routerVPNExecutionMeasurementCancelled(op.request.Request)
			scored = false
		}
		if op.issued.info == nil {
			raw, err := json.Marshal(op.terminal)
			if err != nil {
				return err
			}
			pending, err := routerVPNStageSelectedMeasurement(files, op.request.Request, routerVPNExecutionThroughputResultFile, op.owner.wireLimit(routerVPNExecutionMeasurementLimit), raw)
			if err != nil {
				return err
			}
			op.issued, err = pending.link(files, routerVPNExecutionThroughputResultFile)
			pending.discard(files)
			if err != nil {
				return err
			}
		}
		if scored {
			if err := m.service.VerifySelectedCaptureContext(ctx, op.request.Selected); err != nil {
				return err
			}
		}
		if op.cancelInfo == nil && scored {
			_, err := files.root.Lstat(routerVPNExecutionMeasurementCancelFile)
			if err == nil || time.Now().UnixMilli() > op.request.Deadline {
				continue
			}
			if !errors.Is(err, os.ErrNotExist) {
				return err
			}
		}
		if err := op.retireThroughputInputs(ctx); err != nil {
			return err
		}
		op.cancel()
		m.owner.measurementGeneration, m.owner.measurementLast = op.request.Generation, op.request.Request
		m.op.Store(nil)
		return nil
	}
}

func (op *routerVPNDesktopExecutionMeasurementOperation) retireThroughputInputs(ctx context.Context) error {
	files := op.owner.owner.files
	if op.inputCurrent(ctx) != nil || op.owner.requestCurrent(ctx, op.request) != nil {
		return routerVPNExternalFailure
	}
	cancel := routerVPNSelectedCandidateFile{name: routerVPNExecutionMeasurementCancelFile, limit: op.owner.wireLimit(routerVPNExecutionMeasurementRequestLimit), info: op.cancelInfo, raw: op.raw}
	input := routerVPNSelectedCandidateFile{name: routerVPNExecutionMeasurementRequestFile, limit: op.owner.wireLimit(routerVPNExecutionMeasurementRequestLimit), info: op.info, raw: op.raw}
	for _, f := range []routerVPNSelectedCandidateFile{cancel, input} {
		if op.issued.current(files) != nil || f.info != nil && (f.current(files) != nil || files.root.Remove(f.name) != nil) {
			return routerVPNExternalFailure
		}
	}
	return nil
}

func routerVPNExecutionMeasurementCancelled(request string) hopmeasure.Status {
	return hopmeasure.Status{Request: request, Stage: "cancelled", Complete: true, Drained: true, Failure: "Selected measurement cancelled", Results: []hopmeasure.Result{}}
}
