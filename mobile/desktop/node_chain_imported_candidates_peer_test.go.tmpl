// This component runs the actual complete imported-SS Run and its public
// NewMeasurementContext before every measurement. Packet/SS encryption, private
// proofs, final selected DNS and destination TCP handshakes are real. The outer
// host/session observation is explicit; installed TUN ownership is a separate
// gate. No closed-prefix preparation or direct candidate dialer participates.
type connectedImportedCandidateEngine struct {
	*nodeChainImportedSSPrefixComponent
	address, tag               string
	dials, closed              atomic.Int32
	changedNetwork             atomic.Bool
	onClose                    func()
	closeEntered, closeRelease chan struct{}
	closeOnce                  sync.Once
}

func (e *connectedImportedCandidateEngine) ObserveChainContext(ctx context.Context) (mobilemultihop.NodeChainIdentity, error) {
	identity, err := e.nodeChainImportedSSPrefixComponent.ObserveChainContext(ctx)
	if e.changedNetwork.Load() {
		identity.NetworkID = "replaced-native-network"
	}
	return identity, err
}

func (e *connectedImportedCandidateEngine) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if address != e.address {
		return e.nodeChainImportedSSPrefixComponent.Dial(ctx, tag, address)
	}
	if tag != e.tag {
		return nil, errors.New("candidate changed the retained packet prefix")
	}
	e.dials.Add(1)
	conn, err := e.nodeChainImportedSSPrefixComponent.Dial(ctx, tag, address)
	if err != nil {
		return conn, err
	}
	return &connectedImportedCandidateConnection{Conn: conn, owner: e}, nil
}

type connectedImportedCandidateConnection struct {
	net.Conn
	owner *connectedImportedCandidateEngine
	once  sync.Once
	err   error
}

func (c *connectedImportedCandidateConnection) Close() error {
	c.once.Do(func() {
		if c.owner.closeEntered != nil {
			c.owner.closeOnce.Do(func() { close(c.owner.closeEntered) })
			<-c.owner.closeRelease
		}
		c.err = c.Conn.Close()
		c.owner.closed.Add(1)
		if c.owner.onClose != nil {
			c.owner.onClose()
		}
	})
	return c.err
}

type connectedImportedCandidateOwner struct {
	*nodeChainImportedSSPrefixFixture
	capture        string
	changedCatalog atomic.Bool
}

func (o *connectedImportedCandidateOwner) CandidateInventoryCurrentContext(ctx context.Context, capture string) error {
	if ctx == nil || ctx.Err() != nil || o.changedCatalog.Load() || capture != o.capture {
		return hopmeasure.ErrStale
	}
	_, err := o.MeasurementChainContext(ctx)
	return err
}

type connectedImportedCandidateFixture struct {
	path           *nodeChainImportedSSPrefixFixture
	engine         *connectedImportedCandidateEngine
	owner          *connectedImportedCandidateOwner
	plan           *mobilemultihop.NodeChainCandidatePlan
	target, source string
	accepted       atomic.Int32
}

func newConnectedImportedCandidateFixture(t *testing.T, mode string, count, position int, fault string) *connectedImportedCandidateFixture {
	t.Helper()
	f := &connectedImportedCandidateFixture{}
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	done := make(chan struct{})
	go func() {
		defer close(done)
		for {
			conn, err := listener.Accept()
			if err != nil {
				return
			}
			f.accepted.Add(1)
			_ = conn.Close()
		}
	}()
	t.Cleanup(func() { _ = listener.Close(); <-done })
	const address = "198.51.100.240:8388"
	// Fix the one fixture-owned literal route before the selected reference
	// device starts; eager native keepalive cannot race an allowlist mutation.
	f.path = nodeChainImportedSSPrefixStartPrepared(t, mode, "literal", importedSSPrefixMethod(mode), fault, count, 85*time.Second, func(originalPosition int, handler *desktopNodeWGHandler) {
		if originalPosition != position {
			return
		}
		if _, exists := handler.rules["tcp/"+address]; exists {
			t.Fatal("candidate replaced an existing original route")
		}
		handler.rules["tcp/"+address] = desktopReferenceRule{Network: "tcp", Address: "198.51.100.240", Port: 8388, Target: listener.Addr().String()}
	})
	launch, err := f.path.chain.LaunchInput()
	var source mobilemultihop.NodeChainSource
	if err != nil || json.Unmarshal([]byte(launch), &source) != nil {
		t.Fatal("complete original source absent", err)
	}
	var member struct {
		Kind    string `json:"kind"`
		Schema  int    `json:"schema"`
		Config  string `json:"config"`
		Capture string `json:"capture"`
	}
	if json.Unmarshal([]byte(source.Nodes[count]), &member) != nil {
		t.Fatal("original imported source absent")
	}
	var graph, capture map[string]any
	if json.Unmarshal([]byte(member.Config), &graph) != nil || json.Unmarshal([]byte(member.Capture), &capture) != nil {
		t.Fatal("original imported source malformed")
	}
	profile := capture["profile"].(map[string]any)
	transport := profile["external"].(map[string]any)["shadowsocks"].(map[string]any)
	row := graph["outbounds"].([]any)[0].(map[string]any)
	size := 32
	if importedSSPrefixMethod(mode) == "2022-blake3-aes-128-gcm" {
		size = 16
	}
	password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{85}, size))
	f.target = "independent-connected-candidate"
	capture["exit_id"], profile["id"] = f.target, f.target
	profile["endpoint"], transport["server"], row["server"] = "198.51.100.240", "198.51.100.240", "198.51.100.240"
	transport["password"], row["password"] = password, password
	input, err := mobilemultihop.NodeChainImportedMemberInput(desktopNodeChainJSON(t, graph), desktopNodeChainJSON(t, capture))
	if err != nil {
		t.Fatal("independent original candidate refused", err)
	}
	inventory := desktopNodeChainJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "connected-complete-ss-catalog-1", Inputs: []string{input}})
	f.plan, err = f.path.chain.NewCandidatePlan(position, inventory)
	if err != nil {
		t.Fatal("connected complete SS candidate plan refused", err)
	}
	var metadata struct {
		Targets []struct {
			ID     string `json:"id"`
			Source string `json:"source_sha256"`
		} `json:"targets"`
	}
	if json.Unmarshal([]byte(f.plan.Metadata()), &metadata) != nil || len(metadata.Targets) != 1 || metadata.Targets[0].ID != f.target {
		t.Fatal("candidate source metadata absent")
	}
	f.source = metadata.Targets[0].Source
	f.engine = &connectedImportedCandidateEngine{nodeChainImportedSSPrefixComponent: f.path.engine, address: address, tag: f.path.chain.PrefixTags()[position]}
	f.owner = &connectedImportedCandidateOwner{nodeChainImportedSSPrefixFixture: f.path, capture: f.plan.CaptureSHA256()}
	return f
}

func (f *connectedImportedCandidateFixture) prove(t *testing.T) {
	t.Helper()
	if service, err := f.plan.NewMeasurementContext(f.path.ctx, f.owner); err == nil || service != nil || f.accepted.Load() != 0 {
		t.Fatal("unproved complete source acquired connected candidate")
	}
	if err := f.path.chain.Run(f.path.ctx, f.engine); err != nil {
		t.Fatal("complete native SS chain failed", err, f.path.chain.Progress(), f.path.snapshot())
	}
	progress, stats := f.path.chain.Progress(), f.path.snapshot()
	if !progress.Ready || !progress.Complete || !progress.DNSProven || !progress.PublicProven || len(progress.Prefixes) != len(f.path.request.Prefixes)+2 || stats.Final.RouterQueries < 2 || stats.Final.DNSQueries == 0 || stats.Middle.PublicQueries < 2 {
		t.Fatal("connected candidate lost complete native proof", progress, stats)
	}
	for i, prefix := range stats.Prefixes {
		if prefix.RawUDP == 0 || prefix.ProofQueries < 2 {
			t.Fatal("connected candidate skipped original encrypted prefix", i, prefix)
		}
	}
}

func (f *connectedImportedCandidateFixture) waitAccepted(t *testing.T, want int32) {
	t.Helper()
	ctx, cancel := context.WithTimeout(f.path.ctx, time.Second)
	defer cancel()
	tick := time.NewTicker(time.Millisecond)
	defer tick.Stop()
	for {
		if got := f.accepted.Load(); got == want {
			return
		} else if got > want {
			t.Fatal("extra candidate destination connection", got, want)
		}
		select {
		case <-ctx.Done():
			t.Fatal("original candidate destination did not accept every connection", f.accepted.Load(), want)
		case <-tick.C:
		}
	}
}

func (f *connectedImportedCandidateFixture) service(t *testing.T) *hopmeasure.CandidateService {
	t.Helper()
	service, err := f.plan.NewMeasurementContext(f.path.ctx, f.owner)
	if err != nil {
		t.Fatal("actual full-chain measurement constructor refused", err)
	}
	t.Cleanup(func() {
		if err := service.Close(); err != nil {
			t.Error("candidate retirement did not join", err)
		}
	})
	return service
}

func TestRouterVPNConnectedImportedSSCandidates(t *testing.T) {
	value := os.Getenv("ROUTERVPN_CONNECTED_IMPORTED_CANDIDATE_CASE")
	if value == "" {
		t.Skip("exact connected imported candidate case required")
	}
	parts := strings.Split(value, "/")
	if len(parts) != 3 || importedSSPrefixMethod(parts[0]) == "" {
		t.Fatal("foreign connected candidate case")
	}
	count, err := strconv.Atoi(parts[1])
	position, positionErr := strconv.Atoi(parts[2])
	if err != nil || positionErr != nil || strconv.Itoa(count) != parts[1] || strconv.Itoa(position) != parts[2] || (count != 2 && count != 6) || position < 0 || position >= count {
		t.Fatal("foreign connected candidate position")
	}
	t.Run(strings.ReplaceAll(value, "/", "-"), func(t *testing.T) {
		f := newConnectedImportedCandidateFixture(t, parts[0], count, position, "")
		f.prove(t)
		before := f.path.snapshot()
		service := f.service(t)
		request := strings.Repeat("a", 32)
		if err := service.StartContext(f.path.ctx, request, f.target); err != nil {
			t.Fatal(err)
		}
		if err := desktopCandidateNativeDrain(f.path.ctx, service, request); err != nil {
			t.Fatal(err)
		}
		status := desktopCandidateNativeStatus(t, service)
		if !status.Complete || !status.Drained || status.Failure != "" || len(status.Results) != 1 || !status.Results[0].Ready || status.Results[0].Benchmark == nil || status.Results[0].Benchmark.Attempts != 50 || status.Results[0].Benchmark.Distribution.Samples != 50 || status.Measurement != "routed-tcp-connect" || status.PrefixPosition != position || status.CaptureSHA256 != f.plan.CaptureSHA256() || status.CandidateSourceSHA256 != f.source {
			t.Fatal("incomplete original fifty connection receipt", status)
		}
		f.waitAccepted(t, 50)
		if f.accepted.Load() != 50 || f.engine.dials.Load() != 50 || f.engine.closed.Load() != 50 || f.path.measuring.Load() || f.path.acquired.Load() != 1 || f.path.released.Load() != 1 {
			t.Fatal("original sockets or activity were not joined", f.accepted.Load(), f.engine.dials.Load(), f.engine.closed.Load())
		}
		after := f.path.snapshot()
		for i := 0; i <= position; i++ {
			if after.Prefixes[i].RawUDP <= before.Prefixes[i].RawUDP {
				t.Fatal("candidate bypassed original encrypted prefix", i)
			}
		}
		if f.path.chain.HealthyContext(f.path.ctx) != nil {
			t.Fatal("candidate replaced or retired the original connected path")
		}
		if err := service.Close(); err != nil {
			t.Fatal(err)
		}
		if err := f.path.close(); err != nil {
			t.Fatal(err)
		}
		if service.Start(strings.Repeat("b", 32), f.target) == nil {
			t.Fatal("retired native chain retained candidate capability")
		}
		t.Logf("CONNECTED_IMPORTED_CANDIDATE_RECEIPT count=%d position=%d samples=50 closed=50 released=1 complete_ready=true selected_dns=true joined=true", count, position)
	})
}

func TestRouterVPNConnectedImportedSSCandidateRefusals(t *testing.T) {
	fault := os.Getenv("ROUTERVPN_CONNECTED_IMPORTED_CANDIDATE_FAULT")
	if fault == "" {
		t.Skip("exact connected imported candidate refusal required")
	}
	switch fault {
	case "wrong-intermediate-key", "wrong-middle-key", "wrong-final-identity", "selected-dns-failure", "catalog-change", "network-change", "native-retired", "cancel-held-close":
	default:
		t.Fatal("foreign connected candidate refusal")
	}
	t.Run(fault, func(t *testing.T) {
		providerFault := ""
		if fault == "wrong-intermediate-key" || fault == "wrong-middle-key" || fault == "wrong-final-identity" || fault == "selected-dns-failure" {
			providerFault = fault
		}
		f := newConnectedImportedCandidateFixture(t, "awg2-strong", 6, 5, providerFault)
		if providerFault != "" {
			ctx, cancel := context.WithTimeout(f.path.ctx, 5*time.Second)
			defer cancel()
			if err := f.path.chain.Run(ctx, f.engine); err == nil || f.path.chain.Progress().Ready {
				t.Fatal("failed complete proof became Ready")
			}
			if service, err := f.plan.NewMeasurementContext(f.path.ctx, f.owner); err == nil || service != nil || f.accepted.Load() != 0 {
				t.Fatal("unproved suffix granted earlier prefix candidate timing")
			}
			stats := f.path.snapshot()
			if fault == "wrong-intermediate-key" || fault == "wrong-middle-key" {
				if len(stats.Prefixes) != 6 {
					t.Fatal("wrong-key refusal lost original prefix counter inventory", stats)
				}
				proved := len(stats.Prefixes)
				if fault == "wrong-intermediate-key" {
					proved--
				}
				for i := 0; i < proved; i++ {
					if stats.Prefixes[i].RawUDP == 0 || stats.Prefixes[i].ProofQueries == 0 {
						t.Fatal("wrong-key refusal failed before its intended original hop", i, stats)
					}
				}
				if fault == "wrong-intermediate-key" && (stats.Prefixes[5].RawUDP == 0 || stats.Prefixes[5].ProofQueries != 0 || stats.Middle.RawTCP != 0 || stats.Middle.PublicQueries != 0 || stats.Final.RouterQueries != 0) {
					t.Fatal("wrong last-prefix key did not stop at the original encrypted hop", stats)
				}
				if fault == "wrong-middle-key" && (stats.Middle.RawTCP == 0 || stats.Middle.PublicQueries != 0 || stats.Final.RouterQueries != 0) {
					t.Fatal("wrong middle key did not stop after the complete original packet prefix", stats)
				}
			}
			if (fault == "wrong-final-identity" || fault == "selected-dns-failure") && stats.Final.RouterQueries == 0 {
				t.Fatal("full-proof refusal did not reach original final")
			}
			if fault == "selected-dns-failure" && (stats.Final.DNSQueries == 0 || stats.Middle.PublicQueries == 0 || stats.Final.FinalPublicQueries != 0) {
				t.Fatal("selected DNS refusal lost prior private/public-middle proof or reached final public success", stats)
			}
			return
		}
		f.prove(t)
		var releaseOnce sync.Once
		release := func() {
			releaseOnce.Do(func() {
				if f.engine.closeRelease != nil {
					close(f.engine.closeRelease)
				}
			})
		}
		defer release()
		if fault == "cancel-held-close" {
			f.engine.closeEntered, f.engine.closeRelease = make(chan struct{}), make(chan struct{})
		} else {
			f.engine.onClose = func() {
				switch fault {
				case "catalog-change":
					f.owner.changedCatalog.Store(true)
				case "network-change":
					f.engine.changedNetwork.Store(true)
				case "native-retired":
					f.path.engine.closed.Store(true)
				}
			}
		}
		service := f.service(t)
		request := strings.Repeat("c", 32)
		if err := service.StartContext(f.path.ctx, request, f.target); err != nil {
			t.Fatal(err)
		}
		if fault == "cancel-held-close" {
			select {
			case <-f.engine.closeEntered:
			case <-f.path.ctx.Done():
				t.Fatal("original connection never entered Close")
			}
			service.Cancel(request)
			ctx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
			closeErr := service.CloseContext(ctx)
			cancel()
			if closeErr == nil || !f.path.measuring.Load() || f.path.released.Load() != 0 {
				t.Fatal("held original socket released native activity")
			}
			release()
		}
		if err := desktopCandidateNativeDrain(f.path.ctx, service, request); err != nil {
			t.Fatal("refused candidate did not join", err)
		}
		status := desktopCandidateNativeStatus(t, service)
		f.waitAccepted(t, 1)
		if !status.Drained || len(status.Results) != 0 || f.accepted.Load() != 1 || f.engine.dials.Load() != 1 || f.engine.closed.Load() != 1 || f.path.measuring.Load() || f.path.released.Load() != 1 {
			t.Fatal("failed candidate published or lost original socket/hold", status, f.accepted.Load(), f.engine.closed.Load())
		}
		if fault != "cancel-held-close" {
			f.owner.changedCatalog.Store(false)
			f.engine.changedNetwork.Store(false)
			if service.Start(strings.Repeat("d", 32), f.target) == nil {
				t.Fatal("restored values revived revoked complete-path measurement")
			}
		}
	})
}
