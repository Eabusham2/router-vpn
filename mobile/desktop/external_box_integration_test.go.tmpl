func (p *desktopExternalIntegrationPeer) NewConnectionEx(ctx context.Context, connection net.Conn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
	p.mu.Lock()
	if p.closing {
		p.mu.Unlock()
		_ = connection.Close()
		if onClose != nil {
			onClose(net.ErrClosed)
		}
		return
	}
	p.connections[connection] = true
	p.workers.Add(1)
	p.mu.Unlock()
	serve := func() {
		defer func() {
			_ = connection.Close()
			p.mu.Lock()
			delete(p.connections, connection)
			p.mu.Unlock()
			p.workers.Done()
		}()
		err := p.NewConnection(ctx, connection, M.Metadata{Source: source, Destination: destination})
		p.recordFailure(err)
		if onClose != nil {
			onClose(err)
		}
	}
	if desktopExternalIntegrationPacketEndpoint(p.protocol) {
		go serve()
	} else {
		serve()
	}
}

