func (f *desktopExternalIntegrationFixture) prove(t *testing.T) {
	t.Helper()
	raw, err := f.proof.Run()
	var result mobilemultihop.ExternalProofResult
	if err != nil || json.Unmarshal([]byte(raw), &result) != nil {
		t.Fatal("unmodified native shared proof failed", err, raw, f.peer.diagnostic())
	}
	meta := f.policy.Metadata()
	if result.Schema != 1 || result.SessionID != meta.SessionID || result.SourceSHA256 != meta.OriginalSourceSHA256 || result.ConfigSHA256 != meta.OriginalConfigSHA256 || result.ExitID != "selected-external-native" || result.IP != desktopExternalIntegrationIP || !result.DNSProven || result.EntryProven || result.CheckedAt <= 0 || !f.proof.Healthy() || !f.network.Current() {
		t.Fatal("real proof changed original authority or lost derived native ownership", result)
	}
	if f.peer.dnsQueries.Load() == 0 || f.peer.tlsHandshakes.Load() != 1 || f.peer.publicRequests.Load() != 1 || f.peer.accepted.Load() < 2 || f.peer.bypassed.Load() != 0 {
		t.Fatal("real selected DNS or public TLS skipped the captured lower path", f.peer.dnsQueries.Load(), f.peer.tlsHandshakes.Load(), f.peer.publicRequests.Load(), f.peer.accepted.Load())
	}
	if err = f.proof.VerifyCurrentPath(); err != nil {
		t.Fatal("real proof did not retain its exact generation", err)
	}
}

// Replacing the OS reader is the sole transaction seam. The real native
// inbound manager performs all stages, teardown, serialization, cancellation
// rollback and publication; the shipping lease retains its actual returned
// reader and physical retirement/rebind acknowledgments around the operation.
func (f *desktopExternalIntegrationFixture) replacement(callback func(adapter.StartStage) error, adopted **desktopTorMTUCandidate, restored **desktopTorMTUCandidate) func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) {
	return func(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
		reader, ok := expected.(routerVPNDesktopTorTUN)
		if !ok {
			return expected, errors.New("fixture received another reader family")
		}
		name, index, oldMTU, err := reader.RouterVPNDesktopMTUInterface()
		if err != nil {
			return expected, err
		}
		makeReader := func(value, nextIndex int) *desktopTorMTUCandidate {
			return &desktopTorMTUCandidate{desktopTorBoxTUN: &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, expected.Tag()), name: name, index: nextIndex, mtu: value, claimed: true, guard: f.proof.engine.physical.current}}
		}
		candidate, rollback := makeReader(mtu, index+1), makeReader(oldMTU, index+2)
		candidate.afterStart = callback
		*adopted, *restored = candidate, rollback
		return f.box.inbound.RouterVPNReplaceTun(ctx, expected, candidate, rollback)
	}
}

func TestRouterVPNDesktopExternalPhysicalIntegration(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("ordinary native physical admission requires Linux or Windows")
	}
	const marker = "ROUTERVPN_DESKTOP_EXTERNAL_COMPOSITION_CHILD"
	if os.Getenv(marker) != "1" {
		executable, err := os.Executable()
		if err != nil {
			t.Fatal(err)
		}
		ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
		defer cancel()
		// A broad shipping selector must not run unrelated tests in this child
		// before its isolated trust root is installed. Preserve only an exact
		// caller-requested suffix for this parent's own focused subtests.
		selector := "^TestRouterVPNDesktopExternalPhysicalIntegration$"
		requested := flag.Lookup("test.run").Value.String()
		if strings.HasPrefix(requested, selector+"/") {
			selector = requested
		}
		command := exec.CommandContext(ctx, executable, "-test.run="+selector, "-test.v", "-test.timeout=80s")
		command.Env = append(os.Environ(), marker+"=1")
		output, err := command.CombinedOutput()
		if err != nil {
			t.Fatalf("actual external composition child failed: %v\n%s", err, output)
		}
		t.Log(string(output))
		return
	}
	ca := newDesktopExternalIntegrationCA(t)
	if runtime.GOOS == "windows" {
		// Windows does not consume SSL_CERT_FILE. This isolated test child
		// replaces only its own verifier roots; normal chain/name checks and
		// the wrong-root negative still execute without a production TLS seam.
		roots := x509.NewCertPool()
		root, err := x509.ParseCertificate(ca.der)
		if err != nil {
			t.Fatal("isolated Windows fixture root is invalid", err)
		}
		roots.AddCert(root)
		t.Setenv("GODEBUG", os.Getenv("GODEBUG")+",x509usefallbackroots=1")
		x509.SetFallbackRoots(roots)
	}
	directory := t.TempDir()
	rootPath := filepath.Join(directory, "fixture-ca.pem")
	if err := os.WriteFile(rootPath, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: ca.der}), 0600); err != nil {
		t.Fatal(err)
	}
	t.Setenv("SSL_CERT_FILE", rootPath)
	t.Setenv("SSL_CERT_DIR", directory)
	t.Run("delayed-accept-retains-prior-grant", desktopExternalIntegrationDelayedAccept)
	for _, protocol := range []string{"http-connect", "https-connect", "shadowsocks"} {
		t.Run(protocol+"/proof-and-mtu", func(t *testing.T) {
			f := newDesktopExternalIntegrationFixture(t, ca, protocol, "")
			f.prove(t)
			lease, err := f.box.RouterVPNExternalClaimMTU(f.proof, f.originalSource, f.originalCapture)
			if err != nil {
				t.Fatal("real successful proof did not grant MTU lease", err)
			}
			defer lease.Close()
			var authority map[string]any
			if json.Unmarshal([]byte(lease.Authority()), &authority) != nil || len(authority) != 6 || authority["source_sha256"] != f.policy.Metadata().SourceSHA256 || authority["id"] != "selected-external-native" || authority["expected_public_ip"] != desktopExternalIntegrationIP || authority["mtu_policy"] != "auto" || lease.Config() != f.policy.Config() {
				t.Fatal("MTU authority relabeled or lost original policy fields", authority)
			}
			if second, err := f.box.RouterVPNExternalClaimMTU(f.proof, f.originalSource, f.originalCapture); err == nil || second != nil {
				t.Fatal("one proof granted two MTU owners")
			}
			original, err := lease.Inbound()
			if err != nil {
				t.Fatal(err)
			}
			var candidate, rollback *desktopTorMTUCandidate
			current, err := lease.changeMTU(context.Background(), original, 1400, f.replacement(nil, &candidate, &rollback))
			if err != nil || current != candidate || current == original {
				t.Fatal("real native candidate was not published", err)
			}
			name, index, mtu, err := lease.ClaimDesktopTUN(func() bool { return true })
			if err != nil || name != "router-vpn" || index != 742 || mtu != 1400 || !lease.Healthy() {
				t.Fatal("native candidate lost captured readback", name, index, mtu, err)
			}
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			returned, err := lease.changeMTU(ctx, current, 1500, f.replacement(func(stage adapter.StartStage) error {
				if stage == adapter.StartStateStarted {
					cancel()
				}
				return nil
			}, &candidate, &rollback))
			if err == nil || returned != rollback || returned == current || returned == candidate {
				t.Fatal("cancelled operation failed to retain the exact native rollback", err)
			}
			actual, ok := f.box.inbound.Get("tun-in")
			if !ok || actual != rollback {
				t.Fatal("MTU lease adopted a reader not published by the actual native manager")
			}
			name, index, mtu, err = lease.ClaimDesktopTUN(func() bool { return true })
			if err != nil || name != "router-vpn" || index != 744 || mtu != 1400 || !lease.Healthy() || !f.proof.Healthy() || !f.network.Current() {
				t.Fatal("cancelled MTU operation destroyed its valid rollback connection", name, index, mtu, err)
			}
			f.source.mu.Lock()
			binds, retires, boundIndex := f.source.binds, f.source.retires, f.source.index
			f.source.mu.Unlock()
			if binds != 3 || retires != 2 || boundIndex != 744 {
				t.Fatal("native candidate or cancellation bypassed exact physical retire/rebind", binds, retires, boundIndex)
			}
			if err = f.proof.engine.DNSProof(context.Background(), "tun-in"); err != nil {
				t.Fatal("restored connection lost actual selected DNS", err)
			}
			if err = mobilemultihop.ProveExternalPublicIP(context.Background(), f.proof.engine.Dial, mobilemultihop.ExternalFinalTag, desktopExternalIntegrationIP); err != nil {
				t.Fatal("restored connection lost actual authenticated public proof path", err)
			}
			if f.peer.publicRequests.Load() != 2 || !f.proof.Healthy() {
				t.Fatal("rollback reused an old successful network result")
			}
			called := false
			if _, err = lease.changeMTU(context.Background(), original, 1450, func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) { called = true; return nil, nil }); err == nil || called {
				t.Fatal("retired original reader mutated its replacement")
			}
		})
		for _, fault := range []string{"dns", "exit", "credential", "tls-name", "tls-root", "lower-denied"} {
			t.Run(protocol+"/reject/"+fault, func(t *testing.T) {
				f := newDesktopExternalIntegrationFixture(t, ca, protocol, fault)
				raw, err := f.proof.Run()
				if err == nil || raw != "" || f.proof.Healthy() || f.network.Current() || !f.source.cancelled.Load() {
					t.Fatal("invalid actual DNS/TLS/credential/physical path acquired proof", fault, raw, err)
				}
				if _, err = f.box.RouterVPNExternalClaimMTU(f.proof, f.originalSource, f.originalCapture); err == nil {
					t.Fatal("failed actual proof acquired MTU authority")
				}
				if fault == "dns" && (f.peer.dnsQueries.Load() == 0 || f.peer.publicAttempts.Load() != 0) {
					t.Fatal("public proof bypassed failed selected DNS")
				}
				if (fault == "tls-name" || fault == "tls-root") && (f.peer.dnsQueries.Load() == 0 || f.peer.publicAttempts.Load() != 1 || f.peer.publicRequests.Load() != 0) {
					t.Fatal("invalid certificate carried private proof request bytes")
				}
				if fault == "exit" && (f.peer.dnsQueries.Load() == 0 || f.peer.tlsHandshakes.Load() != 1 || f.peer.publicRequests.Load() != 1) {
					t.Fatal("wrong-exit negative never reached the real authenticated public proof", f.peer.diagnostic())
				}
				if fault == "credential" && (f.peer.accepted.Load() == 0 || f.peer.dnsQueries.Load() != 0 || f.peer.publicAttempts.Load() != 0) {
					t.Fatal("credential negative never reached the actual proxy authentication boundary", f.peer.diagnostic())
				}
				if fault == "lower-denied" && f.peer.accepted.Load() != 0 {
					t.Fatal("denied lower path connected through a default dialer")
				}
			})
		}
	}
	for _, afterPublication := range []bool{false, true} {
		name := "network-reset-during-mtu"
		if afterPublication {
			name = "network-reset-after-native-publication"
		}
		t.Run(name, func(t *testing.T) {
			f := newDesktopExternalIntegrationFixture(t, ca, "http-connect", "")
			f.prove(t)
			lease, err := f.box.RouterVPNExternalClaimMTU(f.proof, f.originalSource, f.originalCapture)
			if err != nil {
				t.Fatal(err)
			}
			defer lease.Close()
			initial, err := lease.Inbound()
			if err != nil {
				t.Fatal(err)
			}
			var candidate, rollback *desktopTorMTUCandidate
			var transaction context.Context
			replace := f.replacement(func(stage adapter.StartStage) error {
				if stage == adapter.StartStateStarted && !afterPublication {
					f.network.InterfaceUpdated(context.Background())
					// Join the real captured cancellation before returning this entered
					// startup stage. No scheduler delay is used to guess propagation.
					select {
					case <-transaction.Done():
					case <-time.After(3 * time.Second):
						return errors.New("native network cancellation did not reach the entered transaction")
					}
				}
				return nil
			}, &candidate, &rollback)
			current, err := lease.changeMTU(context.Background(), initial, 1400, func(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
				transaction = ctx
				result, changeErr := replace(ctx, expected, mtu)
				if afterPublication {
					f.network.InterfaceUpdated(context.Background())
				}
				return result, changeErr
			})
			if err == nil || lease.Healthy() || f.proof.Healthy() || f.network.Current() {
				t.Fatal("real network cancellation resurrected a candidate or rollback", err)
			}
			actual, exists := f.box.inbound.Get("tun-in")
			if !afterPublication {
				if current != nil || exists || actual != nil {
					t.Fatal("retired physical generation kept a replacement reader")
				}
			} else {
				// Returning the exact published reader on a failed adoption preserves
				// cleanup ownership; it cannot become a healthy connection or permit.
				if current != candidate || !exists || actual != candidate {
					t.Fatal("late network cancellation discarded or changed the actual published cleanup owner")
				}
				if _, _, _, readErr := candidate.RouterVPNDesktopMTUInterface(); readErr == nil {
					t.Fatal("late network cancellation left a usable native reader")
				}
			}
			f.source.mu.Lock()
			binds := f.source.binds
			f.source.mu.Unlock()
			if binds != 1 {
				t.Fatal("retired physical generation reacquired TUN authority")
			}
		})
	}
	t.Run("network-reset-during-real-proof", func(t *testing.T) {
		f := newDesktopExternalIntegrationFixture(t, ca, "http-connect", "held-proof")
		result := make(chan error, 1)
		go func() {
			raw, err := f.proof.Run()
			if raw != "" {
				err = errors.New("cancelled proof published data")
			}
			result <- err
		}()
		select {
		case <-f.peer.publicEntered:
		case <-time.After(5 * time.Second):
			t.Fatal("actual TLS proof never reached controlled peer")
		}
		f.network.InterfaceUpdated(context.Background())
		close(f.peer.publicRelease)
		select {
		case err := <-result:
			if err == nil || f.proof.Healthy() || f.network.Current() {
				t.Fatal("cancelled real network result was adopted")
			}
		case <-time.After(5 * time.Second):
			t.Fatal("cancelled real TLS proof did not join")
		}
	})
	if t.Failed() {
		return
	}
	t.Log("Original compiler -> derived Box -> real lower sockets -> selected DNS -> verified TLS public proof and actual native-manager MTU rollback passed. OS permit identity and TUN creation remain explicit separate kernel-test boundaries.")
}
