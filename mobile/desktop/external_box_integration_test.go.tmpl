// This composition retains the original compiler, derived Box, native lower
// outbound, broker sockets, selected DNS router, normal certificate validation
// and unmodified shared proof. Only privileged OS permit/identity operations
// and the TUN device are fixtures. A local proxy terminates the selected remote
// protocols; it never dials any public or private remote address. These results
// are not a kernel firewall, physical-device or private deployment acceptance.
const desktopExternalIntegrationDNS = "192.168.50.53:5353"
const desktopExternalIntegrationIP = "203.0.113.88"
const desktopExternalIntegrationUser = "captured-native-user"
const desktopExternalIntegrationPassword = "captured-native-password"

// Policy and lifecycle source are deliberately separate: the broker exercises
// its ordinary real socket implementation while the OS constructor is an
// explicit boundary. The source cannot supply or fabricate connected sockets.
type desktopExternalIntegrationKernel struct {
	source   *desktopExternalIntegrationSource
	local    netip.Addr
	remote   netip.AddrPort
	index    uint32
	name     string
	deny     atomic.Bool
	mu       sync.Mutex
	grants   map[string]mobiletor.DesktopSocketGrant
	issued   map[string]*desktopExternalIntegrationGrant
	requests int
}

// Accept can be scheduled after the sender has already closed its socket and
// revoked the permit. Retain a one-use receipt of each actual prior Grant;
// looking only at current permits mistakes that joined teardown for a bypass.
type desktopExternalIntegrationGrant struct {
	grant    mobiletor.DesktopSocketGrant
	at       time.Time
	accepted bool
}

type desktopExternalIntegrationSource struct {
	capture                 mobiletor.DesktopSocketCapture
	owner                   mobiletor.DesktopSocketKernelOwner
	kernel                  *desktopExternalIntegrationKernel
	live, cancelled, closed atomic.Bool
	mu                      sync.Mutex
	name                    string
	index                   uint32
	binds, retires          int
}

func (p *desktopExternalIntegrationKernel) Owner() (mobiletor.DesktopSocketKernelOwner, error) {
	return p.source.owner, nil
}
func (p *desktopExternalIntegrationKernel) Current(c mobiletor.DesktopSocketCapture, o mobiletor.DesktopSocketKernelOwner) bool {
	return p.source.live.Load() && c == p.source.capture && o == p.source.owner
}
func (p *desktopExternalIntegrationKernel) Select(ctx context.Context, c mobiletor.DesktopSocketCapture, network string, remote netip.AddrPort) (mobiletor.DesktopSocketBinding, error) {
	if ctx.Err() != nil || !p.Current(c, p.source.owner) || network != "tcp" || remote != p.remote || p.deny.Load() {
		return mobiletor.DesktopSocketBinding{}, errors.New("local composition source denied another path")
	}
	return mobiletor.DesktopSocketBinding{Owner: p.source.owner, InterfaceName: p.name, InterfaceIndex: p.index, LocalAddress: p.local}, nil
}
func (p *desktopExternalIntegrationKernel) Bind(ctx context.Context, c mobiletor.DesktopSocketCapture, b mobiletor.DesktopSocketBinding, network string, raw syscall.RawConn) error {
	if ctx.Err() != nil || !p.Current(c, b.Owner) || b.LocalAddress != p.local || b.InterfaceName != p.name || b.InterfaceIndex != p.index || network != "tcp4" || raw == nil {
		return errors.New("local composition binding lost its captured source")
	}
	return raw.Control(func(uintptr) {})
}
func (p *desktopExternalIntegrationKernel) Grant(ctx context.Context, q mobiletor.DesktopSocketGrant) (mobiletor.DesktopSocketReceipt, error) {
	if ctx.Err() != nil || !p.Current(q.Capture, q.Binding.Owner) || q.Network != "tcp" || q.Remote != p.remote || q.Local.Addr() != p.local || q.Local.Port() == 0 || p.deny.Load() {
		return mobiletor.DesktopSocketReceipt{}, errors.New("local composition source refused a different grant")
	}
	p.mu.Lock()
	if previous, ok := p.issued[q.SocketID]; ok {
		identity := q
		identity.Sequence = previous.grant.Sequence
		if previous.grant != identity {
			p.mu.Unlock()
			return mobiletor.DesktopSocketReceipt{}, errors.New("local composition renewed a different captured socket")
		}
	}
	if p.issued == nil {
		p.issued = make(map[string]*desktopExternalIntegrationGrant)
	}
	if p.issued[q.SocketID] == nil {
		p.issued[q.SocketID] = &desktopExternalIntegrationGrant{grant: q, at: time.Now()}
	}
	p.requests++
	p.grants[q.SocketID] = q
	p.mu.Unlock()
	now := time.Now()
	return mobiletor.DesktopSocketReceipt{Grant: q, ObservedAt: now.UnixMilli(), ExpiresAt: now.Add(10 * time.Second).UnixMilli()}, nil
}
func (p *desktopExternalIntegrationKernel) Revoke(_ context.Context, q mobiletor.DesktopSocketGrant) error {
	p.mu.Lock()
	defer p.mu.Unlock()
	if owned, ok := p.grants[q.SocketID]; ok && (owned.Capture != q.Capture || owned.Binding != q.Binding || owned.Local != q.Local || owned.Remote != q.Remote) {
		return errors.New("local composition revoke changed ownership")
	}
	delete(p.grants, q.SocketID)
	return nil
}
func (p *desktopExternalIntegrationKernel) grantedPeer(address net.Addr, acceptedAt time.Time) bool {
	peer, err := netip.ParseAddrPort(address.String())
	if err != nil {
		return false
	}
	p.mu.Lock()
	defer p.mu.Unlock()
	for _, receipt := range p.issued {
		grant := receipt.grant
		if !receipt.accepted && !receipt.at.After(acceptedAt) && grant.Local == peer && grant.Remote == p.remote {
			receipt.accepted = true
			return true
		}
	}
	return false
}
func (*desktopExternalIntegrationSource) CreateSocket(context.Context, mobiletor.DesktopSocketCreation) (mobiletor.DesktopSocketCreated, error) {
	return mobiletor.DesktopSocketCreated{}, errors.New("the composition OS boundary cannot fabricate a socket")
}
func (s *desktopExternalIntegrationSource) Cancel() { s.cancelled.Store(true); s.live.Store(false) }
func (s *desktopExternalIntegrationSource) Close(ctx context.Context) error {
	s.Cancel()
	s.kernel.mu.Lock()
	remaining := len(s.kernel.grants)
	s.kernel.mu.Unlock()
	if ctx.Err() != nil || remaining != 0 {
		return errors.New("local composition source closed before actual broker grants joined")
	}
	s.closed.Store(true)
	return nil
}
func (s *desktopExternalIntegrationSource) BindTunnel(ctx context.Context, c mobiletor.DesktopSocketCapture, name string, index uint32) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if ctx.Err() != nil || !s.live.Load() || c != s.capture || name == "" || index == 0 || s.name != "" {
		return errors.New("local TUN binding is not current")
	}
	s.name, s.index = name, index
	s.binds++
	return nil
}
func (s *desktopExternalIntegrationSource) RetireTunnel(ctx context.Context, c mobiletor.DesktopSocketCapture, name string, index uint32) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if ctx.Err() != nil || !s.live.Load() || c != s.capture || name != s.name || index != s.index {
		return errors.New("local TUN retirement is not current")
	}
	s.name, s.index = "", 0
	s.retires++
	return nil
}

// Each child has private, temporary trust roots. The production proof receives
// no custom TLS configuration and must verify both the chain and literal IP.
type desktopExternalIntegrationCA struct {
	root *x509.Certificate
	key  *ecdsa.PrivateKey
	der  []byte
}

func newDesktopExternalIntegrationCA(t *testing.T) *desktopExternalIntegrationCA {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	root := &x509.Certificate{SerialNumber: big.NewInt(96101), Subject: pkix.Name{CommonName: "isolated external composition root"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature}
	der, err := x509.CreateCertificate(rand.Reader, root, root, &key.PublicKey, key)
	if err != nil {
		t.Fatal(err)
	}
	return &desktopExternalIntegrationCA{root, key, der}
}
func (ca *desktopExternalIntegrationCA) certificate(t *testing.T, valid bool) tls.Certificate {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	leaf := &x509.Certificate{SerialNumber: big.NewInt(96102), Subject: pkix.Name{CommonName: "captured external composition peer"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, DNSNames: []string{"captured-proxy.example"}}
	if valid {
		leaf.IPAddresses = []net.IP{net.ParseIP("1.1.1.1")}
	} else {
		leaf.IPAddresses = []net.IP{net.ParseIP("1.0.0.1")}
	}
	der, err := x509.CreateCertificate(rand.Reader, leaf, ca.root, &key.PublicKey, ca.key)
	if err != nil {
		t.Fatal(err)
	}
	return tls.Certificate{Certificate: [][]byte{der, ca.der}, PrivateKey: key}
}

// The peer accepts only the two selected upper destinations. The native lower
// path must reach this exact local listener under a preexisting broker grant.
type desktopExternalIntegrationPeer struct {
	listener                                                                                    net.Listener
	kernel                                                                                      *desktopExternalIntegrationKernel
	protocol                                                                                    string
	certificate, proxyCertificate                                                               tls.Certificate
	badDNS, badIP, badAuth                                                                      bool
	mu                                                                                          sync.Mutex
	closing                                                                                     bool
	connections                                                                                 map[net.Conn]bool
	workers                                                                                     sync.WaitGroup
	accepted, dnsQueries, tlsHandshakes, publicRequests, publicAttempts, authFailures, bypassed atomic.Int32
	failure                                                                                     string
	publicEntered, publicRelease                                                                chan struct{}
	publicOnce                                                                                  sync.Once
	ctx                                                                                         context.Context
	cancel                                                                                      context.CancelFunc
}

func (p *desktopExternalIntegrationPeer) start(t *testing.T) {
	t.Helper()
	var serveSS func(net.Conn) error
	if p.protocol == "shadowsocks" {
		password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{7}, 32))
		if p.badAuth {
			password = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{8}, 32))
		}
		ss, err := shadowaead_2022.NewServiceWithPassword("2022-blake3-aes-256-gcm", password, 60, p, nil)
		if err != nil {
			t.Fatal(err)
		}
		serveSS = func(c net.Conn) error {
			return ss.NewConnection(p.ctx, c, M.Metadata{Source: M.SocksaddrFromNet(c.RemoteAddr())})
		}
	}
	p.workers.Add(1)
	go func() {
		defer p.workers.Done()
		for {
			c, err := p.listener.Accept()
			if err != nil {
				return
			}
			acceptedAt := time.Now()
			p.mu.Lock()
			if p.closing {
				p.mu.Unlock()
				c.Close()
				return
			}
			p.connections[c] = true
			p.workers.Add(1)
			p.mu.Unlock()
			go func() {
				defer p.workers.Done()
				defer func() { c.Close(); p.mu.Lock(); delete(p.connections, c); p.mu.Unlock() }()
				if !p.kernel.grantedPeer(c.RemoteAddr(), acceptedAt) {
					p.bypassed.Add(1)
					return
				}
				p.accepted.Add(1)
				_ = c.SetDeadline(time.Now().Add(12 * time.Second))
				if serveSS != nil {
					p.recordFailure(serveSS(c))
				} else {
					p.recordFailure(p.connect(c))
				}
			}()
		}
	}()
}
func (p *desktopExternalIntegrationPeer) recordFailure(err error) {
	if err != nil {
		p.mu.Lock()
		p.failure = err.Error()
		p.mu.Unlock()
	}
}
func (p *desktopExternalIntegrationPeer) diagnostic() string {
	p.mu.Lock()
	defer p.mu.Unlock()
	return fmt.Sprintf("accepted=%d dns=%d tls=%d public=%d attempts=%d peer=%s", p.accepted.Load(), p.dnsQueries.Load(), p.tlsHandshakes.Load(), p.publicRequests.Load(), p.publicAttempts.Load(), p.failure)
}
func (p *desktopExternalIntegrationPeer) close() {
	p.mu.Lock()
	p.closing = true
	p.cancel()
	for c := range p.connections {
		_ = c.Close()
	}
	p.mu.Unlock()
	_ = p.listener.Close()
	p.workers.Wait()
}
func (p *desktopExternalIntegrationPeer) connect(c net.Conn) error {
	if p.protocol == "https-connect" {
		secure := tls.Server(c, &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{p.proxyCertificate}, NextProtos: []string{"http/1.1"}})
		if err := secure.HandshakeContext(p.ctx); err != nil {
			return err
		}
		c = secure
	}
	reader := bufio.NewReader(c)
	request, err := http.ReadRequest(reader)
	if err != nil {
		return err
	}
	defer request.Body.Close()
	expected := "Basic " + base64.StdEncoding.EncodeToString([]byte(desktopExternalIntegrationUser+":"+desktopExternalIntegrationPassword))
	if request.Method != http.MethodConnect || request.Header.Get("Proxy-Authorization") != expected || p.badAuth {
		p.authFailures.Add(1)
		_, _ = io.WriteString(c, "HTTP/1.1 407 Proxy Authentication Required\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
		return errors.New("native proxy credentials changed")
	}
	target := request.Host
	if target != desktopExternalIntegrationDNS && target != "1.1.1.1:443" {
		return errors.New("native proxy escaped selected destinations")
	}
	if _, err = io.WriteString(c, "HTTP/1.1 200 Connection Established\r\n\r\n"); err != nil {
		return err
	}
	return p.serve(&desktopExternalBufferedConn{Conn: c, reader: reader}, target)
}

type desktopExternalBufferedConn struct {
	net.Conn
	reader *bufio.Reader
}

func (c *desktopExternalBufferedConn) Read(b []byte) (int, error) { return c.reader.Read(b) }
func (p *desktopExternalIntegrationPeer) NewConnection(_ context.Context, c net.Conn, m M.Metadata) error {
	return p.serve(c, m.Destination.String())
}
func (*desktopExternalIntegrationPeer) NewPacketConnection(context.Context, N.PacketConn, M.Metadata) error {
	return errors.New("composition peer denies unrequested UDP")
}
func (*desktopExternalIntegrationPeer) NewError(context.Context, error) {}
func (p *desktopExternalIntegrationPeer) serve(c net.Conn, target string) error {
	if target == desktopExternalIntegrationDNS {
		peer := &mDNS.Conn{Conn: c}
		for {
			q, err := peer.ReadMsg()
			if err != nil {
				return err
			}
			if len(q.Question) != 1 || q.Question[0].Name != "example.com." || q.Question[0].Qtype != mDNS.TypeA {
				return errors.New("native selected DNS question changed")
			}
			p.dnsQueries.Add(1)
			answer := new(mDNS.Msg)
			answer.SetReply(q)
			ip := net.IPv4(93, 184, 216, 34)
			if p.badDNS {
				ip = net.IPv4(192, 168, 50, 1)
			}
			answer.Answer = []mDNS.RR{&mDNS.A{Hdr: mDNS.RR_Header{Name: q.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60}, A: ip}}
			if err = peer.WriteMsg(answer); err != nil {
				return err
			}
		}
	}
	if target != "1.1.1.1:443" {
		return errors.New("native encrypted peer escaped captured proof target")
	}
	p.publicAttempts.Add(1)
	secure := tls.Server(c, &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{p.certificate}, NextProtos: []string{"http/1.1"}})
	if err := secure.HandshakeContext(p.ctx); err != nil {
		return err
	}
	p.tlsHandshakes.Add(1)
	request, err := http.ReadRequest(bufio.NewReader(secure))
	if err != nil {
		return err
	}
	defer request.Body.Close()
	nonce := request.URL.Query().Get("routervpn_proof")
	decoded, nonceErr := hex.DecodeString(nonce)
	if request.Method != http.MethodGet || request.Host != "1.1.1.1" || request.URL.Path != "/cdn-cgi/trace" || len(request.URL.Query()) != 1 || nonceErr != nil || len(decoded) != 16 || request.Header.Get("Authorization") != "" {
		return errors.New("native public proof changed its nonce, method, target or credential scope")
	}
	p.publicRequests.Add(1)
	if p.publicEntered != nil {
		p.publicOnce.Do(func() { close(p.publicEntered) })
		select {
		case <-p.publicRelease:
		case <-p.ctx.Done():
			return p.ctx.Err()
		}
	}
	ip := desktopExternalIntegrationIP
	if p.badIP {
		ip = "203.0.113.89"
	}
	body := "ip=" + ip + "\n"
	_, err = fmt.Fprintf(secure, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s", len(body), body)
	return err
}

type desktopExternalIntegrationFixture struct {
	box                             *Box
	policy                          *mobilemultihop.DesktopExternalPolicy
	originalSource, originalCapture string
	network                         *routervpndesktoppt.ExternalNetworkOwner
	tun                             *desktopTorBoxTUN
	source                          *desktopExternalIntegrationSource
	kernel                          *desktopExternalIntegrationKernel
	peer                            *desktopExternalIntegrationPeer
	proof                           *RouterVPNExternalProofRequest
}

func desktopExternalIntegrationAddress(t *testing.T) (net.Interface, netip.Addr) {
	t.Helper()
	interfaces, err := net.Interfaces()
	if err != nil {
		t.Fatal(err)
	}
	for _, iface := range interfaces {
		if iface.Flags&net.FlagUp == 0 || iface.Flags&net.FlagLoopback != 0 {
			continue
		}
		addresses, err := iface.Addrs()
		if err != nil {
			t.Fatal(err)
		}
		for _, raw := range addresses {
			prefix, err := netip.ParsePrefix(raw.String())
			if err == nil && prefix.Addr().Is4() && prefix.Addr().IsGlobalUnicast() {
				return iface, prefix.Addr()
			}
		}
	}
	t.Fatal("ordinary composition requires an existing local non-loopback IPv4 interface")
	return net.Interface{}, netip.Addr{}
}

// A TCP connection can finish its handshake while still waiting in the
// listener backlog. Force that ordering so a queued Accept cannot be mistaken
// for traffic sent after the exact client permit has already been retired.
func desktopExternalIntegrationDelayedAccept(t *testing.T) {
	t.Helper()
	iface, address := desktopExternalIntegrationAddress(t)
	listener, err := net.Listen("tcp4", net.JoinHostPort(address.String(), "0"))
	if err != nil {
		t.Fatal(err)
	}
	defer listener.Close()
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	source := &desktopExternalIntegrationSource{
		capture: mobiletor.DesktopSocketCapture{SessionID: strings.Repeat("a", 32), SourceSHA256: strings.Repeat("b", 64), NetworkID: strings.Repeat("c", 32)},
		owner:   mobiletor.DesktopSocketKernelOwner{Kind: "unix-isolated-uid", IdentitySHA256: strings.Repeat("d", 64), Generation: 1, ProcessID: uint32(os.Getpid())},
	}
	source.live.Store(true)
	kernel := &desktopExternalIntegrationKernel{source: source, local: address, remote: listener.Addr().(*net.TCPAddr).AddrPort(), index: uint32(iface.Index), name: iface.Name, grants: make(map[string]mobiletor.DesktopSocketGrant)}
	source.kernel = kernel
	broker, err := mobiletor.NewDesktopSocketBroker(ctx, source.capture, kernel, source.live.Load)
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := broker.Close(context.Background()); err != nil {
			t.Error("delayed Accept broker did not join", err)
		}
		if err := source.Close(context.Background()); err != nil {
			t.Error("delayed Accept source retained an active grant", err)
		}
	}()
	beforeDial := time.Now()
	connection, err := broker.DialContext(ctx, "tcp4", kernel.remote.String())
	if err != nil {
		t.Fatal("delayed Accept did not exercise a real broker socket", err)
	}
	if err = connection.Close(); err != nil {
		t.Fatal("delayed Accept did not join the original socket", err)
	}
	kernel.mu.Lock()
	remaining := len(kernel.grants)
	kernel.mu.Unlock()
	if remaining != 0 {
		t.Fatal("delayed Accept fixture did not revoke before receiving the connection")
	}
	if err = listener.(*net.TCPListener).SetDeadline(time.Now().Add(3 * time.Second)); err != nil {
		t.Fatal(err)
	}
	peer, err := listener.Accept()
	if err != nil {
		t.Fatal("delayed Accept lost the already connected socket", err)
	}
	defer peer.Close()
	acceptedAt := time.Now()
	if kernel.grantedPeer(peer.RemoteAddr(), beforeDial) || !kernel.grantedPeer(peer.RemoteAddr(), acceptedAt) || kernel.grantedPeer(peer.RemoteAddr(), acceptedAt) {
		t.Fatal("queued connection lost its one-use prior grant or accepted a future/replayed receipt")
	}
	unowned, err := (&net.Dialer{}).DialContext(ctx, "tcp4", kernel.remote.String())
	if err != nil {
		t.Fatal(err)
	}
	defer unowned.Close()
	other, err := listener.Accept()
	if err != nil {
		t.Fatal(err)
	}
	defer other.Close()
	if kernel.grantedPeer(other.RemoteAddr(), time.Now()) {
		t.Fatal("ungranted real connection reused a retired broker receipt")
	}
}

func newDesktopExternalIntegrationFixture(t *testing.T, ca *desktopExternalIntegrationCA, protocol, fault string) *desktopExternalIntegrationFixture {
	t.Helper()
	iface, address := desktopExternalIntegrationAddress(t)
	listener, err := net.Listen("tcp4", net.JoinHostPort(address.String(), "0"))
	if err != nil {
		t.Fatal(err)
	}
	remote := listener.Addr().(*net.TCPAddr).AddrPort()
	ctx, cancel := context.WithCancel(context.Background())
	f := &desktopExternalIntegrationFixture{}
	f.source = &desktopExternalIntegrationSource{owner: mobiletor.DesktopSocketKernelOwner{Kind: "unix-isolated-uid", IdentitySHA256: strings.Repeat("c", 64), Generation: 1, ProcessID: uint32(os.Getpid())}}
	f.source.live.Store(true)
	f.kernel = &desktopExternalIntegrationKernel{source: f.source, local: address, remote: remote, index: uint32(iface.Index), name: iface.Name, grants: make(map[string]mobiletor.DesktopSocketGrant)}
	f.source.kernel = f.kernel
	f.peer = &desktopExternalIntegrationPeer{listener: listener, kernel: f.kernel, protocol: protocol, certificate: ca.certificate(t, true), proxyCertificate: ca.certificate(t, true), connections: make(map[net.Conn]bool), ctx: ctx, cancel: cancel}
	switch fault {
	case "dns":
		f.peer.badDNS = true
	case "exit":
		f.peer.badIP = true
	case "credential":
