func (p *desktopExternalIntegrationPeer) diagnostic() string {
	p.mu.Lock()
	defer p.mu.Unlock()
	latency := ""
	if p.latency != nil {
		latency = fmt.Sprintf(" latency-dns=%d latency-tls=%d latency-requests=%d", p.latency.queries.Load(), p.latency.handshakes.Load(), p.latency.requests.Load())
	}
	return fmt.Sprintf("accepted=%d udp=%d dns=%d udp-dns=%d tls=%d public=%d attempts=%d%s peer=%s", p.accepted.Load(), p.physicalUDP.Load(), p.dnsQueries.Load(), p.udpQueries.Load(), p.tlsHandshakes.Load(), p.publicRequests.Load(), p.publicAttempts.Load(), latency, p.failure)
}
func (p *desktopExternalIntegrationPeer) close() {
	p.mu.Lock()
	p.closing = true
	p.cancel()
	var streams []net.Conn
	for c := range p.connections {
		streams = append(streams, c)
	}
	var packets []N.PacketConn
	for c := range p.packetConnections {
		packets = append(packets, c)
	}
	p.mu.Unlock()
	for _, c := range streams {
		_ = c.Close()
	}
	for _, c := range packets {
		_ = c.Close()
	}
	if p.listener != nil {
		_ = p.listener.Close()
	}
	if p.packet != nil {
		_ = p.packet.Close()
	}
	if p.closeProtocol != nil {
		p.closeProtocol()
	}
	p.workers.Wait()
}
func (p *desktopExternalIntegrationPeer) connect(c net.Conn) error {
	if p.protocol == "https-connect" {
		secure := tls.Server(c, &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{p.proxyCertificate}, NextProtos: []string{"http/1.1"}})
		if err := secure.HandshakeContext(p.ctx); err != nil {
			return err
		}
		c = secure
	}
	reader := bufio.NewReader(c)
	request, err := http.ReadRequest(reader)
	if err != nil {
		return err
	}
	defer request.Body.Close()
	expected := "Basic " + base64.StdEncoding.EncodeToString([]byte(desktopExternalIntegrationUser+":"+desktopExternalIntegrationPassword))
	if request.Method != http.MethodConnect || request.Header.Get("Proxy-Authorization") != expected || p.badAuth {
		p.authFailures.Add(1)
		_, _ = io.WriteString(c, "HTTP/1.1 407 Proxy Authentication Required\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
		return errors.New("native proxy credentials changed")
	}
	target := request.Host
	if target != desktopExternalIntegrationDNS && target != "1.1.1.1:443" && !(p.latency != nil && target == desktopExternalLatencyAddress) {
		return errors.New("native proxy escaped selected destinations")
	}
	if _, err = io.WriteString(c, "HTTP/1.1 200 Connection Established\r\n\r\n"); err != nil {
		return err
	}
	return p.serve(&desktopExternalBufferedConn{Conn: c, reader: reader}, target)
}

