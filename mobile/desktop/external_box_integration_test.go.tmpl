func (f *desktopExternalIntegrationFixture) prove(t *testing.T) {
	t.Helper()
	raw, err := f.proof.Run()
	var result mobilemultihop.ExternalProofResult
	if err != nil || json.Unmarshal([]byte(raw), &result) != nil {
		t.Fatal("unmodified native shared proof failed", err, raw, f.peer.diagnostic())
	}
	meta := f.policy.Metadata()
	if result.Schema != 1 || result.SessionID != meta.SessionID || result.SourceSHA256 != meta.OriginalSourceSHA256 || result.ConfigSHA256 != meta.OriginalConfigSHA256 || result.ExitID != "selected-external-native" || result.IP != desktopExternalIntegrationIP || !result.DNSProven || result.EntryProven || result.CheckedAt <= 0 || !f.proof.Healthy() || !f.network.Current() {
		t.Fatal("real proof changed original authority or lost derived native ownership", result)
	}
	if f.peer.dnsQueries.Load() == 0 || f.peer.tlsHandshakes.Load() != 1 || f.peer.publicRequests.Load() != 1 ||
		(!desktopExternalIntegrationUDP(f.peer.protocol) && f.peer.accepted.Load() < 2) || f.peer.bypassed.Load() != 0 {
		t.Fatal("real selected DNS or public TLS skipped the captured lower path", f.peer.dnsQueries.Load(), f.peer.tlsHandshakes.Load(), f.peer.publicRequests.Load(), f.peer.accepted.Load())
	}
	if desktopExternalIntegrationUDP(f.peer.protocol) {
		capture, err := f.policy.Capture()
		if err != nil || len(capture.PhysicalRoots) != 1 || len(capture.PhysicalRoots[0].Destinations) != 1 ||
			capture.PhysicalRoots[0].Destinations[0].Network != "udp" || capture.SelectedDNS.Type != "udp" || capture.SelectedDNS.Physical ||
			f.peer.listener != nil || f.peer.accepted.Load() != 1 || f.peer.physicalUDP.Load() == 0 || f.peer.udpQueries.Load() == 0 ||
			f.peer.udpQueries.Load() != f.peer.dnsQueries.Load() {
			t.Fatal("UDP family did not carry selected UDP DNS and TCP proof through its sole captured UDP socket", err, f.peer.diagnostic())
		}
		if _, err := f.kernel.Select(context.Background(), f.source.capture, "tcp", f.kernel.remote); err == nil {
			t.Fatal("UDP fixture granted an unrequested physical TCP destination")
		}
	}
	if f.peer.protocol == "socks5" {
		f.peer.socks.proved(t, f)
	}
	if awgpolicy.IsMode(f.peer.protocol) {
		if f.peer.awgReadback == nil {
			t.Fatal("external AWG proof lost its independent native parameter receipt")
		}
		if err := f.peer.awgReadback(); err != nil {
			t.Fatal(err)
		}
	}
	if err = f.proof.VerifyCurrentPath(); err != nil {
		t.Fatal("real proof did not retain its exact generation", err)
	}
}

// Replacing the OS reader is the sole transaction seam. The real native
// inbound manager performs all stages, teardown, serialization, cancellation
// rollback and publication; the shipping lease retains its actual returned
// reader and physical retirement/rebind acknowledgments around the operation.
func (f *desktopExternalIntegrationFixture) replacement(callback func(adapter.StartStage) error, adopted **desktopTorMTUCandidate, restored **desktopTorMTUCandidate) func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) {
	return func(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
		reader, ok := expected.(routerVPNDesktopTorTUN)
		if !ok {
			return expected, errors.New("fixture received another reader family")
		}
		name, index, oldMTU, err := reader.RouterVPNDesktopMTUInterface()
		if err != nil {
			return expected, err
		}
		makeReader := func(value, nextIndex int) *desktopTorMTUCandidate {
			return &desktopTorMTUCandidate{desktopTorBoxTUN: &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, expected.Tag()), name: name, index: nextIndex, mtu: value, claimed: true, guard: f.proof.engine.physical.current}}
		}
		candidate, rollback := makeReader(mtu, index+1), makeReader(oldMTU, index+2)
		candidate.afterStart = callback
		*adopted, *restored = candidate, rollback
		return f.box.inbound.RouterVPNReplaceTun(ctx, expected, candidate, rollback)
	}
}

