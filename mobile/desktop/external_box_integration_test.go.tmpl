// This composition retains the original compiler, derived Box, native lower
// outbound, broker sockets, selected DNS router, normal certificate validation
// and unmodified shared proof. Only privileged OS permit/identity operations
// and the TUN device are fixtures. A local proxy terminates the selected remote
// protocols; it never dials any public or private remote address. These results
// are not a kernel firewall, physical-device or private deployment acceptance.
const desktopExternalIntegrationDNS = "192.168.50.53:5353"
const desktopExternalIntegrationIP = "203.0.113.88"
const desktopExternalIntegrationUser = "captured-native-user"
const desktopExternalIntegrationPassword = "captured-native-password"

func desktopExternalIntegrationPacketEndpoint(protocol string) bool {
	return protocol == "wireguard" || awgpolicy.IsMode(protocol)
}

func desktopExternalIntegrationUDP(protocol string) bool {
	return protocol == "hysteria2" || desktopExternalIntegrationPacketEndpoint(protocol)
}

func desktopExternalIntegrationUDPDNS(protocol string) bool {
	return protocol == "socks5" || desktopExternalIntegrationUDP(protocol)
}

// These complete Fast/Strong imports are test inputs, not product defaults.
func desktopExternalIntegrationAWGParameters(protocol string) map[string]string {
	if !awgpolicy.IsMode(protocol) {
		return nil
	}
	parameters := map[string]string{"jc": "3", "jmin": "40", "jmax": "900", "s1": "56", "s2": "48", "s3": "24", "s4": "32",
		"h1": "10000000-19999999", "h2": "20000000-29999999", "h3": "30000000-39999999", "h4": "40000000-49999999"}
	if protocol == "awg2-fast" {
		parameters["jc"], parameters["jmin"], parameters["jmax"], parameters["s4"] = "0", "20", "40", "8"
	}
	return parameters
}

// Policy and lifecycle source are deliberately separate: the broker exercises
// its ordinary real socket implementation while the OS constructor is an
// explicit boundary. The source cannot supply or fabricate connected sockets.
type desktopExternalIntegrationTuple struct {
	network string
	remote  netip.AddrPort
}

type desktopExternalIntegrationKernel struct {
	source      *desktopExternalIntegrationSource
	local       netip.Addr
	remote      netip.AddrPort
	index       uint32
	name        string
	udp         bool
	tuples      []desktopExternalIntegrationTuple
	socksRelays map[netip.AddrPort]bool
	deny        atomic.Bool
	denied      atomic.Int32
	mu          sync.Mutex
	grants      map[string]mobiletor.DesktopSocketGrant
	issued      map[string]*desktopExternalIntegrationGrant
	requests    int
}

// Accept can be scheduled after the sender has already closed its socket and
// revoked the permit. Retain a one-use receipt of each actual prior Grant;
// looking only at current permits mistakes that joined teardown for a bypass.
type desktopExternalIntegrationGrant struct {
	grant    mobiletor.DesktopSocketGrant
	at       time.Time
	accepted bool
}

type desktopExternalIntegrationSource struct {
	capture                 mobiletor.DesktopSocketCapture
	owner                   mobiletor.DesktopSocketKernelOwner
	kernel                  *desktopExternalIntegrationKernel
	live, cancelled, closed atomic.Bool
	mu                      sync.Mutex
	name                    string
	index                   uint32
	binds, retires          int
}

func (p *desktopExternalIntegrationKernel) Owner() (mobiletor.DesktopSocketKernelOwner, error) {
	return p.source.owner, nil
}
func (p *desktopExternalIntegrationKernel) Current(c mobiletor.DesktopSocketCapture, o mobiletor.DesktopSocketKernelOwner) bool {
	return p.source.live.Load() && c == p.source.capture && o == p.source.owner
}
func (p *desktopExternalIntegrationKernel) network() string {
	if p.udp {
		return "udp"
	}
	return "tcp"
}

// An explicit OpenVPN import captures network/address pairs independently.
// Existing single-remote fixtures retain their original exact predicate.
func (p *desktopExternalIntegrationKernel) permits(network string, remote netip.AddrPort) bool {
	if network == "udp" {
		p.mu.Lock()
		owned := p.socksRelays[remote]
		p.mu.Unlock()
		if owned {
			return true
		}
	}
	if len(p.tuples) == 0 {
		return network == p.network() && remote == p.remote
	}
	for _, tuple := range p.tuples {
		if tuple.network == network && tuple.remote == remote {
			return true
		}
	}
	return false
}
func (p *desktopExternalIntegrationKernel) permitsBinding(network string) bool {
	p.mu.Lock()
	socksUDP := p.socksRelays != nil && network == "udp4"
	p.mu.Unlock()
	if socksUDP {
		return true
	}
	if len(p.tuples) == 0 {
		return network == p.network()+"4"
	}
	for _, tuple := range p.tuples {
		if network == tuple.network+"4" {
			return true
		}
	}
	return false
}
func (p *desktopExternalIntegrationKernel) Select(ctx context.Context, c mobiletor.DesktopSocketCapture, network string, remote netip.AddrPort) (mobiletor.DesktopSocketBinding, error) {
	if ctx.Err() != nil || !p.Current(c, p.source.owner) || !p.permits(network, remote) {
		return mobiletor.DesktopSocketBinding{}, errors.New("local composition source denied another path")
	}
	if p.deny.Load() {
		p.denied.Add(1)
		return mobiletor.DesktopSocketBinding{}, errors.New("local composition source denied its captured path")
	}
	return mobiletor.DesktopSocketBinding{Owner: p.source.owner, InterfaceName: p.name, InterfaceIndex: p.index, LocalAddress: p.local}, nil
}
func (p *desktopExternalIntegrationKernel) Bind(ctx context.Context, c mobiletor.DesktopSocketCapture, b mobiletor.DesktopSocketBinding, network string, raw syscall.RawConn) error {
	if ctx.Err() != nil || !p.Current(c, b.Owner) || b.LocalAddress != p.local || b.InterfaceName != p.name || b.InterfaceIndex != p.index || !p.permitsBinding(network) || raw == nil {
		return errors.New("local composition binding lost its captured source")
	}
	return raw.Control(func(uintptr) {})
}
func (p *desktopExternalIntegrationKernel) Grant(ctx context.Context, q mobiletor.DesktopSocketGrant) (mobiletor.DesktopSocketReceipt, error) {
	if ctx.Err() != nil || !p.Current(q.Capture, q.Binding.Owner) || !p.permits(q.Network, q.Remote) || q.Local.Addr() != p.local || q.Local.Port() == 0 || p.deny.Load() {
		return mobiletor.DesktopSocketReceipt{}, errors.New("local composition source refused a different grant")
	}
	p.mu.Lock()
	if previous, ok := p.issued[q.SocketID]; ok {
		identity := q
		identity.Sequence = previous.grant.Sequence
		if previous.grant != identity {
			p.mu.Unlock()
			return mobiletor.DesktopSocketReceipt{}, errors.New("local composition renewed a different captured socket")
		}
	}
	if p.issued == nil {
		p.issued = make(map[string]*desktopExternalIntegrationGrant)
	}
	if p.issued[q.SocketID] == nil {
		p.issued[q.SocketID] = &desktopExternalIntegrationGrant{grant: q, at: time.Now()}
	}
	p.requests++
	p.grants[q.SocketID] = q
	p.mu.Unlock()
	now := time.Now()
	return mobiletor.DesktopSocketReceipt{Grant: q, ObservedAt: now.UnixMilli(), ExpiresAt: now.Add(10 * time.Second).UnixMilli()}, nil
}
func (p *desktopExternalIntegrationKernel) Revoke(_ context.Context, q mobiletor.DesktopSocketGrant) error {
	p.mu.Lock()
	defer p.mu.Unlock()
	if owned, ok := p.grants[q.SocketID]; ok && (owned.Capture != q.Capture || owned.Binding != q.Binding || owned.Local != q.Local || owned.Remote != q.Remote) {
		return errors.New("local composition revoke changed ownership")
	}
	delete(p.grants, q.SocketID)
	return nil
}
func (p *desktopExternalIntegrationKernel) grantedPeer(address net.Addr, acceptedAt time.Time) bool {
	peer, err := netip.ParseAddrPort(address.String())
	if err != nil {
		return false
	}
	p.mu.Lock()
	defer p.mu.Unlock()
	for _, receipt := range p.issued {
		grant := receipt.grant
		if !receipt.accepted && !receipt.at.After(acceptedAt) && grant.Local == peer && grant.Remote == p.remote {
			receipt.accepted = true
			return true
		}
	}
	return false
}

// A datagram is usable only while its exact prior socket grant is current.
// A packet queued before a revoke may arrive later; discard it without treating
// the historical receipt as permission to resume a retired QUIC connection.
func (p *desktopExternalIntegrationKernel) grantedPacket(address net.Addr, receivedAt time.Time) (allowed, known, first bool) {
	if !p.udp {
		return false, false, false
	}
	return p.grantedPacketTo(p.remote, address, receivedAt)
}
func (p *desktopExternalIntegrationKernel) grantedPacketTo(destination netip.AddrPort, address net.Addr, receivedAt time.Time) (allowed, known, first bool) {
	peer, err := netip.ParseAddrPort(address.String())
	if err != nil {
		return false, false, false
	}
	p.mu.Lock()
	defer p.mu.Unlock()
	for id, receipt := range p.issued {
		grant := receipt.grant
		if grant.Network != "udp" || receipt.at.After(receivedAt) || grant.Local != peer || grant.Remote != destination {
			continue
		}
		current, exists := p.grants[id]
		if !exists || current.Network != "udp" || current.Local != peer || current.Remote != destination ||
			current.Capture != p.source.capture || !p.source.live.Load() || p.deny.Load() {
			return false, true, false
		}
		first = !receipt.accepted
		receipt.accepted = true
		return true, true, first
	}
	return false, false, false
}
func (*desktopExternalIntegrationSource) CreateSocket(context.Context, mobiletor.DesktopSocketCreation) (mobiletor.DesktopSocketCreated, error) {
	return mobiletor.DesktopSocketCreated{}, errors.New("the composition OS boundary cannot fabricate a socket")
}
func (s *desktopExternalIntegrationSource) Cancel() { s.cancelled.Store(true); s.live.Store(false) }
func (s *desktopExternalIntegrationSource) Close(ctx context.Context) error {
	s.Cancel()
	s.kernel.mu.Lock()
	remaining := len(s.kernel.grants)
	s.kernel.mu.Unlock()
	if ctx.Err() != nil || remaining != 0 {
		return errors.New("local composition source closed before actual broker grants joined")
	}
	s.closed.Store(true)
	return nil
}
func (s *desktopExternalIntegrationSource) BindTunnel(ctx context.Context, c mobiletor.DesktopSocketCapture, name string, index uint32) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if ctx.Err() != nil || !s.live.Load() || c != s.capture || name == "" || index == 0 || s.name != "" {
		return errors.New("local TUN binding is not current")
	}
	s.name, s.index = name, index
	s.binds++
	return nil
}
func (s *desktopExternalIntegrationSource) RetireTunnel(ctx context.Context, c mobiletor.DesktopSocketCapture, name string, index uint32) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if ctx.Err() != nil || !s.live.Load() || c != s.capture || name != s.name || index != s.index {
		return errors.New("local TUN retirement is not current")
	}
	s.name, s.index = "", 0
	s.retires++
	return nil
}

// Each child has private, temporary trust roots. The production proof receives
// no custom TLS configuration and must verify both the chain and literal IP.
type desktopExternalIntegrationCA struct {
	root *x509.Certificate
	key  *ecdsa.PrivateKey
	der  []byte
}

func newDesktopExternalIntegrationCA(t *testing.T) *desktopExternalIntegrationCA {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	root := &x509.Certificate{SerialNumber: big.NewInt(96101), Subject: pkix.Name{CommonName: "isolated external composition root"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature}
	der, err := x509.CreateCertificate(rand.Reader, root, root, &key.PublicKey, key)
	if err != nil {
		t.Fatal(err)
	}
	return &desktopExternalIntegrationCA{root, key, der}
}
func (ca *desktopExternalIntegrationCA) certificate(t *testing.T, valid bool) tls.Certificate {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	leaf := &x509.Certificate{SerialNumber: big.NewInt(96102), Subject: pkix.Name{CommonName: "captured external composition peer"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, DNSNames: []string{"captured-proxy.example"}}
	if valid {
		leaf.IPAddresses = []net.IP{net.ParseIP("1.1.1.1")}
		leaf.DNSNames = append(leaf.DNSNames, "speed.cloudflare.com")
	} else {
		leaf.IPAddresses = []net.IP{net.ParseIP("1.0.0.1")}
	}
	der, err := x509.CreateCertificate(rand.Reader, leaf, ca.root, &key.PublicKey, ca.key)
	if err != nil {
		t.Fatal(err)
	}
	return tls.Certificate{Certificate: [][]byte{der, ca.der}, PrivateKey: key}
}

// The peer accepts only the two selected upper destinations. The native lower
// path must reach this exact local listener under a preexisting broker grant.
type desktopExternalIntegrationPeer struct {
	listener                                                                                    net.Listener
	packet                                                                                      net.PacketConn
	closeProtocol                                                                               func()
	kernel                                                                                      *desktopExternalIntegrationKernel
	protocol                                                                                    string
	certificate, proxyCertificate                                                               tls.Certificate
	badDNS, badIP, badAuth, truncatedBody                                                       bool
	referenceBind                                                                               wgconn.Bind // Independent native provider transport; never a client grant.
	wgPrivate, wgClientPublic, wgPreshared                                                      string
	awgParameters                                                                               map[string]string
	awgReadback                                                                                 func() error
	mu                                                                                          sync.Mutex
	closing                                                                                     bool
	connections                                                                                 map[net.Conn]bool
	packetConnections                                                                           map[N.PacketConn]bool
	workers                                                                                     sync.WaitGroup
	accepted, dnsQueries, tlsHandshakes, publicRequests, publicAttempts, authFailures, bypassed atomic.Int32
	physicalUDP, udpQueries                                                                     atomic.Int32
	failure                                                                                     string
	publicEntered, publicRelease                                                                chan struct{}
	publicOnce                                                                                  sync.Once
	latency                                                                                     *desktopExternalLatencyPeer
	socks                                                                                       *desktopExternalSOCKSPeer
	ctx                                                                                         context.Context
	cancel                                                                                      context.CancelFunc
}

func (p *desktopExternalIntegrationPeer) start(t *testing.T) {
	t.Helper()
	if p.protocol == "hysteria2" {
		p.startHysteria2(t)
		return
	}
	if p.protocol == "wireguard" {
		p.startWireGuard(t)
		return
	}
	if awgpolicy.IsMode(p.protocol) {
		p.startAmnezia(t)
		return
	}
	var serveSS func(net.Conn) error
	if p.protocol == "shadowsocks" {
		password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{7}, 32))
		if p.badAuth {
			password = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{8}, 32))
		}
		ss, err := shadowaead_2022.NewServiceWithPassword("2022-blake3-aes-256-gcm", password, 60, p, nil)
		if err != nil {
			t.Fatal(err)
		}
		serveSS = func(c net.Conn) error {
			return ss.NewConnection(p.ctx, c, M.Metadata{Source: M.SocksaddrFromNet(c.RemoteAddr())})
		}
	}
	p.workers.Add(1)
	go func() {
		defer p.workers.Done()
		for {
			c, err := p.listener.Accept()
			if err != nil {
				return
			}
			acceptedAt := time.Now()
			p.mu.Lock()
			if p.closing {
				p.mu.Unlock()
				c.Close()
				return
			}
			p.connections[c] = true
			p.workers.Add(1)
			p.mu.Unlock()
			go func() {
				defer p.workers.Done()
				defer func() { c.Close(); p.mu.Lock(); delete(p.connections, c); p.mu.Unlock() }()
				if !p.kernel.grantedPeer(c.RemoteAddr(), acceptedAt) {
					p.bypassed.Add(1)
					return
				}
				p.accepted.Add(1)
				_ = c.SetDeadline(time.Now().Add(12 * time.Second))
				if p.socks != nil {
					p.recordFailure(p.socks.serve(c))
				} else if serveSS != nil {
					p.recordFailure(serveSS(c))
				} else {
					p.recordFailure(p.connect(c))
				}
			}()
		}
	}()
}

type desktopExternalIntegrationPacket struct {
	net.PacketConn
	peer *desktopExternalIntegrationPeer
}

func (p *desktopExternalIntegrationPacket) ReadFrom(body []byte) (int, net.Addr, error) {
	p.peer.mu.Lock()
	if p.peer.closing {
		p.peer.mu.Unlock()
		return 0, nil, net.ErrClosed
	}
	p.peer.workers.Add(1)
	p.peer.mu.Unlock()
	defer p.peer.workers.Done()
	for {
		n, source, err := p.PacketConn.ReadFrom(body)
		if err != nil {
			return n, source, err
		}
		allowed, known, first := p.peer.kernel.grantedPacket(source, time.Now())
		if !allowed {
			if !known {
				p.peer.bypassed.Add(1)
			}
			continue
		}
		if first {
			p.peer.accepted.Add(1)
		}
		p.peer.physicalUDP.Add(1)
		return n, source, nil
	}
}

func (p *desktopExternalIntegrationPeer) startHysteria2(t *testing.T) {
	t.Helper()
	if p.packet == nil || p.listener != nil || !p.kernel.udp {
		t.Fatal("Hysteria2 composition lost its sole captured UDP peer")
	}
	private, err := x509.MarshalPKCS8PrivateKey(p.proxyCertificate.PrivateKey)
	if err != nil {
		t.Fatal(err)
	}
	var chain []string
	for _, der := range p.proxyCertificate.Certificate {
		chain = append(chain, string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})))
	}
	logger := log.NewNOPFactory().NewLogger("captured-hysteria2-composition")
	tlsConfig, err := boxTLS.NewServer(p.ctx, logger, option.InboundTLSOptions{Enabled: true, Certificate: chain,
		Key: []string{string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: private}))}})
	clear(private)
	if err != nil {
		t.Fatal(err)
	}
	service, err := HYQUIC.NewService[int](HYQUIC.ServiceOptions{Context: p.ctx, Logger: logger, TLSConfig: tlsConfig,
		UDPTimeout: 10 * time.Second, Handler: p})
	p.closeProtocol = func() {
		if service != nil {
			_ = service.Close()
		}
		_ = tlsConfig.Close()
	}
	if err == nil {
		password := desktopExternalIntegrationPassword
		if p.badAuth {
			password += "-different-peer"
		}
		service.UpdateUsers([]int{1}, []string{password})
		err = tlsConfig.Start()
	}
	if err == nil {
		err = service.Start(&desktopExternalIntegrationPacket{PacketConn: p.packet, peer: p})
	}
	if err != nil {
		t.Fatal("actual pinned Hysteria2 composition peer failed", err)
	}
}

// The peer owns one actual UDP listener. Its bind cannot select another peer,
// a routing mark or an ungranted socket; it passes bytes to the independent WG
// device only after the same broker observation used by the QUIC service.
type desktopExternalWireGuardBind struct {
	mu             sync.Mutex
	peer           *desktopExternalIntegrationPeer
	opened, closed bool
}

type desktopExternalWireGuardEndpoint netip.AddrPort

func (desktopExternalWireGuardEndpoint) ClearSrc()             {}
func (desktopExternalWireGuardEndpoint) SrcToString() string   { return "" }
func (e desktopExternalWireGuardEndpoint) DstToString() string { return netip.AddrPort(e).String() }
func (e desktopExternalWireGuardEndpoint) DstToBytes() []byte {
	raw, _ := netip.AddrPort(e).MarshalBinary()
	return raw
}
func (e desktopExternalWireGuardEndpoint) DstIP() netip.Addr { return netip.AddrPort(e).Addr() }
func (desktopExternalWireGuardEndpoint) SrcIP() netip.Addr   { return netip.Addr{} }

func (b *desktopExternalWireGuardBind) Open(port uint16) ([]wgconn.ReceiveFunc, uint16, error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	if port != 0 || b.opened || b.closed || b.peer.packet == nil {
		return nil, 0, errors.New("external WG fixture cannot replace its original physical UDP listener")
	}
	b.opened = true
	packet := &desktopExternalIntegrationPacket{PacketConn: b.peer.packet, peer: b.peer}
	read := func(packets [][]byte, sizes []int, endpoints []wgconn.Endpoint) (int, error) {
		n, source, err := packet.ReadFrom(packets[0])
		if err != nil {
			return 0, err
		}
		remote, err := netip.ParseAddrPort(source.String())
		if err != nil {
			return 0, err
		}
		sizes[0], endpoints[0] = n, desktopExternalWireGuardEndpoint(remote)
		return 1, nil
	}
	return []wgconn.ReceiveFunc{read}, b.peer.kernel.remote.Port(), nil
}
func (b *desktopExternalWireGuardBind) Close() error {
	b.mu.Lock()
	defer b.mu.Unlock()
	if !b.opened || b.closed {
		return nil
	}
	b.closed = true
	return b.peer.packet.Close()
}
func (b *desktopExternalWireGuardBind) Send(packets [][]byte, endpoint wgconn.Endpoint, offset int) error {
	remote, err := netip.ParseAddrPort(endpoint.DstToString())
	if err != nil || remote.Addr() != b.peer.kernel.local || remote.Port() == 0 {
		return errors.New("external WG peer cannot select another physical destination")
	}
	allowed, _, _ := b.peer.kernel.grantedPacket(net.UDPAddrFromAddrPort(remote), time.Now())
	if !allowed {
		return net.ErrClosed
	}
	for _, packet := range packets {
		if offset < 0 || offset > len(packet) {
			return errors.New("external WG peer lost packet offset")
		}
		n, err := b.peer.packet.WriteTo(packet[offset:], net.UDPAddrFromAddrPort(remote))
		if err != nil {
			return err
		}
		if n != len(packet)-offset {
			return io.ErrShortWrite
		}
	}
	return nil
}
