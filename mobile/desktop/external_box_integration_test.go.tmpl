	net.Conn
	reader *bufio.Reader
}

func (c *desktopExternalBufferedConn) Read(b []byte) (int, error) { return c.reader.Read(b) }
func (p *desktopExternalIntegrationPeer) NewConnection(_ context.Context, c net.Conn, m M.Metadata) error {
	return p.serve(c, m.Destination.String())
}
func (p *desktopExternalIntegrationPeer) NewPacketConnection(ctx context.Context, connection N.PacketConn, metadata M.Metadata) error {
	if !desktopExternalIntegrationUDPDNS(p.protocol) || metadata.Destination.String() != desktopExternalIntegrationDNS {
		return errors.New("composition peer denies unrequested UDP")
	}
	stop := context.AfterFunc(p.ctx, func() { _ = connection.Close() })
	defer stop()
	for {
		packet := buf.NewPacket()
		destination, err := connection.ReadPacket(packet)
		question := new(mDNS.Msg)
		if err == nil && (destination != metadata.Destination || packet.Len() > 4096) {
			err = errors.New("native UDP changed its exact selected DNS destination")
		}
		if err == nil {
			err = question.Unpack(packet.Bytes())
		}
		packet.Release()
		if err != nil {
			return err
		}
		latency := p.latency != nil && len(question.Question) == 1 && question.Question[0].Name == "speed.cloudflare.com."
		if ctx.Err() != nil || len(question.Question) != 1 || !latency && question.Question[0].Name != "example.com." || question.Question[0].Qtype != mDNS.TypeA && !(latency && question.Question[0].Qtype == mDNS.TypeAAAA) {
			return errors.New("selected UDP DNS question changed")
		}
		p.dnsQueries.Add(1)
		p.udpQueries.Add(1)
		answer := new(mDNS.Msg).SetReply(question)
		ip := net.IPv4(93, 184, 216, 34)
		if p.badDNS {
			ip = net.IPv4(192, 168, 50, 1)
		}
		answer.Answer = []mDNS.RR{&mDNS.A{Hdr: mDNS.RR_Header{Name: question.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60}, A: ip}}
		if latency {
			p.latency.answer(question, answer)
		}
		raw, err := answer.Pack()
		if err != nil {
			return err
		}
		reply := buf.NewSize(2048 + len(raw))
		reply.Resize(2048, 0)
		_, _ = reply.Write(raw)
		if err := connection.WritePacket(reply, destination); err != nil {
			return err
		}
	}
}
func (*desktopExternalIntegrationPeer) NewError(context.Context, error) {}
func (p *desktopExternalIntegrationPeer) serve(c net.Conn, target string) error {
	if target == desktopExternalIntegrationDNS {
		peer := &mDNS.Conn{Conn: c}
		for {
			q, err := peer.ReadMsg()
			if err != nil {
				return err
			}
			latency := p.latency != nil && len(q.Question) == 1 && q.Question[0].Name == "speed.cloudflare.com."
			if len(q.Question) != 1 || (!latency && q.Question[0].Name != "example.com.") || q.Question[0].Qtype != mDNS.TypeA && !(latency && q.Question[0].Qtype == mDNS.TypeAAAA) {
				return errors.New("native selected DNS question changed")
			}
			p.dnsQueries.Add(1)
			answer := new(mDNS.Msg)
			answer.SetReply(q)
			ip := net.IPv4(93, 184, 216, 34)
			if p.badDNS {
				ip = net.IPv4(192, 168, 50, 1)
			}
			answer.Answer = []mDNS.RR{&mDNS.A{Hdr: mDNS.RR_Header{Name: q.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60}, A: ip}}
			if latency {
				p.latency.answer(q, answer)
			}
			if err = peer.WriteMsg(answer); err != nil {
				return err
			}
		}
	}
	if p.latency != nil && target == desktopExternalLatencyAddress {
		return p.latency.serve(p, c)
	}
	if target != "1.1.1.1:443" {
		return errors.New("native encrypted peer escaped captured proof target")
	}
	p.publicAttempts.Add(1)
	secure := tls.Server(c, &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{p.certificate}, NextProtos: []string{"http/1.1"}})
	if err := secure.HandshakeContext(p.ctx); err != nil {
		return err
	}
	p.tlsHandshakes.Add(1)
	request, err := http.ReadRequest(bufio.NewReader(secure))
	if err != nil {
		return err
	}
	defer request.Body.Close()
	nonce := request.URL.Query().Get("routervpn_proof")
	decoded, nonceErr := hex.DecodeString(nonce)
	if request.Method != http.MethodGet || request.Host != "1.1.1.1" || request.URL.Path != "/cdn-cgi/trace" || len(request.URL.Query()) != 1 || nonceErr != nil || len(decoded) != 16 || request.Header.Get("Authorization") != "" {
		return errors.New("native public proof changed its nonce, method, target or credential scope")
	}
	p.publicRequests.Add(1)
	if p.publicEntered != nil {
		p.publicOnce.Do(func() { close(p.publicEntered) })
		select {
		case <-p.publicRelease:
		case <-p.ctx.Done():
			return p.ctx.Err()
		}
	}
	ip := desktopExternalIntegrationIP
	if p.badIP {
		ip = "203.0.113.89"
	}
	body := "ip=" + ip + "\n"
	length := len(body)
	if p.truncatedBody {
		body = body[:len(body)-4]
	}
	_, err = fmt.Fprintf(secure, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s", length, body)
	return err
}

