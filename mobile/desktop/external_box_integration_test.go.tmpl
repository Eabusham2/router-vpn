func desktopExternalIntegrationAddress(t *testing.T) (net.Interface, netip.Addr) {
	t.Helper()
	interfaces, err := net.Interfaces()
	if err != nil {
		t.Fatal(err)
	}
	for _, iface := range interfaces {
		if iface.Flags&net.FlagUp == 0 || iface.Flags&net.FlagLoopback != 0 {
			continue
		}
		addresses, err := iface.Addrs()
		if err != nil {
			t.Fatal(err)
		}
		for _, raw := range addresses {
			prefix, err := netip.ParsePrefix(raw.String())
			if err == nil && prefix.Addr().Is4() && prefix.Addr().IsGlobalUnicast() {
				return iface, prefix.Addr()
			}
		}
	}
	t.Fatal("ordinary composition requires an existing local non-loopback IPv4 interface")
	return net.Interface{}, netip.Addr{}
}

// A TCP connection can finish its handshake while still waiting in the
// listener backlog. Force that ordering so a queued Accept cannot be mistaken
// for traffic sent after the exact client permit has already been retired.
func desktopExternalIntegrationDelayedAccept(t *testing.T) {
	t.Helper()
