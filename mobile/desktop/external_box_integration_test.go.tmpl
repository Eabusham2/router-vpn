// The independent reference translates only native event/read-offset types
// around the same userspace stack. The application uses its shipping AWG
// endpoint/wrapper; this peer uses the unmodified pinned AWG crypto device.
type desktopExternalAWGTUN struct {
	wgtransport.Device
	events           chan awgtun.Event
	done, configured chan struct{}
	offset           int
	refreshed        atomic.Bool
	once             sync.Once
	workers          sync.WaitGroup
}

func desktopExternalAWGWrap(stack wgtransport.Device, padding int) *desktopExternalAWGTUN {
	tun := &desktopExternalAWGTUN{Device: stack, events: make(chan awgtun.Event, 4), done: make(chan struct{}), configured: make(chan struct{}), offset: 16 + padding}
	tun.workers.Add(1)
	go func() {
		defer tun.workers.Done()
		defer close(tun.events)
		for {
			select {
			case <-tun.done:
				return
			case event, ok := <-stack.Events():
				if !ok {
					return
				}
				select {
				case tun.events <- awgtun.Event(event):
				case <-tun.done:
					return
				}
			}
		}
	}()
	return tun
}

func (t *desktopExternalAWGTUN) Events() <-chan awgtun.Event { return t.events }
func (t *desktopExternalAWGTUN) Read(packets [][]byte, sizes []int, offset int) (int, error) {
	select {
	case <-t.done:
		return 0, net.ErrClosed
	case <-t.configured:
	}
	if len(packets) != 1 || len(sizes) == 0 || offset < 0 || offset > len(packets[0]) {
		return 0, errors.New("external AWG reference lost its bounded packet buffer")
	}
	if offset != t.offset {
		if offset == 16 && t.refreshed.CompareAndSwap(false, true) {
			sizes[0] = 0
			return 0, nil
		}
		return 0, errors.New("external AWG reference lost its captured S4 read offset")
	}
	return t.Device.Read(packets, sizes, offset)
}
func (t *desktopExternalAWGTUN) Close() error {
	t.once.Do(func() { close(t.done); _ = t.Device.Close(); t.workers.Wait() })
	return nil
}

type desktopExternalAWGBind struct{ wgconn.Bind }

func (b *desktopExternalAWGBind) Open(port uint16) ([]awgconn.ReceiveFunc, uint16, error) {
	reads, port, err := b.Bind.Open(port)
	if err != nil {
		return nil, 0, err
	}
	converted := make([]awgconn.ReceiveFunc, len(reads))
	for i, read := range reads {
		converted[i] = func(packets [][]byte, sizes []int, endpoints []awgconn.Endpoint) (int, error) {
			values := make([]wgconn.Endpoint, len(endpoints))
			n, err := read(packets, sizes, values)
			for index := 0; index < n; index++ {
				endpoints[index] = values[index]
			}
			return n, err
		}
	}
	return converted, port, nil
}
func (b *desktopExternalAWGBind) Send(packets [][]byte, endpoint awgconn.Endpoint) error {
	return b.Bind.Send(packets, endpoint, 0)
}
func (b *desktopExternalAWGBind) ParseEndpoint(value string) (awgconn.Endpoint, error) {
	return b.Bind.ParseEndpoint(value)
}

func (p *desktopExternalIntegrationPeer) startAmnezia(t *testing.T) {
	t.Helper()
	parameters, err := awgpolicy.ParametersUAPI(p.awgParameters)
	padding, paddingErr := strconv.Atoi(p.awgParameters["s4"])
	if err != nil || paddingErr != nil || len(p.awgParameters) != 11 || p.packet == nil || p.listener != nil || (p.kernel == nil || !p.kernel.udp) && p.referenceBind == nil {
		t.Fatal("external AWG peer lost its complete captured parameters or sole UDP endpoint")
	}
	var values [3][]byte
	defer func() {
		for _, value := range values {
			clear(value)
		}
	}()
	for i, encoded := range []string{p.wgPrivate, p.wgClientPublic, p.wgPreshared} {
		raw, err := base64.StdEncoding.Strict().DecodeString(encoded)
		if err != nil || len(raw) != 32 {
			t.Fatal("external AWG peer requires independent keys")
		}
		values[i] = raw
	}
	stack, err := wgtransport.NewDevice(wgtransport.DeviceOptions{Context: p.ctx, Logger: log.NewNOPFactory().Logger(), Handler: p,
		UDPTimeout: 10 * time.Second, ICMPTimeout: time.Second, MTU: 1280,
		Address: []netip.Prefix{netip.MustParsePrefix("10.78.0.1/32"), netip.MustParsePrefix("fd78:78::1/128")}})
	if err != nil {
		t.Fatal("actual external AWG peer stack", err)
	}
	wrapped := desktopExternalAWGWrap(stack, padding)
	bind := p.referenceBind
	if bind == nil {
		bind = &desktopExternalWireGuardBind{peer: p}
	}
	device := awgdevice.NewDevice(wrapped, &desktopExternalAWGBind{bind}, &awgdevice.Logger{Verbosef: func(string, ...any) {}, Errorf: func(string, ...any) {}})
	p.closeProtocol = device.Close
	ipc := fmt.Sprintf("private_key=%x\n%spublic_key=%x\npreshared_key=%x\nallowed_ip=10.78.0.2/32\nallowed_ip=fd78:78::2/128\n", values[0], parameters, values[1], values[2])
	err = device.IpcSet(ipc)
	ipc = ""
	if err == nil {
		close(wrapped.configured)
		err = stack.Start()
	}
	if err == nil {
		err = device.Up()
	}
	if err != nil {
		t.Fatal("actual external AWG peer start", err)
	}
	expected := sha256.Sum256([]byte(parameters))
	p.awgReadback = func() error {
		raw, err := device.IpcGet()
		if err != nil || len(raw) == 0 || len(raw) > 64<<10 {
			return errors.New("external AWG peer omitted native parameter readback")
		}
		actual := map[string]string{"jc": "0", "jmin": "0", "jmax": "0", "s1": "0", "s2": "0", "s3": "0", "s4": "0"}
		seen := map[string]bool{}
		for _, line := range strings.Split(raw, "\n") {
			key, value, ok := strings.Cut(line, "=")
			if !ok || !awgpolicy.IsParameter(key) {
				continue
			}
			if seen[key] {
				return errors.New("external AWG peer repeated a captured parameter")
			}
			seen[key], actual[key] = true, value
		}
		raw = ""
		text, err := awgpolicy.ParametersUAPI(actual)
		mtu, mtuErr := wrapped.MTU()
		if err != nil || sha256.Sum256([]byte(text)) != expected || mtuErr != nil || mtu != 1280 || wrapped.offset != 16+padding {
			return errors.New("external AWG peer changed its eleven parameters, MTU or S4 offset")
		}
		return nil
	}
	if err := p.awgReadback(); err != nil {
		t.Fatal(err)
	}
}

