func desktopTorWaitMTUProof(t *testing.T, files *routerVPNTorFileFixture, matches func(mobiletor.DesktopBridgeProof) bool) mobiletor.DesktopBridgeProof {
	t.Helper()
	deadline := time.NewTimer(3 * time.Second)
	defer deadline.Stop()
	tick := time.NewTicker(10 * time.Millisecond)
	defer tick.Stop()
	for {
		var proof mobiletor.DesktopBridgeProof
		raw, err := os.ReadFile(filepath.Join(files.directory, "proof.json"))
		if err == nil && json.Unmarshal(raw, &proof) == nil && matches(proof) {
			return proof
		}
		select {
		case <-deadline.C:
			t.Fatal("Tor command did not publish its exact interface receipt", proof, err)
		case <-tick.C:
		}
	}
}

func desktopTorWaitMTUTerminal(t *testing.T, files *routerVPNTorFileFixture, request routerVPNDesktopMTURequest) routerVPNDesktopMTURecord {
	t.Helper()
	deadline := time.NewTimer(3 * time.Second)
	defer deadline.Stop()
	tick := time.NewTicker(10 * time.Millisecond)
	defer tick.Stop()
	for {
		var record routerVPNDesktopMTURecord
		raw, err := os.ReadFile(filepath.Join(files.directory, "mtu-status.json"))
		if err == nil && json.Unmarshal(raw, &record) == nil && record.Schema == request.Schema &&
			record.Session == request.Session && record.SourceSHA256 == request.SourceSHA256 && record.ConfigSHA256 == request.ConfigSHA256 &&
			record.Generation == request.Generation && record.Status.Request == request.Request && record.Status.Complete && !record.Status.Running {
			return record
		}
		select {
		case <-deadline.C:
			t.Fatal("Tor command did not publish its captured terminal MTU status", record, err)
		case <-tick.C:
		}
	}
}

func TestRouterVPNDesktopTorMTUCommandPublishesExactRollbackAndFreshPath(t *testing.T) {
	f := desktopTorAutoFiles(t)
	owner, lease := desktopTorMeasuredCommand(t, f)
	lease.blocked = make(chan struct{})
	parent, cancel := context.WithCancel(context.Background())
	done := make(chan error, 1)
	go func() {
		defer close(done)
		done <- routerVPNRunTor(parent, f.directory, routerVPNTorTestSession, f.binary, f.getenv, func(_ context.Context, files *routerVPNTorFiles, _ *routerVPNTorBinary) (routerVPNTorOwner, error) {
			owner.current = files.current
			return owner, nil
		})
	}()
	t.Cleanup(func() {
		cancel()
		select {
		case <-done:
		case <-time.After(3 * time.Second):
			t.Error("Tor MTU command did not drain")
		}
	})
	initial := desktopTorWaitMTUProof(t, f, func(p mobiletor.DesktopBridgeProof) bool { return p.Healthy })
	if initial.MTUReadback != nil {
		t.Fatal("new connection adopted an old MTU request")
	}
	var idle routerVPNDesktopMTURecord
	if json.Unmarshal(desktopExternalWaitFile(t, f.directory, "mtu-status.json"), &idle) != nil || idle.Generation != 0 || !idle.Requested || idle.MTUReadback != nil {
		t.Fatal("native Tor command did not expose its actual unmeasured Auto state", idle)
	}
	request := routerVPNDesktopMTURequest{Schema: 1, Session: initial.SessionID, SourceSHA256: initial.SourceSHA256, ConfigSHA256: initial.ConfigSHA256,
		Generation: 1, Request: strings.Repeat("d", 32), Force: true}
	write := func(name string, value any) {
		t.Helper()
		raw, err := json.Marshal(value)
		if err != nil || os.WriteFile(filepath.Join(f.directory, name), raw, 0600) != nil {
			t.Fatal("failed to write captured MTU fixture request", err)
		}
	}
	write("mtu-request.json", request)
	select {
	case <-lease.blocked:
	case <-time.After(2 * time.Second):
		t.Fatal("Tor command did not dispatch its actual MTU controller")
	}
	working := desktopTorWaitMTUProof(t, f, func(p mobiletor.DesktopBridgeProof) bool {
		return p.MTUReadback != nil && p.MTUReadback.Generation == 1 && p.MTUReadback.Revision == 1
	})
	if working.MTUReadback.RequestID != request.Request || working.InterfaceIndex != working.MTUReadback.InterfaceIndex || working.EffectiveMTU != working.MTUReadback.EffectiveMTU ||
		working.Policy != initial.Policy || working.Proof != initial.Proof || working.SourceSHA256 != initial.SourceSHA256 || working.ConfigSHA256 != initial.ConfigSHA256 {
		t.Fatal("Tor heartbeat changed immutable identity or mixed interface receipts", working)
	}
	write("mtu-cancel.json", routerVPNDesktopMTUControl{Schema: 1, Session: request.Session, SourceSHA256: request.SourceSHA256, ConfigSHA256: request.ConfigSHA256, Generation: 1, Request: request.Request})
	restored := desktopTorWaitMTUProof(t, f, func(p mobiletor.DesktopBridgeProof) bool {
		return p.MTUReadback != nil && p.MTUReadback.Revision == 2
	})
	// Heartbeat readback can observe rollback after the current maintenance
	// tick captured its still-running status. Await this request's terminal
	// publication before comparing the two independently written records.
	terminal := desktopTorWaitMTUTerminal(t, f, request)
	if terminal.MTUReadback == nil ||
		*terminal.MTUReadback != *restored.MTUReadback || !terminal.Status.Complete || terminal.Status.Running || terminal.Status.Measured || !terminal.Status.Restored {
		t.Fatal("Tor rollback status and heartbeat did not agree", terminal, restored)
	}
	before := lease.proofs.Load()
	path := routerVPNDesktopPathRequest{Schema: 1, Session: request.Session, SourceSHA256: request.SourceSHA256, ConfigSHA256: request.ConfigSHA256, Generation: 1, Request: strings.Repeat("e", 32)}
	write("path-request.json", path)
	verified := desktopPathRecord(t, f.directory, func(r routerVPNDesktopPathRecord) bool { return r.Generation == 1 && r.Complete })
	if !verified.Verified || verified.Cancelled || verified.CheckedAt == 0 || lease.proofs.Load() <= before {
		t.Fatal("Tor durable-save path reused a cached heartbeat", verified)
	}
	cancel()
	select {
	case err := <-done:
		if err != nil {
			t.Fatal(err)
		}
	case <-time.After(3 * time.Second):
		t.Fatal("Tor measurement services did not join before stop acknowledgement")
	}
	routerVPNTorCheckStoppedFixture(t, f)
}

func TestRouterVPNDesktopTorMTUHeartbeatRejectsRegressedOrUnregisteredReadback(t *testing.T) {
	f := desktopTorAutoFiles(t)
	owner, _ := desktopTorMeasuredCommand(t, f)
	initial := owner.proof
	valid := mobiletor.DesktopBridgeMTUReadback{Generation: 1, RequestID: strings.Repeat("a", 32), Revision: 1,
		InterfaceName: initial.InterfaceName, InterfaceIndex: initial.InterfaceIndex + 1, EffectiveMTU: 1400}
	for _, mutate := range []func(*mobiletor.DesktopBridgeMTUReadback){
		func(r *mobiletor.DesktopBridgeMTUReadback) { r.Generation = 0 },
		func(r *mobiletor.DesktopBridgeMTUReadback) { r.RequestID = "wrong" },
		func(r *mobiletor.DesktopBridgeMTUReadback) { r.InterfaceName = "another-tun" },
		func(r *mobiletor.DesktopBridgeMTUReadback) { r.InterfaceIndex = 0 },
		func(r *mobiletor.DesktopBridgeMTUReadback) { r.EffectiveMTU = 9001 },
		func(r *mobiletor.DesktopBridgeMTUReadback) { r.Revision = 0 },
	} {
		bad := valid
		mutate(&bad)
		owner.readback = func() (*mobiletor.DesktopBridgeMTUReadback, error) { return &bad, nil }
		receipt := initial
		if routerVPNTorRefreshReadback(context.Background(), owner, &receipt) == nil || receipt.MTUReadback != nil || receipt != initial {
			t.Fatal("malformed native interface receipt was adopted", bad, receipt)
		}
	}
	owner.readback = func() (*mobiletor.DesktopBridgeMTUReadback, error) { return &valid, nil }
	receipt := initial
	if err := routerVPNTorRefreshReadback(context.Background(), owner, &receipt); err != nil {
		t.Fatal(err)
	}
	retained := *receipt.MTUReadback
	valid.InterfaceIndex++
	if *receipt.MTUReadback != retained {
		t.Fatal("published receipt retained a mutable caller pointer")
	}
	if routerVPNTorRefreshReadback(context.Background(), owner, &receipt) == nil {
		t.Fatal("same interface revision authorized another native reader")
	}
	valid = retained
	valid.Revision--
	if routerVPNTorRefreshReadback(context.Background(), owner, &receipt) == nil {
		t.Fatal("native interface revision regressed")
	}
	owner.readback = func() (*mobiletor.DesktopBridgeMTUReadback, error) {
		return nil, errors.New("native readback unavailable")
	}
	if routerVPNTorRefreshReadback(context.Background(), owner, &receipt) == nil {
		t.Fatal("missing native readback was fabricated as unchanged")
	}
}

type desktopTorReceiptCommandFixture struct {
	*desktopTorMeasuredCommandFixture
	network func() (string, error)
}

func (f *desktopTorReceiptCommandFixture) DesktopNetworkReceipt() (string, error) {
	return f.network()
}

func TestRouterVPNDesktopTorMTUHeartbeatAdoptsCompleteReceipt(t *testing.T) {
	for _, prior := range []bool{false, true} {
		for _, outcome := range []string{"network-failure", "cancel-after-readback", "cancel-after-network", "network-name", "network-index", "network-mtu", "revision-changed", "cancel-after-recheck", "success"} {
			t.Run(fmt.Sprintf("previous-%t/%s", prior, outcome), func(t *testing.T) {
				files := desktopTorAutoFiles(t)
				base, _ := desktopTorMeasuredCommand(t, files)
				initial := base.proof
				initial.NetworkReceipt = "retained original network witness"
				if prior {
					initial.MTUReadback = &mobiletor.DesktopBridgeMTUReadback{Generation: 1, RequestID: strings.Repeat("a", 32), Revision: 1,
						InterfaceName: initial.InterfaceName, InterfaceIndex: initial.InterfaceIndex, EffectiveMTU: initial.EffectiveMTU}
				}
				valid := mobiletor.DesktopBridgeMTUReadback{Generation: 2, RequestID: strings.Repeat("b", 32), Revision: 2,
					InterfaceName: initial.InterfaceName, InterfaceIndex: initial.InterfaceIndex + 1, EffectiveMTU: 1400}
				ctx, cancel := context.WithCancel(context.Background())
				defer cancel()
				readbacks := 0
				base.readback = func() (*mobiletor.DesktopBridgeMTUReadback, error) {
					readbacks++
					if outcome == "cancel-after-readback" || outcome == "cancel-after-recheck" && readbacks == 2 {
						cancel()
					}
					return &valid, nil
				}
				network := desktopNetworkReceiptFixture(t, valid.InterfaceIndex, valid.EffectiveMTU, strings.Repeat("d", 32))
				witness, err := desktopnetwork.ParseDesktopNetworkReceipt(network)
				if err != nil {
					t.Fatal(err)
				}
				witness.Name = valid.InterfaceName
				switch outcome {
				case "network-name":
					witness.Name += "-replacement"
				case "network-index":
					witness.Index++
				case "network-mtu":
					witness.MTU++
				}
				network, err = desktopnetwork.CanonicalDesktopNetworkReceipt(witness)
				if err != nil {
					t.Fatal(err)
				}
				calls := 0
				owner := &desktopTorReceiptCommandFixture{desktopTorMeasuredCommandFixture: base, network: func() (string, error) {
					calls++
					if outcome == "revision-changed" {
						valid.Revision++
					}
					if outcome == "network-failure" {
						return "", errors.New("captured network witness lost")
					}
					if outcome == "cancel-after-network" {
						cancel()
					}
					return network, nil
				}}
				receipt := initial
				err = routerVPNTorRefreshReadback(ctx, owner, &receipt)
				if outcome != "success" {
					if err == nil || receipt != initial {
						t.Fatal("failed or cancelled network observation partially adopted the MTU/interface receipt", err, initial, receipt)
					}
					if strings.HasPrefix(outcome, "cancel-") && !errors.Is(err, context.Canceled) {
						t.Fatal("cancelled observation lost its cancellation identity", err)
					}
					if outcome == "cancel-after-readback" && calls != 0 {
						t.Fatal("cancelled readback began another network observation")
					}
					return
				}
				if err != nil || calls != 1 || receipt.MTUReadback == nil || *receipt.MTUReadback != valid ||
					receipt.InterfaceName != valid.InterfaceName || receipt.InterfaceIndex != valid.InterfaceIndex || receipt.EffectiveMTU != valid.EffectiveMTU || receipt.NetworkReceipt != network {
					t.Fatal("successful observation did not adopt its complete exact receipt", err, receipt)
				}
				retained := *receipt.MTUReadback
				valid.InterfaceIndex++
				if *receipt.MTUReadback != retained {
					t.Fatal("adopted receipt borrowed the mutable observation")
				}
				// Only the reader/MTU and its network witness may change. The
				// source, captured path, padding, proof and timestamp stay exact.
				receipt.MTUReadback, receipt.InterfaceName, receipt.InterfaceIndex, receipt.EffectiveMTU, receipt.NetworkReceipt =
					initial.MTUReadback, initial.InterfaceName, initial.InterfaceIndex, initial.EffectiveMTU, initial.NetworkReceipt
				if receipt != initial {
					t.Fatal("readback adoption changed captured proof authority")
				}
			})
		}
	}
}

func (f *desktopTorMeasuredCommandFixture) MTUReadbackContext(ctx context.Context) (*mobiletor.DesktopBridgeMTUReadback, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	if f.readback != nil {
		return f.readback()
	}
	if err := desktopnetwork.LockContext(ctx, &f.mtu.mu); err != nil {
		return nil, err
	}
	defer f.mtu.mu.Unlock()
	return f.mtu.readbackLockedContext(ctx)
}
func (f *desktopTorReceiptCommandFixture) DesktopNetworkReceiptContext(ctx context.Context) (string, error) {
	if err := ctx.Err(); err != nil {
		return "", err
	}
	return f.network()
}
