func desktopTorAutoFiles(t *testing.T) *routerVPNTorFileFixture {
	t.Helper()
	f := routerVPNNewTorFileFixture(t)
	raw, err := os.ReadFile(filepath.Join(f.directory, "tor-profile.json"))
	if err != nil {
		t.Fatal(err)
	}
	source := strings.Replace(string(raw), `"mtu_policy":"manual","manual_mtu":1392`, `"mtu_policy":"auto","manual_mtu":0`, 1)
	f.inputs, err = mobiletor.NewDesktopBridgeCapture(source, routerVPNTorTestSession, routerVPNTorTestIsolation, runtime.GOOS, f.binary, f.directory)
	if err != nil {
		t.Fatal(err)
	}
	for name, value := range map[string]string{"tor-profile.json": source, "tor-capture.json": f.inputs.JSON(), "torrc": f.inputs.Torrc(), "tor-defaults": f.inputs.Defaults(), "sing-box.json": f.inputs.Policy().Config()} {
		if err := os.WriteFile(filepath.Join(f.directory, name), []byte(value), 0600); err != nil {
			t.Fatal(err)
		}
	}
	digests := f.inputs.Digests()
	for name, value := range map[string]string{"SOURCE_SHA256": digests.SourceSHA256, "PROFILE_SHA256": digests.ProfileSHA256, "CAPTURE_SHA256": digests.CaptureSHA256,
		"TORRC_SHA256": digests.TorrcSHA256, "DEFAULTS_SHA256": digests.DefaultsSHA256, "CONFIG_SHA256": digests.ConfigSHA256} {
		f.environment["HOMEVPN_TOR_"+name] = value
	}
	return f
}

