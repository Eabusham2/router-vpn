func desktopTorMeasuredCommand(t *testing.T, files *routerVPNTorFileFixture) (*desktopTorMeasuredCommandFixture, *desktopTorMTULeaseFixture) {
	t.Helper()
	mtu, lease, _ := desktopTorMTUFixtureForPolicy(t, files.inputs.Policy())
