package routervpndesktoppt

import (
	"context"
	"errors"
	"os"
	"runtime"
	"time"

	"github.com/sagernet/sing-box/routervpn/desktopnetwork"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// BindPhysicalTunnel receives the real Box-owned TUN readback. Windows WFP
// permits that exact LUID, so an interface replacement requires an acknowledged
// retire/rebind. The Linux name-bound baseline keeps its existing semantics.
func (n *NetworkOwner) BindPhysicalTunnel(ctx context.Context, name string, index uint32) error {
	return n.changePhysicalTunnel(ctx, name, index, false)
}
func (n *NetworkOwner) BindPhysicalTunnelFile(ctx context.Context, name string, index uint32, file *os.File) error {
	if file == nil {
		return errors.New("desktop physical tunnel has no retained control descriptor")
	}
	return n.changePhysicalTunnelFile(ctx, name, index, false, file)
}
func (n *NetworkOwner) RetirePhysicalTunnel(ctx context.Context, name string, index uint32) error {
	return n.changePhysicalTunnel(ctx, name, index, true)
}
func (n *NetworkOwner) changePhysicalTunnel(ctx context.Context, name string, index uint32, retire bool) error {
	return n.changePhysicalTunnelFile(ctx, name, index, retire, nil)
}
func (n *NetworkOwner) changePhysicalTunnelFile(ctx context.Context, name string, index uint32, retire bool, file *os.File) error {
	if n == nil {
		return errors.New("desktop physical tunnel has no captured native owner")
	}
	// Capture is immutable after construction. The ordinary native path does
	// not acquire a physical-broker requirement merely by reaching this hook.
	if !n.capture.PhysicalBroker {
		return nil
	}
	if ctx == nil {
		return errors.New("desktop physical tunnel lost its original caller")
	}
	bounded, cancel := context.WithTimeout(ctx, 3*time.Second)
	defer cancel()
	if err := desktopnetwork.LockContext(bounded, &n.mu); err != nil {
		return err
	}
	source, capture := n.physicalSource, n.brokerCapture()
	current := n.activated && n.ready && !n.retired && n.ctx != nil && n.ctx.Err() == nil
	n.mu.Unlock()
	if !current || source == nil || name == "" || index == 0 {
		return errors.New("desktop physical tunnel has no captured native reader")
	}
	if err := bounded.Err(); err != nil {
		return err
	}
	policy, supported := source.(mobiletor.DesktopSocketTunnelPolicy)
	if !supported {
		if runtime.GOOS == "windows" || runtime.GOOS == "darwin" {
			return errors.New("desktop physical protection lost its actual kernel tunnel owner")
		}
		return bounded.Err()
	}
	var err error
	if retire {
		err = policy.RetireTunnel(bounded, capture, name, index)
	} else if file != nil {
		owned, ok := policy.(mobiletor.DesktopSocketTunnelFilePolicy)
		if !ok {
			return errors.New("desktop physical policy cannot retain its native tunnel control")
		}
		err = owned.BindTunnelFile(bounded, capture, name, index, file)
	} else {
		err = policy.BindTunnel(bounded, capture, name, index)
	}
	if lockErr := desktopnetwork.LockContext(bounded, &n.mu); lockErr != nil {
		return errors.Join(err, lockErr)
	}
	current = n.activated && n.ready && !n.retired && n.ctx != nil && n.ctx.Err() == nil && n.physicalSource == source && n.brokerCapture() == capture
	n.mu.Unlock()
	if !current {
		return errors.Join(err, bounded.Err(), errors.New("desktop physical tunnel policy did not acknowledge this exact reader"))
	}
	return errors.Join(err, bounded.Err())
}
