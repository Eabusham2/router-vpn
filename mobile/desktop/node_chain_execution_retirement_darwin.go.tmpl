//go:build darwin

package main

import (
	"context"
	"errors"

	"github.com/sagernet/sing-box/routervpn/macosprocess"
)

// finish is the sole native stopped-receipt producer. The authenticated stop
// callback observes retired only after this exact source/manager/Box join and
// successful publication under the original private workspace handle.
func (control *routerVPNDarwinNodeChainExecutionControl) finish(ctx context.Context, files *routerVPNExternalFiles) error {
	if control == nil || control.native == nil || ctx == nil || ctx.Err() != nil ||
		control.scope.Family != macosprocess.NodeChainExecutionFamily || !routerVPNExternalSession.MatchString(control.scope.Session) ||
		!routerVPNExternalSource.MatchString(control.scope.Source) || !routerVPNExternalSource.MatchString(control.scope.Config) {
		return routerVPNExternalFailure
	}
	if _, bounded := ctx.Deadline(); !bounded {
		return routerVPNExternalFailure
	}
	workspaceErr := control.workspace(files)
	if control.retired.Load() {
		return workspaceErr
	}
	control.retiring.Store(true)
	var removeErr error
	if workspaceErr == nil {
		removeErr = errors.Join(files.remove("node-ready.json"), files.remove("node-chain-execution-ready.json"),
			files.remove("node-chain-execution-adoption.json"), files.remove("node-chain-execution-last.json"))
	}
	// A refused receipt writer must not suppress retirement of resources
	// already held by this original native owner.
	joinErr := control.native.close(ctx)
	if workspaceErr != nil || removeErr != nil || joinErr != nil {
		return errors.Join(workspaceErr, removeErr, joinErr)
	}
	if ctx.Err() != nil || !control.native.joined {
		return routerVPNExternalFailure
	}
	closed := struct {
		routerVPNExternalStop
		Closed bool `json:"closed"`
	}{routerVPNExternalStop{Schema: 1, Session: control.scope.Session, SourceSHA256: control.scope.Config}, true}
	if err := files.publish("stopped.json", closed); err != nil {
		return err
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	control.retired.Store(true)
	return nil
}
