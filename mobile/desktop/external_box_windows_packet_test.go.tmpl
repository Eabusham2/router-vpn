// Private provider keys travel only over the original inherited bounded pipe.
// The client retains independent private material; public receipts never carry
// either private key or the preshared secret.
type desktopExternalWFPPacketRequest struct {
	Protocol        string            `json:"protocol"`
	PrivateKey      string            `json:"private_key"`
	ClientPublicKey string            `json:"client_public_key"`
	PreSharedKey    string            `json:"preshared_key"`
	Parameters      map[string]string `json:"parameters,omitempty"`
}
type desktopExternalWFPPacketCapture struct {
	protocol, privateKey, peerPublicKey, presharedKey string
	parameters                                        map[string]string
}

func desktopExternalWFPPacketKeys(t *testing.T, protocol string) (*desktopExternalWFPPacketRequest, *desktopExternalWFPPacketCapture) {
	t.Helper()
	if protocol != "wireguard" && protocol != "awg2-fast" && protocol != "awg2-strong" {
		t.Fatal("unknown captured packet protocol")
	}
	clientPrivate, clientPublic := desktopExternalIntegrationWGKey(t)
	serverPrivate, serverPublic := desktopExternalIntegrationWGKey(t)
	shared, _ := desktopExternalIntegrationWGKey(t)
	var parameters map[string]string
	if protocol != "wireguard" {
		parameters = desktopExternalIntegrationAWGParameters(protocol)
	}
	return &desktopExternalWFPPacketRequest{protocol, serverPrivate, clientPublic, shared, maps.Clone(parameters)},
		&desktopExternalWFPPacketCapture{protocol, clientPrivate, serverPublic, shared, maps.Clone(parameters)}
}

func desktopExternalWFPStartPacketPeer(t *testing.T, peer *desktopExternalIntegrationPeer, request *desktopExternalWFPPacketRequest, fault string) {
	t.Helper()
	if request == nil || request.Protocol != "wireguard" && request.Protocol != "awg2-fast" && request.Protocol != "awg2-strong" || peer.kernel != nil {
		t.Fatal("native packet provider lost its independent transport")
	}
	if request.Protocol == "wireguard" && len(request.Parameters) != 0 || request.Protocol != "wireguard" && !reflect.DeepEqual(request.Parameters, desktopExternalIntegrationAWGParameters(request.Protocol)) {
		t.Fatal("native packet provider parameters were not captured")
	}
	peer.protocol, peer.wgPrivate, peer.wgClientPublic, peer.wgPreshared = request.Protocol, request.PrivateKey, request.ClientPublicKey, request.PreSharedKey
	peer.awgParameters = maps.Clone(request.Parameters)
	switch fault {
	case "", "dns", "exit", "trust", "held":
	case "private-key":
		_, peer.wgClientPublic = desktopExternalIntegrationWGKey(t)
	case "psk":
		peer.wgPreshared, _ = desktopExternalIntegrationWGKey(t)
	case "parameters":
		if peer.protocol == "wireguard" {
			t.Fatal("plain WG cannot acquire AWG parameters")
		}
		peer.awgParameters["h1"] = "50000000-59999999"
	default:
		t.Fatal("unknown native packet negative")
	}
	peer.referenceBind = newDesktopExternalNativePacketBind(peer)
	peer.start(t)
	request.PrivateKey, request.ClientPublicKey, request.PreSharedKey = "", "", ""
	clear(request.Parameters)
}

