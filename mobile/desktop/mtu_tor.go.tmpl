type routerVPNDesktopTorMTULease interface {
	routerVPNDesktopMTULease
	routerVPNDesktopMTUReadbackLease
	routerVPNDesktopMTUMeasurementLease
	MTUReadbackContext(context.Context) (mobiletor.DesktopBridgeMTUReadback, error)
	RegisterOperation(uint64, string) error
	VerificationTarget() (string, string)
}

var _ routerVPNDesktopTorMTULease = (*box.RouterVPNDesktopTorMTULease)(nil)

type routerVPNTorMeasurementOwner interface {
	routerVPNExternalMTUProvider
	MTUReadbackContext(context.Context) (*mobiletor.DesktopBridgeMTUReadback, error)
	FreshPathOwner() routerVPNDesktopPathOwner
}

var _ routerVPNTorMeasurementOwner = (*routerVPNTorNative)(nil)

func routerVPNTorRefreshReadback(ctx context.Context, owner routerVPNTorOwner, receipt *mobiletor.DesktopBridgeProof) error {
	if ctx == nil || receipt == nil {
		return routerVPNTorFailure
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	captured, ok := owner.(routerVPNTorMeasurementOwner)
	if !ok {
		if receipt.MTUReadback != nil {
			return routerVPNTorFailure
		}
		return nil // Fixture owners do not claim a real OS TUN.
	}
	readback, err := captured.MTUReadbackContext(ctx)
	if err != nil {
		return err
	}
	// The MTU reader and routing witness form one receipt. Never install the
	// new interface/MTU before the matching network observation has succeeded;
	// a failed or late cancelled observation must leave the prior proof intact.
	next := *receipt
	if err := routerVPNTorAdoptReadback(&next, readback); err != nil {
		return err
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	network, err := routerVPNDesktopNetworkProjection(ctx, owner)
	if err != nil {
		return err
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	// Both observations must describe the same staged native interface. The
	// second MTU read prevents a transaction (including an interface-index ABA)
	// between the two snapshots from becoming a complete but mixed receipt.
	if network != "" {
		witness, err := desktopnetwork.ParseDesktopNetworkReceipt(network)
		if err != nil || witness.Name != next.InterfaceName || witness.Index != uint32(next.InterfaceIndex) || witness.MTU != next.EffectiveMTU {
			return routerVPNTorFailure
		}
	}
	confirmed, err := captured.MTUReadbackContext(ctx)
	if err != nil {
		return err
	}
	if (confirmed == nil) != (next.MTUReadback == nil) || confirmed != nil && *confirmed != *next.MTUReadback {
		return routerVPNTorFailure
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	next.NetworkReceipt = network
	*receipt = next
	return nil
}

func routerVPNTorAdoptReadback(receipt *mobiletor.DesktopBridgeProof, readback *mobiletor.DesktopBridgeMTUReadback) error {
	if readback == nil {
		if receipt.MTUReadback != nil {
			return routerVPNTorFailure
		}
		return nil
	}
	if readback.Generation == 0 || !routerVPNExternalSession.MatchString(readback.RequestID) || readback.InterfaceName != receipt.InterfaceName ||
		readback.InterfaceIndex < 1 || readback.EffectiveMTU < 1280 || readback.EffectiveMTU > 9000 {
		return routerVPNTorFailure
	}
	if previous := receipt.MTUReadback; previous != nil {
		if readback.Revision < previous.Revision || readback.Generation < previous.Generation ||
			readback.Generation == previous.Generation && readback.RequestID != previous.RequestID ||
			readback.Revision == previous.Revision && (readback.InterfaceIndex != previous.InterfaceIndex || readback.EffectiveMTU != previous.EffectiveMTU) {
			return routerVPNTorFailure
		}
	} else if readback.Revision == 0 && (readback.InterfaceIndex != receipt.InterfaceIndex || readback.EffectiveMTU != receipt.EffectiveMTU) {
		return routerVPNTorFailure
	}
	copy := *readback
	receipt.MTUReadback = &copy
	receipt.InterfaceName, receipt.InterfaceIndex, receipt.EffectiveMTU = copy.InterfaceName, copy.InterfaceIndex, copy.EffectiveMTU
	return nil
}

func newRouterVPNDesktopTorMTU(lease routerVPNDesktopMTULease, session string, physical func() string) (*routerVPNDesktopMTU, error) {
	if _, ok := lease.(routerVPNDesktopTorMTULease); !ok {
		return nil, routerVPNExternalFailure
	}
	owner, err := newRouterVPNDesktopMTUOwner(lease, session, physical)
	if err != nil {
		return nil, err
	}
	cache := &routerVPNDesktopMTUCache{}
	controller, err := mobilemtu.NewTor(owner, lease.Config(), lease.Authority(), cache)
	if err != nil {
		owner.invalid.Store(true)
		return nil, routerVPNExternalFailure
	}
	return &routerVPNDesktopMTU{owner: owner, controller: controller, cache: cache, tor: true}, nil
}

func (n *routerVPNTorNative) DesktopMTU() (*routerVPNDesktopMTU, error) {
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.mtu != nil {
		return n.mtu, nil
	}
	if n.ctx.Err() != nil || n.processExited() || n.tor == nil || !n.tor.Healthy() || n.box == nil || n.boxClosed {
		return nil, routerVPNTorFailure
	}
	lease, err := n.tor.ClaimMTU()
	if err != nil {
		return nil, routerVPNTorFailure
	}
	if err := lease.SetTransitionHandler(n.admitMTUTransition); err != nil {
		lease.Close()
		return nil, err
	}
	mtu, err := newRouterVPNDesktopTorMTU(lease, n.files.inputs.Capture().SessionID, func() string { return routerVPNDesktopPhysicalPath(n.box) })
	if err != nil {
		lease.Close()
		return nil, err
	}
	n.mtu = mtu
	return mtu, nil
}

// Only Tor has a mutable native-reader receipt. Registering the exact request
// precedes Start's worker and any restore; ordinary external leases keep their
// existing controller ownership contract.
func (m *routerVPNDesktopMTU) register(request routerVPNDesktopMTURequest) error {
	if !m.tor {
		return nil
	}
	lease, ok := m.owner.lease.(routerVPNDesktopTorMTULease)
	if !ok {
		return routerVPNExternalFailure
	}
	return lease.RegisterOperation(request.Generation, request.Request)
}

// Caller holds m.mu, so a new request cannot be joined to the old status or
// vice versa while the native interface reader is captured. Running candidates
// may advance the revision; terminal/waiting-commit adoption still requires the
// controller's matching atomically published live proof receipt.
func (m *routerVPNDesktopMTU) readbackLocked() (*mobiletor.DesktopBridgeMTUReadback, error) {
	return m.readbackLockedContext(context.Background())
}
func (m *routerVPNDesktopMTU) readbackLockedContext(ctx context.Context) (*mobiletor.DesktopBridgeMTUReadback, error) {
	if !m.tor {
		return nil, nil
	}
	lease, ok := m.owner.lease.(routerVPNDesktopTorMTULease)
	if !ok || m.closed || m.owner.invalid.Load() {
		return nil, routerVPNExternalFailure
	}
	readback, err := lease.MTUReadbackContext(ctx)
	if err != nil {
		return nil, err
	}
	if readback.Generation != m.request.Generation || readback.RequestID != m.request.Request ||
		readback.InterfaceName == "" || readback.InterfaceIndex < 1 || readback.EffectiveMTU < 1280 || readback.EffectiveMTU > 9000 {
		return nil, routerVPNExternalFailure
	}
	if readback.Generation == 0 {
		if readback.Revision != 0 || readback.RequestID != "" {
			return nil, routerVPNExternalFailure
		}
		return nil, nil
	}
	return &readback, nil
}

func (m *routerVPNDesktopMTU) readback() (*mobiletor.DesktopBridgeMTUReadback, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	return m.readbackLocked()
}

func (n *routerVPNTorNative) MTUReadback() (*mobiletor.DesktopBridgeMTUReadback, error) {
	return n.MTUReadbackContext(context.Background())
}
func (n *routerVPNTorNative) MTUReadbackContext(ctx context.Context) (*mobiletor.DesktopBridgeMTUReadback, error) {
	if err := n.HealthyContext(ctx); err != nil {
		return nil, err
	}
	if n.files.current() != nil {
		return nil, routerVPNTorFailure
	}
	if err := desktopnetwork.LockContext(ctx, &n.mu); err != nil {
		return nil, err
	}
	mtu := n.mtu
	n.mu.Unlock()
	if mtu == nil {
		return nil, ctx.Err()
	}
	if err := desktopnetwork.LockContext(ctx, &mtu.mu); err != nil {
		return nil, err
	}
	defer mtu.mu.Unlock()
	return mtu.readbackLockedContext(ctx)
}

type routerVPNTorPathRuntime interface {
	Healthy() bool
	HealthyContext(context.Context) error
	DesktopMTU() (*routerVPNDesktopMTU, error)
}

type routerVPNTorFreshPath struct {
	owner   routerVPNTorPathRuntime
	ctx     context.Context
	current func() error
}

func (p *routerVPNTorFreshPath) Healthy() bool {
	return p != nil && p.owner != nil && p.ctx != nil && p.ctx.Err() == nil && p.current != nil && p.current() == nil && p.owner.Healthy()
}
func (p *routerVPNTorFreshPath) VerifyCurrentPath() error {
	return p.VerifyCurrentPathContext(context.Background())
}
func (p *routerVPNTorFreshPath) VerifyCurrentPathContext(parent context.Context) error {
	if err := p.HealthyContext(parent); err != nil {
		return err
	}
	mtu, err := p.owner.DesktopMTU()
	if err != nil {
		return err
	}
	ctx, cancel := context.WithTimeout(parent, 30*time.Second)
	defer cancel()
	stop := context.AfterFunc(p.ctx, cancel)
	defer stop()
	state, err := mtu.owner.Capture()
	if err != nil || mtu.owner.VerifyExternal(ctx, state) != nil {
		return routerVPNTorFailure
	}
	return p.HealthyContext(ctx)
}

func (n *routerVPNTorNative) FreshPathOwner() routerVPNDesktopPathOwner {
	return &routerVPNTorFreshPath{owner: n, ctx: n.ctx, current: n.files.current}
}

func (p *routerVPNTorFreshPath) HealthyContext(ctx context.Context) error {
	if ctx == nil {
		return routerVPNTorFailure
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if p == nil || p.owner == nil || p.ctx == nil || p.ctx.Err() != nil || p.current == nil || p.current() != nil {
		return routerVPNTorFailure
	}
	return p.owner.HealthyContext(ctx)
}
