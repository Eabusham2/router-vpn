// These fixtures execute the real compiler, native owner, native lower object
// and broker byte path. The OS permit/isolated-identity constructor is the stated
// test boundary; the separate privileged kernel gates must still prove that
// constructor before any ordinary-external desktop admission can be enabled.
func externalPhysicalPolicyFixture(t *testing.T, protocol, host string, port int, lan bool, target string) *mobilemultihop.DesktopExternalPolicy {
	return externalPhysicalDeviceFixture(t, protocol, host, port, lan, target, "off", "always")
}

func externalPhysicalDeviceFixture(t *testing.T, protocol, host string, port int, lan bool, target, ipv6, kill string) *mobilemultihop.DesktopExternalPolicy {
	return externalPhysicalDeviceFixtureRemotes(t, protocol, host, port, lan, target, ipv6, kill, nil)
}

func externalPhysicalDeviceFixtureRemotes(t *testing.T, protocol, host string, port int, lan bool, target, ipv6, kill string, remotes []nativeopenvpn.Remote) *mobilemultihop.DesktopExternalPolicy {
	t.Helper()
	// The labels select independent imported test profiles. The saved native
	// protocol remains amneziawg; no preset alias is added to its schema.
	ssSelected := protocol
	ssEntry := protocol == "ss-entry-ss" || protocol == "ss-entry-http" || protocol == "ss-entry-https"
	if ssEntry {
		protocol = "shadowsocks"
	}
	openvpnMode := ""
	if parts := strings.Split(protocol, "-openvpn-"); len(parts) == 2 {
		openvpnMode = parts[1]
		if openvpnMode != "tcp" && openvpnMode != "udp" && openvpnMode != "mixed" {
			t.Fatal("uncaptured OpenVPN final transport")
		}
		if parts[0] == "wg-entry" {
			protocol = "wg-entry-wireguard"
		} else if parts[0] == "awg-entry-fast" {
			protocol = "awg-entry-wireguard-fast"
		} else if parts[0] == "awg-entry-strong" {
			protocol = "awg-entry-wireguard-strong"
		} else {
			t.Fatal("uncaptured OpenVPN packet entry")
		}
	}
	finalVariant := ""
	if selected, ok := strings.CutPrefix(protocol, "wg-entry-amneziawg-"); ok {
		finalVariant, protocol = selected, "wg-entry-wireguard"
	} else if parts := strings.Split(protocol, "-"); len(parts) == 5 && parts[0] == "awg" && parts[1] == "entry" && parts[3] == "amneziawg" {
		finalVariant, protocol = parts[4], "awg-entry-wireguard-"+parts[2]
	}
	if finalVariant != "" && finalVariant != "fast" && finalVariant != "strong" {
		t.Fatal("unknown final AWG import")
	}
	entrySelected := strings.HasPrefix(protocol, "wg-entry-") || strings.HasPrefix(protocol, "awg-entry-")
	entryExit := "shadowsocks"
	if ssSelected == "ss-entry-http" {
		entryExit = "http-connect"
	}
	if ssSelected == "ss-entry-https" {
		entryExit = "https-connect"
	}
	entryLayer := ""
	if strings.HasSuffix(protocol, "-aes-xor") {
		entryLayer = "aes-256-gcm+xor-whitening"
		protocol = strings.TrimSuffix(protocol, "-aes-xor")
	} else if strings.HasSuffix(protocol, "-aes") {
		entryLayer = "aes-256-gcm"
		protocol = strings.TrimSuffix(protocol, "-aes")
	}
	if entryLayer != "" && !strings.Contains(protocol, "-entry-hysteria2") {
		t.Fatal("layer requires captured HY2 entry fixture")
	}
	if entrySelected {
		parts := strings.Split(protocol, "-")
		if len(parts) < 3 {
			t.Fatal("missing captured stream exit")
		}
		switch parts[2] {
		case "ss":
		case "http":
			entryExit = "http-connect"
		case "https":
			entryExit = "https-connect"
		case "hysteria2":
			entryExit = "hysteria2"
		case "socks5":
			entryExit = "socks5"
		case "wireguard":
			entryExit = "wireguard"
		default:
			t.Fatal("unowned captured stream exit")
		}
		if parts[0] == "wg" {
			if len(parts) != 3 {
				t.Fatal("unknown WG import")
			}
			protocol = "wireguard"
		} else {
			if len(parts) != 4 {
				t.Fatal("unknown AWG import")
			}
			protocol = "amneziawg-" + parts[3]
		}
	}
	if finalVariant != "" {
		entryExit = "amneziawg"
	}
	if openvpnMode != "" {
		entryExit = "openvpn"
	}
	variant := ""
	if selected, ok := strings.CutPrefix(protocol, "amneziawg-"); ok {
		if selected != "fast" && selected != "strong" {
			t.Fatal("unknown captured Amnezia fixture variant")
		}
		protocol, variant = "amneziawg", selected
	}
	if selected, ok := strings.CutPrefix(protocol, "openvpn-"); ok {
		if selected != "tcp" && selected != "udp" && selected != "mixed" {
			t.Fatal("unknown captured OpenVPN fixture transport")
		}
		protocol, variant = "openvpn", selected
	}
	transport := map[string]any{"tag": mobilemultihop.ExternalFinalTag, "server": host, "server_port": port}
	private := map[string]any{"protocol": protocol, "expected_public_ip": "203.0.113.88"}
	switch protocol {
	case "socks5":
		transport["type"], transport["version"], transport["username"], transport["password"] = "socks", "5", "captured-user", "captured-password"
		private["socks5"] = map[string]any{"host": host, "port": port, "username": transport["username"], "password": transport["password"]}
	case "http-connect", "https-connect":
		transport["type"], transport["username"], transport["password"] = "http", "captured-user", "captured-password"
		settings := map[string]any{"host": host, "port": port, "username": transport["username"], "password": transport["password"]}
		if protocol == "https-connect" {
			transport["tls"] = map[string]any{"enabled": true, "server_name": "captured-proxy.example"}
			settings["tls_server_name"] = "captured-proxy.example"
		}
		private[strings.ReplaceAll(protocol, "-", "_")] = settings
	case "shadowsocks":
		transport["type"], transport["method"], transport["password"] = "shadowsocks", "2022-blake3-aes-256-gcm", base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{3}, 32))
		private["shadowsocks"] = map[string]any{"server": host, "port": port, "method": transport["method"], "password": transport["password"]}
	case "hysteria2":
		transport["type"], transport["password"] = "hysteria2", "captured-hysteria-password"
		transport["tls"] = map[string]any{"enabled": true, "server_name": "captured-proxy.example"}
		private["hysteria2"] = map[string]any{"server": host, "port": port, "password": transport["password"], "tls_server_name": "captured-proxy.example"}
	case "openvpn":
		if len(remotes) == 0 {
			network := variant
			if network == "mixed" {
				network = "tcp"
			}
			remotes = []nativeopenvpn.Remote{{Host: host, Port: port, Network: network}}
			if variant == "mixed" {
				remotes = append(remotes, nativeopenvpn.Remote{Host: "198.18.0.3", Port: 1195, Network: "udp"},
					nativeopenvpn.Remote{Host: "198.18.0.4", Port: 443, Network: "tcp"})
			}
		}
		config := "client\ndev tun\nproto " + remotes[0].Network + "\n"
		for _, remote := range remotes {
			if err := remote.Validate(); err != nil {
				t.Fatal("fixture changed its exact public OpenVPN remote", err)
			}
			config += fmt.Sprintf("remote %s %d %s\n", remote.Host, remote.Port, remote.Network)
		}
		config += "auth-user-pass\nremote-cert-tls server\nverify-x509-name captured-provider.example name\npeer-fingerprint " + strings.Repeat("ab", 32) + "\ntun-mtu 1280\ndata-ciphers AES-256-GCM:AES-128-GCM\n"
		compiled, err := nativeopenvpn.CompileEndpoint(config, "captured-user", "captured-password", mobilemultihop.ExternalFinalTag, "")
		transport = make(map[string]any)
		if err != nil || json.Unmarshal([]byte(compiled), &transport) != nil {
			t.Fatal("fixture lost its actual bounded OpenVPN compiler", err)
		}
		private["openvpn"] = map[string]any{"config": config, "username": "captured-user", "password": "captured-password"}
	case "wireguard", "amneziawg":
		key := func(value byte) string { return base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{value}, 32)) }
		transport = map[string]any{"type": "wireguard", "tag": mobilemultihop.ExternalFinalTag,
			"address": []string{"10.78.0.2/32", "fd78:78::2/128"}, "private_key": key(17), "mtu": 1280,
			"peers": []any{map[string]any{"address": host, "port": port, "public_key": key(18), "pre_shared_key": key(19),
				"allowed_ips": []string{"0.0.0.0/0", "::/0"}, "persistent_keepalive_interval": 25}}}
		settings := map[string]any{"endpoint": net.JoinHostPort(host, fmt.Sprint(port)), "private_key": key(17),
			"addresses": transport["address"], "peer_public_key": key(18), "preshared_key": key(19), "mtu": 1280,
			"allowed_ips": []string{"0.0.0.0/0", "::/0"}, "persistent_keepalive_interval": 25}
		if protocol == "amneziawg" {
			parameters := map[string]string{"jc": "3", "jmin": "40", "jmax": "900", "s1": "56", "s2": "48", "s3": "24", "s4": "32",
				"h1": "10000000-19999999", "h2": "20000000-29999999", "h3": "30000000-39999999", "h4": "40000000-49999999"}
			if variant == "fast" {
				parameters["jc"], parameters["jmin"], parameters["jmax"], parameters["s4"] = "0", "20", "40", "8"
			}
			transport["type"], transport["amnezia"], settings["parameters"] = mobilemultihop.AmneziaType, parameters, parameters
		}
		private[protocol] = settings
	default:
		t.Fatal("unexpected native fixture protocol")
	}
	profile := map[string]any{"id": "ordinary-native-exit", "node_kind": "external", "external": private, "dns_mode": "custom", "dns_protocol": "https",
		"dns_host": "192.168.50.53", "dns_port": 5443, "dns_server_name": "selected-resolver.example", "dns_path": "/captured-query",
		"home_lan_access": lan, "ipv6_mode": ipv6, "kill_switch_policy": kill, "mtu_policy": "auto"}
	selection := map[string]any{"schema": 1, "exit_id": profile["id"], "protocol": protocol, "expected_public_ip": private["expected_public_ip"], "profile": profile}
	graph := map[string]any{"outbounds": []any{transport}, "endpoints": []any{},
		"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "interface_name": "router-vpn", "address": []string{"172.29.91.1/30", "fd29:91::1/126"}, "mtu": 1280, "auto_route": true, "strict_route": true, "stack": "system"}},
		"route":    map[string]any{"rules": []any{}, "final": mobilemultihop.ExternalFinalTag, "auto_detect_interface": true}}
	if protocol == "wireguard" || protocol == "amneziawg" || protocol == "openvpn" {
		graph["outbounds"], graph["endpoints"] = []any{}, []any{transport}
	}
	if entrySelected || ssEntry {
		transport["tag"] = "external-entry"
		entry := map[string]any{"id": "captured-wg-entry", "node_kind": "external", "external": private, "home_lan_access": true, "ipv6_mode": "on", "mtu_policy": "auto"}
		final := map[string]any{"type": "shadowsocks", "tag": mobilemultihop.ExternalFinalTag, "server": "198.51.100.240", "server_port": 8388, "method": "2022-blake3-aes-256-gcm", "password": base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{23}, 32)), "detour": "external-entry"}
		profile["external"] = map[string]any{"protocol": "shadowsocks", "expected_public_ip": "203.0.113.88", "shadowsocks": map[string]any{"server": final["server"], "port": final["server_port"], "method": final["method"], "password": final["password"]}}
		if entryExit == "wireguard" || entryExit == "amneziawg" {
			key := func(value byte) string { return base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{value}, 32)) }
			transport["mtu"] = 1420
			private[protocol].(map[string]any)["mtu"] = 1420
			final = map[string]any{"type": "wireguard", "tag": mobilemultihop.ExternalFinalTag, "detour": "external-entry", "private_key": key(31), "mtu": 1360, "address": []string{"10.79.0.2/32", "fd79:79::2/128"}, "peers": []any{map[string]any{"address": "198.51.100.240", "port": 8388, "public_key": key(32), "pre_shared_key": key(33), "allowed_ips": []string{"0.0.0.0/0", "::/0"}}}}
			profile["external"] = map[string]any{"protocol": "wireguard", "expected_public_ip": "203.0.113.88", "wireguard": map[string]any{"endpoint": "198.51.100.240:8388", "private_key": key(31), "peer_public_key": key(32), "preshared_key": key(33), "addresses": final["address"], "allowed_ips": []string{"0.0.0.0/0", "::/0"}, "mtu": 1360}}
			if entryExit == "amneziawg" {
				parameters := map[string]string{"jc": "3", "jmin": "40", "jmax": "900", "s1": "56", "s2": "48", "s3": "24", "s4": "32", "h1": "10000000-19999999", "h2": "20000000-29999999", "h3": "30000000-39999999", "h4": "40000000-49999999"}
				if finalVariant == "fast" {
					parameters["jc"], parameters["jmin"], parameters["jmax"], parameters["s4"] = "0", "20", "40", "8"
				}
				final["type"], final["amnezia"], final["mtu"] = mobilemultihop.AmneziaType, parameters, 1328
				imported := profile["external"].(map[string]any)
				config := imported["wireguard"].(map[string]any)
				config["parameters"], config["mtu"] = parameters, 1328
				imported["protocol"], imported["amneziawg"] = "amneziawg", config
				delete(imported, "wireguard")
				profile["mtu_policy"], profile["manual_mtu"] = "manual", 1328
			}
		} else if entryExit == "openvpn" {
			transport["mtu"] = 1440
			private[protocol].(map[string]any)["mtu"] = 1440
			network := "tcp"
			if openvpnMode == "udp" || openvpnMode == "mixed" {
				network = "udp"
			}
			config := "client\ndev tun\nauth-user-pass\nremote-cert-tls server\npeer-fingerprint " + strings.Repeat("ab", 32) + "\ntun-mtu 1280\ndata-ciphers AES-256-GCM\n"
			if openvpnMode == "mixed" {
				config += "remote 198.51.100.240 8387 tcp\n"
			}
			config += "remote 198.51.100.240 8388 " + network + "\n"
			compiled, err := nativeopenvpn.CompileEndpoint(config, "captured-final-user", "captured-final-secret", mobilemultihop.ExternalFinalTag, "external-entry")
			if err != nil {
				t.Fatal(err)
			}
			// Unmarshal into a fresh object so no prior stream-only keys survive.
			final = map[string]any{}
			if json.Unmarshal([]byte(compiled), &final) != nil {
				t.Fatal("OpenVPN final projection failed")
			}
			profile["external"] = map[string]any{"protocol": "openvpn", "expected_public_ip": "203.0.113.88", "openvpn": map[string]any{"config": config, "username": "captured-final-user", "password": "captured-final-secret"}}
			profile["mtu_policy"], profile["manual_mtu"] = "manual", 1280
		} else if entryExit == "socks5" {
			delete(final, "method")
			final["type"], final["version"], final["username"], final["password"] = "socks", "5", "separate-captured-exit-user", "separate-captured-exit-password"
			profile["external"] = map[string]any{"protocol": "socks5", "expected_public_ip": "203.0.113.88", "socks5": map[string]any{"host": final["server"], "port": final["server_port"], "username": final["username"], "password": final["password"]}}
		} else if entryExit == "hysteria2" {
			delete(final, "method")
			final["type"], final["password"], final["tls"] = "hysteria2", "separate-captured-quic-password", map[string]any{"enabled": true, "server_name": "captured-exit.example"}
			profile["external"] = map[string]any{"protocol": "hysteria2", "expected_public_ip": "203.0.113.88", "hysteria2": map[string]any{"server": final["server"], "port": final["server_port"], "password": final["password"], "tls_server_name": "captured-exit.example"}}
		} else if entryExit != "shadowsocks" {
			delete(final, "method")
			final["type"], final["username"], final["password"] = "http", "separate-captured-exit-user", "separate-captured-exit-password"
			proxy := map[string]any{"host": final["server"], "port": final["server_port"], "username": final["username"], "password": final["password"]}
			if entryExit == "https-connect" {
				final["tls"] = map[string]any{"enabled": true, "server_name": "captured-exit.example"}
				proxy["tls_server_name"] = "captured-exit.example"
			}
			profile["external"] = map[string]any{"protocol": entryExit, "expected_public_ip": "203.0.113.88", strings.ReplaceAll(entryExit, "-", "_"): proxy}
		}
		if entryLayer != "" {
			profile["start_layer"] = entryLayer
			profile["external"].(map[string]any)["start_layer"] = map[string]any{"mode": entryLayer, "api": "http://10.93.0.1:8787", "transport": map[string]any{"type": "shadowsocks", "server": "198.51.100.240", "server_port": 8388, "method": "2022-blake3-aes-256-gcm", "password": base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{29}, 32))}}
		}
		selection["protocol"], selection["entry"], selection["entry_tag"] = entryExit, entry, "external-entry"
		graph["outbounds"] = []any{final}
		if ssEntry {
			graph["outbounds"], graph["endpoints"] = []any{transport, final}, []any{}
		}
		if entryExit == "wireguard" || entryExit == "amneziawg" || entryExit == "openvpn" {
			graph["outbounds"], graph["endpoints"] = []any{}, []any{transport, final}
		}
	}
	config, _ := json.Marshal(graph)
	capture, _ := json.Marshal(selection)
	original, err := mobilemultihop.NewExternalPolicy(string(config), string(capture))
	if err != nil {
		t.Fatal(err)
	}
	policy, err := mobilemultihop.NewDesktopExternalPolicy(original, strings.Repeat("a", 32), target)
	if err != nil {
		t.Fatal(err)
	}
	return policy
}

type externalPhysicalFixture struct {
	native   *desktopPTFixture
	policy   *mobilemultihop.DesktopExternalPolicy
	manager  *desktopPTEntryManager
	network  *ExternalNetworkOwner
	physical *ExternalPhysicalOutbound
}

func newExternalPhysicalFixture(t *testing.T, policy *mobilemultihop.DesktopExternalPolicy) *externalPhysicalFixture {
	t.Helper()
	f := newDesktopPTFixture(t)
	manager := &desktopPTEntryManager{}
	service.MustRegister[adapter.OutboundManager](f.ctx, manager)
	meta := policy.Metadata()
	options := ExternalCaptureOptions{SessionID: meta.SessionID, SourceSHA256: meta.SourceSHA256}
	raw, err := NewExternalNetworkOwner(f.ctx, nil, mobilemultihop.DesktopExternalNetworkTag, options)
	if err != nil {
		t.Fatal(err)
	}
	physical, err := NewExternalPhysicalOutbound(f.ctx, nil, nil, mobilemultihop.DesktopExternalPhysicalTag, options)
	if err != nil {
		t.Fatal(err)
	}
	manager.replace(physical)
	fixture := &externalPhysicalFixture{f, policy, manager, raw.(*ExternalNetworkOwner), physical.(*ExternalPhysicalOutbound)}
	if meta.SOCKSUDPAssociationTunneled {
		prepareExternalSOCKSEntryModel(t, fixture)
	}
	t.Cleanup(func() {
		if err := fixture.network.Close(); err != nil {
			t.Error(err)
		}
		if err := fixture.physical.Close(); err != nil {
			t.Error(err)
		}
	})
	return fixture
}

func (f *externalPhysicalFixture) start(t *testing.T, source *physicalFactorySource) context.Context {
	t.Helper()
	if err := f.network.PrepareExternalPhysicalBroker(f.policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observeCtx context.Context) error {
			return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
		})
		return broker, source, err
	}); err != nil {
		t.Fatal(err)
	}
	for _, stage := range []adapter.StartStage{adapter.StartStateInitialize, adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
		if err := f.network.Start(stage); err != nil {
			t.Fatal(err)
		}
	}
	ctx, err := f.network.Activate(f.policy)
	if err != nil {
		t.Fatal(err)
	}
	return ctx
}

func TestRouterVPNExternalPhysicalSeparateRegistriesAndUnpreparedRejection(t *testing.T) {
	services := boxService.NewRegistry()
	RegisterExternalNetworkOwner(services)
	outbounds := outbound.NewRegistry()
	RegisterExternalPhysicalOutbound(outbounds)
	for _, registry := range []interface{ CreateOptions(string) (any, bool) }{services, outbounds} {
		tag := mobilemultihop.DesktopExternalNetworkType
		if registry == outbounds {
			tag = mobilemultihop.DesktopExternalPhysicalType
		}
		options, found := registry.CreateOptions(tag)
		if !found {
			t.Fatal("external native type was not registered separately")
		}
		if _, ok := options.(*ExternalCaptureOptions); !ok {
			t.Fatal("external native registry borrowed Tor options")
		}
	}
	policy := externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, runtime.GOOS)
	f := newExternalPhysicalFixture(t, policy)
	if err := f.network.Start(adapter.StartStateInitialize); err == nil || f.network.Current() {
		t.Fatal("JSON-only owner opened a factory or became current")
	}
	if _, err := f.network.Activate(policy); err == nil {
		t.Fatal("unprepared graph activated")
	}
	if _, err := f.physical.DialContext(context.Background(), "tcp", M.ParseSocksaddr("192.168.50.7:8443")); err == nil {
		t.Fatal("unprepared outbound used a default dialer")
	}
	for _, tag := range []string{NetworkOwnerTag, "foreign"} {
		if raw, err := NewExternalNetworkOwner(context.Background(), nil, tag, f.network.capture); err == nil || raw != nil {
			t.Fatal("external native type adopted a foreign tag")
		}
	}
	if err := f.network.Close(); err != nil || f.network.Current() || f.network.Start(adapter.StartStateInitialize) == nil {
		t.Fatal("closed inert owner became startable", err)
	}
	var missing *ExternalNetworkOwner
	if missing.Current() || missing.Close() != nil || missing.Start(adapter.StartStateInitialize) == nil {
		t.Fatal("absent native owner acquired state")
	}
}

func TestRouterVPNExternalPhysicalFactoryAndActivationRetainExactPolicy(t *testing.T) {
	policy := externalPhysicalPolicyFixture(t, "shadowsocks", "192.168.50.7", 8443, false, runtime.GOOS)
	f := newExternalPhysicalFixture(t, policy)
	source := &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()}
	var calls atomic.Int32
	factory := func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		calls.Add(1)
		if capture != f.network.brokerCapture() || !current() || f.network.Current() {
			t.Error("external factory lost its pre-TUN generation")
		}
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observeCtx context.Context) error {
			return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
		})
		return broker, source, err
	}
