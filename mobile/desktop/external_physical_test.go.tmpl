func externalPhysicalFactoryInterface(t *testing.T) *adapter.NetworkInterface {
	t.Helper()
	interfaces, err := net.Interfaces()
	if err != nil {
		t.Fatal(err)
	}
	for _, actual := range interfaces {
		if actual.Flags&net.FlagUp == 0 || actual.Flags&net.FlagLoopback != 0 {
			continue
		}
		selected, err := control.InterfaceFromNet(actual)
		if err != nil {
			t.Fatal(err)
		}
		for _, prefix := range selected.Addresses {
			if prefix.Addr().Is4() && prefix.Addr().IsGlobalUnicast() {
				return &adapter.NetworkInterface{Interface: selected}
			}
		}
	}
	t.Fatal("ordinary native physical factory requires the runner's existing IPv4 interface")
	return nil
}

type externalPhysicalFactoryCase struct {
	fixture  *externalPhysicalFixture
	manager  *externalPhysicalFactoryNetwork
	selected *adapter.NetworkInterface
	source   *externalTunnelFixture
	lan      bool
	ipv6     string
	kill     string
	fault    string
	calls    int
}

func (c *externalPhysicalFactoryCase) constructed(t *testing.T, ctx context.Context, actual mobiletor.DesktopSocketCapture) error {
	t.Helper()
	c.calls++
	n := c.fixture.network
	if actual != n.brokerCapture() || ctx.Err() != nil || n.ready || n.active {
		t.Error("ordinary physical constructor substituted its captured identity or ran after admission")
	}
	changed := *c.selected
	changed.Addresses = append([]netip.Prefix(nil), c.selected.Addresses...)
	switch c.fault {
	case "during-index":
		changed.Index++
	case "during-address":
		changed.Addresses = []netip.Prefix{netip.MustParsePrefix("192.0.2.200/24")}
	case "during-mask":
		prefix := changed.Addresses[0]
		changed.Addresses[0] = netip.PrefixFrom(prefix.Addr(), (prefix.Bits()+1)%(prefix.Addr().BitLen()+1))
	case "during-down":
		changed.Flags &^= net.FlagUp
	case "partial":
		return errors.New("held ordinary partial constructor")
	case "cancel":
		n.Cancel()
	}
	c.manager.selected.Store(&changed)
	return nil
}

func runExternalPhysicalFactoryCases(t *testing.T, prepare func(*testing.T, *externalPhysicalFactoryCase) error) {
	runExternalPhysicalFactoryProtocolCases(t, []string{"shadowsocks"}, prepare)
}

func runExternalPhysicalFactoryProtocolCases(t *testing.T, protocols []string, prepare func(*testing.T, *externalPhysicalFactoryCase) error) {
	t.Helper()
	for _, protocol := range protocols {
		for _, lan := range []bool{false, true} {
			for _, ipv6 := range []string{"off", "on"} {
				for _, kill := range []string{"on-connect", "always"} {
					for _, fault := range []string{"live", "during-index", "during-address", "during-mask", "during-down", "partial", "cancel"} {
						t.Run(protocol+"/"+map[bool]string{false: "lan-off", true: "lan-on"}[lan]+"/ipv6-"+ipv6+"/"+kill+"/"+fault, func(t *testing.T) {
							policy := externalPhysicalDeviceFixture(t, protocol, "192.168.50.7", 8443, lan, runtime.GOOS, ipv6, kill)
							f := newExternalPhysicalFixture(t, policy)
							if protocol == "socks5" {
								var graph struct {
									Outbounds []json.RawMessage `json:"outbounds"`
								}
								var options ExternalSOCKSOptions
								if json.Unmarshal([]byte(policy.Config()), &graph) != nil || len(graph.Outbounds) != 2 || json.Unmarshal(graph.Outbounds[0], &options) != nil {
									t.Fatal("factory lost its sealed SOCKS options")
								}
								root, err := NewExternalSOCKSOutbound(f.native.ctx, nil, nil, mobilemultihop.ExternalFinalTag, options)
								if err != nil {
									t.Fatal(err)
								}
								manager := &externalSOCKSManager{objects: map[string]adapter.Outbound{root.Tag(): root, f.physical.Tag(): f.physical}}
								service.MustRegister[adapter.OutboundManager](f.native.ctx, manager)
								t.Cleanup(func() {
									if err := root.(*ExternalSOCKSOutbound).Close(); err != nil {
										t.Error(err)
									}
								})
							}
							selected := externalPhysicalFactoryInterface(t)
							manager := &externalPhysicalFactoryNetwork{desktopPTNetwork: f.native.network}
							manager.selected.Store(selected)
							service.MustRegister[adapter.NetworkManager](f.native.ctx, manager)
							source := &externalTunnelFixture{physicalFactorySource: &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()}}
							c := &externalPhysicalFactoryCase{fixture: f, manager: manager, selected: selected, source: source, lan: lan, ipv6: ipv6, kill: kill, fault: fault}
							if err := prepare(t, c); err != nil {
								t.Fatal(err)
							}
							if c.calls != 0 {
								t.Fatal("ordinary physical factory entered before native Initialize")
							}
							err := f.network.Start(adapter.StartStateInitialize)
							if c.calls != 1 {
								t.Fatal("ordinary native Initialize omitted or repeated its exact constructor")
							}
							if fault != "live" {
								if err == nil || !source.cancelled.Load() || f.network.Current() {
									t.Fatal("late or partial ordinary physical source survived failed initialization", err)
								}
							} else {
								if err != nil || f.network.broker == nil || !f.network.broker.Current() {
									t.Fatal("ordinary captured physical source failed initialization", err)
								}
								for _, stage := range []adapter.StartStage{adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
									if err := f.network.Start(stage); err != nil {
										t.Fatal(err)
									}
								}
								proof, err := f.network.Activate(policy)
								if err != nil || !f.network.Current() {
									t.Fatal("ordinary native activation lost its exact source", err)
								}
								changed := *selected
								changed.Addresses = []netip.Prefix{netip.MustParsePrefix("192.0.2.200/24")}
								manager.selected.Store(&changed)
								if f.network.Current() {
									t.Fatal("physical generation survived an actual default-interface address replacement")
								}
								f.network.Cancel()
								if proof.Err() == nil || !source.cancelled.Load() {
									t.Fatal("native replacement did not revoke retained proof and socket authority")
								}
							}
							if err := f.network.Close(); err != nil || !source.closed.Load() {
								t.Fatal("ordinary native cleanup discarded a retained partial source", err)
							}
						})
					}
				}
			}
		}
	}
}

type externalPhysicalBytePolicy struct {
	*desktopPhysicalPolicyFixture
	address   netip.Addr
	remote    netip.AddrPort
	alternate netip.AddrPort
}

func (p *externalPhysicalBytePolicy) Select(_ context.Context, _ mobiletor.DesktopSocketCapture, _ string, remote netip.AddrPort) (mobiletor.DesktopSocketBinding, error) {
	if remote != p.remote && remote != p.alternate {
		return mobiletor.DesktopSocketBinding{}, errors.New("fixture denied a different destination")
	}
	return mobiletor.DesktopSocketBinding{Owner: p.owner, InterfaceName: "actual-fixture-address", InterfaceIndex: 1, LocalAddress: p.address}, nil
}

func (p *externalPhysicalBytePolicy) Grant(_ context.Context, q mobiletor.DesktopSocketGrant) (mobiletor.DesktopSocketReceipt, error) {
	if q.Remote != p.remote && q.Remote != p.alternate {
		return mobiletor.DesktopSocketReceipt{}, errors.New("fixture denied an uncaptured remote")
	}
	p.mu.Lock()
	p.requests = append(p.requests, q)
	p.grants[q.SocketID+q.Remote.String()] = q
	p.mu.Unlock()
	now := time.Now()
	return mobiletor.DesktopSocketReceipt{Grant: q, ObservedAt: now.UnixMilli(), ExpiresAt: now.Add(10 * time.Second).UnixMilli()}, nil
}

func externalPhysicalByteAddress(t *testing.T) netip.Addr {
	t.Helper()
	interfaces, err := net.Interfaces()
	if err != nil {
		t.Fatal(err)
	}
	for _, iface := range interfaces {
		if iface.Flags&net.FlagUp == 0 || iface.Flags&net.FlagLoopback != 0 {
			continue
		}
		addresses, err := iface.Addrs()
		if err != nil {
			t.Fatal(err)
		}
		for _, address := range addresses {
			prefix, err := netip.ParsePrefix(address.String())
			if err == nil && prefix.Addr().Is4() && prefix.Addr().IsGlobalUnicast() {
				return prefix.Addr()
			}
