				packets, err = net.ListenPacket("udp4", net.JoinHostPort(address.String(), "0"))
				if err == nil {
					defer packets.Close()
					remote = packets.LocalAddr().(*net.UDPAddr).AddrPort()
				}
			}
			if err != nil {
				t.Fatal(err)
			}
			policy := externalPhysicalPolicyFixture(t, protocol, remote.Addr().String(), int(remote.Port()), false, runtime.GOOS)
			f := newExternalPhysicalFixture(t, policy)
			kernel := &externalPhysicalBytePolicy{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture(), address: address, remote: remote}
			if network == "packet" {
				// The independent OS seam admits a second *local fixture* peer.
				// Only the compiled native outbound rejects this extra tuple, so
				// its per-write restriction is not hidden by a narrower mock.
				other, err := net.ListenPacket("udp4", net.JoinHostPort(address.String(), "0"))
				if err != nil {
					t.Fatal(err)
				}
				defer other.Close()
				kernel.alternate = other.LocalAddr().(*net.UDPAddr).AddrPort()
			}
			partial := &physicalFactorySource{desktopPhysicalPolicyFixture: kernel.desktopPhysicalPolicyFixture}
			if err := f.network.PrepareExternalPhysicalBroker(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
				// The actual byte fixture isolates OS identity/permit authority;
				// it never creates an account or changes the runner's firewall.
				broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, kernel, current, func(observeCtx context.Context) error {
					return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
				})
				return broker, partial, err
			}); err != nil {
				t.Fatal(err)
			}
			if err := f.network.Start(adapter.StartStateInitialize); err != nil {
				t.Fatal(err)
			}
			for _, stage := range []adapter.StartStage{adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
				if err := f.network.Start(stage); err != nil {
					t.Fatal(err)
				}
			}
			if _, err := f.network.Activate(policy); err != nil {
				t.Fatal(err)
			}
			payload := bytes.Repeat([]byte("exact ordinary lower path"), 128)
			server := make(chan error, 1)
			go func() {
				if listener != nil {
					conn, err := listener.Accept()
					if err != nil {
						server <- err
						return
					}
					defer conn.Close()
					_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
					buffer := make([]byte, len(payload))
					_, err = io.ReadFull(conn, buffer)
					if err == nil {
						_, err = conn.Write(buffer)
					}
					server <- err
				} else {
					_ = packets.SetDeadline(time.Now().Add(5 * time.Second))
					buffer := make([]byte, len(payload))
					n, peer, err := packets.ReadFrom(buffer)
					if err == nil {
						_, err = packets.WriteTo(buffer[:n], peer)
					}
					server <- err
				}
			}()
			dialCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
			var closeSocket func() error
			if network == "packet" {
				packet, err := f.physical.ListenPacket(dialCtx, M.ParseSocksaddr(remote.String()))
				cancel()
				if err != nil {
					t.Fatal(err)
				}
				defer packet.Close()
				closeSocket = packet.Close
				_ = packet.SetDeadline(time.Now().Add(5 * time.Second))
				if _, err := packet.WriteTo(payload, net.UDPAddrFromAddrPort(kernel.alternate)); err == nil {
					t.Fatal("native packet write bypassed its compiled tuple despite live OS permission")
				}
				if _, err := packet.WriteTo(payload, net.UDPAddrFromAddrPort(remote)); err != nil {
					t.Fatal(err)
				}
				actual := make([]byte, len(payload)+1)
				n, from, err := packet.ReadFrom(actual)
				if err != nil || from == nil || from.String() != remote.String() || !bytes.Equal(actual[:n], payload) {
					t.Fatal("native packet lower path changed peer or bytes", err)
				}
			} else {
				conn, err := f.physical.DialContext(dialCtx, network, M.ParseSocksaddr(remote.String()))
				cancel()
				if err != nil {
					t.Fatal(err)
				}
				defer conn.Close()
				closeSocket = conn.Close
				_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
				if _, err := conn.Write(payload); err != nil {
					t.Fatal(err)
				}
				actual := make([]byte, len(payload))
				if _, err := io.ReadFull(conn, actual); err != nil || !bytes.Equal(actual, payload) {
					t.Fatal("native lower socket did not transfer exact bytes", err)
				}
			}
			if err := <-server; err != nil {
				t.Fatal(err)
			}
			if err := closeSocket(); err != nil {
				t.Fatal(err)
			}
			if protocol == "hysteria2" || protocol == "wireguard" || strings.HasPrefix(protocol, "amneziawg-") {
				if leaked, err := f.physical.DialContext(context.Background(), "tcp", M.ParseSocksaddr(remote.String())); err == nil || leaked != nil {
					if leaked != nil {
						_ = leaked.Close()
					}
					t.Fatal("captured UDP-only root acquired a TCP permission", protocol)
				}
			}
			for _, wrong := range []string{"192.0.2.99:8443", netip.AddrPortFrom(remote.Addr(), remote.Port()+1).String(), "unowned.example:8443"} {
				if leaked, err := f.physical.DialContext(context.Background(), baseNetwork, M.ParseSocksaddr(wrong)); err == nil || leaked != nil {
					if leaked != nil {
						_ = leaked.Close()
					}
					t.Fatal("native lower path accepted an uncaptured destination", wrong)
				}
			}
			foreign, err := NewExternalPhysicalOutbound(f.native.ctx, nil, nil, mobilemultihop.DesktopExternalPhysicalTag, f.network.capture)
			if err != nil {
				t.Fatal(err)
			}
			f.manager.replace(foreign)
			if leaked, err := f.physical.DialContext(context.Background(), baseNetwork, M.ParseSocksaddr(remote.String())); err == nil || leaked != nil {
				t.Fatal("replaced native lower object retained socket authority")
			}
			if err := f.network.Close(); err != nil {
				t.Fatal(err)
			}
			kernel.mu.Lock()
			left, calls := len(kernel.grants), len(kernel.requests)
			kernel.mu.Unlock()
			if left != 0 || calls == 0 || !partial.closed.Load() {
				t.Fatal("native lower cleanup lost exact grants/source")
			}
		})
	}
}

type externalTunnelFixture struct {
	*physicalFactorySource
	binds, retires atomic.Int32
	release        chan struct{}
	entered        chan struct{}
}

func (s *externalTunnelFixture) BindTunnel(ctx context.Context, _ mobiletor.DesktopSocketCapture, name string, index uint32) error {
	if name != "exact-tun" || index != 77 {
		return errors.New("foreign tunnel")
	}
	s.binds.Add(1)
	if s.entered != nil {
		close(s.entered)
		<-s.release
	}
	return ctx.Err()
}
func (s *externalTunnelFixture) RetireTunnel(ctx context.Context, capture mobiletor.DesktopSocketCapture, name string, index uint32) error {
	if name != "exact-tun" || index != 77 {
		return errors.New("foreign tunnel")
	}
	s.retires.Add(1)
	return ctx.Err()
}
func (s *externalTunnelFixture) BindTunnelFile(ctx context.Context, capture mobiletor.DesktopSocketCapture, name string, index uint32, file *os.File) error {
	if file == nil {
		return errors.New("missing retained tunnel control")
	}
	return s.BindTunnel(ctx, capture, name, index)
}

func TestRouterVPNExternalPhysicalTunnelLifecycleAndRetirement(t *testing.T) {
	policy := externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, runtime.GOOS)
	f := newExternalPhysicalFixture(t, policy)
	source := &externalTunnelFixture{physicalFactorySource: &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()}}
	if f.network.BindPhysicalTunnel(context.Background(), "exact-tun", 77) == nil {
		t.Fatal("inactive owner bound a tunnel")
	}
	if err := f.network.PrepareExternalPhysicalBroker(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observeCtx context.Context) error {
			return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
		})
		return broker, source, err
	}); err != nil {
		t.Fatal(err)
	}
	if err := f.network.Start(adapter.StartStateInitialize); err != nil {
		t.Fatal(err)
	}
	for _, stage := range []adapter.StartStage{adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
		if err := f.network.Start(stage); err != nil {
			t.Fatal(err)
		}
	}
	if _, err := f.network.Activate(policy); err != nil {
		t.Fatal(err)
	}
	if err := f.network.BindPhysicalTunnel(context.Background(), "exact-tun", 77); err != nil {
		t.Fatal(err)
	}
	if err := f.network.RetirePhysicalTunnel(context.Background(), "exact-tun", 77); err != nil {
		t.Fatal(err)
	}
	if source.binds.Load() != 1 || source.retires.Load() != 1 {
		t.Fatal("actual tunnel owner did not receive its lifecycle calls")
	}
	source.entered, source.release = make(chan struct{}), make(chan struct{})
	returned := make(chan error, 1)
	go func() { returned <- f.network.BindPhysicalTunnel(context.Background(), "exact-tun", 77) }()
	<-source.entered
	f.network.InterfaceUpdated(context.Background())
	close(source.release)
	if err := <-returned; err == nil {
		t.Fatal("late tunnel acknowledgement survived generation retirement")
	}
}

func TestRouterVPNExternalPhysicalJournalAdmissionCapturesDurableBarrier(t *testing.T) {
	policy := externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, "windows")
	meta := policy.Metadata()
	predecessor := mobiletor.DesktopWindowsProtectionTarget{Capture: mobiletor.DesktopSocketCapture{
		SessionID: strings.Repeat("b", 32), SourceSHA256: strings.Repeat("c", 64), NetworkID: strings.Repeat("d", 32)},
		Policy: "always", BaselineSHA256: strings.Repeat("e", 64)}
	original := predecessor
	prepared := ExternalPhysicalPrepared{Capture: mobiletor.DesktopSocketCapture{
		SessionID: meta.SessionID, SourceSHA256: meta.SourceSHA256, NetworkID: strings.Repeat("1", 32)},
		Policy: meta.KillSwitchPolicy, BaselineSHA256: strings.Repeat("2", 64)}
	candidate := mobiletor.DesktopWindowsProtectionTarget{Capture: prepared.Capture, Policy: prepared.Policy, BaselineSHA256: prepared.BaselineSHA256}
	admissions, commits := 0, 0
	admit := func(ctx context.Context, actual ExternalPhysicalPrepared) error {
		admissions++
		if ctx.Err() != nil || actual != prepared {
			return errors.New("fixture changed exact prepared external capture")
		}
		return nil
	}
	commit := func(ctx context.Context, actual mobiletor.DesktopWindowsProtectionCommit) error {
		commits++
		if ctx.Err() != nil || actual.Validate() != nil || actual.Action != "successor" || actual.Previous == nil || *actual.Previous != original || actual.Candidate == nil || *actual.Candidate != candidate {
			return errors.New("fixture changed the retained durable transaction")
		}
		return nil
	}
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	owned, err := WithExternalPhysicalJournalAdmission(ctx, policy, &predecessor, commit, admit)
	if err != nil {
		t.Fatal(err)
	}
	predecessor.Capture.NetworkID = strings.Repeat("f", 32)
	captured, err := externalPhysicalPredecessorFor(owned, policy)
	if err != nil || captured == nil || *captured != original {
		t.Fatal("journal retained caller-owned predecessor storage", err)
	}
	captured.Capture.NetworkID = strings.Repeat("f", 32)
	captured, err = externalPhysicalPredecessorFor(owned, policy)
	if err != nil || captured == nil || *captured != original {
		t.Fatal("returned predecessor mutated native capture", err)
	}
	barrier, err := externalPhysicalCommitFor(owned, policy)
	if err != nil || barrier == nil || barrier(owned, mobiletor.DesktopWindowsProtectionCommit{Action: "successor", Previous: captured, Candidate: &candidate}) != nil || commits != 1 {
		t.Fatal("external journal lost its original durable commit callback", err)
	}
	if err := CompleteExternalPhysicalAdmission(owned, policy, prepared); err != nil || admissions != 1 {
		t.Fatal("exact external admission was not retained", err)
	}
	for _, fault := range []string{"session", "source", "original-source", "network", "policy", "baseline"} {
		t.Run(fault, func(t *testing.T) {
			changed := prepared
			switch fault {
			case "session":
				changed.Capture.SessionID = strings.Repeat("f", 32)
			case "source":
				changed.Capture.SourceSHA256 = strings.Repeat("f", 64)
			case "original-source":
				changed.Capture.SourceSHA256 = meta.OriginalSourceSHA256
			case "network":
				changed.Capture.NetworkID = "missing-native-capture"
			case "policy":
				changed.Policy = "on-connect"
			case "baseline":
				changed.BaselineSHA256 = "missing-native-baseline"
			}
			if CompleteExternalPhysicalAdmission(owned, policy, changed) == nil || admissions != 1 {
				t.Fatal("changed prepared result reached durable admission")
			}
		})
	}
	foreign := externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, "windows")
	if _, err := externalPhysicalCommitFor(owned, foreign); err == nil {
		t.Fatal("equal but foreign policy acquired original barrier")
	}
	if _, err := externalPhysicalPredecessorFor(owned, foreign); err == nil {
		t.Fatal("equal but foreign policy acquired original predecessor")
	}
	if CompleteExternalPhysicalAdmission(owned, foreign, prepared) == nil || admissions != 1 {
		t.Fatal("equal but foreign policy consumed original admission")
	}
	if _, err := WithExternalPhysicalJournalAdmission(owned, policy, &original, commit, admit); err == nil {
		t.Fatal("journal capability was replaced in its owned context")
	}
	for _, fault := range []string{"nil-context", "cancelled-context", "nil-policy", "other-platform", "nil-barrier", "nil-admit", "invalid-predecessor"} {
		t.Run(fault, func(t *testing.T) {
			lifetime, selected, prior, barrier, callback := context.Context(context.Background()), policy, &original, mobiletor.DesktopWindowsProtectionCommitBarrier(commit), ExternalPhysicalAdmission(admit)
			switch fault {
			case "nil-context":
				lifetime = nil
			case "cancelled-context":
				var stop context.CancelFunc
				lifetime, stop = context.WithCancel(lifetime)
				stop()
			case "nil-policy":
				selected = nil
			case "other-platform":
				selected = externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, "linux")
			case "nil-barrier":
				barrier = nil
			case "nil-admit":
				callback = nil
			case "invalid-predecessor":
				invalid := original
				invalid.BaselineSHA256 = "unproved"
				prior = &invalid
			}
			if actual, err := WithExternalPhysicalJournalAdmission(lifetime, selected, prior, barrier, callback); err == nil || actual != nil {
				t.Fatal("incomplete external journal created a native capability")
			}
		})
	}
	initial, err := WithExternalPhysicalJournalAdmission(context.Background(), policy, nil, commit, admit)
	if err != nil {
		t.Fatal(err)
	}
	if prior, err := externalPhysicalPredecessorFor(initial, policy); err != nil || prior != nil {
		t.Fatal("explicit initial expectation became arbitrary recovery", err)
	}
	cancel()
	if _, err := externalPhysicalCommitFor(owned, policy); err == nil {
		t.Fatal("cancelled journal acquired a durable commit")
	}
	if _, err := externalPhysicalPredecessorFor(owned, policy); err == nil {
		t.Fatal("cancelled journal acquired a new predecessor")
	}
	if CompleteExternalPhysicalAdmission(owned, policy, prepared) == nil || admissions != 1 || commits != 1 {
		t.Fatal("cancelled journal admitted a late result")
	}
}

type externalPhysicalRetirementSource struct {
	*physicalFactorySource
	target    mobiletor.DesktopWindowsProtectionTarget
	closeFail atomic.Bool
	readErr   error
	readCalls int
}

func (s *externalPhysicalRetirementSource) Close(ctx context.Context) error {
	if s.closeFail.Load() {
		return errors.New("fixture retained ordinary native handle")
	}
	return s.physicalFactorySource.Close(ctx)
}
func (s *externalPhysicalRetirementSource) RetainedProtectionOutcome(context.Context) (*mobiletor.DesktopWindowsProtectionTarget, error) {
	s.readCalls++
	if s.readErr != nil {
		return nil, s.readErr
	}
	return &s.target, nil
}

func TestRouterVPNExternalPhysicalRetirementKeepsExactJoinedSource(t *testing.T) {
	for _, partial := range []bool{false, true} {
		t.Run(map[bool]string{false: "started", true: "partial-before-admission"}[partial], func(t *testing.T) {
			policy := externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, runtime.GOOS)
			f := newExternalPhysicalFixture(t, policy)
			source := &externalPhysicalRetirementSource{physicalFactorySource: &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()},
				target: mobiletor.DesktopWindowsProtectionTarget{Capture: f.network.brokerCapture(), Policy: "always", BaselineSHA256: strings.Repeat("a", 64)}}
			// This explicit native-source model exercises the real preparation,
			// factory and joined Close; it does not install or claim a WFP policy.
			if err := f.network.PrepareExternalPhysicalBroker(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
				if partial {
					return nil, source, errors.New("fixture failed after captured ordinary baseline construction")
				}
				broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observeCtx context.Context) error {
					return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
				})
				return broker, source, err
			}); err != nil {
				t.Fatal(err)
			}
			if err := f.network.Start(adapter.StartStateInitialize); (err != nil) != partial {
				t.Fatal("fixture entered another construction phase", err)
			}
			if _, _, err := f.network.RetainedPhysicalProtection(context.Background(), policy); err == nil || source.readCalls != 0 {
				t.Fatal("unjoined ordinary source yielded a retirement result")
			}
			source.closeFail.Store(true)
			if f.network.Close() == nil {
				t.Fatal("fixture failed close unexpectedly joined")
			}
			if _, _, err := f.network.RetainedPhysicalProtection(context.Background(), policy); err == nil || source.readCalls != 0 {
				t.Fatal("failed ordinary close yielded a retirement result")
			}
			source.closeFail.Store(false)
			if err := f.network.Close(); err != nil {
				t.Fatal(err)
			}
			actual, captured, err := f.network.RetainedPhysicalProtection(context.Background(), policy)
			if err != nil || !captured || actual == nil || *actual != source.target || source.readCalls != 1 {
				t.Fatal("joined ordinary source lost its exact outcome", err)
			}
			actual.Capture.NetworkID = strings.Repeat("e", 32)
			if source.target.Capture != f.network.brokerCapture() {
				t.Fatal("returned outcome mutated original native source")
			}
			foreign := externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, runtime.GOOS)
			if _, _, err := f.network.RetainedPhysicalProtection(context.Background(), foreign); err == nil || source.readCalls != 1 {
				t.Fatal("foreign policy queried original retirement")
			}
			cancelled, cancel := context.WithCancel(context.Background())
			cancel()
			if _, _, err := f.network.RetainedPhysicalProtection(cancelled, policy); err == nil || source.readCalls != 1 {
				t.Fatal("cancelled query reached original source")
			}
			source.readErr = errors.New("fixture retained baseline replaced")
			if target, captured, err := f.network.RetainedPhysicalProtection(context.Background(), policy); err == nil || !captured || target != nil {
				t.Fatal("failed outcome became an unchanged predecessor")
			}
			source.readErr = nil
			source.target.Capture.NetworkID = strings.Repeat("e", 32)
			if target, _, err := f.network.RetainedPhysicalProtection(context.Background(), policy); err == nil || target != nil {
				t.Fatal("foreign network replaced original outcome")
			}
		})
	}
	policy := externalPhysicalPolicyFixture(t, "http-connect", "192.168.50.7", 8443, false, runtime.GOOS)
	f := newExternalPhysicalFixture(t, policy)
	if err := f.network.Close(); err != nil {
		t.Fatal(err)
	}
	if target, captured, err := f.network.RetainedPhysicalProtection(context.Background(), policy); err != nil || captured || target != nil {
		t.Fatal("never-entered source fabricated native absence", err)
	}
}
