// This extends only the paired prefix. The original imported member, provider,
// private final identity and last-prefix routing remain owned by the old tail.
func nodeChainOpenVPNPairedPrefixSource(t *testing.T, r desktopNodeChainPeerRequest, clients []string, physical, finalIdentity string) mobilemultihop.NodeChainSource {
	t.Helper()
	base := desktopNodeChainPeerSource(t, r, clients, physical)
	launch, err := base.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(launch), &source) != nil || len(source.Nodes) != len(r.Prefixes)+1 {
		t.Fatal("original complete packet source absent")
	}
	identities := make([]string, len(r.Prefixes)+2)
	for i, prefix := range r.Prefixes {
		private, _ := base64.StdEncoding.DecodeString(prefix.PrivateKey)
		server, err := ecdh.X25519().NewPrivateKey(private)
		clear(private)
		if err != nil {
			t.Fatal(err)
		}
		_, client := desktopNodeChainInner(i, len(r.Prefixes))
		target := desktopNodeChainNext(i)
		if i == 0 {
			target = physical
		}
		text := fmt.Sprintf("[Interface]\nAddress=%s/32,fd78:78::2/128\nPrivateKey=%s\nDNS=192.168.50.133\nMTU=2000\n[Peer]\nPublicKey=%s\nPresharedKey=%s\nEndpoint=%s\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n", client, clients[i], base64.StdEncoding.EncodeToString(server.PublicKey().Bytes()), prefix.PreSharedKey, target)
		identities[i] = desktopNodeChainJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(text))})
	}
	count := len(r.Prefixes)
	identities[count+1] = finalIdentity
	source.IdentitySources = identities
	source.Nodes = append(source.Nodes[:count], "", source.Nodes[count])
	source.Schema = 5
	return source
}

func (f *nodeChainOpenVPNFixture) snapshot() desktopNodeChainImportedReply {
	snapshot := f.peer.snapshot()
	if f.complete != nil {
		snapshot.Prefixes = f.complete.snapshot().Prefixes
		snapshot.Address = f.complete.prefixes[0].bind.address()
	}
	return snapshot
}
func (f *nodeChainOpenVPNFixture) samples() []uint64 {
	count := len(f.request.Prefixes)
	samples := make([]uint64, count+2)
	for i := 0; i < count; i++ {
		if i == count-1 {
			samples[i] = f.peer.measuredFirstHealth.Load()
		} else {
			samples[i] = f.complete.prefixes[i].measuredHealth.Load()
		}
	}
	samples[count] = f.peer.snapshot().Middle.DownloadBytes
	samples[count+1] = f.peer.paired.measuredHealth.Load()
	return samples
}

func TestRouterVPNDesktopNodeChainOpenVPNPrefixTraffic(t *testing.T) {
	chosen := os.Getenv("ROUTERVPN_OPENVPN_PREFIX_CASE")
	if chosen == "" {
		t.Skip("captured long prefix case required")
	}
	parts := strings.Split(chosen, "/")
	if len(parts) != 4 {
		t.Fatal("uncaptured prefix selector")
	}
	mode, network := parts[0], parts[1]
	count, err := strconv.Atoi(parts[2])
	if err != nil || strconv.Itoa(count) != parts[2] || (count != 2 && count != 6) || (mode != "wg" && mode != "awg2-fast" && mode != "awg2-strong") || (network != "tcp" && network != "udp") {
		t.Fatal("uncaptured prefix shape")
	}
	group, err := strconv.Atoi(parts[3])
	if err != nil || strconv.Itoa(group) != parts[3] || group < 0 || group >= (count+2)/2 {
		t.Fatal("uncaptured measurement group")
	}
	t.Run(strings.ReplaceAll(chosen, "/", "-"), func(t *testing.T) {
		// New long composition only. Original trio retains its 12/45-second owner;
		// all production proof, worker and per-request clocks remain unchanged.
		f := nodeChainOpenVPNStartPrefixes(t, mode, network, "", 170*time.Second, count)
		f.prove(t)
		f.fiftyPrefixGroup(t, group)
		if err := f.close(); err != nil {
			t.Fatal("original full prefix retirement", err)
		}
		if f.chain.Progress().Ready || f.chain.HealthyContext(context.Background()) == nil {
			t.Fatal("closed original path became current")
		}
	})
}

func TestRouterVPNDesktopNodeChainOpenVPNPrefixRefusal(t *testing.T) {
	fault := os.Getenv("ROUTERVPN_OPENVPN_PREFIX_REFUSAL")
	if fault == "" {
		t.Skip("captured long prefix refusal required")
	}
	switch fault {
	case "wrong-intermediate-key", "omit-last-prefix", "wrong-middle-password", "wrong-final-identity", "selected-dns-failure":
	default:
		t.Fatal("uncaptured refusal")
	}
	t.Run(fault, func(t *testing.T) {
		f := nodeChainOpenVPNStartPrefixes(t, "awg2-strong", "udp", fault, 12*time.Second, 6)
		ctx, cancel := context.WithTimeout(f.ctx, 5*time.Second)
		defer cancel()
		if err := f.chain.Run(ctx, f.engine); err == nil || f.chain.Progress().Ready {
			t.Fatal("invalid original long path became ready", fault)
		}
		stats := f.snapshot()
		if stats.Prefixes[0].RawUDP == 0 {
			t.Fatal("negative never reached original first encrypted owner")
		}
		if fault == "wrong-final-identity" || fault == "selected-dns-failure" {
			if stats.Final.RouterQueries == 0 {
				t.Fatal("negative never reached paired final identity")
			}
		} else if stats.Final.RouterQueries != 0 {
			t.Fatal("invalid intermediate path acquired paired final authority")
		}
	})
}

func (f *nodeChainOpenVPNFixture) fiftyPrefixGroup(t *testing.T, group int) {
	t.Helper()
	service, err := f.chain.NewHopMeasurementContext(f.ctx, f)
	if err != nil {
		t.Fatal("original encrypted measurement source", err)
	}
	t.Cleanup(func() {
		if err := service.Close(); err != nil {
			t.Error(err)
		}
	})
	// The private reference CA is the only replacement at TLS validation.
	field := reflect.ValueOf(service).Elem().FieldByName("publicTLS")
	*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.testTLS.Clone()
	facade, err := hopmeasure.NewOrderedLatencyContext(f.ctx, service, f.chain.SourceSHA256(), f.chain.ConfigSHA256())
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := facade.Close(); err != nil {
			t.Error(err)
		}
	})
	proofs := f.chain.ProofInventory()
	for position := group * 2; position < group*2+2; position++ {
		proof := proofs[position]
		t.Logf("OPENVPN_PREFIX_FIFTY position=%d phase=start", position)
		started := time.Now()
		before := f.samples()
		request := fmt.Sprintf("%032x", position+1)
		if err := facade.StartContext(f.ctx, request, proof.ProfileID); err != nil {
			t.Fatal(err)
		}
		if err := facade.DrainContext(f.ctx, request); err != nil {
			t.Fatal("original fifty-response worker did not drain", err)
		}
		var status hopmeasure.Status
		if json.Unmarshal([]byte(facade.StatusJSON()), &status) != nil || !status.Complete || !status.Drained || status.Failure != "" || len(status.Results) != 1 {
			t.Fatal("encrypted fifty-response result absent", facade.StatusJSON())
		}
		row := status.Results[0]
		kind, metric := "private-node", "routed-private-response-including-connection"
		if position == len(proofs)-2 {
			kind, metric = "public-path", "routed-https-response-after-tls"
		}
		if !row.Ready || row.ID != proof.ProfileID || row.Kind != kind || row.Benchmark == nil || row.Benchmark.Measurement != metric || row.Benchmark.Attempts != 50 || row.Benchmark.Failed != 0 || row.Benchmark.Distribution == nil || row.Benchmark.Distribution.Samples != 50 || row.Benchmark.TrimmedMean <= 0 || row.Download != nil || row.Upload != nil || row.Idle != nil {
			t.Fatal("original fifty-response metric changed", row)
		}
		var saved hopmeasure.OrderedLatencyReceipt
		if json.Unmarshal([]byte(facade.SavedJSON(proof.ProfileID)), &saved) != nil || saved.Position != position || saved.NodeID != proof.ProfileID || saved.SourceSHA256 != f.chain.SourceSHA256() || saved.ConfigSHA256 != f.chain.ConfigSHA256() {
			t.Fatal("fifty-response history lost original path", saved)
		}
		after := f.samples()
		for i := range after {
			want := uint64(0)
			if i == position {
				want = 50
			}
			if after[i]-before[i] != want {
				t.Fatal("fifty responses borrowed another prefix", position, i, before, after)
			}
		}
		t.Logf("OPENVPN_PREFIX_FIFTY position=%d phase=complete elapsed=%s", position, time.Since(started))
		if f.measuring.Load() || f.acquired.Load() != int32(position-group*2+1) || f.released.Load() != f.acquired.Load() {
			t.Fatal("fifty-response completion did not release original scope")
		}
	}
	previous := facade.CommittedJSON(proofs[len(proofs)-2].ProfileID)
	f.reconnect(t)
	if facade.StartContext(f.ctx, strings.Repeat("f", 32), proofs[len(proofs)-2].ProfileID) == nil || facade.CommittedJSON(proofs[len(proofs)-2].ProfileID) != previous || f.measuring.Load() {
		t.Fatal("reconnected middle borrowed original measurement or replaced history")
	}
}
