func desktopExecutionJSON(t *testing.T, value any) string {
	t.Helper()
	raw, err := json.Marshal(value)
	if err != nil {
		t.Fatal(err)
	}
	return string(raw)
}

// Compile real complete private sources and independent server-side packet
// identities. Native I/O/proof doubles below test the child ownership seam;
// they are not encrypted prefix, DNS, lease or physical-device acceptance.
func desktopExecutionCommandSource(t *testing.T, target, execution string) (*mobilemultihop.NodeChainExecutionPreparation, *mobilemultihop.NodeChainExecutionProjection) {
	t.Helper()
	local := desktopNodeChainCommandPolicy(t, 3, target, 1420).OriginalChain()
	raw, err := local.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if err := json.Unmarshal([]byte(raw), &source); err != nil {
		t.Fatal(err)
	}
	proofs := local.ProofInventory()
	serverSource := mobilemultihop.NodeChainServerSource{Schema: 1, EntryID: proofs[0].ProfileID, EntryNodeID: proofs[0].NodeID, EntryMode: proofs[0].Mode}
	keys := []string{}
	for i, launch := range source.Nodes {
		var row struct {
			Mode      string `json:"mode"`
			Files     string `json:"files"`
			Profile   string `json:"profile_json"`
			Start     string `json:"start"`
			Bootstrap string `json:"dns_bootstrap"`
		}
		if err := json.Unmarshal([]byte(launch), &row); err != nil {
			t.Fatal(err)
		}
		identity := row.Files
		if row.Mode == "shadowsocks" {
			server, _ := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{byte(90 + i)}, 32))
			wg := fmt.Sprintf("[Interface]\nAddress=10.%d.0.2/32\nPrivateKey=%s\nDNS=192.168.50.133\nMTU=2000\n[Peer]\nPublicKey=%s\nEndpoint=198.51.100.%d:51820\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n", 77+i,
				base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(40 + i)}, 32)), base64.StdEncoding.EncodeToString(server.PublicKey().Bytes()), 10+i)
			identity = desktopExecutionJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(wg))})
		} else {
			node, err := mobilemultihop.NewNodeProfile(row.Mode, row.Files, row.Profile, row.Start, row.Bootstrap)
			if err != nil {
				t.Fatal(err)
			}
			key, err := node.PacketClientPublicKey()
			if err != nil {
				t.Fatal(err)
			}
			keys = append(keys, key)
		}
		source.IdentitySources = append(source.IdentitySources, identity)
		if i == 0 {
			continue
		}
		if row.Mode == "wg" {
			var files map[string]string
			if err := json.Unmarshal([]byte(row.Files), &files); err != nil {
				t.Fatal(err)
			}
			wg, err := base64.StdEncoding.DecodeString(files["wg.conf"])
			if err != nil {
				t.Fatal(err)
			}
			old := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(40 + i)}, 32))
			next := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(220 + i)}, 32))
			if !strings.Contains(string(wg), old) {
				t.Fatal("missing original client key")
			}
			files["wg.conf"] = base64.StdEncoding.EncodeToString([]byte(strings.Replace(string(wg), old, next, 1)))
			row.Files = desktopExecutionJSON(t, files)
			node, err := mobilemultihop.NewNodeProfile(row.Mode, row.Files, row.Profile, row.Start, row.Bootstrap)
			if err != nil {
				t.Fatal(err)
			}
			launch, err = node.LaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			identity = row.Files
		}
		serverSource.Nodes = append(serverSource.Nodes, launch)
		serverSource.IdentitySources = append(serverSource.IdentitySources, identity)
	}
	local, err = mobilemultihop.NewNodeChain(desktopExecutionJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	original, err := mobilemultihop.NewDesktopNodeChainPolicy(local, desktopExternalSession, target, 1420)
	if err != nil {
		t.Fatal(err)
	}
	prep, err := mobilemultihop.NewDesktopNodeChainExecutionPreparation(original, execution)
	if err != nil {
		t.Fatal(err)
	}
	server, err := mobilemultihop.NewNodeChainServerPolicy(desktopExecutionJSON(t, serverSource))
	if err != nil {
		t.Fatal(err)
	}
	descriptor := server.Descriptor()
	digest, err := descriptor.Digest()
	if err != nil {
		t.Fatal(err)
	}
	request := multihoprelay.NodeChainRequest{Schema: 1, SessionID: strings.Repeat("1", 32), EntryNodeID: descriptor.EntryNodeID,
		SourceSHA256: descriptor.SourceSHA256, DescriptorSHA256: digest, DNSPolicySHA256: descriptor.DNSPolicySHA256,
		Epoch: strings.Repeat("2", 64), Peer: "10.77.0.2", AcquireExpiresAt: time.Now().Add(time.Minute).Unix(), Port: 32000, LocalPacketPublicKeys: keys}
	for i := range descriptor.Members {
		request.Users = append(request.Users, multihoprelay.NodeChainUser{Position: i + 1, Username: strings.Repeat(fmt.Sprintf("%x", 3+i*2), 48), Password: strings.Repeat(fmt.Sprintf("%x", 4+i*2), 48)})
	}
	policy, err := mobilemultihop.NewNodeChainExecutionPolicy(desktopExecutionJSON(t, mobilemultihop.NodeChainExecutionSource{
		Schema: 1, Execution: execution, LocalSource: prep.LocalSource(), Server: descriptor, Request: request, FirstPort: 32000, LastPort: 32000}))
	if err != nil {
		t.Fatal(err)
	}
	projection, err := prep.BindExecution(policy)
	if err != nil {
		t.Fatal(err)
	}
	return prep, projection
}

type desktopExecutionProofFixture struct {
	lifetime context.Context
	progress mobilemultihop.NodeChainExecutionProgress
	closeErr error
	events   *[]string
}

func (p *desktopExecutionProofFixture) Run(ctx context.Context) error {
	p.lifetime = ctx
	*p.events = append(*p.events, "prove")
	return ctx.Err()
}
func (p *desktopExecutionProofFixture) HealthyContext(ctx context.Context) error {
	if p.lifetime == nil || p.lifetime.Err() != nil {
		return routerVPNExternalFailure
	}
	return ctx.Err()
}
func (p *desktopExecutionProofFixture) Progress() mobilemultihop.NodeChainExecutionProgress {
	return p.progress
}
func (p *desktopExecutionProofFixture) CloseContext(ctx context.Context) error {
	*p.events = append(*p.events, "join")
	if p.lifetime != nil && p.lifetime.Err() == nil {
		return errors.New("proof lifetime remained active during final close")
	}
	return errors.Join(ctx.Err(), p.closeErr)
}

type desktopExecutionEngineFixture struct {
	projection *mobilemultihop.NodeChainExecutionProjection
	identity   mobilemultihop.NodeChainIdentity
	readback   mobilemultihop.NodeChainExecutionTUNReadback
	current    func(context.Context) error
	events     *[]string
	retireErr  error
	read       func()
	observe    func()
}

func (e *desktopExecutionEngineFixture) DiscoverContext(ctx context.Context) (mobilemultihop.NodeChainExecutionDiscovery, error) {
	*e.events = append(*e.events, "discover")
	return mobilemultihop.NodeChainExecutionDiscovery{FirstPort: 32000, LastPort: 32000}, e.current(ctx)
}
func (e *desktopExecutionEngineFixture) AdoptContext(ctx context.Context, source string, port int) (*mobilemultihop.NodeChainExecutionProjection, error) {
	if source != "" || port != 32000 {
		return nil, routerVPNExternalFailure
	}
	*e.events = append(*e.events, "adopt")
	return e.projection, e.current(ctx)
}
func (e *desktopExecutionEngineFixture) ObserveChainContext(ctx context.Context) (mobilemultihop.NodeChainIdentity, error) {
	if e.observe != nil {
		e.observe()
	}
	return e.identity, e.current(ctx)
}
func (e *desktopExecutionEngineFixture) SelectedContext(ctx context.Context) (string, error) {
	p, _ := e.projection.ProofInventory("server")
	return p[len(p)-1].Tag, e.current(ctx)
}
func (e *desktopExecutionEngineFixture) SelectionEpochContext(ctx context.Context) (uint64, error) {
	return 7, e.current(ctx)
}
func (e *desktopExecutionEngineFixture) CaptureExecutionTUNReadbackContext(ctx context.Context, identity mobilemultihop.NodeChainIdentity) (mobilemultihop.NodeChainExecutionTUNReadback, error) {
	if e.read != nil {
		e.read()
	}
	if identity != e.identity {
		return mobilemultihop.NodeChainExecutionTUNReadback{}, routerVPNExternalFailure
	}
	return e.readback, e.current(ctx)
}
func (*desktopExecutionEngineFixture) ExecutionTUNReadbackRetiredContext(context.Context, mobilemultihop.NodeChainExecutionTUNReadback) error {
	return routerVPNExternalFailure
}
func (e *desktopExecutionEngineFixture) RetireContext(ctx context.Context) error {
	*e.events = append(*e.events, "retire")
	return errors.Join(ctx.Err(), e.retireErr)
}
func (*desktopExecutionEngineFixture) Dial(context.Context, string, string) (net.Conn, error) {
	return nil, errors.New("fixture cannot prove native prefix traffic")
}
func (*desktopExecutionEngineFixture) SelectContext(context.Context, string) error {
	return routerVPNExternalFailure
}
func (*desktopExecutionEngineFixture) DNSExecutionProofContext(context.Context, mobilemultihop.NodeChainExecutionDNSCapture) error {
