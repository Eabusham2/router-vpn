type desktopExecutionRuntimeFixture struct {
	owner  *routerVPNNodeChainExecutionRuntime
	engine *desktopExecutionEngineFixture
	proof  *desktopExecutionProofFixture
	record routerVPNNodeMTURecord
	valid  atomic.Bool
	events []string
}

func newDesktopExecutionRuntimeFixture(t *testing.T) *desktopExecutionRuntimeFixture {
	t.Helper()
	prep, projection := desktopExecutionCommandSource(t, "linux", "auto")
	physical, _ := prep.DesktopPhysicalPolicy()
	_, meta, _, _ := physical.PhysicalReadValidated()
	files := desktopImportedCommandFiles(t, map[string]string{"node-chain-execution-source.json": prep.Source(), "sing-box.json": prep.Config()})
	f := &desktopExecutionRuntimeFixture{}
	f.valid.Store(true)
	f.record = routerVPNNodeMTURecord{Schema: 1, Session: meta.SessionID, Config: prep.ConfigSHA256(), Path: strings.Repeat("c", 64), Reader: 1, Interface: "router-vpn", Index: 17, MTU: 1420}
	identity := mobilemultihop.NodeChainIdentity{EngineID: "original-box", SessionID: meta.SessionID, NetworkID: "original-network", SourceSHA256: projection.SourceSHA256(), ConfigSHA256: projection.ConfigSHA256()}
	plan, _ := projection.MTUPlan()
	f.engine = &desktopExecutionEngineFixture{projection: projection, identity: identity, events: &f.events,
		readback: mobilemultihop.NodeChainExecutionTUNReadback{Identity: identity, TargetOS: "linux", TUNTag: plan.TUNTag, ReaderNonce: strings.Repeat("e", 64), ReaderGeneration: 1, InterfaceName: f.record.Interface, InterfaceIndex: 17, MTU: 1420}}
	f.proof = &desktopExecutionProofFixture{events: &f.events}
	progress := mobilemultihop.NodeChainExecutionProgress{NodeChainProgress: mobilemultihop.NodeChainProgress{Stage: "selected", Execution: "server", Complete: true, Ready: true, DNSProven: true, PublicProven: true}}
	proofs, _ := projection.ProofInventory("server")
	for _, p := range proofs {
		progress.Prefixes = append(progress.Prefixes, mobilemultihop.NodeChainPrefixProgress{Position: p.Position, ProfileID: p.ProfileID, Proven: true, ResponseMS: 2})
	}
	candidate := routechoice.Candidate{Execution: routechoice.Server, Transport: "ordered-node-chain", EntryID: proofs[0].ProfileID, ExitID: proofs[len(proofs)-1].ProfileID}
	measured, err := routechoice.Score(candidate, 2*time.Millisecond, 4*time.Millisecond)
	if err != nil {
		t.Fatal(err)
	}
	progress.Comparison = routechoice.Result{Target: mobilemultihop.Targets[0], Winner: &candidate, Final: &measured, Measurements: []routechoice.Measurement{measured}}
	f.proof.progress = progress
	f.owner, err = routerVPNNewNodeChainExecutionRuntimeFactory(context.Background(), files, prep, strings.Repeat("d", 64), func(ctx context.Context) error {
		if !f.valid.Load() {
			return routerVPNExternalFailure
		}
		return ctx.Err()
	},
		func(ctx context.Context, p *mobilemultihop.NodeChainExecutionPreparation, session string, current func(context.Context) error) (routerVPNDesktopExecutionEngine, error) {
			if p != prep || session != meta.SessionID {
				t.Fatal("factory changed original typed preparation")
			}
			f.engine.current = current
			return f.engine, ctx.Err()
		}, func(p *mobilemultihop.NodeChainExecutionProjection, e routerVPNDesktopExecutionEngine) (routerVPNDesktopExecutionProof, error) {
			if p != f.engine.projection || e != f.engine {
				t.Fatal("proof changed retained native projection")
			}
			return f.proof, nil
		})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		f.proof.closeErr = nil
		f.engine.retireErr = nil
		ctx, stop := context.WithTimeout(context.Background(), time.Second)
		defer stop()
		if err := f.owner.close(ctx); err != nil {
			t.Error(err)
		}
	})
	return f
}

func TestRouterVPNDesktopNodeChainExecutionRuntimeKeepsActualProjection(t *testing.T) {
	f := newDesktopExecutionRuntimeFixture(t)
	ctx, cancel := context.WithCancel(context.Background())
	if err := f.owner.run(ctx); err != nil {
		t.Fatal(err)
	}
	cancel()
	if err := f.owner.current(context.Background()); err != nil || f.proof.lifetime.Err() != nil {
		t.Fatal("startup context became runtime lifetime", err)
	}
	if !reflect.DeepEqual(f.events, []string{"discover", "adopt", "prove"}) {
		t.Fatal(f.events)
	}
	adoption, err := f.owner.files.read("node-chain-execution-adoption.json", mobilemultihop.DesktopNodeChainExecutionAdoptionRecordLimit)
	if err != nil {
		t.Fatal("child did not publish original adoption before readiness", err)
	}
	parent, err := mobilemultihop.ParseDesktopNodeChainExecutionPreparation(f.owner.prep.Source())
	if err != nil {
		t.Fatal(err)
	}
	projection, identity, err := mobilemultihop.ParseDesktopNodeChainExecutionAdoptionRecord(adoption, parent, f.owner.transfer)
	if err != nil || identity != f.engine.identity || projection.Config() != f.engine.projection.Config() {
		t.Fatal("parent lost original execution projection", err)
	}
	if err := f.owner.heartbeat(context.Background(), f.record); err != nil {
		t.Fatal(err)
	}
	raw, err := f.owner.files.read("node-chain-execution-ready.json", mobilemultihop.DesktopNodeChainExecutionReadyRecordLimit)
	if err != nil {
		t.Fatal(err)
	}
	ready, err := mobilemultihop.ParseDesktopNodeChainExecutionAdoptedReadyRecord(raw, projection, identity, f.owner.transfer)
	if err != nil || ready.Identity.ConfigSHA256 == ready.PreparationConfigSHA256 || ready.Identity != f.engine.identity || ready.SelectionEpoch != 7 {
		t.Fatal("heartbeat relabeled preparation as executed graph", err)
	}
	if err := f.owner.close(context.Background()); err != nil || !f.owner.closed.Load() {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(f.events, []string{"discover", "adopt", "prove", "join", "retire"}) {
		t.Fatal("remote join must precede native gate retirement", f.events)
	}
	if _, err := f.owner.files.root.Lstat("node-chain-execution-ready.json"); !errors.Is(err, os.ErrNotExist) {
		t.Fatal("closed owner retained readiness", err)
	}
	if _, err := f.owner.files.root.Lstat("node-chain-execution-adoption.json"); !errors.Is(err, os.ErrNotExist) {
		t.Fatal("closed owner retained adoption receipt", err)
	}
	if f.owner.run(context.Background()) == nil {
		t.Fatal("closed child restarted")
	}
}

func TestRouterVPNDesktopNodeChainExecutionRuntimeRetainsFailedCleanup(t *testing.T) {
	for _, fault := range []string{"remote-join", "gate-retire"} {
		t.Run(fault, func(t *testing.T) {
			f := newDesktopExecutionRuntimeFixture(t)
			if err := f.owner.run(context.Background()); err != nil {
				t.Fatal(err)
			}
			if fault == "remote-join" {
				f.proof.closeErr = errors.New("pending original DELETE")
			} else {
				f.engine.retireErr = errors.New("pending original gate")
			}
			if f.owner.close(context.Background()) == nil || f.owner.closed.Load() {
				t.Fatal("unjoined owner allowed native teardown")
			}
			if fault == "remote-join" && strings.Contains(strings.Join(f.events, ","), "retire") {
				t.Fatal("native gate retired before remote join", f.events)
			}
			f.proof.closeErr = nil
			f.engine.retireErr = nil
			if err := f.owner.close(context.Background()); err != nil || !f.owner.closed.Load() {
				t.Fatal("original cleanup retry failed", err)
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainExecutionRuntimeRejectsReplacedOwners(t *testing.T) {
	for _, fault := range []string{"foreign-projection", "preparation-identity", "host", "readback", "late-readback"} {
		t.Run(fault, func(t *testing.T) {
			f := newDesktopExecutionRuntimeFixture(t)
			if fault == "foreign-projection" {
				_, f.engine.projection = desktopExecutionCommandSource(t, "linux", "auto")
				f.engine.identity.SourceSHA256 = f.engine.projection.SourceSHA256()
				f.engine.identity.ConfigSHA256 = f.engine.projection.ConfigSHA256()
				f.engine.readback.Identity = f.engine.identity
			}
			if fault == "preparation-identity" {
				f.engine.identity.ConfigSHA256 = f.owner.prep.ConfigSHA256()
			}
			err := f.owner.run(context.Background())
			if fault == "foreign-projection" || fault == "preparation-identity" {
				if err == nil {
					t.Fatal("foreign execution owner admitted")
				}
				if _, err := f.owner.files.root.Lstat("node-chain-execution-adoption.json"); !errors.Is(err, os.ErrNotExist) {
					t.Fatal("failed original owner published adoption", err)
				}
				return
			}
			if err != nil {
				t.Fatal(err)
			}
			switch fault {
			case "host":
				f.valid.Store(false)
				if f.owner.current(context.Background()) == nil || f.proof.lifetime.Err() == nil {
					t.Fatal("replacement host kept original lifetime alive")
				}
			case "readback":
				f.engine.readback.MTU--
			case "late-readback":
				calls := 0
				f.engine.read = func() {
					calls++
					if calls == 2 {
						f.engine.readback.MTU--
					}
				}
			}
			if f.owner.heartbeat(context.Background(), f.record) == nil {
				t.Fatal("replaced owner published ready")
			}
			if _, err := f.owner.files.root.Lstat("node-chain-execution-ready.json"); !errors.Is(err, os.ErrNotExist) {
				t.Fatal("late owner retained heartbeat", err)
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainExecutionRuntimeJoinsLateConstructor(t *testing.T) {
	f := newDesktopExecutionRuntimeFixture(t)
	original := f.owner.factory
	entered, release := make(chan struct{}), make(chan struct{})
	f.owner.factory = func(ctx context.Context, p *mobilemultihop.NodeChainExecutionPreparation, s string, current func(context.Context) error) (routerVPNDesktopExecutionEngine, error) {
		close(entered)
		<-release
		engine, _ := original(context.Background(), p, s, current)
		return engine, errors.New("late native constructor")
	}
	done := make(chan error, 1)
	go func() { done <- f.owner.run(context.Background()) }()
	<-entered
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	if f.owner.close(ctx) == nil || f.owner.closed.Load() {
		t.Fatal("canceled cleanup abandoned entered native factory")
	}
	close(release)
	if err := <-done; err == nil {
		t.Fatal("late constructor succeeded")
	}
	if f.owner.state.Load().engine.Load() == nil {
		t.Fatal("partial native owner discarded")
	}
	if _, err := f.owner.files.root.Lstat("node-chain-execution-adoption.json"); !errors.Is(err, os.ErrNotExist) {
		t.Fatal("late canceled constructor published adoption", err)
	}
	if err := f.owner.close(context.Background()); err != nil || !reflect.DeepEqual(f.events, []string{"retire"}) {
		t.Fatal("original late engine was not retired", err, f.events)
	}
}

func TestRouterVPNDesktopNodeChainExecutionAdoptionRevokesLatePublication(t *testing.T) {
	f := newDesktopExecutionRuntimeFixture(t)
	published := false
	f.engine.observe = func() {
		if _, err := f.owner.files.root.Lstat("node-chain-execution-adoption.json"); err == nil {
			published = true
			f.valid.Store(false)
		}
	}
	if err := f.owner.run(context.Background()); err == nil || !published {
		t.Fatal("original host was not revoked across adoption publication", err)
	}
	if _, err := f.owner.files.root.Lstat("node-chain-execution-adoption.json"); !errors.Is(err, os.ErrNotExist) {
		t.Fatal("late publication survived original owner revocation", err)
	}
	if err := f.owner.close(context.Background()); err != nil || !f.owner.closed.Load() {
		t.Fatal("failed adoption did not join original owned runtime", err)
	}
}
