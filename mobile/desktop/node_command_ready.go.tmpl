package main

import (
	"context"
	"time"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

type routerVPNNodeDNSOwner interface {
	Current() bool
	ClaimTUN(func() bool) (string, int, int, error)
	MeasureSelectedDNS(context.Context) (time.Duration, error)
}

type routerVPNNodeCoverOwner interface {
	Current() bool
	Readiness() (int, string, error)
}

// Ready is published only after an actual fresh native DNS query and an exact
// TUN readback. The private record is bound to the same source and predecessor
// as the handoff; the controller still owes its authenticated selected-node
// proof before it can report Connected.
func routerVPNProveNodeReady(ctx context.Context, files *routerVPNExternalFiles, policy mobilemultihop.DesktopPhysicalPolicy,
	expected *mobiletor.DesktopProtectionTransferRecord, owner routerVPNNodeDNSOwner) error {
	if ctx == nil || ctx.Err() != nil || files == nil || files.root == nil || policy == nil || policy.Validate() != nil ||
		expected == nil || expected.Validate() != nil || owner == nil || !owner.Current() {
		return routerVPNExternalFailure
	}
	_, meta, _, readErr := mobilemultihop.ReadDesktopPhysicalPolicy(policy)
	if readErr != nil {
		return routerVPNExternalFailure
	}
	if expected.SessionID != meta.SessionID || expected.SourceSHA256 != meta.SourceSHA256 ||
		expected.ConfigSHA256 != meta.ConfigSHA256 || expected.Policy != meta.KillSwitchPolicy ||
		files.stopRequested(meta.SessionID, meta.ConfigSHA256) || !files.current("node-ready.json") {
		return routerVPNExternalFailure
	}
	transfer, err := mobiletor.DesktopProtectionTransferRecordSHA256(*expected)
	if err != nil {
		return routerVPNExternalFailure
	}
	return routerVPNProveNodeReadyCaptured(ctx, files, policy, transfer, owner)
}

// The platform coordinator supplies its independently authenticated selection
// digest. This shared probe owns no admission or predecessor capability; it
// performs the same real selected resolver exchange and native TUN readback.
func routerVPNProveNodeReadyCaptured(ctx context.Context, files *routerVPNExternalFiles, policy mobilemultihop.DesktopPhysicalPolicy,
	transfer string, owner routerVPNNodeDNSOwner) error {
	return routerVPNProveNodeReadyCapturedCover(ctx, files, policy, transfer, owner, nil)
}

func routerVPNProveNodeReadyCapturedCover(ctx context.Context, files *routerVPNExternalFiles, policy mobilemultihop.DesktopPhysicalPolicy,
	transfer string, owner routerVPNNodeDNSOwner, cover routerVPNNodeCoverOwner) error {
	if ctx == nil || ctx.Err() != nil || files == nil || files.root == nil || policy == nil || policy.Validate() != nil ||
		!routerVPNExternalSource.MatchString(transfer) || owner == nil || !owner.Current() {
		return routerVPNExternalFailure
	}
	_, meta, capture, readErr := mobilemultihop.ReadDesktopPhysicalPolicy(policy)
	if readErr != nil {
		return routerVPNExternalFailure
	}
	if files.stopRequested(meta.SessionID, meta.ConfigSHA256) || !files.current("node-ready.json") {
		return routerVPNExternalFailure
	}
	elapsed, err := owner.MeasureSelectedDNS(ctx)
	if err != nil || elapsed <= 0 {
		return routerVPNExternalFailure
	}
	name, index, mtu, err := owner.ClaimTUN(owner.Current)
	if err != nil || index < 1 || uint64(index) > uint64(^uint32(0)) || ctx.Err() != nil || !owner.Current() || files.stopRequested(meta.SessionID, meta.ConfigSHA256) {
		return routerVPNExternalFailure
	}
	record := mobilemultihop.DesktopNodeReadyRecord{Schema: 1, Kind: "routervpn-node-ready-v1", SessionID: meta.SessionID,
		SourceSHA256: meta.SourceSHA256, ConfigSHA256: meta.ConfigSHA256, TransferSHA256: transfer,
		DNSConfigSHA256: capture.SelectedDNS.ConfigSHA256, InterfaceName: name, InterfaceIndex: uint32(index), MTU: mtu, ProvedAt: time.Now().UnixMilli(),
		DNSMilliseconds: float64(elapsed.Nanoseconds()) / 1e6}
	if cover != nil {
		record.CoverServices, record.CoverSHA256, err = cover.Readiness()
		if err != nil {
			return routerVPNExternalFailure
		}
	}
	if record.Validate(policy, transfer) != nil || files.publish("node-ready.json", record) != nil || ctx.Err() != nil || !owner.Current() || cover != nil && !cover.Current() {
		return routerVPNExternalFailure
	}
	return nil
}
