//go:build linux

package routervpndesktoppt

import (
	"context"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// No returned source is distinct from native absence. This comparison keeps
// even a cancelled or partial source with its exact sealed Router policy; the
// parent still supplies the independent baseline observation and journal.
func (n *NodeNetworkOwner) JoinedLinuxPhysicalSource(ctx context.Context, policy mobilemultihop.DesktopPhysicalPolicy) (*mobiletor.DesktopLinuxSourceJoinRecord, bool, error) {
	return joinedLinuxPhysicalSource(ctx, n, linuxPhysicalPolicy{node: policy})
}
