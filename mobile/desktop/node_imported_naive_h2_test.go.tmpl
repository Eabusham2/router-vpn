	}
	f.first = desktopImportedNaiveH2Entry(t, owned, firstRaw)
	f.manager.owners["entry-wg"] = f.first
	if openvpnPeer != nil {
		f.openvpn = f.first.(*OV.ClientEndpoint)
	}
	// Packet endpoint startup may immediately launch receive workers whose
	// detours read this same manager. Complete its immutable catalog first.
	if lastLayer != "off" {
		f.manager.owners[mobilemultihop.NativeStartLayerTag] = desktopImportedSOCKSNativeLayer(t, owned, byTag[mobilemultihop.NativeStartLayerTag])
	}
	f.dnsManager = &desktopImportedNaiveH2DNSManager{owners: make(map[string]adapter.DNSTransport)}
	owned = service.ContextWith[adapter.DNSTransportManager](owned, f.dnsManager)
	f.dnsRouter = &desktopImportedNaiveH2DNSRouter{manager: f.dnsManager}
	owned = service.ContextWith[adapter.DNSRouter](owned, f.dnsRouter)
	f.bootstrap = desktopImportedNaiveH2Transport(t, owned, f.bootstrapRaw)
	f.dnsManager.owners[f.bootstrap.Tag()] = f.bootstrap
	if lifecycle, ok := f.first.(adapter.Lifecycle); ok {
		for _, stage := range []adapter.StartStage{adapter.StartStateInitialize, adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
			if err := lifecycle.Start(stage); err != nil {
				f.startErr = err
				return f
			}
		}
	} else if kind == "wireguard" || kind == "amneziawg" || strings.HasPrefix(kind, "openvpn-") {
		t.Fatal("captured packet entry lost its mandatory native lifecycle")
	}
	finalCtx, cancelFinal := context.WithCancel(owned)
	f.owned, f.cancelFinal = finalCtx, cancelFinal
	if json.Unmarshal([]byte(desktopImportedSOCKSXrayJSON(t, finalRaw)), &f.finalOptions) != nil {
		t.Fatal("imported Naive H2 lost exact native final options")
	}
	var err error
	f.final, err = NV.NewOutbound(finalCtx, nil, log.NewNOPFactory().Logger(), mobilemultihop.LocalTag, f.finalOptions)
	if err != nil {
		t.Fatal(err)
	}
	if err := f.final.(adapter.Lifecycle).Start(adapter.StartStateStart); err != nil {
		t.Fatal("imported Naive H2 native final did not start", err)
	}
	selectedContext := service.ContextWith[adapter.OutboundManager](owned, &desktopImportedNaiveH2SelectedManager{desktopImportedSOCKSXrayManager: f.manager, final: f.final})
	f.selectedTransport = desktopImportedNaiveH2Transport(t, selectedContext, f.selected)
	return f
}

// The two receivers accept different questions. Merely reaching a TCP DNS
// listener cannot satisfy the other lane, even when both captured tuples match.
func desktopImportedNaiveH2DNSPeer(t *testing.T, question string, hits *atomic.Int64) string {
	t.Helper()
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	server := &dns.Server{Listener: listener, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
		answer := new(dns.Msg).SetReply(q)
		if len(q.Question) != 1 || q.Question[0].Name != question || q.Question[0].Qtype != dns.TypeA || q.Question[0].Qclass != dns.ClassINET {
			answer.Rcode = dns.RcodeRefused
		} else {
			hits.Add(1)
			answer.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: question, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 1}, A: net.IPv4(203, 0, 113, 77)}}
		}
		_ = w.WriteMsg(answer)
	})}
	ready, joined := make(chan struct{}), make(chan error, 1)
	server.NotifyStartedFunc = func() { close(ready) }
	go func() { joined <- server.ActivateAndServe() }()
	select {
	case <-ready:
	case err := <-joined:
		t.Fatal(err)
	case <-time.After(time.Second):
		t.Fatal("captured H2 TCP DNS did not start")
	}
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
		defer cancel()
		if err := server.ShutdownContext(ctx); err != nil {
			t.Error("captured H2 TCP DNS did not retire", err)
		}
		_ = listener.Close()
		select {
		case <-joined:
		case <-ctx.Done():
			t.Error("captured H2 TCP DNS did not join")
		}
	})
	return listener.Addr().String()
}

// All route owners are installed before the Naive server starts accepting.
// DNS uses the captured TCP tuple; authenticated application UDP still goes
// through the native UoT handler to the existing exact echo destination.
type desktopImportedNaiveH2Routes struct {
	server     *desktopNodeLayerServer
	dnsAddress string
	refuse     bool
}

func (r *desktopImportedNaiveH2Routes) RouteConnection(ctx context.Context, c net.Conn, m adapter.InboundContext) error {
	if m.Destination.String() == "192.168.50.133:53" {
		if r.refuse {
			return errors.New("original final refused its captured selected DNS route")
		}
		// Route through a separate immutable server view, sharing the original
		// lifecycle via an explicit forwarding helper rather than copying its mutex.
		return desktopImportedNaiveH2Forward(r.server, c, r.dnsAddress)
	}
	return r.server.plainConnection(ctx, c, M.Metadata{Source: m.Source, Destination: m.Destination})
}
func (r *desktopImportedNaiveH2Routes) RouteConnectionEx(ctx context.Context, c net.Conn, m adapter.InboundContext, done N.CloseHandlerFunc) {
	err := r.RouteConnection(ctx, c, m)
	if done != nil {
		done(err)
	}
}
func (r *desktopImportedNaiveH2Routes) RoutePacketConnection(ctx context.Context, c N.PacketConn, m adapter.InboundContext) error {
	return r.server.NewPacketConnection(ctx, c, M.Metadata{Source: m.Source, Destination: m.Destination})
}
func (r *desktopImportedNaiveH2Routes) RoutePacketConnectionEx(ctx context.Context, c N.PacketConn, m adapter.InboundContext, done N.CloseHandlerFunc) {
	err := r.RoutePacketConnection(ctx, c, m)
	if done != nil {
		done(err)
	}
}
func desktopImportedNaiveH2Forward(s *desktopNodeLayerServer, connection net.Conn, address string) error {
	peer, err := (&net.Dialer{}).DialContext(s.ctx, "tcp", address)
	if err != nil {
		return err
	}
	if !s.enter(peer) {
		_ = peer.Close()
		return net.ErrClosed
	}
	defer s.leave(peer)
	s.plainTCP.Add(1)
	interrupt := func() { _ = peer.Close(); _ = connection.SetDeadline(time.Now()) }
	retired := make(chan struct{})
	stop := context.AfterFunc(s.ctx, func() { defer close(retired); interrupt() })
	joined := make(chan struct{})
	go func() { defer close(joined); _, _ = io.Copy(peer, connection); interrupt() }()
	_, err = io.Copy(connection, peer)
	interrupt()
	<-joined
	if !stop() {
		<-retired
	}
	_ = connection.Close()
	return err
}

