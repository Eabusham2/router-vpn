// The positive and lifetime inventory covers every original wire and both
// independent layer axes. Family-specific refusal controls retain their exact
// authenticated reference peer; none is counted as a replacement positive.
func desktopImportedNaiveH2Faults(kind, first, last string) []string {
	faults := []string{"success", "cancel", "close-owner", "replacement-owner"}
	if first == "off" && last == "off" {
		faults = append(faults, "entry-route", "wrong-entry-ip", "final-password", "final-user", "final-server-name", "final-certificate", "final-route", "bootstrap-route", "dns-route", "final-identity", "final-token")
		switch kind {
		case "wireguard", "amneziawg":
			faults = append(faults, "entry-private-key", "entry-public-key", "entry-psk")
			if kind == "amneziawg" {
				faults = append(faults, "entry-awg-parameter")
			}
		default:
			faults = append(faults, "entry-auth")
		}
		if kind == "hysteria2" || kind == "https-connect" {
			faults = append(faults, "entry-sni", "entry-trust")
		}
	}
	if first != "off" {
		faults = append(faults, "entry-layer-key")
	}
	if first == "aes-256-gcm+xor-whitening" {
		faults = append(faults, "entry-layer-whitening")
	}
	if last != "off" {
		faults = append(faults, "final-layer-key", "bootstrap-route")
	}
	if last == "aes-256-gcm+xor-whitening" {
		faults = append(faults, "final-layer-whitening")
	}
	return faults
}
func desktopImportedNaiveH2Cases(t *testing.T, kinds []string) {
	t.Helper()
	desktopNodeNaiveLibrary(t)
	for _, kind := range kinds {
		for _, first := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, last := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				for _, fault := range desktopImportedNaiveH2Faults(kind, first, last) {
					t.Run(kind+"/"+first+"/"+last+"/"+fault, func(t *testing.T) { desktopImportedNaiveH2Traffic(t, kind, first, last, fault) })
				}
			}
		}
	}
}
