	adapter.DNSRouter
	manager *desktopImportedNaiveH2DNSManager
	calls   atomic.Int64
}

func (r *desktopImportedNaiveH2DNSRouter) Exchange(ctx context.Context, q *dns.Msg, o adapter.DNSQueryOptions) (*dns.Msg, error) {
	r.calls.Add(1)
	original := r.manager.owners["routervpn-predecessor-bootstrap-0"]
	if original == nil || o.Transport != original {
		return nil, errors.New("H2 attempted uncaptured DNS owner")
	}
	return original.Exchange(ctx, q)
}
func (r *desktopImportedNaiveH2DNSRouter) Lookup(ctx context.Context, name string, o adapter.DNSQueryOptions) ([]netip.Addr, error) {
	q := new(dns.Msg)
	q.SetQuestion(dns.Fqdn(name), dns.TypeA)
	reply, err := r.Exchange(ctx, q, o)
	if err != nil {
		return nil, err
	}
	var result []netip.Addr
	for _, answer := range reply.Answer {
		if a, ok := answer.(*dns.A); ok {
			if ip, ok := netip.AddrFromSlice(a.A); ok {
				result = append(result, ip.Unmap())
			}
		}
	}
	if len(result) == 0 {
		return nil, errors.New("captured H2 bootstrap returned no original address")
	}
	return result, nil
}
