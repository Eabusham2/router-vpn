// These are userspace protocol/proof witnesses using the original captured
// source and a mandatory real physical-interface inventory. They never mark
// the compiler plan healthy or substitute for a system-TUN/device result.
type desktopImportedNaiveH2Fixture struct {
	*desktopPacketRealityFixture
	finalOptions                 option.NaiveOutboundOptions
	bootstrapRaw                 []byte
	bootstrap, selectedTransport adapter.DNSTransport
	bootstrapPeer, selectedPeer  string
	bootstrapHits                atomic.Int64
	dnsManager                   *desktopImportedNaiveH2DNSManager
	dnsRouter                    *desktopImportedNaiveH2DNSRouter
	finalCloseOnce               sync.Once
	finalCloseErr                error
	bootstrapDenied              atomic.Int64
}

func (f *desktopImportedNaiveH2Fixture) closeFinal() error {
	f.finalCloseOnce.Do(func() {
		if f.final != nil {
			f.finalCloseErr = f.final.(io.Closer).Close()
		}
	})
	return f.finalCloseErr
}
func (f *desktopImportedNaiveH2Fixture) close() error {
	f.closeOnce.Do(func() {
		if f.ingress != nil {
			f.ingress.retiring.Store(true)
		}
		if f.selectedTransport != nil {
			f.closeErr = errors.Join(f.closeErr, f.selectedTransport.Close())
		}
		if f.bootstrap != nil {
			f.closeErr = errors.Join(f.closeErr, f.bootstrap.Close())
		}
		f.closeErr = errors.Join(f.closeErr, f.closeFinal())
		if f.first != nil {
			if closer, ok := f.first.(io.Closer); ok {
				f.closeErr = errors.Join(f.closeErr, closer.Close())
			} else if f.kind != "socks5" && f.kind != "http-connect" && f.kind != "https-connect" {
				f.closeErr = errors.Join(f.closeErr, errors.New("captured H2 entry lost its native close contract"))
			}
		}
		if f.manager != nil {
			for tag, owner := range f.manager.owners {
				if tag != "entry-wg" && tag != f.lower.Tag() {
					if closer, ok := owner.(io.Closer); ok {
						f.closeErr = errors.Join(f.closeErr, closer.Close())
					}
				}
			}
		}
		if f.lower != nil {
			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
			defer cancel()
			f.closeErr = errors.Join(f.closeErr, f.lower.empty(ctx))
		}
		if f.cancelFinal != nil {
			f.cancelFinal()
		}
	})
	return f.closeErr
}

func desktopImportedNaiveH2Source(t *testing.T, kind, first, last string) []string {
	t.Helper()
	directory := os.Getenv("ROUTERVPN_IMPORTED_NAIVE_H2_FIXTURES")
	if directory == "" {
		t.Fatal("required imported H2 original source inventory absent")
	}
	path := filepath.Join(directory, kind+"--naive-h2--"+first+"--"+last+".json")
	info, err := os.Lstat(path)
	if err != nil || !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > 1<<20 {
		t.Fatal("Naive H2 source is not an original bounded regular file", err)
	}
	raw, err := os.ReadFile(path)
	var source []string
	if err != nil || json.Unmarshal(raw, &source) != nil || len(source) != 9 || source[2] != "naive-h2" {
		t.Fatal("Naive H2 original source receipt changed", err)
	}
	plan, err := mobilemultihop.NewImportedEntry(source[0], source[1], source[2], source[3], source[4], source[5], source[6])
	if err != nil {
		t.Fatal("original Naive H2 source failed exact compilation", err)
	}
	defer plan.Close()
	if plan.SourceSHA256() != source[7] || plan.Config() != source[8] || plan.Healthy() {
		t.Fatal("Naive H2 original source identity changed or claimed live proof")
	}
	var metadata mobilemultihop.Metadata
	normalize := func(mode string) string {
		if mode == "" {
			return "off"
		}
		return mode
	}
	protocol := kind
	if strings.HasPrefix(kind, "openvpn-") {
		protocol = "openvpn"
	}
	if json.Unmarshal([]byte(plan.Metadata()), &metadata) != nil || metadata.EntryMode != protocol || normalize(metadata.EntryStartLayer) != first || normalize(metadata.ExitStartLayer) != last {
		t.Fatal("Naive H2 source name substituted another captured entry or layer")
	}
	if protocol == "openvpn" {
		graph := desktopImportedSOCKSXrayObject(t, plan.Config())
		matched := false
		for _, raw := range graph["endpoints"].([]any) {
			row := raw.(map[string]any)
			if row["tag"] == "entry-wg" && row["network"] == strings.TrimPrefix(kind, "openvpn-") {
				matched = true
			}
		}
		if !matched {
			t.Fatal("Naive H2 source name substituted original OpenVPN wire transport")
		}
	}
	return source
}

func desktopImportedNaiveH2Compile(t *testing.T, args []string) *mobilemultihop.Controller {
	t.Helper()
	plan, err := mobilemultihop.NewImportedEntry(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
	if err != nil {
		t.Fatal("captured native imported Naive H2 source did not compile", err)
	}
	t.Cleanup(func() {
		if err := plan.Close(); err != nil {
			t.Error("captured packet plan did not close", err)
		}
	})
	return plan
}

