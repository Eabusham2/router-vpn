package box

import (
	"context"
	"errors"

	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

// The execution engine independently observes the actual TUN and its selector
// epoch. Its lifetime callback observes the original physical generation only:
// the same callback must remain usable while the existing physical owner has
// deliberately detached its old TUN grant during an authorized replacement.
func (owner *RouterVPNDesktopNodePhysical) NodeChainExecutionSourceCurrentContext(ctx context.Context, preparation *mobilemultihop.NodeChainExecutionPreparation) error {
	if owner == nil || owner.instance == nil || preparation == nil {
		return errRouterVPNExecutionOwner
	}
	policy, err := preparation.DesktopPhysicalPolicy()
	if err != nil || policy == nil || owner.policy != policy {
		return errors.Join(err, errRouterVPNExecutionOwner)
	}
	return owner.generationCurrentContext(ctx)
}

// Retain the existing physical permission transaction around the exact native
// execution manager transaction. A same-identity wrapper, foreign Box or another
// sealed physical policy cannot borrow this original pause/reader authority.
func (owner *RouterVPNDesktopNodePhysical) ChangeNodeChainExecutionMTUContext(ctx context.Context, engine *RouterVPNNodeChainExecutionEngine,
	binding mobilemultihop.NodeChainExecutionMTUResumeBinding, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
	if owner == nil || engine == nil || owner.instance == nil || engine.instance != owner.instance || !binding.OwnsEngine(engine) ||
		owner.NodeChainExecutionSourceCurrentContext(ctx, engine.prep) != nil {
		return expected, errRouterVPNExecutionOwner
	}
	return owner.changeMTU(ctx, expected, mtu, func(call context.Context, reader adapter.Inbound, value int) (adapter.Inbound, error) {
		return engine.ChangeExecutionMTUContext(call, binding, reader, value)
	})
}

// An unchanged pause retains its existing physical grant. No TUN permission
// is detached and no native mutation is requested to make a saved value fit.
func (owner *RouterVPNDesktopNodePhysical) RetainUnchangedNodeChainExecutionMTUContext(ctx context.Context, engine *RouterVPNNodeChainExecutionEngine,
	binding mobilemultihop.NodeChainExecutionMTUResumeBinding, expected adapter.Inbound, mtu int) error {
	if owner == nil || engine == nil || owner.instance == nil || engine.instance != owner.instance || expected == nil ||
		!binding.OwnsEngine(engine) || owner.NodeChainExecutionSourceCurrentContext(ctx, engine.prep) != nil {
		return errRouterVPNExecutionOwner
	}
	if err := adapter.RouterVPNLockContext(ctx, &owner.mu); err != nil {
		return err
	}
	defer owner.mu.Unlock()
	name, index, actual, err := owner.readbackContext(ctx)
	if err != nil || owner.inbound != expected || actual != mtu {
		return errors.Join(err, errRouterVPNExecutionOwner)
	}
	if err := engine.RetainUnchangedExecutionMTUContext(ctx, binding, expected, mtu); err != nil {
		return err
	}
	afterName, afterIndex, afterMTU, err := owner.readbackContext(ctx)
	if err != nil || owner.inbound != expected || name != afterName || index != afterIndex || actual != afterMTU {
		return errors.Join(err, errRouterVPNExecutionOwner)
	}
	return ctx.Err()
}
