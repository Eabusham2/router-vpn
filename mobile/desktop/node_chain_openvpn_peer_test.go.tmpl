// This encrypted composition fixture executes the original compiler and Run
// controller against actual WG/AWG, OpenVPN and SS2022 owners. Its outer
// engine/session identity is a declared component boundary, not a Box, kernel
// TUN, firewall or installed-host observation. Only the original first UDP
// tuple maps to loopback; the OpenVPN provider is reachable through that prefix.
type nodeChainOpenVPNFixture struct {
	chain       *mobilemultihop.NodeChain
	peer        *desktopNodeChainImportedPeer
	complete    *desktopNodeChainPeer
	provider    desktopExternalInstalledOpenVPNPeer
	request     desktopNodeChainPeerRequest
	ctx         context.Context
	cancel      context.CancelFunc
	engine      *nodeChainOpenVPNComponent
	closeNative func() error
	closed      bool
	testTLS     *tls.Config
	measuring   atomic.Bool
	acquired    atomic.Int32
	released    atomic.Int32
}

type nodeChainOpenVPNComponent struct {
	chain    *mobilemultihop.NodeChain
	identity mobilemultihop.NodeChainIdentity
	owners   map[string]adapter.Outbound
	endpoint *OV.ClientEndpoint
	resolver adapter.DNSTransport
	closed   atomic.Bool
	mu       sync.Mutex
	selected string
}

// The one captured OpenVPN TCP transport is a persistent encrypted stream.
// Use the existing reciprocal forwarder for that exact original destination;
// all other reference flows retain their ordinary handler and deadlines.
type nodeChainOpenVPNPrefix struct {
	*desktopNodeWGHandler
	remote M.Socksaddr
}

func (h *nodeChainOpenVPNPrefix) NewConnectionEx(ctx context.Context, c net.Conn, source, destination M.Socksaddr, done N.CloseHandlerFunc) {
	if destination != h.remote {
		h.desktopNodeWGHandler.NewConnectionEx(ctx, c, source, destination, done)
		return
	}
	if _, ok := h.rule("tcp", destination); ok {
		h.tcp.Add(1)
	}
	h.desktopReferenceHandler.newReciprocalConnectionEx(ctx, c, source, destination, done)
}

var _ mobilemultihop.NodeChainEngine = (*nodeChainOpenVPNComponent)(nil)
var _ mobilemultihop.NodeChainOpenVPNEngine = (*nodeChainOpenVPNComponent)(nil)

func (e *nodeChainOpenVPNComponent) ObserveChainContext(ctx context.Context) (mobilemultihop.NodeChainIdentity, error) {
	if ctx == nil || ctx.Err() != nil || e.closed.Load() {
		return mobilemultihop.NodeChainIdentity{}, errors.New("original component owner retired")
	}
	return e.identity, nil
}
func (e *nodeChainOpenVPNComponent) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return nil, err
	}
	out := e.owners[tag]
	if out == nil {
		return nil, errors.New("foreign ordered component prefix")
	}
	if tag == e.chain.PrefixTags()[len(e.chain.PrefixTags())-2] && address == hopmeasure.PublicAddress {
		// The isolated provider's captured benchmark address is a component
		// resolution boundary. The following TCP/TLS/payload still traverses
		// the actual encrypted first and middle owners; no ambient dial runs.
		address = "93.184.216.34:443"
	}
	return out.DialContext(ctx, "tcp", M.ParseSocksaddr(address))
}
func (e *nodeChainOpenVPNComponent) SelectContext(ctx context.Context, tag string) error {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return err
	}
	if tag != e.chain.FinalTag() {
		return errors.New("foreign selected final")
	}
	e.mu.Lock()
	defer e.mu.Unlock()
	e.selected = tag
	return nil
}
func (e *nodeChainOpenVPNComponent) SelectedContext(ctx context.Context) (string, error) {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return "", err
	}
	e.mu.Lock()
	defer e.mu.Unlock()
	return e.selected, nil
}
func (e *nodeChainOpenVPNComponent) DNSProofContext(ctx context.Context, capture mobilemultihop.NodeChainDNSCapture) error {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return err
	}
	if capture != e.chain.DNSCapture() || e.resolver == nil {
		return errors.New("foreign original resolver")
	}
	q := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
	r, err := e.resolver.Exchange(ctx, q)
	if err != nil {
		return err
	}
	if r == nil || r.Id != q.Id || r.Rcode != dns.RcodeSuccess || len(r.Answer) != 1 {
		return errors.New("selected final DNS did not answer")
	}
	a, ok := r.Answer[0].(*dns.A)
	if !ok || a.Hdr.Name != "example.com." || !a.A.Equal(net.ParseIP("93.184.216.34")) {
		return errors.New("selected final DNS answer changed")
	}
	return ctx.Err()
}
func (e *nodeChainOpenVPNComponent) OpenVPNMiddleStateContext(ctx context.Context, tag string) (nativeopenvpn.PacketObservation, error) {
	if _, err := e.ObserveChainContext(ctx); err != nil {
		return nativeopenvpn.PacketObservation{}, err
	}
	capture, err := e.chain.OpenVPNMiddleCapture()
	if err != nil || tag != capture.Tag || e.endpoint == nil || e.owners[tag] != e.endpoint {
		return nativeopenvpn.PacketObservation{}, errors.New("original OpenVPN endpoint replaced")
	}
	remote, mtu, err := e.endpoint.RouterVPNConnectedCapacityContext(ctx)
	if err != nil {
		return nativeopenvpn.PacketObservation{}, err
	}
	state := nativeopenvpn.PacketObservation{Remote: remote, MTU: mtu}
	if state.Validate() != nil || remote.Remote != capture.Remote {
		return nativeopenvpn.PacketObservation{}, errors.New("actual middle lost captured remote")
	}
	return state, nil
}

func nodeChainOpenVPNNativeOwners(t *testing.T, ctx context.Context, chain *mobilemultihop.NodeChain, physical, fault string) (map[string]adapter.Outbound, func() error) {
	t.Helper()
	var graph map[string]any
	if json.Unmarshal([]byte(chain.Config()), &graph) != nil {
		t.Fatal("original OpenVPN middle graph absent")
	}
	egress, err := chain.PhysicalEgress()
	if err != nil || len(egress) != 1 || egress[0].Network != "udp" {
		t.Fatal("middle gained physical transport", err)
	}
	lower := &desktopSSReferenceLower{virtual: net.JoinHostPort(egress[0].Host, strconv.Itoa(egress[0].Port)), original: physical}
	manager := &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}}
	ctx = service.ContextWith[adapter.OutboundManager](ctx, manager)
	ctx = service.ContextWith[adapter.NetworkManager](ctx, &desktopImportedPacketNetwork{})
	ingress := &desktopNodeChainRejectInbound{}
	ctx = service.ContextWith[adapter.Router](ctx, ingress)
	var all []adapter.Outbound
	var once sync.Once
	var failure error
	closeOwners := func() error {
		once.Do(func() {
			for i := len(all) - 1; i >= 0; i-- {
				failure = errors.Join(failure, all[i].(io.Closer).Close())
			}
		})
		return failure
	}
	t.Cleanup(func() {
		if err := closeOwners(); err != nil {
			t.Error("original ordered native owners failed retirement", err)
		}
	})
	for position, tag := range chain.PrefixTags() {
		var row map[string]any
		for _, family := range []string{"endpoints", "outbounds"} {
			for _, raw := range graph[family].([]any) {
				v := raw.(map[string]any)
				if v["tag"] == tag {
					row = v
				}
			}
		}
		if row == nil {
			t.Fatal("original ordered native prefix vanished")
		}
		if position == 0 {
			row["detour"] = "captured-physical"
			if fault == "wrong-entry-key" {
				row["peers"].([]any)[0].(map[string]any)["pre_shared_key"] = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{97}, 32))
			}
		}
		if position == len(chain.PrefixTags())-2 && fault == "wrong-middle-password" {
			row["password"] = "foreign-openvpn-password"
		}
		if position == len(chain.PrefixTags())-2 && fault == "wrong-control-key" {
			wrap := row["tls"].(map[string]any)["control_wrap"].(map[string]any)
			key := wrap["key"].([]any)[0].(string)
			wrap["key"] = []string{strings.ReplaceAll(key, "aaaaaaaa", "bbbbbbbb")}
		}
		if position == len(chain.PrefixTags())-1 && fault == "wrong-final-key" {
			row["password"] = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{99}, 32))
		}
		if position == len(chain.PrefixTags())-1 && fault == "omit-middle" {
			row["detour"] = chain.PrefixTags()[len(chain.PrefixTags())-3]
		}
		if position == 1 && fault == "wrong-intermediate-key" {
			row["peers"].([]any)[0].(map[string]any)["pre_shared_key"] = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{96}, 32))
		}
		if position == len(chain.PrefixTags())-2 && fault == "omit-last-prefix" {
			row["detour"] = chain.PrefixTags()[0]
		}
		raw := []byte(desktopNodeChainJSON(t, row))
		var out adapter.Outbound
		switch row["type"] {
		case "wireguard":
			var o option.WireGuardEndpointOptions
			err = json.Unmarshal(raw, &o)
			if err == nil {
				out, err = WG.NewEndpoint(ctx, ingress, log.NewNOPFactory().Logger(), tag, o)
			}
		case mobilemultihop.AmneziaType:
			var o Options
			err = json.Unmarshal(raw, &o)
			if err == nil {
				out, err = NewEndpoint(ctx, ingress, log.NewNOPFactory().Logger(), tag, o)
			}
		case "openvpn-client":
			var o option.OpenVPNClientEndpointOptions
			err = json.Unmarshal(raw, &o)
			if err == nil {
				out, err = OV.NewClientEndpoint(ctx, ingress, log.NewNOPFactory().Logger(), tag, o)
			}
		case "shadowsocks":
			var o option.ShadowsocksOutboundOptions
			err = json.Unmarshal(raw, &o)
			if err == nil {
				out, err = SS.NewOutbound(ctx, nil, log.NewNOPFactory().Logger(), tag, o)
			}
		default:
			t.Fatal("uncaptured OpenVPN middle protocol", row["type"])
		}
		if err != nil {
			t.Fatal(err)
		}
		if _, ok := out.(io.Closer); !ok {
			t.Fatal("native middle lost original cleanup")
		}
		all = append(all, out)
		manager.owners[tag] = out
	}
	for _, stage := range adapter.ListStartStages {
		for _, out := range all {
			if starter, ok := out.(adapter.Lifecycle); ok {
				if err := starter.Start(stage); err != nil {
					t.Fatal(err)
				}
			}
		}
	}
	return manager.owners, closeOwners
}

func nodeChainOpenVPNStart(t *testing.T, mode, network, fault string) *nodeChainOpenVPNFixture {
	return nodeChainOpenVPNStartBounded(t, mode, network, fault, 12*time.Second)
}

func nodeChainOpenVPNStartBounded(t *testing.T, mode, network, fault string, budget time.Duration) *nodeChainOpenVPNFixture {
	return nodeChainOpenVPNStartPrefixes(t, mode, network, fault, budget, 1)
}

func nodeChainOpenVPNStartPrefixes(t *testing.T, mode, network, fault string, budget time.Duration, count int) *nodeChainOpenVPNFixture {
	t.Helper()
	if count < 1 || count > 6 {
		t.Fatal("uncaptured OpenVPN prefix count")
	}

	ctx, cancel := context.WithTimeout(pause.WithDefaultManager(context.Background()), budget)
	t.Cleanup(cancel)
	f := &nodeChainOpenVPNFixture{ctx: ctx, cancel: cancel}
	request, clients := desktopNodeChainPeerFixture(t, count)
	modes := make([]string, count)
	for i := range modes {
		modes[i] = mode
	}
	desktopNodeChainSetModes(t, &request, modes)
	f.request = request
	finalKey, err := ecdh.X25519().GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	finalPublic := base64.StdEncoding.EncodeToString(finalKey.PublicKey().Bytes())
	proof := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + finalPublic))
	request.FinalNodeProofID = hex.EncodeToString(proof[:])
	f.request = request
	finalWG := fmt.Sprintf("[Interface]\nAddress=10.77.0.2/32\nPrivateKey=%s\nMTU=1420\n[Peer]\nPublicKey=%s\nEndpoint=10.77.0.1:51820\nAllowedIPs=0.0.0.0/0,::/0\n", clients[0], finalPublic)
	finalIdentity := desktopNodeChainJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(finalWG))})
	loopback := netip.MustParseAddr("127.0.0.1")
	hooks := &desktopNodeChainImportedPeerHooks{decorate: func(h *desktopNodeWGHandler) tun.Handler {
		// Preserve both original owners: this fixture's existing bounded
		// lifetime and the reference peer's explicit retirement. The shared
		// reciprocal copier closes and joins its sockets when either ends.
		ownedContext, cancelOwned := context.WithCancel(ctx)
		stopOriginal := context.AfterFunc(h.ctx, cancelOwned)
		h.ctx = ownedContext
		t.Cleanup(func() { cancelOwned(); stopOriginal() })
		return &nodeChainOpenVPNPrefix{desktopNodeWGHandler: h, remote: M.ParseSocksaddr("203.0.113.24:1194")}
	}, middle: func(parent *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
		routes := append([]desktopNodeLayerRoute(nil), parent.routes...)
		for i := range routes {
			if routes[i].Destination == "speed.cloudflare.com:443" {
				routes[i].Destination = "93.184.216.34:443"
			}
		}
		f.provider = startDesktopInstalledOpenVPNProviderCaptured(t, parent, desktopExternalInstalledPeerRequest{OpenVPNNetwork: network}, "", "", loopback, loopback, true, 2, &desktopOpenVPNProviderCapture{Remote: netip.MustParseAddrPort("203.0.113.24:1194"), MTU: 1500, Routes: routes})
		if len(f.provider.entryRoutes) != 1 {
			t.Fatal("middle provider changed its one captured lower tuple")
		}
		return desktopExternalInstalledSSPeer{address: f.provider.entryRoutes[0].Target, close: f.provider.close}
	}}
	// The shared paired reference helper's SS metadata authenticates only its
	// request envelope. Its middle factory above is the real OpenVPN provider.
	// The product source below contains solely the original OpenVPN import.
	marker := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, 32))
	tail := request
	tail.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Prefixes[count-1:]...)
	f.peer = desktopNodeChainImportedPeerStartWithHooks(t, desktopNodeChainImportedRequest{1, tail, mobilemultihop.NativeStartLayerMethod, marker}, loopback, loopback, nil, hooks)
	physical := f.peer.paired.bind.address()
	if count > 1 {
		ipcs, err := desktopNodeChainPeerIdentityBounds(request, 1, 6)
		if err != nil {
			t.Fatal(err)
		}
		defer clear(ipcs)
		f.complete = &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, count), final: f.peer.paired}
		f.complete.prefixes[count-1] = f.peer.prefix
		desktopNodeChainStartCapturedPrefixes(t, request, loopback, loopback, f.complete, ipcs, count-2)
		physical = f.complete.prefixes[0].bind.address()
	}
	delete(f.peer.paired.entry.rules, "tcp/10.79.0.1:8388")
	delete(f.peer.paired.entry.rules, "udp/10.79.0.1:8388")
	route := f.provider.entryRoutes[0]
	f.peer.paired.entry.rules[network+"/203.0.113.24:1194"] = route
	var source mobilemultihop.NodeChainSource
	if count == 1 {
		socket := netip.MustParseAddrPort(physical)
		paired := desktopNodeChainImportedSource(t, request, clients, net.JoinHostPort(request.Address, strconv.Itoa(int(socket.Port()))), mobilemultihop.NativeStartLayerMethod, marker, finalIdentity)
		launch, err := paired.LaunchInput()
		if err != nil || json.Unmarshal([]byte(launch), &source) != nil {
			t.Fatal("original paired captures absent", err)
		}
	} else {
		socket := netip.MustParseAddrPort(physical)
		source = nodeChainOpenVPNPairedPrefixSource(t, request, clients, net.JoinHostPort(request.Address, strconv.Itoa(int(socket.Port()))), finalIdentity)
	}
	private := nativeopenvpn.Profile{Config: f.provider.profile, Username: f.provider.username, Password: f.provider.password}
	if count > 1 {
		// The provider still supplies an independently observed 1500-byte
		// native capacity. This longer captured client demands only 1280,
		// within every original preceding packet envelope; no PMTU is inferred.
		if strings.Count(private.Config, "tun-mtu 1500\n") != 1 {
			t.Fatal("original provider MTU declaration changed")
		}
		private.Config = strings.Replace(private.Config, "tun-mtu 1500\n", "tun-mtu 1280\n", 1)
	}
	endpoint, err := nativeopenvpn.CompileProfile(private, mobilemultihop.ExternalFinalTag, "")
	if err != nil {
		t.Fatal(err)
	}
	profile := map[string]any{"id": "captured-openvpn-middle", "node_kind": "external", "endpoint": "203.0.113.24", "external": map[string]any{"protocol": "openvpn", "expected_public_ip": "203.0.113.88", "openvpn": map[string]any{"config": private.Config, "username": private.Username, "password": private.Password}}, "dns_mode": "home", "start_layer": "off", "mtu_policy": "auto", "ipv6_mode": "on", "home_lan_access": false, "kill_switch_policy": "on-connect"}
	graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "interface_name": "router-vpn", "address": []string{"172.29.91.1/30", "fd29:91::1/126"}, "mtu": 1280, "auto_route": true, "strict_route": true, "stack": "system"}}, "endpoints": []any{endpoint}, "outbounds": []any{}, "route": map[string]any{"final": mobilemultihop.ExternalFinalTag, "rules": []any{}, "auto_detect_interface": true}}
	capture := map[string]any{"schema": 1, "exit_id": "captured-openvpn-middle", "protocol": "openvpn", "expected_public_ip": "203.0.113.88", "profile": profile}
	source.Nodes[count], err = mobilemultihop.NodeChainImportedOpenVPNMemberInput(desktopNodeChainJSON(t, graph), desktopNodeChainJSON(t, capture))
	if err != nil {
		t.Fatal(err)
	}
	source.Schema = 5
	f.chain, err = mobilemultihop.NewNodeChain(desktopNodeChainJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	owners, closeNative := nodeChainOpenVPNNativeOwners(t, ctx, f.chain, physical, fault)
	f.closeNative = closeNative
	engine := &nodeChainOpenVPNComponent{chain: f.chain, owners: owners, identity: mobilemultihop.NodeChainIdentity{EngineID: "original-encrypted-component", SessionID: "original-openvpn-middle-component", NetworkID: "retained-first-loopback-tuple", SourceSHA256: f.chain.SourceSHA256(), ConfigSHA256: f.chain.ConfigSHA256()}}
	engine.endpoint = owners[f.chain.PrefixTags()[count]].(*OV.ClientEndpoint)
	var compiled map[string]any
	if json.Unmarshal([]byte(f.chain.Config()), &compiled) != nil {
		t.Fatal("compiled selected resolver absent")
	}
	var selected map[string]any
	for _, raw := range compiled["dns"].(map[string]any)["servers"].([]any) {
		row := raw.(map[string]any)
		if row["tag"] == f.chain.DNSCapture().ResolverTag {
			selected = row
		}
	}
	if selected == nil || selected["server"] != "192.168.50.133" || selected["detour"] != f.chain.FinalTag() {
		t.Fatal("OpenVPN middle substituted selected final DNS")
	}
	dnsContext := service.ContextWith[adapter.OutboundManager](ctx, &desktopSSReferenceManager{owners: owners})
	dnsContext = service.ContextWith[adapter.DNSTransportManager](dnsContext, &desktopImportedNaiveH3DNSManager{owners: map[string]adapter.DNSTransport{}})
	dnsContext = service.ContextWith[adapter.DNSRouter](dnsContext, &desktopNaiveSelectedDNSRouter{})
	engine.resolver = desktopNaiveDNSTransport(t, dnsContext, selected)
	t.Cleanup(func() {
		if err := engine.resolver.Close(); err != nil {
			t.Error(err)
		}
	})
	root := x509.NewCertPool()
	if !root.AppendCertsFromPEM([]byte(f.peer.paired.ca)) {
		t.Fatal("private reference TLS roots absent")
	}
	// As in the existing native candidate fixture, only package-test TLS trust
	// changes. Run must still perform every actual routed private/public proof.
	field := reflect.ValueOf(f.chain).Elem().FieldByName("runtime").FieldByName("testTLS")
	f.testTLS = &tls.Config{RootCAs: root, MinVersion: tls.VersionTLS12}
	*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.testTLS.Clone()
	f.engine = engine
	if fault == "wrong-final-identity" {
		if err := f.peer.control("wrong-node"); err != nil {
			t.Fatal(err)
		}
	}
	if fault == "selected-dns-failure" {
		if err := f.peer.control("fail-dns"); err != nil {
			t.Fatal(err)
		}
	}
	t.Cleanup(func() {
		if err := f.close(); err != nil {
			t.Error("original ordered component did not join", err)
		}
	})
	return f
}

func (f *nodeChainOpenVPNFixture) close() error {
	if f.closed {
		return nil
	}
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()
	if err := f.chain.CloseContext(ctx); err != nil {
		return err
	}
	f.engine.closed.Store(true)
	if err := f.closeNative(); err != nil {
		return err
	}
	f.cancel()
	f.closed = true
	return nil
}
func (f *nodeChainOpenVPNFixture) prove(t *testing.T) nativeopenvpn.PacketObservation {
	t.Helper()
	if err := f.chain.Run(f.ctx, f.engine); err != nil {
		t.Fatal("actual ordered OpenVPN middle proof", err, f.provider.stats(), f.snapshot())
	}
	state, err := f.engine.OpenVPNMiddleStateContext(f.ctx, f.chain.PrefixTags()[len(f.chain.PrefixTags())-2])
	if err != nil || state.MTU != 1500 || state.Remote.Generation == 0 {
		t.Fatal("actual connected middle capacity absent", err, state)
	}
	progress := f.chain.Progress()
	stats := f.snapshot()
	native := f.provider.stats()
	if !progress.Ready || !progress.DNSProven || !progress.PublicProven || len(progress.Prefixes) != len(f.request.Prefixes)+2 || stats.Prefixes[0].ProofQueries < 2 || stats.Prefixes[0].RawUDP == 0 || stats.Final.RouterQueries < 2 || stats.Final.DNSQueries < 1 || stats.Middle.PublicQueries < 2 || native.streams == 0 || native.packets == 0 {
		t.Fatal("proof bypassed an original encrypted member", progress, stats, native)
	}
	for i, prefix := range stats.Prefixes {
		if prefix.RawUDP == 0 || prefix.ProofQueries < 2 {
			t.Fatal("unproved original packet prefix", i, prefix)
		}
	}
	plan, err := f.chain.MTUPlan()
	if err != nil || len(plan.Prefixes) != len(f.request.Prefixes)+2 || plan.Ceiling > int(state.MTU) {
		t.Fatal("configured graph lost nested packet bounds", err, plan)
	}
	if _, err = f.chain.PlanForMTU(f.chain.Config(), plan.Original); err != nil {
		t.Fatal("captured MTU projection changed original endpoints", err)
	}
	return state
}

// Measurement borrowing is a declared component host boundary. The real
// shared service owns all fifty requests, timing, statistics and history.
func (f *nodeChainOpenVPNFixture) MeasurementChainContext(ctx context.Context) (*mobilemultihop.NodeChain, error) {
	if ctx == nil || ctx.Err() != nil || f.engine.closed.Load() {
		return nil, errors.New("original measurement component retired")
	}
	return f.chain, nil
}

func (f *nodeChainOpenVPNFixture) BeginMeasurementContext(ctx context.Context) (func(), error) {
	if _, err := f.MeasurementChainContext(ctx); err != nil {
		return nil, err
	}
	if !f.measuring.CompareAndSwap(false, true) {
		return nil, errors.New("original measurement component already borrowed")
	}
	f.acquired.Add(1)
	var once sync.Once
	return func() { once.Do(func() { f.released.Add(1); f.measuring.Store(false) }) }, nil
}

func (f *nodeChainOpenVPNFixture) reconnect(t *testing.T) {
	t.Helper()
	before, err := f.engine.OpenVPNMiddleStateContext(f.ctx, f.chain.PrefixTags()[len(f.chain.PrefixTags())-2])
	if err != nil {
		t.Fatal(err)
	}
	f.engine.endpoint.InterfaceUpdated(f.ctx)
	deadline := time.NewTimer(5 * time.Second)
	defer deadline.Stop()
	tick := time.NewTicker(5 * time.Millisecond)
	defer tick.Stop()
	for {
		state, err := f.engine.OpenVPNMiddleStateContext(f.ctx, f.chain.PrefixTags()[len(f.chain.PrefixTags())-2])
		if err == nil && state.Remote.Generation > before.Remote.Generation {
			return
		}
		select {
		case <-deadline.C:
			t.Fatal("original native middle did not reconnect")
		case <-tick.C:
		case <-f.ctx.Done():
			t.Fatal(f.ctx.Err())
		}
	}
}

func (f *nodeChainOpenVPNFixture) fifty(t *testing.T) {
	t.Helper()
	service, err := f.chain.NewHopMeasurementContext(f.ctx, f)
	if err != nil {
		t.Fatal("original encrypted measurement source", err)
	}
	t.Cleanup(func() {
		if err := service.Close(); err != nil {
			t.Error(err)
		}
	})
	// The private reference CA is the only replacement at TLS validation.
	field := reflect.ValueOf(service).Elem().FieldByName("publicTLS")
	*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.testTLS.Clone()
	facade, err := hopmeasure.NewOrderedLatencyContext(f.ctx, service, f.chain.SourceSHA256(), f.chain.ConfigSHA256())
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := facade.Close(); err != nil {
			t.Error(err)
		}
	})
	proofs := f.chain.ProofInventory()
	for position, proof := range proofs {
		before := f.peer.snapshot()
		beforeFirst, beforeFinal := f.peer.measuredFirstHealth.Load(), f.peer.paired.measuredHealth.Load()
		request := fmt.Sprintf("%032x", position+1)
		if err := facade.StartContext(f.ctx, request, proof.ProfileID); err != nil {
			t.Fatal(err)
		}
		if err := facade.DrainContext(f.ctx, request); err != nil {
			t.Fatal("original fifty-response worker did not drain", err)
		}
		var status hopmeasure.Status
		if json.Unmarshal([]byte(facade.StatusJSON()), &status) != nil || !status.Complete || !status.Drained || status.Failure != "" || len(status.Results) != 1 {
			t.Fatal("encrypted fifty-response result absent", facade.StatusJSON())
		}
		row := status.Results[0]
		kind, metric := "private-node", "routed-private-response-including-connection"
		if position == 1 {
			kind, metric = "public-path", "routed-https-response-after-tls"
		}
		if !row.Ready || row.ID != proof.ProfileID || row.Kind != kind || row.Benchmark == nil || row.Benchmark.Measurement != metric || row.Benchmark.Attempts != 50 || row.Benchmark.Failed != 0 || row.Benchmark.Distribution == nil || row.Benchmark.Distribution.Samples != 50 || row.Benchmark.TrimmedMean <= 0 || row.Download != nil || row.Upload != nil || row.Idle != nil {
			t.Fatal("original fifty-response metric changed", row)
		}
		var saved hopmeasure.OrderedLatencyReceipt
		if json.Unmarshal([]byte(facade.SavedJSON(proof.ProfileID)), &saved) != nil || saved.Position != position || saved.NodeID != proof.ProfileID || saved.SourceSHA256 != f.chain.SourceSHA256() || saved.ConfigSHA256 != f.chain.ConfigSHA256() {
			t.Fatal("fifty-response history lost original path", saved)
		}
		after := f.peer.snapshot()
		// The original five-second observer remains running. It makes real
		// health requests too, so use the peer's measurement-specific HTTP
		// counters instead of treating those separate proofs as samples.
		first, middle, final := f.peer.measuredFirstHealth.Load()-beforeFirst, after.Middle.DownloadBytes-before.Middle.DownloadBytes, f.peer.paired.measuredHealth.Load()-beforeFinal
		if position == 0 && (first != 50 || middle != 0 || final != 0) || position == 1 && (first != 0 || middle != 50 || final != 0) || position == 2 && (first != 0 || middle != 0 || final != 50) {
			t.Fatal("fifty responses borrowed another prefix", position, first, middle, final)
		}
		if f.measuring.Load() || f.acquired.Load() != int32(position+1) || f.released.Load() != f.acquired.Load() {
			t.Fatal("fifty-response completion did not release original scope")
		}
	}
	previous := facade.CommittedJSON(proofs[1].ProfileID)
	f.reconnect(t)
	if facade.StartContext(f.ctx, strings.Repeat("f", 32), proofs[1].ProfileID) == nil || facade.CommittedJSON(proofs[1].ProfileID) != previous || f.measuring.Load() {
		t.Fatal("reconnected middle borrowed original measurement or replaced history")
	}
}

func TestRouterVPNDesktopNodeChainOpenVPNMiddleTraffic(t *testing.T) {
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		for _, network := range []string{"tcp", "udp"} {
			t.Run(mode+"--"+network, func(t *testing.T) {
				t.Run("complete-proof-dns-capacity", func(t *testing.T) {
					f := nodeChainOpenVPNStart(t, mode, network, "")
					f.prove(t)
					if err := f.chain.HealthyContext(f.ctx); err != nil {
						t.Fatal(err)
					}
				})
				t.Run("reconnect-rejects-original", func(t *testing.T) {
					f := nodeChainOpenVPNStart(t, mode, network, "")
					f.prove(t)
					f.reconnect(t)
					if f.chain.HealthyContext(f.ctx) == nil || f.chain.Progress().Ready {
						t.Fatal("new OpenVPN transport adopted original proof")
					}
				})
				t.Run("fifty-responses-original-history", func(t *testing.T) {
					f := nodeChainOpenVPNStartBounded(t, mode, network, "", 45*time.Second)
					f.prove(t)
					f.fifty(t)
				})
				t.Run("close-joins-native-stream", func(t *testing.T) {
					f := nodeChainOpenVPNStart(t, mode, network, "")
					f.prove(t)
					conn, err := f.engine.endpoint.DialContext(f.ctx, "tcp", M.ParseSocksaddr("10.77.0.1:8388"))
					if err != nil {
						t.Fatal(err)
					}
					defer conn.Close()
					if _, err = conn.Write([]byte("held-middle")); err != nil {
						t.Fatal(err)
					}
					_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
					entered, done := make(chan struct{}), make(chan error, 1)
					go func() { close(entered); b := make([]byte, 1); _, err := conn.Read(b); done <- err }()
					<-entered
					if err = f.close(); err != nil {
						t.Fatal(err)
					}
					select {
					case err := <-done:
						var timeout net.Error
						if err == nil || errors.As(err, &timeout) && timeout.Timeout() {
							t.Fatal("original stream did not close with native retirement", err)
						}
					case <-time.After(2 * time.Second):
						t.Fatal("original middle stream outlived joined native close")
					}
					if f.chain.Progress().Ready || f.chain.HealthyContext(context.Background()) == nil {
						t.Fatal("retired ordered proof became current")
					}
				})
			})
		}
	}
}

func TestRouterVPNDesktopNodeChainOpenVPNMiddleRefusal(t *testing.T) {
	for _, network := range []string{"tcp", "udp"} {
		t.Run(network, func(t *testing.T) {
			for _, fault := range []string{"wrong-entry-key", "wrong-middle-password", "wrong-control-key", "wrong-final-key", "wrong-final-identity", "omit-middle", "selected-dns-failure"} {
				t.Run(fault, func(t *testing.T) {
					f := nodeChainOpenVPNStart(t, "awg2-strong", network, fault)
					ctx, cancel := context.WithTimeout(f.ctx, 5*time.Second)
					defer cancel()
					if err := f.chain.Run(ctx, f.engine); err == nil || f.chain.Progress().Ready {
						t.Fatal("unproved original ordered graph became ready", fault)
					}
					stats := f.peer.snapshot()
					if stats.Prefixes[0].RawUDP == 0 {
						t.Fatal("negative control never reached actual encrypted first hop")
					}
					if fault == "wrong-final-identity" || fault == "selected-dns-failure" {
						if stats.Final.RouterQueries == 0 {
							t.Fatal("negative control did not reach original paired identity")
						}
					} else if stats.Final.RouterQueries != 0 {
						t.Fatal("wrong route or credentials reached paired final proof")
					}
				})
			}
		})
	}
}
