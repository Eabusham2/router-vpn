package main

import (
	"context"
	"net/netip"
	"os"
	"os/signal"
	"strings"
	"syscall"
	"time"

	"github.com/sagernet/sing-box/routervpn/mobiletor"
	"github.com/spf13/cobra"
)

func init() {
	var directory, session, binary string
	command := &cobra.Command{Use: "routervpn-tor", Short: "Run one captured Router VPN standalone Tor session", Args: cobra.NoArgs, SilenceUsage: true,
		RunE: func(_ *cobra.Command, _ []string) error {
			ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
			defer cancel()
			return routerVPNRunTor(ctx, directory, session, binary, os.Getenv, routerVPNNewTorNative)
		}}
	command.Flags().StringVar(&directory, "runtime-dir", "", "absolute private session directory")
	command.Flags().StringVar(&session, "session", "", "captured session identity")
	command.Flags().StringVar(&binary, "tor-binary", "", "exact captured standalone Tor executable")
	mainCommand.AddCommand(command)
}

type routerVPNTorProgress struct {
	Schema       int    `json:"schema"`
	Session      string `json:"session_id"`
	SourceSHA256 string `json:"source_sha256"`
	ConfigSHA256 string `json:"config_sha256"`
	Stage        string `json:"stage"`
}

func routerVPNTorStage(stage string) bool {
	switch stage {
	case "starting", "authenticating", "starting-tun", "starting-transports", "bootstrapping", "proving", "connected", "stopping", "cleanup-pending", "closed":
		return true
	}
	return false
}

func routerVPNTorValidProof(proof mobiletor.DesktopBridgeProof, metadata mobiletor.DesktopBridgeMetadata, started, timeNow time.Time) bool {
	address, err := netip.ParseAddr(proof.Proof.IP)
	if err != nil || !address.IsGlobalUnicast() || address.IsPrivate() || address.IsLoopback() || address.IsLinkLocalUnicast() || address.String() != proof.Proof.IP {
		return false
	}
	return proof.Schema == 1 && proof.SessionID == metadata.SessionID && proof.SourceSHA256 == metadata.SourceSHA256 && proof.ConfigSHA256 == metadata.ConfigSHA256 && proof.Policy == metadata && proof.Healthy && proof.MTUReadback == nil && metadata.ValidEntryProof(proof.EntryProof, started, timeNow) && proof.Proof.SessionID == metadata.SessionID && proof.Proof.IsTor && proof.Proof.DNSProven &&
		!proof.Proof.CheckedAt.IsZero() && !proof.Proof.CheckedAt.Before(started.Add(-time.Second)) && !proof.Proof.CheckedAt.After(timeNow.Add(time.Second)) && proof.HeartbeatAt >= proof.Proof.CheckedAt.UnixMilli() && proof.HeartbeatAt >= timeNow.Add(-mobiletor.DesktopBridgeHeartbeatMaxAge).UnixMilli() && proof.HeartbeatAt <= timeNow.Add(time.Second).UnixMilli() &&
		proof.InterfaceName != "" && len(proof.InterfaceName) <= 64 && strings.IndexFunc(proof.InterfaceName, func(r rune) bool { return r <= 0x20 || r == 0x7f }) < 0 && proof.InterfaceIndex > 0 && proof.EffectiveMTU == metadata.ConfiguredMTU && proof.EffectiveMTU >= 1280 && proof.EffectiveMTU <= 9000 && (metadata.InterfaceName == "" || proof.InterfaceName == metadata.InterfaceName)
}

// The create-only first progress publication is admission for this runtime.
// Even a second process with identical source cannot mint a no-work receipt for
// an already-running owner. This loop owns proof/progress/transition output;
// one retained maintenance worker owns disjoint measurement status files.
func routerVPNRunTor(parent context.Context, directory, session, binaryPath string, getenv func(string) string, factory routerVPNTorFactory) (failure error) {
	if parent == nil || getenv == nil || factory == nil {
		return routerVPNTorFailure
	}
	files, err := routerVPNOpenTorFiles(directory, session, binaryPath, getenv)
	if err != nil {
		return routerVPNTorFailure
	}
	defer files.closeHandles()
	metadata := files.inputs.Policy().Metadata()
	progress := routerVPNTorProgress{Schema: 1, Session: session, SourceSHA256: metadata.SourceSHA256, ConfigSHA256: metadata.ConfigSHA256, Stage: "starting"}
	if files.publish("progress.json", progress) != nil {
		return routerVPNTorFailure
	}
	closed := struct {
		routerVPNExternalStop
		Closed bool `json:"closed"`
	}{routerVPNExternalStop{Schema: 1, Session: session, SourceSHA256: metadata.SourceSHA256}, true}
	finish := func() error {
		if files.current() != nil {
			return routerVPNTorFailure
		}
		if entries, err := routerVPNTorReadDirectory(files.data, 0); err != nil || len(entries) != 0 {
			return routerVPNTorFailure
		}
		progress.Stage = "closed"
		if files.publish("progress.json", progress) != nil || files.publish("stopped.json", closed) != nil {
			return routerVPNTorFailure
		}
		return nil
	}
	if parent.Err() != nil || files.stopRequested(session, metadata.SourceSHA256) {
		return finish()
	}
	binary, err := routerVPNCaptureTorBinary(binaryPath, getenv("HOMEVPN_TOR_BINARY_SHA256"))
	if err != nil {
		// Admission and all source bytes are valid; no native constructor or
		// child launch has occurred. This is a bounded no-work acknowledgement.
		_ = finish()
		return routerVPNTorFailure
	}
	ctx := globalCtx
	if ctx == nil {
		ctx = context.Background()
	}
	ctx = context.WithoutCancel(ctx)
	started := time.Now()
	owner, factoryErr := factory(ctx, files, binary)
	if owner == nil {
		_ = finish()
		return routerVPNTorFailure
	}
	type outcome struct {
		proof mobiletor.DesktopBridgeProof
		err   error
	}
	done := make(chan outcome, 1)
	go func() {
		if factoryErr != nil {
			done <- outcome{err: factoryErr}
			return
		}
		if err := owner.Start(); err != nil {
			done <- outcome{err: err}
			return
		}
		proof, err := owner.Run()
		done <- outcome{proof: proof, err: err}
	}()
	tick := time.NewTicker(100 * time.Millisecond)
	defer tick.Stop()
	finished, connected, stopping := false, false, false
	var receipt mobiletor.DesktopBridgeProof
	var heartbeat time.Time
	var dnsFiles *routerVPNDesktopDNSFiles
	var mtuFiles *routerVPNDesktopMTUFiles
	var pathFiles *routerVPNDesktopPathFiles
	var transitions <-chan routerVPNTorMTUTransitionRequest
	if native, ok := owner.(routerVPNTorTransitionOwner); ok {
		transitions = native.MTUTransitions()
	}
	var transition *mobiletor.DesktopBridgeMTUTransition
	var transitionDone <-chan struct{}
	var transitionID, proofVersion uint64
	var maintenance <-chan routerVPNTorMaintenance
	var cancelMaintenance context.CancelFunc
	for !stopping {
		select {
		case <-transitionDone:
			transitionDone = nil
		case request := <-transitions:
			if transitionDone != nil {
				select {
				case <-transitionDone:
					transitionDone = nil
				default:
					request.respond(routerVPNTorFailure)
					failure, stopping = routerVPNTorFailure, true
					continue
				}
			}
			if !connected || mtuFiles == nil || parent.Err() != nil || files.stopRequested(session, metadata.SourceSHA256) || !routerVPNTorLifetimeCurrent(owner) {
				request.respond(routerVPNTorFailure)
				stopping = true
				break
			}
			now, clockErr := routerVPNTorNextHeartbeat(parent, request.context, receipt.HeartbeatAt)
			if clockErr != nil {
				request.respond(routerVPNTorFailure)
				failure, stopping = routerVPNTorFailure, true
				break
			}
			next, admitted, err := routerVPNTorAdmitTransition(files, request, receipt, transitionID, now)
			if err != nil {
				request.respond(routerVPNTorFailure)
				failure, stopping = routerVPNTorFailure, true
				break
			}
			receipt, heartbeat, transition, transitionID = next, now, &admitted, admitted.TransitionID
			transitionDone = request.finished
			proofVersion++
			request.respond(nil)
		case result := <-maintenance:
			maintenance = nil
			cancelMaintenance()
			cancelMaintenance = nil
			if parent.Err() != nil || files.stopRequested(session, metadata.SourceSHA256) {
				stopping = true
				break
			}
			if !routerVPNTorLifetimeCurrent(owner) || files.current() != nil {
				failure, stopping = routerVPNTorFailure, true
				break
			}
			// A synchronous transition may have advanced the base proof while
			// this older read was waiting for the native reader. Recheck afresh;
			// never overwrite that newer admission with a late snapshot/error.
			if result.version != proofVersion {
				break
			}
			if result.err != nil {
				failure, stopping = routerVPNTorFailure, true
				break
			}
			if result.heartbeat {
				receipt = result.proof
				heartbeat = time.Now()
				receipt.HeartbeatAt = heartbeat.UnixMilli()
				if files.publish("proof.json", receipt) != nil {
					failure, stopping = routerVPNTorFailure, true
					break
				}
				proofVersion++
				transition = nil
			}
		case result := <-done:
			finished = true
			if parent.Err() != nil || files.stopRequested(session, metadata.SourceSHA256) {
				stopping = true
				break
			}
			if result.err != nil || files.current() != nil || !owner.Healthy() || !routerVPNTorValidProof(result.proof, metadata, started, time.Now()) {
				failure, stopping = routerVPNTorFailure, true
				break
			}
			receipt = result.proof
			service, err := owner.DesktopDNS()
			if err != nil || service == nil {
				failure, stopping = routerVPNTorFailure, true
				break
			}
			dnsFiles, err = routerVPNOpenDesktopDNSService(routerVPNTorOutputFiles(files), service, session, metadata.SourceSHA256, metadata.ConfigSHA256)
			if err != nil {
				failure, stopping = routerVPNTorFailure, true
				break
			}
			if measured, ok := owner.(routerVPNTorMeasurementOwner); ok {
				mtuFiles, err = routerVPNOpenDesktopMTUProvider(routerVPNTorOutputFiles(files), measured, session, metadata.SourceSHA256, metadata.ConfigSHA256)
				if err == nil {
					pathFiles, err = routerVPNOpenDesktopPath(routerVPNTorOutputFiles(files), measured.FreshPathOwner(), session, metadata.SourceSHA256, metadata.ConfigSHA256)
				}
				if err != nil {
					failure, stopping = routerVPNTorFailure, true
					break
				}
			}
			if routerVPNTorRefreshReadback(owner, &receipt) != nil || receipt.MTUReadback != nil {
				failure, stopping = routerVPNTorFailure, true
				break
			}
			heartbeat = time.Now()
			receipt.HeartbeatAt = heartbeat.UnixMilli()
			if files.publish("proof.json", receipt) != nil {
				failure, stopping = routerVPNTorFailure, true
				break
			}
			connected, progress.Stage = true, "connected"
		case <-parent.Done():
			stopping = true
		case <-tick.C:
			if parent.Err() != nil || files.stopRequested(session, metadata.SourceSHA256) {
				stopping = true
				break
			}
			if files.current() != nil {
				failure, stopping = routerVPNTorFailure, true
				break
			}
			if connected {
				pathFiles.signalCancellation()
				if !routerVPNTorLifetimeCurrent(owner) {
					failure, stopping = routerVPNTorFailure, true
					break
				}
				now := time.Now()
				if transition != nil && receipt.HeartbeatAt == transition.FromHeartbeatAt && now.UnixMilli() >= transition.ExpiresAt ||
					time.Since(heartbeat) >= mobiletor.DesktopBridgeHeartbeatMaxAge && !routerVPNTorTransitionKeepsAlive(transition, receipt, now) {
					failure, stopping = routerVPNTorFailure, true
					break
				}
				if maintenance == nil {
					ctx, cancel := context.WithCancel(parent)
					cancelMaintenance = cancel
					completed := make(chan routerVPNTorMaintenance, 1)
					maintenance = completed
					captured := routerVPNTorMaintenance{version: proofVersion, proof: receipt, heartbeat: transitionDone == nil && time.Since(heartbeat) >= 500*time.Millisecond}
					go func() { completed <- routerVPNTorMaintain(ctx, owner, files, dnsFiles, mtuFiles, pathFiles, captured) }()
				}
			} else {
				progress.Stage = owner.Stage()
				if !routerVPNTorStage(progress.Stage) {
					failure, stopping = routerVPNTorFailure, true
					break
				}
				// Run may finish between select and this read. Its receipt still
				// has to pass this loop's captured adoption before publication.
				if progress.Stage == "connected" {
					progress.Stage = "proving"
				}
			}
			if files.publish("progress.json", progress) != nil {
				failure, stopping = routerVPNTorFailure, true
			}
		}
	}
	if cancelMaintenance != nil {
		cancelMaintenance()
	}
	owner.Cancel()
	if maintenance != nil {
		<-maintenance
	}
	if dnsFiles != nil {
		dnsFiles.service.Invalidate()
	}
	if mtuFiles != nil {
		mtuFiles.owner.invalidate()
	}
	proofRemoved := files.remove("proof.json") == nil
	if !proofRemoved {
		failure = routerVPNTorFailure
	}
	progress.Stage = "stopping"
	_ = files.publish("progress.json", progress)
	if !finished {
		<-done
	}
	// The standalone Tor child, PT/network observer, DNS/proof workers and Box
	// remain attached to this process until their actual captured owners drain.
	for {
		cleanup, stop := context.WithTimeout(context.Background(), 5*time.Second)
		err := owner.Close(cleanup)
		stop()
		if err == nil {
			break
		}
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-tick.C
	}
	for dnsFiles != nil && dnsFiles.service.Close() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-tick.C
	}
	for mtuFiles != nil && mtuFiles.owner.close() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-tick.C
	}
	for pathFiles.close() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-tick.C
	}
	for mtuFiles != nil && mtuFiles.retire() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-tick.C
	}
	for dnsFiles.close() != nil {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-tick.C
	}
	for !proofRemoved {
		progress.Stage = "cleanup-pending"
		_ = files.publish("progress.json", progress)
		<-tick.C
		proofRemoved = files.remove("proof.json") == nil
	}
	if err := finish(); err != nil {
		return err
	}
	return failure
}
