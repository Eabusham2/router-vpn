}

func TestRouterVPNDesktopNodeChainMTUProofHandoff(t *testing.T) {
	f := desktopNodeChainRuntimeFixture(t)
	f.start(t)
	original, oldEngine := f.ready(t), f.engines[0]
	desktopNodeMTUApply(t, f.mtu, "begin", 0)
	desktopNodeMTUApply(t, f.mtu, "set", 1360)
	if !reflect.DeepEqual(f.events, []string{"prove", "join", "native-change", "prove"}) || f.proofs[0].closed != 1 || len(f.proofs) != 2 {
		t.Fatal("MTU replacement did not join before native mutation and reproof", f.events)
	}
	if _, err := oldEngine.ObserveChainContext(context.Background()); err == nil {
		t.Fatal("old proof adopted the replacement reader")
	}
	if err := f.runtime.heartbeat(context.Background(), f.mtu.record); err != nil {
		t.Fatal(err)
	}
	changed := f.ready(t)
	if changed.Identity != original.Identity || changed.Reader != original.Reader+1 || changed.Generation != original.Generation+1 || changed.MTU != 1360 {
		t.Fatal("fresh proof lost original source or exact reader generation", original, changed)
	}
	// A late old completion cannot make its revoked current callback valid.
	f.proofs[0].ready = true
	if _, err := oldEngine.ObserveChainContext(context.Background()); err == nil {
		t.Fatal("late old proof regained admission")
	}
	desktopNodeMTUApply(t, f.mtu, "rollback", 0)
	if err := f.runtime.heartbeat(context.Background(), f.mtu.record); err != nil {
		t.Fatal(err)
	}
	restored := f.ready(t)
	if restored.Identity != original.Identity || restored.Reader != original.Reader+2 || restored.Generation != original.Generation+2 || restored.MTU != 1420 {
		t.Fatal("rollback lost the fresh controller bound to actual returned TUN", restored)
	}
	changes := len(f.native.values)
	if err := f.runtime.close(context.Background()); err != nil || len(f.native.values) != changes || f.native.current != f.mtu.inbound {
		t.Fatal("proof close acquired native teardown or lost joined cleanup", err)
	}
}

func TestRouterVPNDesktopNodeChainMTURejectsUnjoinedCanceledAndForeignReaders(t *testing.T) {
	for _, fault := range []string{"join", "cancel", "returned-reader", "network", "session", "source", "config", "proof-failure", "ceiling"} {
		t.Run(fault, func(t *testing.T) {
			f := desktopNodeChainRuntimeFixture(t)
			f.start(t)
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			value := 1360
			if fault == "join" {
				f.proofs[0].onClose = func(context.Context) error { return errors.New("original proof callback still running") }
			}
			if fault == "ceiling" {
				value = f.runtime.ceiling + 1
			}
			if fault == "cancel" || fault == "returned-reader" {
				change := f.native.change
				f.native.change = func(call context.Context, previous adapter.Inbound, value int) (adapter.Inbound, error) {
					next, err := change(call, previous, value)
					if fault == "cancel" {
						cancel()
					} else {
						old := next.(*desktopMTUTUNFixture)
						foreign := *old
						f.native.current = &foreign
					}
					return next, err
				}
			}
			f.create = func(position int, proof *desktopNodeChainProofFixture, engine *desktopNodeChainEngineFixture) {
				if position != 1 {
					return
				}
				switch fault {
				case "network":
					engine.identity.NetworkID = "substituted-network"
				case "session":
					engine.identity.SessionID = strings.Repeat("f", 32)
				case "source":
					engine.identity.SourceSHA256 = strings.Repeat("f", 64)
				case "config":
					engine.identity.ConfigSHA256 = strings.Repeat("f", 64)
				case "proof-failure":
					proof.onRun = func(context.Context) error { return errors.New("middle prefix proof failed") }
				}
			}
			if err := f.mtu.changeBeforeContext(ctx, value, time.Time{}); err == nil {
				t.Fatal("invalid chain MTU transition succeeded")
			}
			if fault == "ceiling" {
				if len(f.native.values) != 0 || f.proofs[0].closed != 0 || f.runtime.current(context.Background()) != nil {
					t.Fatal("out-of-envelope candidate retired or changed the original owner")
				}
				return
			}
			if fault == "join" && len(f.native.values) != 0 {
				t.Fatal("native mutation preceded original proof join")
			}
			if f.runtime.current(context.Background()) == nil || f.runtime.heartbeat(context.Background(), f.mtu.record) == nil {
				t.Fatal("failed or canceled generation published readiness")
			}
			if _, err := f.runtime.files.root.Lstat("node-chain-ready.json"); !errors.Is(err, os.ErrNotExist) {
				t.Fatal("old heartbeat survived proof retirement", err)
			}
			if fault == "join" {
				if err := f.runtime.resume(context.Background()); err == nil {
					t.Fatal("failed proof join was bypassed by a new controller")
				}
				f.proofs[0].onClose = nil
			}
			if err := f.runtime.close(context.Background()); err != nil {
				t.Fatal("original proof join could not retry", err)
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainHeartbeatRejectsCurrentReaderSubstitution(t *testing.T) {
	f := desktopNodeChainRuntimeFixture(t)
	f.start(t)
	before := f.ready(t)
	actual := f.native.current.(*desktopMTUTUNFixture)
	foreign := *actual
	f.native.current = &foreign
	if err := f.runtime.heartbeat(context.Background(), f.mtu.record); err == nil {
		t.Fatal("same-value foreign TUN acquired fresh heartbeat")
	}
	after := f.ready(t)
	if after != before {
		t.Fatal("invalid current owner updated a successful receipt")
	}
}

func TestRouterVPNDesktopNodeChainActualLoopRequiresCurrentProofAndReader(t *testing.T) {
	for _, fault := range []string{"exact", "cancel", "reader-substitution", "parent-cancel-current", "graph-cancel-current", "wrong-parent-cancel-current", "invalid-proof-with-stop-current"} {
		t.Run(fault, func(t *testing.T) {
			f := desktopNodeChainRuntimeFixture(t)
			currentFault := strings.HasSuffix(fault, "-current")
			currentEntered := make(chan context.Context, 1)
			currentRelease := make(chan struct{})
			var releaseCurrent sync.Once
			var currentArmed atomic.Bool
			if currentFault {
				f.create = func(_ int, proof *desktopNodeChainProofFixture, _ *desktopNodeChainEngineFixture) {
					proof.onHealthy = func(ctx context.Context) error {
						if !currentArmed.Load() {
							return nil
						}
						if _, bounded := ctx.Deadline(); bounded {
							return nil
						}
						select {
						case currentEntered <- ctx:
						default:
						}
						<-currentRelease
						if fault == "wrong-parent-cancel-current" {
							return context.Canceled
						}
						if fault == "invalid-proof-with-stop-current" {
							return routerVPNExternalFailure
						}
						return ctx.Err()
					}
				}
			}
			fixture := &desktopNodeMTUHeartbeatFixture{entered: make(chan struct{}), release: make(chan struct{}), raw: desktopNetworkReceiptFixture(t, 17, 1420, strings.Repeat("d", 32))}
			registry := include.InboundRegistry()
			created := 0
			inbound.Register[option.TunInboundOptions](registry, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
				created++
				value := fixture
				if created > 1 {
					value = &desktopNodeMTUHeartbeatFixture{}
				}
				value.Adapter = inbound.NewAdapter(C.TypeTun, tag)
				return value, nil
			})
			graph, stopGraph := context.WithCancel(box.Context(context.Background(), registry, include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry()))
			defer stopGraph()
			// Only the proof/native-interface boundaries are modeled. The Box
			// manager, original reader capture, private files and entire shipping
			// loop run unchanged; this is not encrypted/privileged acceptance.
			options, err := SJ.UnmarshalExtendedContext[option.Options](graph, []byte(`{"log":{"disabled":true},"inbounds":[{"type":"tun","tag":"tun-in","interface_name":"router-vpn","mtu":1420,"address":["10.8.0.2/24"],"auto_route":false,"stack":"system"}],"outbounds":[{"type":"direct","tag":"direct"}],"route":{"auto_detect_interface":true,"final":"direct"}}`))
			if err != nil {
				t.Fatal(err)
			}
			instance, err := box.New(box.Options{Context: graph, Options: options})
			if err != nil {
				t.Fatal(err)
			}
			defer instance.Close()
			if err := instance.RouterVPNStrategyStart(); err != nil {
				t.Fatal(err)
			}
			parent, stopParent := context.WithCancel(context.Background())
			defer stopParent()
			meta := f.runtime.policy.Metadata()
			done := make(chan error, 1)
			go func() {
				done <- routerVPNRunNodeMTULoopWithChain(parent, graph, f.runtime.files, instance, meta.SessionID, meta.ConfigSHA256, nil,
					func(ctx context.Context) error { return ctx.Err() }, func() error { return nil }, f.runtime)
			}()
			var release sync.Once
			finished := false
			defer func() {
				releaseCurrent.Do(func() { close(currentRelease) })
				release.Do(func() { close(fixture.release) })
				stopParent()
				stopGraph()
				if !finished {
					select {
					case <-done:
					case <-time.After(3 * time.Second):
						t.Error("ordered shipping loop did not join")
					}
				}
			}()
			select {
			case <-fixture.entered:
			case err := <-done:
				finished = true
				t.Fatal("ordered loop failed before original native receipt", err)
			case <-time.After(5 * time.Second):
				t.Fatal("ordered loop never entered original native receipt")
			}
			switch fault {
			case "cancel":
				stopParent()
			case "reader-substitution":
				if err := instance.Inbound().Create(graph, instance.Router(), log.NewNOPFactory().Logger(), "tun-in", C.TypeTun, &option.TunInboundOptions{MTU: 1420}); err != nil {
					t.Fatal(err)
				}
			}
			release.Do(func() { close(fixture.release) })
			var capturedReady mobilemultihop.DesktopNodeChainReadyRecord
			if fault == "exact" || currentFault {
				deadline := time.Now().Add(3 * time.Second)
				for {
					// The shipping heartbeat can revoke Ready after its atomic
					// publication. Its matching MTU status is published only after
					// those final current-owner checks have completed. Capture both
					// while active; Stop must remain free to remove active files.
					raw, readyErr := f.runtime.files.read("node-chain-ready.json", mobilemultihop.DesktopNodeChainReadyRecordLimit)
					ready, parseErr := mobilemultihop.ParseDesktopNodeChainReadyRecord(raw, f.runtime.policy, f.runtime.transfer)
					statusRaw, statusErr := f.runtime.files.read("node-mtu-status.json", routerVPNNodeMTURecordLimit)
					var status routerVPNNodeMTURecord
					if parent.Err() == nil && readyErr == nil && parseErr == nil && statusErr == nil &&
						routerVPNMTUStrict(statusRaw, &status) && status.Schema == 1 &&
						status.Session == meta.SessionID && status.Session == ready.Identity.SessionID &&
						status.Config == meta.ConfigSHA256 && status.Config == ready.Identity.ConfigSHA256 &&
						status.Reader == ready.Reader && status.Interface == ready.InterfaceName &&
						status.Index > 0 && uint64(status.Index) == uint64(ready.InterfaceIndex) &&
						status.MTU == ready.MTU && status.Heartbeat > 0 && status.Heartbeat <= ready.ObservedAt &&
						status.Failure == "" && !status.Active {
						capturedReady = ready
						break
					}
					if time.Now().After(deadline) {
						t.Fatal("complete current loop did not publish matching chain and MTU heartbeat")
					}
					time.Sleep(10 * time.Millisecond)
				}
				if !currentFault {
					stopParent()
				}
			}
			var originalState *routerVPNNodeChainProofState
			if currentFault {
				originalState = f.runtime.state.Load()
				if originalState == nil || originalState.revoked.Load() || originalState.joined {
					t.Fatal("current observation lost original proved state")
				}
				currentArmed.Store(true)
				var observing context.Context
				select {
				case observing = <-currentEntered:
				case err := <-done:
					finished = true
					t.Fatal("actual loop exited before held current observation", err)
				case <-time.After(3 * time.Second):
					t.Fatal("actual loop did not enter held current observation")
				}
				switch fault {
				case "parent-cancel-current":
					stopParent()
				case "graph-cancel-current":
					stopGraph()
				case "wrong-parent-cancel-current":
					foreign, stopForeign := context.WithCancel(context.Background())
					stopForeign()
					if foreign.Err() == nil || parent.Err() != nil || graph.Err() != nil {
						t.Fatal("foreign cancellation changed the original owner")
					}
				case "invalid-proof-with-stop-current":
					desktopExternalStopFile(t, f.runtime.files.root.Name(), meta.SessionID, meta.ConfigSHA256)
				}
				if fault == "parent-cancel-current" || fault == "graph-cancel-current" {
					select {
					case <-observing.Done():
					case <-time.After(3 * time.Second):
						t.Fatal("captured current observation did not receive cancellation")
					}
				}
				releaseCurrent.Do(func() { close(currentRelease) })
			}
			select {
			case err := <-done:
				finished = true
				wantSuccess := fault == "exact" || fault == "cancel" || fault == "parent-cancel-current"
				if (err == nil) != wantSuccess {
					t.Fatal("actual loop changed cancellation/substitution outcome", err)
				}
			case <-time.After(3 * time.Second):
				t.Fatal("actual ordered loop did not join captured receipt")
			}
			if fault == "exact" || currentFault {
				if capturedReady.Reader != 1 || capturedReady.Generation != 1 || capturedReady.MTU != 1420 {
					t.Fatal("actual loop published another proof/reader", capturedReady)
				}
			} else {
				for _, name := range []string{"node-chain-ready.json", "node-mtu-status.json"} {
					if _, err := f.runtime.files.root.Lstat(name); !errors.Is(err, os.ErrNotExist) {
						t.Fatal("invalid actual loop published success", name, err)
					}
				}
			}
			if currentFault {
				if f.runtime.state.Load() != originalState || originalState.revoked.Load() || originalState.joined || len(f.proofs) != 1 || f.proofs[0].closed != 0 {
					t.Fatal("loop exit acquired coordinator proof retirement")
				}
				join, cancelJoin := context.WithTimeout(context.Background(), 3*time.Second)
				err := f.runtime.close(join)
				cancelJoin()
				if err != nil || f.runtime.state.Load() != originalState || !originalState.revoked.Load() || !originalState.joined || f.proofs[0].closed != 1 {
					t.Fatal("original coordinator did not join captured proof before Box teardown", err)
				}
			}
			if err := f.runtime.close(context.Background()); err != nil {
				t.Fatal(err)
			}
			if _, err := f.runtime.files.root.Lstat("node-chain-ready.json"); !errors.Is(err, os.ErrNotExist) {
				t.Fatal("closed original runtime retained active chain readiness", err)
			}
		})
	}
}

// desktopObservationalCompleteFixture models only the physical MTU attachment
// boundary. Its run/current/close callbacks are the original concrete typed
// owners. The actual Box, retained TUN reader and common command loop run here;
// this component fixture does not establish encrypted or installed ownership.
type desktopObservationalCompleteFixture struct {
	start func(context.Context) error
	current func(context.Context) error
	session, config string
	observe func(context.Context) context.Context
	raw *routerVPNNodeMTU
}
func (f *desktopObservationalCompleteFixture) run(ctx context.Context) error {
	return f.start(ctx)
}
func (f *desktopObservationalCompleteFixture) attachMTU(ctx context.Context, raw *routerVPNNodeMTU, physical *box.RouterVPNDesktopNodePhysical) error {
	if f.raw != nil || raw == nil || physical != nil || raw.record.Session != f.session || raw.record.Config != f.config ||
		raw.record.Reader != 1 || raw.record.Interface != "router-vpn" || raw.record.Index != 17 || raw.record.MTU != 1420 {
		return errors.New("modeled attachment changed original TUN capture")
	}
	if err := f.current(ctx); err != nil {
		return err
	}
	f.raw = raw
	return nil
}
func (f *desktopObservationalCompleteFixture) loopCurrent(ctx context.Context) error {
	return f.current(f.observe(ctx))
}
func (f *desktopObservationalCompleteFixture) heartbeat(ctx context.Context, record routerVPNNodeMTURecord) error {
	if f.raw == nil || record.Session != f.session || record.Config != f.config || record.Reader != f.raw.record.Reader ||
		record.Interface != f.raw.record.Interface || record.Index != f.raw.record.Index || record.MTU != f.raw.record.MTU {
		return errors.New("modeled heartbeat changed original TUN capture")
	}
	return f.current(ctx)
}

type desktopObservationalContextKey struct{}

func TestRouterVPNDesktopNodeChainObservationalStopOwnership(t *testing.T) {
	for _, family := range []string{"socks", "connect", "execution"} {
		t.Run(family, func(t *testing.T) {
			for _, fault := range []string{"parent", "graph", "foreign", "invalid-with-stop"} {
				t.Run(fault, func(t *testing.T) {
					token := new(int)
					var armed atomic.Bool
					entered := make(chan context.Context, 1)
					release := make(chan struct{})
					var releaseOnce sync.Once
					var foreignContext context.Context
					observe := func(ctx context.Context) context.Context {
						if !armed.Load() {
							return ctx
						}
						// This adapter method is called only by complete.loopCurrent.
						// Heartbeat delegates directly to the concrete owner instead.
						if ctx.Value(desktopObservationalContextKey{}) != token {
							panic("current observation lost original parent marker")
						}
						if _, bounded := ctx.Deadline(); bounded {
							panic("bounded heartbeat entered loopCurrent adapter")
						}
						select {
						case entered <- ctx:
						default:
						}
						<-release
						if foreignContext != nil {
							return foreignContext
						}
						return ctx
					}
					var files *routerVPNExternalFiles
					var session, config string
					var complete *desktopObservationalCompleteFixture
					var current, closeOwner func(context.Context) error
					var captureRetained func() func() bool
					var invalidate func()
					var joined func() bool
					switch family {
					case "socks":
						f := newDesktopSOCKSRuntimeFixture(t)
						invalidate = func() { f.valid.Store(false) }
						files, session, config = f.owner.files, f.construction.metadata.SessionID, f.construction.metadata.ConfigSHA256
						current, closeOwner = f.owner.loopCurrent, f.owner.close
						complete = &desktopObservationalCompleteFixture{start: f.owner.run, current: current, observe: observe, session: session, config: config}
						captureRetained = func() func() bool {
							state := f.owner.state.Load()
							return func() bool { return state != nil && f.owner.state.Load() == state && !f.owner.closed.Load() && f.proof.closed.Load() == 0 }
						}
						joined = func() bool { return f.owner.closed.Load() && f.proof.closed.Load() == 1 }
					case "connect":
						f := newDesktopCONNECTRuntimeFixture(t)
						invalidate = func() { f.valid.Store(false) }
						files, session, config = f.owner.files, f.construction.metadata.SessionID, f.construction.metadata.ConfigSHA256
						current, closeOwner = f.owner.loopCurrent, f.owner.close
						complete = &desktopObservationalCompleteFixture{start: f.owner.run, current: current, observe: observe, session: session, config: config}
						captureRetained = func() func() bool {
							state := f.owner.state.Load()
							return func() bool { return state != nil && f.owner.state.Load() == state && !f.owner.closed.Load() && f.proof.closed.Load() == 0 }
						}
						joined = func() bool { return f.owner.closed.Load() && f.proof.closed.Load() == 1 }
					case "execution":
						f := newDesktopExecutionRuntimeFixture(t)
						invalidate = func() { f.valid.Store(false) }
						files, session, config = f.owner.files, f.owner.meta.SessionID, f.owner.prep.ConfigSHA256()
						current, closeOwner = f.owner.loopCurrent, f.owner.close
						complete = &desktopObservationalCompleteFixture{start: f.owner.run, current: current, observe: observe, session: session, config: config}
						captureRetained = func() func() bool {
							state := f.owner.state.Load()
							return func() bool { return state != nil && f.owner.state.Load() == state && !f.owner.closed.Load() }
						}
						joined = func() bool { return f.owner.closed.Load() }

					}
					// An original parent marker identifies the exact loop callback.
					// Shared proof workers have their own lifetime and cannot satisfy
					// this barrier; bounded heartbeat reads are also excluded.
					parent, stopParent := context.WithCancel(context.WithValue(context.Background(), desktopObservationalContextKey{}, token))
					defer stopParent()
					registry := include.InboundRegistry()
					tun := &desktopNodeMTUHeartbeatFixture{entered: make(chan struct{}), release: make(chan struct{}), raw: desktopNetworkReceiptFixture(t, 17, 1420, strings.Repeat("d", 32))}
					close(tun.release)
					inbound.Register[option.TunInboundOptions](registry, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
						tun.Adapter = inbound.NewAdapter(C.TypeTun, tag)
						return tun, nil
					})
					graph, stopGraph := context.WithCancel(box.Context(context.Background(), registry, include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry()))
					defer stopGraph()
					options, err := SJ.UnmarshalExtendedContext[option.Options](graph, []byte(`{"log":{"disabled":true},"inbounds":[{"type":"tun","tag":"routervpn-chain-tun","interface_name":"router-vpn","mtu":1420,"address":["10.8.0.2/24"],"auto_route":false,"stack":"system"}],"outbounds":[{"type":"direct","tag":"direct"}],"route":{"auto_detect_interface":true,"final":"direct"}}`))
					if err != nil {
						t.Fatal(err)
					}
					instance, err := box.New(box.Options{Context: graph, Options: options})
					if err != nil {
						t.Fatal(err)
					}
					defer instance.Close()
					if err := instance.RouterVPNStrategyStart(); err != nil {
						t.Fatal(err)
					}
					done := make(chan error, 1)
					started := make(chan struct{})
					finished := false
					// This cleanup is registered after Box.Close, so it first
					// releases/joins the loop and original proof owner.
					defer func() {
						releaseOnce.Do(func() { close(release) })
						stopParent()
						stopGraph()
						if !finished {
							select {
							case <-done:
							case <-time.After(3 * time.Second):
								t.Error("observational loop failed to join")
							}
						}
						cleanup, cancel := context.WithTimeout(context.Background(), 3*time.Second)
						defer cancel()
						if err := closeOwner(cleanup); err != nil {
							t.Error("original observation owner cleanup", err)
						}
					}()
					go func() {
						var typed routerVPNNodeMTUComplete
						if complete != nil {
							typed = complete
						}
						done <- routerVPNRunNodeMTULoopWithComplete(parent, graph, files, instance, session, config, nil,
							func(ctx context.Context) error { return ctx.Err() }, func() error { close(started); return nil }, nil, typed, nil)
					}()
					// The original typed owner must complete startup and attach the
					// captured reader before the heartbeat observation begins. Source
					// validation is startup work; it cannot consume the heartbeat's
					// separate bound or make an absent heartbeat acceptable.
					startupDeadline := time.NewTimer(15 * time.Second)
					defer startupDeadline.Stop()
					select {
					case <-started:
						startupDeadline.Stop()
					case err := <-done:
						finished = true
						t.Fatal("observational loop failed before original reader attachment", err)
					case <-startupDeadline.C:
						t.Fatal("observational loop did not attach original reader")
					}
					deadline := time.NewTimer(3 * time.Second)
					tick := time.NewTicker(10 * time.Millisecond)
					defer deadline.Stop()
					defer tick.Stop()
					published := false
					for !published {
						raw, readErr := files.read("node-mtu-status.json", routerVPNNodeMTURecordLimit)
						var status routerVPNNodeMTURecord
						published = readErr == nil && routerVPNMTUStrict(raw, &status) && status.Schema == 1 &&
							status.Session == session && status.Config == config && status.Reader == 1 &&
							status.Interface == "router-vpn" && status.Index == 17 && status.MTU == 1420 &&
							status.Heartbeat > 0 && status.Failure == "" && !status.Active
						if published {
							break
						}
						select {
						case err := <-done:
							finished = true
							t.Fatal("observational loop failed before original heartbeat", err)
						case <-deadline.C:
							t.Fatalf("observational loop did not publish original heartbeat: read=%v record=%+v", readErr, status)
						case <-tick.C:
						}
					}
					retained := captureRetained()
					if !retained() {
						t.Fatal("observational loop lost original active owner")
					}
					armed.Store(true)
					var observing context.Context
					select {
					case observing = <-entered:
					case err := <-done:
						finished = true
						t.Fatal("observational loop exited before captured current", err)
					case <-time.After(3 * time.Second):
						t.Fatal("observational loop missed captured current")
					}
					switch fault {
					case "parent":
						stopParent()
					case "graph":
						stopGraph()
					case "foreign":
						foreign, cancel := context.WithCancel(context.Background())
						cancel()
						foreignContext = foreign
						if foreign.Err() == nil || parent.Err() != nil || graph.Err() != nil {
							t.Fatal("foreign cancellation changed original parent")
						}
					case "invalid-with-stop":
						invalidate()
						desktopExternalStopFile(t, files.root.Name(), session, config)
					}
					if fault == "parent" || fault == "graph" {
						select {
						case <-observing.Done():
						case <-time.After(3 * time.Second):
							t.Fatal("original observation did not receive cancellation")
						}
					}
					releaseOnce.Do(func() { close(release) })
					select {
					case err := <-done:
						finished = true
						if (err == nil) != (fault == "parent") {
							t.Fatal("observational Stop changed captured parent authority", err)
						}
					case <-time.After(3 * time.Second):
						t.Fatal("observational loop did not finish")
					}
					if !retained() {
						t.Fatal("loop return prematurely closed original owner")
					}
					cancelled, cancel := context.WithCancel(context.Background())
					cancel()
					if current(cancelled) == nil {
						t.Fatal("lower current admitted a cancelled observation")
					}
					cleanup, stopCleanup := context.WithTimeout(context.Background(), 3*time.Second)
					err = closeOwner(cleanup)
					stopCleanup()
					if err != nil || !joined() {
						t.Fatal("original observation owner did not join before Box close", err)
					}
				})
			}
		})
	}
