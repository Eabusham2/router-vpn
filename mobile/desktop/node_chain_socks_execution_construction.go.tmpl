package main

import (
	"context"
	"errors"

	box "github.com/sagernet/sing-box"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/adapter/outbound"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/include"
	"github.com/sagernet/sing-box/option"
	ownedSOCKS "github.com/sagernet/sing-box/protocol/routervpnnodesocks"
	"github.com/sagernet/sing/service"
)

// Execution owns a separate context capability. The Local SOCKS context is
// deliberately never installed here: only the exact preparation's observer
// may admit its selector trials, retained winner or replacement reader.
type routerVPNDesktopSOCKSExecutionConstruction struct {
	self        *routerVPNDesktopSOCKSExecutionConstruction
	preparation *mobilemultihop.NodeChainExecutionPreparation
	physical    *mobilemultihop.DesktopNodeChainSOCKSExecutionPhysicalPolicy
	policy      *mobilemultihop.DesktopNodeChainSOCKSPolicy
	source      *mobilemultihop.NodeChainSOCKSSource
	capture     *ownedSOCKS.Capture
	registry    *outbound.Registry
	ctx         context.Context
	config      string
	metadata    mobilemultihop.DesktopPhysicalMetadata
}

func routerVPNNewDesktopSOCKSExecutionConstruction(ctx context.Context, prep *mobilemultihop.NodeChainExecutionPreparation) (*routerVPNDesktopSOCKSExecutionConstruction, error) {
	if ctx == nil || ctx.Err() != nil || prep == nil {
		return nil, routerVPNExternalFailure
	}
	physical, err := prep.SOCKSDesktopPhysicalPolicy()
	if err != nil {
		return nil, err
	}
	policy, err := physical.OriginalDesktopSOCKSPolicy()
	if err != nil {
		return nil, err
	}
	source, err := policy.NativeSource()
	if err != nil {
		return nil, err
	}
	original, err := prep.OriginalSOCKSSource()
	if err != nil || original != source {
		return nil, errors.Join(err, routerVPNExternalFailure)
	}
	config, metadata, _, err := physical.PhysicalReadValidated()
	if err != nil || config != prep.Config() || metadata.ConfigSHA256 != prep.ConfigSHA256() || metadata.Kind != "node-chain-socks-execution" {
		return nil, errors.Join(err, routerVPNExternalFailure)
	}
	local := service.ContextWithDefaultRegistry(service.ExtendContext(ctx))
	capture, err := ownedSOCKS.NewCapture(local, source)
	if err != nil {
		return nil, err
	}
	registry := include.OutboundRegistry()
	if err := capture.Register(registry); err != nil {
		return nil, err
	}
	local = capture.Context()
	local = service.ContextWith[option.OutboundOptionsRegistry](local, registry)
	local = service.ContextWith[adapter.OutboundRegistry](local, registry)
	local, err = box.RouterVPNNodeSOCKSExecutionContext(local, prep, capture)
	if err != nil {
		return nil, err
	}
	result := &routerVPNDesktopSOCKSExecutionConstruction{preparation: prep, physical: physical, policy: policy,
		source: source, capture: capture, registry: registry, ctx: local, config: config, metadata: metadata}
	result.self = result
	return result, result.current(ctx)
}

func (c *routerVPNDesktopSOCKSExecutionConstruction) current(ctx context.Context) error {
	if ctx == nil || ctx.Err() != nil || c == nil || c.self != c || c.ctx == nil || c.ctx.Err() != nil ||
		c.preparation == nil || c.physical == nil || c.policy == nil || c.source == nil || c.capture == nil || c.registry == nil ||
		service.FromContext[adapter.OutboundRegistry](c.ctx) != c.registry || service.FromContext[option.OutboundOptionsRegistry](c.ctx) != c.registry {
		return routerVPNExternalFailure
	}
	physical, err := c.preparation.SOCKSDesktopPhysicalPolicy()
	if err != nil || physical != c.physical {
		return errors.Join(err, routerVPNExternalFailure)
	}
	policy, err := physical.OriginalDesktopSOCKSPolicy()
	if err != nil || policy != c.policy {
		return errors.Join(err, routerVPNExternalFailure)
	}
	source, err := policy.NativeSource()
	original, sourceErr := c.preparation.OriginalSOCKSSource()
	if err != nil || sourceErr != nil || source != c.source || original != c.source {
		return errors.Join(err, sourceErr, routerVPNExternalFailure)
	}
	config, metadata, _, err := physical.PhysicalReadValidated()
	if err != nil || config != c.config || config != c.preparation.Config() || metadata != c.metadata {
		return errors.Join(err, routerVPNExternalFailure)
	}
	return errors.Join(c.capture.RequireOriginalContext(c.ctx, c.source), ctx.Err())
}
