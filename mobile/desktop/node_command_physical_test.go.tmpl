func desktopNodeCommandHysteria2Original(t *testing.T, layer string) *mobilemultihop.NodeProfile {
	t.Helper()
	input, err := desktopNodeCommandOriginalWithLayer(t, layer).LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source struct {
		Profile string `json:"profile_json"`
		Start   string `json:"start"`
	}
	if json.Unmarshal([]byte(input), &source) != nil || source.Profile == "" {
		t.Fatal("Hysteria command lost its exact original node policy")
	}
	graph, _ := json.Marshal(map[string]any{"inbounds": []any{map[string]any{"type": "tun", "auto_route": true, "strict_route": true}},
		"outbounds": []any{map[string]any{"type": "hysteria2", "tag": "proxy", "server": "192.0.2.44", "server_port": 8443,
			"password": "captured-hysteria-password", "obfs": map[string]any{"type": "salamander", "password": "captured-hysteria-mask"},
			"tls": map[string]any{"enabled": true, "server_name": "captured-node.test"}}}, "route": map[string]any{"final": "proxy"}})
	files, _ := json.Marshal(map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString(graph)})
	original, err := mobilemultihop.NewNodeProfile("hysteria2", string(files), source.Profile, source.Start, "")
	if err != nil {
		t.Fatal(err)
	}
	return original
}

func desktopNodeCommandXrayOriginal(t *testing.T, mode, layer string) *mobilemultihop.NodeProfile {
	t.Helper()
	input, err := desktopNodeCommandOriginalWithLayer(t, layer).LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source struct {
		Profile string `json:"profile_json"`
		Start   string `json:"start"`
	}
	if json.Unmarshal([]byte(input), &source) != nil || source.Profile == "" {
		t.Fatal("Xray command lost its exact original node policy")
	}
	key, err := ecdh.X25519().NewPrivateKey([]byte(strings.Repeat("x", 32)))
	if err != nil {
		t.Fatal(err)
	}
	user := map[string]any{"id": "11111111-1111-4111-8111-111111111111", "flow": "xtls-rprx-vision", "encryption": "none"}
	stream := map[string]any{"network": "raw", "security": "reality", "realitySettings": map[string]any{
		"serverName": "captured-node.test", "fingerprint": "chrome", "password": base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()), "shortId": "0123456789abcdef"}}
	if mode != "reality-vision" {
		pq, err := mlkem.NewDecapsulationKey768([]byte(strings.Repeat("q", 64)))
		if err != nil {
			t.Fatal(err)
		}
		user["encryption"] = "mlkem768x25519plus.native.0rtt." + base64.RawURLEncoding.EncodeToString(pq.EncapsulationKey().Bytes())
	}
	if mode == "reality-xhttp" {
		delete(user, "flow")
		stream["network"] = "xhttp"
		stream["xhttpSettings"] = map[string]any{"path": "/captured-node", "mode": "auto"}
		stream["finalmask"] = map[string]any{"tcp": []any{map[string]any{"type": "fragment", "settings": map[string]any{
			"packets": "tlshello", "length": "100-300", "delay": "10-30", "maxSplit": "3-7"}}}}
	}
	xray := map[string]any{"inbounds": []any{map[string]any{"protocol": "socks", "listen": "127.0.0.1", "port": 1090, "settings": map[string]any{"auth": "noauth", "udp": true}}},
		"outbounds": []any{map[string]any{"protocol": "vless", "tag": "proxy", "settings": map[string]any{"vnext": []any{map[string]any{
			"address": "192.0.2.44", "port": 24443, "users": []any{user}}}}, "streamSettings": stream}}}
	wrapper := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "auto_route": true, "strict_route": true}},
		"outbounds": []any{map[string]any{"type": "socks", "tag": "proxy", "server": "127.0.0.1", "server_port": 1090, "version": "5"}}, "route": map[string]any{"final": "proxy"}}
	assets := make(map[string]string)
	for name, value := range map[string]any{"sing-box.json": wrapper, "xray.json": xray} {
		raw, err := json.Marshal(value)
		if err != nil {
			t.Fatal(err)
		}
		assets[name] = base64.StdEncoding.EncodeToString(raw)
	}
	files, _ := json.Marshal(assets)
	original, err := mobilemultihop.NewNodeProfile(mode, string(files), source.Profile, source.Start, "")
	if err != nil {
		t.Fatal(err)
	}
	return original
}

func TestRouterVPNDesktopNodePhysicalCommandXrayCompleteStartSource(t *testing.T) {
	for _, mode := range []string{"reality-vision", "reality-pq-vision", "reality-xhttp"} {
		for _, layer := range []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			label := layer
			if label == "" {
				label = "off"
			}
			t.Run(mode+"/"+label, func(t *testing.T) {
				original := desktopNodeCommandXrayOriginal(t, mode, layer)
				policy, err := mobilemultihop.NewDesktopNodePolicy(original, desktopExternalSession, "windows")
				if err != nil || policy == nil || policy.Config() == "" {
					t.Fatal("complete Xray command source did not compile its exact native policy", err)
				}
			})
		}
	}
}

func TestRouterVPNDesktopNodePhysicalCommandSourceBoundary(t *testing.T) {
	if policy, err := routerVPNNodeCommandPhysical(nil, "", "", ""); err != nil || policy != nil {
		t.Fatal("ordinary legacy node command unexpectedly selected a physical factory", err)
	}
	if runtime.GOOS != "windows" {
		if policy, err := routerVPNNodeCommandPhysical(nil, desktopExternalSession, strings.Repeat("b", 64), strings.Repeat("c", 64)); err == nil || policy != nil {
			t.Fatal("unsupported target adopted a Windows source flag")
		}
		return
	}
	cases := []string{"exact", "missing-source", "source-record", "derived-config", "source-hash", "config-hash", "session", "linked-source", "layer-aes", "layer-whitening", "hysteria2-off", "hysteria2-aes", "hysteria2-whitening"}
	for _, mode := range []string{"reality-vision", "reality-pq-vision", "reality-xhttp"} {
		for _, layer := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			cases = append(cases, "xray/"+mode+"/"+layer)
		}
	}
	for _, fault := range cases {
		t.Run(fault, func(t *testing.T) {
			original := desktopNodeCommandOriginal(t)
			if fault == "layer-aes" {
				original = desktopNodeCommandOriginalWithLayer(t, "aes-256-gcm")
			} else if fault == "layer-whitening" {
				original = desktopNodeCommandOriginalWithLayer(t, "aes-256-gcm+xor-whitening")
			} else if strings.HasPrefix(fault, "hysteria2-") {
				layer := ""
				if fault == "hysteria2-aes" {
					layer = "aes-256-gcm"
				} else if fault == "hysteria2-whitening" {
					layer = "aes-256-gcm+xor-whitening"
				}
				original = desktopNodeCommandHysteria2Original(t, layer)
			} else if strings.HasPrefix(fault, "xray/") {
				parts := strings.Split(fault, "/")
				layer := parts[2]
				if layer == "off" {
					layer = ""
				}
				original = desktopNodeCommandXrayOriginal(t, parts[1], layer)
			}
			policy, err := mobilemultihop.NewDesktopNodePolicy(original, desktopExternalSession, "windows")
			if err != nil {
				t.Fatal(err)
			}
			launch, err := original.LaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			directory := t.TempDir()
			if err := os.Chmod(directory, 0700); err != nil {
				t.Fatal(err)
			}
			staged := policy.Config()
			source, config, session := policy.Metadata().SourceSHA256, policy.Metadata().ConfigSHA256, desktopExternalSession
			switch fault {
			case "source-record":
				launch = strings.Replace(launch, "private-fixture-token", "foreign-fixture-token", 1)
			case "derived-config":
				staged += "\n"
			case "source-hash":
				source = strings.Repeat("f", 64)
			case "config-hash":
				config = strings.Repeat("f", 64)
			case "session":
				session = strings.Repeat("f", 32)
			}
			if err := os.WriteFile(filepath.Join(directory, "sing-box.json"), []byte(staged), 0600); err != nil {
				t.Fatal(err)
			}
			if fault != "missing-source" {
				name := "node-source.json"
				if fault == "linked-source" {
					name = "foreign-source.json"
				}
				if err := os.WriteFile(filepath.Join(directory, name), []byte(launch), 0600); err != nil {
					t.Fatal(err)
				}
				if fault == "linked-source" {
					if err := os.Symlink(name, filepath.Join(directory, "node-source.json")); err != nil {
						t.Fatal(err)
					}
				}
			}
			files, err := routerVPNOpenExternalFiles(directory)
			if err != nil {
				t.Fatal(err)
			}
			defer files.root.Close()
			actual, err := routerVPNNodeCommandPhysical(files, session, config, source)
			if fault == "exact" || fault == "layer-aes" || fault == "layer-whitening" || strings.HasPrefix(fault, "hysteria2-") || strings.HasPrefix(fault, "xray/") {
				if err != nil || actual == nil || actual.Config() != policy.Config() || !reflect.DeepEqual(actual.Metadata(), policy.Metadata()) {
					t.Fatal("exact private inputs did not reconstruct their captured native policy", err)
				}
			} else if err == nil || actual != nil {
				t.Fatal("node command adopted changed source or staged derived authority", fault)
			}
		})
	}
}

func TestRouterVPNDesktopNodePhysicalCommandRestoredMTU(t *testing.T) {
	if policy, err := routerVPNNodeCommandPhysicalWithMTU(nil, "", "", "", 1392); err == nil || policy != nil {
		t.Fatal("legacy command admitted an unbound restored MTU")
	}
	if runtime.GOOS != "windows" {
		if policy, err := routerVPNNodeCommandPhysicalWithMTU(nil, desktopExternalSession, strings.Repeat("b", 64), strings.Repeat("c", 64), 1392); err == nil || policy != nil {
			t.Fatal("unsupported target adopted restored Windows source")
		}
		return
	}
	for _, fault := range []string{"exact", "equal-configured", "missing", "different", "too-small", "too-large", "negative", "source-dropped"} {
		t.Run(fault, func(t *testing.T) {
			original := desktopNodeCommandOriginal(t)
			restored := 1392
			if fault == "equal-configured" {
				capture, err := original.DesktopCapture()
				if err != nil {
					t.Fatal(err)
				}
				restored = capture.ConfiguredMTU
			}
			policy, err := mobilemultihop.NewDesktopNodePolicyWithMTU(original, desktopExternalSession, "windows", restored)
			if err != nil {
				t.Fatal(err)
			}
			input, err := original.LaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			directory := t.TempDir()
			if err := os.Chmod(directory, 0700); err != nil {
				t.Fatal(err)
			}
			for name, content := range map[string]string{"node-source.json": input, "sing-box.json": policy.Config()} {
				if err := os.WriteFile(filepath.Join(directory, name), []byte(content), 0600); err != nil {
					t.Fatal(err)
				}
			}
			files, err := routerVPNOpenExternalFiles(directory)
			if err != nil {
				t.Fatal(err)
			}
			defer files.root.Close()
			argument, source := restored, policy.Metadata().SourceSHA256
			switch fault {
			case "missing":
				argument = 0
			case "different":
				argument = 1380
			case "too-small":
				argument = 1279
			case "too-large":
				argument = 9001
			case "negative":
				argument = -1
			case "source-dropped":
				source = ""
			}
			actual, err := routerVPNNodeCommandPhysicalWithMTU(files, desktopExternalSession, policy.Metadata().ConfigSHA256, source, argument)
			if fault == "exact" || fault == "equal-configured" {
				if err != nil || actual == nil || actual.Config() != policy.Config() || !reflect.DeepEqual(actual.Metadata(), policy.Metadata()) {
					t.Fatal("captured live MTU did not recompile the original private graph", err)
				}
			} else if err == nil || actual != nil {
				t.Fatal("changed or missing restored MTU acquired native authority", fault)
			}
		})
	}
}

func desktopNodeCommandTransferFixture(t *testing.T) (*mobilemultihop.DesktopNodePolicy, mobiletor.DesktopProtectionTransferRecord) {
	t.Helper()
	policy, err := mobilemultihop.NewDesktopNodePolicy(desktopNodeCommandOriginal(t), desktopExternalSession, "windows")
	if err != nil {
		t.Fatal(err)
	}
	meta := policy.Metadata()
	expected := mobiletor.DesktopProtectionTransferRecord{Schema: 1, Kind: "routervpn-windows-protection-transfer-v1", SessionID: meta.SessionID,
		SourceSHA256: meta.SourceSHA256, ConfigSHA256: meta.ConfigSHA256, Policy: meta.KillSwitchPolicy,
		Predecessor: &mobiletor.DesktopWindowsProtectionTarget{Capture: mobiletor.DesktopSocketCapture{SessionID: strings.Repeat("f", 32),
			SourceSHA256: strings.Repeat("e", 64), NetworkID: strings.Repeat("d", 32)}, Policy: "always", BaselineSHA256: strings.Repeat("c", 64)}}
	return policy, expected
}

func TestRouterVPNDesktopNodePhysicalCommandTransferInput(t *testing.T) {
	for _, fault := range []string{"exact", "initial", "missing-hash", "wrong-hash", "missing-file", "session", "source", "config", "policy", "invalid-old", "noncanonical", "duplicate", "linked", "dropped-physical", "unexpected-legacy"} {
		t.Run(fault, func(t *testing.T) {
			policy, expected := desktopNodeCommandTransferFixture(t)
			switch fault {
			case "initial":
				expected.Predecessor = nil
			case "session":
				expected.SessionID = strings.Repeat("b", 32)
			case "source":
				expected.SourceSHA256 = strings.Repeat("b", 64)
			case "config":
				expected.ConfigSHA256 = strings.Repeat("b", 64)
			case "policy":
				expected.Policy = "on-connect"
			case "invalid-old":
				expected.Predecessor.Capture.NetworkID = ""
			}
			raw, _ := json.Marshal(expected)
			if fault == "noncanonical" {
				raw = append(raw, '\n')
			} else if fault == "duplicate" {
				raw = append(raw[:len(raw)-1], []byte(`,"schema":1}`)...)
			}
			sum := sha256.Sum256(raw)
			digest := hex.EncodeToString(sum[:])
			if fault == "missing-hash" || fault == "unexpected-legacy" {
				digest = ""
			}
			if fault == "wrong-hash" {
				digest = strings.Repeat("0", 64)
			}
			if fault == "dropped-physical" || fault == "unexpected-legacy" {
				policy = nil
			}
			directory := t.TempDir()
			if err := os.Chmod(directory, 0700); err != nil {
				t.Fatal(err)
			}
			files, err := routerVPNOpenExternalFiles(directory)
			if err != nil {
				t.Fatal(err)
			}
			defer files.root.Close()
			if fault != "missing-file" {
				name := "node-protection-transfer.json"
				if fault == "linked" {
					name = "foreign-transfer.json"
				}
				if err := os.WriteFile(filepath.Join(directory, name), raw, 0600); err != nil {
					t.Fatal(err)
				}
				if fault == "linked" {
					if err := os.Symlink(name, filepath.Join(directory, "node-protection-transfer.json")); err != nil {
						t.Fatal(err)
					}
				}
			}
			actual, err := routerVPNNodeCommandTransfer(files, policy, digest)
			if fault == "exact" || fault == "initial" {
				if err != nil || actual == nil || !reflect.DeepEqual(*actual, expected) {
					t.Fatal("captured private predecessor did not survive command parsing", err)
				}
				if actual.Predecessor != nil {
					if err := os.WriteFile(filepath.Join(directory, "node-protection-transfer.json"), []byte("replacement"), 0600); err != nil {
						t.Fatal(err)
					}
					if *actual.Predecessor != *expected.Predecessor {
						t.Fatal("parsed predecessor changed with its private pathname")
					}
				}
			} else if err == nil || actual != nil {
				t.Fatal("command accepted missing, changed or unbound predecessor input", fault)
			}
		})
	}
}

type desktopNodeCommandRetiredOwner struct {
	target   *mobiletor.DesktopWindowsProtectionTarget
	captured bool
	failure  error
}

func (o *desktopNodeCommandRetiredOwner) RetainedProtection(context.Context) (*mobiletor.DesktopWindowsProtectionTarget, bool, error) {
	return o.target, o.captured, o.failure
}

func TestRouterVPNDesktopNodePhysicalCommandRetirementReceipt(t *testing.T) {
	for _, fault := range []string{"own", "unchanged", "absent", "no-source", "no-owner", "read-failed", "owner-failed", "other-source", "lost-deny", "replaced-receipt"} {
		t.Run(fault, func(t *testing.T) {
			policy, expected := desktopNodeCommandTransferFixture(t)
			directory := t.TempDir()
			if err := os.Chmod(directory, 0700); err != nil {
				t.Fatal(err)
			}
			files, err := routerVPNOpenExternalFiles(directory)
			if err != nil {
				t.Fatal(err)
			}
			defer files.root.Close()
			target := &mobiletor.DesktopWindowsProtectionTarget{Capture: mobiletor.DesktopSocketCapture{SessionID: expected.SessionID,
				SourceSHA256: expected.SourceSHA256, NetworkID: strings.Repeat("2", 32)}, Policy: expected.Policy, BaselineSHA256: strings.Repeat("3", 64)}
			retired := &desktopNodeCommandRetiredOwner{target: target, captured: true}
			var owner routerVPNNodeProtectionOwner = retired
			switch fault {
			case "unchanged":
				retired.target = expected.Predecessor
			case "absent":
				expected.Predecessor = nil
				retired.target = nil
			case "no-source", "read-failed":
				retired.target = nil
				retired.captured = false
			case "no-owner":
				owner = nil
			case "owner-failed":
				retired.failure = errors.New("native cleanup pending")
			case "other-source":
				retired.target.Capture.SourceSHA256 = strings.Repeat("7", 64)
			case "lost-deny":
				retired.target = nil
			case "replaced-receipt":
				if err := os.WriteFile(filepath.Join(directory, "node-protection-retired.json"), []byte("replacement-owner"), 0600); err != nil {
					t.Fatal(err)
				}
			}
			reads := 0
			verify := func(ctx context.Context, actual *mobiletor.DesktopWindowsProtectionTarget) error {
				reads++
				deadline, bounded := ctx.Deadline()
				if !bounded || time.Until(deadline) > 3*time.Second || time.Until(deadline) <= 0 || !reflect.DeepEqual(actual, expected.Predecessor) {
					t.Fatal("fallback read lost its bounded exact expected state")
				}
				if fault == "read-failed" {
					return errors.New("native expected state changed")
				}
				return nil
			}
			err = routerVPNRetireNodeProtection(files, policy, &expected, owner, verify)
			valid := fault == "own" || fault == "unchanged" || fault == "absent" || fault == "no-source" || fault == "no-owner"
			if (err == nil) != valid {
				t.Fatal("retirement did not preserve its explicit outcome", fault, err)
			}
			expectedReads := 0
			if fault == "no-source" || fault == "no-owner" || fault == "read-failed" {
				expectedReads = 1
			}
			if reads != expectedReads {
				t.Fatal("failed native source silently fell back to a different protection read")
			}
			raw, readErr := os.ReadFile(filepath.Join(directory, "node-protection-retired.json"))
			if valid {
				record, parseErr := mobiletor.ParseDesktopProtectionRetirementRecord(raw, expected)
				if readErr != nil || parseErr != nil {
					t.Fatal("joined command omitted its canonical protection receipt", readErr, parseErr)
				}
				want := retired.target
				if expectedReads != 0 {
					want = expected.Predecessor
				}
				if !reflect.DeepEqual(record.Target, want) {
					t.Fatal("published receipt changed its captured native result")
				}
			} else if fault == "replaced-receipt" {
				if readErr != nil || string(raw) != "replacement-owner" {
					t.Fatal("cleanup changed a replacement receipt", readErr)
				}
			} else if !errors.Is(readErr, os.ErrNotExist) {
				t.Fatal("failed protection read published a cleanup receipt", readErr)
			}
		})
	}
}
