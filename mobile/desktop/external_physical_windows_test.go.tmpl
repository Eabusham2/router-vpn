//go:build windows

package routervpndesktoppt

import (
	"context"
	"net/netip"
	"reflect"
	"testing"

	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

func TestRouterVPNExternalPhysicalWindowsCapturesPolicyAndRetainsLateOwner(t *testing.T) {
	runExternalPhysicalFactoryCases(t, func(t *testing.T, c *externalPhysicalFactoryCase) error {
		wantInterfaces, wantLAN, err := desktopWindowsPhysicalInterfaces(c.selected, c.ipv6 != "off", c.lan)
		if err != nil {
			t.Fatal(err)
		}
		wantDHCP, err := mobiletor.DesktopWindowsPhysicalDHCPServers(uint32(c.selected.Index))
		if err != nil {
			t.Fatal(err)
		}
		wantPrivate := []mobiletor.DesktopWindowsSocketDestination{
			{Network: "tcp", Address: netip.MustParseAddrPort("192.168.50.7:8443")},
			{Network: "udp", Address: netip.MustParseAddrPort("192.168.50.7:8443")},
		}
		return c.fixture.network.prepareExternalPhysicalWindows(c.fixture.policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, options mobiletor.DesktopWindowsSocketOptions) (desktopWindowsPhysicalPolicy, error) {
			if options.KillSwitchPolicy != c.kill || options.IPv6Enabled != (c.ipv6 != "off") || !reflect.DeepEqual(options.Interfaces, wantInterfaces) ||
				!reflect.DeepEqual(options.LANPrefixes, wantLAN) || !reflect.DeepEqual(options.DHCP4Servers, wantDHCP) ||
				!reflect.DeepEqual(options.PrivateDestinations, wantPrivate) {
				t.Error("Windows ordinary factory changed selected protection, exact private destinations, actual LAN or DHCP", options)
			}
			if len(options.Interfaces) < 1 || c.ipv6 == "off" && (len(options.Interfaces) != 1 || !options.Interfaces[0].Address.Is4()) {
				t.Error("Windows ordinary factory enabled an unselected physical family")
			}
			return c.source, c.constructed(t, ctx, capture)
		})
	})
}
