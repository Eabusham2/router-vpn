//go:build linux

package box

import (
	"context"
	"errors"
	"fmt"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/nativeopenvpn"
	"net"
	"net/netip"
	"os"
	"os/exec"
	"testing"
)

// The original guardian carrier owns these disconnected veth namespaces.
const desktopOpenVPNCompositionPeerAddress = "198.18.0.2"
const desktopOpenVPNCompositionClientAddress = "198.18.0.1"
const desktopOpenVPNCompositionPeerArgument = "routervpn-openvpn-composition-peer"

func init() {
	if len(os.Args) == 2 && os.Args[1] == desktopOpenVPNCompositionPeerArgument {
		if err := desktopOpenVPNCompositionPeerMain(); err != nil {
			fmt.Fprintln(os.Stderr, "owned OpenVPN provider fixture failed:", err)
			os.Exit(84)
		}
		os.Exit(0)
	}
}

func desktopOpenVPNCompositionPeerMain() error {
	if os.Geteuid() != 0 || os.Getenv("ROUTERVPN_LINUX_GUARDIAN_TEST_NS") != "1" {
		return errors.New("provider requires original private namespace")
	}
	iface, err := net.InterfaceByName("rvpn-peer")
	if err != nil || iface.Flags&net.FlagUp == 0 {
		return errors.New("provider lost actual peer interface")
	}
	return desktopOpenVPNReferenceServe(desktopOpenVPNCompositionPeerAddress)
}

func desktopOpenVPNCompositionStartPeer(t *testing.T, request desktopOpenVPNCompositionPeerInput) *desktopOpenVPNCompositionProcess {
	return desktopOpenVPNReferenceStart(t, request, desktopOpenVPNCompositionPeerAddress, func(ctx context.Context) *exec.Cmd {
		return exec.CommandContext(ctx, "ip", "netns", "exec", "rvpn-peer", "/opt/routervpn-guardian-proof/guardian.test", desktopOpenVPNCompositionPeerArgument)
	})
}

func desktopOpenVPNCompositionNew(t *testing.T, process *desktopOpenVPNCompositionProcess, profile nativeopenvpn.Profile, remotes []nativeopenvpn.Remote, session string) *desktopOpenVPNCompositionFixture {
	t.Helper()
	iface, err := net.InterfaceByName("rvpn-test")
	if err != nil || iface.Flags&net.FlagUp == 0 {
		t.Fatal("actual client veth is unavailable", err)
	}
	return desktopOpenVPNReferenceNew(t, process, profile, remotes, session, "linux", netip.MustParseAddr(desktopOpenVPNCompositionClientAddress), *iface)
}

func TestDesktopLinuxGuardianKernelExternalOpenVPN(t *testing.T) {
	if os.Geteuid() != 0 || os.Getenv("ROUTERVPN_LINUX_GUARDIAN_TEST_NS") != "1" {
		t.Fatal("mandatory OpenVPN composition requires the original owned namespace carrier")
	}
	iface, err := net.InterfaceByName("rvpn-test")
	if err != nil || iface.Flags&net.FlagUp == 0 || iface.Flags&net.FlagLoopback != 0 {
		t.Fatal("actual OpenVPN client veth missing", err)
	}
	addresses, err := iface.Addrs()
	if err != nil {
		t.Fatal(err)
	}
	owned := false
	for _, address := range addresses {
		prefix, err := netip.ParsePrefix(address.String())
		if err == nil && prefix.Addr().String() == desktopOpenVPNCompositionClientAddress && prefix.Bits() == 30 {
			owned = true
		}
	}
	if !owned {
		t.Fatal("actual OpenVPN client address differs from namespace carrier")
	}
	desktopOpenVPNCompositionRun(t, desktopOpenVPNCompositionStartPeer, desktopOpenVPNCompositionNew)
}
