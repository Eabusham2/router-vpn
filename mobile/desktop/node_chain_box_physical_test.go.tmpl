func TestRouterVPNDesktopNodeChainPhysicalHysteriaFinalLayerChangedBox(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		for _, fault := range []string{"outer-key", "inner-detour"} {
			t.Run(layer+"_"+fault, func(t *testing.T) {
				original := desktopChainPhysicalHysteriaSource(t, "wg", layer)
				policy, err := mobilemultihop.NewDesktopNodeChainPolicy(original, desktopTorBoxSession, runtime.GOOS, 0)
				if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
					t.Fatal("original layered policy failed before substitution", err)
				}
				changed := 0
				instance, tun := desktopChainPhysicalBox(t, policy, func(graph map[string]any) {
					for _, raw := range graph["outbounds"].([]any) {
						out := raw.(map[string]any)
						if fault == "outer-key" && (out["type"] == "shadowsocks" || out["type"] == "routervpn-aes-xor") {
							out["password"] = base64.StdEncoding.EncodeToString([]byte(strings.Repeat("z", 32)))
							changed++
						}
						if fault == "inner-detour" && out["type"] == "hysteria2" {
							out["detour"] = original.ProofInventory()[0].Tag
							changed++
						}
					}
				})
				if changed != 1 {
					t.Fatal("layer substitution did not reach exactly its original outbound")
				}
				if _, _, err := instance.routerVPNDesktopNodePhysical(policy); err == nil {
					t.Fatal("changed Hysteria2 outer layer or detour borrowed original physical authority")
				}
				if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil || tun.ready || tun.claimed {
					t.Fatal("changed Hysteria2 layer acquired the original TUN")
				}
			})
		}
	}
}

