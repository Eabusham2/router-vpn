// The actual Box parses all complete prefix objects and captures its real
// options at construction. The explicit TUN fixture owns no kernel interface.
// These construction tests never claim encrypted or OS routing acceptance.
func desktopChainPhysicalBox(t *testing.T, policy interface{ Config() string },
	change func(map[string]any)) (*Box, *desktopTorBoxTUN) {
	t.Helper()
	var graph map[string]any
	if json.Unmarshal([]byte(policy.Config()), &graph) != nil {
		t.Fatal("chain physical test lost its sealed source")
	}
	if change != nil {
		change(graph)
	}
	raw, err := json.Marshal(graph)
	if err != nil {
		t.Fatal(err)
	}
	var tun *desktopTorBoxTUN
	ins := inbound.NewRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun,
		func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.TunInboundOptions) (adapter.Inbound, error) {
			tun = &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag), name: options.InterfaceName, index: 772, mtu: int(options.MTU)}
			return tun, nil
		})
	outs := outbound.NewRegistry()
	group.RegisterSelector(outs)
	G.RegisterOutbound(outs)
	shadowsocks.RegisterOutbound(outs)
	hysteria2.RegisterOutbound(outs)
	routervpndesktoppt.RegisterNodePhysicalOutbound(outs)
	endpoints := endpoint.NewRegistry()
	wireguard.RegisterEndpoint(endpoints)
	AWG.RegisterEndpoint(endpoints)
	resolvers := dns.NewTransportRegistry()
	DNST.RegisterUDP(resolvers)
	services := boxService.NewRegistry()
	routervpndesktoppt.RegisterNodeNetworkOwner(services)
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx = Context(ctx, ins, outs, endpoints, resolvers, services, certificate.NewRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
	if err != nil {
		t.Fatal("actual ordered graph parse", err)
	}
	options.Log = &option.LogOptions{Disabled: true}
	instance, err := New(Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal("actual ordered Box construction", err)
	}
	t.Cleanup(func() {
		if err := instance.Close(); err != nil {
			t.Error("original ordered Box did not retire", err)
		}
	})
	if tun == nil {
		t.Fatal("actual ordered Box omitted its TUN constructor")
	}
	return instance, tun
}

func TestRouterVPNDesktopNodeChainPhysicalCapturesActualBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("this physical adapter covers Linux and Windows")
	}
	policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSource(t), desktopTorBoxSession, runtime.GOOS, 0)
	if err != nil {
		t.Fatal(err)
	}
	instance, tun := desktopChainPhysicalBox(t, policy, nil)
	if !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
		t.Fatal("exact complete chain lost its typed physical factory")
	}
	_, network, err := instance.routerVPNDesktopNodePhysical(policy)
	if err != nil || network == nil || tun.ready || tun.claimed || network.Current() || network.SocketCurrent() {
		t.Fatal("construction fabricated native preparation or readiness", err)
	}
	if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
		t.Fatal("unprepared ordered graph acquired physical TUN authority")
	}
	if instance.routerVPNNodeChainOptions == "" {
		t.Fatal("Box.New omitted its actual ordered configuration snapshot")
	}
	if err := instance.RouterVPNStrategyStart(); err == nil {
		t.Fatal("ordered JSON bypassed original native physical preparation")
	}
	if tun.ready || tun.claimed || network.SocketCurrent() {
		t.Fatal("unprepared ordered graph reached native sockets or TUN")
	}
}

func TestRouterVPNDesktopNodeChainPhysicalRejectsSubstitutedBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("this physical adapter covers Linux and Windows")
	}
	for _, fault := range []string{"middle-key", "dns", "physical-source", "mtu", "interface"} {
		t.Run(fault, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSource(t), desktopTorBoxSession, runtime.GOOS, 0)
			if err != nil {
				t.Fatal(err)
			}
			instance, tun := desktopChainPhysicalBox(t, policy, func(graph map[string]any) {
				switch fault {
				case "middle-key":
					rows := graph["endpoints"].([]any)
					rows[1].(map[string]any)["private_key"] = rows[0].(map[string]any)["private_key"]
				case "dns":
					for _, raw := range graph["dns"].(map[string]any)["servers"].([]any) {
						server := raw.(map[string]any)
						if server["tag"] == policy.NodeChain().DNSCapture().ResolverTag {
							server["server"] = "192.168.50.134"
						}
					}
				case "physical-source":
					graph["services"].([]any)[0].(map[string]any)["source_sha256"] = strings.Repeat("f", 64)
				case "mtu":
					tun := graph["inbounds"].([]any)[0].(map[string]any)
					tun["mtu"] = tun["mtu"].(float64) + 16
				case "interface":
					graph["inbounds"].([]any)[0].(map[string]any)["interface_name"] = "foreign-chain"
				}
			})
			if _, _, err := instance.routerVPNDesktopNodePhysical(policy); err == nil {
				t.Fatal("changed running chain acquired the original physical authority")
			}
			if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
				t.Fatal("changed running chain acquired a native TUN")
			}
			if tun.ready || tun.claimed {
				t.Fatal("changed chain entered native startup")
			}
		})
	}
}

// Every position before the SS2022 final retains its exact declared WG/AWG
// mode. The native constructors here are real; only the privileged TUN is a
// boundary double, and no preparation is manufactured to start a native path.
func TestRouterVPNDesktopNodeChainPhysicalAWGModesAndOriginalBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("this physical adapter covers Linux and Windows")
	}
	for _, modes := range [][]string{
		{"awg2-fast", "wg"}, {"awg2-strong", "wg"},
		{"wg", "awg2-fast"}, {"wg", "awg2-strong"},
		{"wg", "awg2-fast", "wg"}, {"wg", "awg2-strong", "wg"},
		{"awg2-fast", "awg2-strong", "wg"}, {"awg2-strong", "wg", "awg2-fast"},
	} {
		t.Run(strings.Join(modes, "/"), func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSourceModes(t, modes), desktopTorBoxSession, runtime.GOOS, 0)
			if err != nil {
				t.Fatal(err)
			}
			instance, tun := desktopChainPhysicalBox(t, policy, nil)
			if !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
				t.Fatal("exact mixed chain lost its typed physical factory")
			}
			meta := policy.Metadata()
			for position, mode := range append(append([]string(nil), modes...), "shadowsocks") {
				prefix := meta.Prefixes[position]
				if prefix.Position != position || prefix.Mode != mode || prefix.ProfileID == "" || prefix.NodeID == "" || prefix.SourceSHA256 == "" {
					t.Fatal("physical factory changed an original prefix mode or proof identity", position)
				}
			}
			_, network, err := instance.routerVPNDesktopNodePhysical(policy)
			if err != nil || network == nil || tun.ready || tun.claimed || network.Current() || network.SocketCurrent() {
				t.Fatal("mixed construction fabricated preparation or lost its exact Box", err)
			}
			t.Run("different-original-mode", func(t *testing.T) {
				otherModes := append([]string(nil), modes...)
				for i, mode := range otherModes {
					if mode == "awg2-fast" {
						otherModes[i] = "awg2-strong"
						break
					}
					if mode == "awg2-strong" {
						otherModes[i] = "awg2-fast"
						break
					}
				}
				other, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSourceModes(t, otherModes), desktopTorBoxSession, runtime.GOOS, 0)
				if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(other, runtime.GOOS) {
					t.Fatal("replacement must be independently valid before testing original ownership", err)
				}
				if other.Metadata().SourceSHA256 == meta.SourceSHA256 {
					t.Fatal("changing an original mode retained the previous source identity")
				}
				if _, _, err := instance.routerVPNDesktopNodePhysical(other); err == nil {
					t.Fatal("another original mode acquired the existing native Box")
				}
				if owner, err := instance.routerVPNDesktopNodeActivatePhysical(other); err == nil || owner != nil {
					t.Fatal("another original mode acquired the retained TUN")
				}
			})
			if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
				t.Fatal("unprepared mixed chain acquired physical TUN authority")
			}
			if err := instance.RouterVPNStrategyStart(); err == nil {
				t.Fatal("mixed ordered JSON bypassed original physical preparation")
			}
			if tun.ready || tun.claimed || network.SocketCurrent() {
				t.Fatal("unprepared mixed chain reached native sockets or TUN")
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainPhysicalRejectsChangedModeProof(t *testing.T) {
	for _, fault := range []string{"unsupported-prefix", "mode-alias", "final-as-prefix", "wrong-original-mode", "wrong-final", "wrong-position"} {
		t.Run(fault, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSourceModes(t, []string{"wg", "awg2-fast", "awg2-strong"}), desktopTorBoxSession, "linux", 0)
			if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(policy, "linux") {
				t.Fatal("mode receipt control has no valid original policy", err)
			}
			// Mutation is confined to this negative fixture. The shipping caller
			// receives no way to construct or edit this sealed policy metadata.
			meta := chainNativeField[mobilemultihop.DesktopNodeChainMetadata](t, policy, "metadata")
			switch fault {
			case "unsupported-prefix":
				meta.Prefixes[1].Mode = "max-wg"
			case "mode-alias":
				meta.Prefixes[1].Mode = "amneziawg"
			case "final-as-prefix":
				meta.Prefixes[1].Mode = "shadowsocks"
			case "wrong-original-mode":
				meta.Prefixes[1].Mode = "awg2-strong"
			case "wrong-final":
				meta.Prefixes[len(meta.Prefixes)-1].Mode = "wg"
			case "wrong-position":
				meta.Prefixes[1].Position = 0
			}
			if routerVPNDesktopNodeChainPhysicalTarget(policy, "linux") {
				t.Fatal("changed mode/proof receipt acquired typed physical authority")
			}
		})
	}
}

func desktopChainPhysicalHysteriaSource(t *testing.T, mode string) *mobilemultihop.NodeChain {
	t.Helper()
	original, err := chainNativeSourceModes(t, []string{mode}).LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(original), &source) != nil {
		t.Fatal("original paired chain missing")
	}
	var final struct {
		Profile string `json:"profile_json"`
	}
	if json.Unmarshal([]byte(source.Nodes[1]), &final) != nil || final.Profile == "" {
		t.Fatal("original paired final missing")
	}
	var profile map[string]any
	if json.Unmarshal([]byte(final.Profile), &profile) != nil {
		t.Fatal("original paired profile malformed")
	}
	ca := newDesktopExternalIntegrationCA(t)
	graph := map[string]any{
		"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "auto_route": true, "strict_route": true}},
		"outbounds": []any{map[string]any{"type": "hysteria2", "tag": "proxy", "server": profile["endpoint"], "server_port": 443,
			"password": "original-final-password", "obfs": map[string]any{"type": "salamander", "password": "original-final-mask"},
			"tls": map[string]any{"enabled": true, "server_name": "captured-proxy.example", "certificate_path": "cert.pem"}}},
		"route": map[string]any{"final": "proxy", "rules": []any{}},
	}
	assets := map[string]string{
		"sing-box.json": base64.StdEncoding.EncodeToString([]byte(chainNativeJSON(t, graph))),
		"cert.pem":      base64.StdEncoding.EncodeToString(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: ca.der})),
	}
	node, err := mobilemultihop.NewNodeProfile("hysteria2", chainNativeJSON(t, assets), final.Profile, "", "")
	if err != nil {
		t.Fatal(err)
	}
	source.Nodes[1], err = node.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	chain, err := mobilemultihop.NewNodeChain(chainNativeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	return chain
}

func TestRouterVPNDesktopNodeChainPhysicalHysteriaCapturesActualBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("this physical adapter covers Linux and Windows")
	}
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		t.Run(mode, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(desktopChainPhysicalHysteriaSource(t, mode), desktopTorBoxSession, runtime.GOOS, 0)
			if err != nil {
				t.Fatal(err)
			}
			if !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
				t.Fatal("exact paired Hysteria2 final lost its typed physical factory")
			}
			instance, tun := desktopChainPhysicalBox(t, policy, nil)
			_, network, err := instance.routerVPNDesktopNodePhysical(policy)
			if err != nil || network == nil || tun.ready || tun.claimed || network.Current() || network.SocketCurrent() {
				t.Fatal("Hysteria2 construction fabricated native readiness", err)
			}
			meta := policy.Metadata()
			if meta.Prefixes[0].Mode != mode || meta.Prefixes[1].Mode != "hysteria2" || meta.Prefixes[1].StartLayer != "off" {
				t.Fatal("Hysteria2 factory changed original prefix/final proof")
			}
			if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
				t.Fatal("unprepared Hysteria2 acquired physical authority")
			}
			if err := instance.RouterVPNStrategyStart(); err == nil {
				t.Fatal("Hysteria2 JSON bypassed original native preparation")
			}
			if tun.ready || tun.claimed || network.SocketCurrent() {
				t.Fatal("unprepared Hysteria2 reached native sockets or TUN")
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainPhysicalHysteriaKeepsTypedScope(t *testing.T) {
	for _, target := range []string{"linux", "windows", "darwin"} {
		t.Run(target, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(desktopChainPhysicalHysteriaSource(t, "wg"), desktopTorBoxSession, target, 0)
			if err != nil {
				t.Fatal(err)
			}
			if routerVPNDesktopNodeChainPhysicalTarget(policy, target) != (target != "darwin") {
				t.Fatal("Hysteria2 factory lost exact supported platform boundary")
			}
			if routerVPNDesktopNodeChainPhysicalTarget(policy, "foreign") {
				t.Fatal("Hysteria2 factory accepted another platform")
			}
		})
	}
	for _, fault := range []string{"layer", "mode", "position", "target"} {
		t.Run(fault, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(desktopChainPhysicalHysteriaSource(t, "wg"), desktopTorBoxSession, "linux", 0)
			if err != nil {
				t.Fatal(err)
			}
			meta := chainNativeField[mobilemultihop.DesktopNodeChainMetadata](t, policy, "metadata")
			switch fault {
			case "layer":
				meta.Prefixes[1].StartLayer = "aes-256-gcm"
			case "mode":
				meta.Prefixes[1].Mode = "shadowsocks"
			case "position":
				meta.Prefixes[1].Position = 0
			case "target":
				meta.TargetOS = "windows"
			}
			if routerVPNDesktopNodeChainPhysicalTarget(policy, meta.TargetOS) {
				t.Fatal("changed Hysteria2 receipt acquired typed physical authority")
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainPhysicalHysteriaRejectsSubstitutedBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("this physical adapter covers Linux and Windows")
	}
	for _, fault := range []string{"password", "sni", "mask", "detour", "dns", "mtu", "physical-source", "interface"} {
		t.Run(fault, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(desktopChainPhysicalHysteriaSource(t, "awg2-strong"), desktopTorBoxSession, runtime.GOOS, 0)
			if err != nil {
				t.Fatal(err)
			}
			instance, tun := desktopChainPhysicalBox(t, policy, func(graph map[string]any) {
				for _, row := range graph["outbounds"].([]any) {
					out := row.(map[string]any)
					if out["type"] != "hysteria2" {
						continue
					}
					switch fault {
					case "password":
						out["password"] = "another-password"
					case "sni":
						out["tls"].(map[string]any)["server_name"] = "another.example"
					case "mask":
						out["obfs"].(map[string]any)["password"] = "another-mask"
					case "detour":
						delete(out, "detour")
					}
				}
				switch fault {
				case "dns":
					for _, raw := range graph["dns"].(map[string]any)["servers"].([]any) {
						row := raw.(map[string]any)
						if row["tag"] == policy.NodeChain().DNSCapture().ResolverTag {
							row["server"] = "192.168.50.134"
						}
					}
				case "mtu":
					row := graph["inbounds"].([]any)[0].(map[string]any)
					row["mtu"] = row["mtu"].(float64) + 16
				case "physical-source":
					graph["services"].([]any)[0].(map[string]any)["source_sha256"] = strings.Repeat("f", 64)
				case "interface":
					graph["inbounds"].([]any)[0].(map[string]any)["interface_name"] = "foreign-chain"
				}
			})
			if _, _, err := instance.routerVPNDesktopNodePhysical(policy); err == nil {
				t.Fatal("changed Hysteria2 Box borrowed original policy")
			}
			if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
				t.Fatal("changed Hysteria2 Box acquired original TUN")
			}
			// Invoke the actual current-platform shipping prepare/restore entry.
			// The original-options refusal must occur before OS acquisition.
			method := "RouterVPNDesktopNodeChainPreparePhysicalOwned"
			if runtime.GOOS == "linux" {
				method = "RouterVPNDesktopLinuxNodeChainPreparePhysicalOwned"
			}
			prepare := reflect.ValueOf(instance).MethodByName(method)
			if !prepare.IsValid() {
				t.Fatal("current platform lost its owned preparation entry")
			}
			result := prepare.Call([]reflect.Value{reflect.ValueOf(policy)})
			if len(result) != 2 || !result[0].IsNil() || result[1].IsNil() {
				t.Fatal("changed Hysteria2 Box entered native owned preparation")
			}
			if tun.ready || tun.claimed {
				t.Fatal("changed Hysteria2 Box reached native startup")
			}
		})
	}
}
