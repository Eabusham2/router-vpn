type desktopPhysicalImportedLayout struct {
	name      string
	count     int
	positions []int
	mode      string
}

var desktopPhysicalImportedLayouts = []desktopPhysicalImportedLayout{
	{"adjacent", 4, []int{1, 2}, "wg"},
	{"before-paired-suffix", 6, []int{1, 3}, "awg2-fast"},
	{"maximum-sparse", 8, []int{1, 4, 6}, "awg2-strong"},
}

// Every paired slot retains its original private identity. Each imported slot
// receives a different complete literal SS source, credential and public IP.
func desktopChainPhysicalImportedSource(t *testing.T, layout desktopPhysicalImportedLayout, layer string) *mobilemultihop.NodeChain {
	t.Helper()
	modes := make([]string, layout.count-1)
	for i := range modes {
		modes[i] = layout.mode
	}
	launch, err := chainNativeSourceModes(t, modes).LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(launch), &source) != nil || len(source.Nodes) != layout.count {
		t.Fatal("original physical paired inventory missing")
	}
	// Keep this identity fixture within the same supported member count. Its
	// last member is SS, so reconstruct that slot's original WG identity below
	// from the exact stable key and endpoint tuple used by chainNativeSourceModes.
	identityModes := make([]string, layout.count-1)
	for i := range identityModes {
		identityModes[i] = "wg"
	}
	identityLaunch, err := chainNativeSourceModes(t, identityModes).LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var identities mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(identityLaunch), &identities) != nil || len(identities.Nodes) != layout.count {
		t.Fatal("original paired identities missing")
	}
	source.Schema, source.IdentitySources = 6, make([]string, layout.count)
	for i := range source.Nodes {
		if i == layout.count-1 {
			client, err := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{byte(20 + i)}, 32))
			if err != nil {
				t.Fatal("original final client identity missing", err)
			}
			server, err := ecdh.X25519().NewPrivateKey(bytes.Repeat([]byte{byte(70 + i)}, 32))
			if err != nil {
				t.Fatal("original final server identity missing", err)
			}
			identity := fmt.Sprintf("[Interface]\nAddress=10.77.0.2/24,fd77::2/64\nPrivateKey=%s\nDNS=192.168.50.133\nMTU=2000\n[Peer]\nPublicKey=%s\nEndpoint=198.51.100.%d:51820\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n", base64.StdEncoding.EncodeToString(client.Bytes()), base64.StdEncoding.EncodeToString(server.PublicKey().Bytes()), i+20)
			source.IdentitySources[i] = chainNativeJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(identity))})
			continue
		}
		var input struct {
			Files string `json:"files"`
		}
		if json.Unmarshal([]byte(identities.Nodes[i]), &input) != nil || input.Files == "" {
			t.Fatal("paired identity slot missing", i)
		}
		source.IdentitySources[i] = input.Files
	}
	importLaunch, err := chainNativeImportedSSPrefixSource(t, 1).LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var imported mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(importLaunch), &imported) != nil {
		t.Fatal("standalone imported source missing")
	}
	var member struct {
		Config  string `json:"config"`
		Capture string `json:"capture"`
	}
	if json.Unmarshal([]byte(imported.Nodes[1]), &member) != nil {
		t.Fatal("standalone imported member missing")
	}
	for _, position := range layout.positions {
		if position <= 0 || position >= layout.count-1 {
			t.Fatal("non-interior fixture position")
		}
		var graph, capture map[string]any
		if json.Unmarshal([]byte(member.Config), &graph) != nil || json.Unmarshal([]byte(member.Capture), &capture) != nil {
			t.Fatal("complete imported member missing")
		}
		profile := capture["profile"].(map[string]any)
		external := profile["external"].(map[string]any)
		ss := external["shadowsocks"].(map[string]any)
		out := graph["outbounds"].([]any)[0].(map[string]any)
		id, host, public := fmt.Sprintf("physical-import-%d", position), fmt.Sprintf("203.0.113.%d", 40+position), fmt.Sprintf("198.51.100.%d", 90+position)
		key := base64.StdEncoding.EncodeToString([]byte(strings.Repeat(string(rune('a'+position)), 32)))
		profile["id"], profile["endpoint"], capture["exit_id"] = id, host, id
		external["expected_public_ip"], capture["expected_public_ip"] = public, public
		ss["server"], ss["port"], ss["password"] = host, 21000+position, key
		out["server"], out["server_port"], out["password"] = host, 21000+position, key
		source.Nodes[position], err = mobilemultihop.NodeChainImportedMemberInput(chainNativeJSON(t, graph), chainNativeJSON(t, capture))
		if err != nil {
			t.Fatal("independent imported source invalid", position, err)
		}
		source.IdentitySources[position] = ""
	}
	last := layout.count - 1
	var final struct {
		Files   string `json:"files"`
		Profile string `json:"profile_json"`
	}
	if json.Unmarshal([]byte(source.Nodes[last]), &final) != nil {
		t.Fatal("original final source missing")
	}
	var profile map[string]any
	if json.Unmarshal([]byte(final.Profile), &profile) != nil {
		t.Fatal("original final profile missing")
	}
	profile["start_layer"] = layer
	node, err := mobilemultihop.NewNodeProfile("shadowsocks", final.Files, chainNativeJSON(t, profile), "", "")
	if err != nil {
		t.Fatal("original final layer invalid", err)
	}
	source.Nodes[last], err = node.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	chain, err := mobilemultihop.NewNodeChain(chainNativeJSON(t, source))
	if err != nil {
		t.Fatal("complete multiple-import physical source invalid", err)
	}
	return chain
}

func TestRouterVPNDesktopNodeChainPhysicalMultipleImports(t *testing.T) {
	for _, layout := range desktopPhysicalImportedLayouts {
		for _, layer := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			t.Run(layout.name+"_"+layer, func(t *testing.T) {
				original := desktopChainPhysicalImportedSource(t, layout, layer)
				policy, err := mobilemultihop.NewDesktopNodeChainPolicy(original, desktopTorBoxSession, runtime.GOOS, 0)
				if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
					t.Fatal("complete imported physical factory refused", err)
				}
				captures, _, err := policy.NodeChain().PublicMeasurementCaptures()
				meta, proofs := policy.Metadata(), original.ProofInventory()
				if err != nil || len(captures) != len(layout.positions) || len(meta.Prefixes) != layout.count {
					t.Fatal("physical factory omitted an original position", err)
				}
				for i, capture := range captures {
					position := layout.positions[i]
					prefix := meta.Prefixes[position]
					if capture.Position != position || capture.Tag != prefix.Tag || capture.SourceSHA256 != prefix.SourceSHA256 || prefix.SourceSHA256 != proofs[position].SourceSHA256 || prefix.Kind != "public-path" || prefix.NodeKind != "external" || prefix.NodeID != "" || prefix.StartLayer != "off" {
						t.Fatal("imported physical slot changed", position)
					}
				}
				if meta.Prefixes[layout.count-1].StartLayer != layer || meta.Prefixes[0].NodeID == "" || meta.Prefixes[layout.count-1].NodeID == "" {
					t.Fatal("physical factory lost paired boundaries or final layer")
				}
				instance, tun := desktopChainPhysicalBox(t, policy, nil)
				_, network, err := instance.routerVPNDesktopNodePhysical(policy)
				if err != nil || network == nil || network.Current() || network.SocketCurrent() || tun.ready || tun.claimed {
					t.Fatal("imported construction fabricated native readiness", err)
				}
				if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
					t.Fatal("unprepared imports acquired a physical owner")
				}
				if err := instance.RouterVPNStrategyStart(); err == nil || network.SocketCurrent() || tun.ready || tun.claimed {
					t.Fatal("unprepared imports bypassed native admission")
				}
			})
		}
	}
}

func TestRouterVPNDesktopNodeChainPhysicalMultipleImportTargets(t *testing.T) {
	for _, target := range []string{"linux", "windows", "darwin"} {
		for _, layer := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			t.Run(target+"_"+layer, func(t *testing.T) {
				policy, err := mobilemultihop.NewDesktopNodeChainPolicy(desktopChainPhysicalImportedSource(t, desktopPhysicalImportedLayouts[1], layer), desktopTorBoxSession, target, 0)
				if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(policy, target) {
					t.Fatal("captured imported target refused", err)
				}
				for _, other := range []string{"linux", "windows", "darwin", "android", "ios", ""} {
					if other != target && routerVPNDesktopNodeChainPhysicalTarget(policy, other) {
						t.Fatal("imported policy borrowed another target")
					}
				}
				copy := *policy
				if routerVPNDesktopNodeChainPhysicalTarget(&copy, target) {
					t.Fatal("copied imported policy borrowed original owner")
				}
			})
		}
	}
}

func TestRouterVPNDesktopNodeChainPhysicalMultipleImportChangedBox(t *testing.T) {
	for _, fault := range []string{"first-key", "second-key", "first-address", "second-address", "reordered-imports", "bypassed-paired-suffix", "dns-address", "dns-detour", "physical-source", "final-key", "mtu", "interface"} {
		t.Run(fault, func(t *testing.T) {
			original := desktopChainPhysicalImportedSource(t, desktopPhysicalImportedLayouts[1], "aes-256-gcm+xor-whitening")
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(original, desktopTorBoxSession, runtime.GOOS, 0)
			if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
				t.Fatal("original imported policy invalid before substitution", err)
			}
			proofs := original.ProofInventory()
			changed := 0
			instance, tun := desktopChainPhysicalBox(t, policy, func(graph map[string]any) {
				for _, raw := range graph["outbounds"].([]any) {
					out := raw.(map[string]any)
					position := 1
					if strings.HasPrefix(fault, "second-") {
						position = 3
					}
					if fault == "final-key" {
						position = len(proofs) - 1
					}
					if out["tag"] == proofs[position].Tag {
						switch fault {
						case "first-key", "second-key", "final-key":
							out["password"] = base64.StdEncoding.EncodeToString([]byte(strings.Repeat("z", 32)))
							changed++
						case "first-address", "second-address":
							out["server"] = "203.0.113.222"
							changed++
						}
					}
					if fault == "reordered-imports" && out["tag"] == proofs[3].Tag {
						out["detour"] = proofs[0].Tag
						changed++
					}
					if fault == "bypassed-paired-suffix" && out["tag"] == proofs[len(proofs)-1].Tag {
						out["detour"] = proofs[3].Tag
						changed++
					}
				}
				if strings.HasPrefix(fault, "dns-") {
					for _, raw := range graph["dns"].(map[string]any)["servers"].([]any) {
						resolver := raw.(map[string]any)
						if resolver["tag"] == original.DNSCapture().ResolverTag {
							if fault == "dns-address" {
								resolver["server"] = "192.168.50.134"
							} else {
								resolver["detour"] = proofs[1].Tag
							}
							changed++
						}
					}
				}
				switch fault {
				case "physical-source":
					graph["services"].([]any)[0].(map[string]any)["source_sha256"] = strings.Repeat("f", 64)
					changed++
				case "mtu":
					in := graph["inbounds"].([]any)[0].(map[string]any)
					in["mtu"] = in["mtu"].(float64) + 16
					changed++
				case "interface":
					graph["inbounds"].([]any)[0].(map[string]any)["interface_name"] = "foreign-imports"
					changed++
				}
			})
			if changed != 1 {
				t.Fatal("substitution did not reach exactly its captured position", changed)
			}
			if _, _, err := instance.routerVPNDesktopNodePhysical(policy); err == nil {
				t.Fatal("changed imported Box borrowed original physical capture")
			}
			if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil || tun.ready || tun.claimed {
				t.Fatal("changed imported Box acquired original native authority")
			}
		})
	}
}

// The actual Box parses all complete prefix objects and captures its real
// options at construction. The explicit TUN fixture owns no kernel interface.
// These construction tests never claim encrypted or OS routing acceptance.
func desktopChainPhysicalBox(t *testing.T, policy interface{ Config() string },
	change func(map[string]any)) (*Box, *desktopTorBoxTUN) {
	t.Helper()
	var graph map[string]any
	if json.Unmarshal([]byte(policy.Config()), &graph) != nil {
		t.Fatal("chain physical test lost its sealed source")
	}
	if change != nil {
		change(graph)
	}
	raw, err := json.Marshal(graph)
	if err != nil {
		t.Fatal(err)
	}
	var tun *desktopTorBoxTUN
	ins := inbound.NewRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun,
		func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.TunInboundOptions) (adapter.Inbound, error) {
			tun = &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag), name: options.InterfaceName, index: 772, mtu: int(options.MTU)}
			return tun, nil
		})
	outs := outbound.NewRegistry()
	group.RegisterSelector(outs)
	G.RegisterOutbound(outs)
	shadowsocks.RegisterOutbound(outs)
	routervpnwhitening.RegisterOutbound(outs)
	hysteria2.RegisterOutbound(outs)
	routervpndesktoppt.RegisterNodePhysicalOutbound(outs)
	endpoints := endpoint.NewRegistry()
	wireguard.RegisterEndpoint(endpoints)
	AWG.RegisterEndpoint(endpoints)
	resolvers := dns.NewTransportRegistry()
	DNST.RegisterUDP(resolvers)
	services := boxService.NewRegistry()
	routervpndesktoppt.RegisterNodeNetworkOwner(services)
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx = Context(ctx, ins, outs, endpoints, resolvers, services, certificate.NewRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
	if err != nil {
		t.Fatal("actual ordered graph parse", err)
	}
	options.Log = &option.LogOptions{Disabled: true}
	instance, err := New(Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal("actual ordered Box construction", err)
	}
	t.Cleanup(func() {
		if err := instance.Close(); err != nil {
			t.Error("original ordered Box did not retire", err)
		}
	})
	if tun == nil {
		t.Fatal("actual ordered Box omitted its TUN constructor")
	}
	return instance, tun
}

func TestRouterVPNDesktopNodeChainPhysicalCapturesActualBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("this physical adapter covers Linux and Windows")
	}
	policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSource(t), desktopTorBoxSession, runtime.GOOS, 0)
	if err != nil {
		t.Fatal(err)
	}
	instance, tun := desktopChainPhysicalBox(t, policy, nil)
	if !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
		t.Fatal("exact complete chain lost its typed physical factory")
	}
	_, network, err := instance.routerVPNDesktopNodePhysical(policy)
	if err != nil || network == nil || tun.ready || tun.claimed || network.Current() || network.SocketCurrent() {
		t.Fatal("construction fabricated native preparation or readiness", err)
	}
	if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
		t.Fatal("unprepared ordered graph acquired physical TUN authority")
	}
	if instance.routerVPNNodeChainOptions == "" {
		t.Fatal("Box.New omitted its actual ordered configuration snapshot")
	}
	if err := instance.RouterVPNStrategyStart(); err == nil {
		t.Fatal("ordered JSON bypassed original native physical preparation")
	}
	if tun.ready || tun.claimed || network.SocketCurrent() {
		t.Fatal("unprepared ordered graph reached native sockets or TUN")
	}
}

func TestRouterVPNDesktopNodeChainPhysicalRejectsSubstitutedBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("this physical adapter covers Linux and Windows")
	}
	for _, fault := range []string{"middle-key", "dns", "physical-source", "mtu", "interface"} {
		t.Run(fault, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSource(t), desktopTorBoxSession, runtime.GOOS, 0)
			if err != nil {
				t.Fatal(err)
			}
			instance, tun := desktopChainPhysicalBox(t, policy, func(graph map[string]any) {
				switch fault {
				case "middle-key":
					rows := graph["endpoints"].([]any)
					rows[1].(map[string]any)["private_key"] = rows[0].(map[string]any)["private_key"]
				case "dns":
					for _, raw := range graph["dns"].(map[string]any)["servers"].([]any) {
						server := raw.(map[string]any)
						if server["tag"] == policy.NodeChain().DNSCapture().ResolverTag {
							server["server"] = "192.168.50.134"
						}
					}
				case "physical-source":
					graph["services"].([]any)[0].(map[string]any)["source_sha256"] = strings.Repeat("f", 64)
				case "mtu":
					tun := graph["inbounds"].([]any)[0].(map[string]any)
					tun["mtu"] = tun["mtu"].(float64) + 16
				case "interface":
					graph["inbounds"].([]any)[0].(map[string]any)["interface_name"] = "foreign-chain"
				}
			})
			if _, _, err := instance.routerVPNDesktopNodePhysical(policy); err == nil {
				t.Fatal("changed running chain acquired the original physical authority")
			}
			if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
				t.Fatal("changed running chain acquired a native TUN")
			}
			if tun.ready || tun.claimed {
				t.Fatal("changed chain entered native startup")
			}
		})
	}
}

// Every position before the SS2022 final retains its exact declared WG/AWG
// mode. The native constructors here are real; only the privileged TUN is a
// boundary double, and no preparation is manufactured to start a native path.
func TestRouterVPNDesktopNodeChainPhysicalAWGModesAndOriginalBox(t *testing.T) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Skip("this physical adapter covers Linux and Windows")
	}
	for _, modes := range [][]string{
		{"awg2-fast", "wg"}, {"awg2-strong", "wg"},
		{"wg", "awg2-fast"}, {"wg", "awg2-strong"},
		{"wg", "awg2-fast", "wg"}, {"wg", "awg2-strong", "wg"},
		{"awg2-fast", "awg2-strong", "wg"}, {"awg2-strong", "wg", "awg2-fast"},
	} {
		t.Run(strings.Join(modes, "/"), func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSourceModes(t, modes), desktopTorBoxSession, runtime.GOOS, 0)
			if err != nil {
				t.Fatal(err)
			}
			instance, tun := desktopChainPhysicalBox(t, policy, nil)
			if !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
				t.Fatal("exact mixed chain lost its typed physical factory")
			}
			meta := policy.Metadata()
			for position, mode := range append(append([]string(nil), modes...), "shadowsocks") {
				prefix := meta.Prefixes[position]
				if prefix.Position != position || prefix.Mode != mode || prefix.ProfileID == "" || prefix.NodeID == "" || prefix.SourceSHA256 == "" {
					t.Fatal("physical factory changed an original prefix mode or proof identity", position)
				}
			}
			_, network, err := instance.routerVPNDesktopNodePhysical(policy)
			if err != nil || network == nil || tun.ready || tun.claimed || network.Current() || network.SocketCurrent() {
				t.Fatal("mixed construction fabricated preparation or lost its exact Box", err)
			}
			t.Run("different-original-mode", func(t *testing.T) {
				otherModes := append([]string(nil), modes...)
				for i, mode := range otherModes {
					if mode == "awg2-fast" {
						otherModes[i] = "awg2-strong"
						break
					}
					if mode == "awg2-strong" {
						otherModes[i] = "awg2-fast"
						break
					}
				}
				other, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSourceModes(t, otherModes), desktopTorBoxSession, runtime.GOOS, 0)
				if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(other, runtime.GOOS) {
					t.Fatal("replacement must be independently valid before testing original ownership", err)
				}
				if other.Metadata().SourceSHA256 == meta.SourceSHA256 {
					t.Fatal("changing an original mode retained the previous source identity")
				}
				if _, _, err := instance.routerVPNDesktopNodePhysical(other); err == nil {
					t.Fatal("another original mode acquired the existing native Box")
				}
				if owner, err := instance.routerVPNDesktopNodeActivatePhysical(other); err == nil || owner != nil {
					t.Fatal("another original mode acquired the retained TUN")
				}
			})
			if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
				t.Fatal("unprepared mixed chain acquired physical TUN authority")
			}
			if err := instance.RouterVPNStrategyStart(); err == nil {
				t.Fatal("mixed ordered JSON bypassed original physical preparation")
			}
			if tun.ready || tun.claimed || network.SocketCurrent() {
				t.Fatal("unprepared mixed chain reached native sockets or TUN")
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainPhysicalRejectsChangedModeProof(t *testing.T) {
	for _, fault := range []string{"unsupported-prefix", "mode-alias", "final-as-prefix", "wrong-original-mode", "wrong-final", "wrong-position"} {
		t.Run(fault, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeSourceModes(t, []string{"wg", "awg2-fast", "awg2-strong"}), desktopTorBoxSession, "linux", 0)
			if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(policy, "linux") {
				t.Fatal("mode receipt control has no valid original policy", err)
			}
			// Mutation is confined to this negative fixture. The shipping caller
			// receives no way to construct or edit this sealed policy metadata.
			meta := chainNativeField[mobilemultihop.DesktopNodeChainMetadata](t, policy, "metadata")
			switch fault {
			case "unsupported-prefix":
				meta.Prefixes[1].Mode = "max-wg"
			case "mode-alias":
				meta.Prefixes[1].Mode = "amneziawg"
			case "final-as-prefix":
				meta.Prefixes[1].Mode = "shadowsocks"
			case "wrong-original-mode":
				meta.Prefixes[1].Mode = "awg2-strong"
			case "wrong-final":
				meta.Prefixes[len(meta.Prefixes)-1].Mode = "wg"
			case "wrong-position":
				meta.Prefixes[1].Position = 0
			}
			if routerVPNDesktopNodeChainPhysicalTarget(policy, "linux") {
				t.Fatal("changed mode/proof receipt acquired typed physical authority")
			}
		})
	}
}

func desktopChainPhysicalHysteriaSource(t *testing.T, mode string, finalLayers ...string) *mobilemultihop.NodeChain {
	t.Helper()
	original, err := chainNativeSourceModes(t, []string{mode}).LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(original), &source) != nil {
		t.Fatal("original paired chain missing")
	}
	var final struct {
		Profile string `json:"profile_json"`
		Files   string `json:"files"`
	}
	if json.Unmarshal([]byte(source.Nodes[1]), &final) != nil || final.Profile == "" {
		t.Fatal("original paired final missing")
	}
	var profile map[string]any
	if json.Unmarshal([]byte(final.Profile), &profile) != nil {
		t.Fatal("original paired profile malformed")
	}
	ca := newDesktopExternalIntegrationCA(t)
	graph := map[string]any{
		"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "auto_route": true, "strict_route": true}},
		"outbounds": []any{map[string]any{"type": "hysteria2", "tag": "proxy", "server": profile["endpoint"], "server_port": 443,
			"password": "original-final-password", "obfs": map[string]any{"type": "salamander", "password": "original-final-mask"},
			"tls": map[string]any{"enabled": true, "server_name": "captured-proxy.example", "certificate_path": "cert.pem"}}},
		"route": map[string]any{"final": "proxy", "rules": []any{}},
	}
	assets := map[string]string{
		"sing-box.json": base64.StdEncoding.EncodeToString([]byte(chainNativeJSON(t, graph))),
		"cert.pem":      base64.StdEncoding.EncodeToString(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: ca.der})),
	}
	start := ""
	if len(finalLayers) > 1 {
		t.Fatal("physical fixture needs one exact final Start Layer")
	}
	if len(finalLayers) == 1 {
		profile["start_layer"] = finalLayers[0]
		final.Profile = chainNativeJSON(t, profile)
		if finalLayers[0] != "" && finalLayers[0] != "off" {
			// This is the same paired final's original complete SS source,
			// with its own key, endpoint and port. It is not an invented layer.
			start = final.Files
		}
	}
	node, err := mobilemultihop.NewNodeProfile("hysteria2", chainNativeJSON(t, assets), final.Profile, start, "")
	if err != nil {
		t.Fatal(err)
	}
	source.Nodes[1], err = node.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	chain, err := mobilemultihop.NewNodeChain(chainNativeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	return chain
}

func TestRouterVPNDesktopNodeChainPhysicalHysteriaFinalLayers(t *testing.T) {
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			t.Run(mode+"_"+layer, func(t *testing.T) {
				original := desktopChainPhysicalHysteriaSource(t, mode, layer)
				policy, err := mobilemultihop.NewDesktopNodeChainPolicy(original, desktopTorBoxSession, runtime.GOOS, 0)
				if err != nil {
					t.Fatal("complete original layered Hysteria2 policy", err)
				}
				if !routerVPNDesktopNodeChainPhysicalTarget(policy, runtime.GOOS) {
					t.Fatal("layered Hysteria2 lost its shipping physical factory")
				}
				instance, tun := desktopChainPhysicalBox(t, policy, nil)
				_, network, err := instance.routerVPNDesktopNodePhysical(policy)
				if err != nil || network == nil || tun.ready || tun.claimed || network.Current() || network.SocketCurrent() {
					t.Fatal("layered Hysteria2 construction fabricated physical readiness", err)
				}
				meta := policy.Metadata()
				if meta.Prefixes[0].Mode != mode || meta.Prefixes[1].Mode != "hysteria2" || meta.Prefixes[1].StartLayer != layer ||
					meta.Prefixes[1].SourceSHA256 != original.ProofInventory()[1].SourceSHA256 {
					t.Fatal("layered factory changed complete original source or selected layer")
				}
				if owner, err := instance.routerVPNDesktopNodeActivatePhysical(policy); err == nil || owner != nil {
					t.Fatal("unprepared layered Hysteria2 acquired physical authority")
				}
				if err := instance.RouterVPNStrategyStart(); err == nil || tun.ready || tun.claimed || network.SocketCurrent() {
					t.Fatal("layered Hysteria2 bypassed original preparation or reached native sockets")
				}
			})
		}
	}
}

