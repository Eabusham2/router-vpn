//go:build darwin && routervpn_darwin_external_host

package routervpnamnezia

import (
	"crypto/tls"
	"net"
	"net/netip"
	"os"
	"testing"
)

// This is an independent real protocol peer on a disposable native host. Its
// listener address is captured from a currently up physical interface, never
// supplied as a substitute for an engine socket, route or PF ownership proof.
func TestRouterVPNDesktopDarwinExternalReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_DARWIN_EXTERNAL_REFERENCE_CHILD") != "1" || os.Geteuid() != 0 {
		t.Fatal("Darwin external reference requires its explicit native root runner")
	}
	address, err := netip.ParseAddr(os.Getenv("ROUTERVPN_DARWIN_EXTERNAL_REFERENCE_ADDRESS"))
	if err != nil || !address.Is4() || !address.IsGlobalUnicast() || address.IsLoopback() {
		t.Fatal("Darwin reference lacks its captured physical address", err)
	}
	interfaces, err := net.Interfaces()
	if err != nil {
		t.Fatal(err)
	}
	found := 0
	interfaceAddresses := map[int]map[netip.Addr]bool{}
	ownedIndex := 0
	for _, device := range interfaces {
		if device.Flags&net.FlagUp == 0 || device.Flags&net.FlagLoopback != 0 {
			continue
		}
		addresses, err := device.Addrs()
		if err != nil {
			t.Fatal(err)
		}
		interfaceAddresses[device.Index] = map[netip.Addr]bool{}
		for _, raw := range addresses {
			prefix, err := netip.ParsePrefix(raw.String())
			if err == nil {
				interfaceAddresses[device.Index][prefix.Addr().Unmap()] = true
			}
			if err == nil && prefix.Addr().Unmap() == address {
				ownedIndex = device.Index
				found++
			}
		}
	}
	if found != 1 {
		t.Fatal("Darwin reference address is not one current physical interface")
	}
	desktopExternalInstalledSSEntry = func(t *testing.T, server *desktopNodeLayerServer, request desktopExternalInstalledSSRequest, cert tls.Certificate, final, network string) desktopExternalInstalledSSPeer {
		return desktopStartSSEntry(t, server, request, cert, final, network, address)
	}
	desktopExternalInstalledWireGuardFinal = startDesktopDarwinInstalledWireGuardFinal
	desktopExternalInstalledAmneziaFinal = startDesktopDarwinInstalledAmneziaFinal
	desktopExternalInstalledWireGuard = func(t *testing.T, server *desktopNodeLayerServer, request desktopExternalInstalledWGRequest) desktopExternalInstalledWGPeer {
		return startDesktopDarwinInstalledWireGuard(t, server, request, address)
	}
	desktopExternalInstalledAmnezia = func(t *testing.T, server *desktopNodeLayerServer, request desktopExternalInstalledAWGRequest) desktopExternalInstalledWGPeer {
		return startDesktopDarwinInstalledAmnezia(t, server, request, address)
	}
	desktopExternalInstalledWireGuardEntry = func(t *testing.T, server *desktopNodeLayerServer, request desktopExternalInstalledWGRequest, cert tls.Certificate, exitAddress, exitNetwork string, exitPort uint16) desktopExternalInstalledPacketEntryPeer {
		return startDesktopDarwinInstalledWGEntry(t, server, request, address, cert, exitAddress, exitNetwork, exitPort)
	}
	desktopExternalInstalledAmneziaEntry = func(t *testing.T, server *desktopNodeLayerServer, request desktopExternalInstalledAWGRequest, cert tls.Certificate, exitAddress, exitNetwork string, exitPort uint16) desktopExternalInstalledPacketEntryPeer {
		return startDesktopDarwinInstalledAmneziaEntry(t, server, request, address, cert, exitAddress, exitNetwork, exitPort)
	}
	desktopExternalInstalledOpenVPNFinal = startDesktopDarwinInstalledOpenVPNFinal
	desktopExternalInstalledOpenVPNEntry = func(t *testing.T, server *desktopNodeLayerServer, request desktopExternalInstalledPeerRequest, cert tls.Certificate, final desktopExternalInstalledOpenVPNPeer) desktopExternalInstalledPacketEntryPeer {
		if request.AmneziaEntry != nil {
			params, backend := desktopDarwinAmneziaBackend(t, *request.AmneziaEntry)
			return desktopInstalledPacketEntryRoutes(t, server, request.AmneziaEntry.desktopExternalInstalledWGRequest, address, cert, final.entryRoutes, "amneziawg", params, backend, 1440)
		}
		if request.WireGuardEntry == nil {
			t.Fatal("OpenVPN final lost original packet entry")
		}
		return desktopInstalledPacketEntryRoutes(t, server, *request.WireGuardEntry, address, cert, final.entryRoutes, "wireguard", "", startDesktopDarwinWGDevice, 1440)
	}
	desktopExternalInstalledOpenVPN = func(t *testing.T, server *desktopNodeLayerServer, request desktopExternalInstalledPeerRequest, dnsAddress, publicAddress string) desktopExternalInstalledOpenVPNPeer {
		client, err := netip.ParseAddr(os.Getenv("ROUTERVPN_DARWIN_EXTERNAL_CLIENT_ADDRESS"))
		if err != nil || client.String() != request.OpenVPNClientAddress || !interfaceAddresses[ownedIndex][client] || !client.Is4() || !client.IsGlobalUnicast() || client.IsLoopback() {
			t.Fatal("OpenVPN provider lost its captured original client interface")
		}
		return startDesktopDarwinInstalledOpenVPN(t, server, request, dnsAddress, publicAddress)
	}
	desktopExternalInstalledReferenceProcessWithLayer(t, address.String(), map[string]bool{
		"shadowsocks": true, "http-connect": true, "https-connect": true, "hysteria2": true, "wireguard": true, "socks5": true, "amneziawg": true, "openvpn": true,
	}, true, os.Getenv("ROUTERVPN_DARWIN_EXTERNAL_LAYER") == "1")
}
