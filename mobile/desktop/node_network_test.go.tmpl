// This fixture executes the immutable node compiler and real native service,
// lower outbound and broker. Its explicitly stated OS source refuses sockets;
// encrypted traffic and real Windows BFE are exercised in separate composition
// gates. Neither a constructor nor these fixture acknowledgments prove a node.
func nodePhysicalPolicyFixture(t *testing.T, target string) *mobilemultihop.DesktopNodePolicy {
	t.Helper()
	private := base64.StdEncoding.EncodeToString([]byte(strings.Repeat("a", 32)))
	public := base64.StdEncoding.EncodeToString([]byte(strings.Repeat("b", 32)))
	psk := base64.StdEncoding.EncodeToString([]byte(strings.Repeat("c", 32)))
	id := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + public))
	config := "[Interface]\nAddress=10.77.0.2/24,fd77:77::2/64\nPrivateKey=" + private + "\nDNS=192.168.50.133\n[Peer]\nPublicKey=" + public + "\nPresharedKey=" + psk + "\nEndpoint=192.0.2.1:51820\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n"
	files, _ := json.Marshal(map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(config))})
	profile, _ := json.Marshal(map[string]any{"id": "captured-router", "node_kind": "router-vpn", "node_proof_id": hex.EncodeToString(id[:]),
		"router_api": "http://10.77.0.1:8787", "api_token": "private-fixture-token", "endpoint": "192.0.2.1", "dns_mode": "home", "adguard_ipv4": "192.168.50.133",
		"mtu_policy": "auto", "home_lan_access": false, "ipv6_mode": "on", "kill_switch_policy": "always"})
	original, err := mobilemultihop.NewNodeProfile("wg", string(files), string(profile), "", "")
	if err != nil {
		t.Fatal(err)
	}
	policy, err := mobilemultihop.NewDesktopNodePolicy(original, strings.Repeat("b", 32), target)
	if err != nil {
		t.Fatal(err)
	}
	return policy
}

type nodePhysicalFixture struct {
	policy   *mobilemultihop.DesktopNodePolicy
	manager  *desktopPTEntryManager
	network  *NodeNetworkOwner
	physical *NodePhysicalOutbound
}

func newNodePhysicalFixture(t *testing.T) *nodePhysicalFixture {
	t.Helper()
	f := newDesktopPTFixture(t)
	manager := &desktopPTEntryManager{}
	service.MustRegister[adapter.OutboundManager](f.ctx, manager)
	policy := nodePhysicalPolicyFixture(t, runtime.GOOS)
	meta := policy.Metadata()
	options := NodeCaptureOptions{meta.SessionID, meta.SourceSHA256}
	raw, err := NewNodeNetworkOwner(f.ctx, nil, mobilemultihop.DesktopNodeNetworkTag, options)
	if err != nil {
		t.Fatal(err)
	}
	lower, err := NewNodePhysicalOutbound(f.ctx, nil, nil, mobilemultihop.DesktopNodePhysicalTag, options)
	if err != nil {
		t.Fatal(err)
	}
	manager.replace(lower)
	result := &nodePhysicalFixture{policy, manager, raw.(*NodeNetworkOwner), lower.(*NodePhysicalOutbound)}
	t.Cleanup(func() {
		if err := result.network.Close(); err != nil {
			t.Error(err)
		}
		if err := result.physical.Close(); err != nil {
			t.Error(err)
		}
	})
	return result
}

func (f *nodePhysicalFixture) prepare(t *testing.T, source *physicalFactorySource) {
	t.Helper()
	if err := f.network.PrepareNodePhysicalBroker(f.policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		if f.network.Current() || f.network.SocketCurrent() || !current() || capture != f.network.brokerCapture() {
			t.Error("node factory ran outside its pre-TUN captured initialization")
		}
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observeCtx context.Context) error {
			return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
		})
		return broker, source, err
	}); err != nil {
		t.Fatal(err)
	}
}

// Observe the original context being consulted by a contended wait before
// cancelling it. A scheduling delay cannot manufacture successful admission,
// and the original mutex remains held until the actual caller has returned.
type nodePhysicalWaitingContext struct {
	context.Context
	once    sync.Once
	waiting chan struct{}
}

func (c *nodePhysicalWaitingContext) Done() <-chan struct{} {
	c.once.Do(func() { close(c.waiting) })
	return c.Context.Done()
}

func nodePhysicalCancelHeldLock(t *testing.T, mutex *sync.Mutex, observe func(context.Context) error) {
	t.Helper()
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	waiting := &nodePhysicalWaitingContext{Context: ctx, waiting: make(chan struct{})}
	mutex.Lock()
	var unlock sync.Once
	release := func() { unlock.Do(mutex.Unlock) }
	defer release()
	done := make(chan error, 1)
	go func() { done <- observe(waiting) }()
	select {
	case <-waiting.waiting:
	case err := <-done:
		t.Fatal("physical caller did not reach the held original owner", err)
	case <-time.After(3 * time.Second):
		cancel()
		release()
		<-done
		t.Fatal("physical caller used an ambient wait without its original context")
	}
	cancel()
	select {
	case err := <-done:
		if !errors.Is(err, context.Canceled) {
			t.Fatal("physical caller lost its original cancellation", err)
		}
	case <-time.After(3 * time.Second):
		release()
		<-done
		t.Fatal("physical caller kept waiting for a held original owner after cancellation")
	}
	release()
}

func TestRouterVPNNodePhysicalCallerContext(t *testing.T) {
	for _, held := range []string{"lower", "owner", "manager"} {
		t.Run(held, func(t *testing.T) {
			f := newNodePhysicalFixture(t)
			source := &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()}
			f.prepare(t, source)
			if err := f.network.Start(adapter.StartStateInitialize); err != nil {
				t.Fatal(err)
			}
			peer := M.ParseSocksaddr("192.0.2.1:51820")
			if broker, err := f.physical.current(context.Background(), "udp", peer); err != nil || broker != f.network.broker {
				t.Fatal("original lower fixture was not usable before contention", err)
			}
			mutex := &f.physical.mu
			if held == "owner" {
				mutex = &f.network.mu
			} else if held == "manager" {
				mutex = &f.manager.mu
			}
			nodePhysicalCancelHeldLock(t, mutex, func(ctx context.Context) error {
				broker, err := f.physical.current(ctx, "udp", peer)
				if broker != nil {
					return errors.New("cancelled lower observation published its original broker")
				}
				return err
			})
			if broker, err := f.physical.current(context.Background(), "udp", peer); err != nil || broker != f.network.broker || source.closed.Load() {
				t.Fatal("one cancelled observation retired the original lower owner", err)
			}
		})
	}
}

func TestRouterVPNNodePhysicalSeparateRegistriesAndUnpreparedRejection(t *testing.T) {
	services, outbounds := boxService.NewRegistry(), outbound.NewRegistry()
	RegisterNodeNetworkOwner(services)
	RegisterNodePhysicalOutbound(outbounds)
	for _, item := range []struct {
		registry interface{ CreateOptions(string) (any, bool) }
		name     string
	}{{services, mobilemultihop.DesktopNodeNetworkType}, {outbounds, mobilemultihop.DesktopNodePhysicalType}} {
		options, found := item.registry.CreateOptions(item.name)
		if _, ok := options.(*NodeCaptureOptions); !found || !ok {
			t.Fatal("private node registry borrowed another graph's authority")
		}
	}
	f := newNodePhysicalFixture(t)
	if f.network.Current() || f.network.SocketCurrent() || f.network.Start(adapter.StartStateInitialize) == nil {
		t.Fatal("JSON-only node source became a prepared native owner")
	}
	if _, err := f.network.Activate(f.policy); err == nil {
		t.Fatal("node activated without an actual prepared factory")
	}
	if _, err := f.physical.DialContext(context.Background(), "udp", M.ParseSocksaddr("192.0.2.1:51820")); err == nil {
		t.Fatal("unprepared node used a default physical dialer")
	}
	if _, err := NewNodeNetworkOwner(context.Background(), nil, mobilemultihop.DesktopExternalNetworkTag, f.network.capture); err == nil {
		t.Fatal("node source adopted an ordinary external service tag")
	}
	if err := f.network.Close(); err != nil || f.network.SocketCurrent() || f.network.Start(adapter.StartStateInitialize) == nil {
		t.Fatal("closed node source became startable", err)
	}
}

func TestRouterVPNNodePhysicalHandshakePhaseAndExactPolicy(t *testing.T) {
	f := newNodePhysicalFixture(t)
	source := &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()}
	f.prepare(t, source)
	if _, err := f.physical.current(context.Background(), "udp", M.ParseSocksaddr("192.0.2.1:51820")); err == nil {
		t.Fatal("captured tuple was eligible before the deny factory completed")
	}
	if err := f.network.Start(adapter.StartStateInitialize); err != nil || !f.network.SocketCurrent() || f.network.Current() {
		t.Fatal("completed node initialization did not retain a separate handshake phase", err)
	}
	if broker, err := f.physical.current(context.Background(), "udp", M.ParseSocksaddr("192.0.2.1:51820")); err != nil || broker != f.network.broker {
		t.Fatal("sealed eager peer could not acquire its actual pre-ready lower broker", err)
	}
	for _, attempt := range []struct{ network, address string }{
		{"tcp", "192.0.2.1:51820"}, {"udp", "192.0.2.1:51821"}, {"udp", "192.0.2.2:51820"},
		{"udp", "192.168.50.133:53"}, {"tcp", "10.77.0.1:8787"}, {"udp", "peer.example:51820"},
	} {
		if _, err := f.physical.current(context.Background(), attempt.network, M.ParseSocksaddr(attempt.address)); err == nil {
			t.Fatal("node handshake admitted an uncaptured application or outer tuple", attempt)
		}
	}
	if _, err := f.network.Activate(f.policy); err == nil {
		t.Fatal("physical handshake permission was reported as complete readiness")
	}
	if f.network.Start(adapter.StartStateStarted) == nil {
		t.Fatal("skipped native startup stages acquired readiness")
	}
	for _, stage := range []adapter.StartStage{adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
		if err := f.network.Start(stage); err != nil {
			t.Fatal(err)
		}
	}
	identical := nodePhysicalPolicyFixture(t, runtime.GOOS)
	if identical.Config() != f.policy.Config() {
		t.Fatal("equal-source substitution fixture differs")
	}
	if _, err := f.network.Activate(identical); err == nil {
		t.Fatal("another compiler owner adopted this native generation")
	}
	if _, err := f.network.Activate(f.policy); err != nil || !f.network.Current() {
		t.Fatal("exact completed node owner failed activation", err)
	}
	replacement, err := NewNodePhysicalOutbound(f.physical.ctx, nil, nil, mobilemultihop.DesktopNodePhysicalTag, f.network.capture)
	if err != nil {
		t.Fatal(err)
	}
	f.manager.replace(replacement)
	if _, err := f.physical.current(context.Background(), "udp", M.ParseSocksaddr("192.0.2.1:51820")); err == nil {
		t.Fatal("retired lower object mutated its replacement")
	}
	f.network.InterfaceUpdated(context.Background())
	if f.network.Current() || f.network.SocketCurrent() || f.network.Start(adapter.StartStateStarted) == nil {
		t.Fatal("network transition retained the old handshake or proof generation")
	}
	if err := f.network.Close(); err != nil || !source.closed.Load() || !source.cancelled.Load() {
		t.Fatal("node teardown did not join its exact source", err)
	}
}

func TestRouterVPNNodePhysicalFactoryCancellationJoinsPartialOwner(t *testing.T) {
	for _, withBroker := range []bool{false, true} {
		t.Run(map[bool]string{false: "partial-source", true: "late-broker"}[withBroker], func(t *testing.T) {
			f := newNodePhysicalFixture(t)
			source := &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()}
			entered, cancelled, release := make(chan struct{}), make(chan struct{}), make(chan struct{})
			var calls atomic.Int32
			if err := f.network.PrepareNodePhysicalBroker(f.policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
				calls.Add(1)
				var broker *mobiletor.DesktopSocketBroker
				if withBroker {
					var err error
					broker, err = mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observeCtx context.Context) error {
						return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
					})
					if err != nil {
						t.Error(err)
					}
				}
				close(entered)
				<-ctx.Done()
				close(cancelled)
				<-release
				return broker, source, errors.New("captured late factory failure")
			}); err != nil {
				t.Fatal(err)
			}
			started, closed := make(chan error, 1), make(chan error, 1)
			go func() { started <- f.network.Start(adapter.StartStateInitialize) }()
			<-entered
			go func() { closed <- f.network.Close() }()
			<-cancelled
			select {
			case err := <-closed:
				t.Fatal("node Close returned before its entered creator joined", err)
			default:
			}
			if f.network.SocketCurrent() || f.network.Current() {
				t.Fatal("cancelled startup retained a ready phase")
			}
			close(release)
			select {
			case err := <-started:
				if err == nil {
					t.Fatal("late factory was admitted")
				}
			case <-time.After(time.Second):
				t.Fatal("late factory did not join")
			}
			select {
			case err := <-closed:
				if err != nil {
					t.Fatal(err)
				}
			case <-time.After(time.Second):
				t.Fatal("node Close did not join returned source")
			}
			if calls.Load() != 1 || !source.closed.Load() || !source.cancelled.Load() {
				t.Fatal("partial node source ownership was discarded")
			}
		})
	}
}

type nodePhysicalRetirementSource struct {
	*physicalFactorySource
	target    mobiletor.DesktopWindowsProtectionTarget
	closeFail atomic.Bool
	readErr   error
	readCalls int
}

func (s *nodePhysicalRetirementSource) Close(ctx context.Context) error {
	if s.closeFail.Load() {
		return errors.New("fixture retained native handle")
	}
	return s.physicalFactorySource.Close(ctx)
}

func (s *nodePhysicalRetirementSource) RetainedProtectionOutcome(context.Context) (*mobiletor.DesktopWindowsProtectionTarget, error) {
	s.readCalls++
	if s.readErr != nil {
		return nil, s.readErr
	}
	return &s.target, nil
}

func TestRouterVPNNodePhysicalRetirementKeepsExactJoinedSource(t *testing.T) {
	for _, partial := range []bool{false, true} {
		t.Run(map[bool]string{false: "started", true: "partial-before-admission"}[partial], func(t *testing.T) {
			f := newNodePhysicalFixture(t)
			source := &nodePhysicalRetirementSource{physicalFactorySource: &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()},
				target: mobiletor.DesktopWindowsProtectionTarget{Capture: f.network.brokerCapture(), Policy: "always", BaselineSHA256: strings.Repeat("a", 64)}}
			if err := f.network.PrepareNodePhysicalBroker(f.policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
				if partial {
					return nil, source, errors.New("fixture failed after captured baseline construction")
				}
				broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, source, current, func(observeCtx context.Context) error {
					return f.network.MatchesContext(observeCtx, capture.SessionID, capture.SourceSHA256)
				})
				return broker, source, err
			}); err != nil {
				t.Fatal(err)
			}
			err := f.network.Start(adapter.StartStateInitialize)
			if (err != nil) != partial {
				t.Fatal("fixture did not enter its intended construction phase", err)
			}
			if _, _, err := f.network.RetainedPhysicalProtection(context.Background(), f.policy); err == nil || source.readCalls != 0 {
				t.Fatal("unjoined node acquired or queried a retained protection result")
			}
			source.closeFail.Store(true)
			if err := f.network.Close(); err == nil {
				t.Fatal("fixture failed close unexpectedly joined")
			}
			if _, _, err := f.network.RetainedPhysicalProtection(context.Background(), f.policy); err == nil || source.readCalls != 0 {
				t.Fatal("failed node close acquired or queried a retained protection result")
			}
			source.closeFail.Store(false)
			if err := f.network.Close(); err != nil {
				t.Fatal(err)
			}
			actual, captured, err := f.network.RetainedPhysicalProtection(context.Background(), f.policy)
			if err != nil || !captured || actual == nil || *actual != source.target || source.readCalls != 1 {
				t.Fatal("joined node lost its exact retained source result", err)
			}
			actual.Capture.NetworkID = strings.Repeat("e", 32)
			if source.target.Capture != f.network.brokerCapture() {
				t.Fatal("returned node receipt mutated native source identity")
			}
			other := nodePhysicalPolicyFixture(t, runtime.GOOS)
			if _, _, err := f.network.RetainedPhysicalProtection(context.Background(), other); err == nil || source.readCalls != 1 {
				t.Fatal("equal but foreign policy read the old source retirement")
			}
			cancelled, cancel := context.WithCancel(context.Background())
			cancel()
			if _, _, err := f.network.RetainedPhysicalProtection(cancelled, f.policy); err == nil || source.readCalls != 1 {
				t.Fatal("cancelled node retirement query reached the native source")
			}
			source.readErr = errors.New("fixture native baseline replaced")
			if target, captured, err := f.network.RetainedPhysicalProtection(context.Background(), f.policy); err == nil || !captured || target != nil {
				t.Fatal("failed native outcome became an unchanged predecessor")
			}
			source.readErr = nil
			source.target.Capture.NetworkID = strings.Repeat("e", 32)
			if target, _, err := f.network.RetainedPhysicalProtection(context.Background(), f.policy); err == nil || target != nil {
				t.Fatal("node retirement accepted another source's network owner")
			}
		})
	}

	f := newNodePhysicalFixture(t)
	if err := f.network.Close(); err != nil {
		t.Fatal(err)
	}
	if target, captured, err := f.network.RetainedPhysicalProtection(context.Background(), f.policy); err != nil || captured || target != nil {
		t.Fatal("never-entered node source fabricated retained native protection", err)
	}
}

type nodePhysicalCloseGateSource struct {
	*nodePhysicalRetirementSource
	hold atomic.Bool
	entered chan struct{}
	enter sync.Once
	bound chan time.Duration
	calls atomic.Int32
	afterClose func()
}

func (s *nodePhysicalCloseGateSource) Close(ctx context.Context) error {
	s.calls.Add(1)
	if deadline, ok := ctx.Deadline(); ok {
		select { case s.bound <- time.Until(deadline): default: }
	}
	s.enter.Do(func() { close(s.entered) })
	if s.hold.Load() { <-ctx.Done(); return ctx.Err() }
	err := s.nodePhysicalRetirementSource.Close(ctx)
	if err == nil && s.afterClose != nil { s.afterClose() }
	return err
}

// The native service and sealed Windows policy are real. Only its already
// returned OS source is a controlled join boundary; this does not prove WFP.
func nodePhysicalCloseGateFixture(t *testing.T) (*NodeNetworkOwner, *mobilemultihop.DesktopNodePolicy, *nodePhysicalCloseGateSource) {
	t.Helper()
	policy := nodePhysicalPolicyFixture(t, "windows")
	meta := policy.Metadata()
	raw, err := NewNodeNetworkOwner(context.Background(), nil, mobilemultihop.DesktopNodeNetworkTag, NodeCaptureOptions{meta.SessionID, meta.SourceSHA256})
	if err != nil { t.Fatal(err) }
	n := raw.(*NodeNetworkOwner)
	source := &nodePhysicalCloseGateSource{
		nodePhysicalRetirementSource: &nodePhysicalRetirementSource{
			physicalFactorySource: &physicalFactorySource{desktopPhysicalPolicyFixture: newDesktopPhysicalPolicyFixture()},
			target: mobiletor.DesktopWindowsProtectionTarget{Capture:n.brokerCapture(), Policy:"always", BaselineSHA256:strings.Repeat("a",64)},
		},
		entered:make(chan struct{}), bound:make(chan time.Duration,2),
	}
	n.policy, n.source = policy, source
	t.Cleanup(func() { source.afterClose = nil; source.hold.Store(false); source.closeFail.Store(false); if err:=n.Close();err!=nil{t.Error(err)} })
	return n, policy, source
}

func TestRouterVPNNodeCapturedSourceRetirement(t *testing.T) {
	for _, fault := range []string{"foreign-policy","foreign-capture","non-windows","expired-caller"} {
		t.Run(fault,func(t *testing.T){
			n,policy,source := nodePhysicalCloseGateFixture(t)
			selected,caller := policy,context.Background()
			switch fault {
			case "foreign-policy": selected=nodePhysicalPolicyFixture(t,"windows")
			case "foreign-capture": n.capture.SourceSHA256=strings.Repeat("e",64)
			case "non-windows": selected=nodePhysicalPolicyFixture(t,"linux")
			case "expired-caller":
				cancelled,cancel:=context.WithCancel(context.Background());cancel();caller=cancelled
			}
			if err:=n.CloseCapturedPhysicalSourceContext(caller,selected);err==nil{t.Fatal("foreign cleanup acquired original source")}
			if n.retired||n.closed||n.ctx.Err()!=nil||source.calls.Load()!=0||source.cancelled.Load(){
				t.Fatal("rejected source cleanup cancelled or joined the original owner")
			}
		})
	}
	t.Run("held-owner",func(t *testing.T){
		n,policy,source := nodePhysicalCloseGateFixture(t)
		nodePhysicalCancelHeldLock(t,&n.mu,func(ctx context.Context)error{return n.CloseCapturedPhysicalSourceContext(ctx,policy)})
		if n.retired||n.ctx.Err()!=nil||source.calls.Load()!=0{t.Fatal("cancelled owner-lock wait retired original source")}
	})
	t.Run("pending-retry",func(t *testing.T){
		n,policy,source:=nodePhysicalCloseGateFixture(t);source.hold.Store(true)
		ctx,cancel:=context.WithTimeout(context.Background(),50*time.Millisecond)
		err:=n.CloseCapturedPhysicalSourceContext(ctx,policy);cancel()
		if !errors.Is(err,context.DeadlineExceeded)||n.closed||!n.retired||source.calls.Load()!=1{
			t.Fatal("pending source became joined or lost its caller deadline",err)
		}
		if _,_,err=n.RetainedPhysicalProtection(context.Background(),policy);err==nil||source.readCalls!=0{
			t.Fatal("pending source published protection retirement")
		}
		source.hold.Store(false)
		if err=n.CloseCapturedPhysicalSourceContext(context.Background(),policy);err!=nil||!n.closed||source.calls.Load()!=2{
			t.Fatal("same retained source did not join on retry",err)
		}
		for count:=0;count<2;count++{
			select{case bound:=<-source.bound:
				if bound<=0||bound>3*time.Second||count==0&&bound>50*time.Millisecond{t.Fatal("source cleanup widened original caller or three-second bound",bound)}
			default:t.Fatal("source close lacked original bounded context")}
		}
		target,captured,err:=n.RetainedPhysicalProtection(context.Background(),policy)
		if err!=nil||!captured||target==nil||*target!=source.target{t.Fatal("joined source lost exact original protection receipt",err)}
	})
	t.Run("never-prepared",func(t *testing.T){
		n,policy,source:=nodePhysicalCloseGateFixture(t);n.policy,n.source=nil,nil
		if err:=n.CloseCapturedPhysicalSourceContext(context.Background(),policy);err!=nil||!n.closed||source.calls.Load()!=0{
			t.Fatal("sealed never-entered source could not join without acquisition",err)
		}
		target,captured,err:=n.RetainedPhysicalProtection(context.Background(),policy)
		if err!=nil||captured||target!=nil{t.Fatal("never-entered source fabricated native protection",err)}
	})
}

type nodeSourceRetirementWrapper struct { mobilemultihop.DesktopPhysicalPolicy }

func TestRouterVPNNodeCapturedSourceRetirementWithProtection(t *testing.T) {
	for _, fault := range []string{"foreign-policy", "foreign-capture", "non-windows", "expired-caller", "nil-caller", "wrapped-policy"} {
		t.Run(fault, func(t *testing.T) {
			n, policy, source := nodePhysicalCloseGateFixture(t)
			var selected mobilemultihop.DesktopPhysicalPolicy = policy
			var caller context.Context = context.Background()
			switch fault {
			case "foreign-policy":
				selected = nodePhysicalPolicyFixture(t, "windows")
			case "foreign-capture":
				n.capture.SourceSHA256 = strings.Repeat("e", 64)
			case "non-windows":
				selected = nodePhysicalPolicyFixture(t, "linux")
			case "expired-caller":
				cancelled, cancel := context.WithCancel(context.Background()); cancel(); caller = cancelled
			case "nil-caller":
				caller = nil
			case "wrapped-policy":
				selected = nodeSourceRetirementWrapper{policy}
			}
			if err := n.CloseCapturedPhysicalSourceWithProtectionContext(caller, selected); err == nil {
				t.Fatal("combined cleanup acquired a foreign or unbounded source")
			}
			if n.retired || n.closed || n.ctx.Err() != nil || source.calls.Load() != 0 || source.readCalls != 0 {
				t.Fatal("rejected combined cleanup entered original native retirement")
			}
		})
	}
	t.Run("held-owner", func(t *testing.T) {
		n, policy, source := nodePhysicalCloseGateFixture(t)
		nodePhysicalCancelHeldLock(t, &n.mu, func(ctx context.Context) error {
			return n.CloseCapturedPhysicalSourceWithProtectionContext(ctx, policy)
		})
		if n.retired || n.ctx.Err() != nil || source.calls.Load() != 0 || source.readCalls != 0 {
			t.Fatal("cancelled combined lock wait entered original source")
		}
	})
	t.Run("pending-retry", func(t *testing.T) {
		n, policy, source := nodePhysicalCloseGateFixture(t); source.hold.Store(true)
		ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
		err := n.CloseCapturedPhysicalSourceWithProtectionContext(ctx, policy); cancel()
		if !errors.Is(err, context.DeadlineExceeded) || n.closed || !n.retired || source.calls.Load() != 1 || source.readCalls != 0 {
			t.Fatal("pending combined cleanup acquired joined source protection", err)
		}
		source.hold.Store(false)
		if err = n.CloseCapturedPhysicalSourceWithProtectionContext(context.Background(), policy); err != nil || !n.closed || source.calls.Load() != 2 || source.readCalls != 1 {
			t.Fatal("combined cleanup lost original source retry or protection outcome", err)
		}
		for count := 0; count < 2; count++ {
			select {
			case bound := <-source.bound:
				if bound <= 0 || bound > 3*time.Second || count == 0 && bound > 50*time.Millisecond {
					t.Fatal("combined cleanup widened original caller or source bound", bound)
				}
			default: t.Fatal("combined source close lost its original bounded caller")
			}
		}
	})
	t.Run("failed-source-retry", func(t *testing.T) {
		n, policy, source := nodePhysicalCloseGateFixture(t); source.closeFail.Store(true)
		if err := n.CloseCapturedPhysicalSourceWithProtectionContext(context.Background(), policy); err == nil || n.closed || source.readCalls != 0 {
			t.Fatal("failed original source close acquired combined protection")
		}
		source.closeFail.Store(false)
		if err := n.CloseCapturedPhysicalSourceWithProtectionContext(context.Background(), policy); err != nil || !n.closed || source.calls.Load() != 2 || source.readCalls != 1 {
			t.Fatal("failed source receipt prevented the exact retained cleanup retry", err)
		}
	})
	t.Run("foreign-outcome", func(t *testing.T) {
		n, policy, source := nodePhysicalCloseGateFixture(t)
		source.target.Capture.NetworkID = strings.Repeat("e", 32)
		if err := n.CloseCapturedPhysicalSourceWithProtectionContext(context.Background(), policy); err == nil || !n.closed || source.readCalls != 1 {
			t.Fatal("combined cleanup accepted foreign retained WFP outcome")
		}
	})
	t.Run("failed-outcome-retry", func(t *testing.T) {
		n, policy, source := nodePhysicalCloseGateFixture(t); source.readErr = errors.New("fixture original protection pending")
		if err := n.CloseCapturedPhysicalSourceWithProtectionContext(context.Background(), policy); err == nil || !n.closed || source.readCalls != 1 {
			t.Fatal("failed retained protection became successful combined cleanup")
		}
		source.readErr = nil
		if err := n.CloseCapturedPhysicalSourceWithProtectionContext(context.Background(), policy); err != nil || source.calls.Load() != 2 || source.readCalls != 2 {
			t.Fatal("combined cleanup lost original retained protection retry", err)
		}
	})
	for _, fault := range []string{"policy-after-join", "capture-after-join", "cancel-after-join"} {
		t.Run(fault, func(t *testing.T) {
			n, policy, source := nodePhysicalCloseGateFixture(t)
			ctx, cancel := context.WithCancel(context.Background()); defer cancel()
			replacement := nodePhysicalPolicyFixture(t, "windows")
			source.afterClose = func() {
				switch fault {
				case "policy-after-join": n.policy = replacement
				case "capture-after-join": n.capture.SourceSHA256 = strings.Repeat("e", 64)
				case "cancel-after-join": cancel()
				}
			}
			if err := n.CloseCapturedPhysicalSourceWithProtectionContext(ctx, policy); err == nil || !n.closed || source.readCalls != 0 {
				t.Fatal("combined cleanup ignored changed original owner after join")
			}
		})
	}
	t.Run("never-prepared", func(t *testing.T) {
		n, policy, source := nodePhysicalCloseGateFixture(t); n.policy, n.source = nil, nil
		if err := n.CloseCapturedPhysicalSourceWithProtectionContext(context.Background(), policy); err != nil || !n.closed || source.calls.Load() != 0 || source.readCalls != 0 {
			t.Fatal("combined never-entered cleanup acquired a native source", err)
		}
	})
	t.Run("joined", func(t *testing.T) {
		n, policy, source := nodePhysicalCloseGateFixture(t)
		if err := n.CloseCapturedPhysicalSourceWithProtectionContext(context.Background(), policy); err != nil || !n.closed || source.calls.Load() != 1 || source.readCalls != 1 {
			t.Fatal("combined cleanup lost exact joined source and WFP outcome", err)
		}
		target, captured, err := n.RetainedPhysicalProtection(context.Background(), policy)
		if err != nil || !captured || target == nil || *target != source.target {
			t.Fatal("standalone retirement lost its independent original readback", err)
		}
	})
}
