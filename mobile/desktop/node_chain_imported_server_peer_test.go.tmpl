type desktopNodeChainImportedServerEnvelope struct {
	desktopNodeChainImportedRequest
	HostnameDNS bool                                    `json:"hostname_dns,omitempty"`
	Candidate   *struct{ Password, Node, Token string } `json:"candidate,omitempty"`
}

// This resolver exists only behind the final independently encrypted packet
// peer. It never resolves an outer/physical socket for the Server worker.
type desktopNodeChainImportedServerDNS struct {
	queries   atomic.Uint64
	failed    atomic.Bool
	probeA    atomic.Uint64
	probeAAAA atomic.Uint64
	mu        sync.Mutex
	probes    map[dns.ResponseWriter]bool
}

// The pinned TCP transport probes connection reuse with A/ID1 and AAAA/ID2.
// These are transport probes, not an application IPv6 lookup or its evidence.
func desktopNodeChainImportedServerQuestion(query *dns.Msg) int {
	if query == nil || query.Response || query.Opcode != dns.OpcodeQuery || query.Rcode != 0 || query.Authoritative || query.Truncated || query.RecursionAvailable || !query.RecursionDesired || query.AuthenticatedData || query.CheckingDisabled || len(query.Question) != 1 || len(query.Answer) != 0 || len(query.Ns) != 0 || len(query.Extra) != 0 || !strings.EqualFold(query.Question[0].Name, desktopImportedHostname+".") || query.Question[0].Qclass != dns.ClassINET {
		return -1
	}
	if query.Id == 1 && query.Question[0].Qtype == dns.TypeA {
		return 1
	}
	if query.Id == 2 && query.Question[0].Qtype == dns.TypeAAAA {
		return 2
	}
	if query.Question[0].Qtype == dns.TypeA {
		return 0
	}
	return -1
}

func (owner *desktopNodeChainImportedServerDNS) question(query *dns.Msg, writer dns.ResponseWriter) int {
	kind := desktopNodeChainImportedServerQuestion(query)
	if writer == nil {
		return -1
	}
	tcp, ok := writer.RemoteAddr().(*net.TCPAddr)
	if !ok || tcp == nil {
		return -1
	}
	owner.mu.Lock()
	defer owner.mu.Unlock()
	if owner.probes == nil {
		owner.probes = make(map[dns.ResponseWriter]bool)
	}
	// miekg/dns retains one response writer per original TCP connection.
	key := writer
	if kind == 1 {
		owner.probes[key] = true
	}
	if kind == 2 && !owner.probes[key] {
		return -1
	}
	if kind != 1 {
		delete(owner.probes, key)
	}
	return kind
}

func desktopNodeChainImportedServerHostname(t *testing.T, peer *desktopNodeChainImportedPeer) *desktopNodeChainImportedServerDNS {
	t.Helper()
	owner := new(desktopNodeChainImportedServerDNS)
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	server := &dns.Server{Listener: listener, Net: "tcp", Handler: dns.HandlerFunc(func(w dns.ResponseWriter, query *dns.Msg) {
		kind := owner.question(query, w)
		if kind < 0 {
			// The non-verbose child writes testing failures to its control stdout
			// only at exit. Retain a fixed public diagnostic on stderr instead;
			// never copy the question, hostname, credentials or private graph.
			failure := "hostname-question-type"
			if len(query.Question) != 1 {
				failure = "hostname-question-count"
			} else if !strings.EqualFold(query.Question[0].Name, desktopImportedHostname+".") {
				failure = "hostname-question-name"
			} else if query.Question[0].Qclass != dns.ClassINET {
				failure = "hostname-question-class"
			} else if query.Question[0].Qtype == dns.TypeAAAA {
				failure = "hostname-question-aaaa"
			}
			_, _ = fmt.Fprintln(os.Stderr, "ROUTERVPN_SERVER_PEER_FAILURE", failure)
			t.Error("Server hostname DNS changed its captured IPv4 question")
			return
		}
		switch kind {
		case 1:
			owner.probeA.Add(1)
		case 2:
			owner.probeAAAA.Add(1)
		default:
			owner.queries.Add(1)
		}
		answer := new(dns.Msg).SetReply(query)
		if owner.failed.Load() {
			answer.Rcode = dns.RcodeNameError
		} else if kind != 2 {
			answer.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: query.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 0}, A: net.ParseIP("10.79.0.1")}}
		}
		_ = w.WriteMsg(answer)
	})}
	done := make(chan error, 1)
	go func() { done <- server.ActivateAndServe() }()
	t.Cleanup(func() {
		_ = server.Shutdown()
		if err := <-done; err != nil {
			_, _ = fmt.Fprintln(os.Stderr, "ROUTERVPN_SERVER_PEER_FAILURE", "hostname-resolver-join")
			t.Error("original Server hostname resolver did not join", err)
		}
	})
	peer.paired.entry.rules["tcp/"+desktopImportedHostnameDNS] = desktopReferenceRule{Network: "tcp", Address: "10.78.0.53", Port: 5353, Target: listener.Addr().String()}
	return owner
}

func TestRouterVPNDesktopNodeChainImportedServerReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NODE_CHAIN_IMPORTED_SERVER_REFERENCE_CHILD") == "" {
		t.Skip("isolated inherited custom reference only")
	}
	if os.Getenv("ROUTERVPN_NODE_CHAIN_IMPORTED_SERVER_REFERENCE_CHILD") != "1" {
		t.Fatal("uncaptured custom reference")
	}
	reader := bufio.NewReaderSize(os.Stdin, 32<<10+1)
	line, err := reader.ReadSlice('\n')
	if err != nil || len(line) > 32<<10 {
		t.Fatal("bounded custom reference request required")
	}
	var envelope desktopNodeChainImportedServerEnvelope
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	if decoder.Decode(&envelope) != nil || decoder.Decode(new(any)) != io.EOF || desktopNodeChainImportedServerRequestValid(envelope.desktopNodeChainImportedRequest) != nil || envelope.HostnameDNS && envelope.Schema != 2 {
		t.Fatal("custom reference source changed")
	}
	request := envelope.desktopNodeChainImportedRequest
	local, remote := netip.MustParseAddr(request.Paired.Address), netip.MustParseAddr(request.Paired.ClientAddress)
	interfaces, err := net.Interfaces()
	found := false
	for _, iface := range interfaces {
		addresses, e := iface.Addrs()
		if e != nil {
			t.Fatal(e)
		}
		for _, value := range addresses {
			prefix, e := netip.ParsePrefix(value.String())
			found = found || e == nil && prefix.Addr() == local && iface.Flags&net.FlagUp != 0 && iface.Flags&net.FlagLoopback == 0
		}
	}
	if err != nil || !found {
		t.Fatal("custom reference requires original physical namespace")
	}
	// Bind the original imported SS endpoint on the owned namespace address.
	// The server worker reaches this exact captured literal; no compiled graph
	// rewrite or fake outbound translates its physical destination.
	var responses atomic.Uint64
	var candidateAddress string
	if c := envelope.Candidate; c != nil {
		if request.Schema != 1 || !desktopSS2022Credentials(request.MiddleMethod, c.Password) || len(c.Node) != 64 || len(c.Token) != 64 || c.Password == request.MiddlePassword || c.Password == request.Paired.FinalPassword {
			t.Fatal("invalid independent benchmark candidate")
		}
		var seen sync.Map
		api := desktopImportedWGSSHTTP(t, nil, http.HandlerFunc(func(w http.ResponseWriter, q *http.Request) {
			nonce := q.URL.Query().Get("nonce")
			if q.Method != "GET" || q.Host != "10.97.0.1:8787" || q.URL.Path != hopmeasure.CandidateChallengePath || q.URL.RawQuery != "nonce="+nonce || !hopmeasure.ValidCandidateNonce(nonce) || q.Header.Get("Authorization") != "Bearer "+hopmeasure.CandidateChallengeMAC(c.Token, c.Node, nonce, false) {
				http.Error(w, "unauthorized", 403)
				return
			}
			if _, duplicate := seen.LoadOrStore(nonce, true); duplicate {
				http.Error(w, "replay", 403)
				return
			}
			responses.Add(1)
			_ = json.NewEncoder(w).Encode(map[string]string{"node_id": c.Node, "nonce": nonce, "response": hopmeasure.CandidateChallengeMAC(c.Token, c.Node, nonce, true)})
		}))
		ctx, cancel := context.WithCancel(t.Context())
		t.Cleanup(cancel)
		owner := &desktopNodeLayerServer{ctx: ctx, cancel: cancel, connections: map[io.Closer]bool{}, routes: []desktopNodeLayerRoute{{Network: "tcp", Destination: "10.97.0.1:8787", Physical: api}}}
		candidateAddress = desktopStartSSProvider(t, owner, request.MiddleMethod, c.Password, netip.MustParseAddr("127.0.0.1")).address
	}
	var peer *desktopNodeChainImportedPeer
	var chain *desktopNodeChainPeer
	if request.Schema == 2 {
		peer, chain = desktopNodeChainImportedServerPrefixes(t, request, local, remote)
	} else {
		peer = desktopNodeChainImportedPeerStartWithHooks(t, request, local, remote, nil, &desktopNodeChainImportedPeerHooks{
			decorate: func(original *desktopNodeWGHandler) tun.Handler { return original },
			middle: func(owner *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
				if candidateAddress != "" {
					owner.routes = append(owner.routes, desktopNodeLayerRoute{Network: "tcp", Destination: "198.51.100.249:8388", Physical: candidateAddress})
				}
				return desktopStartSSProvider(t, owner, request.MiddleMethod, request.MiddlePassword, local)
			},
		})
	}
	var transportDNS *desktopNodeChainImportedServerDNS
	if envelope.HostnameDNS {
		transportDNS = desktopNodeChainImportedServerHostname(t, peer)
	}
	respond := func() {
		snapshot, middle := peer.snapshot(), peer.provider.address
		if chain != nil {
			actual := chain.snapshot()
			snapshot.Address, snapshot.Prefixes = actual.Address, actual.Prefixes
			middle = "10.79.0.1:8388"
		}
		queries := uint64(0)
		if transportDNS != nil {
			queries = transportDNS.queries.Load()
		}
		status := map[string]any{"peer": snapshot, "middle_address": middle, "transport_dns_queries": queries}
		if envelope.Candidate != nil {
			status["candidate_responses"] = responses.Load()
		}
		if json.NewEncoder(os.Stdout).Encode(status) != nil {
			t.Fatal("custom reply pipe failed")
		}
	}
	respond()
	for {
		line, err = reader.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 64 {
			t.Fatal("custom control pipe failed")
		}
		command := strings.TrimSuffix(string(line), "\n")
		if command == "quit" {
			return
		}
		if command == "fail-transport-dns" && transportDNS != nil {
			transportDNS.failed.Store(true)
		} else if peer.control(command) != nil {
			t.Fatal("uncaptured custom control")
		}
		respond()
	}
}

// Schema 2 belongs only to this Server reference envelope. The product schema2
// descriptor is independently captured by the shipping worker and never read
// from this peer request.
func desktopNodeChainImportedServerRequestValid(request desktopNodeChainImportedRequest) error {
	if request.Schema == 1 {
		return desktopNodeChainImportedRequestValid(request)
	}
	if request.Schema != 2 {
		return errors.New("uncaptured imported Server reference family")
	}
	if _, err := desktopNodeChainPeerIdentityBounds(request.Paired, 1, 5); err != nil {
		return err
	}
	request.Schema = 1
	request.Paired.Prefixes = request.Paired.Prefixes[len(request.Paired.Prefixes)-1:]
	return desktopNodeChainImportedRequestValid(request)
}

func desktopNodeChainImportedServerPrefixes(t *testing.T, request desktopNodeChainImportedRequest, local, remote netip.Addr) (*desktopNodeChainImportedPeer, *desktopNodeChainPeer) {
	t.Helper()
	if request.Schema != 2 || desktopNodeChainImportedServerRequestValid(request) != nil {
		t.Fatal("invalid imported Server prefix source")
	}
	// The last actual packet owner forwards only its private proof and the
	// imported literal. Earlier owners retain only next-packet UDP grants.
	count := len(request.Paired.Prefixes)
	ipcs, err := desktopNodeChainPeerIdentityBounds(request.Paired, 1, 5)
	if err != nil {
		t.Fatal(err)
	}
	last := request
	last.Schema = 1
	last.Paired.Prefixes = request.Paired.Prefixes[count-1:]
	loopback := netip.MustParseAddr("127.0.0.1")
	bindLocal, bindRemote := loopback, loopback
	if count == 1 {
		bindLocal, bindRemote = local, remote
	}
	peer := desktopNodeChainImportedPeerStart(t, last, bindLocal, bindRemote)
	chain := &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, count), final: peer.paired}
	chain.prefixes[count-1] = peer.prefix
	desktopNodeChainStartCapturedPrefixes(t, request.Paired, local, remote, chain, ipcs, count-1)
	clear(ipcs)
	return peer, chain
}

func TestRouterVPNDesktopNodeChainImportedServerPrefixCapture(t *testing.T) {
	for count := 1; count <= 5; count++ {
		t.Run(fmt.Sprint(count), func(t *testing.T) {
			paired, _ := desktopNodeChainPeerFixture(t, count)
			modes := make([]string, count)
			for i := range modes {
				modes[i] = []string{"wg", "awg2-fast", "awg2-strong"}[i%3]
			}
			desktopNodeChainSetModes(t, &paired, modes)
			request := desktopNodeChainImportedRequest{Schema: 2, Paired: paired, MiddleMethod: "2022-blake3-aes-256-gcm", MiddlePassword: base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{91}, 32))}
			if err := desktopNodeChainImportedServerRequestValid(request); err != nil {
				t.Fatal(err)
			}
			changed := request
			changed.Schema = 1
			if count > 1 && desktopNodeChainImportedServerRequestValid(changed) == nil {
				t.Fatal("longer source entered original trio envelope")
			}
			if count > 1 {
				changed = request
				changed.Paired.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Paired.Prefixes...)
				changed.Paired.Prefixes[0].ClientPublicKey = changed.Paired.Prefixes[1].ClientPublicKey
				if desktopNodeChainImportedServerRequestValid(changed) == nil {
					t.Fatal("earlier independent packet identity lost")
				}
			}
			loopback := netip.MustParseAddr("127.0.0.1")
			peer, chain := desktopNodeChainImportedServerPrefixes(t, request, loopback, loopback)
			snapshot := chain.snapshot()
			if len(snapshot.Prefixes) != count || chain.prefixes[count-1] != peer.prefix {
				t.Fatal("actual encrypted prefix owner lost")
			}
			for i, prefix := range chain.prefixes {
				if snapshot.Prefixes[i].Mode != modes[i] {
					t.Fatal("actual encrypted prefix family changed")
				}
				if i < count-1 {
					next := desktopNodeChainNext(i + 1)
					if len(prefix.handler.rules) != 2 || prefix.handler.rules["udp/"+next].Target != chain.prefixes[i+1].bind.address() {
						t.Fatal("prefix acquired a bypass")
					}
				} else {
					for _, network := range []string{"tcp", "udp"} {
						if prefix.handler.rules[network+"/10.79.0.1:8388"].Target != peer.provider.address {
							t.Fatal("import bypassed actual last packet owner")
						}
					}
					if _, ok := prefix.handler.rules["tcp/10.77.0.1:8388"]; ok {
						t.Fatal("final bypassed original import")
					}
				}
			}
		})
	}
}

// The listener and lower loopback dial are explicit component fixtures. The
// handler and pinned TCP multiplexer are their original implementations; this
// does not substitute for the encrypted namespace gate below.
func TestRouterVPNServerHostnameActualTCPTransport(t *testing.T) {
	peer := &desktopNodeChainImportedPeer{paired: &desktopImportedWGSSPeer{entry: &desktopNodeWGHandler{desktopReferenceHandler: &desktopReferenceHandler{rules: make(map[string]desktopReferenceRule)}}}}
	owner := desktopNodeChainImportedServerHostname(t, peer)
	target := peer.paired.entry.rules["tcp/"+desktopImportedHostnameDNS].Target
	lower, err := dialer.NewDefault(context.Background(), option.DialerOptions{})
	if err != nil {
		t.Fatal(err)
	}
	transport := DNST.NewTCPRaw(BDNS.NewTransportAdapter(C.DNSTypeTCP, "original-hostname", nil), lower, M.ParseSocksaddr(target))
	defer func() {
		if err := transport.Close(); err != nil {
			t.Error("original TCP transport did not join", err)
		}
	}()
	query := func() {
		q := new(dns.Msg).SetQuestion(desktopImportedHostname+".", dns.TypeA)
		q.Id = 0
		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
		defer cancel()
		answer, err := transport.Exchange(ctx, q)
		if err != nil || answer == nil || answer.Id != q.Id || answer.Rcode != dns.RcodeSuccess || len(answer.Answer) != 1 {
			t.Fatal("original TCP application lookup failed", err)
		}
		a, ok := answer.Answer[0].(*dns.A)
		if !ok || !a.A.Equal(net.ParseIP("10.79.0.1")) {
			t.Fatal("original TCP application answer changed")
		}
	}
	query()
	deadline, tick := time.NewTimer(time.Second), time.NewTicker(time.Millisecond)
	defer deadline.Stop()
	defer tick.Stop()
	for owner.probeA.Load() != 1 || owner.probeAAAA.Load() != 1 {
		select {
		case <-deadline.C:
			t.Fatal("original TCP reuse probes did not complete")
		case <-tick.C:
		}
	}
	if owner.queries.Load() != 1 {
		t.Fatal("TCP probes substituted the original ID0 application lookup")
	}
	// The real multiplexer assigns later application IDs itself. They remain A
	// lookups, including ID1, and must not become an IPv6 application exception.
	for i := 0; i < 4; i++ {
		query()
	}
	if owner.queries.Load() < 2 || owner.probeAAAA.Load() != 1 {
		t.Fatal("later TCP application lookup lost original ownership")
	}
}

func desktopMultipleServerPacketDecorator(ready <-chan struct{}) func(*desktopNodeWGHandler) tun.Handler {
	return func(handler *desktopNodeWGHandler) tun.Handler {
		handler.rulesReady = ready
		return handler
	}
}

func TestRouterVPNDesktopMultipleServerPacketRulePublication(t *testing.T) {
	ready := make(chan struct{})
	old := netip.MustParseAddrPort("10.79.0.1:8388")
	next := netip.MustParseAddrPort("10.79.0.2:8388")
	rule := desktopReferenceRule{Network: "tcp", Address: next.Addr().String(), Port: int(next.Port()), Target: "127.0.0.1:18888"}
	rules := map[string]desktopReferenceRule{"tcp/" + old.String(): rule}
	handler := &desktopNodeWGHandler{desktopReferenceHandler: &desktopReferenceHandler{rules: rules}}
	device := desktopMultipleServerPacketDecorator(ready)(handler)
	if device != handler {
		t.Fatal("packet publication substituted the original reference handler")
	}
	lookup := func(endpoint netip.AddrPort, accepted bool) bool {
		verdict := device.JudgeFlow(6, netip.AddrPort{}, endpoint, nil)
		got, found := handler.rule("tcp", M.SocksaddrFromNetIP(endpoint))
		action := tun.ActionReject
		if accepted {
			action = tun.ActionAccept
		}
		return verdict.Action == action && found == accepted && (!found || got == rule)
	}
	if !lookup(old, false) {
		t.Fatal("packet handlers exposed an unpublished reference rule")
	}
	// The goroutine starts before the real setup writes, like the gVisor
	// forwarder. The route publication itself must synchronize both readers.
	done := make(chan bool, 1)
	go func() {
		deadline := time.Now().Add(2 * time.Second)
		for time.Now().Before(deadline) {
			if device.JudgeFlow(6, netip.AddrPort{}, next, nil).Action == tun.ActionAccept {
				done <- lookup(next, true) && lookup(old, false)
				return
			}
			runtime.Gosched()
		}
		done <- false
	}()
	delete(rules, "tcp/"+old.String())
	rules["tcp/"+next.String()] = rule
	close(ready)
	if !<-done {
		t.Fatal("packet handlers lost the original published rule or retained its predecessor")
	}
}

// Only the first transport binds the isolated peer underlay. All subsequent
// providers bind loopback in the peer namespace. The outer encrypted provider forwards only its own
// TLS proof and the next original member's exact destinations.
func TestRouterVPNDesktopMultipleImportedServerReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_MULTIPLE_SERVER_REFERENCE_CHILD") != "1" {
		t.Skip("isolated multiple-import reference child only")
	}
	reader := bufio.NewReaderSize(os.Stdin, 32<<10+1)
	line, err := reader.ReadSlice('\n')
	if err != nil || len(line) > 32<<10 {
		t.Fatal("bounded multiple-import reference request required")
	}
	var request struct {
		desktopNodeChainImportedRequest
		OuterPassword string `json:"outer_password"`
		Throughput    bool   `json:"throughput,omitempty"`
		Layout        string `json:"layout"`
	}
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	if decoder.Decode(&request) != nil || decoder.Decode(new(any)) != io.EOF ||
		desktopNodeChainImportedRequestValid(request.desktopNodeChainImportedRequest) != nil ||
		!desktopSS2022Credentials(request.MiddleMethod, request.OuterPassword) ||
		(request.Layout != "adjacent" && request.Layout != "sparse" && request.Layout != "packet-first") ||
		request.OuterPassword == request.MiddlePassword || request.OuterPassword == request.Paired.FinalPassword {
		t.Fatal("invalid or shared multiple-import peer identities")
	}
	local, remote := desktopNodeChainPeerPhysicalNamespace(t, request.Paired)
	loop := netip.MustParseAddr("127.0.0.1")
	packetBind, packetClient, outerBind := loop, loop, local
	if request.Layout == "packet-first" {
		packetBind, packetClient, outerBind = local, remote, loop
	}
	rulesReady := make(chan struct{})
	inner := desktopNodeChainImportedPeerStartWithHooks(t, request.desktopNodeChainImportedRequest, packetBind, packetClient, nil, &desktopNodeChainImportedPeerHooks{
		decorate: desktopMultipleServerPacketDecorator(rulesReady),
		middle: func(owner *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
			return desktopStartSSProvider(t, owner, request.MiddleMethod, request.MiddlePassword, loop)
		},
	})
	certificate, ca := desktopNodeChainImportedCertificate(t)
	inner.paired.benchmarkDNS.Store(request.Throughput)
	var outerBytes, outerBenchmark [2]atomic.Uint64
	var proofs atomic.Uint64
	var wrong atomic.Bool
	public := desktopImportedWGSSHTTP(t, &certificate, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if request.Throughput && r.Host == "speed.cloudflare.com" && r.Header.Get("Authorization") == "" && len(r.TransferEncoding) == 0 {
			desktopNodeChainPublicBenchmark(w, r, &outerBytes[0], &outerBytes[1], &outerBenchmark)
			return
		}
		if r.Method != http.MethodGet || r.Host != "1.1.1.1" || r.URL.Path != "/cdn-cgi/trace" ||
			len(r.URL.Query()) != 1 || len(r.URL.Query().Get("routervpn_proof")) != 32 ||
			r.Header.Get("Authorization") != "" || r.ContentLength != 0 || len(r.TransferEncoding) != 0 {
			http.NotFound(w, r)
			return
		}
		proofs.Add(1)
		ip := "203.0.113.87"
		if wrong.Load() {
			ip = "203.0.113.90"
		}
		fmt.Fprintln(w, "ip="+ip)
	}))
	routes := []desktopNodeLayerRoute{{Network: "tcp", Destination: "1.1.1.1:443", Physical: public}}
	if request.Layout == "sparse" {
		routes = append(routes, desktopNodeLayerRoute{Network: "udp", Destination: "198.51.100.112:51820", Physical: inner.paired.address})
	} else {
		for _, network := range []string{"tcp", "udp"} {
			routes = append(routes, desktopNodeLayerRoute{Network: network, Destination: "10.79.0.1:8388", Physical: inner.provider.address})
		}
	}
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	outer := &desktopNodeLayerServer{ctx: ctx, cancel: cancel, connections: map[io.Closer]bool{}, routes: routes}
	provider := desktopStartSSProvider(t, outer, request.MiddleMethod, request.OuterPassword, outerBind)
	address := provider.address
	if request.Layout == "packet-first" {
		address = "10.79.0.2:8388"
		for _, network := range []string{"tcp", "udp"} {
			delete(inner.paired.entry.rules, network+"/10.79.0.1:8388")
			inner.paired.entry.rules[network+"/"+address] = desktopReferenceRule{Network: network, Address: "10.79.0.2", Port: 8388, Target: provider.address}
		}
	}
	close(rulesReady)
	respond := func() {
		original := inner.snapshot()
		original.PublicCA += ca
		if json.NewEncoder(os.Stdout).Encode(map[string]any{"peer": original, "outer_address": address,
			"outer_tcp": outer.rawTCP.Load(), "outer_udp": outer.rawUDP.Load(), "outer_proofs": proofs.Load(),
			"benchmark_bytes":     [4][2]uint64{{outerBenchmark[0].Load(), outerBenchmark[1].Load()}, {inner.packetBenchmark[0].Load(), inner.packetBenchmark[1].Load()}, {inner.publicBenchmark[0].Load(), inner.publicBenchmark[1].Load()}, {original.Final.DownloadBytes, original.Final.UploadBytes}},
			"benchmark_dns":       inner.paired.benchmarkQueries.Load(),
			"benchmark_denied":    inner.paired.benchmarkDenied.Load(),
			"outer_auth_failures": provider.stats().AuthTCP, "inner_auth_failures": inner.provider.stats().AuthTCP}) != nil {
			t.Fatal("multiple peer response pipe failed")
		}
	}
	respond()
	for {
		line, err = reader.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 64 {
			t.Fatal("multiple peer control pipe failed")
		}
		switch command := strings.TrimSuffix(string(line), "\n"); command {
		case "wrong-outer-public":
			wrong.Store(true)
		case "stats":
		case "wrong-middle-public", "fail-dns", "drop-cover":
			if inner.control(command) != nil {
				t.Fatal("original peer rejected control")
			}
		default:
			t.Fatal("unknown multiple peer control")
		}
		respond()
	}
}
