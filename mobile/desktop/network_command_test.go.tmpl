func TestRouterVPNDesktopStartupEnvelopeControlsOriginalTor(t *testing.T) {
	for _, mode := range []string{"missing", "substituted", "late-success"} {
		t.Run(mode, func(t *testing.T) {
			files := routerVPNNewTorFileFixture(t)
			owner := routerVPNNewTorCommandFixture(t, files, false)
			meta := files.inputs.Policy().Metadata()
			admission, err := mobilemultihop.NewDesktopStartupAdmission("tor", meta.SessionID, meta.SourceSHA256, meta.ConfigSHA256, time.Now().Add(time.Second))
			if err != nil {
				t.Fatal(err)
			}
			if mode == "substituted" {
				admission.SourceSHA256 = strings.Repeat("d", 64)
			}
			raw, err := admission.Canonical()
			if err != nil {
				t.Fatal(err)
			}
			if mode == "missing" {
				raw = ""
			}
			parent, cancel := context.WithTimeout(context.Background(), 3*time.Second)
			defer cancel()
			parent = routerVPNRequireStartupEnvironment(parent, raw)
			calls := 0
			err = routerVPNRunTor(parent, files.directory, meta.SessionID, files.binary, files.getenv, func(ctx context.Context, _ *routerVPNTorFiles, _ *routerVPNTorBinary) (routerVPNTorOwner, error) {
				calls++
				startup := routerVPNNativeStartupCaller(ctx)
				deadline, ok := startup.Deadline()
				if !ok || deadline.UnixNano() != admission.DeadlineNS {
					t.Error("Tor child renewed transported deadline")
				}
				return &desktopStartupTorOwner{routerVPNTorCommandFixture: owner, startup: startup}, nil
			})
			if err == nil {
				t.Fatal("invalid or expired Tor command admitted success")
			}
			if mode == "late-success" && (!errors.Is(err, context.DeadlineExceeded) || calls != 1 || owner.base.closes.Load() != 1) {
				t.Fatal("expired Tor original did not join exact owner", err, calls, owner.base.closes.Load())
			}
			if mode != "late-success" && calls != 0 {
				t.Fatal("unbound Tor startup reached native factory")
			}
			if _, err := os.Stat(filepath.Join(files.directory, "proof.json")); !errors.Is(err, os.ErrNotExist) {
				t.Fatal("late or foreign Tor startup published proof", err)
			}
		})
	}
}
