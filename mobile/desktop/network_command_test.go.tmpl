// Only the privileged TUN constructor is represented by this inbound fixture.
// Reader adoption, source ownership and final projection use shipping methods.
type desktopNetworkInboundFixture struct {
	*desktopMTUTUNFixture
	raw        string
	err        error
	duringRead func()
}

func (n *desktopNetworkInboundFixture) RouterVPNDesktopNetworkReceipt() (string, error) {
	if n.duringRead != nil {
		n.duringRead()
	}
	return n.raw, n.err
}

func desktopNetworkReceiptFixture(t *testing.T, index, mtu int, nonce string) string {
	t.Helper()
	r := desktopnetwork.DesktopNetworkReceipt{Schema: 1, TargetOS: runtime.GOOS, Incarnation: nonce,
		Name: "router-vpn", Index: uint32(index), MTU: mtu, Addresses: []string{"10.8.0.2/24"}}
	if runtime.GOOS == "windows" {
		r.LUID = uint64(index) + 100
	}
	raw, err := desktopnetwork.CanonicalDesktopNetworkReceipt(r)
	if err != nil {
		t.Fatal(err)
	}
	return raw
}

func desktopNetworkOwnerFixture(t *testing.T) (*routerVPNNodeMTU, *desktopNodeMTUEngineFixture, *desktopNetworkInboundFixture, *atomic.Bool) {
	t.Helper()
	valid := &atomic.Bool{}
	valid.Store(true)
	inbound := &desktopNetworkInboundFixture{desktopMTUTUNFixture: &desktopMTUTUNFixture{index: 17, mtu: 1420},
		raw: desktopNetworkReceiptFixture(t, 17, 1420, strings.Repeat("d", 32))}
	engine := &desktopNodeMTUEngineFixture{current: inbound}
	owner, err := newRouterVPNNodeMTU(engine, strings.Repeat("a", 32), strings.Repeat("b", 64), strings.Repeat("c", 64), valid.Load)
	if err != nil {
		t.Fatal(err)
	}
	return owner, engine, inbound, valid
}

func TestRouterVPNNodeMTUNetworkProjectionRetainsCurrentMTUReader(t *testing.T) {
	owner, engine, original, _ := desktopNetworkOwnerFixture(t)
	raw, err := routerVPNDesktopNetworkProjection(context.Background(), owner)
	if err != nil || raw != original.raw {
		t.Fatal("initial captured reader was not projected", err)
	}
	engine.change = func(ctx context.Context, expected adapter.Inbound, value int) (adapter.Inbound, error) {
		old := expected.(*desktopNetworkInboundFixture)
		next := &desktopNetworkInboundFixture{desktopMTUTUNFixture: &desktopMTUTUNFixture{index: old.index + 1, mtu: value, guard: old.guard, guardContext: old.guardContext},
			raw: desktopNetworkReceiptFixture(t, old.index+1, value, strings.Repeat("e", 30)+string("0123456789abcdef"[(old.index+1)%16])+"1")}
		engine.current = next
		return next, nil
	}
	for _, action := range []string{"begin", "set", "rollback"} {
		value := 0
		if action == "set" {
			value = 1376
		}
		desktopNodeMTUApply(t, owner, action, value)
		raw, err := owner.DesktopNetworkReceipt()
		if err != nil || raw != engine.current.(*desktopNetworkInboundFixture).raw {
			t.Fatal("projection lost actual adopted reader", action, err)
		}
		if action != "begin" && raw == original.raw {
			t.Fatal("projection reused immutable initial ready after TUN replacement")
		}
	}
}

func TestRouterVPNNodeMTUNetworkProjectionRejectsSubstitution(t *testing.T) {
	for _, scenario := range []string{"wrong-index", "wrong-mtu", "wrong-name", "wrong-platform", "malformed", "guard-retired", "reader-replaced", "retired-during-read"} {
		t.Run(scenario, func(t *testing.T) {
			owner, engine, inbound, valid := desktopNetworkOwnerFixture(t)
			r, _ := desktopnetwork.ParseDesktopNetworkReceipt(inbound.raw)
			switch scenario {
			case "wrong-index":
				r.Index++
			case "wrong-mtu":
				r.MTU--
			case "wrong-name":
				r.Name = "other-original"
			case "wrong-platform":
				r.TargetOS = "darwin"
				r.LUID = 0
				if runtime.GOOS == "darwin" {
					r.TargetOS = "linux"
				}
			case "guard-retired":
				valid.Store(false)
			case "reader-replaced":
				engine.current = &desktopMTUTUNFixture{index: 17, mtu: 1420}
			case "retired-during-read":
				inbound.duringRead = func() { valid.Store(false) }
			}
			inbound.raw, _ = desktopnetwork.CanonicalDesktopNetworkReceipt(r)
			if scenario == "malformed" {
				inbound.raw = "{}"
			}
			if _, err := owner.DesktopNetworkReceipt(); err == nil {
				t.Fatal("foreign or retired native routing identity admitted")
			}
		})
	}
}

func TestRouterVPNNodeMTUNetworkOptionalEvidenceDoesNotFabricateReceipt(t *testing.T) {
	owner, _, inbound, _ := desktopNetworkOwnerFixture(t)
	inbound.err = errors.Join(desktopnetwork.ErrNetworkReceiptUnavailable, errors.New("native routing readback unavailable"))
	if raw, err := owner.DesktopNetworkReceipt(); err != nil || raw != "" {
		t.Fatal("optional native evidence became a fabricated daily connection failure", raw, err)
	}
	ordinary, _, _ := desktopNodeMTUFixture(t)
	if raw, err := ordinary.DesktopNetworkReceipt(); err != nil || raw != "" {
		t.Fatal("fixture without native evidence fabricated a receipt", raw, err)
	}
	if raw, err := routerVPNDesktopNetworkProjection(context.Background(), struct{}{}); err != nil || raw != "" {
		t.Fatal("unknown engine fabricated a receipt", raw, err)
	}
}

func desktopNetworkDiagnosticOutput(t *testing.T, operation func()) string {
	t.Helper()
	reader, writer, err := os.Pipe()
	if err != nil {
		t.Fatal(err)
	}
	defer reader.Close()
	original := os.Stderr
	os.Stderr = writer
	defer func() {
		os.Stderr = original
		_ = writer.Close()
	}()
	operation()
	if err := writer.Close(); err != nil {
		t.Fatal(err)
	}
	raw, err := io.ReadAll(reader)
	if err != nil {
		t.Fatal(err)
	}
	return string(raw)
}

func TestRouterVPNNodeMTUNetworkFirstFailurePreservesOptionalReaderOutcome(t *testing.T) {
	owner, engine, inbound, _ := desktopNetworkOwnerFixture(t)
	private := "private-node-key/192.0.2.17\nsecret-token"
	inbound.err = errors.Join(desktopnetwork.ErrNetworkReceiptUnavailable, errors.New("native Linux routing call has no unique owned addition: "+private))
	before := owner.record
	read := func() {
		t.Helper()
		if raw, err := owner.DesktopNetworkReceipt(); raw != "" || err != nil {
			t.Fatal("diagnostics changed the original optional receipt result", err)
		}
	}
	first := desktopNetworkDiagnosticOutput(t, func() { read(); read() })
	if owner.record != before {
		t.Fatal("diagnostics changed serialized ownership or acceptance state")
	}
	want := "NODE-MTU-DIAGNOSTIC receipt reason=unique-addition generation=0 reader=1 index=17 mtu=1420\n"
	if runtime.GOOS != "linux" {
		want = ""
	}
	if first != want || strings.Contains(first, private) {
		t.Fatal("first reader diagnostic was repeated, private or mislabeled", first)
	}
	inbound.err = errors.Join(desktopnetwork.ErrNetworkReceiptUnavailable, errors.New(private))
	if repeated := desktopNetworkDiagnosticOutput(t, read); repeated != "" {
		t.Fatal("a later failure replaced the same reader's first observation", repeated)
	}
	engine.change = func(ctx context.Context, expected adapter.Inbound, value int) (adapter.Inbound, error) {
		old := expected.(*desktopNetworkInboundFixture)
		next := &desktopNetworkInboundFixture{desktopMTUTUNFixture: &desktopMTUTUNFixture{index: old.index + 1, mtu: value, guard: old.guard, guardContext: old.guardContext}, err: errors.Join(desktopnetwork.ErrNetworkReceiptUnavailable, errors.New(private))}
		engine.current = next
		return next, nil
	}
	desktopNodeMTUApply(t, owner, "begin", 0)
	desktopNodeMTUApply(t, owner, "set", 1376)
	second := desktopNetworkDiagnosticOutput(t, func() { read(); read() })
	want = "NODE-MTU-DIAGNOSTIC receipt reason=unclassified generation=2 reader=2 index=18 mtu=1376\n"
	if runtime.GOOS != "linux" {
		want = ""
	}
	if second != want {
		t.Fatal("replacement reader lost its own first bounded cause", second)
	}
	current := engine.current.(*desktopNetworkInboundFixture)
	current.err = nil
	current.raw = desktopNetworkReceiptFixture(t, 18, 1376, strings.Repeat("e", 32))
	if output := desktopNetworkDiagnosticOutput(t, func() {
		if raw, err := owner.DesktopNetworkReceipt(); err != nil || raw != current.raw {
			t.Fatal("diagnostics changed later valid native evidence", err)
		}
	}); output != "" {
		t.Fatal("valid evidence produced a diagnostic", output)
	}
}

func TestRouterVPNNodeMTUNetworkMissingReaderDiagnosticCannotFabricateEvidence(t *testing.T) {
	owner, _, _ := desktopNodeMTUFixture(t)
	before := owner.record
	output := desktopNetworkDiagnosticOutput(t, func() {
		for i := 0; i < 2; i++ {
			if raw, err := owner.DesktopNetworkReceipt(); raw != "" || err != nil {
				t.Fatal("missing optional reader changed its result", err)
			}
		}
	})
	want := "NODE-MTU-DIAGNOSTIC receipt reason=reader-missing generation=0 reader=1 index=17 mtu=1420\n"
	if runtime.GOOS != "linux" {
		want = ""
	}
	if output != want || owner.record != before {
		t.Fatal("missing reader diagnostic changed ownership or fabricated a receipt", output)
	}
}

func (n *desktopNetworkInboundFixture) RouterVPNDesktopNetworkReceiptContext(ctx context.Context) (string, error) {
	if err := ctx.Err(); err != nil {
		return "", err
	}
	if n.duringRead != nil {
		n.duringRead()
	}
	if err := ctx.Err(); err != nil {
		return "", err
	}
	return n.raw, n.err
}

func TestRouterVPNDesktopNetworkProjectionContextPreservesObservationErrors(t *testing.T) {
	for _, scenario := range []string{"cancelled", "deadline", "unavailable", "identity", "success"} {
		t.Run(scenario, func(t *testing.T) {
			owner, _, inbound, valid := desktopNetworkOwnerFixture(t)
			prior := owner.record
			ctx, cancel := context.WithCancel(t.Context())
			defer cancel()
			var expected error
			switch scenario {
			case "cancelled":
				expected = context.Canceled
				inbound.duringRead = cancel
			case "deadline":
				expected = context.DeadlineExceeded
				inbound.err = expected
			case "unavailable":
				inbound.err = errors.Join(desktopnetwork.ErrNetworkReceiptUnavailable, errors.New("ambiguous original route addition"))
			case "identity":
				expected = errors.New("original native descriptor replaced")
				inbound.err = expected
			}
			raw, err := routerVPNDesktopNetworkProjection(ctx, owner)
			if expected != nil && !errors.Is(err, expected) {
				t.Fatalf("observation error changed: %v", err)
			}
			if expected == nil && err != nil {
				t.Fatal(err)
			}
			if scenario == "success" {
				if raw != inbound.raw {
					t.Fatal("exact original witness lost")
				}
			} else if raw != "" {
				t.Fatal("failed or unavailable read fabricated evidence")
			}
			if owner.record != prior || !valid.Load() {
				t.Fatal("observation mutated or retired the captured owner")
			}
		})
	}
}

func TestRouterVPNDesktopNativeNetworkProjectionCancelsHeldOwnerLock(t *testing.T) {
	for _, tor := range []bool{false, true} {
		t.Run(map[bool]string{false: "external", true: "tor"}[tor], func(t *testing.T) {
			var owner any
			var unlock func()
			if tor {
				n := &routerVPNTorNative{}
				n.mu.Lock()
				owner, unlock = n, n.mu.Unlock
			} else {
				n := &routerVPNExternalNative{}
				n.mu.Lock()
				owner, unlock = n, n.mu.Unlock
			}
			// Store the unlock method, not its invocation, to keep the actual shipping
			// mutex contended until the original caller has returned.
			ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
			defer cancel()
			done := make(chan error, 1)
			go func() { _, err := routerVPNDesktopNetworkProjection(ctx, owner); done <- err }()
			select {
			case err := <-done:
				unlock()
				if !errors.Is(err, context.DeadlineExceeded) {
					t.Fatalf("lost caller expiry: %v", err)
				}
			case <-time.After(time.Second):
				unlock()
				<-done
				t.Fatal("shipping owner lock ignored caller expiry")
			}
		})
	}
}

func TestRouterVPNDesktopStopInterruptsOriginalNetworkObserver(t *testing.T) {
	for _, tor := range []bool{false, true} {
		t.Run(map[bool]string{false: "external", true: "tor"}[tor], func(t *testing.T) {
			directory, policy := desktopExternalWorkspace(t)
			files, err := routerVPNOpenExternalFiles(directory)
			if err != nil {
				t.Fatal(err)
			}
			defer files.root.Close()
			ctx, join := routerVPNWatchCommandStop(t.Context(), files, desktopExternalSession, policy.SourceSHA256())
			defer join()
			var owner any
			var unlock func()
			if tor {
				n := &routerVPNTorNative{}
				n.mu.Lock()
				owner, unlock = n, n.mu.Unlock
			} else {
				n := &routerVPNExternalNative{}
				n.mu.Lock()
				owner, unlock = n, n.mu.Unlock
			}
			var release sync.Once
			defer release.Do(unlock)
			done := make(chan error, 1)
			go func() { _, err := routerVPNDesktopNetworkProjection(ctx, owner); done <- err }()
			writeStop := func(path, session, source string) {
				t.Helper()
				raw, _ := json.Marshal(routerVPNExternalStop{Schema: 1, Session: session, SourceSHA256: source})
				if err := os.WriteFile(filepath.Join(path, "stop.json"), raw, 0600); err != nil {
					t.Fatal(err)
				}
			}
			// A replaceable pathname must not redirect the retained root. Windows
			// can prevent the rename while that actual root is open; in that case
			// prove the sharing fence and keep the foreign Stop in a sibling root.
			originalInfo, err := files.root.Stat(".")
			if err != nil {
				t.Fatal(err)
			}
			retained := directory + "-retained"
			originalPath, foreignPath := retained, directory
			if renameErr := os.Rename(directory, retained); renameErr != nil {
				if runtime.GOOS != "windows" || !errors.Is(renameErr, syscall.Errno(32)) {
					t.Fatal(renameErr)
				}
				currentInfo, statErr := os.Lstat(directory)
				if statErr != nil || !os.SameFile(originalInfo, currentInfo) {
					t.Fatal("denied rename changed the original directory", statErr)
				}
				if _, statErr = os.Lstat(retained); !errors.Is(statErr, os.ErrNotExist) {
					t.Fatal("denied rename created a replacement directory", statErr)
				}
				originalPath, foreignPath = directory, retained
				t.Log("original Windows directory sharing fence retained the captured root")
			}
			t.Cleanup(func() { _ = os.RemoveAll(retained) })
			currentInfo, err := files.root.Stat(".")
			if err != nil || !os.SameFile(originalInfo, currentInfo) {
				t.Fatal("Stop fixture lost the actual original directory handle", err)
			}
			if err := os.Mkdir(foreignPath, 0700); err != nil {
				t.Fatal(err)
			}
			writeStop(foreignPath, desktopExternalSession, policy.SourceSHA256())
			writeStop(originalPath, strings.Repeat("b", 32), policy.SourceSHA256())
			select {
			case err := <-done:
				t.Fatalf("foreign Stop interrupted retained owner: %v", err)
			case <-time.After(150 * time.Millisecond):
			}
			writeStop(originalPath, desktopExternalSession, strings.Repeat("c", 64))
			select {
			case err := <-done:
				t.Fatalf("wrong source interrupted retained owner: %v", err)
			case <-time.After(150 * time.Millisecond):
			}
			writeStop(originalPath, desktopExternalSession, policy.SourceSHA256())
			select {
			case err := <-done:
				if !errors.Is(err, context.Canceled) {
					t.Fatalf("original Stop lost cancellation: %v", err)
				}
			case <-time.After(time.Second):
				release.Do(unlock)
				<-done
				t.Fatal("original Stop could not interrupt shipping owner mutex")
			}
			release.Do(unlock)
			if !files.stopRequested(desktopExternalSession, policy.SourceSHA256()) {
				t.Fatal("watcher changed its captured Stop record")
			}
		})
	}
}

func TestRouterVPNDesktopStartupEnvelopeControlsOriginalCommand(t *testing.T) {
	for _, mode := range []string{"missing", "substituted", "late-success"} {
		t.Run(mode, func(t *testing.T) {
			directory, policy := desktopExternalWorkspace(t)
			owner := desktopExternalOwner(t, policy, false)
			var result mobilemultihop.ExternalProofResult
			if err := json.Unmarshal([]byte(owner.result), &result); err != nil {
				t.Fatal(err)
			}
			admission, err := mobilemultihop.NewDesktopStartupAdmission("external", desktopExternalSession, policy.SourceSHA256(), result.ConfigSHA256, time.Now().Add(time.Second))
			if err != nil {
				t.Fatal(err)
			}
			if mode == "substituted" {
				admission.ConfigSHA256 = strings.Repeat("d", 64)
			}
			raw, err := admission.Canonical()
			if err != nil {
				t.Fatal(err)
			}
			if mode == "missing" {
				raw = ""
			}
			parent, cancel := context.WithTimeout(context.Background(), 3*time.Second)
			defer cancel()
			parent = routerVPNRequireStartupEnvironment(parent, raw)
			calls := 0
			err = routerVPNRunExternal(parent, directory, desktopExternalSession, "", func(ctx context.Context, _ *mobilemultihop.ExternalPolicy, _ *mobilemultihop.DesktopExternalPolicy, _, _, _ string) (routerVPNExternalOwner, error) {
				calls++
				startup := routerVPNNativeStartupCaller(ctx)
				deadline, ok := startup.Deadline()
				if !ok || deadline.UnixNano() != admission.DeadlineNS {
					t.Error("child renewed transported deadline")
				}
				owner.beforeStart = func() error { <-startup.Done(); return nil }
				return owner, nil
			})
			if err == nil {
				t.Fatal("invalid or expired command admitted success")
			}
			if mode == "late-success" {
				if !errors.Is(err, context.DeadlineExceeded) || calls != 1 || owner.closes.Load() != 1 {
					t.Fatal("expired original did not join exact owner", err, calls, owner.closes.Load())
				}
			}
			if mode != "late-success" && calls != 0 {
				t.Fatal("unbound startup reached native factory")
			}
			if _, err := os.Stat(filepath.Join(directory, "proof.json")); !errors.Is(err, os.ErrNotExist) {
				t.Fatal("late or foreign startup published proof", err)
			}
		})
	}
}

type desktopStartupReceiptObserver struct {
	read func(context.Context) (string, error)
}

func (o *desktopStartupReceiptObserver) DesktopNetworkReceiptContext(ctx context.Context) (string, error) {
	return o.read(ctx)
}
func TestRouterVPNDesktopHeartbeatKeepsObservationBudget(t *testing.T) {
	for _, mode := range []string{"healthy", "pure-expiry", "mixed-loss"} {
		t.Run(mode, func(t *testing.T) {
			parent, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
			defer cancel()
			owner := &desktopStartupReceiptObserver{read: func(ctx context.Context) (string, error) {
				got, ok := ctx.Deadline()
				want, _ := parent.Deadline()
				if !ok || !got.Equal(want) {
					t.Error("heartbeat renewed original observer")
				}
				if mode == "healthy" {
					return "original", nil
				}
				<-ctx.Done()
				if mode == "mixed-loss" {
					return "", errors.Join(ctx.Err(), errors.New("original interface replaced"))
				}
				return "", ctx.Err()
			}}
			raw, expired, err := routerVPNDesktopNetworkHeartbeat(parent, owner)
			if mode == "healthy" {
				if err != nil || expired || raw != "original" {
					t.Fatal("healthy read failed", err)
				}
				return
			}
			if !errors.Is(err, context.DeadlineExceeded) || expired != (mode == "pure-expiry") {
				t.Fatal("observation expiry hid real loss or retired healthy owner", err, expired)
			}
		})
	}
}

