// Decrypted traffic reaches only the original SOCKS control tuple and a relay
// currently leased by that authenticated association. It cannot reach SS,
// DNS or public probes through a second plaintext fixture route.
type nodeSOCKSPrefixHandler struct {
	original *desktopNodeWGHandler
	server *desktopNodeLayerServer
	relays *desktopImportedSOCKSLayerRoutes
	control string
}
func (h *nodeSOCKSPrefixHandler) JudgeFlow(protocol uint8, _, destination netip.AddrPort, _ []byte) tun.FlowVerdict {
	allowed := protocol == 6 && destination.String() == h.control
	if protocol == 17 {
		h.relays.mu.Lock()
		allowed = !h.relays.closed && h.relays.leases[destination.String()] != nil
		h.relays.mu.Unlock()
	}
	if allowed { return tun.FlowVerdict{Action: tun.ActionAccept} }
	return tun.FlowVerdict{Action: tun.ActionReject}
}
func (*nodeSOCKSPrefixHandler) NewDNSPacket([]byte, M.Socksaddr, M.Socksaddr, N.PacketWriter) {}
func (h *nodeSOCKSPrefixHandler) NewConnectionEx(ctx context.Context, c net.Conn, source, destination M.Socksaddr, done N.CloseHandlerFunc) {
	if !h.original.adopt(c, true) { if done != nil { done(net.ErrClosed) }; return }
	h.original.tcp.Add(1)
	go func() {
		defer h.original.workers.Done()
		defer h.original.forget(c)
		err := h.server.NewConnection(ctx, c, M.Metadata{Source: source, Destination: destination})
		_ = c.Close()
		if done != nil { done(err) }
	}()
}
func (h *nodeSOCKSPrefixHandler) NewPacketConnectionEx(ctx context.Context, c N.PacketConn, source, destination M.Socksaddr, done N.CloseHandlerFunc) {
	if !h.original.adopt(c, true) { if done != nil { done(net.ErrClosed) }; return }
	h.original.udp.Add(1)
	go func() {
		defer h.original.workers.Done()
		defer h.original.forget(c)
		err := h.server.NewPacketConnection(ctx, c, M.Metadata{Source: source, Destination: destination})
		_ = c.Close()
		if done != nil { done(err) }
	}()
}
func nodeSOCKSCloseServer(s *desktopNodeLayerServer) {
	s.mu.Lock()
	s.closing = true
	all := make([]io.Closer, 0, len(s.connections))
	for connection := range s.connections { all = append(all, connection) }
	s.mu.Unlock()
	s.cancel()
	for _, connection := range all { _ = connection.Close() }
	s.workers.Wait()
}

// The held reader is the original sing SOCKS control observer: its real native
// Read must already return an error before this explicit test barrier holds it.
type nodeSOCKSControl struct {
	net.Conn
	armed atomic.Bool
	once sync.Once
	readFailed, release, returned chan struct{}
	closes atomic.Int32
	closeFailure atomic.Bool
}
func (c *nodeSOCKSControl) Read(p []byte) (int, error) {
	n, err := c.Conn.Read(p)
	if err != nil && c.armed.Load() {
		c.once.Do(func() { close(c.readFailed); <-c.release; close(c.returned) })
	}
	return n, err
}
var nodeSOCKSOriginalCloseFailure = errors.New("original encrypted SOCKS association close refused")
func (c *nodeSOCKSControl) Close() error {
	c.closes.Add(1)
	err := c.Conn.Close()
	if c.closeFailure.Load() {
		return errors.Join(err, nodeSOCKSOriginalCloseFailure)
	}
	return err
}
type nodeSOCKSObservedEndpoint struct {
	adapter.Endpoint
	mu sync.Mutex
	control string
	tcp []*nodeSOCKSControl
	udp []net.Conn
	holdNext bool
	factoryEntered, factoryRelease chan struct{}
}
// The captured first member has no logical detour. Only its private test
// constructor maps the one physical tuple to the original loopback peer.
func (*nodeSOCKSObservedEndpoint) Dependencies() []string { return nil }
func (e *nodeSOCKSObservedEndpoint) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	connection, err := e.Endpoint.DialContext(ctx, network, destination)
	if connection == nil { return nil, err }
	e.mu.Lock()
	if network == "tcp" && destination.String() == e.control {
		c := &nodeSOCKSControl{Conn: connection, readFailed: make(chan struct{}), release: make(chan struct{}), returned: make(chan struct{})}
		e.tcp = append(e.tcp, c)
		connection = c
	} else if network == "udp" { e.udp = append(e.udp, connection) }
	hold := e.holdNext
	e.holdNext = false
	entered, release := e.factoryEntered, e.factoryRelease
	e.mu.Unlock()
	if hold { close(entered); <-release }
	return connection, err
}
func (e *nodeSOCKSObservedEndpoint) association(t *testing.T) (*nodeSOCKSControl, net.Conn) {
	t.Helper()
	e.mu.Lock(); defer e.mu.Unlock()
	if len(e.tcp) == 0 || len(e.udp) != 1 { t.Fatal("actual selected DNS did not acquire one original SOCKS association") }
	return e.tcp[len(e.tcp)-1], e.udp[0]
}

