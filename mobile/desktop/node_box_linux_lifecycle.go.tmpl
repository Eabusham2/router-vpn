//go:build linux

package box

import (
	"context"
	"errors"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/desktoppt"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// Linux retains its own native source and observation type. The admitted
// public command owns its authenticated parent journal, baseline succession,
// exact encrypted graph and complete Linux lifecycle.
type RouterVPNDesktopLinuxNodePreparation struct {
	network *routervpndesktoppt.NodeNetworkOwner
	policy  *mobilemultihop.DesktopNodePolicy
}

func routerVPNDesktopLinuxNodeLifecycleAvailable(policy *mobilemultihop.DesktopNodePolicy) bool {
	if policy == nil || policy.Validate() != nil {
		return false
	}
	meta := policy.Metadata()
	// Only exact AWG2 with Off or admitted WG/Shadowsocks/Hysteria2 layers may
	// enter this native TUN/nft/DNS lifecycle. The seal rederives each actual
	// endpoint/outbound, credential, port and physical lower.
	return meta.TargetOS == "linux" && mobilemultihop.DesktopLinuxNodePhysicalGraphSupported(meta.Mode, meta.StartLayer)
}

func (s *Box) RouterVPNDesktopLinuxNodePreparePhysicalOwned(policy *mobilemultihop.DesktopNodePolicy) (*RouterVPNDesktopLinuxNodePreparation, error) {
	if !routerVPNDesktopLinuxNodeLifecycleAvailable(policy) {
		return nil, errors.New("this Linux Router node graph has no admitted native lifecycle")
	}
	_, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	owner := &RouterVPNDesktopLinuxNodePreparation{network: network, policy: policy}
	return owner, network.PrepareNodePhysicalPolicy(policy)
}

func (p *RouterVPNDesktopLinuxNodePreparation) RetainedProtection(ctx context.Context) (*routervpndesktoppt.NodeLinuxPhysicalPrepared, bool, error) {
	if p == nil || p.network == nil || p.policy == nil {
		return nil, false, errors.New("Linux Router node preparation lost its captured retirement owner")
	}
	return p.network.RetainedLinuxPhysicalProtection(ctx, p.policy)
}

func (p *RouterVPNDesktopLinuxNodePreparation) JoinedSource(ctx context.Context) (*mobiletor.DesktopLinuxSourceJoinRecord, bool, error) {
	if p == nil || p.network == nil || p.policy == nil {
		return nil, false, errors.New("Linux Router node cleanup lost its captured source")
	}
	return p.network.JoinedLinuxPhysicalSource(ctx, p.policy)
}

// CloseSource joins only this original native service after the caller has
// joined its Box. A partial preparation may predate ServiceManager.Initialize,
// whose ordinary Close therefore has no started service to visit. Keeping the
// retained preparation lets that exact source close without a later lookup or
// an invented absence receipt. It never releases the parent-owned baseline.
func (p *RouterVPNDesktopLinuxNodePreparation) CloseSource(ctx context.Context) error {
	if p == nil || p.network == nil || p.policy == nil || p.policy.Validate() != nil || ctx == nil || ctx.Err() != nil {
		return errors.New("Linux source cleanup lost its retained preparation")
	}
	if err := p.network.Close(); err != nil {
		return err
	}
	_, _, err := p.network.JoinedLinuxPhysicalSource(ctx, p.policy)
	return err
}

func (p *RouterVPNDesktopLinuxNodePreparation) DisconnectProtection(ctx context.Context) (bool, error) {
	if p == nil || p.network == nil || p.policy == nil {
		return false, errors.New("Linux disconnect lost its retained native preparation")
	}
	return p.network.DisconnectLinuxPhysicalProtection(ctx, p.policy)
}

func (p *RouterVPNDesktopLinuxNodePreparation) ReleaseProtection(ctx context.Context) error {
	if p == nil || p.network == nil || p.policy == nil {
		return errors.New("Linux release lost its retained native preparation")
	}
	return p.network.ReleaseLinuxPhysicalProtection(ctx, p.policy)
}

func (p *RouterVPNDesktopLinuxNodePreparation) CloseProtection(ctx context.Context) error {
	if p == nil || p.network == nil || p.policy == nil {
		return errors.New("Linux protection teardown lost its native preparation")
	}
	return p.network.CloseLinuxPhysicalProtection(ctx, p.policy)
}

// Activation uses the actual native TUN reader and an uncached selected-DNS
// exchange through this exact graph. A cancelled or failed proof revokes the
// same native generation and leaves its partial owners available for Close.
// Authenticated Router node HTTP proof and parent publication still follow;
// this method does not report the application Connected state.
func (s *Box) RouterVPNDesktopLinuxNodeActivatePhysical(ctx context.Context, policy *mobilemultihop.DesktopNodePolicy) (*RouterVPNDesktopNodePhysical, error) {
	if ctx == nil || ctx.Err() != nil || !routerVPNDesktopLinuxNodeLifecycleAvailable(policy) {
		return nil, errors.New("Linux Router node activation lost its captured proof request")
	}
	_, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	if err = network.CheckLinuxPhysicalAdmission(policy); err != nil {
		return nil, err
	}
	owner, err := s.routerVPNDesktopNodeActivatePhysical(policy)
	if err != nil {
		return nil, err
	}
	if err = owner.ProveSelectedDNS(ctx); err != nil {
		owner.Cancel()
		return nil, err
	}
	if err = network.CheckLinuxPhysicalAdmission(policy); err != nil || ctx.Err() != nil || !owner.Current() {
		owner.Cancel()
		return nil, errors.Join(err, ctx.Err(), errors.New("Linux Router node selected-DNS proof lost its original native owner"))
	}
	return owner, nil
}
