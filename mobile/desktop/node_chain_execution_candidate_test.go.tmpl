type desktopSelectedCandidateComponent struct {
	*desktopExecutionLatencyComponent
	peer                                         *mobilemultihop.RouterVPNDesktopCandidateTestPeer
	request                                      routerVPNSelectedCandidateRequest
	prepareRaw, metadataRaw, sourceRaw, startRaw []byte
	metadata                                     routerVPNSelectedCandidateMetadata
	tempSequence                                 uint64
}

func newDesktopSelectedCandidateComponent(t *testing.T, setting string, localWinner, typed bool, position int) *desktopSelectedCandidateComponent {
	t.Helper()
	var prep *mobilemultihop.NodeChainExecutionPreparation
	var projection *mobilemultihop.NodeChainExecutionProjection
	var original *desktopExecutionRuntimeFixture
	if typed {
		prep = desktopMultipleImportedExecutionCommandPreparation(t, "separated", "linux", setting)
		projection = desktopMultipleImportedExecutionCommandProjection(t, prep, "separated")
		original = newDesktopMultipleImportedExecutionChildFixture(t, prep, projection)
	} else {
		prep, projection = desktopExecutionCommandSource(t, "linux", setting)
		original = newDesktopExecutionRuntimeFixtureFromProjection(t, prep, projection)
	}
	f := newDesktopSelectedComponent(t, original, prep, projection, localWinner, true)
	// A different four-node saved catalog supplies a fully captured private
	// destination, independent of every prefix in the connected test route.
	catalog := desktopNodeChainCommandPolicy(t, 4, "linux", 1420).OriginalChain()
	launch, err := catalog.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(launch), &source) != nil || len(source.Nodes) != 4 {
		t.Fatal("missing saved candidate source")
	}
	const candidate = "ordered-router-3"
	inventory := mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "desktop-original-selected-catalog", Inputs: []string{source.Nodes[3]}}
	raw := f.write(t, routerVPNExecutionCandidateSource, inventory)
	m := f.owner.measurement.Load()
	request := routerVPNSelectedCandidateRequest{1, "selected-packet-candidate-50", strings.Repeat("a", 32), 1, time.Now().Add(89 * time.Second).UnixMilli(), f.record.Path, position, candidate, routerVPNSelectedCandidateDigest(raw), m.capture.Capture, m.capture.Selected}
	result := &desktopSelectedCandidateComponent{desktopExecutionLatencyComponent: f, request: request, sourceRaw: raw, peer: f.native.SetupCandidate(t, position, "198.51.100.13:8388")}
	result.prepareRaw = f.write(t, routerVPNExecutionCandidateRequest, request)
	return result
}

func (f *desktopSelectedCandidateComponent) step(t *testing.T) {
	t.Helper()
	if err := f.owner.heartbeat(t.Context(), f.record); err != nil {
		t.Fatal("selected candidate heartbeat", err)
	}
	if err := f.owner.pollMeasurement(t.Context()); err != nil {
		t.Fatal("selected candidate mailbox", err)
	}
}

func (f *desktopSelectedCandidateComponent) prepare(t *testing.T) {
	t.Helper()
	f.step(t)
	raw, err := f.owner.files.read(routerVPNExecutionCandidateMetadata, 64<<10)
	if err != nil || !routerVPNSelectedCandidateDecode(raw, &f.metadata, 6) || f.metadata.Request != f.request.Request ||
		f.metadata.Generation != f.request.Generation || f.metadata.InventorySHA != f.request.InventorySHA || f.metadata.Revision != "desktop-original-selected-catalog" || !routerVPNExternalSource.MatchString(f.metadata.CaptureSHA) {
		var refused routerVPNSelectedCandidateResult
		if body, e := f.owner.files.read(routerVPNExecutionCandidateResult, 64<<10); e == nil {
			_ = json.Unmarshal(body, &refused)
		}
		t.Fatal("original child-issued plan metadata missing", err, refused.Status.Stage, refused.Status.Failure)
	}
	var public struct {
		Requested string `json:"requested_execution"`
		Execution string `json:"execution"`
		Epoch     uint64 `json:"selection_epoch"`
		Position  int    `json:"prefix_position"`
		Capture   string `json:"capture_sha256"`
		Targets   []struct {
			ID     string `json:"id"`
			Source string `json:"source_sha256"`
		} `json:"targets"`
	}
	if json.Unmarshal(f.metadata.Metadata, &public) != nil || public.Requested != f.owner.prep.Execution() || public.Execution != f.native.Runtime.Progress().Execution ||
		public.Epoch != f.owner.measurement.Load().epoch || public.Position != f.request.Position || public.Capture != f.metadata.CaptureSHA || len(public.Targets) != 1 || public.Targets[0].ID != f.request.Candidate || !routerVPNExternalSource.MatchString(public.Targets[0].Source) {
		t.Fatal("child metadata not bound to selected original capture", public)
	}
	f.metadataRaw = raw
}

func (f *desktopSelectedCandidateComponent) publishPulse() error {
	f.tempSequence++
	value := routerVPNNodeChainCandidatePulse{Schema: 1, Request: f.request.Request, CaptureSHA: f.metadata.CaptureSHA, Revision: f.metadata.Revision, Sequence: f.tempSequence, ObservedAt: time.Now().UnixMilli()}
	raw, err := json.Marshal(value)
	if err != nil {
		return err
	}
	dir := f.owner.files.root.Name()
	tmp := filepath.Join(dir, ".candidate-pulse-fixture")
	if err := os.WriteFile(tmp, raw, 0600); err != nil {
		return err
	}
	return os.Rename(tmp, filepath.Join(dir, routerVPNExecutionCandidateLive))
}

func (f *desktopSelectedCandidateComponent) pulse(t *testing.T) {
	t.Helper()
	if err := f.publishPulse(); err != nil {
		t.Fatal(err)
	}
}

func (f *desktopSelectedCandidateComponent) start(t *testing.T) {
	t.Helper()
	f.pulse(t)
	f.startRaw = f.write(t, routerVPNExecutionCandidateStart, routerVPNSelectedCandidateStart{f.request.Request, f.request.Generation, f.metadata.CaptureSHA, routerVPNSelectedCandidateDigest(f.metadataRaw)})
}

func (f *desktopSelectedCandidateComponent) finish(t *testing.T, pulse bool) routerVPNSelectedCandidateResult {
	t.Helper()
	// Parent catalog polling runs independently of the child command loop.
	if pulse {
		stop := make(chan struct{})
		joined := make(chan error, 1)
		go func() {
			ticker := time.NewTicker(100 * time.Millisecond)
			defer ticker.Stop()
			for {
				select {
				case <-stop:
					joined <- nil
					return
				case <-ticker.C:
					if err := f.publishPulse(); err != nil {
						joined <- err
						return
					}
				}
			}
		}()
		defer func() {
			close(stop)
			if err := <-joined; err != nil {
				t.Error("parent catalog polling", err)
			}
		}()
	}
	deadline := time.Now().Add(95 * time.Second)
	for {
		f.step(t)
		if _, err := f.owner.files.root.Lstat(routerVPNExecutionCandidateRequest); errors.Is(err, os.ErrNotExist) {
			break
		}
		if time.Now().After(deadline) {
			t.Fatal("original selected candidate did not join")
		}
		time.Sleep(100 * time.Millisecond)
	}
	raw, err := f.owner.files.read(routerVPNExecutionCandidateResult, 64<<10)
	var result routerVPNSelectedCandidateResult
	if err != nil || !routerVPNSelectedCandidateDecode(raw, &result, 15) || !reflect.DeepEqual(result.routerVPNSelectedCandidateRequest, f.request) || !result.Status.Complete || !result.Status.Drained || result.Status.Request != f.request.Request {
		t.Fatal("missing exact joined candidate result", err, result.Status.Stage)
	}
	if f.owner.activity.Load() != nil || f.owner.measurement.Load().candidate.Load() != nil {
		t.Fatal("candidate acknowledged before original activity joined")
	}
	return result
}

func TestRouterVPNDesktopSelectedPacketCandidateFifty(t *testing.T) {
	for _, row := range []struct {
		name, setting string
		local, typed  bool
		position      int
	}{
		{"server", "server", false, true, 2}, {"compare-server", "auto", false, true, 2}, {"compare-local", "auto", true, true, 2}, {"ordinary-entry", "server", false, false, 0},
	} {
		t.Run(row.name, func(t *testing.T) {
			f := newDesktopSelectedCandidateComponent(t, row.setting, row.local, row.typed, row.position)
			m := f.owner.measurement.Load()
			originalService := m.service
			selection := f.native.SelectionCount()
			last, err := f.native.Runtime.CaptureLastContext(t.Context())
			if err != nil {
				t.Fatal(err)
			}
			f.prepare(t)
			if f.owner.activity.Load() == nil || f.peer == nil {
				t.Fatal("prepare did not keep its original activity")
			}
			f.start(t)
			result := f.finish(t, true)
			tcp, put, del := f.peer.Counts()
			remote := 0
			if row.position > 0 && !row.local {
				remote = 1
			}
			after, e := f.native.Runtime.CaptureLastContext(t.Context())
			if result.Status.Failure != "" || len(result.Status.Results) != 1 || !result.Status.Results[0].Ready || result.Status.Results[0].Benchmark == nil ||
				result.Status.Results[0].Benchmark.Attempts != 50 || tcp != 50 || put != remote || del != remote ||
				result.CaptureSHA != f.metadata.CaptureSHA || result.MetadataSHA != routerVPNSelectedCandidateDigest(f.metadataRaw) || e != nil || after.JSON() != last.JSON() ||
				m != f.owner.measurement.Load() || m.service != originalService || m.capture.Selected != f.request.Selected || f.native.SelectionCount() != selection {
				t.Fatal("selected 50 lost original transport, timing, capture or join", result.Status.Stage, result.Status.Failure, tcp, put, del, e)
			}
			for name, expected := range map[string][]byte{routerVPNExecutionCandidateMetadata: f.metadataRaw, routerVPNExecutionCandidateStart: f.startRaw, routerVPNExecutionCandidateSource: f.sourceRaw} {
				b, e := f.owner.files.read(name, 64<<10)
				if e != nil || !bytes.Equal(b, expected) {
					t.Fatal("child removed parent's immutable receipt input", name)
				}
			}
		})
	}
}

func TestRouterVPNDesktopSelectedPacketCandidateRefusals(t *testing.T) {
	for _, fault := range []string{"pre-metadata-cancel", "expired-before-prepare", "unadmitted-final", "foreign-start-hash", "foreign-metadata-inode", "foreign-source-inode", "stale-pulse", "foreign-revision", "foreign-selected-capture", "cancel-after-metadata", "failed-stop-retry"} {
		t.Run(fault, func(t *testing.T) {
			f := newDesktopSelectedCandidateComponent(t, "server", false, false, 1)
			switch fault {
			case "pre-metadata-cancel":
				f.write(t, routerVPNExecutionCandidateCancel, f.request)
			case "expired-before-prepare":
				f.request.Deadline = time.Now().Add(-time.Millisecond).UnixMilli()
				f.prepareRaw = f.write(t, routerVPNExecutionCandidateRequest, f.request)
			case "foreign-selected-capture":
				f.request.Selected += " "
				f.prepareRaw = f.write(t, routerVPNExecutionCandidateRequest, f.request)
			case "unadmitted-final":
				f.request.Position = 2
				f.prepareRaw = f.write(t, routerVPNExecutionCandidateRequest, f.request)
			default:
				f.prepare(t)
				switch fault {
				case "foreign-start-hash":
					f.pulse(t)
					f.write(t, routerVPNExecutionCandidateStart, routerVPNSelectedCandidateStart{f.request.Request, 1, f.metadata.CaptureSHA, strings.Repeat("b", 64)})
				case "foreign-metadata-inode", "foreign-source-inode":
					name, raw := routerVPNExecutionCandidateMetadata, f.metadataRaw
					if fault == "foreign-source-inode" {
						name, raw = routerVPNExecutionCandidateSource, f.sourceRaw
					}
					// Keep the original object alive so the filesystem cannot recycle its inode.
					if err := f.owner.files.root.Rename(name, name+".original"); err != nil {
						t.Fatal(err)
					}
					if err := os.WriteFile(filepath.Join(f.owner.files.root.Name(), name), raw, 0600); err != nil {
						t.Fatal(err)
					}
					f.start(t)
					f.step(t)
					if op := f.owner.measurement.Load().candidate.Load(); op != nil && op.started {
						t.Fatal("selected candidate started with a replaced original inode")
					}
				case "stale-pulse", "foreign-revision":
					f.start(t)
					pulse := routerVPNNodeChainCandidatePulse{1, f.request.Request, f.metadata.CaptureSHA, f.metadata.Revision, 2, time.Now().UnixMilli()}
					if fault == "stale-pulse" {
						pulse.ObservedAt -= 1600
					} else {
						pulse.Revision += "-foreign"
					}
					f.write(t, routerVPNExecutionCandidateLive, pulse)
				case "cancel-after-metadata":
					f.write(t, routerVPNExecutionCandidateCancel, f.request)
				case "failed-stop-retry":
					f.peer.BadStop(true)
					f.start(t)
					f.step(t)
					bound := time.Now().Add(8 * time.Second)
					for {
						_, put, _ := f.peer.Counts()
						if put > 0 {
							break
						}
						if time.Now().After(bound) {
							t.Fatal("candidate failed to acquire original grant")
						}
						f.pulse(t)
						f.step(t)
						time.Sleep(20 * time.Millisecond)
					}
					f.write(t, routerVPNExecutionCandidateCancel, f.request)
					f.step(t)
					if f.owner.activity.Load() == nil {
						t.Fatal("failed authenticated stop released original activity")
					}
					if _, err := f.owner.files.root.Lstat(routerVPNExecutionCandidateResult); !errors.Is(err, os.ErrNotExist) {
						t.Fatal("unjoined stop published completion")
					}
					f.peer.BadStop(false)
				}
			}
			result := f.finish(t, false)
			if tcp, put, _ := f.peer.Counts(); fault != "failed-stop-retry" && (tcp != 0 || put != 0) {
				t.Fatal("foreign inputs acquired an original candidate grant", tcp, put)
			}
			if result.Status.Failure == "" || len(result.Status.Results) != 0 {
				t.Fatal("unproved candidate published timing")
			}
			if len(f.metadataRaw) == 0 && (result.MetadataSHA != "" || result.CaptureSHA != "") || len(f.metadataRaw) > 0 && (result.MetadataSHA != routerVPNSelectedCandidateDigest(f.metadataRaw) || result.CaptureSHA != f.metadata.CaptureSHA) {
				t.Fatal("failed original candidate returned the wrong receipt hashes")
			}
		})
	}
}

func TestRouterVPNDesktopSelectedPacketCandidateGeneration(t *testing.T) {
	f := newDesktopSelectedCandidateComponent(t, "server", false, false, 1)
	m := f.owner.measurement.Load()
	original := m.service
	f.prepare(t)
	// A latency request arriving after Prepare cannot replace the reserved owner.
	latency := f.desktopExecutionLatencyComponent.request(t, strings.Repeat("c", 32), 1)
	f.write(t, routerVPNExecutionMeasurementRequestFile, latency)
	f.step(t)
	if m.op.Load() != nil || m.candidate.Load() == nil || f.owner.activity.Load() != m.candidate.Load().activity {
		t.Fatal("selected latency stole the waiting candidate activity")
	}
	if err := f.owner.files.root.Remove(routerVPNExecutionMeasurementRequestFile); err != nil {
		t.Fatal(err)
	}
	f.write(t, routerVPNExecutionCandidateCancel, f.request)
	first := f.finish(t, false)
	if first.MetadataSHA != routerVPNSelectedCandidateDigest(f.metadataRaw) || first.Status.Stage != "cancelled" {
		t.Fatal("original cancellation receipt missing")
	}
	metadata, err := f.owner.files.root.Lstat(routerVPNExecutionCandidateMetadata)
	if err != nil {
		t.Fatal(err)
	}
	f.request.Request, f.request.Generation = strings.Repeat("d", 32), 2
	f.prepareRaw = f.write(t, routerVPNExecutionCandidateRequest, f.request)
	f.step(t)
	retained, err := f.owner.files.root.Lstat(routerVPNExecutionCandidateMetadata)
	if err != nil || !os.SameFile(metadata, retained) || m.candidate.Load() != nil || f.owner.candidateGeneration != 1 {
		t.Fatal("successor overwrote original unread metadata")
	}
	if err := f.owner.files.root.Remove(routerVPNExecutionCandidateMetadata); err != nil {
		t.Fatal(err)
	}
	f.step(t)
	if m.candidate.Load() != nil || f.owner.candidateGeneration != 1 {
		t.Fatal("successor started before the original result was retired")
	}
	if err := f.owner.files.root.Remove(routerVPNExecutionCandidateResult); err != nil {
		t.Fatal(err)
	}
	f.prepare(t)
	if m.candidate.Load() == nil || f.owner.candidateGeneration != 2 || m.service != original {
		t.Fatal("successor lost original selected activity")
	}
	// The successor is already identified by a distinct nonce and generation even when
	// its immutable target list and exact original selected projection are identical.
	f.write(t, routerVPNExecutionCandidateCancel, f.request)
	second := f.finish(t, false)
	if second.Status.Stage != "cancelled" || second.MetadataSHA == first.MetadataSHA || second.CaptureSHA != first.CaptureSHA {
		t.Fatal("successor receipt lost original plan or generation")
	}
}

func TestRouterVPNDesktopSelectedPacketCandidatePublication(t *testing.T) {
	for _, race := range []string{"before-link", "after-link"} {
		t.Run(race, func(t *testing.T) {
			dir := t.TempDir()
			if err := os.Chmod(dir, 0700); err != nil {
				t.Fatal(err)
			}
			files, err := routerVPNOpenExternalFiles(dir)
			if err != nil {
				t.Fatal(err)
			}
			defer files.root.Close()
			op := &routerVPNSelectedCandidateOperation{owner: &routerVPNDesktopExecutionMeasurement{owner: &routerVPNNodeChainExecutionRuntime{files: files}},
				request:  routerVPNSelectedCandidateRequest{Request: strings.Repeat("a", 32), Generation: 1},
				metadata: routerVPNSelectedCandidateMetadata{Request: strings.Repeat("a", 32), Generation: 1, CaptureSHA: strings.Repeat("b", 64), Metadata: json.RawMessage(`{}`)}}
			raw, err := json.Marshal(op.metadata)
			if err != nil {
				t.Fatal(err)
			}
			pending, err := op.stagePublication(routerVPNExecutionCandidateMetadata, 64<<10, raw)
			if err != nil {
				t.Fatal(err)
			}
			defer pending.discard(files)
			name := routerVPNExecutionCandidateMetadata
			writeForeign := func() {
				if err := os.WriteFile(filepath.Join(files.root.Name(), name), raw, 0600); err != nil {
					t.Fatal(err)
				}
			}
			if race == "before-link" {
				writeForeign()
				original, err := files.root.Lstat(name)
				if err != nil {
					t.Fatal(err)
				}
				if op.linkMetadata(pending) == nil || op.startToken.MetadataSHA != "" || op.publication.info != nil {
					t.Fatal("unissued metadata reported as linked")
				}
				current, err := files.root.Lstat(name)
				if err != nil || !os.SameFile(current, original) {
					t.Fatal("foreign receipt overwritten by metadata publication")
				}
			} else {
				if err := op.linkMetadata(pending); err != nil {
					t.Fatal(err)
				}
				if err := files.root.Rename(name, name+".parent"); err != nil {
					t.Fatal(err)
				}
				writeForeign()
				if op.publication.current(files) == nil || op.startToken.MetadataSHA != routerVPNSelectedCandidateDigest(raw) || op.startToken.CaptureSHA != op.metadata.CaptureSHA {
					t.Fatal("late replacement lost the captured original receipt hashes")
				}
				observed, err := files.root.Lstat(name + ".parent")
				if err != nil || !os.SameFile(observed, op.publication.info) {
					t.Fatal("publisher lost the original inode the parent observed")
				}
			}
		})
	}

	for _, fault := range []string{"result-before-link", "result-after-link", "result-retry", "result-foreign-before-prepare"} {
		t.Run(fault, func(t *testing.T) {
			f := newDesktopSelectedCandidateComponent(t, "server", false, false, 1)
			files := f.owner.files
			name := routerVPNExecutionCandidateResult
			if fault == "result-foreign-before-prepare" {
				f.write(t, name, map[string]bool{"foreign": true})
				original, err := files.root.Lstat(name)
				if err != nil {
					t.Fatal(err)
				}
				f.step(t)
				after, err := files.root.Lstat(name)
				if err != nil || !os.SameFile(original, after) || f.owner.candidateGeneration != 0 || f.owner.measurement.Load().candidate.Load() != nil {
					t.Fatal("foreign result admitted another candidate preparation")
				}
				return
			}
			f.prepare(t)
			op := f.owner.measurement.Load().candidate.Load()
			result := routerVPNSelectedCandidateResult{op.request, op.metadata.CaptureSHA, op.startToken.MetadataSHA, time.Now().UnixMilli(), op.cancelledStatus()}
			raw, err := json.Marshal(result)
			if err != nil {
				t.Fatal(err)
			}
			if fault == "result-before-link" {
				pending, err := op.stagePublication(name, 128<<10, raw)
				if err != nil {
					t.Fatal(err)
				}
				if err := files.root.WriteFile(name, raw, 0600); err != nil {
					t.Fatal(err)
				}
				original, err := files.root.Lstat(name)
				if err != nil {
					t.Fatal(err)
				}
				_, linkErr := pending.link(files, name)
				pending.discard(files)
				if linkErr == nil {
					t.Fatal("result publication overwrote a receipt appearing after staging")
				}
				if op.publishResult(result) == nil || op.result.info != nil {
					t.Fatal("result publication admitted a preexisting receipt")
				}
				after, err := files.root.Lstat(name)
				if err != nil || !os.SameFile(original, after) {
					t.Fatal("result publication replaced the foreign original")
				}
				return
			}
			if err := op.publishResult(result); err != nil {
				t.Fatal(err)
			}
			issued := op.result
			if fault == "result-after-link" {
				if err := files.root.Rename(name, name+".issued"); err != nil {
					t.Fatal(err)
				}
				if err := files.root.WriteFile(name, raw, 0600); err != nil {
					t.Fatal(err)
				}
				foreign, err := files.root.Lstat(name)
				if err != nil {
					t.Fatal(err)
				}
				if op.finishRefusal(t.Context()) == nil {
					t.Fatal("replaced result acknowledged the original request")
				}
				after, err := files.root.Lstat(name)
				if err != nil || !os.SameFile(after, foreign) || op.input.current(files) != nil || f.owner.measurement.Load().candidate.Load() != op {
					t.Fatal("result refusal erased the foreign receipt or original reservation")
				}
				if err := files.root.Rename(name+".issued", name); err != nil {
					t.Fatal(err)
				}
			}
			result.CompletedAt++
			if err := op.publishResult(result); err != nil || !os.SameFile(issued.info, op.result.info) || !bytes.Equal(raw, op.result.raw) {
				t.Fatal("result retry changed the original issued bytes or inode", err)
			}
			if err := op.finishRefusal(t.Context()); err != nil || issued.current(files) != nil || f.owner.measurement.Load().candidate.Load() != nil {
				t.Fatal("original joined result retry failed", err)
			}
		})
	}
}
