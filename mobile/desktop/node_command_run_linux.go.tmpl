func init() { mainCommand.AddCommand(routerVPNNewLinuxImportedCommand()) }

// The installed parent launches this distinct family. Cobra only captures its
// exact arguments; the controlled child authenticates inherited descriptors
// before opening the independently captured imported graph.
func routerVPNNewLinuxImportedCommand() *cobra.Command {
	var directory, session, config, source, transfer string
	var mtu int
	var parent routerVPNNodeLinuxParentOptions
	command := &cobra.Command{Use: "routervpn-imported", Short: "Run one captured imported entry and paired Router exit", Args: cobra.NoArgs, SilenceUsage: true,
		RunE: func(command *cobra.Command, _ []string) error {
			ctx, cancel := signal.NotifyContext(command.Context(), os.Interrupt, syscall.SIGTERM)
			defer cancel()
			if err := ctx.Err(); err != nil {
				return err
			}
			return routerVPNRunLinuxImportedControlled(ctx, directory, session, config, source, transfer, mtu, parent)
		}}
	command.Flags().StringVar(&directory, "runtime-dir", "", "absolute private runtime directory")
	command.Flags().StringVar(&session, "session", "", "captured runtime identity")
	command.Flags().StringVar(&config, "config-sha256", "", "captured complete configuration digest")
	command.Flags().StringVar(&source, "physical-source-sha256", "", "captured imported physical owner identity")
	command.Flags().StringVar(&transfer, "physical-transfer-sha256", "", "captured protection selection")
	command.Flags().IntVar(&mtu, "physical-mtu", 0, "captured live TUN value for sealed restoration")
	command.Flags().IntVar(&parent.ChannelFD, "linux-parent-channel", 0, "inherited original Linux parent channel")
	command.Flags().IntVar(&parent.DirectoryFD, "linux-parent-directory", 0, "inherited original Linux parent task directory")
	command.Flags().StringVar(&parent.CaptureSHA256, "linux-parent-capture", "", "captured Linux command identity")
	routerVPNExternalOwnedFlags(command.Flags())
	return command
}

// The ordinary Linux host predicate stays closed until complete native
// acceptance. This explicit command path additionally requires the original
// created parent's descriptors, exact sealed policy and native ACKs; no flag
// can substitute a file acknowledgment or construct those capabilities.
func routerVPNRunLinuxNodeControlled(parent context.Context, directory, session, config, source, transfer string,
	mtu int, options routerVPNNodeLinuxParentOptions) error {
	return routerVPNRunLinuxPhysicalControlled(parent, directory, session, config, source, transfer, mtu, options, false)
}

// This child entry point requires the actual inherited descriptors and
// authenticated selection before any private source read.
func routerVPNRunLinuxImportedControlled(parent context.Context, directory, session, config, source, transfer string,
	mtu int, options routerVPNNodeLinuxParentOptions) error {
	return routerVPNRunLinuxPhysicalControlled(parent, directory, session, config, source, transfer, mtu, options, true)
}

func routerVPNRunLinuxPhysicalControlled(parent context.Context, directory, session, config, source, transfer string,
	mtu int, options routerVPNNodeLinuxParentOptions, imported bool) (failure error) {
	return routerVPNRunLinuxPhysicalFamilyControlled(parent, directory, session, config, source, transfer, mtu, options, imported, false)
}

func routerVPNRunLinuxNodeChainControlled(parent context.Context, directory, session, config, source, transfer string,
	mtu int, options routerVPNNodeLinuxParentOptions) error {
	return routerVPNRunLinuxPhysicalFamilyControlled(parent, directory, session, config, source, transfer, mtu, options, false, true)
}

func routerVPNRunLinuxPhysicalFamilyControlled(parent context.Context, directory, session, config, source, transfer string,
	mtu int, options routerVPNNodeLinuxParentOptions, imported, ordered bool) (failure error) {
	return routerVPNRunLinuxExecutionFamilyControlled(parent, directory, session, config, source, "", transfer, mtu, options, imported, ordered)
}

func routerVPNRunLinuxNodeChainExecutionControlled(parent context.Context, capture routerVPNNodeChainExecutionCommand) error {
	if capture.validate() != nil || capture.windows != (routerVPNNodeJournalOptions{}) || capture.linux == (routerVPNNodeLinuxParentOptions{}) {
		return routerVPNExternalFailure
	}
	return routerVPNRunLinuxExecutionFamilyControlled(parent, capture.directory, capture.session, capture.config, capture.physical, capture.source, capture.transfer, capture.mtu, capture.linux, false, false)
}

func routerVPNRunLinuxExecutionFamilyControlled(parent context.Context, directory, session, config, source, executionSource, transfer string,
	mtu int, options routerVPNNodeLinuxParentOptions, imported, ordered bool) error {
	return routerVPNRunLinuxPrefixFamilyControlled(parent, directory, session, config, source, executionSource, "", transfer, mtu, options, imported, ordered)
}

func routerVPNRunLinuxPrefixFamilyControlled(parent context.Context, directory, session, config, source, executionSource, prefixCapture, transfer string,
	mtu int, options routerVPNNodeLinuxParentOptions, imported, ordered bool) (failure error) {
 return routerVPNRunLinuxSOCKSFamilyControlled(parent,directory,session,config,source,executionSource,prefixCapture,transfer,mtu,options,imported,ordered,false)
}

func routerVPNRunLinuxNodeChainSOCKSControlled(parent context.Context,directory,session,config,source,transfer string,mtu int,options routerVPNNodeLinuxParentOptions)error{
 return routerVPNRunLinuxSOCKSFamilyControlled(parent,directory,session,config,source,"","",transfer,mtu,options,false,false,true)
}

func routerVPNRunLinuxSOCKSFamilyControlled(parent context.Context,directory,session,config,source,executionSource,prefixCapture,transfer string,
 mtu int,options routerVPNNodeLinuxParentOptions,imported,ordered,socks bool)(failure error){
 if socks && (imported||ordered||executionSource!=""||prefixCapture!=""){return routerVPNExternalFailure}
	if prefixCapture != "" && (executionSource != "" || imported || ordered || !routerVPNExternalSource.MatchString(prefixCapture)) {
		return routerVPNExternalFailure
	}
	if parent == nil || imported && ordered {
		return routerVPNExternalFailure
	}
	if executionSource != "" && (imported || ordered || !routerVPNExternalSource.MatchString(executionSource)) {
		return routerVPNExternalFailure
	}
	control, err := routerVPNOpenLinuxNodeControl(session, source, config, options)
	if control != nil {
		defer func() {
			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
			defer cancel()
			failure = errors.Join(failure, control.close(ctx))
		}()
	}
	if err != nil {
		return err
	}
	// Authentication above precedes opening this retained private workspace.
	files, err := routerVPNOpenExternalFiles(directory)
	if err != nil {
		return err
	}
	defer files.root.Close()
	ctx, stopPreparation := context.WithTimeout(parent, routerVPNNodeAdmissionLimit)
	defer stopPreparation()
	var policy mobilemultihop.DesktopPhysicalPolicy
	var executionPreparation *mobilemultihop.NodeChainExecutionPreparation
 if socks {
  policy,err=control.compileSOCKS(ctx,files,session,source,config,transfer,mtu)
  if err!=nil{return err}
 } else if prefixCapture != "" {
		capture := routerVPNNodeCandidatePrefixCommand{directory: directory, session: session, config: config, physical: source, capture: prefixCapture, transfer: transfer, mtu: mtu, linux: options}
		policy, err = control.compileCandidatePrefix(ctx, files, capture)
		if err != nil {
			return err
		}
	} else if executionSource != "" {
		capture := routerVPNNodeChainExecutionCommand{directory: directory, session: session, config: config, physical: source, source: executionSource, transfer: transfer, mtu: mtu, linux: options}
		executionPreparation, err = control.compileExecution(ctx, files, capture)
		if err != nil {
			return err
		}
		policy, err = executionPreparation.DesktopPhysicalPolicy()
		if err != nil {
			return err
		}
	} else if ordered {
		captured, compileErr := control.compileChain(ctx, files, session, source, config, transfer, mtu)
		if compileErr != nil {
			return compileErr
		}
		policy = captured
	} else if imported {
		captured, compileErr := control.compileImported(ctx, files, session, source, config, transfer, mtu)
		if compileErr != nil {
			return compileErr
		}
		original := captured.OriginalController()
		if original == nil {
			return routerVPNExternalFailure
		}
		// This defer precedes native cleanup registration: the constructor stays
		// live through original source join and parent retirement acknowledgment.
		defer func() {
			if !control.retired {
				failure = errors.Join(failure, errors.New("imported constructor retains unacknowledged native retirement"))
				return
			}
			failure = errors.Join(failure, original.Close())
		}()
		policy = captured
	} else {
		captured, compileErr := control.compile(ctx, files, session, source, config, transfer, mtu)
		if compileErr != nil {
			return compileErr
		}
		policy = captured
	}
	lifetime := globalCtx
	if lifetime == nil {
		lifetime = context.Background()
	}
	graph, cancel := context.WithCancel(service.ContextWithDefaultRegistry(service.ExtendContext(context.WithoutCancel(lifetime))))
	native := &routerVPNExternalNative{cancel: cancel, startupOwner: &routerVPNNodeStartupOwner{cancel: cancel}}
	control.native = native
	var socksRuntime *routerVPNDesktopSOCKSRuntime
 var socksConstruction *routerVPNDesktopSOCKSConstruction
	var chain *routerVPNNodeChainRuntime
	var execution *routerVPNNodeChainExecutionRuntime
	var prefix *routerVPNNodeCandidatePrefixRuntime
	var stopped atomic.Bool
	defer func() {
		stopped.Store(true)
		readyErr := files.remove("node-ready.json")
		cleanup, stop := context.WithTimeout(context.Background(), 15*time.Second)
		defer stop()
		if err:=socksRuntime.close(cleanup);err!=nil{failure=errors.Join(failure,err);return}
		if err := prefix.close(cleanup); err != nil {
			failure = errors.Join(failure, err)
			return
		}
		if err := execution.close(cleanup); err != nil {
			failure = errors.Join(failure, err)
			return
		}
		if err := chain.close(cleanup); err != nil {
			failure = errors.Join(failure, err)
			return
		}
		// Retain only this original partial Box/source across cleanup retries.
		// A failed Box close stays a failure; no replacement or named native
		// object is discovered to manufacture a joined source receipt.
		var lastJoinFailure error
		for {
			if err := control.joinNative(cleanup); err == nil {
				break
			} else if cleanup.Err() != nil {
				failure = errors.Join(failure, lastJoinFailure, err, cleanup.Err())
				return
			} else {
				lastJoinFailure = err
			}
			select {
			case <-cleanup.Done():
				failure = errors.Join(failure, lastJoinFailure, cleanup.Err())
				return
			case <-time.After(50 * time.Millisecond):
			}
		}
		if err := control.retire(cleanup); err != nil {
			failure = errors.Join(failure, err)
			return
		}
		if readyErr != nil {
			failure = errors.Join(failure, readyErr)
			return
		}
		closed := struct {
			routerVPNExternalStop
			Closed bool `json:"closed"`
		}{routerVPNExternalStop{Schema: 1, Session: session, SourceSHA256: config}, true}
		failure = errors.Join(failure, files.publish("stopped.json", closed))
	}()
	for _, name := range []string{"node-mtu-status.json", "node-mtu-request.json", "node-ready.json", "node-chain-ready.json", "node-chain-socks-ready.json", "node-chain-execution-ready.json", "node-chain-execution-adoption.json", "node-candidate-prefix-ready.json", "node-candidate-prefix-request.json", "node-candidate-prefix-result.json", "node-candidate-prefix-live.json", "node-candidate-prefix-cancel.json", "node-chain-measure-request.json", "node-chain-measure-cancel.json", "node-chain-measure-result.json", "node-chain-candidate-request.json", "node-chain-candidate-source.json", "node-chain-candidate-live.json", "node-chain-candidate-cancel.json", "node-chain-candidate-result.json", "node-protection-retired.json", "stopped.json", "node-protection-transfer.json", "node-dns-request.json", "node-dns-result.json", "node-dns-cancel.json"} {
		if _, err := files.root.Lstat(name); !errors.Is(err, os.ErrNotExist) {
			return routerVPNExternalFailure
		}
	}
	if parent.Err() != nil || files.stopRequested(session, config) {
		return nil
	}
	graph, err = control.prepare(graph, policy)
	if err != nil {
		return err
	}
 if captured,ok:=policy.(*mobilemultihop.DesktopNodeChainSOCKSPolicy);ok{
  socksConstruction,err=routerVPNNewDesktopSOCKSConstruction(graph,captured)
  if err!=nil{return err}
  graph=socksConstruction.ctx
 }
	parsed, err := SJ.UnmarshalExtendedContext[option.Options](graph, []byte(policy.Config()))
	if err != nil {
		return err
	}
	parsed.Log = &option.LogOptions{Disabled: true}
	for _, existing := range routerVPNExternalConstructed(graph) {
		if existing != nil {
			return routerVPNExternalFailure
		}
	}
	stopConstruction := routerVPNWatchNodeConstruction(ctx, func() bool { return files.stopRequested(session, config) }, cancel)
	defer stopConstruction()
	if err := ctx.Err(); err != nil {
		return err
	}
	instance, err := box.New(box.Options{Context: graph, Options: parsed})
	if instance != nil {
		native.box = instance
		native.startupOwner.original = instance
	}
	stopConstruction()
	if err != nil || instance == nil {
		if instance == nil {
			for _, partial := range routerVPNExternalConstructed(graph) {
				if closer, ok := partial.(io.Closer); ok {
					native.partial = append(native.partial, closer)
				}
			}
		}
		return errors.Join(err, routerVPNExternalFailure)
	}

	switch original := policy.(type) {
	case *mobilemultihop.DesktopNodePolicy:
		prepared, prepareErr := instance.RouterVPNDesktopLinuxNodePreparePhysicalOwned(original)
		if prepared != nil {
			control.preparation = prepared
		}
		err = prepareErr
	case *mobilemultihop.DesktopImportedPolicy:
		prepared, prepareErr := instance.RouterVPNDesktopLinuxImportedPreparePhysicalOwned(original)
		if prepared != nil {
			control.preparation = prepared
		}
		err = prepareErr
 case *mobilemultihop.DesktopNodeChainSOCKSPolicy:
  prepared,prepareErr:=instance.RouterVPNDesktopLinuxNodeChainSOCKSPreparePhysicalOwned(original)
  if prepared!=nil{control.preparation=prepared}
  err=prepareErr
	case *mobilemultihop.DesktopNodeChainPolicy:
		prepared, prepareErr := instance.RouterVPNDesktopLinuxNodeChainPreparePhysicalOwned(original)
		if prepared != nil {
			control.preparation = prepared
		}
		err = prepareErr
	case *mobilemultihop.DesktopNodeCandidatePreparationPolicy:
		prepared, prepareErr := instance.RouterVPNDesktopLinuxCandidatePrefixPreparePhysicalOwned(original)
		if prepared != nil {
			control.preparation = prepared
		}
		err = prepareErr
	case *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy:
		prepared, prepareErr := instance.RouterVPNDesktopLinuxNodeChainExecutionPreparePhysicalOwned(original)
		if prepared != nil {
			control.preparation = prepared
		}
		err = prepareErr
	default:
		return routerVPNExternalFailure
	}
	if err != nil {
		return err
	}
	if err := instance.RouterVPNDesktopStartupContext(ctx); err != nil {
		return err
	}
	if err := native.startupOwner.start(ctx, func() bool { return files.stopRequested(session, config) }, instance.RouterVPNStrategyStart); err != nil {
		return err
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	stopPreparation()
	proof, stopProof := context.WithTimeout(graph, routerVPNNodeAdmissionLimit)
	var physical *box.RouterVPNDesktopNodePhysical
	switch original := policy.(type) {
	case *mobilemultihop.DesktopNodePolicy:
		physical, err = instance.RouterVPNDesktopLinuxNodeActivatePhysical(proof, original)
	case *mobilemultihop.DesktopImportedPolicy:
		physical, err = instance.RouterVPNDesktopLinuxImportedActivatePhysical(proof, original)
 case *mobilemultihop.DesktopNodeChainSOCKSPolicy:
  physical,err=instance.RouterVPNDesktopLinuxNodeChainSOCKSActivatePhysical(proof,original)
	case *mobilemultihop.DesktopNodeChainPolicy:
		physical, err = instance.RouterVPNDesktopLinuxNodeChainActivatePhysical(proof, original)
	case *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy:
		physical, err = instance.RouterVPNDesktopLinuxNodeChainExecutionActivatePhysical(proof, original)
	case *mobilemultihop.DesktopNodeCandidatePreparationPolicy:
		physical, err = instance.RouterVPNDesktopLinuxCandidatePrefixActivatePhysical(proof, original)
	}
	stopProof()
	if err != nil {
		return err
	}
	activation, stopActivation := context.WithTimeout(graph, routerVPNNodeAdmissionLimit)
	var cover *box.RouterVPNDesktopLinuxNodeCover
	switch original := policy.(type) {
	case *mobilemultihop.DesktopNodePolicy:
		cover, err = instance.RouterVPNDesktopLinuxNodeActivateCover(activation, original, physical)
	case *mobilemultihop.DesktopImportedPolicy:
		cover, err = instance.RouterVPNDesktopLinuxImportedActivateCover(activation, original, physical)
 case *mobilemultihop.DesktopNodeChainSOCKSPolicy:
  cover,err=instance.RouterVPNDesktopLinuxNodeChainSOCKSActivateCover(activation,original,physical)
	case *mobilemultihop.DesktopNodeChainPolicy:
		cover, err = instance.RouterVPNDesktopLinuxNodeChainActivateCover(activation, original, physical)
	case *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy:
		cover, err = instance.RouterVPNDesktopLinuxNodeChainExecutionActivateCover(activation, original, physical)
	case *mobilemultihop.DesktopNodeCandidatePreparationPolicy:
		cover, err = instance.RouterVPNDesktopLinuxCandidatePrefixActivateCover(activation, original, physical)
	}
	stopActivation()
	if err != nil {
		return err
	}
	current := func(call context.Context) error {
		if err := call.Err(); err != nil {
			return err
		}
		if stopped.Load() || parent.Err() != nil || graph.Err() != nil {
			return routerVPNExternalFailure
		}
		if err := cover.CurrentContext(call); err != nil {
			return err
		}
		return control.current(call)
	}
 if socksConstruction!=nil{
  socksRuntime,err=routerVPNNewDesktopSOCKSRuntime(graph,files,socksConstruction,control.selectionHash,instance,physical,func(call context.Context)error{
   if stopped.Load()||parent.Err()!=nil||graph.Err()!=nil{return routerVPNExternalFailure}
   // Physical source observation is reentrant while its same TUN grant is
   // detached for this owner's original MTU operation. Cover.Current is not.
   return control.current(call)
  })
  if err!=nil{return err}
 }
	if captured, ok := policy.(*mobilemultihop.DesktopNodeChainPolicy); ok {
		chain, err = routerVPNNewNodeChainRuntime(graph, files, captured, control.selectionHash, instance)
		if err != nil {
			return err
		}
	}
	if executionPreparation != nil {
		execution, err = routerVPNNewNodeChainExecutionRuntime(graph, files, executionPreparation, control.selectionHash, instance, func(call context.Context) error {
			if stopped.Load() || parent.Err() != nil || graph.Err() != nil || physical == nil {
				return routerVPNExternalFailure
			}
			// Never reenter cover.CurrentContext while the original physical
			// MTU transaction intentionally holds its owner lock.
			if err := physical.NodeChainExecutionSourceCurrentContext(call, executionPreparation); err != nil {
				return err
			}
			return control.current(call)
		})
		if err != nil {
			return err
		}
	}
	if captured, ok := policy.(*mobilemultihop.DesktopNodeCandidatePreparationPolicy); ok {
		prefix, err = routerVPNNewNodeCandidatePrefixRuntime(graph, files, captured, control.selectionHash, instance)
		if err != nil {
			return err
		}
	}
	ready := func() error {
		ctx, cancel := context.WithTimeout(graph, routerVPNNodeAdmissionLimit)
		defer cancel()
		if err := control.current(ctx); err != nil {
			return err
		}
		if prefix != nil {
			return control.current(ctx)
		}
		if err := routerVPNProveNodeReadyCapturedCover(ctx, files, policy, control.selectionHash, physical, cover); err != nil {
			return err
		}
		return control.current(ctx)
 }
 if socksRuntime!=nil{return routerVPNRunNodeMTULoopWithSOCKS(parent,graph,files,instance,session,config,physical,current,ready,socksRuntime)}
 return routerVPNRunNodeMTULoopWithPrefix(parent,graph,files,instance,session,config,physical,current,ready,chain,execution,prefix)
}
