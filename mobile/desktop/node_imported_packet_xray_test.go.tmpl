		server := newServer([]desktopNodeLayerRoute{{Network: "tcp", Destination: net.JoinHostPort("10.77.0.1", port), Physical: finalPhysical}})
		layerFault := ""
		if strings.HasPrefix(fault, "final-layer-") {
			layerFault = fault
		}
		peer := desktopImportedSOCKSLayerProvider(t, server, outer, layerFault)
		f.finalCarrier = &peer
		t.Cleanup(peer.close)
		finalTarget, finalPhysical = desktopImportedSOCKSAddress(outer), peer.address
	} else if provisionalFinal["detour"] != "entry-wg" {
		t.Fatal("unlayered packet REALITY bypassed original entry")
	}
	entryRoutes := []desktopNodeLayerRoute{{Network: "tcp", Destination: finalTarget, Physical: finalPhysical}, {Network: "tcp", Destination: "1.1.1.1:443", Physical: public.Listener.Addr().String()}}
	source, capture := desktopImportedSOCKSXrayObject(t, args[0]), desktopImportedSOCKSXrayObject(t, args[1])
	if capture["expected_public_ip"] != "203.0.113.88" {
		t.Fatal("packet entry public proof capture changed")
	}
	entryProfile := capture["profile"].(map[string]any)
	external := entryProfile["external"].(map[string]any)
	var virtual, entryPhysical string
	var openvpnPeer *desktopExternalInstalledOpenVPNPeer
	if strings.HasPrefix(kind, "openvpn-") {
		f.entryNetwork = strings.TrimPrefix(kind, "openvpn-")
		loopback := netip.MustParseAddr("127.0.0.1")
		entry := startDesktopInstalledOpenVPNProviderCaptured(t, newServer(nil), desktopExternalInstalledPeerRequest{OpenVPNNetwork: f.entryNetwork}, "", "", loopback, loopback, true, 2,
			&desktopOpenVPNProviderCapture{Remote: netip.MustParseAddrPort("203.0.113.24:1194"), MTU: 1500, Routes: entryRoutes})
		openvpnPeer = &entry
		virtual, entryPhysical = entry.address, entry.entryRoutes[0].Target
		f.entryStats = func() desktopPacketRealityReceipt {
			s := entry.stats()
			return desktopPacketRealityReceipt{raw: s.connections + s.physicalUDP, tcp: s.streams, udp: s.packets, auth: s.authFailures}
		}
		config, password := entry.profile, entry.password
		if fault == "entry-auth" {
			password += "-foreign"
		}
		if fault == "entry-route" {
			config = strings.ReplaceAll(config, "203.0.113.24", "203.0.113.25")
		}
		external["openvpn"] = map[string]any{"config": config, "username": entry.username, "password": password}
		endpoint, err := nativeopenvpn.CompileProfile(nativeopenvpn.Profile{Config: config, Username: entry.username, Password: password}, "custom-exit", "")
		if err != nil {
			t.Fatal(err)
		}
		source["endpoints"] = []any{endpoint}
	} else {
		f.entryNetwork = "udp"
		endpoint := source["endpoints"].([]any)[0].(map[string]any)
		peer := endpoint["peers"].([]any)[0].(map[string]any)
		virtual = net.JoinHostPort(peer["address"].(string), fmt.Sprint(int(peer["port"].(float64))))
		provider, err := ecdh.X25519().GenerateKey(rand.Reader)
		if err != nil {
			t.Fatal(err)
		}
		consumer, err := ecdh.X25519().GenerateKey(rand.Reader)
		if err != nil {
			t.Fatal(err)
		}
		secret := make([]byte, 32)
		if _, err := rand.Read(secret); err != nil {
			t.Fatal(err)
		}
		defer clear(secret)
		encode := base64.StdEncoding.EncodeToString
		request := desktopExternalInstalledWGRequest{PrivateKey: encode(provider.Bytes()), ClientPublicKey: encode(consumer.PublicKey().Bytes()), PresharedKey: encode(secret)}
		parameters, backend := "", startDesktopDarwinWGDevice
		if kind == "amneziawg" {
			values := map[string]string{}
			for k, v := range endpoint["amnezia"].(map[string]any) {
				values[k] = v.(string)
			}
			parameters, backend = desktopDarwinAmneziaBackend(t, desktopExternalInstalledAWGRequest{request, values})
		} else if kind != "wireguard" {
			t.Fatal("uncaptured packet REALITY protocol")
		}
		rules := map[string]desktopReferenceRule{}
		for _, route := range entryRoutes {
			address := netip.MustParseAddrPort(route.Destination)
			rules[route.Network+"/"+route.Destination] = desktopReferenceRule{Network: route.Network, Address: address.Addr().String(), Port: int(address.Port()), Target: route.Physical}
		}
		entry := desktopInstalledPacketDevice(t, newServer(entryRoutes), request, netip.MustParseAddr("127.0.0.1"), parameters, backend, rules, false)
		entryPhysical = entry.address
		f.entryStats = func() desktopPacketRealityReceipt {
			raw, tcp, udp := entry.stats()
			return desktopPacketRealityReceipt{raw: raw, tcp: tcp, udp: udp}
		}
		endpoint["private_key"], endpoint["address"] = encode(consumer.Bytes()), []string{"10.78.0.2/32", "fd78:78::2/128"}
		peer["public_key"], peer["pre_shared_key"] = encode(provider.PublicKey().Bytes()), encode(secret)
		switch fault {
		case "entry-private-key":
			endpoint["private_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
		case "entry-public-key":
			peer["public_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
		case "entry-psk":
			peer["pre_shared_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
		case "entry-awg-parameter":
			endpoint["amnezia"].(map[string]any)["s1"] = "57"
		case "entry-route":
			peer["address"] = "203.0.113.25"
		}
		credentials := external[kind].(map[string]any)
		credentials["private_key"], credentials["addresses"], credentials["peer_public_key"], credentials["preshared_key"] = endpoint["private_key"], endpoint["address"], peer["public_key"], peer["pre_shared_key"]
		credentials["endpoint"] = net.JoinHostPort(peer["address"].(string), fmt.Sprint(int(peer["port"].(float64))))
		if kind == "amneziawg" {
			credentials["parameters"] = endpoint["amnezia"]
		}
	}
	args[0], args[1] = desktopImportedSOCKSXrayJSON(t, source), desktopImportedSOCKSXrayJSON(t, capture)
	f.source, f.captured = args, append([]string(nil), args...)
	f.plan = desktopPacketRealityCompile(t, args)
	f.config = f.plan.Config()
	graph := desktopImportedSOCKSXrayObject(t, f.config)
	byTag := desktopImportedSOCKSGraph(graph)
	firstRaw, finalRaw := byTag["entry-wg"], byTag[mobilemultihop.LocalTag]
	if firstRaw == nil || desktopImportedSOCKSXrayJSON(t, finalRaw) != desktopImportedSOCKSXrayJSON(t, provisionalFinal) {
		t.Fatal("entry provider changed independent original REALITY final")
	}
	if json.Unmarshal([]byte(f.plan.Metadata()), &f.meta) != nil || f.meta.EntryKind != "external" || f.meta.EntryMode != strings.Split(kind, "-")[0] && f.meta.EntryMode != kind || f.meta.EntryAPI != "" || f.meta.EntryNodeID != "" || f.meta.EntryToken != "" || f.meta.ExitMode != mode || f.meta.TransportCapability != "" || f.meta.ExitNodeID != identity || f.meta.ExitAPI != "http://10.77.0.1:8787" {
		t.Fatal("packet REALITY changed captured proof or transport authority")
	}
	selectedDNS := graph["dns"].(map[string]any)
	for _, row := range selectedDNS["servers"].([]any) {
		selected := row.(map[string]any)
		if selected["tag"] == selectedDNS["final"] {
			if len(f.selected) != 0 {
				t.Fatal("packet REALITY selected multiple DNS owners")
			}
			if selectedPeer != nil {
				expected := map[string]any{"type": transportKind, "tag": selectedDNS["final"], "server": profile["dns_host"], "server_port": profile["dns_port"], "detour": "proxy", "tls": map[string]any{"enabled": true, "server_name": profile["dns_server_name"]}}
				if transportKind != "tls" {
					expected["path"] = profile["dns_path"]
				}
				if desktopImportedSOCKSXrayJSON(t, expected) != desktopImportedSOCKSXrayJSON(t, selected) {
					t.Fatal("packet REALITY changed exact selected DNS transport, identity or owner")
				}
			} else {
				wanted := "192.168.50.133"
				if fault == "dns-route" {
					wanted = "192.168.50.134"
				}
				if selected["type"] != "udp" || selected["server"] != wanted || selected["detour"] != "proxy" {
					t.Fatal("packet REALITY changed captured Home DNS")
				}
			}
			f.selected = []byte(desktopImportedSOCKSXrayJSON(t, selected))
		}
	}
	if len(f.selected) == 0 {
		t.Fatal("packet REALITY lost selected DNS")
	}
	planned := desktopImportedSOCKSXrayObject(t, finalRaw["config_json"].(string))
	plannedUser := planned["outbounds"].([]any)[0].(map[string]any)["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)
	if plannedUser["flow"] != flow {
		t.Fatal("packet REALITY replaced its original ordinary/UDP443 flow")
	}
	outer := desktopImportedSOCKSOuter(t, byTag, firstRaw, "")
	if firstLayer != "off" {
		if outer == nil || outer["tag"] == firstRaw["tag"] || outer["detour"] != nil {
			t.Fatal("packet REALITY entry layer lost its independent physical owner")
		}
		var layerRaw map[string]any
		var inner string
		if openvpnPeer != nil {
			if outer["type"] != nativeopenvpn.LayerMapType {
				t.Fatal("OpenVPN REALITY lost its captured layer mapper")
			}
			mapping := outer["layers"].(map[string]any)["203.0.113.24"].(map[string]any)
			api, err := url.Parse(mapping["api"].(string))
			if err != nil {
				t.Fatal(err)
			}
			inner = net.JoinHostPort(api.Hostname(), "1194")
			layerRaw = desktopImportedSOCKSXrayObject(t, desktopImportedSOCKSXrayJSON(t, mapping["transport"]))
			if firstLayer == "aes-256-gcm+xor-whitening" {
				layerRaw["type"] = "routervpn-aes-xor"
				layerRaw["server_port"] = float64(8389)
			}
		} else {
			peer := firstRaw["peers"].([]any)[0].(map[string]any)
			inner = net.JoinHostPort(peer["address"].(string), fmt.Sprint(int(peer["port"].(float64))))
			layerRaw = outer
		}
		layerFault := ""
		if strings.HasPrefix(fault, "entry-layer-") {
			layerFault = fault
		}
		layer := desktopImportedSOCKSLayerProvider(t, newServer([]desktopNodeLayerRoute{{Network: f.entryNetwork, Destination: inner, Physical: entryPhysical}}), layerRaw, layerFault)
		f.entryCarrier = &layer
		t.Cleanup(layer.close)
		virtual, entryPhysical = desktopImportedSOCKSAddress(layerRaw), layer.address
	} else if outer["tag"] != firstRaw["tag"] || firstRaw["detour"] != nil {
		t.Fatal("unlayered packet REALITY invented a wrapper")
	}
	f.lower = newDesktopPacketRealityPhysical(f.entryNetwork, M.ParseSocksaddr(virtual), entryPhysical)
	t.Cleanup(func() {
		if err := f.lower.Close(); err != nil {
			t.Error("packet physical fixture did not retire", err)
		}
	})
	ctx, cancel := context.WithTimeout(pause.WithDefaultManager(context.Background()), 15*time.Second)
	f.ctx = ctx
	t.Cleanup(cancel)
	f.manager = &desktopImportedSOCKSXrayManager{owners: map[string]adapter.Outbound{f.lower.Tag(): f.lower}}
	owned := service.ContextWith[adapter.OutboundManager](ctx, f.manager)
	owned = service.ContextWith[adapter.NetworkManager](owned, &desktopImportedPacketNetwork{})
	f.ingress = &desktopImportedOpenVPNIngress{t: t}
	owned = service.ContextWith[adapter.Router](owned, f.ingress)
	t.Cleanup(func() {
		if err := f.close(); err != nil {
			t.Error("original packet REALITY native owners did not join before fixture cleanup", err)
		}
		if f.ingress.active.Load() != 0 {
			t.Error("packet REALITY routed unsolicited inbound traffic")
		}
	})
	f.firstRaw = desktopImportedSOCKSXrayObject(t, desktopImportedSOCKSXrayJSON(t, firstRaw))
	if firstLayer != "off" {
		outer["detour"] = f.lower.Tag()
		f.manager.owners[outer["tag"].(string)] = desktopImportedOpenVPNNative(t, owned, outer)
	} else {
		firstRaw["detour"] = f.lower.Tag()
	}
	f.first = desktopImportedOpenVPNNative(t, owned, firstRaw)
	f.manager.owners["entry-wg"] = f.first
	if openvpnPeer != nil {
		f.openvpn = f.first.(*OV.ClientEndpoint)
	}
	// Packet endpoint startup may immediately launch receive workers whose
	// detours read this same manager. Complete its immutable catalog first.
	if lastLayer != "off" {
		f.manager.owners[mobilemultihop.NativeStartLayerTag] = desktopImportedSOCKSNativeLayer(t, owned, byTag[mobilemultihop.NativeStartLayerTag])
	}
	for _, stage := range []adapter.StartStage{adapter.StartStateInitialize, adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
		if err := f.first.(adapter.Lifecycle).Start(stage); err != nil {
			f.startErr = err
			return f
		}
	}
	finalCtx, cancelFinal := context.WithCancel(owned)
	f.owned, f.cancelFinal = finalCtx, cancelFinal
	if json.Unmarshal([]byte(desktopImportedSOCKSXrayJSON(t, finalRaw)), &f.finalOptions) != nil {
		t.Fatal("packet REALITY lost exact native final options")
	}
	f.final, err = XR.NewOutbound(finalCtx, nil, log.NewNOPFactory().Logger(), mobilemultihop.LocalTag, f.finalOptions)
	if err != nil {
		t.Fatal(err)
	}
	if err := f.final.(adapter.Lifecycle).Start(adapter.StartStateStart); err != nil {
		t.Fatal("packet REALITY native final did not start", err)
	}
	return f
}

func TestRouterVPNImportedWireGuardRealityNativeTraffic(t *testing.T) {
	desktopPacketRealityCases(t, "wireguard")
}
func TestRouterVPNImportedAmneziaRealityNativeTraffic(t *testing.T) {
	desktopPacketRealityCases(t, "amneziawg")
}
func TestRouterVPNImportedOpenVPNTCPRealityNativeTraffic(t *testing.T) {
	desktopPacketRealityCases(t, "openvpn-tcp")
}
func TestRouterVPNImportedOpenVPNUDPRealityNativeTraffic(t *testing.T) {
	desktopPacketRealityCases(t, "openvpn-udp")
}

func desktopPacketRealityCases(t *testing.T, kind string) {
	for _, first := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		for _, last := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			t.Run(first+"--"+last, func(t *testing.T) {
				faults := []string{"success", "cancel", "close-owner", "replacement-owner"}
				if first == "off" && last == "off" {
					faults = append(faults, "entry-route", "wrong-entry-ip", "final-reality-key", "final-user", "final-route", "dns-route", "final-identity", "final-token")
					if strings.HasPrefix(kind, "openvpn-") {
						faults = append(faults, "entry-auth")
					} else {
						faults = append(faults, "entry-private-key", "entry-public-key", "entry-psk")
						if kind == "amneziawg" {
							faults = append(faults, "entry-awg-parameter")
						}
					}
				}
				if first != "off" {
					faults = append(faults, "entry-layer-key")
				}
				if first == "aes-256-gcm+xor-whitening" {
					faults = append(faults, "entry-layer-whitening")
				}
				if last != "off" {
					faults = append(faults, "final-layer-key")
				}
				if last == "aes-256-gcm+xor-whitening" {
					faults = append(faults, "final-layer-whitening")
				}
				for _, fault := range faults {
					t.Run(fault, func(t *testing.T) { desktopPacketRealityTraffic(t, kind, first, last, fault) })
				}
			})
		}
	}
}

func desktopPacketRealityTraffic(t *testing.T, kind, first, last, fault string, selectedMode ...string) {
	t.Helper()
	f := desktopPacketRealityNew(t, kind, first, last, fault, nil, selectedMode...)
	if f.startErr != nil {
		f.audit = func() {
			stats := f.entryStats()
			if fault != "entry-route" || f.lower.denied.Load() == 0 || f.lower.calls.Load() != 0 || stats.raw != 0 || stats.tcp != 0 || stats.udp != 0 || f.finalServer.rawTCP.Load() != 0 {
				t.Fatal("packet REALITY native startup failed without its exact foreign-tuple refusal", f.startErr)
			}
		}
		if err := f.close(); err != nil {
			t.Fatal(err)
		}
		return
	}
	entryFailure := strings.HasPrefix(fault, "entry-") || fault == "wrong-entry-ip"
	entryErr := f.connectedEntry(f.ctx)
	if entryErr != nil && !entryFailure {
		t.Fatal("actual packet REALITY entry did not authenticate", entryErr)
	}
	publicOK := false
	var err error
	if entryErr == nil {
		publicOK, err = desktopImportedSOCKSXrayPublic(f.ctx, f.first, f.roots, "203.0.113.88")
	}
	if publicOK == entryFailure {
		t.Fatal("packet REALITY independent entry proof changed", err, entryErr)
	}
	dnsOK, proofOK := false, false
	if publicOK {
		wanted := "192.168.50.133:53"
		if fault == "dns-route" {
			wanted = "192.168.50.134:53"
		}
		dnsOK, err = desktopImportedSOCKSXrayDNS(f.ctx, f.final, wanted)
		wantDNS := fault != "final-reality-key" && fault != "final-pq-key" && fault != "final-user" && fault != "final-route" && fault != "dns-route" && !strings.HasPrefix(fault, "final-layer-")
		if dnsOK != wantDNS {
			t.Fatal("packet REALITY selected Home DNS did not traverse its original authenticated chain", err)
		}
		if dnsOK {
			proofOK, err = desktopImportedSOCKSXrayProof(f.ctx, f.final, f.meta.ExitAPI, f.meta.ExitNodeID, f.meta.ExitToken)
			if proofOK != (fault != "final-identity" && fault != "final-token") {
				t.Fatal("packet REALITY independent paired proof changed", err)
			}
		}
	}
	success := fault == "success" || fault == "cancel" || fault == "close-owner" || fault == "replacement-owner"
	if (publicOK && dnsOK && proofOK) != success || f.plan.Healthy() {
		t.Fatal("packet REALITY confused a userspace proof with host readiness")
	}
	f.recheckConnected(t)
	if success {
		for _, network := range []string{"tcp", "udp"} {
			if err := desktopImportedSOCKSXrayEcho(f.ctx, f.final, network); err != nil {
				t.Fatal("packet REALITY final payload failed", network, err)
			}
		}
	}
	var replacement adapter.Outbound
	if fault == "replacement-owner" {
		replacement, err = XR.NewOutbound(f.owned, nil, log.NewNOPFactory().Logger(), mobilemultihop.LocalTag, f.finalOptions)
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() {
			if err := replacement.(io.Closer).Close(); err != nil {
				t.Error(err)
			}
		})
		if err := replacement.(adapter.Lifecycle).Start(adapter.StartStateStart); err != nil {
			t.Fatal(err)
		}
		for _, network := range []string{"tcp", "udp"} {
			if err := desktopImportedSOCKSXrayEcho(f.ctx, replacement, network); err != nil {
				t.Fatal("replacement final did not prove its own traffic", network, err)
			}
		}
	}
	if fault == "cancel" || fault == "close-owner" || fault == "replacement-owner" {
		held, err := f.final.DialContext(f.ctx, "tcp", M.ParseSocksaddr("192.0.2.99:9999"))
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() { _ = held.Close() })
		if err := held.SetDeadline(time.Now().Add(2 * time.Second)); err != nil {
			t.Fatal(err)
		}
		if err := desktopImportedSOCKSXrayExchange(held); err != nil {
			t.Fatal("retirement did not first prove its original held stream", err)
		}
		if fault == "cancel" {
			f.cancelFinal()
		} else if err := f.final.(io.Closer).Close(); err != nil {
			t.Fatal(err)
		}
		_ = held.SetReadDeadline(time.Now().Add(2 * time.Second))
		var body [1]byte
		if n, err := held.Read(body[:]); n != 0 || err == nil {
			t.Fatal("retired original final kept its application stream")
		} else if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
			t.Fatal("retirement waited only for the fixture deadline")
		}
		calls, streams := f.lower.calls.Load(), f.entryStats().tcp
		late, err := f.final.DialContext(context.Background(), "tcp", M.ParseSocksaddr("192.0.2.99:9999"))
		if late != nil {
			_ = late.Close()
		}
		if late != nil || err == nil || f.lower.calls.Load() != calls || f.entryStats().tcp != streams {
			t.Fatal("retired final acquired another physical or authenticated packet-entry stream")
		}
		f.retired, f.retiredTCP = true, streams
	}
	if replacement != nil {
		for _, network := range []string{"tcp", "udp"} {
			if err := desktopImportedSOCKSXrayEcho(f.ctx, replacement, network); err != nil {
				t.Fatal("original retirement damaged the independent replacement", network, err)
			}
		}
		if err := replacement.(io.Closer).Close(); err != nil {
			t.Fatal(err)
		}
		f.retiredTCP = f.entryStats().tcp
	}
	f.recheckConnected(t)
	if err := f.close(); err != nil {
		t.Fatal("packet native owners did not drain before physical fixture teardown", err)
	}
	f.audit = func() {
		stats := f.entryStats()
		if f.retired && stats.tcp != f.retiredTCP {
			t.Fatal("retired final opened a deferred authenticated entry stream before original peer cleanup joined")
		}
		if stats.udp != 0 || !reflect.DeepEqual(f.source, f.captured) || f.plan.Config() != f.config || f.plan.Healthy() {
			t.Fatal("packet REALITY rewrote its capture or exposed an unowned entry UDP service")
		}
		if fault == "entry-route" {
			if f.lower.denied.Load() == 0 || f.lower.calls.Load() != 0 || stats.raw != 0 {
				t.Fatal("wrong entry tuple reached original physical provider")
			}
		} else if f.lower.calls.Load() == 0 {
			t.Fatal("packet REALITY did not attempt the original captured physical owner")
		}
		if fault == "entry-auth" && stats.auth == 0 {
			t.Fatal("OpenVPN negative did not witness actual provider authentication rejection")
		}
		if strings.HasPrefix(fault, "entry-layer-") {
			if stats.raw != 0 || stats.tcp != 0 {
				t.Fatal("rejected entry layer reached the original packet provider")
			}
		} else if fault != "entry-route" && stats.raw == 0 {
			t.Fatal("packet negative did not reach its original ciphertext provider")
		}
		if entryFailure || fault == "final-route" || strings.HasPrefix(fault, "final-layer-") {
			if f.finalServer.rawTCP.Load() != 0 || f.dns.Load() != 0 || f.health.Load() != 0 {
				t.Fatal("rejected original entry or final route reached the paired engine")
			}
		} else if f.finalServer.rawTCP.Load() == 0 {
			t.Fatal("packet REALITY did not reach original final ciphertext")
		}
		if fault == "final-reality-key" || fault == "final-pq-key" || fault == "final-user" {
			if f.dns.Load() != 0 || f.health.Load() != 0 || f.finalServer.plainTCP.Load() != 0 || f.finalServer.plainUDP.Load() != 0 {
				t.Fatal("foreign REALITY credential gained final plaintext")
			}
		}
		wantedPublic := int64(1)
		if entryFailure && fault != "wrong-entry-ip" {
			wantedPublic = 0
		}
		if f.public.Load() != wantedPublic {
			t.Fatal("packet REALITY lost its independent public proof")
		}
		if success && (f.dns.Load() != 1 || f.health.Load() != 1 || f.authorized.Load() != 1 || f.finalServer.plainTCP.Load() == 0 || f.finalServer.plainUDP.Load() == 0 || stats.tcp < 2) {
			t.Fatal("packet REALITY omitted actual payload, selected DNS or distinct paired proof")
		}
		if fault == "dns-route" && (f.dns.Load() != 0 || f.health.Load() != 0) {
			t.Fatal("foreign DNS route reached original resolver or proof")
		}
		if fault == "final-identity" || fault == "final-token" {
			wanted := int64(1)
			if fault == "final-token" {
				wanted = 0
			}
			if f.dns.Load() != 1 || f.health.Load() != 1 || f.authorized.Load() != wanted {
				t.Fatal("paired final refusal lost independent DNS/token evidence")
			}
		}
		for _, role := range []struct {
			name, network string
			peer          *desktopExternalInstalledSSPeer
		}{{"entry", f.entryNetwork, f.entryCarrier}, {"final", "tcp", f.finalCarrier}} {
			if role.peer == nil {
				continue
			}
			observed := role.peer.stats()
			failed := strings.HasPrefix(fault, role.name+"-layer-")
			if role.network == "tcp" && (observed.PhysicalUDP != 0 || observed.Packets != 0) || role.network == "udp" && (observed.PhysicalTCP != 0 || observed.Streams != 0) {
				t.Fatal("independent layer changed original physical transport", role.name)
			}
			if failed {
				if observed.AuthTCP+observed.AuthUDP == 0 || observed.Streams+observed.Packets != 0 {
					t.Fatal("independent packet layer lacks actual rejection", role.name)
				}
			} else if !entryFailure && observed.Streams+observed.Packets == 0 {
				t.Fatal("packet REALITY bypassed its independent layer", role.name)
			}
		}
	}
}

func TestRouterVPNImportedPacketRealityPhysicalOwner(t *testing.T) {
	for _, network := range []string{"tcp", "udp"} {
		t.Run(network, func(t *testing.T) {
			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
			defer cancel()
			var address string
			joined := make(chan struct{})
			var workers sync.WaitGroup
			if network == "tcp" {
				listener, err := net.Listen("tcp4", "127.0.0.1:0")
				if err != nil {
					t.Fatal(err)
				}
				address = listener.Addr().String()
				go func() {
					defer close(joined)
					for range 2 {
						connection, err := listener.Accept()
						if err != nil {
							return
						}
						workers.Add(1)
						go func() { defer workers.Done(); defer connection.Close(); _, _ = io.Copy(connection, connection) }()
					}
				}()
				t.Cleanup(func() {
					_ = listener.Close()
					select {
					case <-joined:
					case <-time.After(time.Second):
						t.Error("packet TCP acceptor did not join")
						return
					}
					done := make(chan struct{})
					go func() { workers.Wait(); close(done) }()
					select {
					case <-done:
					case <-time.After(time.Second):
						t.Error("packet TCP echo workers did not join")
					}
				})
			} else {
				packet, err := net.ListenPacket("udp4", "127.0.0.1:0")
				if err != nil {
					t.Fatal(err)
				}
				address = packet.LocalAddr().String()
				go func() {
					defer close(joined)
					body := make([]byte, 4096)
					for {
						n, peer, err := packet.ReadFrom(body)
						if err != nil {
							return
						}
						if _, err := packet.WriteTo(body[:n], peer); err != nil {
							return
						}
					}
				}()
				t.Cleanup(func() {
					_ = packet.Close()
					select {
					case <-joined:
					case <-time.After(time.Second):
						t.Error("packet UDP echo worker did not join")
					}
				})
			}
			target := M.ParseSocksaddr("203.0.113.20:1194")
			owner := newDesktopPacketRealityPhysical(network, target, address)
			replacement := newDesktopPacketRealityPhysical(network, target, address)
			defer owner.Close()
			defer replacement.Close()
			foreign := "tcp"
			if network == "tcp" {
				foreign = "udp"
			}
			for _, probe := range []struct {
				network string
				target  M.Socksaddr
			}{{foreign, target}, {network, M.ParseSocksaddr("203.0.113.21:1194")}, {network, M.ParseSocksaddr("203.0.113.20:1195")}} {
				connection, err := owner.DialContext(ctx, probe.network, probe.target)
				if connection != nil {
					_ = connection.Close()
				}
				if connection != nil || err == nil {
					t.Fatal("packet physical owner widened its captured tuple")
				}
			}
			if packet, err := owner.ListenPacket(ctx, target); packet != nil || err == nil || owner.calls.Load() != 0 || owner.denied.Load() != 3 {
				t.Fatal("packet physical owner granted an unowned listener")
			}
			first, err := owner.DialContext(ctx, network, target)
			if err != nil {
				t.Fatal(err)
			}
			defer first.Close()
			second, err := replacement.DialContext(ctx, network, target)
			if err != nil {
				t.Fatal(err)
			}
			defer second.Close()
			for _, connection := range []net.Conn{first, second} {
				if err := connection.SetDeadline(time.Now().Add(time.Second)); err != nil {
					t.Fatal(err)
				}
				if err := desktopImportedSOCKSXrayExchange(connection); err != nil {
					t.Fatal("original packet physical owner did not carry its bytes", err)
				}
			}
			if err := first.Close(); err != nil {
				t.Fatal(err)
			}
			if err := owner.empty(ctx); err != nil {
				t.Fatal(err)
			}
			if err := owner.Close(); err != nil {
				t.Fatal(err)
			}
			late, err := owner.DialContext(ctx, network, target)
			if late != nil {
				_ = late.Close()
			}
			if late != nil || err == nil || owner.calls.Load() != 1 {
				t.Fatal("retired packet owner admitted another physical dial")
			}
			if err := desktopImportedSOCKSXrayExchange(second); err != nil {
				t.Fatal("packet retirement closed independent replacement", err)
			}
			if err := second.Close(); err != nil {
				t.Fatal(err)
			}
			if err := replacement.empty(ctx); err != nil {
				t.Fatal(err)
			}
		})
	}
}

// These PQ verdicts retain their independent physical interface requirement.
func TestRouterVPNImportedPQRealityPacketTraffic(t *testing.T) {
	for _, kind := range []string{"wireguard", "amneziawg", "openvpn-tcp", "openvpn-udp"} {
		for _, first := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, last := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				for _, fault := range desktopImportedPQXrayFaults(first, last) {
					t.Run(kind+"/"+first+"/"+last+"/"+fault, func(t *testing.T) { desktopPacketRealityTraffic(t, kind, first, last, fault, "reality-pq-vision") })
				}
			}
		}
	}
}
