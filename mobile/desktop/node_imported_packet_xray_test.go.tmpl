// Reuse the checked descriptor registry, but admit exactly one captured packet
// transport. No listener, alternate tuple, system interface or fallback is granted.
type desktopPacketRealityPhysical struct {
	*desktopImportedSOCKSXrayPhysical
	network string
	denied  atomic.Int64
}

func newDesktopPacketRealityPhysical(network string, expected M.Socksaddr, physical string) *desktopPacketRealityPhysical {
	return &desktopPacketRealityPhysical{network: network, desktopImportedSOCKSXrayPhysical: &desktopImportedSOCKSXrayPhysical{
		Adapter:  outbound.NewAdapterWithDialerOptions("direct", "fixture-original-packet-physical", []string{network}, option.DialerOptions{}),
		expected: expected, physical: physical, connections: map[*desktopImportedSOCKSXrayConnection]bool{}, changed: make(chan struct{}),
	}}
}

func (p *desktopPacketRealityPhysical) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	p.mu.Lock()
	if p.closed || ctx.Err() != nil {
		p.mu.Unlock()
		return nil, errors.Join(ctx.Err(), net.ErrClosed)
	}
	if (p.network != "tcp" && p.network != "udp") || network != p.network || destination != p.expected {
		p.denied.Add(1)
		p.mu.Unlock()
		return nil, errors.New("packet REALITY rejected an uncaptured physical tuple")
	}
	p.pending++
	p.signal()
	p.mu.Unlock()
	defer func() { p.mu.Lock(); p.pending--; p.signal(); p.mu.Unlock() }()
	p.calls.Add(1)
	raw, err := (&net.Dialer{}).DialContext(ctx, network+"4", p.physical)
	if err != nil {
		return nil, err
	}
	connection := &desktopImportedSOCKSXrayConnection{Conn: raw, owner: p.desktopImportedSOCKSXrayPhysical}
	p.mu.Lock()
	p.connections[connection] = true
	retired := p.closed || ctx.Err() != nil
	p.signal()
	p.mu.Unlock()
	if retired {
		return nil, errors.Join(ctx.Err(), net.ErrClosed, connection.Close())
	}
	return connection, nil
}

// The packet reference providers retain their loopback-only forwarding rules.
// This one owned bridge forwards unchanged ciphertext to the actual REALITY
// listener on the already verified physical interface. It cannot select another
// destination, and it does not replace the mandatory interface inventory check.
func desktopPacketRealityCiphertextBridge(t *testing.T, physical netip.Addr, target string) string {
	t.Helper()
	address, err := netip.ParseAddrPort(target)
	if err != nil || !physical.Is4() || !physical.IsPrivate() || physical.IsLoopback() || address.Addr() != physical || address.Port() == 0 {
		t.Fatal("packet REALITY bridge lost its original physical reference tuple", err)
	}
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	s := &desktopNodeLayerServer{ctx: ctx, cancel: cancel, connections: map[io.Closer]bool{}}
	s.workers.Add(1)
	go func() {
		defer s.workers.Done()
		for {
			client, err := listener.Accept()
			if err != nil {
				return
			}
			if !s.enter(client) {
				_ = client.Close()
				return
			}
			go func() {
				defer s.leave(client)
				remote, err := (&net.Dialer{Timeout: 2 * time.Second}).DialContext(ctx, "tcp4", target)
				if err != nil {
					return
				}
				if !s.enter(remote) {
					_ = remote.Close()
					return
				}
				defer s.leave(remote)
				joined := make(chan struct{})
				go func() { _, _ = io.Copy(remote, client); _ = client.Close(); _ = remote.Close(); close(joined) }()
				_, _ = io.Copy(client, remote)
				_ = client.Close()
				_ = remote.Close()
				<-joined
			}()
		}
	}()
	t.Cleanup(func() {
		s.mu.Lock()
		s.closing = true
		owned := make([]io.Closer, 0, len(s.connections))
		for c := range s.connections {
			owned = append(owned, c)
		}
		s.mu.Unlock()
		cancel()
		_ = listener.Close()
		for _, c := range owned {
			_ = c.Close()
		}
		joined := make(chan struct{})
		go func() { s.workers.Wait(); close(joined) }()
		select {
		case <-joined:
		case <-time.After(2 * time.Second):
			t.Error("original packet REALITY ciphertext bridge did not join")
		}
	})
	return listener.Addr().String()
}

func desktopPacketRealitySource(t *testing.T, name string) []string {
	t.Helper()
	directory := os.Getenv("ROUTERVPN_IMPORTED_PACKET_XRAY_FIXTURES")
	if directory == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_PACKET_XRAY_FIXTURES") == "1" {
			t.Fatal("required original packet REALITY captures absent")
		}
		t.Skip("native reference gate supplies original packet REALITY captures")
	}
	path := filepath.Join(directory, name)
	info, err := os.Lstat(path)
	if err != nil || !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > 1<<20 {
		t.Fatal("packet REALITY source is not a bounded regular file", err)
	}
	raw, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	var source []string
	if json.Unmarshal(raw, &source) != nil || len(source) != 9 {
		t.Fatal("packet REALITY lost its original nine-string capture")
	}
	plan, err := mobilemultihop.NewImportedEntry(source[0], source[1], source[2], source[3], source[4], source[5], source[6])
	if err != nil {
		t.Fatal("original packet REALITY compiler rejected its source", err)
	}
	if plan.SourceSHA256() != source[7] || plan.Config() != source[8] || plan.Healthy() {
		t.Fatal("original packet REALITY source identity changed")
	}
	if err := plan.Close(); err != nil {
		t.Fatal("original compiler-only packet plan did not close", err)
	}
	return source
}

type desktopPacketRealityReceipt struct{ raw, tcp, udp, auth int64 }
type desktopPacketRealityFixture struct {
	ctx                             context.Context
	cancelFinal                     context.CancelFunc
	kind, fault                     string
	first, final                    adapter.Outbound
	finalOptions                    XR.Options
	owned                           context.Context
	manager                         *desktopImportedSOCKSXrayManager
	lower                           *desktopPacketRealityPhysical
	plan                            *mobilemultihop.Controller
	source, captured                []string
	config                          string
	meta                            mobilemultihop.Metadata
	selected                        []byte
	finalServer                     *desktopNodeLayerServer
	entryStats                      func() desktopPacketRealityReceipt
	entryCarrier, finalCarrier      *desktopExternalInstalledSSPeer
	entryNetwork                    string
	firstRaw                        map[string]any
	startErr                        error
	openvpn                         *OV.ClientEndpoint
	connected                       nativeopenvpn.RemoteReceipt
	connectedMTU                    uint32
	ingress                         *desktopImportedOpenVPNIngress
	public, dns, health, authorized atomic.Int64
	roots                           *x509.CertPool
	closeOnce                       sync.Once
	closeErr                        error
	audit                           func()
	retired                         bool
	retiredTCP                      int64
}

func (f *desktopPacketRealityFixture) close() error {
	f.closeOnce.Do(func() {
		if f.ingress != nil {
			f.ingress.retiring.Store(true)
		}
		if f.final != nil {
			f.closeErr = errors.Join(f.closeErr, f.final.(io.Closer).Close())
		}
		if f.first != nil {
			f.closeErr = errors.Join(f.closeErr, f.first.(io.Closer).Close())
		}
		if f.manager != nil {
			for tag, owner := range f.manager.owners {
				if tag != "entry-wg" && tag != f.lower.Tag() {
					if closer, ok := owner.(io.Closer); ok {
						f.closeErr = errors.Join(f.closeErr, closer.Close())
					}
				}
			}
		}
		if f.lower != nil {
			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
			defer cancel()
			f.closeErr = errors.Join(f.closeErr, f.lower.empty(ctx))
		}
		if f.cancelFinal != nil {
			f.cancelFinal()
		}
	})
	return f.closeErr
}

func (f *desktopPacketRealityFixture) connectedEntry(ctx context.Context) error {
	if f.startErr != nil {
		return f.startErr
	}
	if f.openvpn == nil {
		return nil
	}
	limit := time.NewTimer(3 * time.Second)
	defer limit.Stop()
	for {
		receipt, mtu, err := f.openvpn.RouterVPNConnectedCapacityContext(ctx)
		if err == nil {
			if !receipt.Matches(f.firstRaw) || receipt.Generation == 0 || receipt.ConnectedAt <= 0 || mtu != 1500 {
				return errors.New("OpenVPN REALITY lost its actual captured connected remote or MTU")
			}
			f.connected, f.connectedMTU = receipt, mtu
			return nil
		}
		if f.fault == "entry-auth" && f.entryStats().auth > 0 || f.fault == "entry-route" && f.lower.denied.Load() > 0 {
			return errors.New("original OpenVPN entry rejected its captured negative")
		}
		if strings.HasPrefix(f.fault, "entry-layer-") && f.entryCarrier != nil {
			s := f.entryCarrier.stats()
			if s.AuthTCP+s.AuthUDP > 0 && s.Streams+s.Packets == 0 {
				return errors.New("original OpenVPN layer rejected its captured negative")
			}
		}
		select {
		case <-ctx.Done():
			return ctx.Err()
		case <-limit.C:
			return errors.New("original OpenVPN connected receipt did not arrive")
		case <-time.After(5 * time.Millisecond):
		}
	}
}

func (f *desktopPacketRealityFixture) recheckConnected(t *testing.T) {
	t.Helper()
	if f.openvpn == nil || f.connected.Generation == 0 {
		return
	}
	receipt, mtu, err := f.openvpn.RouterVPNConnectedCapacityContext(f.ctx)
	if err != nil || receipt != f.connected || mtu != f.connectedMTU {
		t.Fatal("REALITY proof changed its original OpenVPN connected owner", err)
	}
}

func desktopPacketRealityCompile(t *testing.T, args []string) *mobilemultihop.Controller {
	t.Helper()
	plan, err := mobilemultihop.NewImportedEntry(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
	if err != nil {
		t.Fatal("captured native packet REALITY source did not compile", err)
	}
	t.Cleanup(func() {
		if err := plan.Close(); err != nil {
			t.Error("captured packet plan did not close", err)
		}
	})
	return plan
}

func desktopPacketRealityNew(t *testing.T, kind, firstLayer, lastLayer, fault string, selectedPeer *desktopCONNECTXrayDNSResolver, selectedMode ...string) *desktopPacketRealityFixture {
	t.Helper()
	mode := "reality-vision"
	if len(selectedMode) > 1 || len(selectedMode) == 1 && selectedMode[0] != "reality-pq-vision" {
		t.Fatal("packet reference changed exact Vision mode")
	}
	if len(selectedMode) == 1 {
		mode = selectedMode[0]
	}
	var original []string
	if mode == "reality-pq-vision" {
		original = desktopImportedPQXraySource(t, kind, firstLayer, lastLayer)
	} else {
		original = desktopPacketRealitySource(t, kind+"--reality-vision--"+firstLayer+"--"+lastLayer+".json")
	}
	args := append([]string(nil), original[:7]...)
	profile := desktopImportedSOCKSXrayObject(t, args[4])
	f := &desktopPacketRealityFixture{kind: kind, fault: fault}
	// Register first: independent peer counters are read only after all
	// original listeners, reference processes and native owners have joined.
	t.Cleanup(func() {
		if f.audit != nil {
			f.audit()
		}
	})
	// Inventory and the original non-loopback listener remain mandatory even
	// though each bounded provider owns only private loopback forwarding rules.
	_, physicalIP := desktopNodePeerInterface(t)
	token, tokenOK := profile["api_token"].(string)
	identity, identityOK := profile["node_proof_id"].(string)
	if !tokenOK || token == "" || !identityOK || len(identity) != 64 || profile["router_api"] != "http://10.77.0.1:8787" || profile["multihop_execution"] != "local" {
		t.Fatal("packet REALITY lost paired Local proof authority")
	}
	paired := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodGet || r.Host != "10.77.0.1:8787" || r.URL.Path != "/health" {
			http.Error(w, "foreign", http.StatusForbidden)
			return
		}
		f.health.Add(1)
		if r.Header.Get("Authorization") != "Bearer "+token {
			http.Error(w, "foreign", http.StatusForbidden)
			return
		}
		f.authorized.Add(1)
		node := identity
		if fault == "final-identity" {
			node = strings.Repeat("f", 64)
			if node == identity {
				node = strings.Repeat("e", 64)
			}
		}
		_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "node_id": node, "proof": "router-vpn-private-agent-v1"})
	}))
	t.Cleanup(paired.Close)
	certificate, ca := desktopExternalInstalledPeerCertificate(t, false)
	public := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodGet || r.Host != "1.1.1.1" || r.URL.Path != "/cdn-cgi/trace" {
			http.Error(w, "foreign", http.StatusForbidden)
			return
		}
		f.public.Add(1)
		address := "203.0.113.88"
		if fault == "wrong-entry-ip" {
			address = "203.0.113.89"
		}
		_, _ = fmt.Fprintln(w, "ip="+address)
	}))
	public.TLS = &tls.Config{Certificates: []tls.Certificate{certificate}, MinVersion: tls.VersionTLS12}
	public.StartTLS()
	t.Cleanup(public.Close)
	f.roots = x509.NewCertPool()
	if !f.roots.AppendCertsFromPEM([]byte(ca)) {
		t.Fatal("packet REALITY public proof trust missing")
	}
	home, err := net.ListenPacket("udp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	homeServer := &dns.Server{PacketConn: home, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
		reply := new(dns.Msg).SetReply(q)
		if len(q.Question) != 1 || q.Question[0].Name != "example.com." || q.Question[0].Qtype != dns.TypeA {
			reply.Rcode = dns.RcodeRefused
		} else {
			f.dns.Add(1)
			reply.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: "example.com.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 1}, A: net.IPv4(93, 184, 216, 34)}}
		}
		_ = w.WriteMsg(reply)
	})}
	started, joined := make(chan struct{}), make(chan error, 1)
	homeServer.NotifyStartedFunc = func() { close(started) }
	go func() { joined <- homeServer.ActivateAndServe() }()
	select {
	case <-started:
	case err := <-joined:
		t.Fatal(err)
	case <-time.After(time.Second):
		t.Fatal("packet REALITY Home DNS did not start")
	}
	t.Cleanup(func() {
		_ = homeServer.Shutdown()
		_ = home.Close()
		select {
		case <-joined:
		case <-time.After(time.Second):
			t.Error("packet REALITY Home DNS did not join")
		}
	})
	var routes []desktopNodeXrayDNSRoute
	if selectedPeer != nil {
		routes = selectedPeer.routes
	}
	var files string
	f.finalServer, files = startDesktopNodeXrayServerWithProof(t, mode, physicalIP, home.LocalAddr().String(), paired.Listener.Addr().String(), routes...)
	finalTarget := f.finalServer.tcp.Addr().String()
	finalPhysical := desktopPacketRealityCiphertextBridge(t, physicalIP, finalTarget)
	profile["endpoint"] = physicalIP.String()
	flow := "xtls-rprx-vision"
	if selectedPeer != nil && fault != "dot853" && fault != "doh443" && fault != "plain-vision-udp443" {
		flow = "xtls-rprx-vision-udp443"
	}
	var assets map[string]string
	if json.Unmarshal([]byte(files), &assets) != nil {
		t.Fatal("packet REALITY original assets absent")
	}
	xrayRaw, err := base64.StdEncoding.Strict().DecodeString(assets["xray.json"])
	if err != nil {
		t.Fatal(err)
	}
	xray := desktopImportedSOCKSXrayObject(t, string(xrayRaw))
	xrayOutbound := xray["outbounds"].([]any)[0].(map[string]any)
	xrayOutbound["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)["flow"] = flow
	if fault == "final-route" {
		profile["endpoint"] = "198.51.100.240"
		xrayOutbound["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["address"] = "198.51.100.240"
	}
	assets["xray.json"] = base64.StdEncoding.EncodeToString([]byte(desktopImportedSOCKSXrayJSON(t, xray)))
	files = desktopImportedSOCKSXrayJSON(t, assets)
	if fault == "final-reality-key" {
		files = desktopNodeXrayAssets(t, files, "xray-reality-key")
	}
	if fault == "final-pq-key" {
		files = desktopNodeXrayAssets(t, files, "xray-pq-key")
	}
	if fault == "final-user" {
		files = desktopNodeXrayAssets(t, files, "xray-user")
	}
	if fault == "final-token" {
		profile["api_token"] = token + "-foreign"
	}
	if fault == "dns-route" {
		profile["adguard_ipv4"] = "192.168.50.134"
	}
	if lastLayer != "off" {
		var layers map[string]string
		if json.Unmarshal([]byte(args[5]), &layers) != nil {
			t.Fatal("packet REALITY final layer source absent")
		}
		raw, err := base64.StdEncoding.Strict().DecodeString(layers["sing-box.json"])
		if err != nil {
			t.Fatal(err)
		}
		layer := desktopImportedSOCKSXrayObject(t, string(raw))
		layer["outbounds"].([]any)[0].(map[string]any)["server"] = physicalIP.String()
		layers["sing-box.json"] = base64.StdEncoding.EncodeToString([]byte(desktopImportedSOCKSXrayJSON(t, layer)))
		args[5] = desktopImportedSOCKSXrayJSON(t, layers)
	}
	transportKind := ""
	if selectedPeer != nil {
		transportKind = "h3"
		port := 443
		if fault == "dot853" {
			transportKind = "tls"
			port = 853
		}
		if fault == "doh443" {
			transportKind = "https"
		}
		profile["dns_mode"], profile["dns_protocol"], profile["dns_host"], profile["dns_port"] = "custom", transportKind, "198.51.100.53", port
		profile["dns_server_name"], profile["dns_path"] = desktopCONNECTXrayDNSName, desktopCONNECTXrayDNSPath
		switch fault {
		case "wrong-dns-sni":
			profile["dns_server_name"] = "foreign.routervpn.test"
		case "wrong-dns-route":
			profile["dns_host"] = "198.51.100.54"
		case "wrong-dns-port":
			profile["dns_port"] = 444
		case "wrong-dns-path":
			profile["dns_path"] = "/uncaptured"
		}
	}
	args[3], args[4] = files, desktopImportedSOCKSXrayJSON(t, profile)
	provisional := desktopPacketRealityCompile(t, args)
	provisionalTags := desktopImportedSOCKSGraph(desktopImportedSOCKSXrayObject(t, provisional.Config()))
	provisionalFinal := provisionalTags[mobilemultihop.LocalTag]
	if provisionalFinal == nil || provisionalFinal["type"] != "routervpn-xray" || provisionalFinal["mode"] != mode {
		t.Fatal("packet REALITY lost its native paired final")
	}
	newServer := func(routes []desktopNodeLayerRoute) *desktopNodeLayerServer {
		ctx, cancel := context.WithCancel(context.Background())
		t.Cleanup(cancel)
		return &desktopNodeLayerServer{ctx: ctx, cancel: cancel, connections: map[io.Closer]bool{}, routes: routes}
	}
	if lastLayer != "off" {
		outer := provisionalTags[mobilemultihop.NativeStartLayerTag]
		if outer == nil || outer["detour"] != "entry-wg" || provisionalFinal["detour"] != mobilemultihop.NativeStartLayerTag {
			t.Fatal("packet REALITY lost its separate final layer")
		}
		_, port, err := net.SplitHostPort(finalTarget)
