// These fixed fixture routes sit after the actual authenticated Xray inbound.
// They expose no general Internet route. Counters increment only when that
// inbound delivers a real decrypted stream or datagram to its retained listener.
type desktopNodeXrayPrivateCapture struct {
	router    string
	benchmark *desktopNodeChainBenchmark
}

func desktopNodeXrayPrivateTCP(t *testing.T, server *desktopNodeLayerServer, target string) net.Listener {
	t.Helper()
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	server.workers.Add(1)
	go func() {
		defer server.workers.Done()
		for {
			incoming, err := listener.Accept()
			if err != nil {
				return
			}
			if !server.enter(incoming) {
				_ = incoming.Close()
				return
			}
			server.plainTCP.Add(1)
			go func() {
				defer server.leave(incoming)
				outgoing, err := (&net.Dialer{Timeout: 2 * time.Second}).DialContext(server.ctx, "tcp4", target)
				if err != nil {
					return
				}
				if !server.enter(outgoing) {
					_ = outgoing.Close()
					return
				}
				defer server.leave(outgoing)
				_ = incoming.SetDeadline(time.Now().Add(3 * time.Second))
				_ = outgoing.SetDeadline(time.Now().Add(3 * time.Second))
				joined := make(chan struct{}, 2)
				go func() { _, _ = io.Copy(outgoing, incoming); joined <- struct{}{} }()
				go func() { _, _ = io.Copy(incoming, outgoing); joined <- struct{}{} }()
				<-joined
				_ = incoming.Close()
				_ = outgoing.Close()
				<-joined
			}()
		}
	}()
	return listener
}

func desktopNodeXrayPrivateUDP(t *testing.T, server *desktopNodeLayerServer, target string) net.PacketConn {
	t.Helper()
	listener, err := net.ListenPacket("udp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	server.workers.Add(1)
	go func() {
		defer server.workers.Done()
		body := make([]byte, 65535)
		for {
			n, from, err := listener.ReadFrom(body)
			if err != nil {
				return
			}
			outgoing, err := (&net.Dialer{Timeout: 2 * time.Second}).DialContext(server.ctx, "udp4", target)
			if err != nil {
				continue
			}
			if !server.enter(outgoing) {
				_ = outgoing.Close()
				return
			}
			server.plainUDP.Add(1)
			payload := append([]byte(nil), body[:n]...)
			go func(connection net.Conn, packet []byte, address net.Addr) {
				defer server.leave(connection)
				_ = connection.SetDeadline(time.Now().Add(2 * time.Second))
				if written, err := connection.Write(packet); err != nil || written != len(packet) {
					return
				}
				answer := make([]byte, 65535)
				if n, err := connection.Read(answer); err == nil {
					_, _ = listener.WriteTo(answer[:n], address)
				}
			}(outgoing, payload, from)
		}
	}()
	return listener
}

func desktopNodeXrayPrivateTargets(t *testing.T, capture *desktopNodeXrayPrivateCapture, physical netip.Addr) {
	t.Helper()
	if capture == nil {
		return
	}
	router, err := netip.ParseAddrPort(capture.router)
	if err != nil || !physical.IsPrivate() || router.Addr() != physical || router.Port() != desktopNodeRouterHealthPort {
		t.Fatal("REALITY fixture lost its original private Router listener")
	}
	if capture.benchmark != nil {
		address, ok := capture.benchmark.route("udp", "10.77.0.1:45998")
		endpoint, err := netip.ParseAddrPort(address)
		if !ok || err != nil || !endpoint.Addr().Is4() || !endpoint.Addr().IsLoopback() || endpoint.Port() == 0 {
			t.Fatal("REALITY fixture lost its original private benchmark listener")
		}
	}
}

// The real client and pinned reference Xray execute proof, selected DNS and
// private benchmark traffic. Kernel/TUN behavior remains explicitly modeled
// here; the separate installed-host phase supplies native acceptance.
func TestRouterVPNDesktopNodeREALITYPrivatePolicy(t *testing.T) {
	for _, mode := range []string{"reality-vision", "reality-pq-vision", "reality-xhttp"} {
		for _, layer := range []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			label := layer
			if label == "" {
				label = "off"
			}
			t.Run(mode+"/"+label, func(t *testing.T) {
				_, ip := desktopNodePeerInterface(t)
				nodeID := strings.Repeat("b", 64)
				peer := startDesktopNodeLayerReferenceConfigured(t, mode, layer, ip,
					desktopNodeLayerReferenceOptions{NodeProofID: nodeID, BenchmarkPort: 45998})
				f := newDesktopNodeLayerFixture(t, peer, "")
				if err := f.box.RouterVPNStrategyStart(); err != nil {
					t.Fatal(err)
				}
				outbound, found := f.box.Outbound().Outbound("proxy")
				if !found {
					t.Fatal("REALITY lost its original final outbound")
				}
				for _, action := range []string{"restore-node", "wrong-node", "restore-node"} {
					before := peer.observe(t, action)
					ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
					transport := &http.Transport{Proxy: nil, DisableKeepAlives: true,
						DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
							if network != "tcp" || address != desktopNodeRouterHealthTarget {
								return nil, errors.New("REALITY changed its original Router proof target")
							}
							return outbound.DialContext(ctx, network, M.ParseSocksaddr(address))
						}}
					client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("REALITY Router proof cannot redirect") }}
					request, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://"+desktopNodeRouterHealthTarget+"/health", nil)
					if err != nil {
						cancel()
						t.Fatal(err)
					}
					response, err := client.Do(request)
					if err != nil {
						cancel()
						transport.CloseIdleConnections()
						t.Fatal("REALITY private proof did not reach its original final peer", err)
					}
					body, readErr := io.ReadAll(io.LimitReader(response.Body, 1025))
					closeErr := response.Body.Close()
					transport.CloseIdleConnections()
					cancel()
					var actual struct {
						OK     bool   `json:"ok"`
						NodeID string `json:"node_id"`
						Proof  string `json:"proof"`
					}
					after := peer.observe(t, "stats")
					if readErr != nil || closeErr != nil || len(body) > 1024 || response.StatusCode != http.StatusOK || json.Unmarshal(body, &actual) != nil ||
						!actual.OK || actual.Proof != "router-vpn-private-agent-v1" || (actual.NodeID == nodeID) == (action == "wrong-node") ||
						after.RouterQueries != before.RouterQueries+1 || after.DirectQueries != 0 || after.ProtocolTCP <= before.ProtocolTCP ||
						after.RawUDP != 0 || after.ProtocolRawUDP != 0 || after.ProtocolRawTCP == 0 || after.ProtocolTLSHTTP != 0 {
						t.Fatal("REALITY substituted its final Router identity or authenticated TCP lower", action, readErr, closeErr, before, after)
					}
				}
				for _, action := range []string{"restore-dns", "fail-dns", "restore-dns"} {
					before := peer.observe(t, action)
					err := f.box.RouterVPNStrategyDNSProof()
					after := peer.observe(t, "stats")
					if (err == nil) == (action == "fail-dns") || after.DNSQueries != before.DNSQueries+1 || after.ProtocolUDP <= before.ProtocolUDP ||
						after.RawUDP != 0 || after.ProtocolRawUDP != 0 || after.ProtocolTLSHTTP != 0 {
						t.Fatal("REALITY substituted selected Home DNS or bypassed final Xray packet", action, err, before, after)
					}
				}
				target := M.ParseSocksaddr("10.77.0.1:45998")
				for _, action := range []string{"release-benchmark", "hold-benchmark", "release-benchmark"} {
					before := peer.observe(t, action)
					ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
					packet, err := outbound.ListenPacket(ctx, target)
					if err != nil {
						cancel()
						t.Fatal(err)
					}
					limit := 2 * time.Second
					if action == "hold-benchmark" {
						limit = 350 * time.Millisecond
					}
					if err := packet.SetDeadline(time.Now().Add(limit)); err != nil {
						packet.Close()
						cancel()
						t.Fatal(err)
					}
					body, answer := bytes.Repeat([]byte{0x61}, 1252), make([]byte, 1253)
					n, writeErr := packet.WriteTo(body, target)
					count, _, readErr := packet.ReadFrom(answer)
					closeErr := packet.Close()
					cancel()
					after := peer.observe(t, "stats")
					if writeErr != nil || n != len(body) || closeErr != nil || before.Benchmark == nil || after.Benchmark == nil ||
						after.Benchmark.Packets != before.Benchmark.Packets+1 || after.Benchmark.ReceivedBytes != before.Benchmark.ReceivedBytes+uint64(len(body)) ||
						after.ProtocolUDP <= before.ProtocolUDP || after.RawUDP != 0 || after.ProtocolRawUDP != 0 {
						t.Fatal("REALITY benchmark missed its original authenticated final Xray packet owner", action, writeErr, closeErr, before, after)
					}
					if action == "hold-benchmark" {
						if readErr == nil || after.Benchmark.HeldPackets != before.Benchmark.HeldPackets+1 || after.Benchmark.Replies != before.Benchmark.Replies {
							t.Fatal("held REALITY benchmark fabricated a reply", readErr, before, after)
						}
					} else if readErr != nil || !bytes.Equal(answer[:count], body) || after.Benchmark.Replies != before.Benchmark.Replies+1 || after.Benchmark.SentBytes != before.Benchmark.SentBytes+uint64(len(body)) {
						t.Fatal("REALITY benchmark lost actual original transfer bytes", readErr, before, after)
					}
				}
				if f.network.Current() {
					t.Fatal("modeled REALITY kernel/TUN boundary fabricated readiness")
				}
				f.source.Cancel()
				if f.exchange("tcp") == nil {
					t.Fatal("retired REALITY owner delivered replacement payload")
				}
				if err := f.close(); err != nil || !f.source.closed.Load() {
					t.Fatal("REALITY did not join its original socket source", err)
				}
			})
		}
	}
}
