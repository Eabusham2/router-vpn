//go:build cgo && routervpn_native_pq && routervpn_pq_traffic_test

package routervpnpq

import (
	"strings"
	"testing"
	"time"
)

func nodeMAXCredentialCases(t *testing.T, modes, outerFaults []string) {
	for _, mode := range modes {
		for _, layer := range []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			faults := []string{"kem-peer", "packet-peer", "middle-key"}
			if layer == "" {
				faults = append(faults, outerFaults...)
			}
			for _, fault := range faults {
				t.Run(mode+"/"+nodePQLayerName(layer)+"/"+fault, func(t *testing.T) {
					f := newNodeMAXFixture(t, mode, layer, fault)
					if fault == "packet-peer" {
						f.start(t)
						pqTrafficAgreedKeys(t, f.endpoint, f.server, f.reference, [32]byte{}, 0)
						if err := f.exchange("tcp", "192.0.2.99", 0); err == nil || f.reference.Packets() == 0 ||
							f.inner.echoes.Load() != 0 || f.inner.queries.Load() != 0 {
							t.Fatal("MAX accepted a wrong captured packet peer after actual KEM")
						}
					} else {
						done := make(chan error, 1)
						go func() { done <- f.box.RouterVPNStrategyStart() }()
						completed, witnessed := false, false
						for deadline := time.Now().Add(12 * time.Second); ; {
							select {
							case err := <-done:
								completed = true
								if err == nil {
									t.Fatal("MAX accepted the substituted authenticated layer credential")
								}
							default:
							}
							f.kernel.mu.Lock()
							attempted := len(f.kernel.seen) != 0
							f.kernel.mu.Unlock()
							switch fault {
							case "kem-peer":
								witnessed = attempted && f.server.rejected.Load() != 0
							case "middle-key":
								witnessed = attempted && f.middle.rejected.Load() != 0
							case "outer-password":
								witnessed = attempted && completed && f.outer.rejected.Load() != 0
							case "outer-mlkem-key":
								witnessed = attempted && completed && f.outer.raw.Load() != 0 && f.tlsReference != nil && strings.Contains(f.tlsReference.process.diagnostics(), "ML-KEM-768 handshake failed > chacha20poly1305: message authentication failed")
							case "outer-user":
								witnessed = attempted && completed && f.outer.raw.Load() != 0 && f.tlsReference != nil && nodeMAXTLSRejected(f.tlsReference.process.diagnostics(), "11111111-1111-4111-8111-111111111111")
							case "outer-name", "outer-trust", "outer-reality-key":
								// Startup must return its actual protected-transport
								// failure before cancellation. Packets alone cannot pass.
								witnessed = attempted && completed && f.outer.raw.Load() != 0 && f.outer.rejected.Load() == 0
							}
							if witnessed || completed {
								if !witnessed {
									t.Fatal("MAX negative missed its actual authenticated rejection", fault)
								}
								break
							}
							if time.Now().After(deadline) {
								f.network.Cancel()
								t.Fatal("MAX negative never reached its retained encrypted peer", fault)
							}
							time.Sleep(time.Millisecond)
						}
						if f.endpoint.owner.Ready() || f.endpoint.owner.TransportReady() || f.reference.Updates() != 0 ||
							f.reference.Packets() != 0 || f.inner.queries.Load() != 0 {
							t.Fatal("MAX credential failure admitted packet traffic or DNS")
						}
						// MAX captures one paired SS key for the mandatory middle
						// and its optional Start Layer. Off must reach the middle
						// through the outer transport; AES/XOR must reject the same
						// wrong key before the outer transport receives anything.
						if fault == "middle-key" && (layer == "" && f.outer.raw.Load() == 0 || layer != "" && f.outer.raw.Load() != 0) {
							t.Fatal("MAX wrong paired key crossed or omitted its captured authentication stage")
						}
						if fault == "kem-peer" && (f.outer.raw.Load() == 0 || f.middle.raw.Load() == 0) ||
							strings.HasPrefix(fault, "outer-") && f.server.received.Load() != 0 ||
							fault == "middle-key" && f.server.received.Load() != 0 {
							t.Fatal("MAX negative crossed or omitted its mandatory layer", fault)
						}
						f.network.Cancel()
						if !completed {
							select {
							case err := <-done:
								if err == nil {
									t.Fatal("MAX cancelled credential trial reported success")
								}
							case <-time.After(time.Second):
								t.Fatal("MAX cancelled credential trial did not join")
							}
						}
					}
					if err := f.close(); err != nil || !f.kernel.closed.Load() || f.endpoint.owner.Ready() || f.endpoint.owner.TransportReady() || f.kernel.bad.Load() != 0 {
						t.Fatal("MAX credential failure escaped its captured owner", err)
					}
				})
			}
		}
	}
}

func TestRouterVPNDesktopNodeCompleteMAXQUICCredentials(t *testing.T) {
	nodeMAXCredentialCases(t, []string{"max-quic-wg", "max-quic-awg"}, []string{"outer-password", "outer-trust", "outer-name"})
}

func TestRouterVPNDesktopNodeCompleteMAXTLSCredentials(t *testing.T) {
	nodeMAXCredentialCases(t, []string{"max-tls-wg", "max-tls-awg"}, []string{"outer-reality-key", "outer-mlkem-key", "outer-user"})
}
