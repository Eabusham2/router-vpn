// Both original private provider profiles come from the actual shared source
// producer. The request uses every original paired prefix key and position;
// no Local profile is copied into the independent Server owner.
func desktopOpenVPNExecutionCommandProjection(t *testing.T, prep *mobilemultihop.NodeChainExecutionPreparation) *mobilemultihop.NodeChainExecutionProjection {
	t.Helper()
	original, err := prep.OriginalOpenVPNSource()
	if err != nil {
		t.Fatal(err)
	}
	middle, err := original.OpenVPNMiddleCapture()
	if err != nil {
		t.Fatal(err)
	}
	name := fmt.Sprintf("%d-%s", len(original.ProofInventory()), middle.Remote.Network)
	raw, err := os.ReadFile(filepath.Join(os.Getenv("ROUTERVPN_OPENVPN_EXECUTION_NATIVE_FIXTURES"), name+".json"))
	var captured struct{ Local, Server string }
	if err != nil || json.Unmarshal(raw, &captured) != nil || captured.Local != prep.LocalSource() {
		t.Fatal("original independent OpenVPN child fixture changed", err)
	}
	server, err := mobilemultihop.NewNodeChainOpenVPNServerPolicy(captured.Server)
	if err != nil {
		t.Fatal(err)
	}
	descriptor := server.Descriptor()
	digest, err := descriptor.Digest()
	if err != nil {
		t.Fatal(err)
	}
	var local mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(prep.LocalSource()), &local) != nil {
		t.Fatal("original Local source absent")
	}
	request := multihoprelay.NodeChainRequest{Schema: 5, SessionID: strings.Repeat("1", 32), EntryNodeID: descriptor.EntryNodeID, SourceSHA256: descriptor.SourceSHA256, DescriptorSHA256: digest, DNSPolicySHA256: descriptor.DNSPolicySHA256, Epoch: strings.Repeat("2", 64), AcquireExpiresAt: time.Now().Add(time.Minute).Unix(), Port: 32000}
	for i, launch := range local.Nodes[:len(local.Nodes)-2] {
		node, err := mobilemultihop.ParseNodeLaunchInput(launch)
		if err != nil {
			t.Fatal(err)
		}
		key, err := node.PacketClientPublicKey()
		if err != nil {
			t.Fatal(err)
		}
		request.LocalPacketPublicKeys = append(request.LocalPacketPublicKeys, key)
		request.LocalPacketPositions = append(request.LocalPacketPositions, i)
	}
	discovery, err := prep.Discovery()
	if err != nil {
		t.Fatal(err)
	}
	var graph struct {
		Endpoints []struct {
			Tag     string   `json:"tag"`
			Address []string `json:"address"`
		} `json:"endpoints"`
	}
	if json.Unmarshal([]byte(prep.Config()), &graph) != nil {
		t.Fatal("original entry graph absent")
	}
	for _, endpoint := range graph.Endpoints {
		if endpoint.Tag != discovery.Entry.Tag {
			continue
		}
		for _, address := range endpoint.Address {
			prefix, err := netip.ParsePrefix(address)
			if err != nil {
				t.Fatal(err)
			}
			if prefix.Addr().Is4() {
				if request.Peer != "" {
					t.Fatal("ambiguous original entry address")
				}
				request.Peer = prefix.Addr().String()
			}
		}
	}
	if request.Peer == "" {
		t.Fatal("original entry IPv4 absent")
	}
	for i := range descriptor.Members {
		request.Users = append(request.Users, multihoprelay.NodeChainUser{Position: i + 1, Username: fmt.Sprintf("%048x", 3+i*2), Password: fmt.Sprintf("%048x", 4+i*2)})
	}
	if err := request.Validate(descriptor); err != nil {
		t.Fatal("original OpenVPN request", err)
	}
	source := mobilemultihop.NodeChainExecutionSource{Schema: 5, Execution: prep.Execution(), LocalSource: prep.LocalSource(), Server: descriptor, Request: request, FirstPort: 32000, LastPort: 32000}
	policy, err := mobilemultihop.NewNodeChainOpenVPNExecutionPolicy(prep, desktopExecutionJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	projection, err := prep.BindExecution(policy)
	if err != nil {
		t.Fatal(err)
	}
	return projection
}

// These existing child-runtime doubles test publication, original callbacks,
// Last dispatch and joined cleanup. They explicitly do not prove a native
// provider connection, encrypted path, TUN reader or installed parent.
type desktopOpenVPNExecutionChildProof struct{ *desktopExecutionProofFixture }

func (p *desktopOpenVPNExecutionChildProof) CaptureOpenVPNDesktopLastContext(ctx context.Context) (mobilemultihop.NodeChainExecutionLast, error) {
	return p.CaptureLastContext(ctx)
}
func newDesktopOpenVPNExecutionChildFixture(t *testing.T, prep *mobilemultihop.NodeChainExecutionPreparation, projection *mobilemultihop.NodeChainExecutionProjection) *desktopExecutionRuntimeFixture {
	t.Helper()
	f := newDesktopExecutionRuntimeFixtureFromProjection(t, prep, projection)
	construction, err := routerVPNNewDesktopOpenVPNExecutionConstruction(desktopSOCKSCommandContext(t.Context()), prep)
	if err != nil {
		t.Fatal(err)
	}
	current := f.owner.host
	f.owner.host = func(ctx context.Context) error {
		if err := construction.current(ctx); err != nil {
			return err
		}
		return current(ctx)
	}
	f.record.MTU, f.engine.readback.MTU = 1280, 1280
	middle := len(f.proof.progress.Prefixes) - 2
	f.proof.progress.Prefixes[middle].Kind = "public-path"
	f.proof.progress.Prefixes[middle].Label = "Cumulative path through custom middle to public HTTPS edge"
	f.owner.proof = func(p *mobilemultihop.NodeChainExecutionProjection, e routerVPNDesktopExecutionEngine) (routerVPNDesktopExecutionProof, error) {
		if p != projection || e != f.engine {
			t.Fatal("OpenVPN child replaced original proof capture")
		}
		return &desktopOpenVPNExecutionChildProof{f.proof}, nil
	}
	return f
}

func TestRouterVPNDesktopOpenVPNExecutionChildPublication(t *testing.T) {
	for _, setting := range []string{"server", "auto"} {
		t.Run(setting, func(t *testing.T) {
			prep := desktopOpenVPNExecutionCommandPreparation(t, "4-tcp", "linux", setting)
			f := newDesktopOpenVPNExecutionChildFixture(t, prep, desktopOpenVPNExecutionCommandProjection(t, prep))
			ctx, cancel := context.WithCancel(context.Background())
			if err := f.owner.run(ctx); err != nil {
				cancel()
				t.Fatal(err)
			}
			cancel()
			if f.owner.current(context.Background()) != nil || f.proof.lifetime.Err() != nil {
				t.Fatal("OpenVPN startup context replaced retained child lifetime")
			}
			raw, err := f.owner.files.read("node-chain-execution-adoption.json", mobilemultihop.DesktopNodeChainOpenVPNExecutionAdoptionRecordLimit)
			if err != nil {
				t.Fatal(err)
			}
			parent, err := mobilemultihop.ParseDesktopNodeChainOpenVPNExecutionPreparation(prep.Source())
			if err != nil {
				t.Fatal(err)
			}
			projection, identity, err := mobilemultihop.ParseDesktopNodeChainOpenVPNExecutionAdoptionRecord(raw, parent, f.owner.transfer)
			if err != nil || identity != f.engine.identity {
				t.Fatal("OpenVPN child did not publish original typed adoption", err)
			}
			if err := f.owner.heartbeat(context.Background(), f.record); err != nil {
				t.Fatal(err)
			}
			raw, err = f.owner.files.read("node-chain-execution-ready.json", mobilemultihop.DesktopNodeChainOpenVPNExecutionReadyRecordLimit)
			if err != nil {
				t.Fatal(err)
			}
			ready, err := mobilemultihop.ParseDesktopNodeChainOpenVPNExecutionAdoptedReadyRecord(raw, projection, identity, f.owner.transfer)
			if err != nil || ready.SelectionEpoch != 7 || ready.Reader != 1 {
				t.Fatal("OpenVPN child lost selected proof and reader heartbeat", err)
			}
			if _, err := mobilemultihop.ParseDesktopNodeChainExecutionReadyRecord(raw, projection, f.owner.transfer); err == nil {
				t.Fatal("OpenVPN heartbeat acquired generic authority")
			}
			if err := f.owner.close(context.Background()); err != nil {
				t.Fatal(err)
			}
			if strings.Join(f.events, ",") != "discover,adopt,prove,join,retire" {
				t.Fatal("OpenVPN child retired before joining its proof", f.events)
			}
			for _, name := range []string{"node-chain-execution-adoption.json", "node-chain-execution-ready.json", "node-chain-execution-last.json"} {
				if _, err := f.owner.files.root.Lstat(name); !errors.Is(err, os.ErrNotExist) {
					t.Fatal("retired OpenVPN child retained public output", name, err)
				}
			}
		})
	}
}

func TestRouterVPNDesktopOpenVPNExecutionChildSavedChoice(t *testing.T) {
	for _, winner := range []string{"local", "server"} {
		t.Run(winner, func(t *testing.T) {
			originalPrep := desktopOpenVPNExecutionCommandPreparation(t, "4-tcp", "linux", "auto")
			originalProjection := desktopOpenVPNExecutionCommandProjection(t, originalPrep)
			target := mobilemultihop.Targets[1]
			last := desktopExecutionSavedChoice(t, originalPrep, originalProjection, winner, target)
			physical, _ := originalPrep.OpenVPNDesktopPhysicalPolicy()
			original, _ := physical.OriginalDesktopOpenVPNPolicy()
			prep, err := mobilemultihop.NewDesktopNodeChainOpenVPNExecutionLastPreparation(original, "auto", last.JSON())
			if err != nil {
				t.Fatal(err)
			}
			projection := desktopOpenVPNExecutionCommandProjection(t, prep)
			f := newDesktopOpenVPNExecutionChildFixture(t, prep, projection)
			f.proof.last = last
			f.proof.progress.Execution = winner
			f.proof.progress.Comparison.Target = target
			choice := *f.proof.progress.Comparison.Winner
			choice.Execution = routechoice.Execution(winner)
			f.proof.progress.Comparison.Winner = &choice
			f.proof.progress.Comparison.Final.Candidate = choice
			f.proof.progress.Comparison.Measurements = nil
			f.owner.proof = func(*mobilemultihop.NodeChainExecutionProjection, routerVPNDesktopExecutionEngine) (routerVPNDesktopExecutionProof, error) {
				return nil, errors.New("OpenVPN restoration reran Compare")
			}
			f.owner.lastProof = func(ctx context.Context, captured mobilemultihop.NodeChainExecutionLast, engine routerVPNDesktopExecutionEngine) (*mobilemultihop.NodeChainExecutionProjection, routerVPNDesktopExecutionProof, error) {
				if captured.JSON() != last.JSON() || engine != f.engine || ctx.Err() != nil {
					t.Fatal("OpenVPN restore substituted saved choice")
				}
				f.events = append(f.events, "restore")
				return projection, &desktopOpenVPNExecutionChildProof{f.proof}, nil
			}
			if err := f.owner.run(context.Background()); err != nil {
				t.Fatal(err)
			}
			if strings.Join(f.events, ",") != "discover,restore,prove" {
				t.Fatal("OpenVPN restore reselected port or reran Compare", f.events)
			}
			raw, err := f.owner.files.read("node-chain-execution-last.json", 16<<10)
			if err != nil || string(raw) != last.JSON() {
				t.Fatal("OpenVPN restore changed winner or target", err)
			}
			if err := f.owner.heartbeat(context.Background(), f.record); err != nil {
				t.Fatal(err)
			}
		})
	}
}

func TestRouterVPNDesktopOpenVPNExecutionChildRejectsForeignOwner(t *testing.T) {
	for _, fault := range []string{"host", "preparation", "physical", "reader", "mtu", "selected-proof", "proof-kind"} {
		t.Run(fault, func(t *testing.T) {
			prep := desktopOpenVPNExecutionCommandPreparation(t, "4-tcp", "linux", "auto")
			f := newDesktopOpenVPNExecutionChildFixture(t, prep, desktopOpenVPNExecutionCommandProjection(t, prep))
			if fault == "proof-kind" {
				f.owner.proof = func(*mobilemultihop.NodeChainExecutionProjection, routerVPNDesktopExecutionEngine) (routerVPNDesktopExecutionProof, error) {
					return f.proof, nil
				}
				if f.owner.run(context.Background()) == nil {
					t.Fatal("OpenVPN child accepted ordinary Last publisher")
				}
				return
			}
			if err := f.owner.run(context.Background()); err != nil {
				t.Fatal(err)
			}
			switch fault {
			case "host":
				f.valid.Store(false)
			case "preparation":
				f.owner.prep, _ = mobilemultihop.ParseDesktopNodeChainOpenVPNExecutionPreparation(prep.Source())
			case "physical":
				other, _ := mobilemultihop.ParseDesktopNodeChainOpenVPNExecutionPreparation(prep.Source())
				f.owner.physical, _ = other.OpenVPNDesktopPhysicalPolicy()
			case "reader":
				f.record.Reader++
			case "mtu":
				f.record.MTU++
			case "selected-proof":
				f.proof.progress.PublicProven = false
			}
			if f.owner.heartbeat(context.Background(), f.record) == nil {
				t.Fatal("OpenVPN execution published a substituted owner or proof")
			}
		})
	}
}

func TestRouterVPNDesktopOpenVPNExecutionChildRetainsFailedCleanup(t *testing.T) {
	for _, fault := range []string{"remote-join", "gate-retire"} {
		t.Run(fault, func(t *testing.T) {
			prep := desktopOpenVPNExecutionCommandPreparation(t, "4-tcp", "linux", "auto")
			f := newDesktopOpenVPNExecutionChildFixture(t, prep, desktopOpenVPNExecutionCommandProjection(t, prep))
			if err := f.owner.run(context.Background()); err != nil {
				t.Fatal(err)
			}
			if fault == "remote-join" {
				f.proof.closeErr = errors.New("pending original DELETE")
			} else {
				f.engine.retireErr = errors.New("pending original gate")
			}
			if f.owner.close(context.Background()) == nil || f.owner.closed.Load() {
				t.Fatal("unjoined owner allowed native teardown")
			}
			if fault == "remote-join" && strings.Contains(strings.Join(f.events, ","), "retire") {
				t.Fatal("native gate retired before remote join", f.events)
			}
			f.proof.closeErr = nil
			f.engine.retireErr = nil
			if err := f.owner.close(context.Background()); err != nil || !f.owner.closed.Load() {
				t.Fatal("original cleanup retry failed", err)
			}
		})
	}
}

func TestRouterVPNDesktopOpenVPNExecutionChildJoinsLateConstructor(t *testing.T) {
	prep := desktopOpenVPNExecutionCommandPreparation(t, "4-tcp", "linux", "auto")
	f := newDesktopOpenVPNExecutionChildFixture(t, prep, desktopOpenVPNExecutionCommandProjection(t, prep))
	original := f.owner.factory
	entered, release := make(chan struct{}), make(chan struct{})
	f.owner.factory = func(ctx context.Context, p *mobilemultihop.NodeChainExecutionPreparation, s string, current func(context.Context) error) (routerVPNDesktopExecutionEngine, error) {
		close(entered)
		<-release
		engine, _ := original(context.Background(), p, s, current)
		return engine, errors.New("late native constructor")
	}
	done := make(chan error, 1)
	go func() { done <- f.owner.run(context.Background()) }()
	<-entered
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	if f.owner.close(ctx) == nil || f.owner.closed.Load() {
		t.Fatal("canceled cleanup abandoned entered native factory")
	}
	close(release)
	if err := <-done; err == nil {
		t.Fatal("late constructor succeeded")
	}
	if f.owner.state.Load().engine.Load() == nil {
		t.Fatal("partial native owner discarded")
	}
	if _, err := f.owner.files.root.Lstat("node-chain-execution-adoption.json"); !errors.Is(err, os.ErrNotExist) {
		t.Fatal("late canceled constructor published adoption", err)
	}
	if err := f.owner.close(context.Background()); err != nil || strings.Join(f.events, ",") != "retire" {
		t.Fatal("original late engine was not retired", err, f.events)
	}
}

// This longest-prefix component deliberately calls the same complete source
// observer as the shipping child at every native callback. Its existing45s
// admission caller remains bounded; the provider and TUN are still doubles.
func TestRouterVPNDesktopOpenVPNExecutionChildLongestOriginalObserver(t *testing.T) {
	for _, name := range []string{"8-tcp", "8-udp"} {
		for _, execution := range []string{"server", "auto"} {
			t.Run(name+"/"+execution, func(t *testing.T) {
				prep := desktopOpenVPNExecutionCommandPreparation(t, name, "linux", execution)
				f := newDesktopOpenVPNExecutionChildFixture(t, prep, desktopOpenVPNExecutionCommandProjection(t, prep))
				ctx, cancel := context.WithTimeout(t.Context(), routerVPNNodeAdmissionLimit)
				defer cancel()
				if err := f.owner.run(ctx); err != nil {
					t.Fatal("longest original observer lost admission", err)
				}
				if err := f.owner.heartbeat(ctx, f.record); err != nil {
					t.Fatal("longest original observer lost selected proof", err)
				}
				if err := f.owner.close(ctx); err != nil {
					t.Fatal("longest original observer failed joined cleanup", err)
				}
			})
		}
	}
}
