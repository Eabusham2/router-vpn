package box

import (
	"errors"
	"runtime"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

// The ordered constructor seals every prefix, while the original native
// physical service owns the one permitted lower and its entire lifetime.
// This factory grants no parent admission and does not report Connected.
func routerVPNDesktopNodeChainPhysicalTarget(policy *mobilemultihop.DesktopNodeChainPolicy, target string) bool {
	if policy == nil || policy.Validate() != nil {
		return false
	}
	meta := policy.Metadata()
	if meta.TargetOS != target || len(meta.Prefixes) < 2 || len(meta.Prefixes) > mobilemultihop.NodeChainMaximumNodes {
		return false
	}
	for position, prefix := range meta.Prefixes {
		modeSupported := mobilemultihop.NodeChainPrefixMode(prefix.Mode)
		if position == len(meta.Prefixes)-1 {
			modeSupported = prefix.Mode == "shadowsocks" ||
				((target == "linux" || target == "windows") && prefix.Mode == "hysteria2" &&
					(prefix.StartLayer == "" || prefix.StartLayer == "off"))
		}
		if prefix.Position != position || !modeSupported ||
			!mobilemultihop.DesktopNodePhysicalGraphSupported(prefix.Mode, prefix.StartLayer) {
			return false
		}
	}
	return true
}

func (s *Box) RouterVPNDesktopNodeChainPreparePhysicalOwned(policy *mobilemultihop.DesktopNodeChainPolicy) (*RouterVPNDesktopNodePreparation, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered Windows physical preparation lost its complete captured chain")
	}
	_, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	owner := &RouterVPNDesktopNodePreparation{network: network, policy: policy}
	return owner, network.PrepareNodeChainPhysicalPolicy(policy)
}

func (s *Box) RouterVPNDesktopNodeChainActivatePhysical(policy *mobilemultihop.DesktopNodeChainPolicy) (*RouterVPNDesktopNodePhysical, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered Windows physical activation lost its complete captured chain")
	}
	return s.routerVPNDesktopNodeActivatePhysical(policy)
}

// Execution preparation has a distinct closed application graph and config
// identity. Its original ordered policy supplies the supported physical root,
// but cannot substitute for this exact preparation-time capability.
func routerVPNDesktopNodeChainExecutionPhysicalTarget(policy *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy, target string) bool {
	if policy == nil || policy.Validate() != nil {
		return false
	}
	original, err := policy.OriginalDesktopPolicy()
	if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(original, target) {
		return false
	}
	_, meta, _, err := policy.PhysicalReadValidated()
	return err == nil && meta.Kind == "node-chain-execution" && meta.TargetOS == target
}

func (s *Box) RouterVPNDesktopNodeChainExecutionPreparePhysicalOwned(policy *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy) (*RouterVPNDesktopNodePreparation, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainExecutionPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered Windows execution lost its original physical preparation")
	}
	_, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	owner := &RouterVPNDesktopNodePreparation{network: network, policy: policy}
	return owner, network.PrepareNodeChainExecutionPhysicalPolicy(policy)
}

func (s *Box) RouterVPNDesktopNodeChainExecutionActivatePhysical(policy *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy) (*RouterVPNDesktopNodePhysical, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainExecutionPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered Windows execution lost its original physical activation")
	}
	return s.routerVPNDesktopNodeActivatePhysical(policy)
}
