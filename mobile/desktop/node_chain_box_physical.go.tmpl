package box

import (
	"errors"
	"runtime"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

// The ordered constructor seals every prefix, while the original native
// physical service owns the one permitted lower and its entire lifetime.
// This factory grants no parent admission and does not report Connected.
func routerVPNDesktopNodeChainPhysicalTarget(policy *mobilemultihop.DesktopNodeChainPolicy, target string) bool {
	if policy == nil {
		return false
	}
	_, meta, physical, err := policy.ReadValidated()
	if err != nil || meta.TargetOS != target || len(meta.Prefixes) < 2 {
		return false
	}
	original, chain := policy.OriginalChain(), policy.NodeChain()
	if original == nil || chain == nil {
		return false
	}
	pairedProxyEntryCount := chain.PairedProxyEntryLocalNodeCount()
	if original.PairedProxyEntryLocalNodeCount() != pairedProxyEntryCount || pairedProxyEntryCount != 0 && pairedProxyEntryCount != len(meta.Prefixes) {
		return false
	}
	pairedHysteriaCount := chain.PairedHysteriaLocalNodeCount()
	if original.PairedHysteriaLocalNodeCount() != pairedHysteriaCount || pairedHysteriaCount != 0 && pairedHysteriaCount != len(meta.Prefixes) {
		return false
	}
	externalFinal := chain.HasExternalFinal()
	if original.HasExternalFinal() != externalFinal || (meta.ExternalFinal != nil) != externalFinal ||
		len(meta.Prefixes) > mobilemultihop.NodeChainMaximumNodes &&
			(original.ExtendedLocalNodeCount() != len(meta.Prefixes) || chain.ExtendedLocalNodeCount() != len(meta.Prefixes) || original.ExtendedMixedLocalPacketCount() != chain.ExtendedMixedLocalPacketCount()) {
		return false
	}
	middle, err := chain.OpenVPNMiddleCapture()
	if err != nil {
		return false
	}
	publicCaptures, _, err := chain.PublicMeasurementCaptures()
	if err != nil {
		return false
	}
	captured := chain.ProofInventory()
	if len(captured) != len(meta.Prefixes) {
		return false
	}
	if pairedHysteriaCount != 0 || pairedProxyEntryCount != 0 {
		originalProofs := original.ProofInventory()
		if len(originalProofs) != len(captured) || externalFinal || middle.Tag != "" || len(publicCaptures) != 0 {
			return false
		}
		for position, proof := range captured {
			if originalProofs[position] != proof || meta.Prefixes[position] != proof {
				return false
			}
		}
	}
	last := len(meta.Prefixes) - 1
	if externalFinal {
		exit := meta.ExternalFinal
		dnsTag := chain.FinalTag()
		if physical.SelectedDNS.Mode == "home" {
			dnsTag = captured[0].Tag
		}
		if physical.SelectedDNS.Physical || physical.SelectedDNS.Detour != dnsTag || meta.NodeID != "" || meta.ProfileID != exit.ProfileID || exit.ProfileID != captured[last].ProfileID ||
			exit.SourceSHA256 != captured[last].SourceSHA256 || exit.ExpectedPublicIP == "" || chain.FinalTag() != captured[last].Tag ||
			meta.FinalTag != chain.FinalTag() || len(publicCaptures) != last || middle.Tag != "" {
			return false
		}
	}
	public := make(map[int]mobilemultihop.NodeChainPublicMeasurementCapture, len(publicCaptures))
	for _, capture := range publicCaptures {
		if capture.Position <= 0 || capture.Position > last || capture.Position == last && !externalFinal ||
			public[capture.Position].Tag != "" || capture.Tag == "" || capture.SourceSHA256 == "" {
			return false
		}
		public[capture.Position] = capture
	}
	for position, prefix := range meta.Prefixes {
		if observation, imported := public[position]; imported {
			openVPN := middle.Tag != "" && middle.Tag == observation.Tag && prefix.Mode == "openvpn" &&
				position == len(meta.Prefixes)-2 && len(public) == 1 && prefix.SourceSHA256 == middle.SourceSHA256
			importedSS := middle.Tag == "" && len(meta.Prefixes) >= 3 && prefix.Mode == "shadowsocks"
			if (!openVPN && !importedSS) || meta.Prefixes[len(meta.Prefixes)-1].Mode != "shadowsocks" ||
				prefix != captured[position] || prefix.Tag != observation.Tag || prefix.SourceSHA256 != observation.SourceSHA256 || prefix.Position != position ||
				prefix.StartLayer != "off" || prefix.Kind != "public-path" || prefix.NodeKind != "external" || prefix.NodeID != "" {
				return false
			}
			continue
		}
		modeSupported := mobilemultihop.NodeChainPrefixMode(prefix.Mode)
		if pairedHysteriaCount != 0 || pairedProxyEntryCount != 0 {
			// Both complete source owners and every original proof were read above.
			modeSupported = modeSupported || prefix.Mode == "shadowsocks" || prefix.Mode == "hysteria2"
		}
		if position == len(meta.Prefixes)-1 {
			modeSupported = prefix.Mode == "shadowsocks" ||
				((target == "linux" || target == "windows" || target == "darwin") && prefix.Mode == "hysteria2")
		}
		if prefix.Position != position || !modeSupported ||
			!mobilemultihop.DesktopNodePhysicalGraphSupported(prefix.Mode, prefix.StartLayer) {
			return false
		}
	}
	return true
}

func (s *Box) RouterVPNDesktopNodeChainPreparePhysicalOwned(policy *mobilemultihop.DesktopNodeChainPolicy) (*RouterVPNDesktopNodePreparation, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered Windows physical preparation lost its complete captured chain")
	}
	_, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	owner := &RouterVPNDesktopNodePreparation{network: network, policy: policy}
	return owner, network.PrepareNodeChainPhysicalPolicy(policy)
}

func (s *Box) RouterVPNDesktopNodeChainActivatePhysical(policy *mobilemultihop.DesktopNodeChainPolicy) (*RouterVPNDesktopNodePhysical, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered Windows physical activation lost its complete captured chain")
	}
	return s.routerVPNDesktopNodeActivatePhysical(policy)
}

// Execution preparation has a distinct closed application graph and config
// identity. Its original ordered policy supplies the supported physical root,
// but cannot substitute for this exact preparation-time capability.
func routerVPNDesktopNodeChainExecutionPhysicalTarget(policy *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy, target string) bool {
	if policy == nil || policy.Validate() != nil {
		return false
	}
	original, err := policy.OriginalDesktopPolicy()
	if err != nil || !routerVPNDesktopNodeChainPhysicalTarget(original, target) {
		return false
	}
	_, meta, _, err := policy.PhysicalReadValidated()
	return err == nil && meta.Kind == "node-chain-execution" && meta.TargetOS == target
}

func (s *Box) RouterVPNDesktopNodeChainExecutionPreparePhysicalOwned(policy *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy) (*RouterVPNDesktopNodePreparation, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainExecutionPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered Windows execution lost its original physical preparation")
	}
	_, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	owner := &RouterVPNDesktopNodePreparation{network: network, policy: policy}
	return owner, network.PrepareNodeChainExecutionPhysicalPolicy(policy)
}

func (s *Box) RouterVPNDesktopNodeChainExecutionActivatePhysical(policy *mobilemultihop.DesktopNodeChainExecutionPhysicalPolicy) (*RouterVPNDesktopNodePhysical, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainExecutionPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered Windows execution lost its original physical activation")
	}
	return s.routerVPNDesktopNodeActivatePhysical(policy)
}
