type desktopExecutionLatencyComponent struct {
	owner  *routerVPNNodeChainExecutionRuntime
	native *mobilemultihop.RouterVPNDesktopLatencyTestFixture
	record routerVPNNodeMTURecord
}

// The concrete shared runtime, HTTP/TLS/Manager and actual 50-sample facade
// execute. Transport/worker/TUN are explicitly doubled component boundaries;
// this is not encrypted routing, installed-host or physical-device proof.
func newDesktopExecutionLatencyComponent(t *testing.T, execution string, localWinner bool) *desktopExecutionLatencyComponent {
	t.Helper()
	prep, projection := desktopExecutionCommandSource(t, "linux", execution)
	existing := newDesktopExecutionRuntimeFixtureFromProjection(t, prep, projection)
	return newDesktopSelectedComponent(t, existing, prep, projection, localWinner, false)
}

func newDesktopSelectedComponent(t *testing.T, existing *desktopExecutionRuntimeFixture, prep *mobilemultihop.NodeChainExecutionPreparation, projection *mobilemultihop.NodeChainExecutionProjection, localWinner, candidate bool) *desktopExecutionLatencyComponent {
	t.Helper()
	var native *mobilemultihop.RouterVPNDesktopLatencyTestFixture
	if candidate {
		native = mobilemultihop.NewRouterVPNDesktopCandidateTestFixture(t, prep, projection, existing.record.Session, localWinner)
	} else {
		native = mobilemultihop.NewRouterVPNDesktopLatencyTestFixture(t, prep, projection, existing.record.Session, localWinner)
	}
	existing.owner.factory = func(ctx context.Context, p *mobilemultihop.NodeChainExecutionPreparation, session string, current func(context.Context) error) (routerVPNDesktopExecutionEngine, error) {
		if p != prep || session != existing.record.Session {
			t.Fatal("selected50 changed original construction")
		}
		native.Host = current
		return native, ctx.Err()
	}
	existing.owner.proof = func(p *mobilemultihop.NodeChainExecutionProjection, e routerVPNDesktopExecutionEngine) (routerVPNDesktopExecutionProof, error) {
		if p != projection || e != native {
			t.Fatal("selected50 changed original controller")
		}
		return native.Runtime, nil
	}
	if err := existing.owner.run(t.Context()); err != nil {
		t.Fatal("actual selected runtime", err)
	}
	if !candidate {
		native.StartHTTP50(t)
	}
	state := existing.owner.state.Load()
	base := &routerVPNNodeMTUBox{instance: existing.owner.instance, physical: new(box.RouterVPNDesktopNodePhysical)}
	raw := &routerVPNNodeMTU{record: existing.record, engine: base}
	mtu := &routerVPNDesktopExecutionMTU{owner: existing.owner, state: state, raw: raw, base: base}
	raw.execution = mtu
	mtu.readback.Store(&routerVPNDesktopExecutionMTUReadback{controller: state.controller.Load(), record: raw.record, native: native.Readback})
	existing.owner.mtu.Store(mtu)
	if err := existing.owner.heartbeat(t.Context(), existing.record); err != nil {
		t.Fatal("actual selected Ready", err)
	}
	if err := existing.owner.pollMeasurement(t.Context()); err != nil {
		t.Fatal("actual selected facade capture", err)
	}
	f := &desktopExecutionLatencyComponent{owner: existing.owner, native: native, record: existing.record}
	t.Cleanup(func() {
		ctx, done := context.WithTimeout(context.Background(), 3*time.Second)
		defer done()
		if err := f.owner.close(ctx); err != nil {
			t.Error("selected component join", err)
		}
	})
	return f
}

func (f *desktopExecutionLatencyComponent) request(t *testing.T, id string, generation uint64) routerVPNExecutionMeasurementRequest {
	t.Helper()
	m := f.owner.measurement.Load()
	if m == nil {
		t.Fatal("original selected measurement absent")
	}
	return routerVPNExecutionMeasurementRequest{Schema: 1, Operation: "selected-latency-50", Request: id, Generation: generation, Deadline: time.Now().Add(75 * time.Second).UnixMilli(), Path: f.record.Path, NodeID: f.native.Node.ProfileID, Position: f.native.Node.Position, Capture: m.capture.Capture, Selected: m.capture.Selected}
}

func (f *desktopExecutionLatencyComponent) write(t *testing.T, name string, value any) []byte {
	t.Helper()
	raw, err := json.Marshal(value)
	if err != nil {
		t.Fatal(err)
	}
	if err = os.WriteFile(filepath.Join(f.owner.files.root.Name(), name), raw, 0600); err != nil {
		t.Fatal(err)
	}
	return raw
}

func (f *desktopExecutionLatencyComponent) finish(t *testing.T, request routerVPNExecutionMeasurementRequest) routerVPNExecutionMeasurementResult {
	t.Helper()
	deadline := time.Now().Add(80 * time.Second)
	for {
		if err := f.owner.heartbeat(t.Context(), f.record); err != nil {
			t.Fatal("selected50 heartbeat", err)
		}
		if err := f.owner.pollMeasurement(t.Context()); err != nil {
			t.Fatal("selected50 mailbox", err)
		}
		if f.owner.measurement.Load() != nil && f.owner.measurement.Load().op.Load() == nil && f.owner.measurementLast == request.Request {
			break
		}
		if time.Now().After(deadline) {
			t.Fatal("selected50 operation did not join")
		}
		time.Sleep(10 * time.Millisecond)
	}
	name := routerVPNExecutionMeasurementResultFile
	if request.Schema == 2 || request.Schema == 3 {
		name = routerVPNExecutionThroughputResultFile
	}
	raw, err := f.owner.files.read(name, routerVPNExecutionMeasurementLimit)
	if err != nil {
		t.Fatal(err)
	}
	var result routerVPNExecutionMeasurementResult
	if !routerVPNMTUStrict(raw, &result) || !reflect.DeepEqual(result.routerVPNExecutionMeasurementRequest, request) || !result.Status.Complete || !result.Status.Drained {
		t.Fatalf("selected50 lost exact completion: %s", raw)
	}
	if f.owner.activity.Load() != nil || request.Schema == 1 && f.owner.measurement.Load().facade != nil {
		t.Fatal("selected50 published before native activity/facade joined")
	}
	return result
}

func desktopSelectedLatencyHTTP50(t *testing.T, execution, winner string, localWinner bool) {
	t.Helper()
	f := newDesktopExecutionLatencyComponent(t, execution, localWinner)
	m := f.owner.measurement.Load()
	selected, capture := m.capture.Selected, append([]byte(nil), m.captureRaw...)
	original := m.service
	selections := f.native.SelectionCount()
	if f.native.Runtime.Progress().Execution != winner {
		t.Fatal("actual Compare did not choose intended measured fixture")
	}
	for attempt := 1; attempt <= 2; attempt++ {
		request := f.request(t, fmt.Sprintf("%032x", attempt), uint64(attempt))
		f.write(t, routerVPNExecutionMeasurementRequestFile, request)
		result := f.finish(t, request)
		if result.Saved == nil || result.Status.Stage != "complete" || result.Status.Failure != "" || len(result.Status.Results) != 1 {
			t.Fatal("selected50 lacks joined saved receipt", result)
		}
		row := result.Status.Results[0]
		if !row.Ready || row.Benchmark == nil || row.Benchmark.Attempts != 50 || row.Benchmark.Failed != 0 || row.Benchmark.Distribution == nil || row.Benchmark.Distribution.Samples != 50 || row.Download != nil || row.Upload != nil {
			t.Fatal("selected50 became another metric", row)
		}
		if f.native.Samples.Load() != int32(attempt*50) {
			t.Fatal("selected50 sample count is not actual HTTP traffic", f.native.Samples.Load())
		}
		if m != f.owner.measurement.Load() || m.service != original || m.capture.Selected != selected || !bytes.Equal(capture, m.captureRaw) || f.native.SelectionCount() != selections {
			t.Fatal("Retest reconstructed Compare or replaced the original capture/measurement")
		}
	}

}
