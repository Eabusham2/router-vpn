	NV.RegisterOutbound(outs)
	HY.RegisterOutbound(outs)
	SS.RegisterOutbound(outs)
	SOCKS.RegisterOutbound(outs)
	WH.RegisterOutbound(outs)
	desktoppt.RegisterNodePhysicalOutbound(outs)
	desktoppt.RegisterExternalSOCKSOutbound(outs)
	OVL.RegisterOutbound(outs)
	endpoints := endpoint.NewRegistry()
	WG.RegisterEndpoint(endpoints)
	AWG.RegisterEndpoint(endpoints)
	OVPN.RegisterEndpoint(endpoints)
	transports := dns.NewTransportRegistry()
	DNST.RegisterUDP(transports)
	DNST.RegisterTCP(transports)
	OVPN.RegisterDNSTransport(transports)
	services := boxService.NewRegistry()
	routervpnperformance.RegisterService(services)
	boxService.Register[desktoppt.NodeCaptureOptions](services, mobilemultihop.DesktopNodeNetworkType, func(ctx context.Context, logger log.ContextLogger, tag string, options desktoppt.NodeCaptureOptions) (adapter.Service, error) {
		owner, e := desktoppt.NewNodeNetworkOwner(ctx, logger, tag, options)
