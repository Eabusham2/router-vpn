func (f *desktopImportedH3WindowsFixture) start(t *testing.T) {
	t.Helper()
	if e := f.box.RouterVPNStrategyStart(); e != nil {
		t.Fatal("protected imported H3 native startup", e)
	}
	if f.admitted != 1 || f.prepared.Validate() != nil || f.network.Current() {
		t.Fatal("protected imported H3 startup lost captured pre-activation owner")
	}
	// Equal bytes from a new compiler object cannot adopt this exact runtime.
	raw, e := f.policy.OriginalController().ImportedLaunchInput()
	if e != nil {
		t.Fatal(e)
	}
	foreign, e := mobilemultihop.ParseImportedLaunchInput(raw)
	if e != nil {
		t.Fatal(e)
	}
	defer foreign.Close()
	replayed, e := mobilemultihop.NewDesktopImportedPolicy(foreign, f.policy.Metadata().SessionID, "windows")
	if e != nil || replayed.Config() != f.policy.Config() {
		t.Fatal("equal-source H3 negative lost its capture", e)
	}
	if owner, e := f.box.RouterVPNDesktopImportedActivatePhysical(replayed); e == nil || owner != nil {
		t.Fatal("protected H3 adopted an equal replacement policy")
	}
	f.owner, e = f.box.RouterVPNDesktopImportedActivatePhysical(f.policy)
	if e != nil || f.owner == nil || !f.owner.Current() {
		t.Fatal("protected H3 lost original activation", e)
	}
}
