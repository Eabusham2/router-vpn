			f.network = owner.(*desktoppt.NodeNetworkOwner)
		}
		return owner, e
	})
	admission := func(ctx context.Context, captured desktoppt.NodePhysicalPrepared) error {
		if f.network == nil || f.network.Current() || f.network.SocketCurrent() || f.admitted != 0 {
			return errors.New("imported H3 physical admission was late or repeated")
		}
		target := mobiletor.DesktopWindowsProtectionTarget{Capture: captured.Capture, Policy: captured.Policy, BaselineSHA256: captured.BaselineSHA256}
		if e := mobiletor.DesktopWindowsNodeCompositionVerifyPrepared(ctx, target); e != nil {
			return e
		}
		f.prepared, f.admitted = target, 1
		return nil
	}
	if previous == nil {
		ctx, e = desktoppt.WithNodePhysicalAdmission(ctx, policy, admission)
	} else {
		ctx, e = desktoppt.WithNodePhysicalSuccessorAdmission(ctx, policy, *previous, admission)
	}
	if e != nil {
		t.Fatal(e)
	}
	ctx = Context(ctx, ins, outs, endpoints, transports, services, certificate.NewRegistry())
	options, e := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(policy.Config()))
