func desktopImportedH3PacketDNS(c net.Conn) error {
	if e := c.SetDeadline(time.Now().Add(5 * time.Second)); e != nil {
		return e
	}
	raw, e := new(mDNS.Msg).SetQuestion("bootstrap.routervpn.test.", mDNS.TypeA).Pack()
	if e != nil {
		return e
	}
	if _, e = c.Write(raw); e != nil {
		return e
	}
	body := make([]byte, 4096)
	n, e := c.Read(body)
	if e != nil {
		return e
	}
	answer := new(mDNS.Msg)
	if e = answer.Unpack(body[:n]); e != nil {
		return e
	}
	if len(answer.Answer) != 1 {
		return errors.New("owned SOCKS association lost bootstrap DNS")
	}
	return nil
}
