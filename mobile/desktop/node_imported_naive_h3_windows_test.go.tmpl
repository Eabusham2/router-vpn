func desktopImportedH3Exchange(ctx context.Context, dialer adapter.Outbound, network string) error {
	c, e := dialer.DialContext(ctx, network, M.ParseSocksaddr(desktopImportedH3Echo))
	if e != nil {
		return e
	}
	defer c.Close()
	if e = c.SetDeadline(time.Now().Add(5 * time.Second)); e != nil {
		return e
	}
	body := []byte("captured-imported-h3-" + network)
	if _, e = c.Write(body); e != nil {
		return e
	}
	answer := make([]byte, len(body))
	if _, e = io.ReadFull(c, answer); e != nil {
		return e
	}
	if !bytes.Equal(body, answer) {
		return errors.New("protected H3 original payload changed")
	}
	return nil
}
