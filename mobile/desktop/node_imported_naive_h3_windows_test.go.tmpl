func (f *desktopImportedH3WindowsFixture) proofLane(ctx context.Context, entry bool) error {
	port := mobilemultihop.DesktopImportedExitProofPort
	if entry {
		port = mobilemultihop.DesktopImportedEntryProofPort
	}
	dialer, e := SOCKS.NewOutbound(f.box.ctx, nil, log.NewNOPFactory().Logger(), "independent-proof-lane", option.SOCKSOutboundOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: uint16(port)}, Version: "5"})
	if e != nil {
		return e
	}
	address := "10.77.0.1:8787"
	if entry {
		address = "1.1.1.1:443"
	}
	stream, e := dialer.DialContext(ctx, "tcp", M.ParseSocksaddr(address))
	if e != nil {
		return e
	}
	defer stream.Close()
	stop := context.AfterFunc(ctx, func() { _ = stream.Close() })
	defer stop()
	if e = stream.SetDeadline(time.Now().Add(5 * time.Second)); e != nil {
		return e
	}
	path, authorization := "/health", "Bearer "+desktopImportedH3ObjectNoTest(f.source[4])["api_token"].(string)
	if entry {
		secure := tls.Client(stream, &tls.Config{ServerName: "1.1.1.1", MinVersion: tls.VersionTLS12})
		if e = secure.HandshakeContext(ctx); e != nil {
			return e
		}
		stream = secure
		path, authorization = "/cdn-cgi/trace?routervpn_proof="+strings.Repeat("a", 32), ""
	}
	request, e := http.NewRequestWithContext(ctx, http.MethodGet, "http://"+address+path, nil)
	if e != nil {
		return e
	}
	request.Host = strings.TrimSuffix(address, ":443")
	if authorization != "" {
		request.Header.Set("Authorization", authorization)
	}
	if e = request.Write(stream); e != nil {
		return e
	}
	reply, e := http.ReadResponse(bufio.NewReader(stream), request)
	if e != nil {
		return e
	}
	defer reply.Body.Close()
	body, e := io.ReadAll(io.LimitReader(reply.Body, 4097))
	if e != nil || reply.StatusCode != 200 || len(body) > 4096 {
		return errors.Join(e, errors.New("protected H3 captured proof failed"))
	}
	if entry {
		if string(body) != "ip="+desktopExternalIntegrationIP+"\n" {
			return errors.New("protected H3 entry public IP changed")
		}
	} else {
		var value struct {
			OK     bool   `json:"ok"`
			NodeID string `json:"node_id"`
			Proof  string `json:"proof"`
		}
		if json.Unmarshal(body, &value) != nil || !value.OK || value.NodeID != f.policy.Metadata().ExitNodeID || value.Proof != "router-vpn-private-agent-v1" {
			return errors.New("protected H3 paired final identity changed")
		}
	}
	return nil
}

func (f *desktopImportedH3WindowsFixture) snapshot(t *testing.T, peer *desktopImportedH3Reference) mobiletor.DesktopWindowsNodeCompositionReadback {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	view, e := mobiletor.DesktopWindowsNodeCompositionSnapshot(ctx)
	if e != nil || view.Closed || view.Target != f.prepared || view.Owner.Kind != "windows-isolated-token" || !view.Options.RetainBaselineForHandoff || !f.owner.Current() {
		t.Fatal("protected imported H3 lost actual BFE/socket owner readback", e)
	}
	capture, e := f.policy.OriginalController().ImportedDesktopCapture()
	if e != nil {
		t.Fatal(e)
	}
	associations := peer.observe(t).SOCKS
	for _, grant := range view.Grants {
		if grant.Capture != f.prepared.Capture || grant.Binding.Owner != view.Owner {
			t.Fatal("protected imported H3 grant changed its original captured owner")
		}
		static := false
		for _, root := range capture.PhysicalRoots {
			for _, destination := range root.Destinations {
				if grant.Network == destination.Network && grant.Remote.String() == net.JoinHostPort(destination.Host, strconv.Itoa(destination.Port)) {
					static = true
				}
			}
		}
		authenticated := false
		if f.policy.Metadata().SOCKSUDPAssociationRequired && grant.Network == "udp" {
			for _, association := range associations {
				if !association.Closed && association.Control != "" && association.Client != "" && association.Packets > 0 && grant.Local.String() == association.Client && grant.Remote.String() == association.Relay {
					authenticated = true
				}
			}
		}
		if !static && !authenticated {
			t.Fatal("protected imported H3 granted its final or DNS as a direct physical root", grant.Network, grant.Remote)
		}
	}
	if len(view.Grants) == 0 {
		t.Fatal("protected imported H3 accepted traffic with no actual native socket grants")
	}
	return view
}

// OpenVPN startup schedules authentication asynchronously. Observe its original
// endpoint before the one-shot proof; process/Box startup is not readiness.
type desktopImportedH3OpenVPN interface {
	RouterVPNConnectedCapacityContext(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error)
}

func desktopImportedH3AwaitOpenVPN(ctx context.Context, original desktopImportedH3OpenVPN, current func(context.Context) (desktopImportedH3OpenVPN, error), capture map[string]any) error {
	if ctx == nil || original == nil || current == nil {
		return errors.New("protected H3 OpenVPN readiness lost original owner or caller")
	}
	remotes, err := nativeopenvpn.Remotes(capture)
	minimum, ok := capture["mtu"].(float64)
	if err != nil || len(remotes) != 1 || !ok || minimum < 1280 || minimum > 65535 || minimum != float64(uint32(minimum)) {
		return errors.New("protected H3 OpenVPN readiness lost captured remote or capacity")
	}
	check := func() error {
		if err := ctx.Err(); err != nil {
			return err
		}
		actual, err := current(ctx)
		if err != nil || ctx.Err() != nil {
			return errors.Join(err, ctx.Err())
		}
		if actual != original {
			return errors.New("protected H3 OpenVPN endpoint owner changed before proof")
		}
		return nil
	}
	tick := time.NewTicker(10 * time.Millisecond)
	defer tick.Stop()
	for {
		if err := check(); err != nil {
			return err
		}
		receipt, capacity, err := original.RouterVPNConnectedCapacityContext(ctx)
		if currentErr := check(); currentErr != nil {
			return errors.Join(err, currentErr)
		}
		if err == nil {
			state := nativeopenvpn.PacketObservation{Remote: receipt, MTU: capacity}
			if state.Validate() != nil || receipt.Remote != remotes[0] || capacity < uint32(minimum) {
				return errors.New("protected H3 OpenVPN connected receipt changed original authority")
			}
			return nil
		}
		if !errors.Is(err, nativeopenvpn.ErrRemotePending) {
			return err
		}
		select {
		case <-ctx.Done():
			return ctx.Err()
		case <-tick.C:
		}
	}
}

func (f *desktopImportedH3WindowsFixture) awaitEntryReady(ctx context.Context) error {
	if f.policy.Metadata().EntryMode != "openvpn" {
		return ctx.Err()
	}
	tag := f.policy.Metadata().EntryTag
	current := func(call context.Context) (desktopImportedH3OpenVPN, error) {
		value, found, err := adapter.RouterVPNOutboundContext(call, f.box.Outbound(), tag)
		endpoint, typed := value.(desktopImportedH3OpenVPN)
		if err != nil || !found || !typed || f.owner == nil || !f.owner.Current() {
			return nil, errors.Join(err, errors.New("protected H3 lost original OpenVPN native owner"))
		}
		return endpoint, nil
	}
	original, err := current(ctx)
	if err != nil {
		return err
	}
	graph := desktopImportedH3ObjectNoTest(f.policy.Config())
	rows, _ := graph["endpoints"].([]any)
	for _, raw := range rows {
		row, ok := raw.(map[string]any)
		if ok && row["tag"] == tag && row["type"] == "openvpn-client" {
			return desktopImportedH3AwaitOpenVPN(ctx, original, current, row)
		}
	}
	return errors.New("protected H3 original OpenVPN endpoint capture missing")
}

