// This is a separate protected Windows acceptance inventory. It starts the
// actual imported Box, original policy, BFE baseline and isolated socket owner.
// Wintun identity is real; route/DNS installation and packet pumping retain the
// existing explicit external WFP fixture boundary. These are not device tests.
var desktopImportedH3WindowsKinds = []string{"socks5", "shadowsocks", "hysteria2", "wireguard", "amneziawg", "openvpn-tcp", "openvpn-udp"}
var desktopImportedH3WindowsLayers = []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"}

func desktopImportedH3WindowsLibrary(t *testing.T) {
	t.Helper()
	path, expected := os.Getenv("ROUTERVPN_NODE_CRONET_LIBRARY"), os.Getenv("ROUTERVPN_NODE_CRONET_SHA256")
	size, e := strconv.ParseInt(os.Getenv("ROUTERVPN_NODE_CRONET_BYTES"), 10, 64)
	if e != nil || size <= 0 || size > 128<<20 || len(expected) != 64 || !filepath.IsAbs(path) {
		t.Fatal("protected imported H3 requires its exact same-target Cronet module")
	}
	before, e := os.Lstat(path)
	if e != nil || !before.Mode().IsRegular() || before.Size() != size {
		t.Fatal("captured imported H3 library is absent or changed", e)
	}
	file, e := os.Open(path)
	if e != nil {
		t.Fatal(e)
	}
	defer file.Close()
	opened, e := file.Stat()
	if e != nil || !os.SameFile(before, opened) {
		t.Fatal("imported H3 library changed while opening", e)
	}
	digest := sha256.New()
	n, e := io.Copy(digest, io.LimitReader(file, size+1))
	if e != nil || n != size || hex.EncodeToString(digest.Sum(nil)) != expected {
		t.Fatal("imported H3 library differs from captured module", e)
	}
	if e = cronet.LoadLibrary(path); e != nil {
		t.Fatal("captured imported H3 native library did not load", e)
	}
	after, e := os.Lstat(path)
	if e != nil || !os.SameFile(opened, after) || after.Size() != size {
		t.Fatal("imported H3 library changed during native load", e)
	}
}
func desktopImportedH3WindowsSource(t *testing.T, kind, first, last string) []string {
	t.Helper()
	directory := os.Getenv("ROUTERVPN_IMPORTED_NAIVE_H3_FIXTURES")
	if directory == "" {
		t.Fatal("protected imported H3 has no separate source inventory")
	}
	path := filepath.Join(directory, kind+"--naive-h3--"+first+"--"+last+".json")
	before, e := os.Lstat(path)
	if e != nil || !before.Mode().IsRegular() || before.Size() <= 0 || before.Size() > 1<<20 {
		t.Fatal("protected imported H3 source is not a bounded original file", e)
	}
	raw, e := os.ReadFile(path)
	var source []string
	if e != nil || json.Unmarshal(raw, &source) != nil || len(source) != 9 || source[2] != "naive-h3" {
		t.Fatal("protected imported H3 source lost its original strings", e)
	}
	original := desktopImportedH3CompileSource(t, source)
	defer original.Close()
	if original.SourceSHA256() != source[7] || original.Config() != source[8] || original.Healthy() {
		t.Fatal("protected imported H3 source identity changed or fabricated proof")
	}
	var meta mobilemultihop.Metadata
	protocol := kind
	if strings.HasPrefix(kind, "openvpn-") {
		protocol = "openvpn"
	}
	normalize := func(v string) string {
		if v == "" {
			return "off"
		}
		return v
	}
	if json.Unmarshal([]byte(original.Metadata()), &meta) != nil || meta.EntryMode != protocol || meta.ExitMode != "naive-h3" || normalize(meta.EntryStartLayer) != first || normalize(meta.ExitStartLayer) != last {
		t.Fatal("protected imported H3 filename relabeled another original graph")
	}
	after, e := os.Lstat(path)
	current, readErr := os.ReadFile(path)
	if e != nil || readErr != nil || !os.SameFile(before, after) || !bytes.Equal(raw, current) {
		t.Fatal("protected imported H3 original source changed during capture")
	}
	return source
}

type desktopImportedH3Reference struct {
	alias       *desktopExternalWindowsAlias
	input       io.WriteCloser
	output      *os.File
	reader      *bufio.Reader
	done        chan error
	cancel      context.CancelFunc
	diagnostics desktopExternalWFPDiagnostics
	initial     desktopImportedH3PeerReply
	closed      bool
}

// A failed Go test peer writes its failure detail after the first non-JSON
// verdict line. Retain that bounded tail before the existing owner joins the
// original process; otherwise the framing error hides the actual provider
// failure. This never accepts diagnostic output as a protocol acknowledgement.
func desktopImportedH3ReadReply(reader *bufio.Reader, value any, diagnostics io.Writer) error {
	err := desktopImportedH3Read(reader, value)
	if err == nil || errors.Is(err, io.EOF) {
		return err
	}
	const limit = 64 << 10
	n, drainErr := io.Copy(diagnostics, io.LimitReader(reader, limit))
	if n == limit {
		drainErr = errors.Join(drainErr, errors.New("original imported H3 peer failure diagnostic exceeded bound"))
	}
	return errors.Join(err, drainErr)
}

func (p *desktopImportedH3Reference) read() (desktopImportedH3PeerReply, error) {
	type result struct {
		reply desktopImportedH3PeerReply
		err   error
	}
	done := make(chan result, 1)
	go func() {
		var value desktopImportedH3PeerReply
		e := desktopImportedH3ReadReply(p.reader, &value, &p.diagnostics)
		done <- result{value, e}
	}()
	select {
	case value := <-done:
		return value.reply, value.err
	case <-time.After(12 * time.Second):
		p.cancel()
		_ = p.output.Close()
		select {
		case <-done:
		case <-time.After(12 * time.Second):
			return desktopImportedH3PeerReply{}, errors.New("original H3 peer reader did not join")
		}
		return desktopImportedH3PeerReply{}, errors.New("original H3 peer response timed out")
	}
}
func (p *desktopImportedH3Reference) same(reply desktopImportedH3PeerReply) bool {
	original := p.initial
	return reply.Schema == 1 && reply.Probe == original.Probe && reply.Kind == original.Kind && reply.EntryLayer == original.EntryLayer && reply.FinalLayer == original.FinalLayer && reply.Address == original.Address && reply.SourceSHA256 == original.SourceSHA256 && reply.ConfigSHA256 == original.ConfigSHA256 && reflect.DeepEqual(reply.Source, original.Source) && bytes.Equal(reply.AppID, original.AppID)
}
func (p *desktopImportedH3Reference) observe(t *testing.T) desktopImportedH3PeerReply {
	t.Helper()
	if p.closed {
		t.Fatal("retired imported H3 peer was reused")
	}
	if e := json.NewEncoder(p.input).Encode(desktopImportedH3PeerRequest{Schema: 1, Operation: "observe"}); e != nil {
		t.Fatal(e)
	}
	r, e := p.read()
	if e != nil || !p.same(r) || r.Closed {
		t.Fatal("imported H3 peer readback changed owner", e, p.diagnostics.String())
	}
	return r
}
func (p *desktopImportedH3Reference) close() error {
	if p.closed {
		return nil
	}
	p.closed = true
	failure := p.input.Close()
	reply, e := p.read()
	if e != nil || !p.same(reply) || !reply.Closed || reply.Nonce != "" {
		failure = errors.Join(failure, e, errors.New("imported H3 peer did not acknowledge original joined cleanup"))
		p.cancel()
	}
	failure = errors.Join(failure, desktopExternalWFPJoinOutput(p.reader, p.output.Close, p.done, p.cancel, 12*time.Second))
	failure = errors.Join(failure, p.output.Close())
	p.cancel()
	return failure
}
func desktopImportedH3WindowsReference(t *testing.T, ca *desktopExternalIntegrationCA, kind, first, last, fault string) *desktopImportedH3Reference {
	return desktopImportedH3WindowsReferenceWithAlias(t, ca, kind, first, last, fault, nil)
}
func desktopImportedH3WindowsReferenceWithAlias(t *testing.T, ca *desktopExternalIntegrationCA, kind, first, last, fault string, alias *desktopExternalWindowsAlias) *desktopImportedH3Reference {
	t.Helper()
	address := desktopExternalWFPAddress(t).String()
	if strings.HasPrefix(kind, "openvpn-") {
		if alias == nil {
			alias = desktopExternalCreateAlias(t)
		} else if e := alias.readback(); e != nil {
			t.Fatal("replacement H3 reference lost original owned alias", e)
		}
		address = desktopExternalOpenVPNAlias.String()
	}
	image, e := desktopExternalWFPCapturedImage()
	if e != nil {
		t.Fatal(e)
	}
	copyPath := filepath.Join(t.TempDir(), "retained-imported-h3-provider.test.exe")
	writer, e := image.create(copyPath)
	if writer != nil {
		t.Cleanup(func() {
			if e := writer.close(); e != nil {
				t.Error(e)
			}
		})
	}
	if e != nil {
		t.Fatal(e)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
	command := exec.CommandContext(ctx, copyPath, "-test.run=^TestRouterVPNWindowsImportedNaiveH3Peer$", "-test.count=1", "-test.timeout=85s")
	command.Env = append(os.Environ(), "ROUTERVPN_WINDOWS_IMPORTED_H3_PEER=1")
	input, e := command.StdinPipe()
	if e != nil {
		cancel()
		t.Fatal(e)
	}
	output, child, e := os.Pipe()
	if e != nil {
		_ = input.Close()
		cancel()
		t.Fatal(e)
	}
	p := &desktopImportedH3Reference{alias: alias, input: input, output: output, reader: bufio.NewReaderSize(output, desktopImportedH3PeerLimit+1), done: make(chan error, 1), cancel: cancel}
	command.Stdout, command.Stderr = child, &p.diagnostics
	if e = command.Start(); e != nil {
		_ = input.Close()
		_ = output.Close()
		_ = child.Close()
		cancel()
		t.Fatal(e)
	}
	_ = child.Close()
	go func() { p.done <- command.Wait() }()
	t.Cleanup(func() {
		if e := p.close(); e != nil {
			t.Error("original imported H3 provider cleanup", e, p.diagnostics.String())
		}
	})
	cert, key := desktopExternalWFPCertificate(t, ca.certificate(t, true))
	r := desktopImportedH3PeerRequest{Schema: 1, Operation: "start", Kind: kind, EntryLayer: first, FinalLayer: last, Address: address, Fault: fault, Source: desktopImportedH3WindowsSource(t, kind, first, last), Certificate: cert, Key: key}
	if e = json.NewEncoder(input).Encode(r); e != nil {
		t.Fatal(e)
	}
	clear(key)
	p.initial, e = p.read()
	self, appErr := mobiletor.DesktopWindowsNodeCompositionAppID()
	if e != nil || appErr != nil || p.initial.Schema != 1 || p.initial.Kind != kind || p.initial.EntryLayer != first || p.initial.FinalLayer != last || p.initial.Closed || len(p.initial.AppID) == 0 || bytes.Equal(self, p.initial.AppID) || len(p.initial.Source) != 7 {
		t.Fatal("independent imported H3 reference lost original process/source identity", e, appErr, p.diagnostics.String())
	}
	return p
}

