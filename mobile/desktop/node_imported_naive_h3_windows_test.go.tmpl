func (p *desktopImportedH3Reference) marker(t *testing.T, operation, nonce string) int64 {
	t.Helper()
	if e := json.NewEncoder(p.input).Encode(desktopImportedH3PeerRequest{Schema: 1, Operation: operation, Nonce: nonce}); e != nil {
		t.Fatal(e)
	}
	reply, e := p.read()
	if e != nil || !p.same(reply) || reply.Closed || reply.Nonce != nonce {
		t.Fatal("protected H3 independent marker changed receiver", e)
	}
	return reply.Observed
}
func desktopImportedH3RequireBlocked(t *testing.T, p *desktopImportedH3Reference) {
	t.Helper()
	positive := func() {
		nonce := desktopExternalWFPNonce(t)
		if p.marker(t, "arm", nonce) != 0 || p.marker(t, "positive", nonce) != 1 {
			t.Fatal("protected H3 independent raw receiver was not live")
		}
	}
	positive()
	nonce := desktopExternalWFPNonce(t)
	if p.marker(t, "arm", nonce) != 0 {
		t.Fatal("H3 raw-deny probe reused an old marker")
	}
	echo, err := desktopExternalWFPExchange(netip.MustParseAddrPort(p.initial.Probe), nonce)
	observed := p.marker(t, "observe", nonce)
	positive()
	if observed != 0 || p.marker(t, "observe", nonce) != 0 || echo {
		t.Fatal("ordinary token bypassed actual imported H3 WFP deny: independent peer marker")
	}
	var timeout net.Error
	if err == nil || !errors.Is(err, syscall.Errno(10013)) && !(errors.As(err, &timeout) && timeout.Timeout()) {
		t.Fatal("protected H3 ordinary raw refusal lacks an actual access/timeout error", err)
	}
}
