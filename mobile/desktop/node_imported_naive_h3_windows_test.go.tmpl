func (f *desktopImportedH3WindowsFixture) close() error {
	f.closeOnce.Do(func() {
		if f.owner != nil {
			f.owner.Cancel()
		}
		if f.box != nil {
			f.closeErr = f.box.Close()
		}
		f.cancel()
	})
	return f.closeErr
}
func desktopImportedH3WindowsBox(t *testing.T, p *desktopImportedH3Reference, previous *mobiletor.DesktopWindowsProtectionTarget) *desktopImportedH3WindowsFixture {
	t.Helper()
	original := desktopImportedH3CompileSource(t, p.initial.Source)
	t.Cleanup(func() { _ = original.Close() })
	sum := sha256.Sum256([]byte(original.Config()))
	if original.SourceSHA256() != p.initial.SourceSHA256 || hex.EncodeToString(sum[:]) != p.initial.ConfigSHA256 {
		t.Fatal("Windows imported H3 adopted changed reference source")
	}
	policy, e := mobilemultihop.NewDesktopImportedPolicy(original, desktopExternalWFPNonce(t), "windows")
	if e != nil {
		t.Fatal(e)
	}
	ctx, cancel := context.WithCancel(context.Background())
	f := &desktopImportedH3WindowsFixture{policy: policy, source: append([]string(nil), p.initial.Source...), cancel: cancel}
	t.Cleanup(func() {
		if e := f.close(); e != nil {
			t.Error("protected imported H3 Box failed original join", e)
		}
	})
	ins := inbound.NewRegistry()
	MIXED.RegisterInbound(ins)
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.TunInboundOptions) (adapter.Inbound, error) {
		f.tun = &desktopExternalWFPTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag), ctx: ctx, options: options}
		return f.tun, nil
	})
	outs := outbound.NewRegistry()
