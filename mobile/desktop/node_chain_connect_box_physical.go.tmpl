package box

import (
	"context"
	"errors"
	"runtime"

	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
)

func routerVPNDesktopNodeChainCONNECTPhysicalTarget(policy *mobilemultihop.DesktopNodeChainCONNECTPolicy, target string) bool {
	if policy == nil {
		return false
	}
	_, meta, capture, err := policy.ReadValidated()
	if err != nil || meta.Kind != "routervpn-desktop-node-chain-connect" || meta.TargetOS != target || len(meta.Prefixes) != 3 {
		return false
	}
	for position, prefix := range meta.Prefixes {
		if prefix.Position != position {
			return false
		}
		switch position {
		case 0:
			if !mobilemultihop.NodeChainPrefixMode(prefix.Mode) || !mobilemultihop.DesktopNodePhysicalGraphSupported(prefix.Mode, prefix.StartLayer) {
				return false
			}
		case 1:
			if (prefix.Mode != "http-connect" && prefix.Mode != "https-connect") || prefix.NodeKind != "external" || prefix.Kind != "public-path" || prefix.StartLayer != "off" {
				return false
			}
		case 2:
			if prefix.Mode != "shadowsocks" || !mobilemultihop.DesktopNodePhysicalGraphSupported(prefix.Mode, prefix.StartLayer) {
				return false
			}
		}
	}
	for _, root := range capture.PhysicalRoots {
		if root.Type == "http" || root.Type == "socks" || root.DynamicSOCKSUDP {
			return false
		}
	}
	return len(capture.PhysicalRoots) > 0
}

func (s *Box) RouterVPNDesktopNodeChainCONNECTPreparePhysicalOwned(policy *mobilemultihop.DesktopNodeChainCONNECTPolicy) (*RouterVPNDesktopNodePreparation, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainCONNECTPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered CONNECT Windows preparation lost its original physical graph")
	}
	_, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	owner := &RouterVPNDesktopNodePreparation{network: network, policy: policy}
	return owner, network.PrepareNodeChainCONNECTPhysicalPolicy(policy)
}
func (s *Box) RouterVPNDesktopNodeChainCONNECTActivatePhysical(policy *mobilemultihop.DesktopNodeChainCONNECTPolicy) (*RouterVPNDesktopNodePhysical, error) {
	if runtime.GOOS != "windows" || !routerVPNDesktopNodeChainCONNECTPhysicalTarget(policy, "windows") {
		return nil, errors.New("ordered CONNECT Windows activation lost its original physical graph")
	}
	return s.routerVPNDesktopNodeActivatePhysical(policy)
}

// This callback observes the original source generation while an authorized
// MTU transaction has deliberately retired the old TUN's physical grant.
// It does not stand in for current TUN/readback or complete proof authority.
func (owner *RouterVPNDesktopNodePhysical) NodeChainCONNECTSourceCurrentContext(ctx context.Context, source *mobilemultihop.NodeChainCONNECTSource) error {
	if ctx == nil || owner == nil || owner.instance == nil || source == nil {
		return errors.New("ordered CONNECT physical source has no original owner")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	policy, ok := owner.policy.(*mobilemultihop.DesktopNodeChainCONNECTPolicy)
	if !ok || policy == nil {
		return errors.New("ordered CONNECT physical source has another policy family")
	}
	captured, err := policy.NativeSource()
	if err != nil || captured != source {
		return errors.Join(err, errors.New("ordered CONNECT physical source changed its original object"))
	}
	return owner.generationCurrentContext(ctx)
}

// The existing physical permission transaction surrounds the exact retained
// typed TUN transaction. It never substitutes an ordinary Box MTU operation.
func (owner *RouterVPNDesktopNodePhysical) ChangeNodeChainCONNECTMTUContext(ctx context.Context, operation *RouterVPNNodeChainCONNECTMTU, expected adapter.Inbound, value int) (adapter.Inbound, error) {
	if owner == nil || operation == nil || operation.original == nil || operation.original.observation == nil ||
		operation.original.observation.instance != owner.instance || operation.Current() != expected ||
		owner.NodeChainCONNECTSourceCurrentContext(ctx, operation.original.source) != nil {
		return expected, errors.New("ordered CONNECT MTU lost its original Box or physical source")
	}
	return owner.changeMTU(ctx, expected, value, operation.ChangeContext)
}

// An unchanged cancelled trial retains the original physical grant. The typed
// continuation still records and observes that same reader before reproof.
func (owner *RouterVPNDesktopNodePhysical) RetainUnchangedNodeChainCONNECTMTUContext(ctx context.Context, operation *RouterVPNNodeChainCONNECTMTU, expected adapter.Inbound, value int) error {
	if owner == nil || operation == nil || operation.original == nil || operation.original.observation == nil ||
		operation.original.observation.instance != owner.instance || operation.Current() != expected ||
		owner.NodeChainCONNECTSourceCurrentContext(ctx, operation.original.source) != nil {
		return errors.New("ordered CONNECT unchanged trial lost its original owner")
	}
	if err := adapter.RouterVPNLockContext(ctx, &owner.mu); err != nil {
		return err
	}
	defer owner.mu.Unlock()
	name, index, mtu, err := owner.readbackContext(ctx)
	if err != nil || owner.inbound != expected || mtu != value {
		return errors.Join(err, errors.New("ordered CONNECT unchanged trial changed its reader"))
	}
	returned, err := operation.ChangeContext(ctx, expected, value)
	if err != nil || returned != expected {
		return errors.Join(err, errors.New("ordered CONNECT unchanged trial acquired another reader"))
	}
	afterName, afterIndex, afterMTU, err := owner.readbackContext(ctx)
	if err != nil || owner.inbound != expected || name != afterName || index != afterIndex || mtu != afterMTU {
		return errors.Join(err, errors.New("ordered CONNECT unchanged trial lost original readback"))
	}
	return ctx.Err()
}
