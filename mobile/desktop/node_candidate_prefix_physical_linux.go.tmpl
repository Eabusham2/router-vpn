//go:build linux

package routervpndesktoppt

import (
	"context"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

func (n *NodeNetworkOwner) PrepareCandidatePrefixPhysicalPolicy(policy *mobilemultihop.DesktopNodeCandidatePreparationPolicy) error {
	return n.prepareNodePhysicalLinuxLifecycle(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, options mobiletor.DesktopLinuxSocketOptions) (desktopLinuxPhysicalPolicy, error) {
		owned, err := mobiletor.NewDesktopLinuxNodeSocketPolicy(ctx, capture, options)
		if owned == nil {
			return nil, err
		}
		return owned, err
	})
}
