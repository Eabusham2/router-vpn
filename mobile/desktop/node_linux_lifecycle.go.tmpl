//go:build linux

package routervpndesktoppt

import (
	"context"
	"errors"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// Router nodes, imported entry/final pairs and ordinary external graphs retain
// distinct sealed compiler products and their original pointer identities.
// Their Linux native source admission, guardian and joined protection contract
// is shared; the authenticated parent still owns succession and release.
type NodeLinuxPhysicalPrepared = LinuxPhysicalPrepared
type NodeLinuxPhysicalAdmission = LinuxPhysicalAdmission
type NodeLinuxPhysicalBaseline = LinuxPhysicalBaseline

func WithNodeLinuxPhysicalAdmission(ctx context.Context, policy mobilemultihop.DesktopPhysicalPolicy,
	admit NodeLinuxPhysicalAdmission) (context.Context, error) {
	return withLinuxPhysicalAdmission(ctx, linuxPhysicalPolicy{node: policy}, nil, admit)
}

func WithNodeLinuxPhysicalBaseline(ctx context.Context, policy mobilemultihop.DesktopPhysicalPolicy,
	baseline NodeLinuxPhysicalBaseline, admit NodeLinuxPhysicalAdmission) (context.Context, error) {
	if baseline == nil {
		return nil, errors.New("Linux Router node baseline requires its original parent callback")
	}
	return withLinuxPhysicalAdmission(ctx, linuxPhysicalPolicy{node: policy}, baseline, admit)
}

func (n *NodeNetworkOwner) linuxPhysicalContext() context.Context {
	if n == nil {
		return nil
	}
	return n.ctx
}
func (n *NodeNetworkOwner) linuxPhysicalSnapshot() linuxPhysicalNetworkSnapshot {
	if n == nil {
		return linuxPhysicalNetworkSnapshot{}
	}
	n.mu.Lock()
	defer n.mu.Unlock()
	return linuxPhysicalNetworkSnapshot{policy: linuxPhysicalPolicy{node: n.policy}, source: n.source, capture: n.brokerCapture(),
		ready: n.ready && n.sockets, retired: n.retired, closed: n.closed, joined: !n.ready && !n.sockets}
}
func (n *NodeNetworkOwner) linuxPhysicalAdmissionCurrent() bool { return n.SocketCurrent() }

func (n *NodeNetworkOwner) prepareNodePhysicalLinuxLifecycle(policy mobilemultihop.DesktopPhysicalPolicy,
	create func(context.Context, mobiletor.DesktopSocketCapture, mobiletor.DesktopLinuxSocketOptions) (desktopLinuxPhysicalPolicy, error)) error {
	if n == nil {
		return errors.New("Linux Router node admission has no native service")
	}
	return prepareLinuxPhysicalLifecycle(n, linuxPhysicalPolicy{node: policy}, create, func(owned linuxPhysicalCreate) error {
		return n.prepareNodePhysicalLinux(policy, owned)
	})
}

func (n *NodeNetworkOwner) CheckLinuxPhysicalAdmission(policy mobilemultihop.DesktopPhysicalPolicy) error {
	return checkLinuxPhysicalAdmission(n, linuxPhysicalPolicy{node: policy})
}

func (n *NodeNetworkOwner) RetainedLinuxPhysicalProtection(ctx context.Context, policy mobilemultihop.DesktopPhysicalPolicy) (*NodeLinuxPhysicalPrepared, bool, error) {
	return retainedLinuxPhysicalProtection(ctx, n, linuxPhysicalPolicy{node: policy})
}

func (n *NodeNetworkOwner) joinedLinuxProtection(ctx context.Context, policy mobilemultihop.DesktopPhysicalPolicy) (mobiletor.DesktopLinuxProtectionOwner, error) {
	captured, err := joinedLinuxPhysicalCapture(ctx, n, linuxPhysicalPolicy{node: policy})
	return captured.retention, err
}

func (n *NodeNetworkOwner) DisconnectLinuxPhysicalProtection(ctx context.Context, policy mobilemultihop.DesktopPhysicalPolicy) (bool, error) {
	retention, err := n.joinedLinuxProtection(ctx, policy)
	if err != nil || retention == nil {
		return false, errors.Join(err, errors.New("Linux disconnect has no retained native baseline"))
	}
	return retention.Disconnect(ctx)
}

func (n *NodeNetworkOwner) ReleaseLinuxPhysicalProtection(ctx context.Context, policy mobilemultihop.DesktopPhysicalPolicy) error {
	retention, err := n.joinedLinuxProtection(ctx, policy)
	if err != nil || retention == nil {
		return errors.Join(err, errors.New("Linux release has no retained native baseline"))
	}
	return retention.Release(ctx)
}

func (n *NodeNetworkOwner) CloseLinuxPhysicalProtection(ctx context.Context, policy mobilemultihop.DesktopPhysicalPolicy) error {
	retention, err := n.joinedLinuxProtection(ctx, policy)
	if err != nil {
		return err
	}
	if retention == nil {
		return nil
	}
	return retention.Close(ctx)
}
