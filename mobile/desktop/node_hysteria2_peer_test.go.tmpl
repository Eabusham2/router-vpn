// This is the actual pinned QUIC/TLS/Hysteria service. The raw marker observer
// uses the same retained UDP descriptor, before Salamander decoding, and never
// supplies a protocol reply. Only authenticated streams reach the echo/DNS
// handler. The owning subprocess joins shutdown before its parent reuses a
// captured physical endpoint.
type desktopNodeHysteria2Packet struct {
	net.PacketConn
	server *desktopNodeLayerServer
}

func (p *desktopNodeHysteria2Packet) ReadFrom(body []byte) (int, net.Addr, error) {
	p.server.mu.Lock()
	if p.server.closing {
		p.server.mu.Unlock()
		return 0, nil, net.ErrClosed
	}
	p.server.workers.Add(1)
	p.server.mu.Unlock()
	defer p.server.workers.Done()
	for {
		n, source, err := p.PacketConn.ReadFrom(body)
		if err != nil {
			return n, source, err
		}
		address, ok := source.(*net.UDPAddr)
		if !ok {
			return 0, nil, errors.New("Hysteria reference changed its retained datagram source")
		}
		if handled, _ := p.server.observation.receive(p.PacketConn.(*net.UDPConn), body[:n], address.AddrPort()); handled {
			continue
		}
		p.server.rawUDP.Add(1)
		return n, source, nil
	}
}

type desktopNodeHysteria2Handler struct{ *desktopNodeLayerServer }

func (h desktopNodeHysteria2Handler) NewConnectionEx(ctx context.Context, connection net.Conn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
	if !h.enter(connection) {
		_ = connection.Close()
		if onClose != nil {
			onClose(net.ErrClosed)
		}
		return
	}
	defer h.leave(connection)
	err := h.NewConnection(ctx, connection, M.Metadata{Source: source, Destination: destination})
	if onClose != nil {
		onClose(err)
	}
}

func (h desktopNodeHysteria2Handler) NewPacketConnectionEx(ctx context.Context, connection N.PacketConn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
	err := h.NewPacketConnection(ctx, connection, M.Metadata{Source: source, Destination: destination})
	if onClose != nil {
		onClose(err)
	}
}

func startDesktopNodeHysteria2Server(t *testing.T, ip netip.Addr, dnsAddress string, routerAddresses ...string) (*desktopNodeLayerServer, string) {
	t.Helper()
	return startDesktopNodeHysteria2ServerWithIdentity(t, ip, dnsAddress, "", routerAddresses...)
}

func startDesktopNodeHysteria2ServerWithIdentity(t *testing.T, ip netip.Addr, dnsAddress, identity string, routerAddresses ...string) (*desktopNodeLayerServer, string) {
	t.Helper()
	packet, err := net.ListenPacket("udp4", net.JoinHostPort(ip.String(), "0"))
	if err != nil {
		t.Fatal(err)
	}
	return startDesktopNodeHysteria2ServerWithPacketIdentity(t, ip, dnsAddress, packet, identity, routerAddresses...)
}

func startDesktopNodeHysteria2ServerWithPacket(t *testing.T, ip netip.Addr, dnsAddress string, packet net.PacketConn, routerAddresses ...string) (*desktopNodeLayerServer, string) {
	t.Helper()
	return startDesktopNodeHysteria2ServerWithPacketIdentity(t, ip, dnsAddress, packet, "", routerAddresses...)
}

func startDesktopNodeHysteria2ServerWithPacketIdentity(t *testing.T, ip netip.Addr, dnsAddress string, packet net.PacketConn, identity string, routerAddresses ...string) (*desktopNodeLayerServer, string) {
	t.Helper()
	started := false
	defer func() {
		if !started && packet != nil {
			_ = packet.Close()
		}
	}()
	var address netip.AddrPort
	var addressErr error
	if packet != nil && packet.LocalAddr() != nil {
		address, addressErr = netip.ParseAddrPort(packet.LocalAddr().String())
	}
	if addressErr != nil || !ip.Is4() || address.Addr() != ip || address.Port() == 0 {
		t.Fatal("Hysteria2 reference lost its retained UDP endpoint", addressErr)
	}
	routerAddress := ""
	if len(routerAddresses) > 1 {
		t.Fatal("Hysteria2 reference has multiple private Router mappings")
	}
	if len(routerAddresses) == 1 && routerAddresses[0] != "" {
		router, err := netip.ParseAddrPort(routerAddresses[0])
		if err != nil || router.Addr() != ip || !ip.IsPrivate() || router.Port() == 0 {
			t.Fatal("Hysteria2 reference changed its captured private Router destination", err)
		}
		routerAddress = router.String()
	}
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	spec := &x509.Certificate{SerialNumber: big.NewInt(time.Now().UnixNano()), Subject: pkix.Name{CommonName: "captured-node.test"},
		DNSNames: []string{"captured-node.test"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
		KeyUsage: x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, IsCA: true, BasicConstraintsValid: true}
	if identity != "" {
		switch identity {
		case "ip-absent", "ip-empty", "ip-wrong-certificate":
		default:
			t.Fatal("Hysteria reference changed its bounded certificate identity")
		}
		spec.DNSNames = nil
		spec.IPAddresses = []net.IP{net.ParseIP(ip.String())}
		if identity == "ip-wrong-certificate" {
			spec.IPAddresses = []net.IP{net.ParseIP("192.0.2.201")}
		}
	}
	der, err := x509.CreateCertificate(rand.Reader, spec, spec, &key.PublicKey, key)
	if err != nil {
		t.Fatal(err)
	}
	private, err := x509.MarshalPKCS8PrivateKey(key)
	if err != nil {
		t.Fatal(err)
	}
	certificate := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))
	privatePEM := string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: private}))
	clear(private)
	var credential [64]byte
	if _, err := rand.Read(credential[:]); err != nil {
		t.Fatal(err)
	}
	password, mask := base64.StdEncoding.EncodeToString(credential[:32]), base64.StdEncoding.EncodeToString(credential[32:])
	clear(credential[:])
	ctx, cancel := context.WithCancel(context.Background())
	s := &desktopNodeLayerServer{ctx: ctx, cancel: cancel, udp: packet, dnsAddress: dnsAddress, routerAddress: routerAddress, connections: make(map[io.Closer]bool)}
	logger := log.NewNOPFactory().NewLogger("captured-hysteria2-peer")
	tlsConfig, err := boxTLS.NewServer(ctx, logger, option.InboundTLSOptions{Enabled: true, Certificate: []string{certificate}, Key: []string{privatePEM}})
	if err != nil {
		cancel()
		_ = packet.Close()
		t.Fatal(err)
	}
	service, err := HY.NewService[int](HY.ServiceOptions{Context: ctx, Logger: logger, TLSConfig: tlsConfig,
		SalamanderPassword: mask, UDPTimeout: 10 * time.Second, Handler: desktopNodeHysteria2Handler{s}})
	if err == nil {
		service.UpdateUsers([]int{1}, []string{password})
		err = tlsConfig.Start()
	}
	if err == nil {
		err = service.Start(&desktopNodeHysteria2Packet{PacketConn: packet, server: s})
	}
	if err != nil {
		cancel()
		_ = packet.Close()
		_ = tlsConfig.Close()
		if service != nil {
			_ = service.Close()
		}
		t.Fatal("actual Hysteria2 reference did not start", err)
	}
	t.Cleanup(func() {
		s.mu.Lock()
		s.closing = true
		connections := make([]io.Closer, 0, len(s.connections))
		for connection := range s.connections {
			connections = append(connections, connection)
		}
		s.mu.Unlock()
		cancel()
		_ = packet.Close()
		_ = service.Close()
		_ = tlsConfig.Close()
		for _, connection := range connections {
			_ = connection.Close()
		}
		s.workers.Wait()
	})
	started = true
	tls := map[string]any{"enabled": true, "certificate_path": "cert.pem"}
	if identity == "" {
		tls["server_name"] = "captured-node.test"
	} else if identity == "ip-empty" {
		tls["server_name"] = ""
	}
	graph := map[string]any{
		"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "auto_route": true, "strict_route": true}},
		"outbounds": []any{map[string]any{"type": "hysteria2", "tag": "proxy", "server": ip.String(), "server_port": packet.LocalAddr().(*net.UDPAddr).Port,
			"password": password, "obfs": map[string]any{"type": "salamander", "password": mask},
			"tls": tls}},
		"route": map[string]any{"final": "proxy", "rules": []any{}},
	}
	raw, err := json.Marshal(graph)
	if err != nil {
		t.Fatal(err)
	}
	files, err := json.Marshal(map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString(raw), "cert.pem": base64.StdEncoding.EncodeToString([]byte(certificate))})
	if err != nil {
		t.Fatal(err)
	}
	return s, string(files)
}

func desktopNodeHysteria2Assets(t *testing.T, files, fault string) string {
	t.Helper()
	var assets map[string]string
	if json.Unmarshal([]byte(files), &assets) != nil || len(assets) != 2 || assets["cert.pem"] == "" {
		t.Fatal("Hysteria reference lost its complete captured node assets")
	}
	raw, err := base64.StdEncoding.Strict().DecodeString(assets["sing-box.json"])
	var graph map[string]any
	if err != nil || json.Unmarshal(raw, &graph) != nil {
		t.Fatal("Hysteria reference lost its actual client graph", err)
	}
	outbound := graph["outbounds"].([]any)[0].(map[string]any)
	switch fault {
	case "hysteria-password":
		outbound["password"] = "different-node-" + outbound["password"].(string)
	case "hysteria-trust":
		outbound["tls"].(map[string]any)["server_name"] = "another-node.test"
	case "hysteria-salamander":
		outbound["obfs"].(map[string]any)["password"] = "different-node-" + outbound["obfs"].(map[string]any)["password"].(string)
	case "", "aes-key":
	default:
		t.Fatal("unrecognized Hysteria reference fault")
	}
	raw, err = json.Marshal(graph)
	if err != nil {
		t.Fatal(err)
	}
	assets["sing-box.json"] = base64.StdEncoding.EncodeToString(raw)
	raw, err = json.Marshal(assets)
	if err != nil {
		t.Fatal(err)
	}
	return string(raw)
}

func TestRouterVPNDesktopNodeHysteria2WrongCredential(t *testing.T) {
	for _, test := range []struct{ layer, fault string }{
		{"", "hysteria-password"}, {"", "hysteria-trust"}, {"", "hysteria-salamander"},
		{"aes-256-gcm", "hysteria-password"}, {"aes-256-gcm+xor-whitening", "hysteria-password"},
		{"aes-256-gcm", "hysteria-trust"}, {"aes-256-gcm+xor-whitening", "hysteria-trust"},
		{"aes-256-gcm", "hysteria-salamander"}, {"aes-256-gcm+xor-whitening", "hysteria-salamander"},
		{"aes-256-gcm", "aes-key"}, {"aes-256-gcm+xor-whitening", "aes-key"},
	} {
		label := test.layer
		if label == "" {
			label = "off"
		}
		t.Run(label+"/"+test.fault, func(t *testing.T) {
			_, ip := desktopNodePeerInterface(t)
			peer := startDesktopNodeLayerReference(t, "hysteria2", test.layer, ip)
			f := newDesktopNodeLayerFixture(t, peer, test.fault)
			if err := f.box.RouterVPNStrategyStart(); err != nil {
				t.Fatal("Hysteria wrong credential did not reach actual captured startup", err)
			}
			if err := f.exchange("udp"); err == nil {
				t.Fatal("wrong captured Hysteria credential delivered encrypted payload")
			}
			observed := peer.observe(t, "stats")
			if observed.RawUDP == 0 || observed.ProtocolTCP != 0 || observed.ProtocolUDP != 0 ||
				strings.HasPrefix(test.fault, "hysteria-") && observed.ProtocolRawUDP == 0 || f.network.Current() {
				t.Fatal("Hysteria negative missed its real encrypted peer or fabricated readiness", observed)
			}
		})
	}
}

// Fixture-only controls are admitted before any peer socket is opened. They
// never change a production profile or weaken the actual runtime validator.
func desktopNodeHysteria2CaptureValid(request desktopNodeLayerRequest) bool {
	if request.HysteriaTLSIdentity != "" {
		if request.Mode != "hysteria2" {
			return false
		}
		switch request.HysteriaTLSIdentity {
		case "ip-absent", "ip-empty", "ip-wrong-certificate":
		default:
			return false
		}
	}
	return !request.WhiteningMismatch || request.Mode == "hysteria2" && request.Layer == "aes-256-gcm+xor-whitening"
}

func TestRouterVPNDesktopNodeHysteria2LayerTLSIdentity(t *testing.T) {
	for _, layer := range []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		label := layer
		if label == "" {
			label = "off"
		}
		for _, identity := range []string{"ip-absent", "ip-empty", "ip-wrong-certificate"} {
			t.Run(label+"/"+identity, func(t *testing.T) {
				_, ip := desktopNodePeerInterface(t)
				peer := startDesktopNodeLayerReferenceConfigured(t, "hysteria2", layer, ip, desktopNodeLayerReferenceOptions{HysteriaTLSIdentity: identity})
				f := newDesktopNodeLayerFixture(t, peer, "")
				if err := f.box.RouterVPNStrategyStart(); err != nil {
					t.Fatal(err)
				}
				err := f.exchange("udp")
				observed := peer.observe(t, "stats")
				if identity == "ip-wrong-certificate" {
					if err == nil || observed.ProtocolTCP != 0 || observed.ProtocolUDP != 0 || observed.DNSQueries != 0 {
						t.Fatal("wrong original IP certificate delivered payload", err, observed)
					}
				} else {
					if err != nil || f.exchange("tcp") != nil || f.box.RouterVPNStrategyDNSProof() != nil {
						t.Fatal("original IP-SAN identity did not survive its transport detour", err)
					}
					observed = peer.observe(t, "stats")
					if observed.ProtocolTCP == 0 || observed.ProtocolUDP == 0 || observed.DNSQueries != 1 {
						t.Fatal("IP-SAN proof skipped real payload or selected DNS", observed)
					}
				}
				if observed.RawUDP == 0 || observed.ProtocolRawUDP == 0 || observed.RawTCP != 0 || f.network.Current() {
					t.Fatal("IP-SAN test missed actual TLS traffic or invented kernel readiness", observed)
				}
			})
		}
	}
}

func TestRouterVPNDesktopNodeHysteria2WrongWhitening(t *testing.T) {
	_, ip := desktopNodePeerInterface(t)
	peer := startDesktopNodeLayerReferenceConfigured(t, "hysteria2", "aes-256-gcm+xor-whitening", ip, desktopNodeLayerReferenceOptions{WhiteningMismatch: true})
	f := newDesktopNodeLayerFixture(t, peer, "")
	if err := f.box.RouterVPNStrategyStart(); err != nil {
		t.Fatal(err)
	}
	if err := f.exchange("udp"); err == nil {
		t.Fatal("mismatched whitening with the correct independent AES key delivered payload")
	}
	observed := peer.observe(t, "stats")
	if observed.RawUDP == 0 || observed.PlainUDP != 0 || observed.ProtocolRawUDP != 0 || observed.ProtocolTCP != 0 || observed.ProtocolUDP != 0 || f.network.Current() {
		t.Fatal("whitening-only negative bypassed its actual outer relay and AES rejection", observed)
	}
}

// This invokes the real worker and encrypted proof, but keeps the common
// explicit modeled TUN/kernel boundary. The installed host separately proves
// that only its exact admitted native activation may publish Connected.
func TestRouterVPNDesktopNodeHysteria2LayerCover(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		for _, fault := range []string{"", "wrong-node", "drop-cover"} {
			label := fault
			if label == "" {
				label = "owned"
			}
			t.Run(layer+"/"+label, func(t *testing.T) {
				_, ip := desktopNodePeerInterface(t)
				peer := startDesktopNodeLayerReferenceConfigured(t, "hysteria2", layer, ip, desktopNodeLayerReferenceOptions{NodeProofID: strings.Repeat("a", 64), Cover: true})
				f := newDesktopNodeLayerFixture(t, peer, "")
				if err := f.box.RouterVPNStrategyStart(); err != nil {
					t.Fatal(err)
				}
				var cover *routervpnperformance.Service
				for _, service := range f.box.RouterVPNServices() {
					if actual, ok := service.(*routervpnperformance.Service); ok {
						if cover != nil {
							t.Fatal("multiple cover workers")
						}
						cover = actual
					}
				}
				if cover == nil || cover.Healthy() || peer.observe(t, "stats").CoverPackets != 0 {
					t.Fatal("cover started before its actual node proof")
				}
				if err := f.box.RouterVPNStrategyDNSProof(); err != nil {
					t.Fatal(err)
				}
				if fault != "" {
					peer.observe(t, fault)
				}
				err := cover.Activate()
				observed := peer.observe(t, "stats")
				if (err == nil) != (fault == "") || cover.Healthy() != (fault == "") || observed.RouterQueries == 0 || observed.DirectQueries != 0 || observed.DNSQueries != 1 || observed.RawTCP != 0 || observed.RawUDP == 0 || observed.ProtocolRawUDP == 0 || observed.ProtocolTCP == 0 || f.network.Current() {
					t.Fatal("layered cover changed proof, path or native boundary", err, observed)
				}
				if fault == "wrong-node" {
					if observed.CoverPackets != 0 {
						t.Fatal("wrong node started cover")
					}
				} else if observed.CoverPackets == 0 || observed.CoverBytes < 128 || observed.CoverMaximum > 1200 || (observed.CoverReplies > 0) != (fault == "") {
					t.Fatal("cover did not reach the final Hysteria peer", observed)
				}
				if err := cover.Close(); err != nil || cover.Healthy() {
					t.Fatal("layered cover worker did not retire", err)
				}
				f.source.Cancel()
				if err := f.close(); err != nil || !f.source.closed.Load() {
					t.Fatal("layered cover retained its old socket source", err)
				}
			})
		}
	}
}

func TestRouterVPNDesktopNodeHysteria2OuterCannotBypassFinal(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		t.Run(layer, func(t *testing.T) {
			_, ip := desktopNodePeerInterface(t)
			peer := startDesktopNodeLayerReference(t, "hysteria2", layer, ip, strings.Repeat("a", 64))
			f := newDesktopNodeLayerFixture(t, peer, "")
			if err := f.box.RouterVPNStrategyStart(); err != nil {
				t.Fatal(err)
			}
			outer, found := f.box.Outbound().Outbound(mobilemultihop.NativeStartLayerTag)
			if !found {
				t.Fatal("missing captured outer AES transport")
			}
			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
			defer cancel()
			connection, err := outer.DialContext(ctx, "tcp", M.ParseSocksaddr(desktopNodeRouterHealthTarget))
			if connection != nil {
				_ = connection.Close()
			}
			if err == nil {
				t.Fatal("Hysteria2 outer acquired an uncaptured physical TCP grant")
			}
			target := M.ParseSocksaddr("192.168.50.133:53")
			packet, err := outer.ListenPacket(ctx, target)
			if err != nil {
				t.Fatal("outer negative missed actual owned UDP transport", err)
			}
			_ = packet.SetDeadline(time.Now().Add(350 * time.Millisecond))
			query := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
			raw, err := query.Pack()
			if err != nil {
				_ = packet.Close()
				t.Fatal(err)
			}
			n, writeErr := packet.WriteTo(raw, target)
			answer := make([]byte, 512)
			_, _, readErr := packet.ReadFrom(answer)
			_ = packet.Close()
			observed := peer.observe(t, "stats")
			if writeErr != nil || n != len(raw) || readErr == nil || observed.RawTCP != 0 || observed.RawUDP == 0 || observed.PlainUDP != 0 ||
				observed.ProtocolRawUDP != 0 || observed.ProtocolTCP != 0 || observed.ProtocolUDP != 0 || observed.RouterQueries != 0 || observed.DNSQueries != 0 {
				t.Fatal("outer AES bypassed its sole captured inner UDP route", writeErr, readErr, observed)
			}
			if err := f.exchange("tcp"); err != nil || f.box.RouterVPNStrategyDNSProof() != nil {
				t.Fatal("outer rejection concealed an unavailable final Hysteria2 path", err)
			}
			observed = peer.observe(t, "stats")
			if observed.ProtocolRawUDP == 0 || observed.ProtocolTCP == 0 || observed.ProtocolUDP == 0 || observed.DNSQueries != 1 || f.network.Current() {
				t.Fatal("final selected DNS positive control skipped its encrypted peer", observed)
			}
		})
	}
}

func TestRouterVPNDesktopNodeHysteria2ReferenceCapture(t *testing.T) {
	for _, test := range []struct {
		name    string
		request desktopNodeLayerRequest
		allowed bool
	}{
		{"unchanged", desktopNodeLayerRequest{}, true},
		{"ip-absent", desktopNodeLayerRequest{Mode: "hysteria2", HysteriaTLSIdentity: "ip-absent"}, true},
		{"ip-empty", desktopNodeLayerRequest{Mode: "hysteria2", HysteriaTLSIdentity: "ip-empty"}, true},
		{"wrong-ip", desktopNodeLayerRequest{Mode: "hysteria2", HysteriaTLSIdentity: "ip-wrong-certificate"}, true},
		{"unknown-identity", desktopNodeLayerRequest{Mode: "hysteria2", HysteriaTLSIdentity: "skip-trust"}, false},
		{"other-mode", desktopNodeLayerRequest{Mode: "shadowsocks", HysteriaTLSIdentity: "ip-absent"}, false},
		{"whitening", desktopNodeLayerRequest{Mode: "hysteria2", Layer: "aes-256-gcm+xor-whitening", WhiteningMismatch: true}, true},
		{"wrong-layer", desktopNodeLayerRequest{Mode: "hysteria2", Layer: "aes-256-gcm", WhiteningMismatch: true}, false},
		{"wrong-mode", desktopNodeLayerRequest{Mode: "shadowsocks", Layer: "aes-256-gcm+xor-whitening", WhiteningMismatch: true}, false},
	} {
		t.Run(test.name, func(t *testing.T) {
			if desktopNodeHysteria2CaptureValid(test.request) != test.allowed {
				t.Fatal("Hysteria2 peer admitted another captured trust/layer control")
			}
		})
	}
}
