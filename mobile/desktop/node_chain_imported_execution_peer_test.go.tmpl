// The test adapter preserves the encrypted peer's actual source metadata and
// binds its real TCP socket to that same captured private peer. The shipping
// relay's peer check remains active. No route to a foreign lease is introduced.
type importedExecutionForward struct {
	*desktopNodeWGHandler
	middle                  atomic.Pointer[string]
	serverDelay, localDelay atomic.Int64
}

func (h *importedExecutionForward) NewConnectionEx(ctx context.Context, c net.Conn, source, destination M.Socksaddr, done N.CloseHandlerFunc) {
	target := destination.String()
	admin := destination.Addr == netip.MustParseAddr("10.78.0.1") && (destination.Port == 8787 || destination.Port >= 28440 && destination.Port <= 28447)
	middle := h.middle.Load()
	local := middle != nil && target == *middle
	if !admin && !local {
		h.desktopNodeWGHandler.NewConnectionEx(ctx, c, source, destination, done)
		return
	}
	if source.Addr != netip.MustParseAddr("10.78.0.2") || !h.adopt(c, true) {
		_ = c.Close()
		if done != nil {
			done(errors.New("imported execution forward lost original private peer"))
		}
		return
	}
	h.tcp.Add(1)
	go func() {
		defer h.workers.Done()
		defer h.forget(c)
		defer c.Close()
		delay := h.localDelay.Load()
		if admin && destination.Port != 8787 {
			delay = h.serverDelay.Load()
		}
		if delay > 0 {
			timer := time.NewTimer(time.Duration(delay))
			select {
			case <-h.ctx.Done():
				timer.Stop()
				_ = c.Close()
				if done != nil {
					done(h.ctx.Err())
				}
				return
			case <-timer.C:
			}
		}
		dialer := net.Dialer{Timeout: 5 * time.Second}
		if admin {
			dialer.LocalAddr = &net.TCPAddr{IP: net.ParseIP("10.78.0.2")}
		}
		raw, err := dialer.DialContext(h.ctx, "tcp", target)
		if err == nil {
			peer, ok := raw.(*net.TCPConn)
			half, halfOK := c.(interface{ CloseWrite() error })
			if !ok || !halfOK {
				err = errors.Join(errors.New("original reciprocal stream unavailable"), raw.Close())
			} else if !h.adopt(peer, false) {
				err = net.ErrClosed
			} else {
				defer h.forget(peer)
				defer peer.Close()
				err = errors.Join(c.SetDeadline(time.Now().Add(30*time.Second)), peer.SetDeadline(time.Now().Add(30*time.Second)))
				if err == nil {
					err = errors.Join(c.SetDeadline(time.Time{}), peer.SetDeadline(time.Time{}))
				}
				if err == nil {
					err = desktopReferenceCopyStream(h.ctx, c, c, half, peer)
				}
			}
		} else {
			_ = c.Close()
		}
		if done != nil {
			done(err)
		}
	}()
}

type importedExecutionRunner struct {
	policy                   *mobilemultihop.NodeChainServerPolicy
	image, imageSHA, runtime string
	imageInfo                os.FileInfo
	mu                       sync.Mutex
	processes                []*importedExecutionProcess
	launches                 atomic.Uint64
}

func (r *importedExecutionRunner) Start(context.Context, []byte, multihoprelay.Lease) (multihoprelay.Process, error) {
	return nil, multihoprelay.ErrUnavailable
}
func (r *importedExecutionRunner) StartChain(ctx context.Context, capture multihoprelay.NodeChainCapture) (multihoprelay.NodeChainProcess, error) {
	bad := errors.New("test launcher lost original portable suffix/image")
	if ctx == nil || ctx.Err() != nil || capture.Validate() != nil || r.policy == nil || r.policy.NativeCarrierRequired() {
		return nil, bad
	}
	expected, e := r.policy.Descriptor().Digest()
	actual, a := capture.Source.Digest()
	if e != nil || a != nil || expected != actual {
		return nil, bad
	}
	file, info, digest, err := captureImportedExecutionImage(r.image)
	if err != nil {
		return nil, err
	}
	defer file.Close()
	if !os.SameFile(info, r.imageInfo) || digest != r.imageSHA {
		return nil, bad
	}
	dir, err := os.MkdirTemp(r.runtime, "chain-")
	if err != nil {
		return nil, err
	}
	original, err := os.Lstat(dir)
	if err != nil {
		return nil, err
	}
	p := newImportedExecutionProcess(capture, dir, original)
	r.mu.Lock()
	r.processes = append(r.processes, p)
	r.mu.Unlock()
	p.root, err = os.OpenRoot(dir)
	if err != nil {
		return p, err
	}
	raw, err := json.Marshal(capture)
	if err != nil {
		return p, err
	}
	defer clear(raw)
	if err = os.WriteFile(filepath.Join(dir, "node-chain-capture.json"), raw, 0600); err != nil {
		return p, err
	}
	if err = os.WriteFile(filepath.Join(dir, "node-chain-source.json"), []byte(r.policy.Source()), 0600); err != nil {
		return p, err
	}
	// Explicit Darwin fixture launch seam: /proc/self/fd is a Linux launcher
	// primitive. The exact verified image/path/inode is rechecked immediately
	// before and after direct exec; the shipping IPC owner remains unmodified.
	command := exec.Command(r.image, "routervpn-node-chain-relay", "--runtime-dir", dir)
	command.Dir = dir
	command.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LANG=C", "GORACE=atexit_sleep_ms=0"}
	command.Stderr = os.Stderr
	source := r.policy.Source()
	p.current = func() bool {
		current, err := os.Lstat(r.image)
		return err == nil && os.SameFile(current, r.imageInfo) && current.Size() == r.imageInfo.Size() && current.ModTime().Equal(r.imageInfo.ModTime()) && r.policy.Source() == source
	}
	if !p.current() {
		return p, bad
	}
	if err = p.start(command); err != nil {
		return p, err
	}
	if !p.current() {
		return p, bad
	}
	nonce, err := importedExecutionNonce()
	if err != nil {
		return p, err
	}
	receipt, err := p.Snapshot(ctx, nonce)
	if err != nil || receipt.Phase != multihoprelay.NodeChainPending {
		return p, errors.Join(err, bad)
	}
	r.launches.Add(1)
	return p, nil
}
func (r *importedExecutionRunner) joined() bool {
	r.mu.Lock()
	defer r.mu.Unlock()
	for _, p := range r.processes {
		if p.Alive() || !p.cleaned || !p.removed {
			return false
		}
	}
	return true
}

type importedExecutionAdmin struct {
	cfg   struct{ NodeID string }
	relay *multihoprelay.Manager
	token string
}

func (s *importedExecutionAdmin) authorized(r *http.Request) (net.IP, error) {
	address, err := netip.ParseAddrPort(r.RemoteAddr)
	if err != nil || address.Addr() != netip.MustParseAddr("10.78.0.2") || r.Host != "10.78.0.1:8787" || r.Header.Get("Authorization") != "Bearer "+s.token {
		return nil, errors.New("original fixture administration authentication refused")
	}
	return net.IP(address.Addr().AsSlice()), nil
}

type importedExecutionPeerRequest struct {
	Schema   int                             `json:"schema"`
	Peer     desktopNodeChainImportedRequest `json:"peer"`
	Image    string                          `json:"image"`
	ImageSHA string                          `json:"image_sha256"`
}

func importedExecutionRead(reader *bufio.Reader, limit int, output any) error {
	line, err := reader.ReadSlice('\n')
	if err != nil || len(line) > limit {
		return errors.New("bounded imported execution control required")
	}
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	if decoder.Decode(output) != nil || decoder.Decode(new(any)) != io.EOF {
		return errors.New("original imported execution control changed")
	}
	return nil
}

func importedExecutionJoinHTTP(ctx context.Context, done <-chan struct{}, outcome *error) error {
	if ctx == nil || done == nil || outcome == nil {
		return errors.New("original administration join is missing")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-done:
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if !errors.Is(*outcome, http.ErrServerClosed) {
		return errors.Join(errors.New("original administration stopped unexpectedly"), *outcome)
	}
	return nil
}

func TestRouterVPNDesktopImportedExecutionReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_IMPORTED_EXECUTION_REFERENCE") == "" {
		t.Skip("explicit original imported execution peer only")
	}
	if os.Getenv("ROUTERVPN_IMPORTED_EXECUTION_REFERENCE") != "1" {
		t.Fatal("uncaptured imported execution peer")
	}
	reader := bufio.NewReaderSize(os.Stdin, mobilemultihop.NodeChainInputLimit+1)
	var request importedExecutionPeerRequest
	if importedExecutionRead(reader, 32<<10, &request) != nil || request.Schema != 1 || desktopNodeChainImportedRequestValid(request.Peer) != nil {
		t.Fatal("original imported execution peer request refused")
	}
	image, info, digest, err := captureImportedExecutionImage(request.Image)
	if err != nil || digest != request.ImageSHA || !filepath.IsAbs(request.Image) {
		t.Fatal("original imported execution image changed", err)
	}
	_ = image.Close()
	local, remote := netip.MustParseAddr(request.Peer.Paired.Address), netip.MustParseAddr(request.Peer.Paired.ClientAddress)
	if local != remote {
		t.Fatal("Darwin fixture requires captured same-host physical peer")
	}
	var forward *importedExecutionForward
	peer := desktopNodeChainImportedPeerStartWithHooks(t, request.Peer, local, remote, nil, &desktopNodeChainImportedPeerHooks{
		decorate: func(original *desktopNodeWGHandler) tun.Handler {
			forward = &importedExecutionForward{desktopNodeWGHandler: original}
			return forward
		},
		middle: func(owner *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
			return desktopStartSSProvider(t, owner, request.Peer.MiddleMethod, request.Peer.MiddlePassword, local)
		},
	})
	endpoint := peer.provider.address
	forward.middle.Store(&endpoint)
	endpointHost, endpointPort, endpointErr := net.SplitHostPort(endpoint)
	endpointNumber, numberErr := strconv.Atoi(endpointPort)
	if endpointErr != nil || numberErr != nil || endpointHost != local.String() {
		t.Fatal("original bound imported endpoint changed")
	}
	// Construction occurs before the first reply or any client launch. There is
	// no live map mutation: only the exact original provider tuple is added.
	for _, network := range []string{"tcp", "udp"} {
		forward.rules[network+"/"+endpoint] = desktopReferenceRule{Network: network, Address: endpointHost, Port: endpointNumber, Target: endpoint}
	}
	send := func(value any) {
		if json.NewEncoder(os.Stdout).Encode(value) != nil {
			t.Fatal("original imported execution output closed")
		}
	}
	send(map[string]any{"peer": peer.snapshot(), "middle_address": endpoint})
	var configure struct {
		LocalSource string `json:"local_source"`
		Winner      string `json:"winner"`
	}
	if importedExecutionRead(reader, mobilemultihop.NodeChainInputLimit, &configure) != nil {
		t.Fatal("missing original complete local source")
	}
	chain, err := mobilemultihop.NewNodeChain(configure.LocalSource)
	var source mobilemultihop.NodeChainSource
	if err != nil || json.Unmarshal([]byte(configure.LocalSource), &source) != nil || source.Schema != 2 || len(source.Nodes) != 3 || len(source.IdentitySources) != 3 {
		t.Fatal("original literal trio source refused", err)
	}
	proofs := chain.ProofInventory()
	first := request.Peer.Paired.Prefixes[0]
	tag, _, err := chain.PublicMeasurementCapture()
	if err != nil || len(proofs) != 3 || proofs[0].NodeID != first.NodeProofID || proofs[2].NodeID != request.Peer.Paired.FinalNodeProofID || tag != proofs[1].Tag {
		t.Fatal("imported/final identity separation lost", err)
	}
	var imported struct {
		Config  string `json:"config"`
		Capture string `json:"capture"`
	}
	var selected struct {
		ExpectedPublicIP string `json:"expected_public_ip"`
		Profile          struct {
			External struct {
				Shadowsocks struct {
					Server   string `json:"server"`
					Port     int    `json:"port"`
					Method   string `json:"method"`
					Password string `json:"password"`
				} `json:"shadowsocks"`
			} `json:"external"`
		} `json:"profile"`
	}
	if json.Unmarshal([]byte(source.Nodes[1]), &imported) != nil || json.Unmarshal([]byte(imported.Capture), &selected) != nil {
		t.Fatal("original imported source envelope changed")
	}
	ss := selected.Profile.External.Shadowsocks
	if selected.ExpectedPublicIP != "203.0.113.88" || ss.Method != request.Peer.MiddleMethod || ss.Password != request.Peer.MiddlePassword || net.JoinHostPort(ss.Server, strconv.Itoa(ss.Port)) != endpoint {
		t.Fatal("source changed original imported endpoint/credential/public identity")
	}
	suffix := mobilemultihop.NodeChainServerSource{Schema: 2, EntryID: proofs[0].ProfileID, EntryNodeID: proofs[0].NodeID, EntryMode: proofs[0].Mode, Nodes: source.Nodes[1:], IdentitySources: source.IdentitySources[1:]}
	suffixRaw, _ := json.Marshal(suffix)
	policy, err := mobilemultihop.NewNodeChainServerPolicy(string(suffixRaw))
	if err != nil || policy.NativeCarrierRequired() {
		t.Fatal("portable suffix authority refused", err)
	}
	runtimeDir := t.TempDir()
	if os.Chmod(runtimeDir, 0700) != nil {
		t.Fatal("private worker root unavailable")
	}
	runner := &importedExecutionRunner{policy: policy, image: request.Image, imageSHA: digest, imageInfo: info, runtime: runtimeDir}
	manager, err := multihoprelay.New(multihoprelay.Config{ListenIP: "10.78.0.1", FirstPort: 28440, LastPort: 28447, TTLSeconds: 300, NodeChains: []multihoprelay.NodeChainDescriptor{policy.Descriptor()}}, first.NodeProofID, runner)
	if err != nil {
		t.Fatal(err)
	}
	admin := &importedExecutionAdmin{relay: manager, token: first.APIToken}
	admin.cfg.NodeID = first.NodeProofID
	health := peer.paired.entry.rules["tcp/10.78.0.1:8787"].Target
	original, _ := url.Parse("http://" + health)
	proxy := httputil.NewSingleHostReverseProxy(original)
	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if _, err := admin.authorized(r); err != nil {
			http.Error(w, "original peer refused", 403)
			return
		}
		if r.URL.Path == "/api/multihop/chain/lease" {
			admin.multihopNodeChainLease(w, r)
			return
		}
		proxy.ServeHTTP(w, r)
	})
	listener, err := net.Listen("tcp4", "10.78.0.1:8787")
	if err != nil {
		t.Fatal(err)
	}
	server := &http.Server{Handler: handler, ReadHeaderTimeout: 2 * time.Second}
	done := make(chan struct{})
	var serveError error
	go func() { serveError = server.Serve(listener); close(done) }()
	closed := false
	closeAll := func() error {
		ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
		defer cancel()
		if err := manager.Close(ctx); err != nil {
			return err
		}
		if !runner.joined() {
			return errors.New("original relay workers did not join")
		}
		if err := server.Shutdown(ctx); err != nil {
			return err
		}
		if err := importedExecutionJoinHTTP(ctx, done, &serveError); err != nil {
			return err
		}
		closed = true
		return nil
	}
	t.Cleanup(func() {
		if !closed {
			if err := closeAll(); err != nil {
				t.Error(err)
			}
		}
	})
	switch configure.Winner {
	case "server":
		forward.localDelay.Store(int64(75 * time.Millisecond))
	case "local":
		forward.serverDelay.Store(int64(75 * time.Millisecond))
	case "":
	default:
		t.Fatal("unknown captured comparison timing arm")
	}
	send(map[string]any{"ready": true, "source_sha256": policy.Descriptor().SourceSHA256})
	for {
		var control struct {
			Command string `json:"command"`
		}
		if err := importedExecutionRead(reader, 128, &control); err != nil {
			t.Fatal(err)
		}
		if control.Command == "quit" {
			if err := closeAll(); err != nil {
				t.Fatal(err)
			}
			send(map[string]any{"joined": true, "launches": runner.launches.Load()})
			return
		}
		if control.Command != "stats" {
			if err := peer.control(control.Command); err != nil {
				t.Fatal(err)
			}
		}
		send(map[string]any{"peer": peer.snapshot(), "launches": runner.launches.Load(), "workers_joined": runner.joined()})
	}
}
