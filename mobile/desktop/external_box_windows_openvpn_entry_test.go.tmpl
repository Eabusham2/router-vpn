// The independent provider forwards this private packet destination only after
// OpenVPN authentication. The final then decrypts its own SS2022 TCP and UDP.
func desktopExternalWFPOpenVPNEntryOriginal(t *testing.T, profile nativeopenvpn.Profile, kill, password string) (*mobilemultihop.ExternalPolicy, string, string) {
	t.Helper()
	_, source, capture := desktopExternalWFPOpenVPNOriginal(t, profile, kill)
	var graph, saved map[string]any
	if json.Unmarshal([]byte(source), &graph) != nil || json.Unmarshal([]byte(capture), &saved) != nil {
		t.Fatal("OpenVPN entry lost original source capture")
	}
	selected := saved["profile"].(map[string]any)
	entry := map[string]any{"id": "selected-openvpn-entry", "node_kind": "external", "external": selected["external"], "mtu_policy": "fixed", "manual_mtu": 1500}
	selected["external"] = map[string]any{"protocol": "shadowsocks", "expected_public_ip": desktopExternalIntegrationIP,
		"shadowsocks": map[string]any{"server": "203.0.113.55", "port": 8388, "method": "2022-blake3-aes-256-gcm", "password": password}}
	saved["protocol"], saved["entry"], saved["entry_tag"] = "shadowsocks", entry, "external-entry"
	graph["endpoints"].([]any)[0].(map[string]any)["tag"] = "external-entry"
	graph["outbounds"] = []any{map[string]any{"type": "shadowsocks", "tag": mobilemultihop.ExternalFinalTag, "server": "203.0.113.55", "server_port": 8388,
		"method": "2022-blake3-aes-256-gcm", "password": password, "detour": "external-entry"}}
	raw, _ := json.Marshal(graph)
	retained, _ := json.Marshal(saved)
	original, err := mobilemultihop.NewExternalPolicy(string(raw), string(retained))
	if err != nil {
		t.Fatal(err)
	}
	return original, string(raw), string(retained)
}

func desktopExternalWFPOpenVPNEntryEndpoint(t *testing.T, f *desktopExternalWFPFixture) *OVPN.ClientEndpoint {
	t.Helper()
	value, ok := f.box.endpoint.Get("external-entry")
	endpoint, typed := value.(*OVPN.ClientEndpoint)
	if !ok || !typed {
		t.Fatal("OpenVPN entry lost its original native endpoint")
	}
	return endpoint
}

func desktopExternalWFPOpenVPNEntryReceipt(t *testing.T, f *desktopExternalWFPFixture, remotes []nativeopenvpn.Remote) nativeopenvpn.PacketObservation {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	remote, capacity, err := desktopExternalWFPOpenVPNEntryEndpoint(t, f).RouterVPNConnectedCapacityContext(ctx)
	state := nativeopenvpn.PacketObservation{Remote: remote, MTU: capacity}
	var graph map[string]any
	if json.Unmarshal([]byte(f.source), &graph) != nil {
		t.Fatal("OpenVPN entry lost original source")
	}
	capture, captureErr := f.original.DesktopCapture()
	if err != nil || captureErr != nil || state.Validate() != nil || state.MTU < uint32(capture.EntryMTU) || len(remotes) != 1 || remote.Remote != remotes[0] || !remote.Matches(graph["endpoints"].([]any)[0].(map[string]any)) {
		t.Fatal("OpenVPN entry changed captured connected generation or capacity", err)
	}
	return state
}

func desktopExternalWFPOpenVPNEntryProve(t *testing.T, f *desktopExternalWFPFixture, peer *desktopOpenVPNCompositionProcess, alias *desktopExternalWindowsAlias, remotes []nativeopenvpn.Remote) nativeopenvpn.PacketObservation {
	t.Helper()
	raw, err := f.proof.Run()
	var result mobilemultihop.ExternalProofResult
	meta := f.policy.Metadata()
	if err != nil || json.Unmarshal([]byte(raw), &result) != nil || result.SessionID != meta.SessionID || result.SourceSHA256 != meta.OriginalSourceSHA256 || result.ConfigSHA256 != meta.OriginalConfigSHA256 || !result.EntryProven || result.EntryID != "selected-openvpn-entry" || result.EntryNodeID != "" || !result.DNSProven || result.IP != desktopExternalIntegrationIP || !f.proof.Healthy() || !f.network.Current() {
		t.Fatal("actual OpenVPN entry/final proof lost original native ownership", err)
	}
	stats := peer.observe(t, "stats")
	if stats.DNS == 0 || stats.PublicRequests != 2 || stats.PublicAttempts != 2 || stats.TLS != 2 {
		t.Fatal("OpenVPN entry and independent SS2022 final omitted encrypted DNS/public proof", stats)
	}
	desktopExternalWFPOpenVPNSnapshot(t, f, alias, remotes)
	if err := f.proof.VerifyCurrentPath(); err != nil {
		t.Fatal(err)
	}
	return desktopExternalWFPOpenVPNEntryReceipt(t, f, remotes)
}

func TestRouterVPNDesktopExternalWindowsOpenVPNEntryWFP(t *testing.T) {
	ca := newDesktopExternalIntegrationCA(t)
	roots := x509.NewCertPool()
	certificate, err := x509.ParseCertificate(ca.der)
	if err != nil {
		t.Fatal(err)
	}
	roots.AddCert(certificate)
	t.Setenv("GODEBUG", os.Getenv("GODEBUG")+",x509usefallbackroots=1")
	x509.SetFallbackRoots(roots)
	alias := desktopExternalCreateAlias(t)
	for _, network := range []string{"tcp", "udp"} {
		t.Run(network, func(t *testing.T) {
			for _, name := range []string{"off", "on-connect", "always", "successor-and-original-restore", "reconnect-rejects-proof", "reject/entry-key", "reject/final-key", "reject/dns", "foreign-predecessor", "commit-refused"} {
				if name == "off" && network != "tcp" {
					continue
				}
				t.Run(name, func(t *testing.T) {
					var retained mobiletor.DesktopWindowsProtectionTarget
					desktopExternalWFPCleanup(t, &retained)
					pki := desktopOpenVPNCompositionCertificates(t)
					public, key := desktopExternalWFPCertificate(t, ca.certificate(t, true))
					fault := ""
					if name == "reject/dns" {
						fault = "dns"
					}
					peer := desktopExternalWFPOpenVPNPeer(t, alias, desktopOpenVPNCompositionPeerInput{Schema: 1, Network: network, Control: "tls-auth", ControlKey: desktopOpenVPNCompositionControlKey(), CA: pki.ca, Certificate: pki.provider, Key: pki.providerKey, PublicCertificate: string(public), PublicKey: string(key), Fault: fault, SS2022Final: true})
					clear(key)
					remote, err := nativeopenvpn.ParseRemote(peer.initial.Remote, network)
					if err != nil {
						t.Fatal(err)
					}
					remotes := []nativeopenvpn.Remote{remote}
					profileFault := ""
					if name == "reject/entry-key" {
						profileFault = "wrong-control-key"
					}
					profile := desktopOpenVPNCompositionProfile(pki, remotes, "tls-auth", profileFault)
					kill := "always"
					if name == "off" || name == "on-connect" {
						kill = name
					}
					passwordByte := byte(7)
					if name == "reject/final-key" {
						passwordByte = 8
					}
					original, source, capture := desktopExternalWFPOpenVPNEntryOriginal(t, profile, kill, base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{passwordByte}, 32)))
					if name == "foreign-predecessor" {
						first := desktopExternalWFPBox(t, original, source, capture, nil, false)
						first.start(t)
						desktopExternalWFPOpenVPNEntryProve(t, first, peer, alias, remotes)
						retained = first.drain(t)
						foreign := retained
						foreign.Capture.SourceSHA256 = strings.Repeat("f", 64)
						next := desktopExternalWFPBox(t, original, source, capture, &foreign, false)
						if err := next.box.RouterVPNStrategyStart(); err == nil || next.admitted != 0 || next.network.Current() {
							t.Fatal("OpenVPN entry adopted foreign predecessor")
						}
						return
					}
					f := desktopExternalWFPBox(t, original, source, capture, nil, name == "commit-refused")
					if name == "commit-refused" {
						if err := f.box.RouterVPNStrategyStart(); err == nil || !strings.Contains(err.Error(), "controlled original journal refuses durable intent") || f.admitted != 0 || f.network.SocketCurrent() {
							t.Fatal("OpenVPN entry bypassed durable barrier", err)
						}
						return
					}
					f.start(t)
					if strings.HasPrefix(name, "reject/") {
						ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
						defer cancel()
						if _, err := f.proof.RunContext(ctx, nil); err == nil || f.proof.Healthy() {
							t.Fatal("failed OpenVPN entry/final acquired completed proof")
						}
						stats := peer.observe(t, "stats")
						wantPublic := int32(1)
						if name == "reject/entry-key" {
							wantPublic = 0
						}
						if stats.PublicRequests != wantPublic || name == "reject/final-key" && stats.DNS != 0 {
							t.Fatal("OpenVPN composition bypassed independent entry/final authentication", stats)
						}
						if lease, err := f.box.RouterVPNExternalClaimMTU(f.proof, source, capture); err == nil || lease != nil {
							t.Fatal("failed composed proof acquired MTU authority")
						}
						retained = f.drain(t)
						return
					}
					connected := desktopExternalWFPOpenVPNEntryProve(t, f, peer, alias, remotes)
					if name == "off" || name == "on-connect" {
						desktopExternalWFPOpenVPNEntryMeasurements(t, f, peer, alias, remotes, connected)
					}
					if name == "reconnect-rejects-proof" {
						endpoint := desktopExternalWFPOpenVPNEntryEndpoint(t, f)
						endpoint.InterfaceUpdated(context.Background())
						ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
						defer cancel()
						for {
							current, capacity, err := endpoint.RouterVPNConnectedCapacityContext(ctx)
							if err == nil && current.Generation != connected.Remote.Generation && capacity >= connected.MTU {
								break
							}
							if ctx.Err() != nil || err != nil && !errors.Is(err, nativeopenvpn.ErrRemotePending) {
								t.Fatal("OpenVPN entry did not reach a new connected generation", err)
							}
							time.Sleep(20 * time.Millisecond)
						}
						if f.proof.VerifyCurrentPath() == nil || f.proof.Healthy() {
							t.Fatal("OpenVPN entry replacement reused original connected proof")
						}
					}
					oracle := desktopExternalWFPStartReference(t, ca, "")
					f.requireHostPolicy(t, oracle)
					retained = f.drain(t)
					f.requireHostPolicy(t, oracle)
					if name == "successor-and-original-restore" {
						for i := 0; i < 2; i++ {
							previous := retained
							next := desktopExternalWFPBox(t, original, source, capture, &previous, false)
							next.start(t)
							// Provider counters are cumulative across the owned successors.
							before := peer.observe(t, "stats")
							raw, err := next.proof.Run()
							var proof mobilemultihop.ExternalProofResult
							after := peer.observe(t, "stats")
							if err != nil || json.Unmarshal([]byte(raw), &proof) != nil || !proof.EntryProven || !proof.DNSProven || after.PublicRequests != before.PublicRequests+2 || next.original != original || next.source != source || next.capture != capture || next.prepared.Capture.SessionID == previous.Capture.SessionID || !reflect.DeepEqual(next.commit.Previous, &previous) || f.proof.Healthy() || f.network.Current() {
								t.Fatal("OpenVPN entry restore changed original pair or predecessor", err)
							}
							desktopExternalWFPOpenVPNEntryReceipt(t, next, remotes)
							desktopExternalWFPOpenVPNSnapshot(t, next, alias, remotes)
							retained = next.drain(t)
						}
					}
				})
			}
		})
	}
}
func desktopExternalWFPOpenVPNEntryMeasurements(t *testing.T, f *desktopExternalWFPFixture, p *desktopOpenVPNCompositionProcess, a *desktopExternalWindowsAlias, remotes []nativeopenvpn.Remote, connected nativeopenvpn.PacketObservation) {
	t.Helper()
	lease, err := f.box.RouterVPNExternalClaimMTU(f.proof, f.source, f.capture)
	if err != nil {
		t.Fatal(err)
	}
	defer lease.Close()
	name, index, mtu, err := lease.ClaimDesktopTUN(f.proof.Healthy)
	if err != nil || name != f.tun.options.InterfaceName || index != f.tun.index || mtu != 1280 {
		t.Fatal("OpenVPN MTU claim lost actual original Wintun", err)
	}
	original, err := lease.Inbound()
	if err != nil {
		t.Fatal(err)
	}
	var candidate, rollback *desktopExternalWFPOpenVPNTUNCandidate
	current, err := lease.changeMTU(context.Background(), original, 1400, desktopExternalWFPOpenVPNReplace(f, nil, &candidate, &rollback))
	if err != nil || current != candidate || current == original {
		t.Fatal("OpenVPN native Wintun MTU replacement failed", err)
	}
	f.tun = candidate.desktopExternalWFPTUN
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	returned, err := lease.changeMTU(ctx, current, 1500, desktopExternalWFPOpenVPNReplace(f, func(stage adapter.StartStage) {
		if stage == adapter.StartStateStarted {
			cancel()
		}
	}, &candidate, &rollback))
	if err == nil || returned != rollback || returned == current || returned == candidate {
		t.Fatal("OpenVPN cancelled Wintun MTU replacement lost original rollback", err)
	}
	f.tun = rollback.desktopExternalWFPTUN
	name, index, mtu, err = lease.ClaimDesktopTUN(f.proof.Healthy)
	if err != nil || name != f.tun.options.InterfaceName || index != f.tun.index || mtu != 1400 || !lease.Healthy() || !f.network.Current() {
		t.Fatal("OpenVPN MTU rollback lost actual current Wintun", err)
	}
	called := false
	if _, err := lease.changeMTU(context.Background(), original, 1450, func(context.Context, adapter.Inbound, int) (adapter.Inbound, error) { called = true; return nil, nil }); err == nil || called {
		t.Fatal("retired OpenVPN Wintun changed its successor")
	}
	if err := f.proof.engine.DNSProof(context.Background(), "tun-in"); err != nil {
		t.Fatal("OpenVPN native MTU rollback lost selected DNS", err)
	}
	if err := mobilemultihop.ProveExternalPublicIP(context.Background(), f.proof.engine.Dial, mobilemultihop.ExternalFinalTag, desktopExternalIntegrationIP); err != nil {
		t.Fatal("OpenVPN native MTU rollback lost encrypted public proof", err)
	}
	if desktopExternalWFPOpenVPNEntryReceipt(t, f, remotes) != connected || p.observe(t, "stats").PublicRequests != 3 {
		t.Fatal("OpenVPN MTU rollback changed native provider generation")
	}

	service, err := f.box.RouterVPNExternalHopMeasurement(f.proof, f.source, f.capture, f.policy.Metadata().SessionID, f.proof.Healthy)
	if err != nil {
		t.Fatal(err)
	}
	defer service.Close()
	dns, err := f.box.RouterVPNExternalDNSMeasurement(f.proof, f.source, f.capture, f.policy.Metadata().SessionID, f.proof.Healthy)
	if err != nil {
		t.Fatal(err)
	}
	defer dns.Close()
	if err := service.StartLatency(strings.Repeat("b", 32), "selected-external-native"); err != nil {
		t.Fatal(err)
	}
	status := desktopExternalLatencyStatus(t, service)
	if status.Stage != "complete" || len(status.Results) != 1 || !status.Results[0].Ready || status.Results[0].Benchmark == nil {
		t.Fatal("OpenVPN native 50-sample benchmark failed", status)
	}
	b := status.Results[0].Benchmark
	stats := p.observe(t, "stats")
	if b.Attempts != 50 || b.Failed != 0 || b.Distribution == nil || b.Distribution.Samples != 50 || b.TrimmedMean <= 0 || stats.LatencyRequests != 50 || stats.LatencyTLS != 50 || stats.LatencyDNS < 1 || desktopExternalWFPOpenVPNEntryReceipt(t, f, remotes) != connected {
		t.Fatal("OpenVPN benchmark changed encrypted transport or missed actual TLS samples", b, stats)
	}
	if err := service.StartLatency(strings.Repeat("b", 32), "selected-external-native"); err == nil {
		t.Fatal("OpenVPN accepted replayed latency request")
	}
	desktopExternalWFPOpenVPNSnapshot(t, f, a, remotes)
}
