func TestRouterVPNDesktopOrdinaryFiftyOperationSchema(t *testing.T) {
	old := routerVPNNodeChainMeasurementRequest{Schema: 1, Bytes: 65536}
	if !old.validOperation() {
		t.Fatal("original throughput refused")
	}
	for position := 0; position < 8; position++ {
		r := routerVPNNodeChainMeasurementRequest{Schema: 2, Operation: "ordered-latency-50", NodeID: "captured", Position: position}
		if !r.validOperation() {
			t.Fatal("ordinary position refused", position)
		}
		r.Bytes = 65536
		if r.validOperation() {
			t.Fatal("fifty borrowed throughput bytes")
		}
	}
	for _, position := range []int{-1, 8} {
		if (routerVPNNodeChainMeasurementRequest{Schema: 2, Operation: "ordered-latency-50", NodeID: "captured", Position: position}).validOperation() {
			t.Fatal("foreign position admitted")
		}
	}
	for _, raw := range []string{`{"schema":1,"bytes":65536,"operation":""}`, `{"schema":1,"bytes":65536,"node_id":""}`, `{"schema":1,"bytes":65536,"position":0}`} {
		if old.validOperationJSON([]byte(raw)) {
			t.Fatal("old schema borrowed fifty fields")
		}
	}
}

// Shipping child polling, original captured service, real HTTP50 and saved
// receipt execute together; this is distinct from encrypted native acceptance.
func TestRouterVPNDesktopOrdinaryFiftyHTTPComposition(t *testing.T) {
	if os.Getenv("ROUTERVPN_ORDINARY_FIFTY_HTTP_CHILD") != "1" {
		image, err := os.Executable()
		if err != nil {
			t.Fatal(err)
		}
		ctx, cancel := context.WithTimeout(t.Context(), 45*time.Second)
		defer cancel()
		command := exec.CommandContext(ctx, image, "-test.run=^TestRouterVPNDesktopOrdinaryFiftyHTTPComposition$", "-test.timeout=40s")
		command.Env = append(os.Environ(), "ROUTERVPN_ORDINARY_FIFTY_HTTP_CHILD=1")
		if out, err := command.CombinedOutput(); err != nil {
			t.Fatalf("ordinary50 HTTP mailbox: %v\n%s", err, out)
		}
		return
	}
	f := desktopNodeChainHTTPMeasurementFixture(t, nil)
	_, meta, _, err := f.runtime.policy.ReadValidated()
	if err != nil {
		t.Fatal(err)
	}
	for position, node := range meta.Prefixes {
		request := routerVPNNodeChainMeasurementRequest{Schema: 2, Operation: "ordered-latency-50", NodeID: node.ProfileID, Position: position, Request: fmt.Sprintf("%032x", position+1), Generation: uint64(position + 1), Deadline: time.Now().Add(30 * time.Second).UnixMilli(), Path: f.mtu.record.Path, Capture: f.ready(t)}
		raw, _ := json.Marshal(request)
		if err := os.WriteFile(filepath.Join(f.runtime.files.root.Name(), "node-chain-measure-request.json"), raw, 0600); err != nil {
			t.Fatal(err)
		}
		deadline := time.Now().Add(30 * time.Second)
		for {
			if err := f.runtime.pollMeasurement(t.Context()); err != nil {
				t.Fatal("ordinary50 mailbox", err)
			}
			if err := f.runtime.heartbeat(t.Context(), f.mtu.record); err != nil {
				t.Fatal("ordinary50 blocked heartbeat", err)
			}
			if f.runtime.measurement == nil {
				break
			}
			if time.Now().After(deadline) {
				t.Fatal("ordinary50 child did not drain")
			}
			time.Sleep(5 * time.Millisecond)
		}
		raw, err = f.runtime.files.read("node-chain-measure-result.json", 128<<10)
		if err != nil {
			t.Fatal(err)
		}
		var result routerVPNNodeChainMeasurementResult
		if json.Unmarshal(raw, &result) != nil || result.routerVPNNodeChainMeasurementRequest != request || !result.Status.Complete || !result.Status.Drained || result.Status.Failure != "" || len(result.Status.Results) != 1 || result.Saved == nil || result.Saved.Position != position || result.Saved.NodeID != node.ProfileID || result.Saved.SourceSHA256 != meta.OriginalSourceSHA256 || result.Saved.ConfigSHA256 != meta.ConfigSHA256 || f.runtime.measurementHold.Load() {
			t.Fatalf("ordinary50 child receipt lost capture: %s", raw)
		}
		row := result.Status.Results[0]
		if !row.Ready || row.Kind != "private-node" || row.Benchmark == nil || row.Benchmark.Attempts != 50 || row.Benchmark.Distribution == nil || row.Benchmark.Distribution.Samples != 50 || row.Download != nil || row.Upload != nil {
			t.Fatal("ordinary50 child mislabeled throughput", row)
		}
	}
}

func TestRouterVPNDesktopTypedLocalFiftyOriginalPositions(t *testing.T) {
	for _, count := range []int{9, 16} {
		t.Run(fmt.Sprintf("paired-%d", count), func(t *testing.T) {
			policy := desktopNodeChainCommandPolicyWithIdentity(t, count, "linux", 1280, true)
			chain := policy.OriginalChain()
			position := count - 2
			if position < mobilemultihop.NodeChainMaximumNodes {
				position = count - 1
			}
			request := routerVPNNodeChainMeasurementRequest{Schema: 2, Operation: "ordered-latency-50", NodeID: chain.ProofInventory()[position].ProfileID, Position: position}
			if request.validOperation() || !request.validOperationForChain(chain) {
				t.Fatal("late private row lost its original sealed path")
			}
			for _, fault := range []string{"samples", "node", "position"} {
				bad := request
				switch fault {
				case "samples":
					bad.Samples = 1
				case "node":
					bad.NodeID = chain.ProofInventory()[0].ProfileID
				case "position":
					bad.Position = count
				}
				if bad.validOperationForChain(chain) {
					t.Fatal("late fifty mailbox accepted changed original request", fault)
				}
			}
		})
	}
	for _, family := range []string{"socks", "http", "https"} {
		for _, count := range []int{4, 8} {
			t.Run(fmt.Sprintf("%s-%d", family, count), func(t *testing.T) {
				raw, err := json.Marshal(desktopTypedCandidateSource(t, family, count))
				if err != nil {
					t.Fatal(err)
				}
				var proofs []mobilemultihop.NodeChainProof
				var valid func(int, string) bool
				if family == "socks" {
					original, err := mobilemultihop.NewNodeChainSOCKSSource(string(raw))
					if err != nil {
						t.Fatal(err)
					}
					policy, err := mobilemultihop.NewDesktopNodeChainSOCKSPolicy(original, desktopExternalSession, "linux", 0)
					if err != nil {
						t.Fatal(err)
					}
					_, meta, _, err := policy.ReadValidated()
					if err != nil {
						t.Fatal(err)
					}
					proofs = meta.Prefixes
					valid = func(pos int, id string) bool {
						return (routerVPNDesktopSOCKSMeasurementRequest{Schema: 2, Operation: "ordered-latency-50", NodeID: id, Position: pos}).validOperationForPolicy(policy)
					}
				} else {
					original, err := mobilemultihop.NewNodeChainCONNECTSource(string(raw))
					if err != nil {
						t.Fatal(err)
					}
					policy, err := mobilemultihop.NewDesktopNodeChainCONNECTPolicy(original, desktopExternalSession, "linux", 0)
					if err != nil {
						t.Fatal(err)
					}
					_, meta, _, err := policy.ReadValidated()
					if err != nil {
						t.Fatal(err)
					}
					proofs = meta.Prefixes
					valid = func(pos int, id string) bool {
						return (routerVPNDesktopCONNECTMeasurementRequest{Schema: 2, Operation: "ordered-latency-50", NodeID: id, Position: pos}).validOperationForPolicy(policy)
					}
				}
				for pos := 3; pos < count; pos++ {
					if !valid(pos, proofs[pos].ProfileID) || valid(pos, "foreign") {
						t.Fatal("typed policy lost original member", pos)
					}
				}
				if valid(count, "foreign") {
					t.Fatal("typed policy accepted extra member")
				}
			})
		}
	}
}

func TestRouterVPNDesktopOrdinaryPrivateResponse(t *testing.T) {
	if os.Getenv("ROUTERVPN_PRIVATE_RESPONSE_CHILD") != "1" {
		image, err := os.Executable()
		if err != nil {
			t.Fatal(err)
		}
		ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
		defer cancel()
		cmd := exec.CommandContext(ctx, image, "-test.run=^TestRouterVPNDesktopOrdinaryPrivateResponse$", "-test.timeout=25s")
		cmd.Env = append(os.Environ(), "ROUTERVPN_PRIVATE_RESPONSE_CHILD=1")
		if out, err := cmd.CombinedOutput(); err != nil {
			t.Fatalf("original private mailbox: %v\n%s", err, out)
		}
		return
	}
	f := desktopNodeChainHTTPMeasurementFixture(t, nil)
	_, meta, _, err := f.runtime.policy.ReadValidated()
	if err != nil {
		t.Fatal(err)
	}
	request := routerVPNNodeChainMeasurementRequest{Schema: 3, Operation: "ordered-private-response", Samples: 3,
		Request: fmt.Sprintf("%032x", 91), Generation: 1, Deadline: time.Now().Add(9 * time.Second).UnixMilli(), Path: f.mtu.record.Path, Capture: f.ready(t)}
	raw, err := json.Marshal(request)
	if err != nil {
		t.Fatal(err)
	}
	if err := f.runtime.files.root.WriteFile("node-chain-measure-request.json", raw, 0600); err != nil {
		t.Fatal(err)
	}
	for {
		if err := f.runtime.pollMeasurement(t.Context()); err != nil {
			t.Fatal("retained private mailbox", err)
		}
		if err := f.runtime.heartbeat(t.Context(), f.mtu.record); err != nil {
			t.Fatal(err)
		}
		if f.runtime.measurement == nil {
			break
		}
		if time.Now().UnixMilli() > request.Deadline {
			t.Fatal("live response exceeded the original operation deadline")
		}
		time.Sleep(5 * time.Millisecond)
	}
	raw, err = f.runtime.files.read("node-chain-measure-result.json", 128<<10)
	var result routerVPNNodeChainMeasurementResult
	if err != nil || !routerVPNMTUStrict(raw, &result) || result.routerVPNNodeChainMeasurementRequest != request || result.Saved != nil || result.Status.Failure != "" || !result.Status.Complete || !result.Status.Drained || f.runtime.measurementHold.Load() || len(result.Status.Results) != 2 {
		t.Fatal("lost joined private receipt", err, result.Status)
	}
	for i, position := range []int{0, len(meta.Prefixes) - 1} {
		row := result.Status.Results[i]
		if row.ID != meta.Prefixes[position].ProfileID || !row.Ready || row.Response == nil || row.Response.Measurement != "routed-private-response-including-connection" || row.Response.Distribution == nil || row.Response.Distribution.Samples != 3 || row.Response.Distribution.Min <= 0 || row.Benchmark != nil || row.Download != nil || row.Upload != nil {
			t.Fatal("original live response was absent or relabeled", row)
		}
	}
}
