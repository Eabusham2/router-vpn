func TestRouterVPNImportedHTTPLayersNativeTraffic(t *testing.T) {
	desktopImportedCONNECTLayerTraffic(t, "http-connect")
}
func TestRouterVPNImportedHTTPSLayersNativeTraffic(t *testing.T) {
	desktopImportedCONNECTLayerTraffic(t, "https-connect")
}
func desktopImportedCONNECTLayerTraffic(t *testing.T, protocol string) {
	directory := os.Getenv("ROUTERVPN_CONNECT_LAYER_FIXTURES")
	if directory == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_ENTRY_FIXTURES") == "1" {
			t.Fatal("required CONNECT independent layer captures absent")
		}
		t.Skip("mandatory native gate supplies exact independent layer captures")
	}
	expected := map[string]bool{}
	for _, p := range []string{"http-connect", "https-connect"} {
		for _, entry := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, final := range []string{"plain", "off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				for _, dns := range []string{"home", "custom"} {
					expected[p+"--"+entry+"--"+final+"--"+dns+".json"] = true
				}
			}
		}
	}
	files, err := os.ReadDir(directory)
	if err != nil || len(files) != len(expected) {
		t.Fatal("incomplete CONNECT independent layer source matrix", err)
	}
	for _, file := range files {
		info, err := file.Info()
		if err != nil || !expected[file.Name()] || !info.Mode().IsRegular() || file.Type()&os.ModeSymlink != 0 || info.Size() <= 0 || info.Size() > 8<<20 {
			t.Fatal("foreign or unbounded CONNECT layer capture", err)
		}
		if !strings.HasPrefix(file.Name(), protocol+"--") {
			continue
		}
		label := strings.TrimSuffix(file.Name(), ".json")
		axes := strings.Split(label, "--")
		raw, err := os.ReadFile(filepath.Join(directory, file.Name()))
		var capture []string
		if err != nil || json.Unmarshal(raw, &capture) != nil || len(capture) != 9 {
			t.Fatal("incomplete CONNECT layer capture", err)
		}
		faults := []string{"success"}
		if axes[3] == "home" {
			faults = append(faults, "final-key")
			if axes[2] == "aes-256-gcm+xor-whitening" {
				faults = append(faults, "entry-auth", "entry-private", "entry-layer-key", "final-whitening", "final-route", "dns-route", "final-identity", "wrong-entry-ip", "cancel", "close-owner")
				if axes[1] == "aes-256-gcm+xor-whitening" {
					faults = append(faults, "entry-whitening")
				}
				if protocol == "https-connect" {
					faults = append(faults, "sni", "trust")
				}
			}
		}
		t.Run(label, func(t *testing.T) {
			for _, fault := range faults {
				t.Run(fault, func(t *testing.T) { desktopImportedCONNECTTraffic(t, protocol, label, fault, capture) })
			}
		})
	}
}

func TestRouterVPNImportedCONNECTNativeTraffic(t *testing.T) {
	for _, protocol := range []string{"http-connect", "https-connect"} {
		for _, method := range []string{"2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305"} {
			for _, policy := range []string{"home", "custom"} {
				label := protocol + "--" + method + "--" + policy
				faults := []string{"success"}
				if method == mobilemultihop.NativeStartLayerMethod && policy == "home" {
					faults = append(faults, "entry-auth", "entry-route", "final-key", "final-route", "dns-route", "final-identity", "wrong-entry-ip", "cancel", "close-owner", "mtu-refusal", "mtu-cancel", "mtu-successor")
					if protocol == "https-connect" {
						faults = append(faults, "sni", "trust")
					}
				}
				t.Run(label, func(t *testing.T) {
					for _, fault := range faults {
						t.Run(fault, func(t *testing.T) { desktopImportedCONNECTTraffic(t, protocol, label, fault) })
					}
				})
			}
		}
	}
}
func desktopImportedCONNECTTraffic(t *testing.T, protocol, label, fault string, layerCapture ...[]string) {
	t.Helper()
	var args []string
	if len(layerCapture) == 1 {
		args = append([]string(nil), layerCapture[0]...)
		if len(args) != 9 {
			t.Fatal("captured CONNECT layer inputs incomplete")
		}
		original, err := mobilemultihop.NewImportedEntry(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
		if err != nil || original.SourceSHA256() != args[7] || original.Config() != args[8] {
			t.Fatal("CONNECT reference lost original source receipt", err)
		}
	} else if len(layerCapture) == 0 {
		directory := os.Getenv("ROUTERVPN_IMPORTED_ENTRY_FIXTURES")
		if directory == "" {
			if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_ENTRY_FIXTURES") == "1" {
				t.Fatal("required CONNECT captures absent")
			}
			t.Skip("mandatory native gate supplies exact captures")
		}
		data, err := os.ReadFile(filepath.Join(directory, "connect--"+label+".json"))
		if err != nil || json.Unmarshal(data, &args) != nil || len(args) != 9 {
			t.Fatal("captured CONNECT sources incomplete", err)
		}
	} else {
		t.Fatal("multiple CONNECT layer owners")
	}
	proxyCert, proxyCA := desktopExternalInstalledPeerCertificate(t, false)
	if protocol == "https-connect" {
		var graph, capture map[string]any
		_ = json.Unmarshal([]byte(args[0]), &graph)
		_ = json.Unmarshal([]byte(args[1]), &capture)
		graph["outbounds"].([]any)[0].(map[string]any)["tls"].(map[string]any)["server_name"] = "captured-external.example"
		capture["profile"].(map[string]any)["external"].(map[string]any)["https_connect"].(map[string]any)["tls_server_name"] = "captured-external.example"
		raw, _ := json.Marshal(graph)
		args[0] = string(raw)
		raw, _ = json.Marshal(capture)
		args[1] = string(raw)
	}
	plan, err := mobilemultihop.NewImportedEntry(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
	if err != nil {
		t.Fatal(err)
	}
	var graph map[string]any
	_ = json.Unmarshal([]byte(plan.Config()), &graph)
	tagged := desktopImportedSOCKSGraph(graph)
	firstRaw, lastRaw := tagged["entry-wg"], tagged[mobilemultihop.LocalTag]
	var meta mobilemultihop.Metadata
	_ = json.Unmarshal([]byte(plan.Metadata()), &meta)
	configured := meta.TransportCapability == "uot-v2"
	layered := meta.EntryStartLayer != "" && meta.EntryStartLayer != "off"
	var entryOuter map[string]any
	if layered {
		entryOuter = tagged[firstRaw["detour"].(string)]
		if entryOuter == nil || entryOuter["detour"] != nil || entryOuter["password"] == lastRaw["password"] {
			t.Fatal("CONNECT reference lost independent wrapper")
		}
	}
	if (!configured && meta.TransportCapability != "tcp-only") || firstRaw["type"] != "http" || (!layered && firstRaw["detour"] != nil) || lastRaw["detour"] != "entry-wg" || (!configured && lastRaw["network"] != "tcp") || (configured && !reflect.DeepEqual(lastRaw["udp_over_tcp"], map[string]any{"enabled": true, "version": float64(2)})) {
		t.Fatal("captured CONNECT capability changed")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	paired := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path != "/health" || r.Header.Get("Authorization") != "Bearer "+meta.ExitToken {
			http.Error(w, "foreign", 403)
			return
		}
		id := meta.ExitNodeID
		if fault == "final-identity" {
			id = "foreign"
		}
		fmt.Fprintf(w, `{"ok":true,"node_id":%q,"proof":"router-vpn-private-agent-v1"}`, id)
	}))
	defer paired.Close()
	selected := graph["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)
	dnsNetwork, _ := selected["type"].(string)
	if (dnsNetwork != "tcp" && (!configured || dnsNetwork != "udp")) || selected["detour"] != "proxy" {
		t.Fatal("selected CONNECT resolver lost final owner")
	}
	var dnsListener net.Listener
	var dnsPacket net.PacketConn
	var dnsPhysical string
	if dnsNetwork == "udp" {
		dnsPacket, err = net.ListenPacket("udp4", "127.0.0.1:0")
		if err == nil {
			dnsPhysical = dnsPacket.LocalAddr().String()
		}
	} else {
		dnsListener, err = net.Listen("tcp4", "127.0.0.1:0")
		if err == nil {
			dnsPhysical = dnsListener.Addr().String()
		}
	}
	if err != nil {
		t.Fatal(err)
	}
	var dnsCalls atomic.Int64
	dnsServer := &dns.Server{Listener: dnsListener, PacketConn: dnsPacket, Net: dnsNetwork, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
		dnsCalls.Add(1)
		r := new(dns.Msg).SetReply(q)
		r.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 1}, A: net.ParseIP("93.184.216.34")}}
		_ = w.WriteMsg(r)
	})}
	dnsDone := make(chan error, 1)
	go func() { dnsDone <- dnsServer.ActivateAndServe() }()
	defer func() {
		_ = dnsServer.Shutdown()
		if dnsListener != nil {
			_ = dnsListener.Close()
		}
		if dnsPacket != nil {
			_ = dnsPacket.Close()
		}
		<-dnsDone
	}()
	dnsTarget := net.JoinHostPort(selected["server"].(string), fmt.Sprint(int(selected["server_port"].(float64))))
	finalCtx, finalCancel := context.WithCancel(ctx)
	finalServer := &desktopNodeLayerServer{ctx: finalCtx, cancel: finalCancel, connections: map[io.Closer]bool{}, routes: []desktopNodeLayerRoute{{Network: "tcp", Destination: "10.77.0.1:8787", Physical: paired.Listener.Addr().String()}, {Network: dnsNetwork, Destination: dnsTarget, Physical: dnsPhysical}}}
	if configured {
		finalServer.streamRouter = UOT.NewRouter(&desktopImportedCONNECTRouter{server: finalServer}, log.NewNOPFactory().Logger())
	}
	var finalWire func(net.Conn) net.Conn
	if lastRaw["type"] == "routervpn-aes-xor" {
		key := sha256.Sum256([]byte("router-vpn-xor-whitening-v1\x00" + lastRaw["password"].(string)))
		if fault == "final-whitening" {
			key[0] ^= 255
		}
		finalWire = func(c net.Conn) net.Conn { return &desktopSSLayerStream{Conn: c, key: key} }
	}
	final := desktopStartSSProviderTransport(t, finalServer, lastRaw["method"].(string), lastRaw["password"].(string), netip.MustParseAddr("127.0.0.1"), finalWire, nil)
	defer final.close()
	publicCert, publicCA := desktopExternalInstalledPeerCertificate(t, false)
	public := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Host != "1.1.1.1" || r.URL.Path != "/cdn-cgi/trace" {
			http.Error(w, "foreign", 403)
			return
		}
		ip := "203.0.113.88"
		if fault == "wrong-entry-ip" {
			ip = "203.0.113.89"
		}
		fmt.Fprintln(w, "ip="+ip)
	}))
	public.TLS = &tls.Config{Certificates: []tls.Certificate{publicCert}, MinVersion: tls.VersionTLS12}
	public.StartTLS()
	defer public.Close()
	entryCtx, entryCancel := context.WithCancel(ctx)
	entryServer := &desktopNodeLayerServer{ctx: entryCtx, cancel: entryCancel, connections: map[io.Closer]bool{}, routes: []desktopNodeLayerRoute{{Network: "tcp", Destination: desktopImportedSOCKSAddress(lastRaw), Physical: final.address}, {Network: "tcp", Destination: "1.1.1.1:443", Physical: public.Listener.Addr().String()}}}
	var tlsCert *tls.Certificate
	if protocol == "https-connect" {
		tlsCert = &proxyCert
	}
	entry := desktopStartImportedCONNECTPeer(t, entryServer, firstRaw["username"].(string), firstRaw["password"].(string), tlsCert, cancel, fault)
	defer entry.close()
	lower := &desktopImportedCONNECTLower{desktopSSReferenceLower: desktopSSReferenceLower{virtual: desktopImportedSOCKSAddress(firstRaw), original: entry.address}}
	var entryLayerPeer desktopExternalInstalledSSPeer
	if layered {
		failure := ""
		if fault == "entry-layer-key" {
			failure = "layer-key"
		}
		if fault == "entry-whitening" {
			failure = "whitening"
		}
		entryLayerPeer = desktopStartSSReferenceLayer(t, ctx, entry.address, desktopImportedSOCKSAddress(firstRaw), meta.EntryStartLayer, entryOuter["password"].(string), failure)
		defer entryLayerPeer.close()
		lower.virtual, lower.original = desktopImportedSOCKSAddress(entryOuter), entryLayerPeer.address
	}
	manager := &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}}
	owned := service.ContextWith[adapter.OutboundManager](ctx, manager)
	if fault == "trust" {
		_, proxyCA = desktopExternalInstalledPeerCertificate(t, false)
	}
	store, err := CERT.NewStore(owned, log.NewNOPFactory().Logger(), option.CertificateOptions{Store: "none", Certificate: []string{proxyCA}})
	if err != nil {
		t.Fatal(err)
	}
	defer store.Close()
	owned = service.ContextWith[adapter.CertificateStore](owned, store)
	if layered {
		tag := entryOuter["tag"].(string)
		manager.owners[tag] = desktopSSReferenceLayerClient(t, owned, tag, "captured-physical", entryOuter["server"].(string), uint16(entryOuter["server_port"].(float64)), meta.EntryStartLayer, entryOuter["password"].(string))
	} else {
		firstRaw["detour"] = "captured-physical"
	}
	if fault == "entry-auth" {
		firstRaw["password"] = "foreign-password"
	}
	if fault == "entry-route" || fault == "entry-private" {
		firstRaw["server"] = "192.0.2.99"
	}
	if fault == "sni" {
		firstRaw["tls"].(map[string]any)["server_name"] = "foreign.example"
	}
	var firstOptions option.HTTPOutboundOptions
	body, _ := json.Marshal(firstRaw)
	if err = json.Unmarshal(body, &firstOptions); err != nil {
		t.Fatal(err)
	}
	first, err := HTTP.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), "entry-wg", firstOptions)
	if err != nil {
		t.Fatal(err)
	}
	manager.owners["entry-wg"] = first
	if fault == "final-key" {
		lastRaw["password"] = desktopSSReferenceKey(lastRaw["method"].(string), 'z')
	}
	if fault == "final-route" {
		lastRaw["server"] = "192.0.2.99"
	}
	body, _ = json.Marshal(lastRaw)
	var last adapter.Outbound
	if lastRaw["type"] == "routervpn-aes-xor" {
		var options WH.Options
		if err = json.Unmarshal(body, &options); err != nil {
			t.Fatal(err)
		}
		last, err = WH.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), mobilemultihop.LocalTag, options)
	} else {
		var options option.ShadowsocksOutboundOptions
		if err = json.Unmarshal(body, &options); err != nil {
			t.Fatal(err)
		}
		last, err = SS.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), mobilemultihop.LocalTag, options)
	}
	if err != nil {
		t.Fatal(err)
	}
	defer last.(io.Closer).Close()
	// Selected TCP or UoT-carried UDP DNS traverses the actual encrypted final.
	roots := x509.NewCertPool()
	if !roots.AppendCertsFromPEM([]byte(publicCA)) {
		t.Fatal("public proof trust absent")
	}
	publicTransport := &http.Transport{Proxy: nil, DisableKeepAlives: true, TLSClientConfig: &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}, DialContext: func(c context.Context, n, a string) (net.Conn, error) {
		return first.DialContext(c, n, M.ParseSocksaddr(a))
	}}
	defer publicTransport.CloseIdleConnections()
	requestCtx, stop := context.WithTimeout(ctx, time.Second)
	request, _ := http.NewRequestWithContext(requestCtx, "GET", "https://1.1.1.1/cdn-cgi/trace", nil)
	response, proofErr := (&http.Client{Transport: publicTransport}).Do(request)
	entryOK := false
	if proofErr == nil {
		raw, e := io.ReadAll(io.LimitReader(response.Body, 1024))
		_ = response.Body.Close()
		entryOK = e == nil && strings.TrimSpace(string(raw)) == "ip=203.0.113.88"
	}
	stop()
	publicTransport.CloseIdleConnections()
	entryBlocked := fault == "entry-auth" || fault == "entry-route" || fault == "entry-private" || fault == "entry-layer-key" || fault == "entry-whitening" || fault == "sni" || fault == "trust" || fault == "cancel"
	if entryOK != (!entryBlocked && fault != "wrong-entry-ip") {
		t.Fatal("CONNECT public proof changed", fault, proofErr)
	}
	if fault == "cancel" && !errors.Is(proofErr, context.Canceled) {
		t.Fatal("original cancellation lost", proofErr)
	}
	if fault == "close-owner" {
		entry.close()
	}
	finalBlocked := entryBlocked || fault == "final-route" || fault == "final-key" || fault == "final-whitening" || fault == "close-owner"
	transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, DialContext: func(c context.Context, n, a string) (net.Conn, error) {
		return last.DialContext(c, n, M.ParseSocksaddr(a))
	}}
	defer transport.CloseIdleConnections()
	requestCtx, stop = context.WithTimeout(ctx, 300*time.Millisecond)
	request, _ = http.NewRequestWithContext(requestCtx, "GET", meta.ExitAPI+"/health", nil)
	request.Header.Set("Authorization", "Bearer "+meta.ExitToken)
	response, proofErr = (&http.Client{Transport: transport}).Do(request)
	finalOK := false
	if proofErr == nil {
		var value struct {
			OK    bool   `json:"ok"`
			Node  string `json:"node_id"`
			Proof string `json:"proof"`
		}
		e := json.NewDecoder(response.Body).Decode(&value)
		_ = response.Body.Close()
		finalOK = e == nil && value.OK && value.Node == meta.ExitNodeID && value.Proof == "router-vpn-private-agent-v1"
	}
	stop()
	transport.CloseIdleConnections()
	if finalOK != (!finalBlocked && fault != "final-identity") {
		t.Fatal("paired encrypted proof changed", fault, proofErr)
	}
	if fault == "dns-route" {
		dnsTarget = "192.168.50.134:5353"
	}
	requestCtx, stop = context.WithTimeout(ctx, 300*time.Millisecond)
	connection, dnsErr := last.DialContext(requestCtx, dnsNetwork, M.ParseSocksaddr(dnsTarget))
	dnsOK := false
	if dnsErr == nil {
		deadline, _ := requestCtx.Deadline()
		_ = connection.SetDeadline(deadline)
		q := new(dns.Msg)
		q.SetQuestion("example.com.", dns.TypeA)
		var reply *dns.Msg
		if dnsNetwork == "udp" {
			wire, packErr := q.Pack()
			dnsErr = packErr
			if dnsErr == nil {
				var n int
				n, dnsErr = connection.Write(wire)
				if dnsErr == nil && n != len(wire) {
					dnsErr = io.ErrShortWrite
				}
			}
			if dnsErr == nil {
				wire = make([]byte, 4096)
				n, readErr := connection.Read(wire)
				dnsErr = readErr
				if dnsErr == nil {
					reply = new(dns.Msg)
					dnsErr = reply.Unpack(wire[:n])
				}
			}
		} else {
			c := &dns.Conn{Conn: connection}
			dnsErr = c.WriteMsg(q)
			if dnsErr == nil {
				reply, dnsErr = c.ReadMsg()
			}
		}
		if dnsErr == nil && reply != nil && reply.Response && reply.Id == q.Id && len(reply.Answer) == 1 {
			answer, ok := reply.Answer[0].(*dns.A)
			dnsOK = ok && answer.Hdr.Name == "example.com." && answer.A.Equal(net.ParseIP("93.184.216.34"))
		}
		_ = connection.Close()
	}
	stop()
	if dnsOK != (!finalBlocked && fault != "dns-route") {
		t.Fatal("selected final DNS changed", fault, dnsErr)
	}
	if (entryOK && finalOK && dnsOK) != (fault == "success" || strings.HasPrefix(fault, "mtu-")) {
		t.Fatal("unproved path became eligible", fault)
	}
	if fault == "success" && !configured {
		for _, out := range []adapter.Outbound{first, last} {
			c, e := out.DialContext(ctx, "udp", M.ParseSocksaddr("203.0.113.53:5353"))
			if c != nil {
				_ = c.Close()
				t.Fatal("CONNECT manufactured UDP carrier")
			}
			if e == nil {
				t.Fatal("UDP dial accepted")
			}
			p, e := out.ListenPacket(ctx, M.ParseSocksaddr("203.0.113.53:5353"))
			if p != nil {
				_ = p.Close()
				t.Fatal("CONNECT manufactured packet owner")
			}
			if e == nil {
				t.Fatal("UDP listener accepted")
			}
		}
		gone, stopGone := context.WithCancel(ctx)
		stopGone()
		c, e := first.DialContext(gone, "tcp", M.ParseSocksaddr("1.1.1.1:443"))
		if c != nil {
			_ = c.Close()
			t.Fatal("retired request gained stream")
		}
		if !errors.Is(e, context.Canceled) {
			t.Fatal("request cancellation changed", e)
		}
	}
	if strings.HasPrefix(fault, "mtu-") {
		desktopImportedCONNECTRetest(t, last, plan.Config(), plan.MTUProfile(), plan.SourceSHA256(), fault)
	}
	entry.close()
	final.close()
	cancel()
	if layered {
		entryLayerPeer.close()
	}
	if lower.udp.Load() != 0 || entryServer.rawUDP.Load() != 0 || final.stats().PhysicalUDP != 0 || (!configured && final.stats().Packets != 0) || (layered && entryLayerPeer.stats().PhysicalUDP != 0) {
		t.Fatal("stream-only graph attempted physical UDP")
	}
	minimumStreams := int64(2)
	if dnsNetwork == "udp" {
		minimumStreams = 1
	}
	if fault == "success" && (entryServer.plainTCP.Load() < 3 || final.stats().Streams < minimumStreams || dnsCalls.Load() == 0 || (dnsNetwork == "udp" && final.stats().Packets == 0) || (layered && entryLayerPeer.stats().Streams < 3)) {
		t.Fatal("independent CONNECT/SS/TCP-DNS observations missing")
	}
	if fault == "entry-auth" && entry.auth.Load() == 0 {
		t.Fatal("wrong authentication lacked actual407")
	}
	if fault == "final-route" && entry.denied.Load() == 0 {
		t.Fatal("foreign final lacked actual route rejection")
	}
	if (fault == "sni" || fault == "trust") && entry.tlsRefused.Load() == 0 {
		t.Fatal("HTTPS lacked independent TLS refusal")
	}
	if fault == "final-key" || fault == "final-whitening" {
		observed := final.stats()
		// A changed XOR key changes masking before SS can emit its typed AEAD
		// error. Both refusals must reach the actual ciphertext peer and yield
		// no decrypted stream or packet; retain the raw-SS typed-auth witness.
		if observed.PhysicalTCP == 0 || observed.Streams != 0 || observed.Packets != 0 ||
			(lastRaw["type"] != "routervpn-aes-xor" && observed.AuthTCP == 0) {
			t.Fatal("wrong final key or whitening gained decrypted traffic", observed)
		}
	}
	if fault == "entry-layer-key" || fault == "entry-whitening" {
		observed := entryLayerPeer.stats()
		if observed.PhysicalTCP == 0 || observed.Streams != 0 || observed.Packets != 0 || entryServer.rawTCP.Load() != 0 {
			t.Fatal("unproved independent entry layer reached CONNECT", observed)
		}
	}
	if entryBlocked && final.stats().PhysicalTCP != 0 {
		t.Fatal("blocked entry reached final")
	}
}
