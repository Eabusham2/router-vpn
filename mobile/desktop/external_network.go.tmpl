type ExternalCaptureOptions struct {
	SessionID    string `json:"session_id"`
	SourceSHA256 string `json:"source_sha256"`
}

func RegisterExternalNetworkOwner(registry *boxService.Registry) {
	boxService.Register[ExternalCaptureOptions](registry, mobilemultihop.DesktopExternalNetworkType, NewExternalNetworkOwner)
}

// ExternalNetworkOwner belongs only to the compiled ordinary external path.
// JSON can name its inert capture but cannot install a factory or activate it.
// The native Box must independently compare its complete derived options and
// supply the exact constructed policy before any startup stage opens a socket.
type ExternalNetworkOwner struct {
	mu        sync.Mutex
	ctx       context.Context
	cancel    context.CancelFunc
	capture   ExternalCaptureOptions
	networkID string
	policy    *mobilemultihop.DesktopExternalPolicy
	factory   ExternalPhysicalBrokerFactory
	preparing chan struct{}
	broker    *mobiletor.DesktopSocketBroker
	source    mobiletor.DesktopSocketSource
	physical  *ExternalPhysicalOutbound
	nextStage adapter.StartStage
	sockets   bool
	ready     bool
	active    bool
	retired   bool
	closed    bool
}

// The factory is an in-memory native capability, never an imported graph field.
// It must return partial source ownership even on cancellation/failure. Close
// joins this exact operation before retiring its descriptors and OS identity.
type ExternalPhysicalBrokerFactory func(context.Context, mobiletor.DesktopSocketCapture, func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error)

var (
	_ adapter.Service                 = (*ExternalNetworkOwner)(nil)
	_ adapter.InterfaceUpdateListener = (*ExternalNetworkOwner)(nil)
)

func NewExternalNetworkOwner(ctx context.Context, _ log.ContextLogger, tag string, options ExternalCaptureOptions) (adapter.Service, error) {
	if ctx == nil || ctx.Err() != nil || tag != mobilemultihop.DesktopExternalNetworkTag ||
		!networkSessionID.MatchString(options.SessionID) || !networkSourceID.MatchString(options.SourceSHA256) {
		return nil, errors.New("ordinary desktop network owner requires its exact captured native source")
	}
	var nonce [16]byte
	if _, err := rand.Read(nonce[:]); err != nil {
		return nil, err
	}
	owned, cancel := context.WithCancel(ctx)
	return &ExternalNetworkOwner{ctx: owned, cancel: cancel, capture: options, networkID: hex.EncodeToString(nonce[:])}, nil
}

func (*ExternalNetworkOwner) Type() string { return mobilemultihop.DesktopExternalNetworkType }
func (*ExternalNetworkOwner) Tag() string  { return mobilemultihop.DesktopExternalNetworkTag }

func (n *ExternalNetworkOwner) Matches(session, source string) bool {
	if n == nil {
		return false
	}
	n.mu.Lock()
	defer n.mu.Unlock()
	return !n.retired && n.ctx != nil && n.ctx.Err() == nil && n.capture.SessionID == session && n.capture.SourceSHA256 == source
}

func (n *ExternalNetworkOwner) brokerCapture() mobiletor.DesktopSocketCapture {
	return mobiletor.DesktopSocketCapture{SessionID: n.capture.SessionID, SourceSHA256: n.capture.SourceSHA256, NetworkID: n.networkID}
}

func (n *ExternalNetworkOwner) PrepareExternalPhysicalBroker(policy *mobilemultihop.DesktopExternalPolicy, factory ExternalPhysicalBrokerFactory) error {
	if n == nil || policy == nil || policy.Validate() != nil || factory == nil {
		return errors.New("ordinary desktop physical preparation requires its original compiled authority")
	}
	meta := policy.Metadata()
	if meta.TargetOS != runtime.GOOS || meta.SOCKSUDPAssociationRequired && !(meta.Protocol == "socks5" && (runtime.GOOS == "linux" || runtime.GOOS == "windows" || runtime.GOOS == "darwin")) || !n.Matches(meta.SessionID, meta.SourceSHA256) {
		// A live SOCKS TCP socket alone does not establish permission for its
		// negotiated UDP relay. Do not start a partially protected SOCKS graph.
		return errors.New("ordinary desktop physical transport requires a proved native target and complete association capability")
	}
	capture, err := policy.Capture()
	if err != nil {
		return err
	}
	allowed, err := externalPhysicalDestinations(capture)
	if err != nil {
		return err
	}
	manager := service.FromContext[adapter.OutboundManager](n.ctx)
	if manager == nil {
		return errors.New("ordinary desktop physical preparation has no native outbound manager")
	}
	selected, exists := manager.Outbound(mobilemultihop.DesktopExternalPhysicalTag)
	physical, ok := selected.(*ExternalPhysicalOutbound)
	if !exists || !ok || physical == nil || physical.options != n.capture {
		return errors.New("ordinary desktop physical preparation found another native lower object")
	}
	var socks *ExternalSOCKSOutbound
	if meta.SOCKSUDPAssociationRequired {
		selected, exists := manager.Outbound(mobilemultihop.ExternalFinalTag)
		socks, ok = selected.(*ExternalSOCKSOutbound)
		if !exists || !ok || socks == nil || socks.options.ExternalCaptureOptions != n.capture {
			return errors.New("ordinary SOCKS5 preparation has no captured per-association native root")
		}
	}
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.retired || n.ready || n.active || n.ctx.Err() != nil || n.factory != nil || n.policy != nil || n.preparing != nil {
		return errors.New("ordinary desktop physical preparation is late, replaced or already owned")
	}
	if err := physical.prepare(n, allowed); err != nil {
		return err
	}
	if socks != nil {
		if err := socks.prepare(policy, n, physical); err != nil {
			return err
		}
	}
	n.policy, n.factory, n.physical = policy, factory, physical
	return nil
}

func (n *ExternalNetworkOwner) Start(stage adapter.StartStage) error {
	if n == nil {
		return errors.New("ordinary desktop network owner is unavailable")
	}
	n.mu.Lock()
	valid := !n.retired && n.ctx != nil && n.ctx.Err() == nil && stage == n.nextStage && stage <= adapter.StartStateStarted
	n.mu.Unlock()
	if !valid {
		return errors.New("ordinary desktop startup changed its captured stage order")
	}
	if stage == adapter.StartStateInitialize {
		if err := n.startPhysical(); err != nil {
			return err
		}
	}
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.retired || n.ctx == nil || n.ctx.Err() != nil || n.policy == nil || n.broker == nil || n.source == nil || stage != n.nextStage {
		return errors.New("ordinary desktop network startup has no prepared native owner")
	}
	if stage == adapter.StartStateInitialize {
		// Packet endpoints and OpenVPN may dial during endpoint Start. Their
		// exact remote tuples, source and deny baseline have
		// already been retained by the native factory. This separate phase
		// admits only the compiled lower tuples, never proof or TUN readiness.
		meta := n.policy.Metadata()
		n.sockets = meta.TargetOS == runtime.GOOS && (runtime.GOOS == "linux" || runtime.GOOS == "windows" || runtime.GOOS == "darwin") && (meta.RootType == "wireguard" || meta.RootType == mobilemultihop.AmneziaType || meta.RootType == "openvpn-client")
	}
	if stage == adapter.StartStateStarted {
		n.ready = true
	}
	n.nextStage++
	return nil
}

func (n *ExternalNetworkOwner) startPhysical() error {
	n.mu.Lock()
	if n.retired || n.ctx == nil || n.ctx.Err() != nil || n.factory == nil || n.policy == nil || n.preparing != nil || n.active || n.ready {
		n.mu.Unlock()
		return errors.New("ordinary desktop physical factory is missing, retired or already entered")
	}
	ctx, factory, capture := n.ctx, n.factory, n.brokerCapture()
	joined := make(chan struct{})
	n.preparing = joined
	n.mu.Unlock()
	defer close(joined)
	broker, source, err := factory(ctx, capture, func() bool { return n.Matches(capture.SessionID, capture.SourceSHA256) })
	// Retain every returned owner before testing cancellation or result shape.
	// The close path waits for joined before observing these fields.
	n.mu.Lock()
	n.broker, n.source = broker, source
	n.mu.Unlock()
	if err == nil && broker != nil && source != nil && ctx.Err() == nil && broker.Matches(capture) {
		n.mu.Lock()
		current := !n.retired && n.ctx.Err() == nil
		n.mu.Unlock()
		if current {
			return nil
		}
	}
	n.retire()
	return errors.Join(err, ctx.Err(), errors.New("ordinary desktop physical initialization did not retain its exact live source"))
}

// Activate follows actual native Started and consumes the same policy pointer
// used for preparation. Its context is the parent of proof and measurement
// work, so a real network reset revokes those results before publication.
func (n *ExternalNetworkOwner) Activate(policy *mobilemultihop.DesktopExternalPolicy) (context.Context, error) {
	if n == nil || policy == nil || policy.Validate() != nil {
		return nil, errors.New("ordinary desktop activation requires its original native policy")
	}
	n.mu.Lock()
	broker, capture := n.broker, n.brokerCapture()
	n.mu.Unlock()
	if broker == nil || !broker.Matches(capture) {
		return nil, errors.New("ordinary desktop activation lost its captured broker")
	}
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.retired || !n.ready || n.active || n.ctx.Err() != nil || n.policy != policy || n.broker != broker || n.source == nil || n.physical == nil {
		return nil, errors.New("ordinary desktop activation is early, stale or already owned")
	}
	n.active = true
	return n.ctx, nil
}

// MatchesContext reads only this original capture under the caller's deadline.
func (n *ExternalNetworkOwner) MatchesContext(ctx context.Context, session, source string) error {
	if n == nil {
		return net.ErrClosed
	}
	if err := desktopnetwork.LockContext(ctx, &n.mu); err != nil {
		return err
	}
	defer n.mu.Unlock()
	if n.retired || n.ctx == nil || n.ctx.Err() != nil || n.capture.SessionID != session || n.capture.SourceSHA256 != source {
		return net.ErrClosed
	}
	return ctx.Err()
}

func (n *ExternalNetworkOwner) CurrentContext(ctx context.Context) error {
	if n == nil {
		return net.ErrClosed
	}
	if err := desktopnetwork.LockContext(ctx, &n.mu); err != nil {
		return err
	}
	current := n.active && n.ready && !n.retired && n.ctx != nil && n.ctx.Err() == nil
	broker, capture := n.broker, n.brokerCapture()
	n.mu.Unlock()
	if !current || broker == nil {
		return net.ErrClosed
	}
	return broker.MatchesContext(ctx, capture)
}

func (n *ExternalNetworkOwner) SocketCurrentContext(ctx context.Context) error {
	if n == nil {
		return net.ErrClosed
	}
	if err := desktopnetwork.LockContext(ctx, &n.mu); err != nil {
		return err
	}
	current := (n.sockets || n.active && n.ready) && !n.retired && n.ctx != nil && n.ctx.Err() == nil
	broker, capture := n.broker, n.brokerCapture()
	n.mu.Unlock()
	if !current || broker == nil {
		return net.ErrClosed
	}
	return broker.MatchesContext(ctx, capture)
}

func (n *ExternalNetworkOwner) Current() bool {
	if n == nil {
		return false
	}
	n.mu.Lock()
	current := n.active && n.ready && !n.retired && n.ctx != nil && n.ctx.Err() == nil
	broker, capture := n.broker, n.brokerCapture()
	n.mu.Unlock()
	return current && broker != nil && broker.Matches(capture)
}

// SocketCurrent preserves normal activation for the ordinary lazy transports.
// Only sealed Linux/Windows WG/AWG/OpenVPN and Darwin WG may acquire its captured lower
// after Initialize. Current still governs every proof, TUN and measurement.
func (n *ExternalNetworkOwner) SocketCurrent() bool {
	if n == nil {
		return false
	}
	n.mu.Lock()
	current := (n.sockets || n.active && n.ready) && !n.retired && n.ctx != nil && n.ctx.Err() == nil
	broker, capture := n.broker, n.brokerCapture()
	n.mu.Unlock()
	return current && broker != nil && broker.Matches(capture)
}

// Cancel revokes proof, measurement and socket admission without waiting for an
// entered native constructor or OS cleanup. Close retains and joins those
// exact owners, including a source returned after this cancellation.
func (n *ExternalNetworkOwner) Cancel() { n.retire() }

// CancelAdmission revokes the immutable original lifetime without waiting for
// the owner mutex or source cleanup. The broker's owned cancellation callback
// retains that cleanup; Close joins the same source and entered constructors.
func (n *ExternalNetworkOwner) CancelAdmission() {
	if n != nil && n.cancel != nil {
		n.cancel()
	}
}

func (n *ExternalNetworkOwner) retire() {
	if n == nil {
		return
	}
	n.mu.Lock()
	n.retired, n.ready, n.sockets = true, false, false
	if n.cancel != nil {
		n.cancel()
	}
	broker, source := n.broker, n.source
	n.mu.Unlock()
	if broker != nil {
		broker.Cancel()
	}
	if source != nil {
		source.Cancel()
	}
}

func (n *ExternalNetworkOwner) InterfaceUpdated(_ context.Context) {
	if n == nil {
		return
	}
	n.mu.Lock()
	entered := n.active || n.preparing != nil
	n.mu.Unlock()
	if entered {
		n.retire()
	}
}

func (n *ExternalNetworkOwner) Close() error {
	if n == nil {
		return nil
	}
	n.retire()
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	n.mu.Lock()
	preparing := n.preparing
	n.mu.Unlock()
	if preparing != nil {
		select {
		case <-preparing:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	n.mu.Lock()
	broker, source := n.broker, n.source
	n.mu.Unlock()
	if broker != nil {
		if err := broker.Close(ctx); err != nil {
			return err
		}
	}
	if source != nil {
		if err := source.Close(ctx); err != nil {
			return err
		}
	}
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.broker != broker || n.source != source || !n.retired || n.ready {
		return errors.New("ordinary desktop cleanup changed its original native owner")
	}
	n.closed = true
	return nil
}

// This result belongs to the exact joined native source, including a source
// returned by a failed constructor. A false captured result is not absence of
// protection; the command must independently read its original expectation.
func (n *ExternalNetworkOwner) RetainedPhysicalProtection(ctx context.Context, policy *mobilemultihop.DesktopExternalPolicy) (*mobiletor.DesktopWindowsProtectionTarget, bool, error) {
	if n == nil || ctx == nil || ctx.Err() != nil || policy == nil || policy.Validate() != nil {
		return nil, false, errors.New("ordinary external retirement lost its captured cleanup request")
	}
	meta := policy.Metadata()
	n.mu.Lock()
	valid := n.closed && n.retired && n.ctx != nil && !n.ready && !n.sockets && n.capture.SessionID == meta.SessionID && n.capture.SourceSHA256 == meta.SourceSHA256 &&
		(n.policy == policy || n.policy == nil && n.factory == nil && n.preparing == nil)
	source, capture, lifetime := n.source, n.brokerCapture(), n.ctx
	n.mu.Unlock()
	if !valid {
		return nil, false, errors.New("ordinary external retirement is unjoined or belongs to another native policy")
	}
	if source == nil {
		return nil, false, nil
	}
	reader, ok := source.(interface {
		RetainedProtectionOutcome(context.Context) (*mobiletor.DesktopWindowsProtectionTarget, error)
	})
	if !ok {
		return nil, true, errors.New("ordinary external source cannot attest its joined protection outcome")
	}
	target, err := reader.RetainedProtectionOutcome(ctx)
	if err != nil || ctx.Err() != nil {
		return nil, true, errors.Join(err, ctx.Err())
	}
	if target != nil && target.Validate() == nil && target.Capture == capture && target.Policy == meta.KillSwitchPolicy {
		captured := *target
		return &captured, true, nil
	}
	// Cancellation revokes admission but does not erase its original cleanup
	// capability. Never look up a later selected policy or predecessor here.
	owner, ok := lifetime.Value(externalPhysicalAdmissionKey{}).(*externalPhysicalAdmissionOwner)
	if !ok || owner == nil || owner.policy != policy || owner.admit == nil {
		return nil, true, errors.New("ordinary external retirement lost its original predecessor capability")
	}
	if target == nil && owner.predecessor == nil {
		return nil, true, nil
	}
	if target == nil || target.Validate() != nil || owner.predecessor == nil || *target != *owner.predecessor {
		return nil, true, errors.New("ordinary external retirement substituted its captured protection outcome")
	}
	captured := *target
	return &captured, true, nil
}

func (n *ExternalNetworkOwner) BindPhysicalTunnel(ctx context.Context, name string, index uint32) error {
	return n.changePhysicalTunnel(ctx, name, index, nil, false)
}
func (n *ExternalNetworkOwner) BindPhysicalTunnelFile(ctx context.Context, name string, index uint32, file *os.File) error {
	if file == nil {
		return errors.New("ordinary desktop tunnel has no retained native control")
	}
	return n.changePhysicalTunnel(ctx, name, index, file, false)
}
func (n *ExternalNetworkOwner) RetirePhysicalTunnel(ctx context.Context, name string, index uint32) error {
	return n.changePhysicalTunnel(ctx, name, index, nil, true)
}
func (n *ExternalNetworkOwner) changePhysicalTunnel(ctx context.Context, name string, index uint32, file *os.File, retire bool) error {
	if n == nil || ctx == nil || name == "" || index == 0 {
		return errors.New("ordinary desktop tunnel lost its active native capture")
	}
	bounded, cancel := context.WithTimeout(ctx, 3*time.Second)
	defer cancel()
	if err := n.CurrentContext(bounded); err != nil {
		return err
	}
	if err := desktopnetwork.LockContext(bounded, &n.mu); err != nil {
		return err
	}
	source, capture := n.source, n.brokerCapture()
	current := n.active && n.ready && !n.retired && n.ctx != nil && n.ctx.Err() == nil
	n.mu.Unlock()
	if !current {
		return errors.New("ordinary desktop tunnel lost its active native capture")
	}
	if err := bounded.Err(); err != nil {
		return err
	}
	policy, ok := source.(mobiletor.DesktopSocketTunnelPolicy)
	if !ok {
		if runtime.GOOS == "linux" && source != nil {
			return bounded.Err()
		}
		return errors.New("ordinary desktop physical policy cannot attest its actual TUN")
	}
	var err error
	if retire {
		err = policy.RetireTunnel(bounded, capture, name, index)
	} else if file != nil {
		owned, ok := policy.(mobiletor.DesktopSocketTunnelFilePolicy)
		if !ok {
			return errors.New("ordinary desktop physical policy cannot retain its exact TUN control")
		}
		err = owned.BindTunnelFile(bounded, capture, name, index, file)
	} else {
		err = policy.BindTunnel(bounded, capture, name, index)
	}
	if lockErr := desktopnetwork.LockContext(bounded, &n.mu); lockErr != nil {
		return errors.Join(err, lockErr)
	}
	current = n.active && n.ready && !n.retired && n.ctx != nil && n.ctx.Err() == nil && n.source == source && n.brokerCapture() == capture
	n.mu.Unlock()
	if !current {
		return errors.Join(err, bounded.Err(), errors.New("ordinary desktop physical policy did not acknowledge the captured TUN"))
	}
	return errors.Join(err, n.CurrentContext(bounded))
}
