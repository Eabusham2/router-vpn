			// not its lifetime. Carry the native dump's existing two-second
			// bound through the entire receipt, including every owner check;
			// lower readers must not renew it or outlive the original Stop.
			heartbeatContext, stopHeartbeat := context.WithTimeout(observe, 2*time.Second)
			next.NetworkReceipt, err = owner.DesktopNetworkReceiptContext(heartbeatContext)
			if err == nil && openVPN != nil {
				// The packet generation is freshly reobserved after this exact
				// reader's network policy. A saved pre-mutation receipt cannot
				// authorize the host's authenticated MTU probes.
				next.OpenVPN, err = openVPN.observeMTU(heartbeatContext)
			}
			if err == nil {
				err = chain.heartbeat(heartbeatContext, next)
			}
			if err == nil && complete != nil {
				err = complete.heartbeat(heartbeatContext, next)
			}
			if err == nil {
				err = prefix.heartbeat(heartbeatContext, next)
			}
			if err == nil {
				err = heartbeatContext.Err()
			}
			stopHeartbeat()
			if err != nil {
				// The owned Stop watcher can cancel the graph while native
				// readback is in flight. Join that requested shutdown without
				// publishing stale evidence; unrelated cancellation or invalid
				// proof remains a failure, even if a Stop record is present.
				if parent.Err() != nil || ctx.Err() != nil && files.stopRequested(session, config) {
					return nil
				}
				return routerVPNExternalFailure
			}
			owner.record = next
			if err = files.publish("node-mtu-status.json", owner.record); err != nil {
				return routerVPNExternalFailure
			}
		}
		if consumed != nil {
			current, err := files.root.Lstat("node-mtu-request.json")
			if err != nil || !os.SameFile(current, consumed) || files.root.Remove("node-mtu-request.json") != nil {
				return routerVPNExternalFailure
			}
		}
		select {
		case <-parent.Done():
			return nil
		case <-ticker.C:
		}
	}
}
