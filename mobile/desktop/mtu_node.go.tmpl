func routerVPNRunNodeMTUSOCKSFamiliesCaptured(parent context.Context,directory,session,config,physicalSource,importedSource,chainSource,executionSource,prefixSource,prefixCapture,socksSource,physicalTransfer string,physicalMTU int,journal routerVPNNodeJournal)(failure error){
