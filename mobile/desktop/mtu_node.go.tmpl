// Ordinary Router-node MTU uses the same retained native TUN transaction as
// external paths. The existing authenticated private-node optimizer retains
// its measurement protocol; only this exact Box may replace its TUN reader.
const routerVPNNodeMTURecordLimit = 32 << 10

type routerVPNNodeMTURecord struct {
	OpenVPN        nativeopenvpn.PacketObservation `json:"openvpn,omitzero"`
	NetworkReceipt string                          `json:"network_receipt,omitempty"`
	Schema         int                             `json:"schema"`
	Session        string                          `json:"session_id"`
	Config         string                          `json:"config_sha256"`
	Path           string                          `json:"path_id"`
	Generation     uint64                          `json:"generation"`
	Request        string                          `json:"request_id"`
	Lease          string                          `json:"lease_id"`
	Active         bool                            `json:"active"`
	Restored       bool                            `json:"restored"`
	Expired        bool                            `json:"expired,omitempty"`
	Reader         uint64                          `json:"reader"`
	Interface      string                          `json:"interface"`
	Index          int                             `json:"index"`
	MTU            int                             `json:"mtu"`
	Heartbeat      int64                           `json:"heartbeat_at"`
	Failure        string                          `json:"failure,omitempty"`
}
type routerVPNNodeMTUCommand struct {
	Schema           int    `json:"schema"`
	Session          string `json:"session_id"`
	Config           string `json:"config_sha256"`
	Path             string `json:"path_id"`
	Generation       uint64 `json:"generation"`
	Request          string `json:"request_id"`
	Lease            string `json:"lease_id"`
	Action           string `json:"action"`
	Reader           uint64 `json:"reader"`
	MTU              int    `json:"expected_mtu"`
	Value            int    `json:"value,omitempty"`
	RevertToken      string `json:"revert_token,omitempty"`
	CommitRequest    string `json:"commit_request,omitempty"`
	CommitGeneration uint64 `json:"commit_generation,omitempty"`
}

func (request *routerVPNNodeMTUCommand) UnmarshalJSON(raw []byte) error {
	type plain routerVPNNodeMTUCommand
	var value plain
	if !routerVPNMTUStrict(raw, &value) {
		return routerVPNExternalFailure
	}
	var fields map[string]json.RawMessage
	if json.Unmarshal(raw, &fields) != nil {
		return routerVPNExternalFailure
	}
	for name, raw := range fields {
		switch name {
		case "schema", "session_id", "config_sha256", "path_id", "generation", "request_id", "lease_id", "action", "reader", "expected_mtu", "value", "revert_token", "commit_request", "commit_generation":
		default:
			return routerVPNExternalFailure
		}
		if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
			return routerVPNExternalFailure
		}
	}
	*request = routerVPNNodeMTUCommand(value)
	return nil
}

type routerVPNNodeCommitRevert struct {
	request    string
	generation uint64
	tokenHash  [32]byte
}
type routerVPNNodeMTUEngine interface {
	Current() (adapter.Inbound, error)
	CurrentContext(context.Context) (adapter.Inbound, error)
	Change(context.Context, adapter.Inbound, int) (adapter.Inbound, error)
}

// An ordered execution keeps its original native manager and physical grant
// across MTU trials. This private companion owns pause, selected-only reproof
// and cleanup; the ordinary node path never acquires it from serialized data.
type routerVPNNodeMTUExecution interface {
	currentCommand(context.Context, *routerVPNNodeMTU, routerVPNNodeMTUCommand) error
	beforeChange(context.Context, *routerVPNNodeMTU, int) (func(), error)
	change(context.Context, *routerVPNNodeMTU, adapter.Inbound, int) (adapter.Inbound, error)
	afterChange(context.Context, *routerVPNNodeMTU) error
}
type routerVPNNodeMTUBox struct {
	instance *box.Box
	tag      string
	physical *box.RouterVPNDesktopNodePhysical
}

func (engine *routerVPNNodeMTUBox) Current() (adapter.Inbound, error) {
	current, ok := engine.instance.Inbound().Get(engine.tag)
	if !ok {
		return nil, routerVPNExternalFailure
	}
	return current, nil
}
func (engine *routerVPNNodeMTUBox) Change(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
	if engine.physical != nil {
		return engine.physical.ChangeMTU(ctx, expected, mtu)
	}
	return engine.instance.RouterVPNChangeMTU(ctx, expected, mtu)
}

func (engine *routerVPNNodeMTUBox) ClaimTUN(guard func() bool) (string, int, int, error) {
	if engine.physical != nil {
		return engine.physical.ClaimTUN(guard)
	}
	current, err := engine.Current()
	reader, ok := current.(routerVPNDesktopMTUTUN)
	if err != nil || !ok {
		return "", 0, 0, routerVPNExternalFailure
	}
	return reader.RouterVPNDesktopMTU(guard)
}

type routerVPNNodeMTU struct {
	ctx          context.Context
	engine       routerVPNNodeMTUEngine
	inbound      routerVPNDesktopMTUTUN
	record       routerVPNNodeMTURecord
	guard        func() bool
	guardContext func(context.Context) error
	used         map[string]bool
	original     int
	deadline     time.Time
	commitRevert *routerVPNNodeCommitRevert
	openVPN      *routerVPNImportedOpenVPN
	chain        *routerVPNNodeChainRuntime
	execution    routerVPNNodeMTUExecution
	prefix       *routerVPNNodeCandidatePrefixRuntime
	// Diagnostic suppression belongs to this exact reader, not a session
	// basename or a replacement owner. It is never serialized as evidence.
	networkReceiptDiagnosticReader uint64
}

func newRouterVPNNodeMTU(engine routerVPNNodeMTUEngine, session, config, path string, guard func() bool) (*routerVPNNodeMTU, error) {
	// Compatibility entry point has no caller to propagate. Its explicitly
	// supplied guard is adapted here; bounded production uses the method below.
	return newRouterVPNNodeMTUContext(context.Background(), engine, session, config, path, func(ctx context.Context) error {
		if err := ctx.Err(); err != nil {
			return err
		}
		if guard == nil || !guard() {
			return routerVPNExternalFailure
		}
		return nil
	})
}
func newRouterVPNNodeMTUContext(ctx context.Context, engine routerVPNNodeMTUEngine, session, config, path string, guard func(context.Context) error) (*routerVPNNodeMTU, error) {
	if ctx == nil || engine == nil || !routerVPNExternalSession.MatchString(session) || len(config) != 64 || len(path) != 64 || guard == nil {
		return nil, routerVPNExternalFailure
	}
	if err := guard(ctx); err != nil {
		return nil, err
	}
	current, err := engine.CurrentContext(ctx)
	if err != nil {
		return nil, err
	}
	inbound, ok := current.(routerVPNDesktopMTUTUN)
	if !ok || inbound.Type() != "tun" {
		return nil, routerVPNExternalFailure
	}
	claim, ok := current.(interface {
		RouterVPNDesktopMTUContext(context.Context, func(context.Context) error) (string, int, int, error)
	})
	if !ok {
		return nil, routerVPNExternalFailure
	}
	claimMethod := claim.RouterVPNDesktopMTUContext
	if captured, ok := engine.(interface {
		ClaimTUNContext(context.Context, func(context.Context) error) (string, int, int, error)
	}); ok {
		claimMethod = captured.ClaimTUNContext
	}
	name, index, mtu, err := claimMethod(ctx, guard)
	if err != nil {
		return nil, err
	}
	owner := &routerVPNNodeMTU{ctx: ctx, engine: engine, inbound: inbound, guardContext: guard, guard: func() bool { return guard(context.Background()) == nil }, used: map[string]bool{}, record: routerVPNNodeMTURecord{Schema: 1, Session: session, Config: config, Path: path, Reader: 1, Interface: name, Index: index, MTU: mtu}}
	if err := owner.currentContext(ctx); err != nil {
		return nil, err
	}
	return owner, nil
}
func (engine *routerVPNNodeMTUBox) CurrentContext(ctx context.Context) (adapter.Inbound, error) {
	current, ok, err := adapter.RouterVPNInboundContext(ctx, engine.instance.Inbound(), engine.tag)
	if err != nil {
		return nil, err
	}
	if !ok {
		return nil, routerVPNExternalFailure
	}
	return current, nil
}
func (engine *routerVPNNodeMTUBox) ClaimTUNContext(ctx context.Context, guard func(context.Context) error) (string, int, int, error) {
	if engine.physical != nil {
		return engine.physical.ClaimTUNContext(ctx, guard)
	}
	current, err := engine.CurrentContext(ctx)
	if err != nil {
		return "", 0, 0, err
	}
	reader, ok := current.(interface {
		RouterVPNDesktopMTUContext(context.Context, func(context.Context) error) (string, int, int, error)
	})
	if !ok {
		return "", 0, 0, routerVPNExternalFailure
	}
	return reader.RouterVPNDesktopMTUContext(ctx, guard)
}
func (owner *routerVPNNodeMTU) currentContext(ctx context.Context) error {
	if ctx == nil {
		return routerVPNExternalFailure
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if owner == nil || owner.guardContext == nil {
		return routerVPNExternalFailure
	}
	if err := owner.guardContext(ctx); err != nil {
		return err
	}
	actual, err := owner.engine.CurrentContext(ctx)
	if err != nil {
		return err
	}
	if actual != owner.inbound {
		return routerVPNExternalFailure
	}
	reader, ok := owner.inbound.(interface {
		RouterVPNDesktopMTUInterfaceContext(context.Context) (string, int, int, error)
	})
	if !ok {
		return routerVPNExternalFailure
	}
	name, index, mtu, err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
	if err != nil {
		return err
	}
	if name != owner.record.Interface || index != owner.record.Index || mtu != owner.record.MTU {
		return routerVPNExternalFailure
	}
	return owner.guardContext(ctx)
}

func (owner *routerVPNNodeMTU) current() error { return owner.currentContext(owner.ctx) }

func (owner *routerVPNNodeMTU) change(value int) error {
	return owner.changeBefore(value, time.Time{})
}
func (owner *routerVPNNodeMTU) changeBefore(value int, deadline time.Time) error {
	return owner.changeBeforeContext(owner.ctx, value, deadline)
}
func (owner *routerVPNNodeMTU) changeBeforeContext(parent context.Context, value int, deadline time.Time) error {
	if owner.currentContext(parent) != nil || value < 1280 || value > 9000 {
		return routerVPNExternalFailure
	}
	// A closed execution may already have its original interface value while
	// still needing selected-path proof. Never acknowledge that rollback from
	// the saved number alone; its companion must retain and reprove the reader.
	if value == owner.record.MTU && owner.execution == nil {
		return nil
	}
	if !mobilemtu.SameOperationContext(parent, parent) {
		work, finish, err := mobilemtu.WithOperationContext(parent, 10*time.Second, 3*time.Second)
		if err != nil {
			return err
		}
		defer finish()
		parent = work
	}
	limit := time.Now().Add(10 * time.Second)
	if !deadline.IsZero() && deadline.Before(limit) {
		limit = deadline
	}
	ctx, cancel := context.WithDeadline(parent, limit)
	defer cancel()
	if owner.chain != nil {
		if err := owner.chain.beforeChange(ctx, value); err != nil {
			return err
		}
	}
	if owner.execution != nil {
		if owner.chain != nil {
			return routerVPNExternalFailure
		}
		finish, err := owner.execution.beforeChange(ctx, owner, value)
		if finish != nil {
			defer finish()
		}
		if err != nil || finish == nil {
			return errors.Join(err, routerVPNExternalFailure)
		}
	}
	previous, before := owner.inbound, owner.record
	var next adapter.Inbound
	var changeErr error
	if owner.execution != nil {
		next, changeErr = owner.execution.change(ctx, owner, previous, value)
	} else {
		next, changeErr = owner.engine.Change(ctx, previous, value)
	}
	observe := ctx
	if ctx.Err() != nil || owner.execution != nil && changeErr != nil {
		// Only the native transaction's original cleanup allowance may observe
		// its returned rollback reader. It cannot adopt a late measured winner.
		var err error
		observe, err = mobilemtu.OperationCleanupContext(ctx)
		if err != nil || owner.ctx.Err() != nil {
			return errors.Join(changeErr, err, ctx.Err())
		}
	}
	actual, err := owner.engine.CurrentContext(observe)
	reader, ok := next.(routerVPNDesktopMTUTUN)
	if err != nil || !ok || actual != next || reader.Tag() != owner.inbound.Tag() || reader.Type() != "tun" {
		return routerVPNExternalFailure
	}
	observed, ok := reader.(interface {
		RouterVPNDesktopMTUInterfaceContext(context.Context) (string, int, int, error)
	})
	if !ok {
		return routerVPNExternalFailure
	}
	name, index, mtu, err := observed.RouterVPNDesktopMTUInterfaceContext(observe)
	if err != nil || name != owner.record.Interface || index < 1 || mtu < 1280 || mtu > 9000 {
		return routerVPNExternalFailure
	}
	after := before
	after.Reader++
	after.Index, after.MTU = index, mtu
	if owner.openVPN != nil {
		if err := owner.openVPN.handoffMTU(observe, previous, before, reader, after); err != nil {
			return err
		}
	}
	owner.inbound, owner.record = reader, after
	if owner.execution != nil {
		// Reprove this exact returned candidate or rollback reader even when
		// work was cancelled. Only the original cleanup allowance may finish
		// that already-owned operation; a new Compare run is never requested.
		resumeErr := owner.execution.afterChange(observe, owner)
		if err := errors.Join(changeErr, ctx.Err(), resumeErr); err != nil {
			return err
		}
	}
	if changeErr != nil || ctx.Err() != nil || mtu != value || owner.currentContext(ctx) != nil {
		return routerVPNExternalFailure
	}
	if owner.chain != nil {
		if err := owner.chain.resume(ctx); err != nil {
			return err
		}
	}
	return nil
}
func (owner *routerVPNNodeMTU) expire(now time.Time) error {
	if !now.Before(owner.deadline) {
		owner.commitRevert = nil
	}
	if !owner.record.Active || now.Before(owner.deadline) {
		return nil
	}
	err := owner.change(owner.original)
	owner.record.Active = false
	owner.record.Expired = true
	owner.record.Restored = err == nil
	owner.record.Failure = "captured MTU lease expired; original MTU restored"
	if err != nil {
		owner.record.Failure = "captured MTU lease expired without confirmed rollback"
	}
	return err
}
func (owner *routerVPNNodeMTU) command(request routerVPNNodeMTUCommand) error {
	ctx, cancel := context.WithTimeout(owner.ctx, 10*time.Second)
	defer cancel()
	return owner.commandContext(ctx, request)
}
func (owner *routerVPNNodeMTU) commandContext(ctx context.Context, request routerVPNNodeMTUCommand) error {
	// Candidate preparation holds its captured TUN for the complete test. A
	// separate optimizer cannot mutate that never-connected measurement owner.
	if owner == nil || owner.prefix != nil {
		return routerVPNExternalFailure
	}
	if owner != nil && owner.chain != nil && owner.chain.measurementHold.Load() {
		return routerVPNExternalFailure
	}
	if owner.chain != nil {
		if err := owner.chain.current(ctx); err != nil {
			return err
		}
	}
	if owner.execution != nil {
		if owner.chain != nil {
			return routerVPNExternalFailure
		}
		if err := owner.execution.currentCommand(ctx, owner, request); err != nil {
			return err
		}
	}
	if request.Schema != 1 || request.Session != owner.record.Session || request.Config != owner.record.Config || request.Path != owner.record.Path || request.Generation != owner.record.Generation+1 || !routerVPNExternalSession.MatchString(request.Request) || !routerVPNExternalSession.MatchString(request.Lease) {
		return routerVPNExternalFailure
	}
	if request.Action != "begin" && request.Action != "set" && request.Action != "commit" && request.Action != "rollback" && request.Action != "revert-unconfirmed-commit" {
		return routerVPNExternalFailure
	}
	if request.Action != "commit" && request.Action != "revert-unconfirmed-commit" && request.RevertToken != "" || request.Action != "revert-unconfirmed-commit" && (request.CommitRequest != "" || request.CommitGeneration != 0) {
		return routerVPNExternalFailure
	}
	if request.RevertToken != "" && !routerVPNExternalSession.MatchString(request.RevertToken) {
		return routerVPNExternalFailure
	}
	if request.Reader != owner.record.Reader || request.MTU != owner.record.MTU || owner.currentContext(ctx) != nil {
		return routerVPNExternalFailure
	}
	if owner.openVPN != nil {
		if _, err := owner.openVPN.observeMTU(ctx); err != nil {
			return err
		}
	}
	if request.Action == "begin" {
		if owner.record.Active || owner.used[request.Lease] || len(owner.used) >= 4096 || request.Value != 0 {
			return routerVPNExternalFailure
		}
		if owner.openVPN != nil {
			if err := owner.openVPN.claimMTULease(ctx, request.Lease); err != nil {
				return err
			}
		}
		owner.used[request.Lease] = true
		owner.record.Lease = request.Lease
		owner.record.Active = true
		owner.record.Restored = false
		owner.record.Expired = false
		owner.commitRevert = nil
		owner.original = owner.record.MTU
		owner.deadline = time.Now().Add(150 * time.Second)
	} else if request.Action == "revert-unconfirmed-commit" {
		capture := owner.commitRevert
		if owner.record.Active || owner.record.Restored || capture == nil || request.Lease != owner.record.Lease || !time.Now().Before(owner.deadline) || request.Value != owner.original || request.CommitRequest != capture.request || request.CommitGeneration != capture.generation || !routerVPNExternalSession.MatchString(request.RevertToken) {
			return routerVPNExternalFailure
		}
		hash := sha256.Sum256([]byte(request.RevertToken))
		if subtle.ConstantTimeCompare(hash[:], capture.tokenHash[:]) != 1 {
			return routerVPNExternalFailure
		}
		if err := owner.changeBeforeContext(ctx, owner.original, owner.deadline); err != nil {
			return err
		}
		owner.record.Restored = true
		owner.commitRevert = nil
	} else {
		if !owner.record.Active || request.Lease != owner.record.Lease || !time.Now().Before(owner.deadline) {
			return routerVPNExternalFailure
		}
		if request.Action == "set" {
			if err := owner.changeBeforeContext(ctx, request.Value, owner.deadline); err != nil {
				return err
			}
		} else {
			if request.Value != 0 {
				return routerVPNExternalFailure
			}
			if request.Action == "rollback" {
				if err := owner.changeBeforeContext(ctx, owner.original, owner.deadline); err != nil {
					return err
				}
				owner.record.Restored = true
				owner.commitRevert = nil
			} else if request.RevertToken != "" {
				owner.commitRevert = &routerVPNNodeCommitRevert{request: request.Request, generation: request.Generation, tokenHash: sha256.Sum256([]byte(request.RevertToken))}
			}
			owner.record.Active = false
		}
	}
	return nil
}

func init() {
	var directory, session, config, physicalSource, importedSource, physicalTransfer string
	var physicalMTU int
	var journal routerVPNNodeJournalOptions
	var linuxParent routerVPNNodeLinuxParentOptions
	command := &cobra.Command{Use: "routervpn-node", Short: "Run one captured Router VPN node and its retained TUN", Args: cobra.NoArgs, SilenceUsage: true, RunE: func(*cobra.Command, []string) error {
		ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
		defer cancel()
		if importedSource != "" {
			if physicalSource != "" || linuxParent != (routerVPNNodeLinuxParentOptions{}) {
				return routerVPNExternalFailure
			}
			return routerVPNRunImportedMTUWithJournal(ctx, directory, session, config, importedSource, physicalTransfer, physicalMTU, journal)
		}
		return routerVPNRunNodeMTUWithParents(ctx, directory, session, config, physicalSource, physicalTransfer, physicalMTU, journal, linuxParent)
	}}
	command.Flags().StringVar(&directory, "runtime-dir", "", "absolute private runtime directory")
	command.Flags().StringVar(&session, "session", "", "captured runtime identity")
	command.Flags().StringVar(&config, "config-sha256", "", "captured configuration digest")
	command.Flags().StringVar(&physicalSource, "physical-source-sha256", "", "captured derived physical owner identity")
	command.Flags().StringVar(&importedSource, "imported-source-sha256", "", "captured imported entry and paired final physical owner identity")
	command.Flags().StringVar(&physicalTransfer, "physical-transfer-sha256", "", "captured private protection predecessor record")
	command.Flags().IntVar(&physicalMTU, "physical-mtu", 0, "captured live TUN value for sealed connection restoration")
	command.Flags().Uint64Var(&journal.ParentHandle, "journal-parent-handle", 0, "inherited native controller capability")
	command.Flags().StringVar(&journal.ParentImage, "journal-parent-image", "", "retained native controller image")
	command.Flags().StringVar(&journal.Pipe, "journal-pipe", "", "native durable transaction rendezvous")
	command.Flags().StringVar(&journal.CaptureSHA256, "journal-capture-sha256", "", "captured journal comparison digest")
	command.Flags().IntVar(&linuxParent.ChannelFD, "linux-parent-channel", 0, "inherited original Linux parent channel")
	command.Flags().IntVar(&linuxParent.DirectoryFD, "linux-parent-directory", 0, "inherited original Linux parent task directory")
	command.Flags().StringVar(&linuxParent.CaptureSHA256, "linux-parent-capture", "", "captured Linux command identity")
	mainCommand.AddCommand(command)
}

func routerVPNRunNodeMTU(parent context.Context, directory, session, config string) (failure error) {
	return routerVPNRunNodeMTUWithPhysical(parent, directory, session, config, "", "")
}

func routerVPNRunNodeMTUWithPhysical(parent context.Context, directory, session, config, physicalSource, physicalTransfer string) (failure error) {
	return routerVPNRunNodeMTUWithPhysicalMTU(parent, directory, session, config, physicalSource, physicalTransfer, 0)
}

func routerVPNRunNodeMTUWithPhysicalMTU(parent context.Context, directory, session, config, physicalSource, physicalTransfer string, physicalMTU int) (failure error) {
	return routerVPNRunNodeMTUCaptured(parent, directory, session, config, physicalSource, physicalTransfer, physicalMTU, nil)
}

func routerVPNRunNodeMTUCaptured(parent context.Context, directory, session, config, physicalSource, physicalTransfer string, physicalMTU int, journal routerVPNNodeJournal) error {
	return routerVPNRunNodeMTUFamilyCaptured(parent, directory, session, config, physicalSource, "", physicalTransfer, physicalMTU, journal)
