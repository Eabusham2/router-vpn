func desktopTypedCandidateReject(t *testing.T, family, fault string) {
	desktopTypedCandidateCase(t, family, 3, "admission-"+fault, func() {
		f := newDesktopTypedCandidateFixture(t, family, 3, nil)
		var initial error
		if f.socks != nil {
			initial = f.socks.candidateRequestCurrent(context.Background(), f.request)
		} else {
			initial = f.connect.candidateRequestCurrent(context.Background(), f.connectRequest)
		}
		if initial != nil {
			t.Fatal("admission negative lost its valid original baseline", initial)
		}
		rewrite := false
		switch fault {
		case "generic-request", "generic-source", "generic-live":
			name := map[string]string{"generic-request": "node-chain-candidate-request.json", "generic-source": "node-chain-candidate-source.json", "generic-live": "node-chain-candidate-live.json"}[fault]
			if err := os.WriteFile(filepath.Join(f.files.root.Name(), name), []byte("{}"), 0600); err != nil {
				t.Fatal(err)
			}
		case "ready-kind":
			if f.socks != nil {
				f.request.Capture.Kind = "routervpn-node-chain-connect-ready-v1"
			} else {
				f.connectRequest.Capture.Kind = "routervpn-node-chain-socks-ready-v1"
			}
			rewrite = true
		case "ready-reader":
			if f.socks != nil {
				f.request.Capture.Reader++
			} else {
				f.connectRequest.Capture.Reader++
			}
			rewrite = true
		case "ready-network":
			if f.socks != nil {
				f.request.Capture.Identity.NetworkID = "foreign-network"
			} else {
				f.connectRequest.Capture.Identity.NetworkID = "foreign-network"
			}
			rewrite = true
		case "capture":
			if f.socks != nil {
				f.request.CaptureSHA = strings.Repeat("f", 64)
			} else {
				f.connectRequest.CaptureSHA = strings.Repeat("f", 64)
			}
			rewrite = true
		case "source-object":
			// The native observer boundary is atomic so the actual proof
			// observer can detect substitution without a fixture data race.
			if f.socks != nil {
				old := f.engine.socks.Load()
				clone := *old
				f.engine.socks.Store(&clone)
				defer f.engine.socks.Store(old)
			} else {
				old := f.engine.connect.Load()
				clone := *old
				f.engine.connect.Store(&clone)
				defer f.engine.connect.Store(old)
			}
		case "config-bytes":
			path := filepath.Join(f.files.root.Name(), "sing-box.json")
			old, err := os.ReadFile(path)
			if err != nil {
				t.Fatal(err)
			}
			if err := os.WriteFile(path, append(append([]byte(nil), old...), byte('\n')), 0600); err != nil {
				t.Fatal(err)
			}
			defer os.WriteFile(path, old, 0600)
		case "inventory-bytes":
			var source mobilemultihop.NodeChainCandidateInventory
			if json.Unmarshal(f.inventory, &source) != nil {
				t.Fatal("inventory unavailable")
			}
			source.Revision = "replacement-catalog"
			raw, _ := json.Marshal(source)
			if err := os.WriteFile(filepath.Join(f.files.root.Name(), "node-chain-typed-candidate-source.json"), raw, 0600); err != nil {
				t.Fatal(err)
			}
		case "state":
			if f.socks != nil {
				old := f.socks.state.Load()
				f.socks.state.Store(f.socks.newState())
				defer func() { f.socks.state.Load().cancel(); f.socks.state.Store(old) }()
			} else {
				old := f.connect.state.Load()
				f.connect.state.Store(f.connect.newState())
				defer func() { f.connect.state.Load().cancel(); f.connect.state.Store(old) }()
			}
		case "box-owner":
			original := f.base.instance
			replacement, _ := desktopTypedCandidateBox(t, f.base.tag, f.mtu.record.MTU)
			f.base.instance = replacement
			defer func() { f.base.instance = original }()
		case "mtu-active":
			f.mtu.record.Active = true
			defer func() { f.mtu.record.Active = false }()
		case "throughput":
			if f.socks != nil {
				f.socks.measurement = &routerVPNDesktopSOCKSMeasurement{}
				defer func() { f.socks.measurement = nil }()
			} else {
				f.connect.measurement = &routerVPNDesktopCONNECTMeasurement{}
				defer func() { f.connect.measurement = nil }()
			}
		case "measurement-hold":
			if f.socks != nil {
				f.socks.measurementHold.Store(true)
				defer f.socks.measurementHold.Store(false)
			} else {
				f.connect.measurementHold.Store(true)
				defer f.connect.measurementHold.Store(false)
			}
		default:
			t.Fatal("unknown typed admission fault")
		}
		if rewrite {
			if f.socks != nil {
				f.raw, _ = json.Marshal(f.request)
			} else {
				f.raw, _ = json.Marshal(f.connectRequest)
			}
			if err := os.WriteFile(filepath.Join(f.files.root.Name(), "node-chain-typed-candidate-request.json"), f.raw, 0600); err != nil {
				t.Fatal(err)
			}
		}
		if err := f.poll(context.Background()); err == nil || f.active() {
			t.Fatal("typed candidate admitted a foreign source, Ready, Box, or activity owner", fault, err)
		}
		if _, err := f.files.root.Lstat("node-chain-typed-candidate-result.json"); !os.IsNotExist(err) {
			t.Fatal("refused typed admission published a result", err)
		}
	})
}
