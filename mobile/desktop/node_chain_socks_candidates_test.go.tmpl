// The parent controller renews its captured catalog independently while the
// native command performs synchronous admission and worker observations. Keep
// that producer independent here too; a single-threaded initial poll otherwise
// lets an honestly captured pulse expire before admission finishes. Only the
// positive fifty-connect cases use this producer. Fault/ABA/cancellation cases
// retain their deliberately controlled pulses below.
func (f *desktopTypedCandidateFixture) startControllerPulse() (func() error, error) {
	name := "node-chain-typed-candidate-source.json"
	original, err := f.files.root.Lstat(name)
	if err != nil {
		return nil, err
	}
	deadline := f.request.Deadline
	sourceName, expectedSource := "node-chain-socks-source.json", ""
	if f.socks != nil {
		expectedSource = f.socks.input
	} else {
		deadline = f.connectRequest.Deadline
		sourceName, expectedSource = "node-chain-connect-source.json", f.connect.input
	}
	sourceInfo, err := f.files.root.Lstat(sourceName)
	if err != nil {
		return nil, err
	}
	// The real controller and native command are different processes. Give this
	// producer its own directory handle and publication ownership map as well;
	// sharing f.files would race the command's result/Ready publications.
	controller, err := routerVPNOpenExternalFiles(f.files.root.Name())
	if err != nil {
		return nil, err
	}
	originalRoot, rootErr := f.files.root.Stat(".")
	controllerRoot, controllerErr := controller.root.Stat(".")
	pulseName := "node-chain-typed-candidate-live.json"
	originalPulse := f.files.owned[pulseName]
	controllerPulse, pulseErr := controller.root.Lstat(pulseName)
	if rootErr != nil || controllerErr != nil || !os.SameFile(originalRoot, controllerRoot) ||
		originalPulse == nil || pulseErr != nil || !controllerPulse.Mode().IsRegular() || !os.SameFile(originalPulse, controllerPulse) {
		return nil, errors.Join(errors.New("controller pulse lost its original directory or staged inode"), controller.root.Close())
	}
	// Transfer only the proven staged pulse before either concurrent producer
	// starts. The native owner must never remove the controller's replacement.
	controller.owned[pulseName] = controllerPulse
	delete(f.files.owned, pulseName)
	publish := func() error {
		info, statErr := controller.root.Lstat(name)
		raw, readErr := controller.read(name, mobilemultihop.NodeChainInputLimit)
		currentSource, sourceStatErr := controller.root.Lstat(sourceName)
		source, sourceReadErr := controller.read(sourceName, mobilemultihop.NodeChainInputLimit)
		valid := statErr == nil && readErr == nil && os.SameFile(original, info) && bytes.Equal(raw, f.inventory) &&
			sourceStatErr == nil && sourceReadErr == nil && os.SameFile(sourceInfo, currentSource) && string(source) == expectedSource &&
			f.valid.Load() && f.state() == f.originalState
		clear(raw)
		clear(source)
		if !valid {
			return errors.New("controller pulse lost its original catalog, source or state")
		}
		f.pulseMu.Lock()
		defer f.pulseMu.Unlock()
		now := time.Now().UnixMilli()
		if now > deadline {
			return context.DeadlineExceeded
		}
		f.pulse.Sequence++
		f.pulse.ObservedAt = now
		return controller.publish(pulseName, f.pulse)
	}
	if err := publish(); err != nil {
		return nil, errors.Join(err, controller.root.Close())
	}
	stop, joined := make(chan struct{}), make(chan struct{})
	var once sync.Once
	var failure error
	go func() {
		defer close(joined)
		defer func() { failure = errors.Join(failure, controller.root.Close()) }()
		ticker := time.NewTicker(100 * time.Millisecond)
		defer ticker.Stop()
		for {
			select {
			case <-stop:
				return
			case <-ticker.C:
				if failure = publish(); failure != nil {
					return
				}
			}
		}
	}()
	return func() error { once.Do(func() { close(stop) }); <-joined; return failure }, nil
}

func (f *desktopTypedCandidateFixture) logAdmissionPulse(t *testing.T) {
	t.Helper()
	raw, readErr := f.files.read("node-chain-typed-candidate-live.json", 4096)
	var pulse routerVPNDesktopSOCKSCandidatePulse
	parseErr := json.Unmarshal(raw, &pulse)
	f.pulseMu.Lock()
	original := f.pulse
	f.pulseMu.Unlock()
	t.Logf("original catalog admission: read=%v parse=%v age_ms=%d sequence=%d same_request=%t same_capture=%t same_revision=%t same_state=%t measurement_hold=%t",
		readErr, parseErr, time.Now().UnixMilli()-pulse.ObservedAt, pulse.Sequence,
		pulse.Request == original.Request, pulse.CaptureSHA == f.capture, pulse.Revision == original.Revision,
		f.state() == f.originalState, f.hold())
}
func (f *desktopTypedCandidateFixture) status(t *testing.T) hopmeasure.CandidateStatus {
	t.Helper()
	var status hopmeasure.CandidateStatus
	var body string
	if f.socks != nil {
		body = f.socks.candidates.service.StatusContextJSON(context.Background())
	} else {
		body = f.connect.candidates.service.StatusContextJSON(context.Background())
