func (f *desktopTypedCandidateFixture) result(t *testing.T) hopmeasure.CandidateStatus {
	t.Helper()
	body, err := f.files.read("node-chain-typed-candidate-result.json", 128<<10)
	if err != nil {
		t.Fatal(err)
	}
	if f.socks != nil {
		var result routerVPNDesktopSOCKSCandidateResult
		if json.Unmarshal(body, &result) != nil || result.routerVPNDesktopSOCKSCandidateRequest != f.request {
			t.Fatal("typed SOCKS result changed captured request")
		}
		return result.Status
	}
	var result routerVPNDesktopCONNECTCandidateResult
	if json.Unmarshal(body, &result) != nil || result.routerVPNDesktopCONNECTCandidateRequest != f.connectRequest {
		t.Fatal("typed CONNECT result changed captured request")
	}
	return result.Status
}

// Each subprocess owns its standard-library TLS fallback pool. The parent Go
// test still reports every exact required root/leaf; a child refusal is fatal.
func desktopTypedCandidateCase(t *testing.T, family string, count int, fault string, run func()) {
	t.Helper()
	key := fmt.Sprintf("%s/%d/%s", family, count, fault)
	if selected := os.Getenv("ROUTERVPN_TYPED_CONNECTED_CANDIDATE_CASE"); selected != "" {
		if selected != key {
			t.Fatal("foreign typed candidate child")
		}
		run()
		return
	}
	image, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 125*time.Second)
	defer cancel()
	command := exec.CommandContext(ctx, image, "-test.run=^"+strings.ReplaceAll(t.Name(), "/", "$/^")+"$", "-test.timeout=120s")
	command.Env = append(os.Environ(), "ROUTERVPN_TYPED_CONNECTED_CANDIDATE_CASE="+key)
	if output, err := command.CombinedOutput(); err != nil {
		t.Fatalf("typed candidate child failed: %v\n%s", err, output)
	}
}

func desktopTypedCandidateFifty(t *testing.T, family string, count int) {
	desktopTypedCandidateCase(t, family, count, "fifty", func() {
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		var accepted, dials atomic.Int64
		acceptedAll := make(chan struct{})
		joined := make(chan struct{})
		go func() {
			defer close(joined)
			for {
				conn, err := listener.Accept()
				if err != nil {
					return
				}
				if accepted.Add(1) == 50 {
					close(acceptedAll)
				}
				_ = conn.Close()
			}
		}()
		defer func() { _ = listener.Close(); <-joined }()
		var f *desktopTypedCandidateFixture
		route := func(ctx context.Context, tag, address string) (net.Conn, bool, error) {
			if f == nil || address != f.address {
				return nil, false, nil
			}
			if tag != f.tag {
				return nil, true, errors.New("typed candidate bypassed original prefix")
			}
			dials.Add(1)
			conn, err := (&net.Dialer{}).DialContext(ctx, "tcp", listener.Addr().String())
			return conn, true, err
		}
		f = newDesktopTypedCandidateFixture(t, family, count, route)
		stopPulse, err := f.startControllerPulse()
		if err != nil {
			t.Fatal("original controller pulse admission", err)
		}
		defer func() {
			if err := stopPulse(); err != nil {
				t.Error("original controller pulse did not retain its source or join", err)
			}
		}()
		if err := f.poll(context.Background()); err != nil {
			f.logAdmissionPulse(t)
			t.Fatal("typed candidate admission", err)
		}
		deadline := time.Now().Add(hopmeasure.RequestTimeout)
		for f.active() {
			if time.Now().After(deadline) {
				t.Fatal("typed fifty failed original request bound")
			}
			if err := f.poll(context.Background()); err != nil {
				f.logAdmissionPulse(t)
				t.Fatal("typed candidate poll", err)
			}
			time.Sleep(time.Millisecond)
		}
		status := f.result(t)
		select {
		case <-acceptedAll:
		case <-time.After(time.Second):
			t.Fatal("typed destination accept did not join all fifty connects")
		}
		if dials.Load() != 50 || accepted.Load() != 50 || !status.Complete || !status.Drained || status.Failure != "" || len(status.Results) != 1 || !status.Results[0].Ready || status.Results[0].Benchmark == nil || status.Results[0].Benchmark.Attempts != 50 || status.Results[0].Benchmark.Distribution.Samples != 50 || status.PrefixPosition != count-3 || status.CaptureSHA256 != f.capture || status.Measurement != "routed-tcp-connect" {
			t.Fatal("typed original mailbox lost fifty destination connections", dials.Load(), accepted.Load(), status)
		}
		if f.hold() || f.state() != f.originalState || f.current(context.Background()) != nil {
			t.Fatal("typed candidate replaced complete original state")
		}
		if _, err := f.files.root.Lstat("node-chain-typed-candidate-request.json"); !os.IsNotExist(err) {
			t.Fatal("typed request removed before original drain or retained after completion", err)
		}
	})
}

