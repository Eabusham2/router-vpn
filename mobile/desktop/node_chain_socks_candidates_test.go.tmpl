// The shipping typed command owner, real typed proof, TLS/private HTTP checks,
// candidate service, mailbox, Box inbound manager and MTU readback run here.
// Only encrypted packet transport and the kernel TUN are explicit models. The
// production attachMTU/physical preparation and installed network acceptance
// remain required independent native host gates; these models cannot earn them.
type desktopTypedCandidateTUN struct {
	*desktopMTUTUNFixture
	closed atomic.Bool
}

func (*desktopTypedCandidateTUN) Start(adapter.StartStage) error { return nil }
func (t *desktopTypedCandidateTUN) Close() error                 { t.closed.Store(true); return nil }

type desktopTypedCandidateEngine struct {
	identity             mobilemultihop.NodeChainIdentity
	current              func(context.Context) error
	socks                atomic.Pointer[mobilemultihop.NodeChainSOCKSSource]
	connect              atomic.Pointer[mobilemultihop.NodeChainCONNECTSource]
	dns                  mobilemultihop.NodeChainDNSCapture
	final, middle        string
	peers                map[string]string
	public, middlePublic string
	selected             atomic.Value
	candidate            func(context.Context, string, string) (net.Conn, bool, error)
}

func (e *desktopTypedCandidateEngine) ObserveChainContext(ctx context.Context) (mobilemultihop.NodeChainIdentity, error) {
	if err := e.current(ctx); err != nil {
		return mobilemultihop.NodeChainIdentity{}, err
	}
	return e.identity, nil
}
func (e *desktopTypedCandidateEngine) ObserveSOCKSMiddleContext(ctx context.Context, source *mobilemultihop.NodeChainSOCKSSource) error {
	if source == nil || source != e.socks.Load() {
		return routerVPNExternalFailure
	}
	return e.current(ctx)
}
func (e *desktopTypedCandidateEngine) ObserveCONNECTMiddleContext(ctx context.Context, source *mobilemultihop.NodeChainCONNECTSource) error {
	if source == nil || source != e.connect.Load() {
		return routerVPNExternalFailure
	}
	return e.current(ctx)
}
func (e *desktopTypedCandidateEngine) SelectContext(ctx context.Context, tag string) error {
	if tag != e.final || e.current(ctx) != nil {
		return routerVPNExternalFailure
	}
	e.selected.Store(tag)
	return nil
}
func (e *desktopTypedCandidateEngine) SelectedContext(ctx context.Context) (string, error) {
	value, _ := e.selected.Load().(string)
	return value, e.current(ctx)
}
func (e *desktopTypedCandidateEngine) DNSProofContext(ctx context.Context, dns mobilemultihop.NodeChainDNSCapture) error {
	if dns != e.dns {
		return errors.New("modeled DNS observer lost exact final resolver")
	}
	return e.current(ctx)
}
func (e *desktopTypedCandidateEngine) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	if err := e.current(ctx); err != nil {
		return nil, err
	}
	if e.candidate != nil {
		if conn, handled, err := e.candidate(ctx, tag, address); handled {
			return conn, err
		}
	}
	target := e.peers[tag+"/"+address]
	if address == "1.1.1.1:443" {
		if tag == e.final {
			target = e.public
		} else if tag == e.middle {
			target = e.middlePublic
		}
	}
	if target == "" {
		return nil, errors.New("typed fixture refused an uncaptured tag or destination")
	}
	return (&net.Dialer{}).DialContext(ctx, "tcp", target)
}

// Produce complete sources with the real published constructors. The only
// companion added for CONNECT is its separately authenticated SS UoT-v2 asset.
func desktopTypedCandidateSource(t *testing.T, family string, count int) mobilemultihop.NodeChainSource {
	t.Helper()
	paired := desktopNodeChainCommandPolicyWithIdentity(t, count, "linux", 0, true).OriginalChain()
	input, err := paired.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(input), &source) != nil {
		t.Fatal("original paired source unavailable")
	}
	var capture, graph map[string]any
	if json.Unmarshal([]byte(desktopExternalCapture), &capture) != nil || json.Unmarshal([]byte(desktopExternalSource), &graph) != nil {
		t.Fatal("original imported fixture unavailable")
	}
	profile := capture["profile"].(map[string]any)
	profile["kill_switch_policy"] = "always"
	if family != "socks" {
		protocol := family + "-connect"
		capture["protocol"] = protocol
		external := profile["external"].(map[string]any)
		proxy := external["socks5"].(map[string]any)
		delete(external, "socks5")
		external[protocolKey(family)], external["protocol"] = proxy, protocol
		out := graph["outbounds"].([]any)[0].(map[string]any)
		delete(out, "version")
		out["type"] = "http"
		if family == "https" {
			proxy["tls_server_name"] = "original-proxy.example"
			out["tls"] = map[string]any{"enabled": true, "server_name": "original-proxy.example"}
		}
	}
	selected, _ := json.Marshal(capture)
	transport, _ := json.Marshal(graph)
	position := count - 2
	if family == "socks" {
		source.Schema = 3
		source.Nodes[position], err = mobilemultihop.NodeChainImportedSOCKSMemberInput(string(transport), string(selected))
	} else {
		source.Schema = 4
		source.Nodes[position], err = mobilemultihop.NodeChainImportedCONNECTMemberInput(string(transport), string(selected))
		source.Nodes[count-1] = desktopTypedCandidateUoTFinal(t, source.Nodes[count-1])
	}
	if err != nil {
		t.Fatal("original typed member constructor", err)
	}
	source.IdentitySources[position] = ""
	return source
}
func protocolKey(family string) string {
	if family == "https" {
		return "https_connect"
	}
	return "http_connect"
}
func desktopTypedCandidateUoTFinal(t *testing.T, input string) string {
	t.Helper()
	var node map[string]any
	if json.Unmarshal([]byte(input), &node) != nil {
		t.Fatal("paired final input unavailable")
	}
	var assets map[string]string
	if json.Unmarshal([]byte(node["files"].(string)), &assets) != nil {
		t.Fatal("paired final assets unavailable")
	}
	raw, err := base64.StdEncoding.DecodeString(assets["sing-box.json"])
	if err != nil {
		t.Fatal(err)
	}
	var graph, profile map[string]any
	if json.Unmarshal(raw, &graph) != nil || json.Unmarshal([]byte(node["profile_json"].(string)), &profile) != nil {
		t.Fatal("paired final profile unavailable")
	}
	out := graph["outbounds"].([]any)[0].(map[string]any)
	configHash, keyHash := sha256.Sum256(raw), sha256.Sum256([]byte(out["password"].(string)))
	declaration, _ := json.Marshal(map[string]any{"schema": 1, "node_id": profile["node_proof_id"], "configured_image": nativecomposite.SSServiceImage, "uot_version": 2, "endpoint": out["server"], "port": out["server_port"], "method": out["method"], "source_sha256": hex.EncodeToString(configHash[:]), "key_sha256": hex.EncodeToString(keyHash[:])})
	if nativecomposite.ValidateSSServiceCompanion(raw, declaration, profile["node_proof_id"].(string)) != nil {
		t.Fatal("original final companion unavailable")
	}
	assets[nativecomposite.SSServiceAsset] = base64.StdEncoding.EncodeToString(declaration)
	files, _ := json.Marshal(assets)
	value := func(key string) string { s, _ := node[key].(string); return s }
	final, err := mobilemultihop.NewNodeProfile(value("mode"), string(files), value("profile_json"), value("start"), value("dns_bootstrap"))
	if err != nil {
		t.Fatal(err)
	}
	result, err := final.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	return result
}

func desktopTypedCandidateTLS(t *testing.T, ip string) *httptest.Server {
	t.Helper()
	public, private, err := ed25519.GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	certificate := &x509.Certificate{SerialNumber: big.NewInt(19), NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), IPAddresses: []net.IP{net.ParseIP("1.1.1.1")}, IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
	der, err := x509.CreateCertificate(rand.Reader, certificate, certificate, public, private)
	if err != nil {
		t.Fatal(err)
	}
	roots := x509.NewCertPool()
	root := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
	if !roots.AppendCertsFromPEM(root) {
		t.Fatal("actual TLS fixture root invalid")
	}
	ca := filepath.Join(t.TempDir(), "candidate-public.pem")
	if os.WriteFile(ca, root, 0600) != nil {
		t.Fatal("TLS fixture root write failed")
	}
	t.Setenv("SSL_CERT_FILE", ca)
	t.Setenv("GODEBUG", os.Getenv("GODEBUG")+",x509usefallbackroots=1")
	x509.SetFallbackRoots(roots)
	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Host != "1.1.1.1" || r.URL.Path != "/cdn-cgi/trace" || len(r.URL.Query().Get("routervpn_proof")) != 32 || r.Header.Get("Authorization") != "" {
			http.Error(w, "unowned public proof", 403)
			return
		}
		fmt.Fprint(w, "ip="+ip+"\n")
	}))
	server.TLS = &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: private}}}
	server.StartTLS()
	t.Cleanup(server.Close)
	return server
}

func desktopTypedCandidateBox(t *testing.T, tag string, mtu int) (*box.Box, *desktopTypedCandidateTUN) {
	t.Helper()
	tun := &desktopTypedCandidateTUN{desktopMTUTUNFixture: &desktopMTUTUNFixture{tag: tag, name: "router-vpn", index: 37, mtu: mtu}}
	registry := include.InboundRegistry()
	inbound.Register[option.TunInboundOptions](registry, C.TypeTun, func(context.Context, adapter.Router, log.ContextLogger, string, option.TunInboundOptions) (adapter.Inbound, error) {
		return tun, nil
	})
	ctx := box.Context(context.Background(), registry, include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
	graph, _ := json.Marshal(map[string]any{"log": map[string]any{"disabled": true}, "inbounds": []any{map[string]any{"type": "tun", "tag": tag, "mtu": mtu, "auto_route": false}}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}}, "route": map[string]any{"final": "direct"}})
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, graph)
	if err != nil {
		t.Fatal(err)
	}
	instance, err := box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal("actual Box manager construction", err)
	}
	t.Cleanup(func() {
		if err := instance.Close(); err != nil {
			t.Error("original component Box did not close", err)
		}
	})
	return instance, tun
}

type desktopTypedCandidateFixture struct {
	family                        string
	count                         int
	source                        mobilemultihop.NodeChainSource
	socks                         *routerVPNDesktopSOCKSRuntime
	connect                       *routerVPNDesktopCONNECTRuntime
	socksProof                    *mobilemultihop.NodeChainSOCKSRuntime
	connectProof                  *mobilemultihop.NodeChainCONNECTRuntime
	engine                        *desktopTypedCandidateEngine
	files                         *routerVPNExternalFiles
	mtu                           *routerVPNNodeMTU
	base                          *routerVPNNodeMTUBox
	instance                      *box.Box
	tun                           *desktopTypedCandidateTUN
	inventory                     []byte
	target, tag, address, capture string
	raw                           []byte
	pulse                         routerVPNDesktopSOCKSCandidatePulse
	pulseMu                       sync.Mutex
	request                       routerVPNDesktopSOCKSCandidateRequest
	connectRequest                routerVPNDesktopCONNECTCandidateRequest
	originalState                 any
	current, close, poll          func(context.Context) error
	heartbeat                     func(context.Context, routerVPNNodeMTURecord) error
	hold                          func() bool
	active                        func() bool
	state                         func() any
	blocked                       func() error
	closeOnly                     func(context.Context) error
	valid                         atomic.Bool
}

func newDesktopTypedCandidateFixture(t *testing.T, family string, count int, route func(context.Context, string, string) (net.Conn, bool, error)) *desktopTypedCandidateFixture {
	t.Helper()
	f := &desktopTypedCandidateFixture{family: family, count: count, source: desktopTypedCandidateSource(t, family, count)}
	f.valid.Store(true)
	canonical, _ := json.Marshal(f.source)
	var proofs []mobilemultihop.NodeChainProof
	var dns mobilemultihop.NodeChainDNSCapture
	var sourceSHA, configSHA, session, config, input string
	var ceiling int
	var err error
	if family == "socks" {
		original, e := mobilemultihop.NewNodeChainSOCKSSource(string(canonical))
		if e != nil {
			t.Fatal(e)
		}
		policy, e := mobilemultihop.NewDesktopNodeChainSOCKSPolicy(original, desktopExternalSession, "linux", 0)
		if e != nil {
			t.Fatal(e)
		}
		construction, e := routerVPNNewDesktopSOCKSConstruction(desktopSOCKSCommandContext(context.Background()), policy)
		if e != nil {
			t.Fatal(e)
		}
		f.socksProof, e = mobilemultihop.NewNodeChainSOCKSRuntime(construction.source)
		if e != nil {
			t.Fatal(e)
		}
		_, meta, e := construction.source.ReadValidated()
		if e != nil {
			t.Fatal(e)
		}
		proofs, dns, sourceSHA, configSHA, ceiling = meta.Proofs, meta.DNS, meta.SourceSHA256, meta.ConfigSHA256, meta.MTU.Ceiling
		session, config = construction.metadata.SessionID, construction.config
		input, err = policy.LaunchInput()
		if err != nil {
			t.Fatal(err)
		}
		f.files = desktopImportedCommandFiles(t, map[string]string{"node-chain-socks-source.json": input, "sing-box.json": config})
		f.engine = &desktopTypedCandidateEngine{}
		f.engine.socks.Store(construction.source)
		f.socks, err = routerVPNNewDesktopSOCKSRuntimeFactory(context.Background(), f.files, construction, strings.Repeat("d", 64), func(ctx context.Context, s *mobilemultihop.NodeChainSOCKSSource, current func(context.Context) error) (routerVPNDesktopSOCKSProof, mobilemultihop.NodeChainSOCKSEngine, error) {
			if s != construction.source {
				return nil, nil, routerVPNExternalFailure
			}
			f.engine.current = current
			return f.socksProof, f.engine, ctx.Err()
		}, func(ctx context.Context) error {
			if !f.valid.Load() {
				return routerVPNExternalFailure
			}
			return ctx.Err()
		})
		f.current, f.close, f.poll, f.heartbeat = f.socks.current, f.socks.close, f.socks.pollMeasurement, f.socks.heartbeat
		f.hold = f.socks.measurementHold.Load
		f.active = func() bool { return f.socks.candidates != nil }
		f.state = func() any { return f.socks.state.Load() }
		f.closeOnly = f.socks.closeCandidates
		f.blocked = func() error {
			activity, e := f.socks.claimActivity(context.Background())
			if activity != nil {
				activity.release()
			}
			return e
		}
	} else {
		original, e := mobilemultihop.NewNodeChainCONNECTSource(string(canonical))
		if e != nil {
			t.Fatal(e)
		}
		policy, e := mobilemultihop.NewDesktopNodeChainCONNECTPolicy(original, desktopExternalSession, "linux", 0)
		if e != nil {
			t.Fatal(e)
		}
		construction, e := routerVPNNewDesktopCONNECTConstruction(desktopCONNECTCommandContext(context.Background()), policy)
		if e != nil {
			t.Fatal(e)
		}
		f.connectProof, e = mobilemultihop.NewNodeChainCONNECTRuntime(construction.source)
		if e != nil {
			t.Fatal(e)
		}
		_, meta, e := construction.source.ReadValidated()
		if e != nil {
			t.Fatal(e)
		}
		proofs, dns, sourceSHA, configSHA, ceiling = meta.Proofs, meta.DNS, meta.SourceSHA256, meta.ConfigSHA256, meta.MTU.Ceiling
		session, config = construction.metadata.SessionID, construction.config
		input, err = policy.LaunchInput()
		if err != nil {
			t.Fatal(err)
		}
		f.files = desktopImportedCommandFiles(t, map[string]string{"node-chain-connect-source.json": input, "sing-box.json": config})
		f.engine = &desktopTypedCandidateEngine{}
		f.engine.connect.Store(construction.source)
		f.connect, err = routerVPNNewDesktopCONNECTRuntimeFactory(context.Background(), f.files, construction, strings.Repeat("d", 64), func(ctx context.Context, s *mobilemultihop.NodeChainCONNECTSource, current func(context.Context) error) (routerVPNDesktopCONNECTProof, mobilemultihop.NodeChainCONNECTEngine, error) {
			if s != construction.source {
				return nil, nil, routerVPNExternalFailure
			}
			f.engine.current = current
			return f.connectProof, f.engine, ctx.Err()
		}, func(ctx context.Context) error {
			if !f.valid.Load() {
				return routerVPNExternalFailure
			}
			return ctx.Err()
		})
		f.current, f.close, f.poll, f.heartbeat = f.connect.current, f.connect.close, f.connect.pollMeasurement, f.connect.heartbeat
		f.hold = f.connect.measurementHold.Load
		f.active = func() bool { return f.connect.candidates != nil }
		f.state = func() any { return f.connect.state.Load() }
		f.closeOnly = f.connect.closeCandidates
		f.blocked = func() error {
			activity, e := f.connect.claimActivity(context.Background())
			if activity != nil {
				activity.release()
			}
			return e
		}
	}
	if err != nil {
		t.Fatal(err)
	}
	f.engine.identity = mobilemultihop.NodeChainIdentity{EngineID: "original-typed-box", NetworkID: "original-typed-network", SessionID: session, SourceSHA256: sourceSHA, ConfigSHA256: configSHA}
	f.engine.final, f.engine.middle, f.engine.dns = proofs[count-1].Tag, proofs[count-2].Tag, dns
	f.engine.peers = map[string]string{}
	f.engine.candidate = route
	// One actual TLS server answers both public probes with the captured middle
	// identity; the final has no separately prescribed public address here.
	server := desktopTypedCandidateTLS(t, "203.0.113.88")
	f.engine.public, f.engine.middlePublic = server.Listener.Addr().String(), server.Listener.Addr().String()
	for position, proof := range proofs {
		if position == count-2 {
			continue
		}
		var member, profile map[string]any
		if json.Unmarshal([]byte(f.source.Nodes[position]), &member) != nil || json.Unmarshal([]byte(member["profile_json"].(string)), &profile) != nil {
			t.Fatal("actual private source missing")
		}
		api, e := url.Parse(profile["router_api"].(string))
		if e != nil {
			t.Fatal(e)
		}
		token := profile["api_token"].(string)
		peer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if r.Host != api.Host || r.URL.Path != "/health" || r.Header.Get("Authorization") != "Bearer "+token {
				http.Error(w, "changed private proof", 401)
				return
			}
			_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "node_id": proof.NodeID, "proof": "router-vpn-private-agent-v1"})
		}))
		t.Cleanup(peer.Close)
		f.engine.peers[proof.Tag+"/"+api.Host] = peer.Listener.Addr().String()
	}
	startup, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	if f.socks != nil {
		err = f.socks.run(startup)
	} else {
		err = f.connect.run(startup)
	}
	cancel()
	if err != nil {
		t.Fatal("complete original typed proofs", err)
	}
	f.originalState = f.state()
	f.instance, f.tun = desktopTypedCandidateBox(t, dns.TUNTag, min(1420, ceiling))
	f.base = &routerVPNNodeMTUBox{instance: f.instance, tag: dns.TUNTag}
	f.mtu, err = newRouterVPNNodeMTUContext(context.Background(), f.base, session, configSHA, strings.Repeat("e", 64), f.current)
	if err != nil {
		t.Fatal(err)
	}
	// The physical acquisition seam is explicit. These exact retained pointers
	// exercise the unchanged native wrapper/readback; no serialized Ready grants
	// a physical socket, TUN activation, or an attachMTU call in this component.
	if f.socks != nil {
		f.socks.instance = f.instance
		w := &routerVPNDesktopSOCKSMTU{owner: f.socks, raw: f.mtu, base: f.base}
		w.readback.Store(&routerVPNDesktopSOCKSMTUReadback{state: f.socks.state.Load(), inbound: f.mtu.inbound, record: f.mtu.record})
		f.socks.mtu.Store(w)
		f.mtu.execution = w
	} else {
		f.connect.instance = f.instance
		w := &routerVPNDesktopCONNECTMTU{owner: f.connect, raw: f.mtu, base: f.base}
		w.readback.Store(&routerVPNDesktopCONNECTMTUReadback{state: f.connect.state.Load(), inbound: f.mtu.inbound, record: f.mtu.record})
		f.connect.mtu.Store(w)
		f.mtu.execution = w
	}
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
		defer cancel()
		if err := f.close(ctx); err != nil {
			t.Error("typed original command owner did not join", err)
		}
	})
	f.inventory, err = json.Marshal(mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "typed-original-catalog-1", Inputs: []string{f.source.Nodes[count-1]}})
	if err != nil {
		t.Fatal(err)
	}
	if f.socks != nil {
		plan, e := mobilemultihop.NewNodeChainSOCKSConnectedCandidatePlan(f.socksProof, count-3, string(f.inventory))
		if e != nil {
			t.Fatal(e)
		}
		f.capture = plan.CaptureSHA256()
	} else {
		plan, e := mobilemultihop.NewNodeChainCONNECTConnectedCandidatePlan(f.connectProof, count-3, string(f.inventory))
		if e != nil {
			t.Fatal(e)
		}
		f.capture = plan.CaptureSHA256()
	}
	f.target, f.tag, f.address = proofs[count-1].ProfileID, proofs[count-3].Tag, fmt.Sprintf("198.51.100.%d:8388", count+9)
	f.stage(t)
	return f
}
func (f *desktopTypedCandidateFixture) stage(t *testing.T) {
	t.Helper()
	if err := f.heartbeat(context.Background(), f.mtu.record); err != nil {
		t.Fatal("typed heartbeat lost original Box reader", err)
	}
	sum := sha256.Sum256(f.inventory)
	q := routerVPNDesktopSOCKSCandidateRequest{Schema: 1, Request: strings.Repeat("a", 32), Generation: 1, Deadline: time.Now().Add(hopmeasure.RequestTimeout).UnixMilli(), Position: f.count - 3, Candidate: f.target, CaptureSHA: f.capture, InventorySHA: hex.EncodeToString(sum[:]), Path: f.mtu.record.Path}
	if f.socks != nil {
		raw, err := f.files.read("node-chain-socks-ready.json", 16384)
		if err != nil || json.Unmarshal(raw, &q.Capture) != nil {
			t.Fatal("actual SOCKS Ready missing", err)
		}
		f.request = q
		f.raw, _ = json.Marshal(q)
	} else {
		q2 := routerVPNDesktopCONNECTCandidateRequest{Schema: q.Schema, Request: q.Request, Generation: q.Generation, Deadline: q.Deadline, Position: q.Position, Candidate: q.Candidate, CaptureSHA: q.CaptureSHA, InventorySHA: q.InventorySHA, Path: q.Path}
		raw, err := f.files.read("node-chain-connect-ready.json", 16384)
		if err != nil || json.Unmarshal(raw, &q2.Capture) != nil {
			t.Fatal("actual CONNECT Ready missing", err)
		}
		f.connectRequest = q2
		f.raw, _ = json.Marshal(q2)
	}
	f.pulse = routerVPNDesktopSOCKSCandidatePulse{Schema: 1, Request: q.Request, CaptureSHA: f.capture, Revision: "typed-original-catalog-1", Sequence: 1, ObservedAt: time.Now().UnixMilli()}
	for name, raw := range map[string][]byte{"node-chain-typed-candidate-source.json": f.inventory, "node-chain-typed-candidate-request.json": f.raw} {
		if err := os.WriteFile(filepath.Join(f.files.root.Name(), name), raw, 0600); err != nil {
			t.Fatal(err)
		}
	}
	if err := f.files.publish("node-chain-typed-candidate-live.json", f.pulse); err != nil {
		t.Fatal(err)
	}
}
func (f *desktopTypedCandidateFixture) renew(t *testing.T) {
	t.Helper()
	f.pulseMu.Lock()
	defer f.pulseMu.Unlock()
	f.pulse.Sequence++
	f.pulse.ObservedAt = time.Now().UnixMilli()
	if err := f.files.publish("node-chain-typed-candidate-live.json", f.pulse); err != nil {
		t.Fatal(err)
	}
