var desktopTypedCandidateDrainFaults = []string{"cancel-drain", "catalog-aba", "retirement-drain", "replacement-state", "request-inode", "inventory-inode"}

func desktopTypedCandidateDrain(t *testing.T, family, fault string) {
	desktopTypedCandidateCase(t, family, 3, fault, func() {
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		joined := make(chan struct{})
		go func() {
			defer close(joined)
			for {
				conn, err := listener.Accept()
				if err != nil {
					return
				}
				_ = conn.Close()
			}
		}()
		defer func() { _ = listener.Close(); <-joined }()
		entered, release := make(chan struct{}), make(chan struct{})
		var once sync.Once
		unblock := func() { once.Do(func() { close(release) }) }
		defer unblock()
		var dials atomic.Int64
		var f *desktopTypedCandidateFixture
		route := func(ctx context.Context, tag, address string) (net.Conn, bool, error) {
			if f == nil || address != f.address {
				return nil, false, nil
			}
			if tag != f.tag {
				return nil, true, routerVPNExternalFailure
			}
			n := dials.Add(1)
			conn, err := (&net.Dialer{}).DialContext(ctx, "tcp", listener.Addr().String())
			if err == nil && n == 1 {
				return &desktopCandidateHeldClose{Conn: conn, entered: entered, release: release}, true, nil
			}
			return conn, true, err
		}
		f = newDesktopTypedCandidateFixture(t, family, 3, route)
		if err := f.poll(context.Background()); err != nil {
			t.Fatal("typed held candidate admission", err)
		}
		select {
		case <-entered:
		case <-time.After(5 * time.Second):
			t.Fatal("typed candidate did not enter original destination close")
		}
		if !f.hold() || f.blocked() == nil {
			t.Fatal("undrained typed candidate admitted competing MTU activity")
		}
		// An ordinary throughput request cannot steal this held typed operation.
		if err := os.WriteFile(filepath.Join(f.files.root.Name(), "node-chain-measure-request.json"), []byte("{}"), 0600); err != nil {
			t.Fatal(err)
		}
		if err := f.poll(context.Background()); err != nil {
			t.Fatal("typed hold failed to exclude ordinary throughput", err)
		}
		if f.socks != nil && f.socks.measurement != nil || f.connect != nil && f.connect.measurement != nil {
			t.Fatal("typed candidate allowed overlapping throughput")
		}
		if err := f.files.root.Remove("node-chain-measure-request.json"); err != nil {
			t.Fatal(err)
		}
		if fault == "retirement-drain" {
			ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
			err := f.close(ctx)
			cancel()
			if err == nil || !f.active() || !f.hold() || f.state() != f.originalState {
				t.Fatal("typed retirement abandoned an unjoined destination")
			}
			// A failed first close must retain the same original operation. Retrying
			// after the socket joins cannot create a candidate result or a new owner.
			unblock()
			ctx, cancel = context.WithTimeout(context.Background(), 3*time.Second)
			defer cancel()
			if err := f.close(ctx); err != nil || f.active() || f.hold() {
				t.Fatal("typed original retirement did not resume its own join", err)
			}
			if _, err := f.files.root.Lstat("node-chain-typed-candidate-result.json"); !os.IsNotExist(err) {
				t.Fatal("retired candidate gained a successful result", err)
			}
			return
		}
		if fault == "request-inode" || fault == "inventory-inode" {
			name := "node-chain-typed-candidate-request.json"
			body := f.raw
			if fault == "inventory-inode" {
				name = "node-chain-typed-candidate-source.json"
				body = f.inventory
			}
			replacement := name + ".replacement"
			if err := f.files.root.WriteFile(replacement, body, 0600); err != nil {
				t.Fatal(err)
			}
			// On Windows a path-based Lstat may resolve file identity lazily.
			// Capture both IDs from the directory's handles before the rename.
			old, err := f.files.root.Lstat(name)
			if err != nil {
				t.Fatal(err)
			}
			info, err := f.files.root.Lstat(replacement)
			if err != nil || os.SameFile(old, info) {
				t.Fatal("candidate replacement did not have an independent identity", err)
			}
			if err := f.files.root.Rename(replacement, name); err != nil {
				t.Fatal(err)
			}
			if f.poll(context.Background()) == nil {
				t.Fatal("typed candidate accepted a substituted original mailbox inode")
			}
			unblock()
			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
			defer cancel()
			if err := f.close(ctx); err != nil {
				t.Fatal("original inode refusal did not drain", err)
			}
			after, err := f.files.root.Lstat(name)
			current, readErr := f.files.read(name, mobilemultihop.NodeChainInputLimit)
			if err != nil || readErr != nil || !os.SameFile(info, after) || !bytes.Equal(current, body) {
				t.Fatal("old candidate cleanup changed the replacement inode or bytes", err, readErr)
			}
			return
		}
		if fault == "replacement-state" {
			// A different immutable state on the same command object cannot borrow
			// the old operation. Keep it inert and retire it separately after proving
			// that closeCandidates joins only the retained old service, not its state.
			var restore func()
			if f.socks != nil {
				old := f.socks.state.Load()
				replacement := f.socks.newState()
				f.socks.state.Store(replacement)
				restore = func() { replacement.cancel(); f.socks.state.Store(old) }
			} else {
				old := f.connect.state.Load()
				replacement := f.connect.newState()
				f.connect.state.Store(replacement)
				restore = func() { replacement.cancel(); f.connect.state.Store(old) }
			}
			defer restore()
			replacement := f.state()
			if f.poll(context.Background()) == nil {
				t.Fatal("typed candidate adopted a replacement command state")
			}
			ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
			err := f.closeOnly(ctx)
			cancel()
			if err == nil || !f.active() || !f.hold() || f.state() != replacement {
				t.Fatal("typed failed close lost old operation or touched replacement state")
			}
			unblock()
			ctx, cancel = context.WithTimeout(context.Background(), 3*time.Second)
			defer cancel()
			if err := f.closeOnly(ctx); err != nil || f.active() || f.hold() || f.state() != replacement {
				t.Fatal("typed cleanup replaced another command state", err)
			}
			return
		}
		if fault == "cancel-drain" {
			if err := os.WriteFile(filepath.Join(f.files.root.Name(), "node-chain-typed-candidate-cancel.json"), f.raw, 0600); err != nil {
				t.Fatal(err)
			}
		} else if fault == "catalog-aba" {
			f.pulse.Revision = "typed-away-catalog-2"
			f.renew(t)
		} else {
			t.Fatal("unknown typed drain fault")
		}
		if err := f.poll(context.Background()); err != nil {
			t.Fatal("typed cancel must retain healthy original command", err)
		}
		if !f.active() || !f.hold() {
			t.Fatal("typed cancellation published before original close joined")
		}
		unblock()
		if fault == "catalog-aba" {
			// Keep B visible until the real worker has observed it. Restoring A after
			// that observation must not revive this operation or grant a score.
			deadline := time.Now().Add(5 * time.Second)
			for {
				status := f.status(t)
				if status.Complete && status.Drained {
					if status.Failure == "" {
						t.Fatal("changed typed catalog retained a score")
					}
					break
				}
				if time.Now().After(deadline) {
					t.Fatal("catalog change did not join typed worker")
				}
				time.Sleep(time.Millisecond)
			}
			f.pulse.Revision = "typed-original-catalog-1"
			f.renew(t)
		}
		deadline := time.Now().Add(5 * time.Second)
		for f.active() {
			if time.Now().After(deadline) {
				t.Fatal("typed cancelled candidate failed to join")
			}
			f.renew(t)
			if err := f.poll(context.Background()); err != nil {
				t.Fatal("typed cancellation publication", err)
			}
			time.Sleep(time.Millisecond)
		}
		status := f.result(t)
		if status.Failure == "" || len(status.Results) != 0 || !status.Complete || !status.Drained || dials.Load() != 1 || f.hold() {
			t.Fatal("cancelled typed candidate or catalog A-to-B-to-A gained a score", status)
		}
		if f.state() != f.originalState || f.current(context.Background()) != nil {
			t.Fatal("typed candidate cancellation retired complete original connection")
		}
	})
}
func TestRouterVPNDesktopSOCKSConnectedCandidatesRetainsDrain(t *testing.T) {
	for _, fault := range desktopTypedCandidateDrainFaults {
		t.Run(fault, func(t *testing.T) { desktopTypedCandidateDrain(t, "socks", fault) })
	}
}
