var desktopTypedCandidateAdmissionFaults = []string{
	"generic-request", "generic-source", "generic-live", "ready-kind", "ready-reader", "ready-network",
	"source-object", "config-bytes", "inventory-bytes", "capture", "state", "box-owner", "mtu-active", "throughput", "measurement-hold",
