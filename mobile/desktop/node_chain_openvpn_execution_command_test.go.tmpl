// These are the actual shared fixture producer's independent private profiles.
// Construction remains closed: no endpoint, TUN or selected-path observation
// becomes ready merely because its original command input can be reconstructed.
func desktopOpenVPNExecutionCommandPreparation(t *testing.T, name, target, execution string) *mobilemultihop.NodeChainExecutionPreparation {
	t.Helper()
	directory := os.Getenv("ROUTERVPN_OPENVPN_EXECUTION_NATIVE_FIXTURES")
	if directory == "" {
		t.Fatal("actual shared OpenVPN execution fixtures are required")
	}
	raw, err := os.ReadFile(filepath.Join(directory, name+".json"))
	var source struct{ Local, Server string }
	if err != nil || json.Unmarshal(raw, &source) != nil || source.Local == "" || source.Server == "" {
		t.Fatal("original independent OpenVPN profiles missing", err)
	}
	local, err := mobilemultihop.NewNodeChain(source.Local)
	if err != nil {
		t.Fatal(err)
	}
	if _, err = mobilemultihop.NewNodeChainOpenVPNServerPolicy(source.Server); err != nil {
		t.Fatal(err)
	}
	original, err := mobilemultihop.NewDesktopNodeChainPolicy(local, strings.Repeat("a", 32), target, 0)
	if err != nil {
		t.Fatal(err)
	}
	prep, err := mobilemultihop.NewDesktopNodeChainOpenVPNExecutionPreparation(original, execution)
	if err != nil {
		t.Fatal(err)
	}
	return prep
}

func TestRouterVPNDesktopOpenVPNExecutionCommandOriginal(t *testing.T) {
	for _, target := range []string{"linux", "windows", "darwin"} {
		for _, name := range []string{"3-tcp", "3-udp", "4-tcp", "4-udp", "8-tcp", "8-udp"} {
			for _, execution := range []string{"server", "auto"} {
				t.Run(target+"/"+name+"/"+execution, func(t *testing.T) {
					prep := desktopOpenVPNExecutionCommandPreparation(t, name, target, execution)
					physical, err := routerVPNDesktopExecutionPhysicalPolicy(prep)
					if err != nil {
						t.Fatal(err)
					}
					_, meta, _, err := physical.PhysicalReadValidated()
					if err != nil || meta.Kind != "node-chain-openvpn-execution" || routerVPNDesktopExecutionPhysicalKind(prep) != meta.Kind {
						t.Fatal("typed physical owner missing", err)
					}
					files := desktopImportedCommandFiles(t, map[string]string{"node-chain-execution-source.json": prep.Source(), "sing-box.json": prep.Config()})
					actual, err := routerVPNNodeChainExecutionCommandCapture(files, meta.SessionID, meta.ConfigSHA256, meta.SourceSHA256, prep.SourceSHA256(), target)
					if err != nil || actual == nil || actual == prep || actual.Source() != prep.Source() || actual.Config() != prep.Config() || !actual.RequiresDesktopOpenVPNExecutionObserver() {
						t.Fatal("typed OpenVPN command lost original source", err)
					}
					if _, err := actual.DesktopPhysicalPolicy(); err == nil {
						t.Fatal("OpenVPN acquired generic physical authority")
					}
					if _, err := actual.SOCKSDesktopPhysicalPolicy(); err == nil {
						t.Fatal("OpenVPN acquired SOCKS physical authority")
					}
					if _, err := actual.CONNECTDesktopPhysicalPolicy(); err == nil {
						t.Fatal("OpenVPN acquired CONNECT physical authority")
					}
					owner, err := routerVPNNewDesktopOpenVPNExecutionConstruction(desktopSOCKSCommandContext(t.Context()), actual)
					if err != nil || owner == nil || owner.current(t.Context()) != nil {
						t.Fatal("original OpenVPN child construction refused", err)
					}
					retained, err := actual.OriginalOpenVPNSource()
					if err != nil || owner.source != retained || owner.policy.OriginalChain() != retained || owner.policy.NodeChain() != owner.native || owner.source == owner.native {
						t.Fatal("child substituted original plain/native sources", err)
					}
					parsed, err := SJ.UnmarshalExtendedContext[option.Options](owner.ctx, []byte(owner.config))
					if err != nil || parsed.Route == nil || parsed.Route.Final != mobilemultihop.NodeChainExecutionGateTag {
						t.Fatal("child lost closed actual native graph", err)
					}
					if _, err := box.RouterVPNNodeOpenVPNExecutionContext(owner.ctx, actual); err == nil {
						t.Fatal("original native context was rebound")
					}
					if _, err := routerVPNNewDesktopOpenVPNExecutionConstruction(owner.ctx, actual); err == nil {
						t.Fatal("child construction context was rebound")
					}
					if _, requested, err := routerVPNDesktopExecutionLastCapture(actual); err != nil || requested {
						t.Fatal("fresh command invented a saved winner", err)
					}
				})
			}
		}
	}
}

func TestRouterVPNDesktopOpenVPNExecutionCommandRefusal(t *testing.T) {
	prep := desktopOpenVPNExecutionCommandPreparation(t, "4-tcp", "linux", "auto")
	physical, _ := prep.OpenVPNDesktopPhysicalPolicy()
	_, meta, _, err := physical.PhysicalReadValidated()
	if err != nil {
		t.Fatal(err)
	}
	for _, fault := range []string{"mobile", "local", "schema-three", "schema-four", "schema-fraction", "duplicate-schema", "session", "config", "physical", "execution", "target", "graph", "paired-source", "socks-source", "connect-source"} {
		t.Run(fault, func(t *testing.T) {
			input, graph := prep.Source(), prep.Config()
			session, config, source, execution, target := meta.SessionID, meta.ConfigSHA256, meta.SourceSHA256, prep.SourceSHA256(), "linux"
			extra := map[string]string{}
			switch fault {
			case "mobile":
				local, e := prep.OriginalOpenVPNSource()
				if e != nil {
					t.Fatal(e)
				}
				mobile, e := mobilemultihop.NewNodeChainOpenVPNExecutionPreparation(local, "auto")
				if e != nil {
					t.Fatal(e)
				}
				input = mobile.Source()
			case "local":
				local, e := prep.OriginalOpenVPNSource()
				if e != nil {
					t.Fatal(e)
				}
				input, err = local.LaunchInput()
			case "schema-three", "schema-four", "schema-fraction", "duplicate-schema":
				before := `"schema":5`
				if strings.Count(input, before) != 1 {
					t.Fatal("exact typed schema anchor changed")
				}
				after := map[string]string{"schema-three": `"schema":3`, "schema-four": `"schema":4`, "schema-fraction": `"schema":5.0`, "duplicate-schema": `"schema":5,"schema":5`}[fault]
				input = strings.Replace(input, before, after, 1)
			case "session":
				session = strings.Repeat("b", 32)
			case "config":
				config = strings.Repeat("b", 64)
			case "physical":
				source = strings.Repeat("b", 64)
			case "execution":
				execution = strings.Repeat("b", 64)
			case "target":
				target = "windows"
			case "graph":
				graph += "\n"
			case "paired-source":
				extra["node-chain-source.json"] = input
			case "socks-source":
				extra["node-chain-socks-source.json"] = input
			case "connect-source":
				extra["node-chain-connect-source.json"] = input
			}
			if err != nil {
				t.Fatal("invalid refusal fixture", err)
			}
			extra["node-chain-execution-source.json"], extra["sing-box.json"] = input, graph
			files := desktopImportedCommandFiles(t, extra)
			if actual, e := routerVPNNodeChainExecutionCommandCapture(files, session, config, source, execution, target); e == nil || actual != nil {
				t.Fatal("foreign OpenVPN command acquired native ownership")
			}
		})
	}
}

func TestRouterVPNDesktopOpenVPNExecutionConstructionRefusal(t *testing.T) {
	for _, fault := range []string{"copy", "preparation", "physical", "policy", "source", "native", "source-receipt", "native-receipt", "context", "config", "metadata", "cancelled", "nil-caller"} {
		t.Run(fault, func(t *testing.T) {
			lifetime, cancel := context.WithCancel(desktopSOCKSCommandContext(t.Context()))
			defer cancel()
			prep := desktopOpenVPNExecutionCommandPreparation(t, "3-udp", "linux", "auto")
			owner, err := routerVPNNewDesktopOpenVPNExecutionConstruction(lifetime, prep)
			if err != nil {
				t.Fatal(err)
			}
			call := t.Context()
			switch fault {
			case "copy":
				copied := *owner
				owner = &copied
			case "preparation":
				owner.preparation, err = mobilemultihop.ParseDesktopNodeChainOpenVPNExecutionPreparation(prep.Source())
			case "physical":
				other := desktopOpenVPNExecutionCommandPreparation(t, "3-udp", "linux", "auto")
				owner.physical, err = other.OpenVPNDesktopPhysicalPolicy()
			case "policy":
				owner.policy, err = mobilemultihop.NewDesktopNodeChainPolicy(owner.source, strings.Repeat("a", 32), "linux", 0)
			case "source":
				copy := *owner.source
				owner.source = &copy
			case "native":
				copy := *owner.native
				owner.native = &copy
			case "source-receipt":
				owner.sourceCapture.SourceSHA256 = strings.Repeat("b", 64)
			case "native-receipt":
				owner.nativeCapture.SourceSHA256 = strings.Repeat("b", 64)
			case "context":
				owner.ctx = lifetime
			case "config":
				owner.config += "\n"
			case "metadata":
				owner.metadata.Kind = "node-chain-socks-execution"
			case "cancelled":
				cancel()
			case "nil-caller":
				call = nil
			}
			if err != nil {
				t.Fatal("invalid replacement fixture", err)
			}
			if owner.current(call) == nil {
				t.Fatal("copied or replaced OpenVPN child construction accepted")
			}
		})
	}
}
