// Exact SOCKS association and shipping final WG/AWG endpoint constructors use
// independent cryptographic packet providers. Only captured physical
// tuples are mapped to private sockets; no device TUN/OS protection is inferred.
func TestRouterVPNImportedSOCKSPacketFinalNativeTraffic(t *testing.T) {
	directory := os.Getenv("ROUTERVPN_IMPORTED_ENTRY_FIXTURES")
	if directory == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_ENTRY_FIXTURES") == "1" {
			t.Fatal("original packet sources required")
		}
		t.Skip("mandatory native gate supplies original sources")
	}
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		faults := []string{"success", "entry-key", "auth-downgrade", "relay-route", "control-eof", "final-private-key", "final-public-key", "final-psk", "final-route", "dns-route", "final-identity", "entry-public-ip"}
		if mode != "wg" {
			faults = append(faults, "final-awg-parameter")
		}
		for _, row := range desktopImportedSOCKSCases(mode, faults) {
			t.Run(row.label, func(t *testing.T) {
				for _, fault := range row.faults {
					t.Run(fault, func(t *testing.T) {
						ctx, cancel := context.WithTimeout(pause.WithDefaultManager(context.Background()), 8*time.Second)
						defer cancel()
						raw, err := os.ReadFile(filepath.Join(directory, "socks5--final-"+row.label+".json"))
						if err != nil {
							t.Fatal(err)
						}
						var args []string
						if json.Unmarshal(raw, &args) != nil || len(args) != 9 {
							t.Fatal("original source missing")
						}
						// Generate both independent peer keys before capturing the exact input pair.
						provider, err := ecdh.X25519().GenerateKey(rand.Reader)
						if err != nil {
							t.Fatal(err)
						}
						consumer, err := ecdh.X25519().GenerateKey(rand.Reader)
						if err != nil {
							t.Fatal(err)
						}
						secret := make([]byte, 32)
						if _, err = rand.Read(secret); err != nil {
							t.Fatal(err)
						}
						defer clear(secret)
						encode := base64.StdEncoding.EncodeToString
						var assets map[string]string
						_ = json.Unmarshal([]byte(args[3]), &assets)
						asset := "awg.conf"
						if mode == "wg" {
							asset = "wg.conf"
						}
						raw, _ = base64.StdEncoding.DecodeString(assets[asset])
						lines := strings.Split(string(raw), "\n")
						for i, line := range lines {
							field, _, ok := strings.Cut(line, "=")
							if !ok {
								continue
							}
							switch strings.TrimSpace(field) {
							case "PrivateKey":
								lines[i] = "PrivateKey = " + encode(consumer.Bytes())
							case "PublicKey":
								lines[i] = "PublicKey = " + encode(provider.PublicKey().Bytes())
							case "PresharedKey":
								lines[i] = "PresharedKey = " + encode(secret)
							case "Address":
								lines[i] = "Address = 10.79.0.2/32, fd79:79::2/128"
							}
						}
						assets[asset] = encode([]byte(strings.Join(lines, "\n")))
						raw, _ = json.Marshal(assets)
						args[3] = string(raw)
						var profile map[string]any
						_ = json.Unmarshal([]byte(args[4]), &profile)
						if mode == "wg" {
							digest := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + encode(provider.PublicKey().Bytes())))
							profile["node_proof_id"] = hex.EncodeToString(digest[:])
						}
						raw, _ = json.Marshal(profile)
						args[4] = string(raw)
						plan, err := mobilemultihop.NewImportedEntry(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
						if err != nil {
							t.Fatal(err)
						}
						var graph map[string]any
						_ = json.Unmarshal([]byte(plan.Config()), &graph)
						byTag := map[string]map[string]any{}
						for _, family := range []string{"endpoints", "outbounds"} {
							rows, _ := graph[family].([]any)
							for _, raw := range rows {
								v := raw.(map[string]any)
								byTag[v["tag"].(string)] = v
							}
						}
						firstRaw, lastRaw := byTag["entry-wg"], byTag[mobilemultihop.LocalTag]
						if firstRaw == nil || lastRaw == nil {
							t.Fatal("actual endpoint closure/final detour missing")
						}
						var meta mobilemultihop.Metadata
						_ = json.Unmarshal([]byte(plan.Metadata()), &meta)
						paired := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
							if r.URL.Path != "/health" || r.Header.Get("Authorization") != "Bearer "+meta.ExitToken {
								http.Error(w, "foreign", 403)
								return
							}
							id := meta.ExitNodeID
							if fault == "final-identity" {
								id = "foreign"
							}
							fmt.Fprintf(w, `{"ok":true,"node_id":%q,"proof":"router-vpn-private-agent-v1"}`, id)
						}))
						defer paired.Close()
						publicCert, publicCA := desktopImportedFinalCertificate(t)
						public := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
							ip := "203.0.113.88"
							if fault == "entry-public-ip" {
								ip = "203.0.113.89"
							}
							fmt.Fprintf(w, "ip=%s\n", ip)
						}))
						public.TLS = &tls.Config{Certificates: []tls.Certificate{publicCert}, MinVersion: tls.VersionTLS12}
						public.StartTLS()
						defer public.Close()
						packet, err := net.ListenPacket("udp4", "127.0.0.1:0")
						if err != nil {
							t.Fatal(err)
						}
						dnsServer := &dns.Server{PacketConn: packet, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
							r := new(dns.Msg).SetReply(q)
							r.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 1}, A: net.ParseIP("93.184.216.34")}}
							_ = w.WriteMsg(r)
						})}
						dnsDone := make(chan error, 1)
						go func() { dnsDone <- dnsServer.ActivateAndServe() }()
						defer func() { _ = dnsServer.Shutdown(); _ = packet.Close(); <-dnsDone }()
						selected := graph["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)
						if selected["detour"] != "proxy" {
							t.Fatal("DNS bypassed final")
						}
						dnsTarget := net.JoinHostPort(selected["server"].(string), "53")
						newServer := func(routes []desktopNodeLayerRoute) *desktopNodeLayerServer {
							c, stop := context.WithCancel(ctx)
							t.Cleanup(stop)
							return &desktopNodeLayerServer{ctx: c, cancel: stop, connections: map[io.Closer]bool{}, routes: routes}
						}
						finalServer := newServer([]desktopNodeLayerRoute{{Network: "tcp", Destination: "10.77.0.1:8787", Physical: paired.Listener.Addr().String()}, {Network: "udp", Destination: dnsTarget, Physical: packet.LocalAddr().String()}})
						entryPeer := lastRaw["peers"].([]any)[0].(map[string]any)
						rules := map[string]desktopReferenceRule{}
						for _, r := range finalServer.routes {
							a := netip.MustParseAddrPort(r.Destination)
							rules[r.Network+"/"+r.Destination] = desktopReferenceRule{Network: r.Network, Address: a.Addr().String(), Port: int(a.Port()), Target: r.Physical}
						}
						peerRequest := desktopExternalInstalledWGRequest{PrivateKey: encode(provider.Bytes()), ClientPublicKey: encode(consumer.PublicKey().Bytes()), PresharedKey: encode(secret)}
						parameters, backend := "", startDesktopDarwinWGDevice
						if mode != "wg" {
							values := map[string]string{}
							for k, v := range lastRaw["amnezia"].(map[string]any) {
								values[k] = v.(string)
							}
							parameters, backend = desktopDarwinAmneziaBackend(t, desktopExternalInstalledAWGRequest{peerRequest, values})
						}
						peer := desktopInstalledPacketDevice(t, finalServer, peerRequest, netip.MustParseAddr("127.0.0.1"), parameters, backend, rules, true)
						defer peer.close()
						target := net.JoinHostPort(entryPeer["address"].(string), fmt.Sprint(int(entryPeer["port"].(float64))))
						physical := peer.address
						target, physical, verifyFinalLayer := desktopImportedSOCKSInstallFinal(t, ctx, byTag, lastRaw, target, physical, fault)
						defer verifyFinalLayer()
						entryServer := newServer([]desktopNodeLayerRoute{{Network: "udp", Destination: target, Physical: physical}, {Network: "tcp", Destination: "1.1.1.1:443", Physical: public.Listener.Addr().String()}})
						socksEntry, socksPeer := desktopStartImportedSOCKSProvider(t, entryServer, firstRaw["password"].(string), fault)
						defer socksEntry.close()
						physicalOwner, lower, verifyEntryLayer := desktopImportedSOCKSInstallEntry(t, ctx, byTag, firstRaw, socksEntry, socksPeer, fault)
						defer func() { socksEntry.close(); verifyEntryLayer() }()
						manager := &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": physicalOwner}}
						owned := service.ContextWith[adapter.OutboundManager](ctx, manager)
						owned = service.ContextWith[adapter.NetworkManager](owned, &desktopImportedPacketNetwork{})
						desktopImportedSOCKSNativeLayers(t, owned, manager, byTag, firstRaw, firstRaw)
						switch fault {
						case "final-private-key":
							lastRaw["private_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
						case "final-public-key":
							entryPeer["public_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
						case "final-psk":
							entryPeer["pre_shared_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
						case "final-awg-parameter":
							lastRaw["amnezia"].(map[string]any)["s1"] = "57"
						case "entry-key":
							firstRaw["password"] = "wrong-entry-password"
						case "final-route":
							entryPeer["address"] = "192.0.2.99"
						}
						create := func(value map[string]any) adapter.Outbound {
							raw, _ := json.Marshal(value)
							var out adapter.Outbound
							var e error
							switch value["type"] {
							case "wireguard":
								var options option.WireGuardEndpointOptions
								_ = json.Unmarshal(raw, &options)
								out, e = WG.NewEndpoint(owned, nil, log.NewNOPFactory().Logger(), value["tag"].(string), options)
							case mobilemultihop.AmneziaType:
								var options Options
								_ = json.Unmarshal(raw, &options)
								out, e = NewEndpoint(owned, nil, log.NewNOPFactory().Logger(), value["tag"].(string), options)
							case "socks":
								var options option.SOCKSOutboundOptions
								_ = json.Unmarshal(raw, &options)
								out, e = SOCKS.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), value["tag"].(string), options)
							default:
								t.Fatal("unknown original native type")
							}
							if e != nil {
								t.Fatal(e)
							}
							t.Cleanup(func() {
								if closer, ok := out.(io.Closer); ok {
									_ = closer.Close()
								}
							})
							manager.owners[value["tag"].(string)] = out
							return out
						}
						first := create(firstRaw)
						desktopImportedSOCKSNativeLayers(t, owned, manager, byTag, firstRaw, lastRaw)
						final := create(lastRaw)
						defer func() {
							if err := final.(io.Closer).Close(); err != nil {
								t.Error("packet endpoint cleanup failed", err)
							}
						}()
						for _, stage := range []adapter.StartStage{adapter.StartStateInitialize, adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
							if e := final.(adapter.Lifecycle).Start(stage); e != nil {
								if (fault == "entry-key" || fault == "auth-downgrade" || fault == "relay-route" || fault == "control-eof" || strings.HasPrefix(fault, "entry-layer-")) && ctx.Err() == nil {
									raw, tcp, udp := peer.stats()
									if lower.calls.Load() == 0 || raw != 0 || tcp != 0 || udp != 0 || entryServer.plainTCP.Load() != 0 || entryServer.plainUDP.Load() != 0 {
										t.Fatal("rejected entry authentication acquired packet final authority")
									}
									return
								}
								t.Fatal(e)
							}
						}
						limit := 2 * time.Second
						if fault != "success" {
							limit = 350 * time.Millisecond
						}
						// Actual TLS public response through the proxy entry, separately from final private proof.
						probePublic, stopPublic := context.WithTimeout(ctx, 2*time.Second)
						roots := x509.NewCertPool()
						if !roots.AppendCertsFromPEM([]byte(publicCA)) {
							t.Fatal("public fixture trust missing")
						}
						publicTransport := &http.Transport{Proxy: nil, DisableKeepAlives: true, TLSClientConfig: &tls.Config{RootCAs: roots, ServerName: "captured-final.example", MinVersion: tls.VersionTLS12}, DialContext: func(c context.Context, n, a string) (net.Conn, error) {
							return first.DialContext(c, n, M.ParseSocksaddr(a))
						}}
						publicRequest, _ := http.NewRequestWithContext(probePublic, "GET", "https://1.1.1.1/cdn-cgi/trace", nil)
						publicResponse, publicErr := (&http.Client{Transport: publicTransport}).Do(publicRequest)
						publicOK := false
						if publicErr == nil {
							body, e := io.ReadAll(io.LimitReader(publicResponse.Body, 4096))
							_ = publicResponse.Body.Close()
							publicOK = e == nil && string(body) == "ip=203.0.113.88\n"
						}
						publicTransport.CloseIdleConnections()
						stopPublic()
						blockedEntry := fault == "entry-key" || fault == "auth-downgrade" || strings.HasPrefix(fault, "entry-layer-")
						if publicOK != (!blockedEntry && fault != "entry-public-ip") {
							t.Fatal("original packet public identity did not follow real TLS path", fault, publicErr)
						}
						probe, stop := context.WithTimeout(ctx, limit)
						transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
							return final.DialContext(ctx, network, M.ParseSocksaddr(address))
						}}
						request, _ := http.NewRequestWithContext(probe, "GET", meta.ExitAPI+"/health", nil)
						request.Header.Set("Authorization", "Bearer "+meta.ExitToken)
						response, failure := (&http.Client{Transport: transport}).Do(request)
						proofOK := false
						if failure == nil {
							var value struct {
								OK    bool   `json:"ok"`
								Node  string `json:"node_id"`
								Proof string `json:"proof"`
							}
							failure = json.NewDecoder(response.Body).Decode(&value)
							_ = response.Body.Close()
							proofOK = failure == nil && value.OK && value.Node == meta.ExitNodeID && value.Proof == "router-vpn-private-agent-v1"
						}
						transport.CloseIdleConnections()
						stop()
						positive := fault == "success"
						if proofOK != (positive || fault == "dns-route" || fault == "entry-public-ip") {
							t.Fatal("final proof acceptance bypassed actual native owners", fault, failure)
						}
						if fault == "dns-route" {
							dnsTarget = "192.168.50.134:53"
						}
						probe, stop = context.WithTimeout(ctx, limit)
						connection, failure := final.DialContext(probe, "udp", M.ParseSocksaddr(dnsTarget))
						dnsOK := false
						if failure == nil {
							deadline, _ := probe.Deadline()
							_ = connection.SetDeadline(deadline)
							query := new(dns.Msg)
							query.SetQuestion("example.com.", dns.TypeA)
							wire, _ := query.Pack()
							_, failure = connection.Write(wire)
							buffer := make([]byte, 4096)
							n := 0
							if failure == nil {
								n, failure = connection.Read(buffer)
							}
							var reply dns.Msg
							if failure == nil && reply.Unpack(buffer[:n]) == nil {
								dnsOK = reply.Response && reply.Id == query.Id && len(reply.Answer) == 1
							}
							_ = connection.Close()
						}
						stop()
						if dnsOK != (positive || fault == "final-identity" || fault == "entry-public-ip") {
							t.Fatal("DNS acceptance bypassed exact final chain", fault, failure)
						}

						if positive {
							canceled, stop := context.WithCancel(ctx)
							stop()
							late, err := first.DialContext(canceled, "tcp", M.ParseSocksaddr("1.1.1.1:443"))
							if late != nil {
								late.Close()
								t.Fatal("cancelled SOCKS owner returned connection")
							}
							if !errors.Is(err, context.Canceled) {
								t.Fatal("cancelled SOCKS request lost cancellation", err)
							}
						}
						if err := final.(io.Closer).Close(); err != nil {
							t.Fatal("packet final did not join", err)
						}
						socksEntry.close()
						rawPackets, plainTCP, plainUDP := peer.stats()
						blockedFinal := blockedEntry || fault == "relay-route" || fault == "control-eof" || fault == "final-private-key" || fault == "final-public-key" || fault == "final-psk" || fault == "final-awg-parameter" || fault == "final-route"
						if lower.calls.Load() == 0 {
							t.Fatal("original physical proxy owner bypassed")
						}
						if positive && (rawPackets == 0 || plainTCP == 0 || plainUDP == 0 || entryServer.plainUDP.Load() == 0) {
							t.Fatal("actual encrypted proxy and packet final payload not observed", rawPackets, plainTCP, plainUDP)
						}
						if blockedFinal && (plainTCP != 0 || plainUDP != 0) {
							t.Fatal("rejected final peer decrypted payload", fault, plainTCP, plainUDP)
						}
						if (blockedEntry || fault == "relay-route" || fault == "control-eof" || fault == "final-route") && rawPackets != 0 {
							t.Fatal("unowned route reached final peer")
						}

					})
				}

			})
		}
	}
}

// Retain the published packet-layer traffic, authority and capacity cases.
func TestRouterVPNImportedSOCKSPacketLayersNativeTraffic(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		t.Run(layer, func(t *testing.T) { desktopImportedSOCKSPacketLayers(t, layer) })
	}
}
func desktopImportedSOCKSPacketLayers(t *testing.T, layer string, entrySelection ...string) {
	entryLayer := ""
	if len(entrySelection) == 1 {
		entryLayer = entrySelection[0]
	} else if len(entrySelection) != 0 {
		t.Fatal("ambiguous entrylayer")
	}
	directory := os.Getenv("ROUTERVPN_IMPORTED_ENTRY_FIXTURES")
	if directory == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_ENTRY_FIXTURES") == "1" {
			t.Fatal("original packet sources required")
		}
		t.Skip("mandatory native gate supplies original sources")
	}
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		t.Run(mode, func(t *testing.T) {
			faults := []string{"success", "entry-key", "auth-downgrade", "relay-route", "control-eof", "final-private-key", "final-public-key", "final-psk", "final-route", "dns-route", "final-identity", "entry-public-ip"}
			if mode != "wg" {
				faults = append(faults, "final-awg-parameter")
			}
			if layer != "" {
				faults = append(faults, "layer-key")
				if layer == "aes-256-gcm+xor-whitening" {
					faults = append(faults, "whitening")
				}
			}
			if entryLayer != "" {
				faults = append(faults, "entry-layer-key", "entry-private")
				if entryLayer == "aes-256-gcm+xor-whitening" {
					faults = append(faults, "entry-whitening")
				}
			}
			for _, fault := range faults {
				t.Run(fault, func(t *testing.T) {
					ctx, cancel := context.WithTimeout(pause.WithDefaultManager(context.Background()), 8*time.Second)
					defer cancel()
					suffix := ""
					if layer != "" {
						suffix = "--" + layer
					}
					if entryLayer != "" {
						suffix = "--entry-" + entryLayer
					}
					raw, err := os.ReadFile(filepath.Join(directory, "socks5--final-"+mode+suffix+".json"))
					if err != nil {
						t.Fatal(err)
					}
					var args []string
					if json.Unmarshal(raw, &args) != nil || len(args) != 9 {
						t.Fatal("original source missing")
					}
					// Generate both independent peer keys before capturing the exact input pair.
					provider, err := ecdh.X25519().GenerateKey(rand.Reader)
					if err != nil {
						t.Fatal(err)
					}
					consumer, err := ecdh.X25519().GenerateKey(rand.Reader)
					if err != nil {
						t.Fatal(err)
					}
					secret := make([]byte, 32)
					if _, err = rand.Read(secret); err != nil {
						t.Fatal(err)
					}
					defer clear(secret)
					encode := base64.StdEncoding.EncodeToString
					var assets map[string]string
					_ = json.Unmarshal([]byte(args[3]), &assets)
					asset := "awg.conf"
					if mode == "wg" {
						asset = "wg.conf"
					}
					raw, _ = base64.StdEncoding.DecodeString(assets[asset])
					lines := strings.Split(string(raw), "\n")
					for i, line := range lines {
						field, _, ok := strings.Cut(line, "=")
						if !ok {
							continue
						}
						switch strings.TrimSpace(field) {
						case "PrivateKey":
							lines[i] = "PrivateKey = " + encode(consumer.Bytes())
						case "PublicKey":
							lines[i] = "PublicKey = " + encode(provider.PublicKey().Bytes())
						case "PresharedKey":
							lines[i] = "PresharedKey = " + encode(secret)
						case "Address":
							lines[i] = "Address = 10.79.0.2/32, fd79:79::2/128"
						}
					}
					assets[asset] = encode([]byte(strings.Join(lines, "\n")))
					raw, _ = json.Marshal(assets)
					args[3] = string(raw)
					var profile map[string]any
					_ = json.Unmarshal([]byte(args[4]), &profile)
					if mode == "wg" {
						digest := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + encode(provider.PublicKey().Bytes())))
						profile["node_proof_id"] = hex.EncodeToString(digest[:])
					}
					raw, _ = json.Marshal(profile)
					args[4] = string(raw)
					plan, err := mobilemultihop.NewImportedEntry(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
					if err != nil {
						t.Fatal(err)
					}
					var graph map[string]any
					_ = json.Unmarshal([]byte(plan.Config()), &graph)
					byTag := map[string]map[string]any{}
					for _, family := range []string{"endpoints", "outbounds"} {
						rows, _ := graph[family].([]any)
						for _, raw := range rows {
							v := raw.(map[string]any)
							byTag[v["tag"].(string)] = v
						}
					}
					firstRaw, lastRaw := byTag["entry-wg"], byTag[mobilemultihop.LocalTag]
					outerRaw := byTag[mobilemultihop.NativeStartLayerTag]
					var entryOuter map[string]any
					if entryLayer != "" {
						entryOuter = byTag[firstRaw["detour"].(string)]
						if entryOuter == nil || entryOuter["detour"] != nil {
							t.Fatal("entrylayer lost physical owner")
						}
					}
					expectedDetour := "entry-wg"
					if layer != "" {
						expectedDetour = mobilemultihop.NativeStartLayerTag
						if outerRaw == nil || outerRaw["detour"] != "entry-wg" {
							t.Fatal("original outer layer missing")
						}
					}
					if firstRaw == nil || lastRaw == nil || lastRaw["detour"] != expectedDetour {
						t.Fatal("actual endpoint closure/final detour missing")
					}
					var meta mobilemultihop.Metadata
					_ = json.Unmarshal([]byte(plan.Metadata()), &meta)
					paired := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
						if r.URL.Path != "/health" || r.Header.Get("Authorization") != "Bearer "+meta.ExitToken {
							http.Error(w, "foreign", 403)
							return
						}
						id := meta.ExitNodeID
						if fault == "final-identity" {
							id = "foreign"
						}
						fmt.Fprintf(w, `{"ok":true,"node_id":%q,"proof":"router-vpn-private-agent-v1"}`, id)
					}))
					defer paired.Close()
					publicCert, publicCA := desktopImportedFinalCertificate(t)
					public := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
						ip := "203.0.113.88"
						if fault == "entry-public-ip" {
							ip = "203.0.113.89"
						}
						fmt.Fprintf(w, "ip=%s\n", ip)
					}))
					public.TLS = &tls.Config{Certificates: []tls.Certificate{publicCert}, MinVersion: tls.VersionTLS12}
					public.StartTLS()
					defer public.Close()
					packet, err := net.ListenPacket("udp4", "127.0.0.1:0")
					if err != nil {
						t.Fatal(err)
					}
					dnsServer := &dns.Server{PacketConn: packet, UDPSize: 4096, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
						r := new(dns.Msg).SetReply(q)
						r.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 1}, A: net.ParseIP("93.184.216.34")}}
						_ = w.WriteMsg(r)
					})}
					dnsDone := make(chan error, 1)
					go func() { dnsDone <- dnsServer.ActivateAndServe() }()
					defer func() { _ = dnsServer.Shutdown(); _ = packet.Close(); <-dnsDone }()
					selected := graph["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)
					if selected["detour"] != "proxy" {
						t.Fatal("DNS bypassed final")
					}
					dnsTarget := net.JoinHostPort(selected["server"].(string), "53")
					newServer := func(routes []desktopNodeLayerRoute) *desktopNodeLayerServer {
						c, stop := context.WithCancel(ctx)
						t.Cleanup(stop)
						return &desktopNodeLayerServer{ctx: c, cancel: stop, connections: map[io.Closer]bool{}, routes: routes}
					}
					finalServer := newServer([]desktopNodeLayerRoute{{Network: "tcp", Destination: "10.77.0.1:8787", Physical: paired.Listener.Addr().String()}, {Network: "udp", Destination: dnsTarget, Physical: packet.LocalAddr().String()}})
					entryPeer := lastRaw["peers"].([]any)[0].(map[string]any)
					rules := map[string]desktopReferenceRule{}
					for _, r := range finalServer.routes {
						a := netip.MustParseAddrPort(r.Destination)
						rules[r.Network+"/"+r.Destination] = desktopReferenceRule{Network: r.Network, Address: a.Addr().String(), Port: int(a.Port()), Target: r.Physical}
					}
					peerRequest := desktopExternalInstalledWGRequest{PrivateKey: encode(provider.Bytes()), ClientPublicKey: encode(consumer.PublicKey().Bytes()), PresharedKey: encode(secret)}
					parameters, backend := "", startDesktopDarwinWGDevice
					if mode != "wg" {
						values := map[string]string{}
						for k, v := range lastRaw["amnezia"].(map[string]any) {
							values[k] = v.(string)
						}
						parameters, backend = desktopDarwinAmneziaBackend(t, desktopExternalInstalledAWGRequest{peerRequest, values})
					}
					observed := &desktopNestedIPObservation{target: netip.MustParseAddrPort(dnsTarget).Addr()}
					originalBackend := backend
					backend = func(c context.Context, device wg.Device, bind *desktopDarwinWGBind, ipc string) (desktopDarwinWGDevice, error) {
						return originalBackend(c, &desktopNestedObservedDevice{Device: device, observed: observed}, bind, ipc)
					}
					peer := desktopInstalledPacketDevice(t, finalServer, peerRequest, netip.MustParseAddr("127.0.0.1"), parameters, backend, rules, true)
					defer peer.close()
					target := net.JoinHostPort(entryPeer["address"].(string), fmt.Sprint(int(entryPeer["port"].(float64))))
					physical := peer.address
					var outerPeer *desktopExternalInstalledSSPeer
					if outerRaw != nil {
						if entryPeer["address"] != "10.77.0.1" {
							t.Fatal("packet layer lost captured private Router API destination")
						}
						layerServer := newServer([]desktopNodeLayerRoute{{Network: "udp", Destination: target, Physical: physical}})
						value := desktopImportedSOCKSLayerProvider(t, layerServer, outerRaw, fault)
						outerPeer = &value
						defer value.close()
						target = net.JoinHostPort(outerRaw["server"].(string), fmt.Sprint(int(outerRaw["server_port"].(float64))))
						physical = value.address
					}
					entryServer := newServer([]desktopNodeLayerRoute{{Network: "udp", Destination: target, Physical: physical}, {Network: "tcp", Destination: "1.1.1.1:443", Physical: public.Listener.Addr().String()}})
					socksEntry, socksPeer := desktopStartImportedSOCKSProvider(t, entryServer, firstRaw["password"].(string), fault)
					defer socksEntry.close()
					entryTarget := net.JoinHostPort(firstRaw["server"].(string), fmt.Sprint(int(firstRaw["server_port"].(float64))))
					socksLower := &desktopImportedSOCKSLower{desktopSSReferenceLower: desktopSSReferenceLower{virtual: entryTarget, original: socksEntry.address}, peer: socksPeer}
					lower := &socksLower.desktopSSReferenceLower
					var physicalOwner adapter.Outbound = socksLower
					var entryCarrier *desktopImportedSOCKSEntryLayer
					if entryOuter != nil {
						entryCarrier = desktopStartImportedSOCKSEntryLayer(t, ctx, socksPeer, entryOuter, entryTarget, socksEntry.address, entryLayer, fault)
						defer func() { socksEntry.close(); entryCarrier.close(t) }()
						lower = &desktopSSReferenceLower{virtual: net.JoinHostPort(entryOuter["server"].(string), fmt.Sprint(int(entryOuter["server_port"].(float64)))), original: entryCarrier.peer.address}
						physicalOwner = lower
						entryOuter["detour"] = "captured-physical"
					} else {
						firstRaw["detour"] = "captured-physical"
					}
					manager := &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": physicalOwner}}
					owned := service.ContextWith[adapter.OutboundManager](ctx, manager)
					owned = service.ContextWith[adapter.NetworkManager](owned, &desktopImportedPacketNetwork{})
					if fault == "entry-private" {
						firstRaw["server"] = "10.93.0.99"
					}
					switch fault {
					case "final-private-key":
						lastRaw["private_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
					case "final-public-key":
						entryPeer["public_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
					case "final-psk":
						entryPeer["pre_shared_key"] = desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'x')
					case "final-awg-parameter":
						lastRaw["amnezia"].(map[string]any)["s1"] = "57"
					case "entry-key":
						firstRaw["password"] = "wrong-entry-password"
					case "final-route":
						entryPeer["address"] = "192.0.2.99"
					}
					create := func(value map[string]any) adapter.Outbound {
						raw, _ := json.Marshal(value)
						var out adapter.Outbound
						var e error
						switch value["type"] {
						case "wireguard":
							var options option.WireGuardEndpointOptions
							_ = json.Unmarshal(raw, &options)
							out, e = WG.NewEndpoint(owned, nil, log.NewNOPFactory().Logger(), value["tag"].(string), options)
						case mobilemultihop.AmneziaType:
							var options Options
							_ = json.Unmarshal(raw, &options)
							out, e = NewEndpoint(owned, nil, log.NewNOPFactory().Logger(), value["tag"].(string), options)
						case "shadowsocks", "routervpn-aes-xor":
							out = desktopSSReferenceLayerClient(t, owned, value["tag"].(string), value["detour"].(string), value["server"].(string), uint16(value["server_port"].(float64)), func() string {
								if value["type"] == "shadowsocks" {
									return "aes-256-gcm"
								}
								return "aes-256-gcm+xor-whitening"
							}(), value["password"].(string))
						case "socks":
							var options option.SOCKSOutboundOptions
							_ = json.Unmarshal(raw, &options)
							out, e = SOCKS.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), value["tag"].(string), options)
						default:
							t.Fatal("unknown original native type")
						}
						if e != nil {
							t.Fatal(e)
						}
						t.Cleanup(func() {
							if closer, ok := out.(io.Closer); ok {
								_ = closer.Close()
							}
						})
						manager.owners[value["tag"].(string)] = out
						return out
					}
					if entryOuter != nil {
						create(entryOuter)
					}
					first := create(firstRaw)
					if outerRaw != nil {
						create(outerRaw)
					}
					final := create(lastRaw)
					defer func() {
						if err := final.(io.Closer).Close(); err != nil {
							t.Error("packet endpoint cleanup failed", err)
						}
					}()
					for _, stage := range []adapter.StartStage{adapter.StartStateInitialize, adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
						if e := final.(adapter.Lifecycle).Start(stage); e != nil {
							if (fault == "entry-key" || fault == "auth-downgrade" || fault == "relay-route" || fault == "control-eof" || fault == "entry-layer-key" || fault == "entry-whitening" || fault == "entry-private") && ctx.Err() == nil {
								raw, tcp, udp := peer.stats()
								if entryCarrier != nil && (fault == "entry-layer-key" || fault == "entry-whitening") && entryCarrier.peer.stats().AuthTCP == 0 {
									t.Fatal("entrylayer refusal lacked independent authentication failure")
								}
								if lower.calls.Load() == 0 || raw != 0 || tcp != 0 || udp != 0 || entryServer.plainTCP.Load() != 0 || entryServer.plainUDP.Load() != 0 {
									t.Fatal("rejected entry authentication acquired packet final authority")
								}
								return
							}
							t.Fatal(e)
						}
					}
					limit := 2 * time.Second
					if fault != "success" {
						limit = 350 * time.Millisecond
					}
					// Actual TLS public response through the proxy entry, separately from final private proof.
					probePublic, stopPublic := context.WithTimeout(ctx, 2*time.Second)
					roots := x509.NewCertPool()
					if !roots.AppendCertsFromPEM([]byte(publicCA)) {
						t.Fatal("public fixture trust missing")
					}
					publicTransport := &http.Transport{Proxy: nil, DisableKeepAlives: true, TLSClientConfig: &tls.Config{RootCAs: roots, ServerName: "captured-final.example", MinVersion: tls.VersionTLS12}, DialContext: func(c context.Context, n, a string) (net.Conn, error) {
						return first.DialContext(c, n, M.ParseSocksaddr(a))
					}}
					publicRequest, _ := http.NewRequestWithContext(probePublic, "GET", "https://1.1.1.1/cdn-cgi/trace", nil)
					publicResponse, publicErr := (&http.Client{Transport: publicTransport}).Do(publicRequest)
					publicOK := false
					if publicErr == nil {
						body, e := io.ReadAll(io.LimitReader(publicResponse.Body, 4096))
						_ = publicResponse.Body.Close()
						publicOK = e == nil && string(body) == "ip=203.0.113.88\n"
					}
					publicTransport.CloseIdleConnections()
					stopPublic()
					blockedEntry := fault == "entry-key" || fault == "auth-downgrade" || fault == "entry-layer-key" || fault == "entry-whitening" || fault == "entry-private"
					if publicOK != (!blockedEntry && fault != "entry-public-ip") {
						t.Fatal("original packet public identity did not follow real TLS path", fault, publicErr)
					}
					probe, stop := context.WithTimeout(ctx, limit)
					transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
						return final.DialContext(ctx, network, M.ParseSocksaddr(address))
					}}
					request, _ := http.NewRequestWithContext(probe, "GET", meta.ExitAPI+"/health", nil)
					request.Header.Set("Authorization", "Bearer "+meta.ExitToken)
					response, failure := (&http.Client{Transport: transport}).Do(request)
					proofOK := false
					if failure == nil {
						var value struct {
							OK    bool   `json:"ok"`
							Node  string `json:"node_id"`
							Proof string `json:"proof"`
						}
						failure = json.NewDecoder(response.Body).Decode(&value)
						_ = response.Body.Close()
						proofOK = failure == nil && value.OK && value.Node == meta.ExitNodeID && value.Proof == "router-vpn-private-agent-v1"
					}
					transport.CloseIdleConnections()
					stop()
					positive := fault == "success"
					if proofOK != (positive || fault == "dns-route" || fault == "entry-public-ip") {
						t.Fatal("final proof acceptance bypassed actual native owners", fault, failure)
					}
					if fault == "dns-route" {
						dnsTarget = "192.168.50.134:53"
					}
					probe, stop = context.WithTimeout(ctx, limit)
					connection, failure := final.DialContext(probe, "udp", M.ParseSocksaddr(dnsTarget))
					dnsOK := false
					if failure == nil {
						deadline, _ := probe.Deadline()
						_ = connection.SetDeadline(deadline)
						query := new(dns.Msg)
						query.SetQuestion("example.com.", dns.TypeA)
						if positive && (layer != "" || entryLayer != "") {
							query.SetEdns0(4096, false)
							query.IsEdns0().Option = append(query.IsEdns0().Option, &dns.EDNS0_PADDING{})
							initial, _ := query.Pack()
							capacity := int(lastRaw["mtu"].(float64)) - 28
							if capacity < len(initial) {
								t.Fatal("packet MTU cannot carry selected DNS")
							}
							query.IsEdns0().Option[0].(*dns.EDNS0_PADDING).Padding = make([]byte, capacity-len(initial))
						}
						wire, _ := query.Pack()
						_, failure = connection.Write(wire)
						buffer := make([]byte, 4096)
						n := 0
						if failure == nil {
							n, failure = connection.Read(buffer)
						}
						var reply dns.Msg
						if failure == nil && reply.Unpack(buffer[:n]) == nil {
							dnsOK = reply.Response && reply.Id == query.Id && len(reply.Answer) == 1
						}
						_ = connection.Close()
					}
					stop()
					if dnsOK != (positive || fault == "final-identity" || fault == "entry-public-ip") {
						t.Fatal("DNS acceptance bypassed exact final chain", fault, failure)
					}

					if positive {
						canceled, stop := context.WithCancel(ctx)
						stop()
						late, err := first.DialContext(canceled, "tcp", M.ParseSocksaddr("1.1.1.1:443"))
						if late != nil {
							late.Close()
							t.Fatal("cancelled SOCKS owner returned connection")
						}
						if !errors.Is(err, context.Canceled) {
							t.Fatal("cancelled SOCKS request lost cancellation", err)
						}
					}
					if err := final.(io.Closer).Close(); err != nil {
						t.Fatal("packet final did not join", err)
					}
					socksEntry.close()
					rawPackets, plainTCP, plainUDP := peer.stats()
					if outerPeer != nil {
						stats := outerPeer.stats()
						if stats.Streams != 0 {
							t.Fatal("packet wrapper forwarded TCP", stats)
						}
						if positive && (stats.PhysicalUDP == 0 || stats.Packets == 0 || stats.AuthUDP != 0) {
							t.Fatal("packet wrapper bypassed", stats)
						}
						if fault == "layer-key" || fault == "whitening" {
							if stats.AuthUDP == 0 || stats.Packets != 0 || rawPackets != 0 {
								t.Fatal("unauthenticated outer packet reached final", stats, rawPackets)
							}
						}
					}
					if positive && (layer != "" || entryLayer != "") {
						observed.mu.Lock()
						count, maximum, invalid := observed.count, observed.maximum, observed.invalid
						observed.mu.Unlock()
						if count == 0 || invalid || maximum != int(lastRaw["mtu"].(float64)) {
							t.Fatal("layered packet capacity or fragmentation changed", count, maximum, invalid)
						}
					}
					blockedFinal := fault == "layer-key" || fault == "whitening" || blockedEntry || fault == "relay-route" || fault == "control-eof" || fault == "final-private-key" || fault == "final-public-key" || fault == "final-psk" || fault == "final-awg-parameter" || fault == "final-route"
					if entryCarrier != nil {
						stats := entryCarrier.peer.stats()
						if positive && (stats.Streams == 0 || stats.Packets == 0 || entryCarrier.retired.Load() == 0) {
							t.Fatal("entrylayer or original association retirement bypassed", stats)
						}
						if fault == "entry-layer-key" || fault == "entry-whitening" {
							if stats.AuthTCP == 0 || entryServer.rawTCP.Load()+entryServer.rawUDP.Load() != 0 {
								t.Fatal("unauthenticated layer reached SOCKS", stats)
							}
						}
						if fault == "entry-private" && entryServer.rawTCP.Load()+entryServer.rawUDP.Load() != 0 {
							t.Fatal("foreign private tuple reached SOCKS")
						}
					}
					if lower.calls.Load() == 0 {
						t.Fatal("original physical proxy owner bypassed")
					}
					if positive && (rawPackets == 0 || plainTCP == 0 || plainUDP == 0 || entryServer.plainUDP.Load() == 0) {
						t.Fatal("actual encrypted proxy and packet final payload not observed", rawPackets, plainTCP, plainUDP)
					}
					if blockedFinal && (plainTCP != 0 || plainUDP != 0) {
						t.Fatal("rejected final peer decrypted payload", fault, plainTCP, plainUDP)
					}
					if (blockedEntry || fault == "relay-route" || fault == "control-eof" || fault == "final-route") && rawPackets != 0 {
						t.Fatal("unowned route reached final peer")
					}

				})
			}

		})
	}
}

func TestRouterVPNImportedSOCKSEntryLayersPacketNativeTraffic(t *testing.T) {
	for _, layer := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		t.Run(layer, func(t *testing.T) { desktopImportedSOCKSPacketLayers(t, "", layer) })
	}
}
