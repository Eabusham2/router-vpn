func desktopMultipleImportedExecutionPhysicalPreparation(t *testing.T, layout, target, execution string) (*mobilemultihop.NodeChainExecutionPreparation, *mobilemultihop.DesktopNodeChainMultipleImportedExecutionPhysicalPolicy) {
	t.Helper()
	directory := os.Getenv("ROUTERVPN_MULTIPLE_IMPORTED_EXECUTION_NATIVE_FIXTURES")
	if directory == "" {
		t.Fatal("original multiple imported native fixture directory required")
	}
	raw, err := os.ReadFile(filepath.Join(directory, layout+".json"))
	var input struct{ Local, Server string }
	if err != nil || json.Unmarshal(raw, &input) != nil || input.Local == "" || input.Server == "" {
		t.Fatal("original independent imported profiles missing", err)
	}
	local, err := mobilemultihop.ParseNodeChainLaunchInput(input.Local)
	if err != nil {
		t.Fatal(err)
	}
	if _, err := mobilemultihop.NewNodeChainMultipleImportedServerPolicy(input.Server); err != nil {
		t.Fatal(err)
	}
	original, err := mobilemultihop.NewDesktopNodeChainPolicy(local, strings.Repeat("a", 32), target, 0)
	if err != nil {
		t.Fatal(err)
	}
	prep, err := mobilemultihop.NewDesktopNodeChainMultipleImportedExecutionPreparation(original, execution)
	if err != nil {
		t.Fatal(err)
	}
	physical, err := prep.MultipleImportedDesktopPhysicalPolicy()
	if err != nil {
		t.Fatal(err)
	}
	return prep, physical
}

// Every provider, manager and closed execution gate is real. The unstarted TUN
// is a component boundary: constructing it proves no installed host readiness.
func desktopMultipleImportedExecutionPhysicalBox(t *testing.T, prep *mobilemultihop.NodeChainExecutionPreparation, change func(map[string]any)) (*Box, *desktopTorBoxTUN, error) {
	t.Helper()
	var tun *desktopTorBoxTUN
	ins := inbound.NewRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.TunInboundOptions) (adapter.Inbound, error) {
		tun = &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag), name: options.InterfaceName, index: 772, mtu: int(options.MTU)}
		return tun, nil
	})
	outs := outbound.NewRegistry()
	group.RegisterSelector(outs)
	G.RegisterOutbound(outs)
	shadowsocks.RegisterOutbound(outs)
	routervpndesktoppt.RegisterNodePhysicalOutbound(outs)
	ends := endpoint.NewRegistry()
	wireguard.RegisterEndpoint(ends)
	AWG.RegisterEndpoint(ends)
	ds := dns.NewTransportRegistry()
	DNST.RegisterUDP(ds)
	services := boxService.NewRegistry()
	routervpndesktoppt.RegisterNodeNetworkOwner(services)
	ctx := Context(t.Context(), ins, outs, ends, ds, services, certificate.NewRegistry())
	physical, err := prep.MultipleImportedDesktopPhysicalPolicy()
	if err != nil {
		t.Fatal(err)
	}
	ctx, err = RouterVPNDesktopNodeMultipleImportedExecutionContext(ctx, prep, physical)
	if err != nil {
		t.Fatal(err)
	}
	var graph map[string]any
	if err := json.Unmarshal([]byte(prep.Config()), &graph); err != nil {
		t.Fatal(err)
	}
	if change != nil {
		change(graph)
	}
	raw, err := json.Marshal(graph)
	if err != nil {
		t.Fatal(err)
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
	if err != nil {
		return nil, tun, err
	}
	options.Log = &option.LogOptions{Disabled: true}
	instance, err := New(Options{Context: ctx, Options: options})
	if instance != nil {
		t.Cleanup(func() {
			select {
			case <-instance.done:
				return
			default:
			}
			if err := instance.Close(); err != nil {
				t.Error("original multiple imported Box failed close", err)
			}
		})
	}
	return instance, tun, err
}

func TestRouterVPNDesktopMultipleImportedExecutionPhysicalActualBox(t *testing.T) {
	for _, layout := range []string{"single", "adjacent", "separated", "maximum-sparse", "maximum-public", "packet-first"} {
		for _, execution := range []string{"server", "auto"} {
			t.Run(layout+"/"+execution, func(t *testing.T) {
				prep, physical := desktopMultipleImportedExecutionPhysicalPreparation(t, layout, runtime.GOOS, execution)
				instance, tun, err := desktopMultipleImportedExecutionPhysicalBox(t, prep, nil)
				if err != nil || instance == nil || tun == nil {
					t.Fatal("original desktop multiple imported Box refused", err)
				}
				c, ok := instance.ctx.Value(routerVPNMultipleImportedExecutionKey{}).(*routerVPNMultipleImportedExecutionConstruction)
				original, sourceErr := prep.OriginalMultipleImportedSource()
				if !ok || c == nil || c.prep != prep || c.physical != physical || c.source != original || sourceErr != nil || c.instance != instance || c.outbounds != instance.outbound || c.transports != instance.dnsTransport || c.dns != instance.dnsRouter || c.resolver == nil || c.close == nil || len(c.members) != len(c.inventory) || len(c.members) == 0 {
					t.Fatal("desktop Box replaced an original imported owner")
				}
				for position, member := range c.members {
					if member == nil || member.Tag() != c.inventory[position].Tag {
						t.Fatal("native Box lost independent imported member")
					}
					for _, other := range c.members[:position] {
						if member == other {
							t.Fatal("native Box reused another imported provider")
						}
					}
				}
				if !routerVPNDesktopNodeChainMultipleImportedExecutionPhysicalTarget(physical, runtime.GOOS) {
					t.Fatal("original multiple imported physical target refused")
				}
				_, network, err := instance.routerVPNDesktopNodePhysical(physical)
				if err != nil || network == nil || network.Current() || network.SocketCurrent() || tun.ready || tun.claimed {
					t.Fatal("closed multiple imported execution fabricated host readiness", err)
				}
				local, err := physical.OriginalDesktopMultipleImportedPolicy()
				if err != nil {
					t.Fatal(err)
				}
				if _, _, err := instance.routerVPNDesktopNodePhysical(local); err == nil {
					t.Fatal("Local policy borrowed selected physical authority")
				}
				captured, err := routerVPNNodeChainExecutionPhysicalPolicy(prep)
				if err != nil || captured != physical {
					t.Fatal("MTU dispatcher replaced original physical owner", err)
				}
				if owner, err := instance.routerVPNDesktopNodeActivatePhysical(physical); err == nil || owner != nil {
					t.Fatal("unprepared multiple imported Box acquired physical permission")
				}
				if err := instance.Close(); err != nil {
					t.Fatal("original multiple imported Box failed to retire", err)
				}
				if err := c.close.JoinContext(t.Context(), instance); err != nil {
					t.Fatal("original multiple imported close receipt did not join", err)
				}
			})
		}
	}
}

func TestRouterVPNDesktopMultipleImportedExecutionPhysicalTarget(t *testing.T) {
	for _, target := range []string{"linux", "windows", "darwin"} {
		t.Run(target, func(t *testing.T) {
			_, physical := desktopMultipleImportedExecutionPhysicalPreparation(t, "maximum-sparse", target, "auto")
			if !routerVPNDesktopNodeChainMultipleImportedExecutionPhysicalTarget(physical, target) {
				t.Fatal("original typed multiple imported target refused")
			}
			for _, other := range []string{"linux", "windows", "darwin", "foreign"} {
				if other != target && routerVPNDesktopNodeChainMultipleImportedExecutionPhysicalTarget(physical, other) {
					t.Fatal("foreign target acquired multiple imported ownership")
				}
			}
			copy := *physical
			if routerVPNDesktopNodeChainMultipleImportedExecutionPhysicalTarget(&copy, target) {
				t.Fatal("copied physical policy acquired native authority")
			}
		})
	}
}

func TestRouterVPNDesktopMultipleImportedExecutionPhysicalChangedGraph(t *testing.T) {
	for _, fault := range []string{"first-password", "second-password", "first-remote", "second-remote", "first-detour", "second-detour", "final-detour", "dns", "physical-source", "mtu", "open-gate"} {
		t.Run(fault, func(t *testing.T) {
			prep, physical := desktopMultipleImportedExecutionPhysicalPreparation(t, "separated", runtime.GOOS, "auto")
			local, err := physical.OriginalDesktopMultipleImportedPolicy()
			if err != nil {
				t.Fatal(err)
			}
			_, meta, capture, err := local.ReadValidated()
			if err != nil {
				t.Fatal(err)
			}
			instance, tun, err := desktopMultipleImportedExecutionPhysicalBox(t, prep, func(graph map[string]any) {
				find := func(tag string) map[string]any {
					for _, field := range []string{"outbounds", "endpoints"} {
						for _, value := range graph[field].([]any) {
							row := value.(map[string]any)
							if row["tag"] == tag {
								return row
							}
						}
					}
					t.Fatal("original captured member absent")
					return nil
				}
				position := 1
				if strings.HasPrefix(fault, "second-") {
					position = 3
				}
				switch fault {
				case "first-password", "second-password":
					find(meta.Prefixes[position].Tag)["password"] = "foreign-provider"
				case "first-remote", "second-remote":
					find(meta.Prefixes[position].Tag)["server"] = "203.0.113.25"
				case "first-detour", "second-detour":
					delete(find(meta.Prefixes[position].Tag), "detour")
				case "final-detour":
					find(meta.Prefixes[len(meta.Prefixes)-1].Tag)["detour"] = meta.Prefixes[0].Tag
				case "dns":
					found := false
					for _, value := range graph["dns"].(map[string]any)["servers"].([]any) {
						row := value.(map[string]any)
						if row["tag"] == capture.SelectedDNS.Tag {
							row["server"] = "192.168.50.134"
							found = true
						}
					}
					if !found {
						t.Fatal("original selected DNS absent")
					}
				case "physical-source":
					graph["services"].([]any)[0].(map[string]any)["source_sha256"] = strings.Repeat("e", 64)
				case "mtu":
					row := graph["inbounds"].([]any)[0].(map[string]any)
					row["mtu"] = row["mtu"].(float64) + 16
				case "open-gate":
					graph["route"].(map[string]any)["final"] = mobilemultihop.SelectorTag
				}
			})
			if err == nil || instance != nil || tun != nil {
				t.Fatal("changed multiple imported graph reached native construction", err)
			}
		})
	}
}
