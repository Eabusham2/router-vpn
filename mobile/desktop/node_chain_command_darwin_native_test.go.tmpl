func darwinChildKey(t *testing.T) *ecdh.PrivateKey {
	t.Helper()
	key, e := ecdh.X25519().GenerateKey(rand.Reader)
	if e != nil {
		t.Fatal(e)
	}
	return key
}
func darwinChildProof(key *ecdh.PrivateKey) string {
	return darwinChildDigest([]byte("router-vpn-node-proof-v1\n" + base64.StdEncoding.EncodeToString(key.PublicKey().Bytes())))
}
func darwinChildPhysical(t *testing.T) netip.Addr {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	raw, e := darwinChildCommand(ctx, "/sbin/route", "-n", "get", "default")
	if e != nil || len(raw) > 8192 {
		t.Fatal("native default route unavailable", e)
	}
	name := ""
	for _, line := range strings.Split(string(raw), "\n") {
		f := strings.Fields(line)
		if len(f) == 2 && f[0] == "interface:" {
			if name != "" {
				t.Fatal("ambiguous physical default")
			}
			name = f[1]
		}
	}
	device, e := net.InterfaceByName(name)
	if e != nil || device.Flags&net.FlagUp == 0 || device.Flags&net.FlagLoopback != 0 {
		t.Fatal("missing physical default interface", e)
	}
	addresses, e := device.Addrs()
	if e != nil {
		t.Fatal(e)
	}
	for _, value := range addresses {
		prefix, e := netip.ParsePrefix(value.String())
		if e == nil && prefix.Addr().Is4() && prefix.Addr().IsGlobalUnicast() {
			return prefix.Addr()
		}
	}
	t.Fatal("physical default has no captured IPv4")
	return netip.Addr{}
}
func (p *darwinChildPeer) read(t *testing.T) darwinChildPeerReply {
	t.Helper()
	if e := p.output.SetReadDeadline(time.Now().Add(15 * time.Second)); e != nil {
		t.Fatal(e)
	}
	raw, e := p.reader.ReadSlice('\n')
	var r darwinChildPeerReply
	if e != nil || len(raw) > 32768 || !routerVPNMTUStrict(raw, &r) || r.Schema != 1 || len(r.Prefixes) != len(p.prefixes) {
		t.Fatal("ordered native peer lost its complete receipt", e)
	}
	addr, e := netip.ParseAddrPort(r.Address)
	if e != nil || addr.Addr() != p.physical || addr.Port() == 0 || r.PublicCA == "" || r.Final.FinalPublicIP != "203.0.113.89" {
		t.Fatal("ordered native peer substituted original physical identity", e)
	}
	if p.reply.Address != "" && (p.reply.Address != r.Address || p.reply.PublicCA != r.PublicCA) {
		t.Fatal("ordered native peer replaced its original endpoint")
	}
	for i, v := range p.prefixes {
		expected := ""
		if v.Mode != "wg" {
			params, e := awgpolicy.ParametersUAPI(v.Parameters)
			if e != nil {
				t.Fatal(e)
			}
			expected = darwinChildDigest([]byte(params))
		}
		if r.Prefixes[i].Mode != v.Mode || r.Prefixes[i].ParametersSHA256 != expected {
			t.Fatal("real ordered cipher parameter readback changed", i)
		}
	}
	p.reply = r
	return r
}
func (p *darwinChildPeer) observe(t *testing.T, action string) darwinChildPeerReply {
	t.Helper()
	if _, e := io.WriteString(p.input, action+"\n"); e != nil {
		t.Fatal(e)
	}
	return p.read(t)
}

// A missed graceful join already fails acceptance. Reaping this exact owned
// disposable peer after Kill has a separate bounded wait and never proves PF
// or engine retirement. An absent waiter receipt must not hang all diagnostics.
func darwinChildPeerJoin(command *exec.Cmd, done <-chan struct{}) (bool, error) {
	if command == nil || command.Process == nil || done == nil {
		return false, errors.New("real encrypted peer lost its original command waiter")
	}
	select {
	case <-done:
		return true, nil
	case <-time.After(5 * time.Second):
	}
	failure := errors.Join(errors.New("real encrypted peer did not join"), command.Process.Kill())
	select {
	case <-done:
		return true, failure
	case <-time.After(5 * time.Second):
		return false, errors.Join(failure, errors.New("original encrypted peer waiter remains unjoined"))
	}
}

func darwinChildPeerStart(t *testing.T, mixed bool) *darwinChildPeer {
	t.Helper()
	p := &darwinChildPeer{done: make(chan struct{}), physical: darwinChildPhysical(t), finalClient: darwinChildKey(t), finalServer: darwinChildKey(t)}
	secret := func() string {
		b := make([]byte, 32)
		if _, e := rand.Read(b); e != nil {
			t.Fatal(e)
		}
		return base64.StdEncoding.EncodeToString(b)
	}
	p.password = secret()
	modes := []string{"wg", "wg"}
	if mixed {
		modes = []string{"wg", "awg2-fast", "awg2-strong"}
	}
	for i, mode := range modes {
		client, server := darwinChildKey(t), darwinChildKey(t)
		p.clients = append(p.clients, client)
		v := darwinChildPrefix{Mode: mode, PrivateKey: base64.StdEncoding.EncodeToString(server.Bytes()), ClientPublicKey: base64.StdEncoding.EncodeToString(client.PublicKey().Bytes()), PreSharedKey: secret(), NodeProofID: darwinChildProof(server), APIToken: fmt.Sprintf("native-ordered-prefix-%d-token", i)}
		if mode != "wg" {
			v.Parameters = map[string]string{"jc": "3", "jmin": "40", "jmax": "900", "s1": "56", "s2": "48", "s3": "24", "s4": "32", "h1": "10000000-19999999", "h2": "20000000-29999999", "h3": "30000000-39999999", "h4": "40000000-49999999"}
			if mode == "awg2-strong" {
				v.Parameters["jc"], v.Parameters["jmax"] = "8", "1200"
			}
		}
		p.prefixes = append(p.prefixes, v)
	}
	image := os.Getenv("ROUTERVPN_DARWIN_NODE_CHAIN_PEER")
	raw, e := os.ReadFile(image)
	if e != nil || image != macosprocess.InstallRoot+"/peer.test" || darwinChildDigest(raw) != os.Getenv("ROUTERVPN_DARWIN_NODE_CHAIN_PEER_SHA256") {
		t.Fatal("ordered native peer lost original compiled image", e)
	}
	p.command = exec.Command(image, "-test.run=^TestRouterVPNDesktopNodeChainReferenceProcess$", "-test.count=1", "-test.timeout=180s")
	p.command.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "GORACE=atexit_sleep_ms=0", "ROUTERVPN_NODE_CHAIN_REFERENCE_CHILD=1", "ROUTERVPN_DARWIN_NODE_CHAIN_REFERENCE=1", "ROUTERVPN_DARWIN_NODE_CHAIN_ADDRESS=" + p.physical.String()}
	p.command.Stderr = os.Stderr
	p.input, e = p.command.StdinPipe()
	if e != nil {
		t.Fatal(e)
	}
	var writer *os.File
	p.output, writer, e = os.Pipe()
	if e != nil {
		t.Fatal(e)
	}
	p.reader = bufio.NewReaderSize(p.output, 32769)
	p.command.Stdout = writer
	if e := p.command.Start(); e != nil {
		t.Fatal(e)
	}
	writer.Close()
	go func() { p.failure = p.command.Wait(); close(p.done) }()
	t.Cleanup(func() {
		p.input.Close()
		joined, joinErr := darwinChildPeerJoin(p.command, p.done)
		if joinErr != nil {
			t.Error(joinErr)
		}
		if joined && p.failure != nil {
			t.Error("real encrypted peer failed joined cleanup", p.failure)
		}
		p.output.Close()
	})
	request := map[string]any{"schema": 1, "address": p.physical.String(), "client_address": p.physical.String(), "prefixes": p.prefixes, "final_password": p.password, "final_node_proof_id": darwinChildProof(p.finalServer), "final_api_token": "native-ordered-final-token"}
	if e := json.NewEncoder(p.input).Encode(request); e != nil {
		t.Fatal(e)
	}
	r := p.read(t)
	for _, v := range r.Prefixes {
		if v.RawUDP != 0 || v.TCP != 0 || v.UDP != 0 || v.ProofQueries != 0 {
			t.Fatal("peer fabricated traffic before child start")
		}
	}
	if r.Final.FinalRawTCP != 0 || r.Final.DNSQueries != 0 || r.Final.RouterQueries != 0 {
		t.Fatal("final peer fabricated proof before child start")
	}
	return p
}

