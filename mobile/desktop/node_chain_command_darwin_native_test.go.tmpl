const darwinChildFlag = "ROUTERVPN_DARWIN_NODE_CHILD_ACCEPTANCE"

var darwinChildCases = []string{"wg-three", "mixed-four", "captured-mtu", "mtu-rollback", "wrong-middle-key", "wrong-middle-proof", "final-dns-failure", "foreign-mtu-session"}

// Only this explicitly tagged native acceptance executable dispatches its real
// generated command from init. The command itself is unchanged shipping code.
func init() {
	if len(os.Args) > 1 && os.Args[1] == "routervpn-node-chain" {
		globalCtx = include.Context(service.ContextWithDefaultRegistry(context.Background()))
		mainCommand.SilenceUsage = true
		mainCommand.SilenceErrors = true
		mainCommand.SetArgs(os.Args[1:])
		if _, err := mainCommand.ExecuteC(); err != nil {
			fmt.Fprintln(os.Stderr, err)
			os.Exit(122)
		}
		os.Exit(0)
	}
}
func darwinChildJSON(t *testing.T, v any) []byte {
	t.Helper()
	b, e := json.Marshal(v)
	if e != nil {
		t.Fatal(e)
	}
	return b
}
func darwinChildDigest(b []byte) string { s := sha256.Sum256(b); return hex.EncodeToString(s[:]) }
func darwinChildNonce(t *testing.T, n int) string {
	t.Helper()
	b := make([]byte, n)
	if _, e := rand.Read(b); e != nil {
		t.Fatal(e)
	}
	return hex.EncodeToString(b)
}
func darwinChildCommand(ctx context.Context, path string, args ...string) ([]byte, error) {
	c := exec.CommandContext(ctx, path, args...)
	c.WaitDelay = 5 * time.Second
	c.Dir = "/"
	c.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL=C", "GORACE=atexit_sleep_ms=0"}
	return c.CombinedOutput()
}
func darwinChildNative(t *testing.T) {
	t.Helper()
	if runtime.GOOS != "darwin" || os.Getuid() != 0 || os.Geteuid() != 0 || os.Getenv(darwinChildFlag) != "1" {
		t.Fatal("actual disposable Darwin root fixture is required")
	}
}
func darwinChildImage(t *testing.T, source, target, expected string) {
	t.Helper()
	if !filepath.IsAbs(source) || !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(expected) {
		t.Fatal("native image lost its original captured digest")
	}
	f, e := os.OpenFile(source, os.O_RDONLY|syscall.O_NOFOLLOW, 0)
	if e != nil {
		t.Fatal(e)
	}
	defer f.Close()
	before, e := f.Stat()
	if e != nil || !before.Mode().IsRegular() || before.Size() < 1 || before.Size() > 512<<20 || before.Mode().Perm()&0022 != 0 || before.Mode().Perm()&0111 == 0 {
		t.Fatal("unsafe original native image", e)
	}
	b, e := io.ReadAll(io.LimitReader(f, 512<<20+1))
	after, e2 := f.Stat()
	if e != nil || e2 != nil || !os.SameFile(before, after) || before.Size() != after.Size() || before.ModTime() != after.ModTime() || darwinChildDigest(b) != expected {
		t.Fatal("original native image changed during copy")
	}
	out, e := os.OpenFile(target, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0755)
	if e != nil {
		t.Fatal(e)
	}
	_, e = out.Write(b)
	e = errors.Join(e, out.Sync(), out.Close())
	if e != nil {
		t.Fatal(e)
	}
}

// A failed controller may retain a separately grouped guardian that inherited
// stderr. Bound the output-pipe wait after the controller exits or its original
// context expires. ErrWaitDelay remains a failed test, never native retirement.
func darwinChildHarnessOutput(command *exec.Cmd) ([]byte, error) {
	command.WaitDelay = 5 * time.Second
	var output bytes.Buffer
	command.Stdout = io.MultiWriter(&output, os.Stdout)
	command.Stderr = command.Stdout
	err := command.Run()
	return output.Bytes(), err
}

// The actual engine can fail while a separately grouped guardian still owns
// its inherited diagnostic pipe. An output timeout is an error, never Stop.
func darwinChildEngineOutput(command *exec.Cmd, output io.Writer) {
	command.WaitDelay = 5 * time.Second
	command.Stdout, command.Stderr = output, output
}

// The parent creates only a new disposable fixed installation. It refuses any
// pre-existing installed source/lock/socket and never adopts or deletes one.
func TestRouterVPNNodeChainDarwinNativeHarness(t *testing.T) {
	darwinChildHarness(t, false)
}

func TestRouterVPNNodeChainDarwinNativeHandshakeHarness(t *testing.T) {
	darwinChildHarness(t, true)
}

func darwinChildHarness(t *testing.T, preflight bool) {
	darwinChildNative(t)
	for _, p := range []string{macosprocess.InstallRoot, macosprocess.InstallLockPath, macosprocess.ProcessLockPath, filepath.Dir(macosprocess.LifetimePath)} {
		if _, e := os.Lstat(p); !errors.Is(e, os.ErrNotExist) {
			t.Fatal("native child fixture requires an absent installation", p, e)
		}
	}
	if e := os.Mkdir(macosprocess.InstallRoot, 0755); e != nil {
		t.Fatal(e)
	}
	root, e := os.Lstat(macosprocess.InstallRoot)
	if e != nil {
		t.Fatal(e)
	}
	complete := false
	t.Cleanup(func() {
		current, e := os.Lstat(macosprocess.InstallRoot)
		if !complete || e != nil || !os.SameFile(root, current) {
			t.Error("native fixture retained its installation because original joined cleanup was not proved")
			return
		}
		for _, p := range []string{macosprocess.InstallLockPath, macosprocess.ProcessLockPath} {
			f, e := os.OpenFile(p, os.O_RDWR|syscall.O_NOFOLLOW, 0)
			if e != nil {
				t.Error(e)
				return
			}
			e = syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
			if e != nil {
				f.Close()
				t.Error("native fixture locks remain held", e)
				return
			}
			f.Close()
		}
		if e := os.RemoveAll(macosprocess.InstallRoot); e != nil {
			t.Error(e)
		}
		for _, p := range []string{macosprocess.InstallLockPath, macosprocess.ProcessLockPath} {
			if e := os.Remove(p); e != nil {
				t.Error(e)
			}
		}
		if e := os.Remove(filepath.Dir(macosprocess.LifetimePath)); e != nil {
			t.Error(e)
		}
	})
	for _, p := range []string{filepath.Dir(macosprocess.EnginePath), macosprocess.InstallRoot + "/run/native-node", filepath.Dir(macosprocess.LifetimePath)} {
		if e := os.MkdirAll(p, 0755); e != nil {
			t.Fatal(e)
		}
	}
	image, e := os.Executable()
	if e != nil {
		t.Fatal(e)
	}
	expected := os.Getenv("ROUTERVPN_DARWIN_NODE_CHILD_SHA256")
	for _, p := range []string{macosprocess.ControllerPath, macosprocess.EnginePath} {
		darwinChildImage(t, image, p, expected)
		before, statErr := os.Lstat(p)
		if statErr != nil {
			t.Fatal("native fixture signing input", p, statErr)
		}
		started := time.Now()
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		out, e := darwinChildCommand(ctx, "/usr/bin/codesign", "--force", "--sign", "-", "--timestamp=none", "--identifier", "routervpn.fixture."+filepath.Base(p), p)
		cause := ctx.Err()
		cancel()
		if e != nil {
			t.Fatalf("native fixture signing image=%s bytes=%d elapsed=%s context=%v: %v\n%s", p, before.Size(), time.Since(started), cause, e, out)
		}
	}
	peer := macosprocess.InstallRoot + "/peer.test"
	darwinChildImage(t, os.Getenv("ROUTERVPN_DARWIN_NODE_CHAIN_PEER"), peer, os.Getenv("ROUTERVPN_DARWIN_NODE_CHAIN_PEER_SHA256"))
	engine, e := os.ReadFile(macosprocess.EnginePath)
	if e != nil {
		t.Fatal(e)
	}
	digest := darwinChildDigest(engine)
	catalog := map[string]any{"Runtime": "sing-box-routervpn", "Target": "darwin/" + runtime.GOARCH, "Size": len(engine), "SHA256": digest, "Files": map[string]any{"sing-box-routervpn": map[string]any{"Size": len(engine), "SHA256": digest}}}
	if e := os.WriteFile(macosprocess.CatalogPath, darwinChildJSON(t, catalog), 0644); e != nil {
		t.Fatal(e)
	}
	target, deadline, alarm := "TestRouterVPNNodeChainDarwinNativeCommand", 900*time.Second, "890s"
	markerName, markerBody := "native-child-complete", "all original child owners joined\n"
	if preflight {
		target, deadline, alarm = "TestRouterVPNNodeChainDarwinNativeHandshake", 90*time.Second, "85s"
		markerName, markerBody = "native-handshake-complete", "original preflight child joined without native preparation\n"
	}
	ctx, cancel := context.WithTimeout(context.Background(), deadline)
	defer cancel()
	command := exec.CommandContext(ctx, macosprocess.ControllerPath, "-test.run=^"+target+"$", "-test.v", "-test.count=1", "-test.timeout="+alarm)
	command.Dir = "/"
	command.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL=C", "GORACE=atexit_sleep_ms=0", darwinChildFlag + "=1", "ROUTERVPN_DARWIN_NODE_CHILD_INSTALLED=1", "ROUTERVPN_DARWIN_NODE_CHILD_UID=" + os.Getenv("ROUTERVPN_DARWIN_NODE_CHILD_UID"), "ROUTERVPN_DARWIN_NODE_CHAIN_PEER=" + peer, "ROUTERVPN_DARWIN_NODE_CHAIN_PEER_SHA256=" + os.Getenv("ROUTERVPN_DARWIN_NODE_CHAIN_PEER_SHA256")}
	_, e = darwinChildHarnessOutput(command)
	if e != nil {
		t.Fatal("actual installed generated-child fixture failed", e)
	}
	marker, e := os.ReadFile(macosprocess.InstallRoot + "/" + markerName)
	if e != nil || string(marker) != markerBody {
		t.Fatal("native harness lacks complete joined original receipt", e)
	}
	complete = true
}

type darwinChildAuthority struct {
	install, process, lifetime *os.File
	listener                   *net.UnixListener
	gui                        *exec.Cmd
	done                       chan struct{}
	failure                    error
}

func TestRouterVPNNodeChainDarwinNativeGUIPeer(t *testing.T) {
	if os.Getenv("ROUTERVPN_DARWIN_NODE_CHILD_GUI") != "1" || os.Getuid() == 0 || os.Geteuid() == 0 {
		t.Fatal("native GUI peer requires its actual unprivileged task")
	}
	c, e := net.DialUnix("unix", nil, &net.UnixAddr{Name: macosprocess.LifetimePath, Net: "unix"})
	if e != nil {
		t.Fatal(e)
	}
	defer c.Close()
	var b [1]byte
	n, e := c.Read(b[:])
	if n != 0 || !errors.Is(e, io.EOF) {
		t.Fatal("native GUI lifetime received an unexpected frame", n, e)
	}
}
func darwinChildAuthorityStart(t *testing.T) *darwinChildAuthority {
	t.Helper()
	a := &darwinChildAuthority{done: make(chan struct{})}
	for i, p := range []string{macosprocess.InstallLockPath, macosprocess.ProcessLockPath} {
		f, e := os.OpenFile(p, os.O_RDWR|os.O_CREATE|os.O_EXCL|syscall.O_NOFOLLOW, 0600)
		if e != nil {
			t.Fatal(e)
		}
		mode := syscall.LOCK_SH
		if i == 1 {
			mode = syscall.LOCK_EX
		}
		if e := syscall.Flock(int(f.Fd()), mode|syscall.LOCK_NB); e != nil {
			t.Fatal(e)
		}
		if i == 0 {
			a.install = f
		} else {
			a.process = f
		}
	}
	uid, e := strconv.ParseUint(os.Getenv("ROUTERVPN_DARWIN_NODE_CHILD_UID"), 10, 32)
	if e != nil || uid < 1 || uid == uint64(^uint32(0)) {
		t.Fatal("native fixture lost its original unprivileged UID")
	}
	a.listener, e = net.ListenUnix("unix", &net.UnixAddr{Name: macosprocess.LifetimePath, Net: "unix"})
	if e != nil {
		t.Fatal(e)
	}
	if e := os.Chmod(macosprocess.LifetimePath, 0666); e != nil {
		t.Fatal(e)
	}
	a.gui = exec.Command(macosprocess.ControllerPath, "-test.run=^TestRouterVPNNodeChainDarwinNativeGUIPeer$", "-test.count=1", "-test.timeout=900s")
	a.gui.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "ROUTERVPN_DARWIN_NODE_CHILD_GUI=1", "GORACE=atexit_sleep_ms=0"}
	a.gui.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: uint32(uid), Gid: uint32(uid)}}
	a.gui.Stderr = os.Stderr
	if e := a.gui.Start(); e != nil {
		t.Fatal(e)
	}
	go func() { a.failure = a.gui.Wait(); close(a.done) }()
	if e := a.listener.SetDeadline(time.Now().Add(10 * time.Second)); e != nil {
		t.Fatal(e)
	}
	c, e := a.listener.AcceptUnix()
	if e != nil {
		t.Fatal(e)
	}
	a.lifetime, e = c.File()
	c.Close()
	if e != nil {
		t.Fatal(e)
	}
	return a
}
func (a *darwinChildAuthority) close() error {
	result := a.lifetime.Close()
	result = errors.Join(result, a.listener.Close())
	select {
	case <-a.done:
		result = errors.Join(result, a.failure)
	case <-time.After(5 * time.Second):
		return errors.Join(result, errors.New("original GUI peer did not join"))
	}
	return errors.Join(result, a.process.Close(), a.install.Close())
}

