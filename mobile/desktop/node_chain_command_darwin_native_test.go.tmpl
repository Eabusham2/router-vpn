func (o *darwinChildOwner) current(ctx context.Context) error {
	if ctx == nil || ctx.Err() != nil || o.closed || o.capture == nil || o.bootstrap == nil || o.command == nil || o.command.Process == nil {
		return errors.New("native acceptance lost original child")
	}
	select {
	case <-o.done:
		return errors.Join(o.failure, errors.New("native child exited before authenticated stop"))
	default:
	}
	if e := o.capture.Current(ctx); e != nil {
		return e
	}
	if e := o.bootstrap.Current(ctx); e != nil {
		return e
	}
	transfer, e := macosprocess.NodeChainTransferSHA256(o.capture.Selection())
	if e != nil || transfer != o.transfer {
		return errors.Join(e, errors.New("native capture transfer changed"))
	}
	return nil
}
func darwinChildInterface(name string) bool {
	if !strings.HasPrefix(name, "utun") || len(name) == 4 {
		return false
	}
	for _, r := range name[4:] {
		if r < '0' || r > '9' {
			return false
		}
	}
	return true
}
func (o *darwinChildOwner) observation(ctx context.Context) (routerVPNNodeMTURecord, mobilemultihop.DesktopNodeChainReadyRecord, error) {
	var mtu routerVPNNodeMTURecord
	var proof mobilemultihop.DesktopNodeChainReadyRecord
	if e := o.current(ctx); e != nil {
		return mtu, proof, e
	}
	raw, e := o.files.read("node-mtu-status.json", routerVPNNodeMTURecordLimit)
	if e != nil {
		return mtu, proof, e
	}
	if !routerVPNMTUStrict(raw, &mtu) {
		return mtu, proof, errors.New("malformed exact native MTU readback")
	}
	raw, e = o.files.read("node-chain-ready.json", mobilemultihop.DesktopNodeChainReadyRecordLimit)
	if e != nil {
		return mtu, proof, e
	}
	proof, e = mobilemultihop.ParseDesktopNodeChainReadyRecord(raw, o.policy, o.transfer)
	if e != nil {
		return mtu, proof, e
	}
	meta := o.policy.Metadata()
	now := time.Now().UnixMilli()
	iface, e := net.InterfaceByName(mtu.Interface)
	if e != nil || !darwinChildInterface(mtu.Interface) || iface.Index != mtu.Index || iface.MTU != mtu.MTU || iface.Flags&net.FlagUp == 0 || mtu.Session != meta.SessionID || mtu.Config != meta.ConfigSHA256 || mtu.Reader == 0 || mtu.Schema != 1 || mtu.Failure != "" || mtu.Heartbeat > now || now-mtu.Heartbeat > 10000 || proof.ObservedAt > now || now-proof.ObservedAt > 10000 || proof.Reader != mtu.Reader || proof.InterfaceName != mtu.Interface || int(proof.InterfaceIndex) != mtu.Index || proof.MTU != mtu.MTU {
		return mtu, proof, errors.Join(e, errors.New("native heartbeat differs from actual utun/reader"))
	}
	o.observed[mtu.Index] = mtu.Interface
	return mtu, proof, o.current(ctx)
}
func (o *darwinChildOwner) wait(t *testing.T, ctx context.Context, request string) (routerVPNNodeMTURecord, mobilemultihop.DesktopNodeChainReadyRecord) {
	t.Helper()
	var last error
	for {
		mtu, proof, e := o.observation(ctx)
		if e == nil && (request == "" || mtu.Request == request) {
			return mtu, proof
		}
		last = e
		select {
		case <-ctx.Done():
			t.Fatal("actual child did not publish matching original proof/utun", ctx.Err(), last, o.output.String())
		case <-o.done:
			t.Fatal("actual child exited before readiness", o.failure, o.output.String())
		case <-time.After(20 * time.Millisecond):
		}
	}
}
func (o *darwinChildOwner) stop(ctx context.Context) error {
	if o.closed {
		return nil
	}
	if o.command == nil || o.command.Process == nil || o.bootstrap == nil {
		return errors.New("native partial child has no authenticated original stop")
	}
	if !o.stopped {
		if e := o.bootstrap.Stop(ctx); e != nil {
			return e
		}
		o.stopped = true
	}
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-o.done:
		if o.failure != nil {
			return o.failure
		}
	}
	raw, e := o.files.read("stopped.json", 4096)
	var record struct {
		routerVPNExternalStop
		Closed bool `json:"closed"`
	}
	meta := o.policy.Metadata()
	if e != nil || !routerVPNMTUStrict(raw, &record) || record.Schema != 1 || record.Session != meta.SessionID || record.SourceSHA256 != meta.ConfigSHA256 || !record.Closed {
		return errors.Join(e, errors.New("native stop lacks original joined receipt"))
	}
	for _, name := range []string{"node-ready.json", "node-chain-ready.json"} {
		if _, e := o.files.root.Lstat(name); !errors.Is(e, os.ErrNotExist) {
			return errors.New("retired child retained readiness")
		}
	}
	interfaces, e := net.Interfaces()
	if e != nil {
		return e
	}
	for _, iface := range interfaces {
		if _, found := o.observed[iface.Index]; found {
			return errors.New("native stop acknowledged before original utun disappeared")
		}
	}
	if o.baseline == nil {
		return errors.New("retired child lost original PF receipt")
	}
	clearRequest := mobiletor.DesktopDarwinPFBaselineRequest{Schema: 1, Action: "clear", Expected: []mobiletor.DesktopDarwinPFBaselineProof{o.baseline.Target}}
	retired, e := darwinChildBaseline(ctx, clearRequest, true)
	if e != nil || retired.Previous != o.baseline.Target || retired.Target.Present {
		return errors.Join(e, errors.New("native stop did not retire exact PF baseline"))
	}
	if e := o.capture.Current(ctx); e != nil {
		return e
	}
	e = errors.Join(o.bootstrap.Close(), o.channel.Close(), o.capture.Close(), o.files.root.Close())
	if e != nil {
		return e
	}
	o.closed = true
	return nil
}

func darwinChildTraffic(t *testing.T, ctx context.Context, p *darwinChildPeer) {
	t.Helper()
	transport := &http.Transport{Proxy: nil, DisableKeepAlives: true}
	defer transport.CloseIdleConnections()
	request, e := http.NewRequestWithContext(ctx, http.MethodGet, "http://10.77.0.1:8787/api/benchmark/download?bytes=65536", nil)
	if e != nil {
		t.Fatal(e)
	}
	request.Header.Set("Authorization", "Bearer native-ordered-final-token")
	response, e := transport.RoundTrip(request)
	if e != nil {
		t.Fatal("actual utun TCP did not reach original encrypted final", e)
	}
	body, e := io.ReadAll(io.LimitReader(response.Body, 65537))
	response.Body.Close()
	if e != nil || response.StatusCode != 200 || len(body) != 65536 || response.Header.Get("X-Routervpn-Benchmark") != "download-v1" {
		t.Fatal("actual encrypted TCP payload changed", e)
	}
	connection, e := (&net.Dialer{}).DialContext(ctx, "udp4", "10.77.0.1:45999")
	if e != nil {
		t.Fatal(e)
	}
	defer connection.Close()
	if e := connection.SetDeadline(time.Now().Add(3 * time.Second)); e != nil {
		t.Fatal(e)
	}
	payload := bytes.Repeat([]byte("actual-darwin-ordered-utun-"), 30)
	if _, e := connection.Write(payload); e != nil {
		t.Fatal(e)
	}
	reply := make([]byte, len(payload)+1)
	n, e := connection.Read(reply)
	if e != nil || n != len(payload) || !bytes.Equal(payload, reply[:n]) {
		t.Fatal("actual encrypted UDP payload changed", e)
	}
	stats := p.observe(t, "stats")
	for i, v := range stats.Prefixes {
		if v.RawUDP <= 0 || v.TCP <= 0 || v.UDP <= 0 || v.ProofQueries == 0 || v.AuthRefusals != 0 {
			t.Fatal("every original encrypted prefix did not prove and carry traffic", i, v)
		}
	}
	if stats.Final.FinalRawTCP <= 0 || stats.Final.FinalRawUDP <= 0 || stats.Final.FinalTCP <= 0 || stats.Final.FinalUDP <= 0 || stats.Final.RouterQueries == 0 || stats.Final.DNSQueries == 0 || stats.Final.FinalPublicQueries == 0 || stats.Final.EntryPublicQueries != 0 || stats.Final.DirectQueries != 0 || stats.Final.DownloadBytes < 65536 || stats.Final.CoverReplies == 0 {
		t.Fatal("final selected DNS/TCP/UDP/exit proof bypassed its original encrypted path", stats.Final)
	}
}
func (o *darwinChildOwner) consume(t *testing.T, ctx context.Context) {
	t.Helper()
	for {
		actual, e := o.files.root.Lstat("node-mtu-request.json")
		if errors.Is(e, os.ErrNotExist) {
			delete(o.files.owned, "node-mtu-request.json")
			return
		}
		if e != nil || o.files.owned["node-mtu-request.json"] == nil || !os.SameFile(actual, o.files.owned["node-mtu-request.json"]) {
			t.Fatal("native MTU request was replaced before consumption", e)
		}
		select {
		case <-ctx.Done():
			t.Fatal("native MTU request was not consumed", ctx.Err())
		case <-o.done:
			t.Fatal("native child exited before mailbox consumption")
		case <-time.After(20 * time.Millisecond):
		}
	}
}
func darwinChildMTURollback(t *testing.T, ctx context.Context, o *darwinChildOwner) {
	t.Helper()
	status, proof := o.wait(t, ctx, "")
	original := status.MTU
	lease := darwinChildNonce(t, 16)
	plan, e := o.policy.NodeChain().MTUPlan()
	if e != nil {
		t.Fatal(e)
	}
	candidate := original + 32
	if candidate > plan.Ceiling {
		candidate = original - 32
	}
	if candidate < 1280 || candidate == original {
		t.Fatal("actual MTU fixture has no distinct valid candidate")
	}
	for _, action := range []string{"begin", "set", "rollback"} {
		command := routerVPNNodeMTUCommand{Schema: 1, Session: status.Session, Config: status.Config, Path: status.Path, Generation: status.Generation + 1, Request: darwinChildNonce(t, 16), Lease: lease, Action: action, Reader: status.Reader, MTU: status.MTU}
		if action == "set" {
			command.Value = candidate
		}
		if e := o.files.publish("node-mtu-request.json", command); e != nil {
			t.Fatal(e)
		}
		old, priorProof := status, proof
		status, proof = o.wait(t, ctx, command.Request)
		o.consume(t, ctx)
		if status.Generation != command.Generation || status.Path != old.Path || status.Lease != lease || proof.Identity != priorProof.Identity || proof.TransferSHA256 != priorProof.TransferSHA256 {
			t.Fatal("native MTU changed the original ordered identity")
		}
		if action == "begin" {
			if status.Reader != old.Reader || status.Index != old.Index || status.Interface != old.Interface || status.MTU != original || !status.Active || proof.Generation != priorProof.Generation {
				t.Fatal("begin replaced the original native reader")
			}
		} else {
			if status.Reader != old.Reader+1 || proof.Generation != priorProof.Generation+1 || status.Index == old.Index {
				t.Fatal("real MTU mutation did not install a fresh original native reader")
			}
			interfaces, e := net.Interfaces()
			if e != nil {
				t.Fatal(e)
			}
			for _, device := range interfaces {
				if device.Index == old.Index {
					t.Fatal("replacement utun published before original utun retired")
				}
			}
			if action == "set" && (!status.Active || status.MTU != candidate) || action == "rollback" && (status.Active || !status.Restored || status.MTU != original) {
				t.Fatal("native MTU rollback lost exact original value")
			}
		}
	}
}
func darwinChildForeignMTU(t *testing.T, ctx context.Context, o *darwinChildOwner) {
	t.Helper()
	before, proof := o.wait(t, ctx, "")
	command := routerVPNNodeMTUCommand{Schema: 1, Session: darwinChildNonce(t, 16), Config: before.Config, Path: before.Path, Generation: before.Generation + 1, Request: darwinChildNonce(t, 16), Lease: darwinChildNonce(t, 16), Action: "begin", Reader: before.Reader, MTU: before.MTU}
	if e := o.files.publish("node-mtu-request.json", command); e != nil {
		t.Fatal(e)
	}
	for {
		current, next := o.wait(t, ctx, "")
		if current.Generation != before.Generation || current.Reader != before.Reader || current.Interface != before.Interface || current.Index != before.Index || current.MTU != before.MTU || current.Active || next.Generation != proof.Generation {
			t.Fatal("foreign session acquired original native MTU reader")
		}
		if current.Heartbeat >= before.Heartbeat+500 {
			break
		}
		select {
		case <-ctx.Done():
			t.Fatal(ctx.Err())
		case <-time.After(20 * time.Millisecond):
		}
	}
	if e := o.files.remove("node-mtu-request.json"); e != nil {
		t.Fatal(e)
	}
}
func darwinChildAwaitRefusal(t *testing.T, ctx context.Context, o *darwinChildOwner, p *darwinChildPeer, scenario string) {
	t.Helper()
	for {
		if e := o.current(ctx); e != nil {
			t.Fatal(e, o.output.String())
		}
		for _, name := range []string{"node-ready.json", "node-chain-ready.json"} {
			if _, e := o.files.root.Lstat(name); !errors.Is(e, os.ErrNotExist) {
				t.Fatal("invalid original path published readiness", name, e)
			}
		}
		if _, e := o.files.read("stopped.json", 4096); e == nil {
			break
		} else if !errors.Is(e, os.ErrNotExist) {
			t.Fatal(e)
		}
		select {
		case <-ctx.Done():
			t.Fatal("invalid original native path did not join its refused proof", ctx.Err(), o.output.String())
		case <-o.done:
			t.Fatal("native refusal exited without authenticated stop")
		case <-time.After(20 * time.Millisecond):
		}
	}
	stats := p.observe(t, "stats")
	if stats.Final.EntryPublicQueries != 0 || stats.Final.DirectQueries != 0 || stats.Final.CoverPackets != 0 || stats.Final.DownloadBytes != 0 {
		t.Fatal("refused ordered path forwarded a bypass payload", stats.Final)
	}
	switch scenario {
	case "wrong-middle-key":
		if stats.Prefixes[0].RawUDP == 0 || stats.Prefixes[1].ProofQueries != 0 || stats.Final.RouterQueries != 0 || stats.Final.DNSQueries != 0 {
			t.Fatal("wrong middle key bypassed its original encrypted prefix", stats)
		}
	case "wrong-middle-proof":
		if stats.Prefixes[1].ProofQueries == 0 || stats.Final.RouterQueries != 0 || stats.Final.DNSQueries != 0 {
			t.Fatal("wrong middle proof advanced to its final", stats)
		}
	case "final-dns-failure":
		if stats.Final.DNSQueries == 0 {
			t.Fatal("selected DNS refusal never queried its original resolver")
		}
	}
}
func TestRouterVPNNodeChainDarwinNativeCommand(t *testing.T) {
	darwinChildNative(t)
	image, e := os.Executable()
	if e != nil || image != macosprocess.ControllerPath || os.Getenv("ROUTERVPN_DARWIN_NODE_CHILD_INSTALLED") != "1" {
		t.Fatal("native child acceptance requires its original installed controller")
	}
	authority := darwinChildAuthorityStart(t)
	authorityClosed := false
	t.Cleanup(func() {
		if !authorityClosed {
			t.Error("original native authority remains retained after failed cleanup")
		}
	})
	fmt.Println("Darwin native child stage: acquiring original PF enable reference")
	enable, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	raw, e := darwinChildCommand(enable, "/sbin/pfctl", "-E")
	cancel()
	match := regexp.MustCompile(`(?m)^Token\s*:\s*([0-9]+)\s*$`).FindSubmatch(raw)
	if e != nil || len(match) != 2 {
		t.Fatal("native PF enable reference unavailable", e, string(raw))
	}
	pfToken := string(match[1])
	allJoined := true
	t.Cleanup(func() {
		if !allJoined {
			t.Error("original PF enable reference retained until native join")
			return
		}
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		if raw, e := darwinChildCommand(ctx, "/sbin/pfctl", "-X", pfToken); e != nil {
			t.Error("original PF reference did not retire", e, string(raw))
		}
	})
	for _, scenario := range darwinChildCases {
		if !t.Run(scenario, func(t *testing.T) {
			fmt.Println("Darwin native child case:", scenario)
			ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
			defer cancel()
			peer := darwinChildPeerStart(t, scenario == "mixed-four")
			owner := &darwinChildOwner{}
			darwinChildTrust(t, peer, func() bool { return owner.closed || owner.command == nil })
			t.Cleanup(func() {
				cleanup, stop := context.WithTimeout(context.Background(), 15*time.Second)
				defer stop()
				fmt.Println("Darwin native child stage: joining original cleanup")
				var e error
				if owner.childStartAttempted {
					e = owner.stop(cleanup)
				} else {
					e = owner.stopUnstarted(cleanup, t.Failed())
				}
				if e != nil {
					fmt.Println("Darwin native child stage: original cleanup remains unproved")
					allJoined = false
					t.Error("original native child cleanup unproved", e, owner.output.String())
				}
			})
			if scenario == "wrong-middle-proof" {
				peer.observe(t, "wrong-node:1")
			}
			if scenario == "final-dns-failure" {
				peer.observe(t, "fail-dns")
			}
			policy := darwinChildPolicy(t, peer, scenario)
			owner.start(t, ctx, authority, policy)
			refused := scenario == "wrong-middle-key" || scenario == "wrong-middle-proof" || scenario == "final-dns-failure"
			if refused {
				darwinChildAwaitRefusal(t, ctx, owner, peer, scenario)
			} else {
				status, _ := owner.wait(t, ctx, "")
				raw, e := owner.files.read("node-ready.json", mobilemultihop.DesktopNodeReadyRecordLimit)
				ready, e2 := mobilemultihop.ParseDesktopNodeReadyRecord(raw, policy, owner.transfer)
				if e != nil || e2 != nil || ready.InterfaceName != status.Interface || int(ready.InterfaceIndex) != status.Index || ready.MTU != status.MTU || ready.DNSMilliseconds <= 0 {
					t.Fatal("original selected DNS readiness lost actual utun", e, e2)
				}
				if scenario == "captured-mtu" || scenario == "mtu-rollback" {
					if status.MTU != 1280 {
						t.Fatal("child ignored manifest restored MTU")
					}
				}
				if scenario == "mtu-rollback" {
					darwinChildMTURollback(t, ctx, owner)
				}
				if scenario == "foreign-mtu-session" {
					darwinChildForeignMTU(t, ctx, owner)
				}
				darwinChildTraffic(t, ctx, peer)
			}
			fmt.Println("Darwin native child stage: requesting authenticated original Stop")
			cleanup, stop := context.WithTimeout(context.Background(), 15*time.Second)
			e := owner.stop(cleanup)
			stop()
			if e != nil {
				allJoined = false
				t.Fatal("authenticated original stop did not join native owners", e, owner.output.String())
			}
			t.Log("verified original Darwin child retirement: " + scenario)
		}) {
			break
		}
	}
	if t.Failed() || !allJoined {
		return
	}
	if e := authority.close(); e != nil {
		t.Fatal(e)
	}
	authorityClosed = true
	if e := os.WriteFile(macosprocess.InstallRoot+"/native-child-complete", []byte("all original child owners joined\n"), 0600); e != nil {
		t.Fatal(e)
	}
}

// The handshake diagnostic observes host networking but never prepares a PF
// baseline, native Box, socket guardian or utun. It uses the installed signed
// images and exactly the same inherited capture/Stop protocol as the full gate.
type darwinChildHandshakeNetwork struct {
	PFStatus string
	Rules, NAT, Anchors string
	Interfaces []string
}

func darwinChildHandshakeSnapshot(ctx context.Context) (darwinChildHandshakeNetwork, error) {
	var result darwinChildHandshakeNetwork
	info, err := darwinChildCommand(ctx, "/sbin/pfctl", "-s", "info")
	if err != nil { return result, errors.New("preflight could not read original PF status") }
	for _, line := range strings.Split(string(info), "\n") {
		fields := strings.Fields(line)
		if len(fields) >= 2 && fields[0] == "Status:" { result.PFStatus = fields[1] }
	}
	if result.PFStatus != "Enabled" && result.PFStatus != "Disabled" {
		return result, errors.New("preflight PF status is ambiguous")
	}
	rules, err := darwinChildCommand(ctx, "/sbin/pfctl", "-a", "*", "-sr")
	if err != nil { return result, errors.New("preflight could not read original PF rules") }
	nat, err := darwinChildCommand(ctx, "/sbin/pfctl", "-a", "*", "-sn")
	if err != nil { return result, errors.New("preflight could not read original PF NAT") }
	anchors, err := darwinChildCommand(ctx, "/sbin/pfctl", "-s", "Anchors")
	if err != nil { return result, errors.New("preflight could not read original PF anchors") }
	result.Rules, result.NAT, result.Anchors = darwinChildDigest(rules), darwinChildDigest(nat), darwinChildDigest(anchors)
	interfaces, err := net.Interfaces()
	if err != nil { return result, err }
	for _, iface := range interfaces {
		if !strings.HasPrefix(iface.Name, "utun") { continue }
		addresses, err := iface.Addrs()
		if err != nil { return result, err }
		parts := make([]string, 0, len(addresses))
		for _, address := range addresses { parts = append(parts, address.String()) }
		sort.Strings(parts)
		result.Interfaces = append(result.Interfaces, fmt.Sprintf("%d/%s/%d/%d/%s", iface.Index, iface.Name, iface.MTU, iface.Flags, strings.Join(parts, ",")))
	}
	sort.Strings(result.Interfaces)
	return result, ctx.Err()
}

func darwinChildHandshakeUnchanged(ctx context.Context, before darwinChildHandshakeNetwork) error {
	after, err := darwinChildHandshakeSnapshot(ctx)
	if err != nil || !reflect.DeepEqual(before, after) {
		return errors.Join(err, errors.New("preflight changed original PF or utun state"))
	}
	return nil
}

// This is a separate installed-controller root. In particular it cannot call
// darwinChildOwner.start, which intentionally installs a baseline for the full
// native acceptance fixture.
func TestRouterVPNNodeChainDarwinNativeHandshake(t *testing.T) {
	darwinChildNative(t)
	if os.Getenv("ROUTERVPN_DARWIN_NODE_CHILD_INSTALLED") != "1" {
		t.Fatal("preflight requires its actual installed signed controller")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()
	before, err := darwinChildHandshakeSnapshot(ctx)
	if err != nil { t.Fatal(err) }
	authority := darwinChildAuthorityStart(t)
	policy := desktopNodeChainCommandPolicyWithIdentity(t, 3, "darwin", 1400, true)
	meta := policy.Metadata()
	directory, err := os.MkdirTemp(macosprocess.InstallRoot+"/run/native-node", "session-")
	if err != nil { t.Fatal(err) }
	if err := os.Chmod(directory, 0700); err != nil { t.Fatal(err) }
	// Preserve the valid config and its captured hash. Only the bounded source
	// is invalid, and it is staged BEFORE OpenCapture pins the original inode.
	for name, body := range map[string]string{
		"node-chain-source.json": "{\"schema\":0}\n",
		"sing-box.json": policy.Config(),
	} {
		if err := os.WriteFile(filepath.Join(directory, name), []byte(body), 0600); err != nil { t.Fatal(err) }
	}
	files, err := routerVPNOpenExternalFiles(directory)
	if err != nil { t.Fatal(err) }
	workspace, err := os.OpenFile(directory, os.O_RDONLY|syscall.O_NOFOLLOW, 0)
	if err != nil { t.Fatal(err) }
	scope := macosprocess.Scope{Family: macosprocess.NodeChainFamily, Workspace: directory, Session: meta.SessionID, Source: meta.SourceSHA256, Config: meta.ConfigSHA256}
	capture, err := macosprocess.OpenCapture(ctx, scope, workspace, authority.install, authority.process, authority.lifetime)
	workspace.Close()
	if err != nil { t.Fatal("preflight original input capture", err) }
	channel, inherited, err := mobiletor.NewDesktopDarwinControlPair()
	if err != nil { t.Fatal(err) }
	command := exec.Command(macosprocess.EnginePath, "routervpn-node-chain", "--runtime-dir", directory, "--session", scope.Session,
		"--physical-source-sha256", scope.Source, "--config-sha256", scope.Config, "--darwin-control", "inherited-v1")
	command.Dir = directory
	command.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL=C", "GORACE=atexit_sleep_ms=0"}
	command.ExtraFiles = append([]*os.File{inherited}, capture.Files()...)
	var output darwinChildOutput
	darwinChildEngineOutput(command, &output)
	if err := command.Start(); err != nil { inherited.Close(); t.Fatal(err) }
	inherited.Close()
	done := make(chan struct{})
	var waitErr error
	go func() { waitErr = command.Wait(); close(done) }()
	var bootstrap *macosprocess.Bootstrap
	joined, stopped, bound := false, false, false
	t.Cleanup(func() {
		if joined { return }
		// Retire only this original child. Before completed binding, closing
		// its owned channel revokes that handshake; it is not a native receipt.
		// After binding, only authenticated Stop may acknowledge retirement.
		cleanup, stopCleanup := context.WithTimeout(context.Background(), 15*time.Second)
		defer stopCleanup()
		if !bound {
			if err := channel.Close(); err != nil { t.Error("preflight original channel", err) }
		} else if !stopped {
			if err := bootstrap.Stop(cleanup); err != nil { t.Error("preflight original cleanup", err); return }
			stopped = true
		}
		select {
		case <-done:
			if waitErr != nil { t.Error("preflight original waiter", waitErr) }
		case <-cleanup.Done():
			t.Error("preflight original child did not join")
		}
	})
	binding, stopBinding := context.WithTimeout(ctx, 15*time.Second)
	bootstrap, err = macosprocess.BindCreated(binding, capture, channel, command)
	stopBinding()
	if err != nil { t.Fatal("preflight authenticated original handshake", err, output.String()) }
	bound = true
	checkStopped := func() error {
		raw, err := files.read("stopped.json", 4096)
		var receipt struct { routerVPNExternalStop; Closed bool `json:"closed"` }
		if err != nil || !routerVPNMTUStrict(raw, &receipt) || receipt.Schema != 1 || receipt.Session != scope.Session ||
			receipt.SourceSHA256 != scope.Config || !receipt.Closed {
			return errors.Join(err, errors.New("preflight lacks original stopped receipt"))
		}
		for _, name := range []string{"node-ready.json", "node-chain-ready.json", "node-mtu-status.json"} {
			if _, err := files.root.Lstat(name); !errors.Is(err, os.ErrNotExist) {
				return errors.New("preflight source refusal published native readiness")
			}
		}
		return nil
	}
	refusal, stopRefusal := context.WithTimeout(ctx, 15*time.Second)
	for {
		if checkStopped() == nil { break }
		select {
		case <-done:
			stopRefusal(); t.Fatal("preflight child exited before authenticated Stop", waitErr, output.String())
		case <-refusal.Done():
			stopRefusal(); t.Fatal("preflight source did not retire before Stop", refusal.Err(), output.String())
		case <-time.After(20*time.Millisecond):
		}
	}
	stopRefusal()
	if err := bootstrap.Current(ctx); err != nil { t.Fatal("preflight lost live original child before Stop", err) }
	if err := darwinChildHandshakeUnchanged(ctx, before); err != nil { t.Fatal(err) }
	fmt.Println("verified original Darwin handshake preflight: source-refused")
	stopping, stopStopping := context.WithTimeout(ctx, 15*time.Second)
	if err := bootstrap.Stop(stopping); err != nil { stopStopping(); t.Fatal("preflight original authenticated Stop", err) }
	stopped = true
	fmt.Println("verified original Darwin handshake preflight: authenticated-stop")
	select {
	case <-done:
		if waitErr != nil { stopStopping(); t.Fatal("preflight original child waiter failed", waitErr, output.String()) }
	case <-stopping.Done():
		stopStopping(); t.Fatal("preflight original child waiter did not join", stopping.Err())
	}
	stopStopping()
	joined = true
	if err := checkStopped(); err != nil { t.Fatal(err) }
	if err := capture.Current(ctx); err != nil { t.Fatal(err) }
	if err := darwinChildHandshakeUnchanged(ctx, before); err != nil { t.Fatal(err) }
	if err := errors.Join(bootstrap.Close(), channel.Close(), capture.Close(), files.root.Close()); err != nil { t.Fatal(err) }
	if err := authority.close(); err != nil { t.Fatal(err) }
	if err := os.WriteFile(macosprocess.InstallRoot+"/native-handshake-complete",
		[]byte("original preflight child joined without native preparation\n"), 0600); err != nil { t.Fatal(err) }
	fmt.Println("verified original Darwin handshake preflight: original-join")
}
