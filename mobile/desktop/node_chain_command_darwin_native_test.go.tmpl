func darwinChildTrust(t *testing.T, p *darwinChildPeer, joined func() bool) {
	t.Helper()
	block, rest := pem.Decode([]byte(p.reply.PublicCA))
	if block == nil || block.Type != "CERTIFICATE" || len(rest) != 0 {
		t.Fatal("native peer lacks complete root")
	}
	cert, e := x509.ParseCertificate(block.Bytes)
	if e != nil || !cert.IsCA {
		t.Fatal("native peer root invalid", e)
	}
	fingerprint := strings.ToUpper(darwinChildDigest(block.Bytes))
	file := macosprocess.InstallRoot + "/peer-root.pem"
	if e := os.WriteFile(file, []byte(p.reply.PublicCA), 0600); e != nil {
		t.Fatal(e)
	}
	call := func(args ...string) ([]byte, error) {
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		return darwinChildCommand(ctx, "/usr/bin/security", args...)
	}
	before, e := call("find-certificate", "-a", "-Z", "/Library/Keychains/System.keychain")
	if e != nil || len(before) > 1<<20 || bytes.Contains(before, []byte(fingerprint)) {
		t.Fatal("native trust preimage unavailable", e)
	}
	trust := func() ([]byte, error) {
		raw, e := call("dump-trust-settings", "-d")
		var exit *exec.ExitError
		if errors.As(e, &exit) && exit.ExitCode() == 1 && bytes.Contains(raw, []byte("No Trust Settings were found")) {
			e = nil
		}
		if len(raw) > 1<<20 {
			return nil, errors.New("unbounded native trust inventory")
		}
		return raw, e
	}
	beforeTrust, e := trust()
	if e != nil {
		t.Fatal(e)
	}
	t.Cleanup(func() {
		if !joined() {
			t.Error("native trust remains retained until original child joins")
			return
		}
		captured, e := os.ReadFile(file)
		if e != nil || string(captured) != p.reply.PublicCA {
			t.Error("native certificate file replaced")
			return
		}
		_, _ = call("remove-trusted-cert", "-d", file)
		current, e := call("find-certificate", "-a", "-Z", "/Library/Keychains/System.keychain")
		if e != nil {
			t.Error(e)
			return
		}
		if bytes.Contains(current, []byte(fingerprint)) {
			_, _ = call("delete-certificate", "-Z", fingerprint, "/Library/Keychains/System.keychain")
		}
		after, e := call("find-certificate", "-a", "-Z", "/Library/Keychains/System.keychain")
		afterTrust, e2 := trust()
		if e != nil || e2 != nil || !bytes.Equal(before, after) || !bytes.Equal(beforeTrust, afterTrust) {
			t.Error("native trust did not restore original inventories", e, e2)
		}
		os.Remove(file)
	})
	if raw, e := call("add-trusted-cert", "-d", "-r", "trustRoot", "-k", "/Library/Keychains/System.keychain", file); e != nil {
		t.Fatal("native system peer root could not be installed", e, string(raw))
	}
}

type darwinChildOutput struct {
	mu sync.Mutex
	b  bytes.Buffer
}

func (o *darwinChildOutput) Write(raw []byte) (int, error) {
	o.mu.Lock()
	defer o.mu.Unlock()
	if o.b.Len() < 32768 {
		remaining := 32768 - o.b.Len()
		o.b.Write(raw[:min(len(raw), remaining)])
	}
	return len(raw), nil
}
func (o *darwinChildOutput) String() string { o.mu.Lock(); defer o.mu.Unlock(); return o.b.String() }

type darwinChildOwner struct {
	command   *exec.Cmd
	done      chan struct{}
	failure   error
	capture   *macosprocess.Capture
	bootstrap *macosprocess.Bootstrap
	channel   *mobiletor.DesktopDarwinControl
	files     *routerVPNExternalFiles
	policy    *mobilemultihop.DesktopNodeChainPolicy
	transfer  string
	baseline  *mobiletor.DesktopDarwinPFBaselineResult
	output    darwinChildOutput
	observed  map[int]string
	closed    bool
	stopped   bool
	// Set before exec.Start and never reset. Even a failed start attempt keeps
	// authenticated native Stop mandatory; nil bootstrap is not absence proof.
	childStartAttempted bool
}

func darwinChildBaseline(ctx context.Context, r mobiletor.DesktopDarwinPFBaselineRequest, apply bool) (mobiletor.DesktopDarwinPFBaselineResult, error) {
	var result mobiletor.DesktopDarwinPFBaselineResult
	raw, e := mobiletor.EncodeDesktopDarwinPFBaselineRequest(r)
	if e != nil {
		return result, e
	}
	body, e := mobiletor.RunDesktopDarwinPFBaseline(ctx, raw, apply)
	if e != nil {
		return result, e
	}
	if !routerVPNMTUStrict(body, &result) || result.Schema != 1 || result.RequestSHA256 != darwinChildDigest(raw) || result.Applied != apply {
		return result, errors.New("native PF baseline response changed original request")
	}
	return result, nil
}

func (o *darwinChildOwner) installBaseline(ctx context.Context) error {
	meta := o.policy.Metadata()
	request := mobiletor.DesktopDarwinPFBaselineRequest{Schema: 1, Action: "replace", SessionID: meta.SessionID, SourceSHA256: meta.SourceSHA256, Expected: []mobiletor.DesktopDarwinPFBaselineProof{{}}}
	plan, e := darwinChildBaseline(ctx, request, false)
	if e != nil || plan.Previous.Present || !plan.Target.Present {
		return errors.Join(e, errors.New("actual baseline plan lost absent original"))
	}
	// The native transaction can commit and then fail readback. Retain the
	// independently validated plan before apply, including on that failure.
	o.baseline = &plan
	receipt, e := darwinChildBaseline(ctx, request, true)
	if e != nil || receipt.Previous != plan.Previous || receipt.Target != plan.Target {
		return errors.Join(e, errors.New("actual baseline did not match original plan"))
	}
	o.baseline = &receipt
	return nil
}

// Only a failing fixture that never attempted to start its native child may
// retire a planned baseline without a child receipt. The existing PF utility
// still requires the exact previous/target rules and absence of child owners.
func (o *darwinChildOwner) stopUnstarted(ctx context.Context, failed bool) error {
	if o == nil || !failed || ctx == nil || ctx.Err() != nil || o.childStartAttempted ||
		o.command != nil && o.command.Process != nil || o.bootstrap != nil || o.done != nil || len(o.observed) != 0 {
		return errors.New("native pre-start cleanup has no proof of an unstarted failed fixture")
	}
	if o.closed {
		return nil
	}
	if o.capture == nil {
		if o.baseline != nil || o.channel != nil {
			return errors.New("native pre-start cleanup lost its original process capture")
		}
	} else if e := o.capture.Current(ctx); e != nil {
		return e
	}
	if o.baseline != nil {
		plan := o.baseline
		if plan.Schema != 1 || plan.Previous.Present || !plan.Target.Present {
			return errors.New("native pre-start cleanup lost its original baseline plan")
		}
		request := mobiletor.DesktopDarwinPFBaselineRequest{Schema: 1, Action: "clear", Expected: []mobiletor.DesktopDarwinPFBaselineProof{plan.Previous, plan.Target}}
		retired, e := darwinChildBaseline(ctx, request, true)
		if e != nil || retired.Previous != plan.Previous && retired.Previous != plan.Target || retired.Target.Present {
			return errors.Join(e, errors.New("native pre-start cleanup did not retire its exact baseline"))
		}
	}
	if o.capture != nil {
		if e := o.capture.Current(ctx); e != nil {
			return e
		}
	}
	var joined error
	if o.channel != nil {
		joined = errors.Join(joined, o.channel.Close())
	}
	if o.capture != nil {
		joined = errors.Join(joined, o.capture.Close())
	}
	if o.files != nil {
		joined = errors.Join(joined, o.files.root.Close())
	}
	if joined != nil || ctx.Err() != nil {
		return errors.Join(joined, ctx.Err())
	}
	o.closed = true
	return nil
}

