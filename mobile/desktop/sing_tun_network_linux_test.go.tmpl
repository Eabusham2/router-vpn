		{"broadcast", func(o *routerVPNLinuxRouteOwner) { o.addresses[0].broadcast = "fd29:94::2" }},
		{"preferred-lifetime", func(o *routerVPNLinuxRouteOwner) { o.addresses[0].preferred-- }},
		{"valid-lifetime", func(o *routerVPNLinuxRouteOwner) { o.addresses[0].valid-- }},
	} {
		t.Run(tc.name, func(t *testing.T) {
			now := clone(after)
			tc.change(&now)
			if routervpnLinuxRouteAdditions(before, now, nil, []DesktopNetworkObject{explicit, local}) {
				t.Fatal("changed address or original interface acquired route ownership")
			}
		})
	}
	// Even identical later snapshots cannot turn a newly selected but absent
	// configured address or an unqualified automatic address into authority.
	for _, name := range []string{"unconfigured", "duplicate-address", "new-tentative", "not-permanent"} {
		t.Run(name, func(t *testing.T) {
			old, now := clone(after), clone(after)
			switch name {
			case "unconfigured":
				old.configured[0], now.configured[0] = netip.MustParsePrefix("fd29:94::2/126"), netip.MustParsePrefix("fd29:94::2/126")
			case "duplicate-address":
				old.addresses, now.addresses = append(old.addresses, old.addresses[0]), append(now.addresses, now.addresses[0])
			case "new-tentative":
				now.addresses[0].flags |= syscall.IFA_F_TENTATIVE
			case "not-permanent":
				old.addresses[0].flags, now.addresses[0].flags = 0, 0
			}
			if routervpnLinuxRouteAdditions(old, now, nil, []DesktopNetworkObject{explicit, local}) {
				t.Fatal("unproved owner state acquired its LOCAL route")
			}
		})
	}
}

func nativeRoutingConcurrentAddressNamespace(t *testing.T) {
	nativeRoutingConcurrentAddressNamespaceMode(t, false)
}

func nativeRoutingConcurrentAddressNamespaceMode(t *testing.T, automatic bool) {
	t.Helper()
	const name, peer = "rvpn-local", "rvpn-local-p"
	v := &netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: name}, PeerName: peer}
	if err := netlink.LinkAdd(v); err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := netlink.LinkDel(v); err != nil {
			t.Error(err)
		}
	}()
	link, err := netlink.LinkByName(name)
	if err != nil {
		t.Fatal(err)
	}
	other, err := netlink.LinkByName(peer)
	if err != nil {
		t.Fatal(err)
	}
	if automatic {
		// These are newly created interfaces in the proved private namespace.
		// Kernel random address generation supplies its actual stable-privacy
		// flag. The independent peer has no asynchronous IPv6 address to add
		// an unrelated route during the owned interface's before/after proof.
		for _, pair := range [][2]string{{name, "random"}, {peer, "none"}} {
			if output, err := exec.Command("ip", "link", "set", "dev", pair[0], "addrgenmode", pair[1]).CombinedOutput(); err != nil {
				t.Fatal("owned native address generation", err, string(output))
			}
		}
	} else {
		if err := netlink.LinkSetUp(other); err != nil {
			t.Fatal(err)
		}
		if err := netlink.LinkSetUp(link); err != nil {
			t.Fatal(err)
		}
		waitNativeRoutingVeths(t, link, other, netip.Prefix{})
	}
	prefix := netip.MustParsePrefix("fd29:94::1/126")
	n := &NativeTun{routervpnOwnedIndex: link.Attrs().Index, options: Options{Name: name, MTU: 1376,
		Inet4Address: []netip.Prefix{netip.MustParsePrefix("172.29.94.1/30")}, Inet6Address: []netip.Prefix{prefix},
		AutoRoute: true, StrictRoute: true, IPRoute2TableIndex: 2022, IPRoute2RuleIndex: 9000,
		Inet4RouteAddress: []netip.Prefix{netip.MustParsePrefix("0.0.0.0/0")}, Inet6RouteAddress: []netip.Prefix{netip.MustParsePrefix("::/0")}}}
	nativeRoutingConfigureVeth(t, n, link)
	if automatic {
		if err := netlink.LinkSetUp(other); err != nil {
			t.Fatal(err)
		}
		if err := netlink.LinkSetUp(link); err != nil {
			t.Fatal(err)
		}
		// Link activation queues addrconf work. Capture the real tentative
		// automatic address after its creation, before waiting for DAD and
		// its LOCAL route; an immediate dump can precede address creation.
		deadline := time.Now().Add(time.Second)
		for {
			owner, err := n.routervpnLinuxRouteOwner()
			if err != nil {
				t.Fatal("read original automatic address", err)
			}
			pending := false
			for _, address := range owner.addresses {
				pending = pending || address.prefix.Addr().IsLinkLocalUnicast() && address.prefix.Bits() == 64 && address.flags == syscall.IFA_F_PERMANENT|syscall.IFA_F_TENTATIVE|0x800
			}
			if pending {
				break
			}
			if !time.Now().Before(deadline) {
				t.Fatal("kernel did not publish its original tentative automatic address")
			}
			time.Sleep(time.Millisecond)
		}
	}
	before := n.routervpnLinuxBefore("route")
	if n.routervpnNetwork.failure != nil {
		t.Fatal(n.routervpnNetwork.failure)
	}
	var pending bool
	for _, address := range before.owner.addresses {
		if automatic {
			if address.prefix.Addr().IsLinkLocalUnicast() && address.prefix.Bits() == 64 && address.flags == syscall.IFA_F_PERMANENT|syscall.IFA_F_TENTATIVE|0x800 {
				prefix, pending = address.prefix, true
			}
		} else {
			pending = pending || address.prefix == prefix && address.flags&syscall.IFA_F_TENTATIVE != 0
		}
	}
	if !pending {
		t.Fatalf("native concurrent fixture did not capture original tentative address: automatic=%v addresses=%+v", automatic, before.owner.addresses)
	}
	if automatic {
		waitNativeRoutingVeths(t, link, nil, n.options.Inet6Address[0])
	} else {
		waitNativeRoutingVeths(t, link, other, prefix)
	}
	routes, err := n.routes(link)
	if err != nil || len(routes) != 2 {
		t.Fatal("native fixture lost its actual pinned route builder", err, len(routes))
	}
	// Execute the same exact before/RouteAdd/after methods as setRoute. The
	// bounded fixture readback above deterministically schedules the kernel's
	// actual address publication in this interval; no route is fabricated.
	if err := netlink.RouteAdd(&routes[0]); err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := netlink.RouteDel(&routes[0]); err != nil {
			t.Error(err)
		}
	}()
	n.routervpnLinuxAdded("route", before)
	maximum := 2
	if automatic {
		maximum = 3 // Explicit route plus the configured and automatic LOCAL routes.
	}
	if n.routervpnNetwork.failure != nil || len(n.routervpnNetwork.objects) < 2 || len(n.routervpnNetwork.objects) > maximum {
		t.Fatal("real kernel LOCAL race lost its complete original ledger", n.routervpnNetwork.failure, len(n.routervpnNetwork.objects))
	}
	foundLocal := false
	for _, object := range n.routervpnNetwork.objects {
		foundLocal = foundLocal || object.Family == 6 && object.Table == 255 && object.Destination == netip.PrefixFrom(prefix.Addr(), 128).String()
	}
	if !foundLocal {
		t.Fatal("actual native receipt omitted its original pending address's LOCAL route")
	}
	raw, err := n.routervpnObserveNetworkReceipt()
	if err != nil {
		t.Fatal("actual concurrent routing receipt", err)
	}
	receipt, err := ParseDesktopNetworkReceipt(raw)
	if err != nil {
		t.Fatal(err)
	}
	for _, object := range n.routervpnNetwork.objects {
		if !routervpnNetworkHasObject(receipt.Objects, object) {
			t.Fatal("native receipt omitted exact recorded concurrent bytes")
		}
	}
	// Later removal of the recorded kernel host route is not a valid receipt,
	// even though its configured address and the explicit route still exist.
	locals, err := netlink.RouteListFiltered(netlink.FAMILY_V6, &netlink.Route{LinkIndex: link.Attrs().Index, Table: 255, Dst: &net.IPNet{IP: prefix.Addr().AsSlice(), Mask: net.CIDRMask(128, 128)}}, netlink.RT_FILTER_OIF|netlink.RT_FILTER_TABLE|netlink.RT_FILTER_DST)
	if err != nil || len(locals) != 1 {
		t.Fatal("actual recorded address host route disappeared before negative", err, len(locals))
	}
	retained := make(map[string]DesktopNetworkObject)
	for key, object := range n.routervpnNetwork.objects {
		retained[key] = object
	}
	beforeRemoval := n.routervpnLinuxBefore("route")
	if n.routervpnNetwork.failure != nil {
		t.Fatal(n.routervpnNetwork.failure)
	}
	if err := netlink.RouteDel(&locals[0]); err != nil {
		t.Fatal(err)
	}
	if _, err := n.routervpnObserveNetworkReceipt(); err == nil {
		t.Fatal("removed recorded kernel route remained accepted")
	}
	if err := netlink.RouteAdd(&routes[1]); err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := netlink.RouteDel(&routes[1]); err != nil {
			t.Error(err)
		}
	}()
	n.routervpnLinuxAdded("route", beforeRemoval)
	if n.routervpnNetwork.failure == nil || !strings.Contains(n.routervpnNetwork.failure.Error(), "inventory changed during its own add") || len(n.routervpnNetwork.objects) != len(retained) {
		t.Fatal("a new explicit add hid removal of the earlier exact address route", n.routervpnNetwork.failure)
	}
	for key, object := range retained {
		if n.routervpnNetwork.objects[key] != object {
			t.Fatal("rejected removal changed the retained exact ledger")
		}
	}
}

func TestRouterVPNNativeLinuxRoutingConcurrentAddressAtomicLedger(t *testing.T) {
	_, _, explicit, local := nativeRoutingConcurrentFixture(t)
	t.Run("complete-batch", func(t *testing.T) {
		n := &NativeTun{}
		n.routervpnLinuxRecordAdditions([]DesktopNetworkObject{explicit, local})
		if n.routervpnNetwork.failure != nil || len(n.routervpnNetwork.objects) != 2 || n.routervpnNetwork.objects[explicit.Key()] != explicit || n.routervpnNetwork.objects[local.Key()] != local {
			t.Fatal("complete concurrent batch did not retain every exact object")
		}
	})
	for _, duplicate := range []bool{false, true} {
		name := "previous-ledger-object"
		if duplicate {
			name = "duplicate-in-batch"
		}
		t.Run(name, func(t *testing.T) {
			n := &NativeTun{routervpnNetwork: routerVPNNativeNetworkLedger{objects: map[string]DesktopNetworkObject{local.Key(): local}}}
			added := []DesktopNetworkObject{explicit, local}
			if duplicate {
				n.routervpnNetwork.objects = nil
				added = []DesktopNetworkObject{explicit, explicit}
			}
			count := len(n.routervpnNetwork.objects)
			n.routervpnLinuxRecordAdditions(added)
			if n.routervpnNetwork.failure == nil || len(n.routervpnNetwork.objects) != count {
				t.Fatal("rejected duplicate partially changed the exact ledger")
			}
		})
	}
	t.Run("sticky-first-failure", func(t *testing.T) {
		first := errors.New("original first failure")
		n := &NativeTun{routervpnNetwork: routerVPNNativeNetworkLedger{failure: first}}
		n.routervpnLinuxRecordAdditions([]DesktopNetworkObject{explicit, local})
		if n.routervpnNetwork.failure != first || len(n.routervpnNetwork.objects) != 0 {
			t.Fatal("later additions replaced a sticky first failure")
		}
	})
}

// Actual read-only kernel inventory. No TUN owner or routing receipt is
// manufactured from this fixture index; it exercises only the bounded reader.
func TestRouterVPNNativeLinuxRoutingBoundedInventory(t *testing.T) {
	current, err := net.InterfaceByName("lo")
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	original := &NativeTun{options: Options{Name: current.Name, RouterVPNNetworkContext: ctx}, routervpnOwnedIndex: current.Index}
	captured, err := original.routervpnLinuxInterface()
	if err != nil || captured.Name != current.Name || captured.Index != current.Index || captured.MTU != current.MTU || captured.Flags != current.Flags {
		t.Fatal("bounded original link dump differs from actual interface", captured, current, err)
	}
	addresses, err := original.routervpnLinuxAddresses(current.Index)
	if err != nil {
		t.Fatal(err)
	}
	expected, err := current.Addrs()
	if err != nil {
		t.Fatal(err)
	}
	wanted := map[string]bool{}
	for _, address := range expected {
		wanted[address.String()] = true
	}
	for _, address := range addresses {
		if address.LinkIndex != current.Index || address.IPNet == nil || !wanted[address.IPNet.String()] {
			t.Fatal("bounded original address dump changed native identity", address)
		}
		delete(wanted, address.IPNet.String())
	}
	if len(wanted) != 0 {
		t.Fatal("bounded address dump omitted native addresses", wanted)
	}
	original.options.Name = "foreign-original-name"
	if _, err := original.routervpnLinuxInterface(); err == nil {
		t.Fatal("bounded link dump adopted a foreign name")
	}
	original.options.Name = current.Name
	cancel()
	if _, err := original.routervpnLinuxInterface(); err == nil {
		t.Fatal("cancelled startup performed a fresh link dump")
	}
	if _, err := original.routervpnLinuxAddresses(current.Index); err == nil {
		t.Fatal("cancelled startup performed a fresh address dump")
	}
	// The completed constructor must stay canceled. A later caller reads the
	// same original index through its own existing deadline without mutating
	// the construction context or accepting a stale snapshot.
	later, finish := context.WithTimeout(context.Background(), time.Second)
	defer finish()
	if value, _, err := original.routervpnNetworkInterfaceContext(later); err != nil || value.Index != current.Index {
		t.Fatal("later link read reused completed construction", err)
	}
	if _, err := original.routervpnNetworkAddressesContext(later, current); err != nil {
		t.Fatal("later address read reused completed construction", err)
	}
	if _, err := original.routervpnNetworkObjectsContext(later, DesktopNetworkReceipt{Index: ^uint32(0)}); err != nil {
		t.Fatal("later route/rule read reused completed construction", err)
	}
	if original.options.RouterVPNNetworkContext != ctx || ctx.Err() == nil {
		t.Fatal("later read changed or renewed construction authority")
	}
}

func TestRouterVPNNativeLinuxRoutingInventoryFraming(t *testing.T) {
	good := []byte{8, 0, 3, 0, 't', 'u', 'n', 0}
	attrs, err := routervpnLinuxAttributes(good)
	if err != nil || string(attrs[3]) != "tun\x00" {
		t.Fatal("complete native attribute rejected", err)
	}
	for _, bad := range [][]byte{append(append([]byte{}, good...), 0), good[:7], append(append([]byte{}, good...), good...), {3, 0, 3, 0}, {5, 0, 3, 0, 'x', 0, 1, 0}} {
		if _, err := routervpnLinuxAttributes(bad); err == nil {
			t.Fatal("malformed, repeated or unframed native attribute accepted", bad)
		}
	}
}
