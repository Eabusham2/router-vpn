func TestRouterVPNNativeLinuxRoutingFirstFailureDiagnostics(t *testing.T) {
	private := "private-node-address-and-key"
	added := []DesktopNetworkObject{{Kind: "route", Family: 6, Index: 8, Table: 254, Priority: 256, Destination: "fe80::/64", Gateway: private, Native: private}}
	removed := []DesktopNetworkObject{{Kind: "rule", Family: 4, Table: 252, Priority: 9001, Destination: private, Native: private}}
	var output bytes.Buffer
	routervpnLinuxMTUDiagnostic(&output, "route", 8, added, removed)
	want := "NODE-MTU-DIAGNOSTIC delta kind=route index=8 added=1 removed=1\n" +
		"NODE-MTU-DIAGNOSTIC added kind=route family=6 index=8 table=254 priority=256 flags=0 destination=linklocal6\n" +
		"NODE-MTU-DIAGNOSTIC removed kind=rule family=4 index=0 table=252 priority=9001 flags=0 destination=other\n"
	if output.String() != want || strings.Contains(output.String(), private) {
		t.Fatal("first native delta disclosed private fields or changed its classifications", output.String())
	}
	output.Reset()
	foreign := added[0]
	foreign.Kind, foreign.Destination = private, private
	routervpnLinuxMTUDiagnostic(&output, private, 8, []DesktopNetworkObject{foreign}, nil)
	if strings.Contains(output.String(), private) || !strings.Contains(output.String(), "kind=other") {
		t.Fatal("unknown native diagnostic field escaped its fixed vocabulary")
	}
	output.Reset()
	many := append([]DesktopNetworkObject(nil), added...)
	for len(many) < 16 {
		many = append(many, added[0])
	}
	routervpnLinuxMTUDiagnostic(&output, "route", 8, many[:3], many)
	if len(strings.Split(strings.TrimSuffix(output.String(), "\n"), "\n")) != 9 {
		t.Fatal("native first delta exceeded its total eight-object diagnostic bound")
	}

	// The same actual ledger operation retains its first error and emits no
	// second cause. This test does not replace a native inventory or TUN.
	reader, writer, err := os.Pipe()
	if err != nil {
		t.Fatal(err)
	}
	defer reader.Close()
	original := os.Stderr
	os.Stderr = writer
	defer func() { os.Stderr = original; _ = writer.Close() }()
	native := &NativeTun{routervpnOwnedIndex: 8}
	first := errors.New("native Linux routing call has no unique owned addition")
	native.routervpnLinuxAdditionFailure("route", first, added, removed)
	native.routervpnLinuxAdditionFailure("rule", errors.New(private), nil, nil)
	if err := writer.Close(); err != nil {
		t.Fatal(err)
	}
	raw, err := io.ReadAll(reader)
	if err != nil || string(raw) != want || native.routervpnNetwork.failure != first || len(native.routervpnNetwork.objects) != 0 {
		t.Fatal("diagnostics changed the original sticky failure or ledger", err)
	}
}

func nativeRoutingRule(t *testing.T, family byte, priority, target, flags uint32, action byte) DesktopNetworkObject {
	t.Helper()
	body := []byte{family, 0, 0, 0, 0, 0, 0, action, 0, 0, 0, 0}
	binary.LittleEndian.PutUint32(body[8:], flags)
	for _, a := range []struct {
		id    uint16
		value uint32
	}{{6, priority}, {15, 0}, {14, ^uint32(0)}} {
		v := make([]byte, 8)
		binary.LittleEndian.PutUint16(v, 8)
		binary.LittleEndian.PutUint16(v[2:], a.id)
		binary.LittleEndian.PutUint32(v[4:], a.value)
		body = append(body, v...)
	}
	if target != 0 {
		v := make([]byte, 8)
		binary.LittleEndian.PutUint16(v, 8)
		binary.LittleEndian.PutUint16(v[2:], 4)
		binary.LittleEndian.PutUint32(v[4:], target)
		body = append(body, v...)
	}
	o, err := ParseDesktopLinuxNetworkObject("rule", body)
	if err != nil {
		t.Fatal(err)
	}
	return o
}

func TestRouterVPNNativeLinuxRoutingResolutionRejectsForeign(t *testing.T) {
	before := nativeRoutingRule(t, 2, 9001, 9010, 4, 2)
	after := nativeRoutingRule(t, 2, 9001, 9010, 0, 2)
	target := nativeRoutingRule(t, 2, 9010, 0, 0, 3)
	for _, tc := range []struct {
		name   string
		modify func(*NativeTun, *[]DesktopNetworkObject, *[]DesktopNetworkObject)
		valid  bool
	}{
		{"owned-complete", func(*NativeTun, *[]DesktopNetworkObject, *[]DesktopNetworkObject) {}, true},
		{"target-first-order", func(_ *NativeTun, _ *[]DesktopNetworkObject, a *[]DesktopNetworkObject) {
			(*a)[0], (*a)[1] = (*a)[1], (*a)[0]
		}, true},
		{"foreign-goto", func(n *NativeTun, _ *[]DesktopNetworkObject, _ *[]DesktopNetworkObject) {
			delete(n.routervpnNetwork.objects, before.Key())
		}, false},
		{"wrong-captured-byte", func(n *NativeTun, _ *[]DesktopNetworkObject, _ *[]DesktopNetworkObject) {
			n.routervpnNetwork.objects[before.Key()] = after
		}, false},
		{"wrong-target", func(_ *NativeTun, _ *[]DesktopNetworkObject, a *[]DesktopNetworkObject) {
			(*a)[1] = nativeRoutingRule(t, 2, 9011, 0, 0, 3)
		}, false},
		{"wrong-family", func(_ *NativeTun, _ *[]DesktopNetworkObject, a *[]DesktopNetworkObject) {
			(*a)[1] = nativeRoutingRule(t, 10, 9010, 0, 0, 3)
		}, false},
		{"wrong-action", func(_ *NativeTun, _ *[]DesktopNetworkObject, a *[]DesktopNetworkObject) {
			(*a)[1] = nativeRoutingRule(t, 2, 9010, 0, 0, 1)
		}, false},
		{"wrong-flags", func(_ *NativeTun, _ *[]DesktopNetworkObject, a *[]DesktopNetworkObject) {
			(*a)[0] = nativeRoutingRule(t, 2, 9001, 9010, 2, 2)
		}, false},
		{"extra-ambient-add", func(_ *NativeTun, _ *[]DesktopNetworkObject, a *[]DesktopNetworkObject) {
			*a = append(*a, nativeRoutingRule(t, 2, 9020, 0, 0, 1))
		}, false},
		{"duplicate-target", func(_ *NativeTun, _ *[]DesktopNetworkObject, a *[]DesktopNetworkObject) { (*a)[0] = target }, false},
		{"already-recorded-target", func(n *NativeTun, _ *[]DesktopNetworkObject, _ *[]DesktopNetworkObject) {
			n.routervpnNetwork.objects[target.Key()] = target
		}, false},
		{"sticky-failure", func(n *NativeTun, _ *[]DesktopNetworkObject, _ *[]DesktopNetworkObject) {
			n.routervpnNetwork.failure = fmt.Errorf("prior native witness lost")
		}, false},
	} {
		t.Run(tc.name, func(t *testing.T) {
			n := &NativeTun{}
			n.routervpnNetwork.objects = map[string]DesktopNetworkObject{before.Key(): before}
			r, a := []DesktopNetworkObject{before}, []DesktopNetworkObject{after, target}
			tc.modify(n, &r, &a)
			original := make(map[string]DesktopNetworkObject)
			for k, v := range n.routervpnNetwork.objects {
				original[k] = v
			}
			if actual := n.routervpnLinuxResolvedRules(r, a); actual != tc.valid {
				t.Fatal("native delta changed its original-owner admission", actual)
			}
			if tc.valid {
				if len(n.routervpnNetwork.objects) != 2 || n.routervpnNetwork.objects[after.Key()] != after || n.routervpnNetwork.objects[target.Key()] != target {
					t.Fatal("resolved receipt lost actual final native bytes")
				}
				if n.routervpnLinuxResolvedRules(r, a) {
					t.Fatal("same target resolution was replayed")
				}
			} else {
				if len(original) != len(n.routervpnNetwork.objects) {
					t.Fatal("rejected delta changed its original ledger")
				}
				for k, v := range original {
					if n.routervpnNetwork.objects[k] != v {
						t.Fatal("rejected delta changed retained bytes")
					}
				}
			}
		})
	}
}

func nativeRoutingVethReady(index int, configured netip.Prefix, addresses []netlink.Addr, routes []DesktopNetworkObject) (bool, error) {
	// A veth brings up automatic IPv6 policy asynchronously. It is fixture
	// setup, never an addition that the native TUN may claim as its own.
	type routeKey struct {
		table       uint32
		destination string
	}
	required := map[routeKey]bool{{254, "fe80::/64"}: true, {255, "ff00::/8"}: true}
	linkLocal, selected, pending := false, !configured.IsValid(), false
	for _, address := range addresses {
		if address.IPNet == nil || address.LinkIndex != index {
			return false, fmt.Errorf("veth IPv6 readback lost its original interface")
		}
		ip, ok := netip.AddrFromSlice(address.IP)
		bits, size := address.Mask.Size()
		if !ok || !ip.Is6() || ip.Is4In6() || size != 128 {
			return false, fmt.Errorf("veth IPv6 readback has an invalid address")
		}
		if address.Flags&syscall.IFA_F_DADFAILED != 0 {
			return false, fmt.Errorf("veth IPv6 duplicate-address detection failed")
		}
		pending = pending || address.Flags&syscall.IFA_F_TENTATIVE != 0
		prefix := netip.PrefixFrom(ip, bits)
		linkLocal = linkLocal || ip.IsLinkLocalUnicast()
		selected = selected || prefix == configured
		required[routeKey{254, prefix.Masked().String()}] = true
		required[routeKey{255, netip.PrefixFrom(ip, 128).String()}] = true
	}
	for _, route := range routes {
		if route.Kind == "route" && route.Family == 6 && route.Index == uint32(index) {
			delete(required, routeKey{route.Table, route.Destination})
		}
	}
	return linkLocal && selected && !pending && len(required) == 0, nil
}

func waitNativeRoutingVeths(t *testing.T, owned, peer netlink.Link, configured netip.Prefix) {
	t.Helper()
	// Stay inside the unchanged 15-second child deadline. Successful kernel
	// address/route readback, rather than elapsed time or equal snapshots,
	// establishes when the two fixture interfaces have finished starting.
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	ticker := time.NewTicker(10 * time.Millisecond)
	defer ticker.Stop()
	for {
		routes, err := routervpnLinuxNetworkObjects("route")
		if err != nil {
			t.Fatal("veth baseline routes", err)
		}
		ready := true
		for i, link := range []netlink.Link{owned, peer} {
			addresses, err := netlink.AddrList(link, netlink.FAMILY_V6)
			if err != nil {
				t.Fatal("veth baseline IPv6 addresses", err)
			}
			expected := configured
			if i != 0 {
				expected = netip.Prefix{}
			}
			current, err := nativeRoutingVethReady(link.Attrs().Index, expected, addresses, routes)
			if err != nil {
				t.Fatal(err)
			}
			ready = ready && current
		}
		if ready {
			return
		}
		select {
		case <-ctx.Done():
			t.Fatal("veth IPv6 DAD and baseline routes did not become ready", ctx.Err())
		case <-ticker.C:
		}
	}
}

func TestRouterVPNNativeLinuxRoutingVethReadiness(t *testing.T) {
	configured := netip.MustParsePrefix("fd29:94::1/126")
	address := func(value string) netlink.Addr {
		ip, prefix, err := net.ParseCIDR(value)
		if err != nil {
			t.Fatal(err)
		}
		prefix.IP = ip
		return netlink.Addr{IPNet: prefix, LinkIndex: 3}
	}
	addresses := []netlink.Addr{address("fe80::1/64"), address(configured.String())}
	var routes []DesktopNetworkObject
	for table, destinations := range map[uint32][]string{
		254: {"fe80::/64", "fd29:94::/126"},
		255: {"ff00::/8", "fe80::1/128", "fd29:94::1/128"},
	} {
		for _, destination := range destinations {
			routes = append(routes, DesktopNetworkObject{Kind: "route", Family: 6, Index: 3, Table: table, Destination: destination})
		}
	}
	if ready, err := nativeRoutingVethReady(3, configured, addresses, routes); !ready || err != nil {
		t.Fatal("complete owned baseline rejected", ready, err)
	}
	for i := range routes {
		incomplete := append(append([]DesktopNetworkObject{}, routes[:i]...), routes[i+1:]...)
		if ready, err := nativeRoutingVethReady(3, configured, addresses, incomplete); ready || err != nil {
			t.Fatal("missing automatic/address route became ready", routes[i], ready, err)
		}
	}
	for _, flags := range []int{syscall.IFA_F_TENTATIVE, syscall.IFA_F_DADFAILED} {
		for i := range addresses {
			changed := append([]netlink.Addr{}, addresses...)
			changed[i].Flags = flags
			if ready, err := nativeRoutingVethReady(3, configured, changed, routes); ready || (err != nil) != (flags == syscall.IFA_F_DADFAILED) {
				t.Fatal("IPv6 DAD was not required", i, flags, ready, err)
			}
		}
	}
	for _, changed := range [][]netlink.Addr{nil, addresses[:1], addresses[1:]} {
		if ready, err := nativeRoutingVethReady(3, configured, changed, routes); ready || err != nil {
			t.Fatal("missing selected/link-local IPv6 address became ready", ready, err)
		}
	}
	if ready, err := nativeRoutingVethReady(2, configured, addresses, routes); ready || err == nil {
		t.Fatal("foreign interface addresses became ready", ready, err)
	}
	foreign := append([]DesktopNetworkObject{}, routes...)
	for i := range foreign {
		foreign[i].Index = 2
	}
	if ready, err := nativeRoutingVethReady(3, configured, addresses, foreign); ready || err != nil {
		t.Fatal("peer routes satisfied the owned interface baseline", ready, err)
	}
}

// The constructor boundary is explicitly modeled by an owned veth. The real
// pinned configure/setRoute/setRules methods and receipt readback execute in a
// fresh user/network namespace; this does not substitute for the actual TUN
// constructor and protected source acceptance in the installed gate.
func TestRouterVPNNativeLinuxRoutingReceiptNamespace(t *testing.T) {
	const marker = "ROUTERVPN_NATIVE_ROUTING_RECEIPT_CHILD"
	if os.Getenv(marker) != "1" {
		image, err := os.Executable()
		if err != nil {
			t.Fatal(err)
		}
		network, err := os.Readlink("/proc/self/ns/net")
		if err != nil {
			t.Fatal(err)
		}
		user, err := os.Readlink("/proc/self/ns/user")
		if err != nil {
			t.Fatal(err)
		}
		netFile, err := os.Open("/proc/self/ns/net")
		if err != nil {
			t.Fatal(err)
		}
		defer netFile.Close()
		userFile, err := os.Open("/proc/self/ns/user")
		if err != nil {
			t.Fatal(err)
		}
		defer userFile.Close()
		ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
		defer cancel()
		cmd := exec.CommandContext(ctx, "/usr/bin/unshare", "--user", "--map-root-user", "--net", "--fork", image, "-test.v", "-test.run=^TestRouterVPNNativeLinuxRoutingReceiptNamespace$", "-test.timeout=15s")
		cmd.ExtraFiles = []*os.File{netFile, userFile}
		cmd.Env = []string{"PATH=/usr/sbin:/usr/bin:/sbin:/bin", marker + "=1", "ROUTERVPN_ROUTING_PARENT_NET=" + network, "ROUTERVPN_ROUTING_PARENT_USER=" + user}
		output, err := cmd.CombinedOutput()
		if err != nil {
			t.Fatal("isolated native routing receipt execution failed", err, string(output))
		}
		for _, leaf := range []string{"complete-native-install", "target-first-native-retirement", "concurrent-configured-ipv6-local-route"} {
			if !strings.Contains(string(output), "--- PASS: TestRouterVPNNativeLinuxRoutingReceiptNamespace/"+leaf+" ") {
				t.Fatal("native receipt case did not execute", leaf, string(output))
			}
		}
		t.Log(string(output))
		return
	}
	for i, kind := range []string{"net", "user"} {
		fd := uintptr(3 + i)
		file := os.NewFile(fd, "original-"+kind)
		if file == nil {
			t.Fatal("missing retained original namespace")
		}
		defer file.Close()
		var fs syscall.Statfs_t
		original, err := file.Stat()
		current, currentErr := os.Stat("/proc/self/ns/" + kind)
		name, nameErr := os.Readlink(fmt.Sprintf("/proc/self/fd/%d", fd))
		if err != nil || currentErr != nil || nameErr != nil || syscall.Fstatfs(int(fd), &fs) != nil || fs.Type != 0x6e736673 || os.SameFile(original, current) || name != os.Getenv("ROUTERVPN_ROUTING_PARENT_"+strings.ToUpper(kind)) {
			t.Fatal("fixture did not retain its original namespace handles across isolated creation", kind, err, currentErr, nameErr)
		}
	}
	t.Run("concurrent-configured-ipv6-local-route", nativeRoutingConcurrentAddressNamespace)
	for _, retire := range []bool{false, true} {
		name := "complete-native-install"
		if retire {
			name = "target-first-native-retirement"
		}
		t.Run(name, func(t *testing.T) {
			const name, peer = "rvpn-receipt", "rvpn-receipt-p"
			if _, err := netlink.LinkByName(name); err == nil {
				t.Fatal("native fixture interface already exists")
			}
			v := &netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: name}, PeerName: peer}
			if err := netlink.LinkAdd(v); err != nil {
				t.Fatal(err)
			}
			defer func() {
				if err := netlink.LinkDel(v); err != nil {
					t.Error(err)
				}
			}()
			link, err := netlink.LinkByName(name)
			if err != nil {
				t.Fatal(err)
			}
			other, err := netlink.LinkByName(peer)
			if err != nil {
				t.Fatal(err)
			}
			if err := netlink.LinkSetUp(other); err != nil {
				t.Fatal(err)
			}
			n := &NativeTun{routervpnOwnedIndex: link.Attrs().Index, options: Options{Name: name, MTU: 1280, Inet4Address: []netip.Prefix{netip.MustParsePrefix("172.29.94.1/30")}, Inet6Address: []netip.Prefix{netip.MustParsePrefix("fd29:94::1/126")}, AutoRoute: true, StrictRoute: true, IPRoute2TableIndex: 2022, IPRoute2RuleIndex: 9000, Inet4RouteAddress: []netip.Prefix{netip.MustParsePrefix("0.0.0.0/0")}, Inet6RouteAddress: []netip.Prefix{netip.MustParsePrefix("::/0")}}}
			if err := n.configure(link); err != nil {
				t.Fatal(err)
			}
			if err := netlink.LinkSetUp(link); err != nil {
				t.Fatal(err)
			}
			waitNativeRoutingVeths(t, link, other, n.options.Inet6Address[0])
			if err := n.setRoute(link); err != nil {
				t.Fatal(err)
			}
			defer func() {
				if err := n.unsetRoute0(link); err != nil {
					t.Error("owned routes failed to drain", err)
				}
			}()
			if err := n.setRules(); err != nil {
				t.Fatal(err)
			}
			defer func() {
				if err := n.unsetRules(); err != nil {
					t.Error("owned rules failed to drain", err)
				}
			}()
			raw, err := n.RouterVPNDesktopNetworkReceipt()
			if err != nil {
				t.Fatal("actual native routing receipt", err)
			}
			r, err := ParseDesktopNetworkReceipt(raw)
			if err != nil {
				t.Fatal(err)
			}
			if r.Index != uint32(link.Attrs().Index) || r.Name != name || r.MTU != 1280 || len(r.Objects) < 10 {
				t.Fatal("real native route/rule receipt lost complete ownership")
			}
			if !retire {
				return
			}
			targets := 0
			for _, rule := range n.rules() {
				if rule.Priority == 9010 {
					if err := netlink.RuleDel(rule); err != nil {
						t.Fatal(err)
					}
					targets++
				}
			}
			if targets != 2 {
				t.Fatal("native fixture did not retire both original NOP targets", targets)
			}
			if _, err := n.RouterVPNDesktopNetworkReceipt(); err == nil {
				t.Fatal("missing native target was accepted as a current receipt")
			}
			current, err := routervpnLinuxNetworkObjects("rule")
			if err != nil {
				t.Fatal(err)
			}
			unresolved := 0
			for _, now := range current {
				for _, old := range r.Objects {
					for _, target := range r.Objects {
						if DesktopLinuxRuleResolvedBy(now, old, target) {
							unresolved++
						}
					}
				}
			}
			if unresolved != 4 {
				t.Fatal("target-first teardown lost its exact four original GOTO flag transitions", unresolved)
			}
		})
	}
}

// These complete canonical bodies were read from a real owned veth in an
// isolated user/network namespace. Its configured address was tentative in
// the first readback, then the kernel published the LOCAL /128 host route.
func nativeRoutingConcurrentFixture(t *testing.T) (routerVPNLinuxRouteOwner, routerVPNLinuxRouteOwner, DesktopNetworkObject, DesktopNetworkObject) {
	t.Helper()
	parse := func(value string) DesktopNetworkObject {
		raw, err := base64.StdEncoding.Strict().DecodeString(value)
		if err != nil {
			t.Fatal(err)
		}
		object, err := ParseDesktopLinuxNetworkObject("route", raw)
		if err != nil {
			t.Fatal(err)
		}
		return object
	}
	explicit := parse("AgAAAPwD/QEAAAAACAAEAAMAAAAIAA8A5gcAAA==")
	local := parse("CoAAAP8CAAIAAAAAFAABAP0pAJQAAAAAAAAAAAAAAAEIAAQAAwAAAAgABgAAAAAACAAPAP8AAAAFABQAAAAAAA==")
	prefix := netip.MustParsePrefix("fd29:94::1/126")
	after := routerVPNLinuxRouteOwner{index: 3, name: "fixture", mtu: 1376, flags: net.FlagUp | net.FlagRunning,
		configured: []netip.Prefix{prefix}, addresses: []routerVPNLinuxRouteAddress{{prefix: prefix, flags: syscall.IFA_F_PERMANENT, preferred: int(^uint32(0)), valid: int(^uint32(0))}}}
	before := after
	before.addresses = append([]routerVPNLinuxRouteAddress(nil), after.addresses...)
	before.addresses[0].flags |= syscall.IFA_F_TENTATIVE
	return before, after, explicit, local
}

func TestRouterVPNNativeLinuxRoutingConcurrentAddressProof(t *testing.T) {
	before, after, explicit, local := nativeRoutingConcurrentFixture(t)
	if !routervpnLinuxKernelLocalAddressRoute(local, after) {
		t.Fatal("actual kernel LOCAL body lost its configured-address proof")
	}
	for name, added := range map[string][]DesktopNetworkObject{
		"ordinary-one-add": {explicit}, "explicit-before-local": {explicit, local}, "local-before-explicit": {local, explicit},
	} {
		t.Run(name, func(t *testing.T) {
			if !routervpnLinuxRouteAdditions(before, after, nil, added) {
				t.Fatal("original owner rejected its exact explicit/address-derived additions")
			}
		})
	}
	// Address readiness can be observed before the asynchronous host route;
	// the same complete address still has to survive both owner snapshots.
	if !routervpnLinuxRouteAdditions(after, after, nil, []DesktopNetworkObject{explicit, local}) {
		t.Fatal("already-ready same address lost its exact later kernel host route")
	}
	for name, added := range map[string][]DesktopNetworkObject{
		"missing-all": nil, "missing-explicit": {local}, "duplicate-explicit": {explicit, explicit},
		"duplicate-derived": {explicit, local, local},
	} {
		t.Run(name, func(t *testing.T) {
			if routervpnLinuxRouteAdditions(before, after, nil, added) {
				t.Fatal("ambiguous or missing explicit add acquired a receipt")
			}
		})
	}
	for _, existing := range []DesktopNetworkObject{explicit, local} {
		if routervpnLinuxRouteAdditions(before, after, []DesktopNetworkObject{existing}, []DesktopNetworkObject{explicit, local}) {
			t.Fatal("existing object was relabelled as this call's new addition")
		}
	}
}

func TestRouterVPNNativeLinuxRoutingConcurrentAddressRejectsForeign(t *testing.T) {
	before, after, explicit, local := nativeRoutingConcurrentFixture(t)
	body, err := base64.StdEncoding.Strict().DecodeString(local.Native)
	if err != nil {
		t.Fatal(err)
	}
	// Reparse every altered body, so rejection cannot rely on a stale cached
	// summary disagreeing with Native. Each control retains valid encoding.
	controls := []struct {
		name   string
		change func([]byte) []byte
	}{
