	// summary disagreeing with Native. Each control retains valid encoding.
	controls := []struct {
		name   string
		change func([]byte) []byte
	}{
		{"protocol", func(b []byte) []byte { b[5] = 3; return b }},
		{"type", func(b []byte) []byte { b[7] = 1; return b }},
		{"scope", func(b []byte) []byte { b[6] = 254; return b }},
