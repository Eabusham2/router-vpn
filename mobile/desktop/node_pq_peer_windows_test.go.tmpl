func nodePQWFPStartReference(t *testing.T, mode, layer string) *nodePQWFPReference {
	t.Helper()
	local := nodePQWFPInterface(t)
	private, err := ecdh.X25519().GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	request := nodePQWFPRequest{Schema: 1, Mode: mode, Layer: layer, Address: local.String(), Public: private.PublicKey().Bytes()}
	if layer != "" {
		var secret [32]byte
		if _, err = rand.Read(secret[:]); err != nil {
			t.Fatal(err)
		}
		request.Password = base64.StdEncoding.EncodeToString(secret[:])
		clear(secret[:])
	}
	actual, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	contents, err := os.ReadFile(actual)
	if err != nil {
		t.Fatal(err)
	}
	copyPath := filepath.Join(t.TempDir(), "owned-pq-reference.test.exe")
	if err = os.WriteFile(copyPath, contents, 0700); err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 240*time.Second)
	command := exec.CommandContext(ctx, copyPath, "-test.run=^TestRouterVPNDesktopNodeWindowsPQReferenceProcess$", "-test.count=1", "-test.timeout=235s")
	command.Env = append(os.Environ(), "ROUTERVPN_NODE_PQ_WFP_REFERENCE_CHILD=1")
	input, err := command.StdinPipe()
	if err != nil {
		cancel()
		t.Fatal(err)
	}
	output, childOutput, err := os.Pipe()
	if err != nil {
		_ = input.Close()
		cancel()
		t.Fatal(err)
	}
	p := &nodePQWFPReference{command: command, input: input, output: output, reader: bufio.NewReaderSize(output, nodePQWFPLimit+1), done: make(chan error, 1), ctx: ctx, cancel: cancel, request: request, private: private, local: local, copyPath: copyPath, digest: sha256.Sum256(contents)}
	command.Stdout, command.Stderr = childOutput, &p.diagnostics
	if err = command.Start(); err != nil {
		_ = input.Close()
		_ = output.Close()
		_ = childOutput.Close()
		cancel()
		t.Fatal(err)
	}
	_ = childOutput.Close()
	go func() { p.done <- command.Wait() }()
	t.Cleanup(func() {
		if err := p.close(); err != nil {
			t.Errorf("owned PQ reference did not join: %v; %s", err, p.diagnostics.String())
		}
	})
	raw, err := json.Marshal(request)
	if err != nil || len(raw)+1 > nodePQWFPLimit {
		t.Fatal("PQ launch request exceeded its bound", err)
	}
	if _, err = input.Write(append(raw, '\n')); err != nil {
		t.Fatal(err)
	}
	p.reply, err = p.read()
	scope, scopeErr := mobiletor.DesktopWindowsNodeCompositionAppID()
	wg, we := netip.ParseAddrPort(p.reply.WG)
	kem, ke := netip.ParseAddrPort(p.reply.KEM)
	if err != nil || scopeErr != nil || p.reply.Schema != 1 || len(p.reply.AppID) == 0 || bytes.Equal(scope, p.reply.AppID) || we != nil || ke != nil || wg.Addr() != local || kem.Addr() != local || wg.Port() == 0 || kem.Port() == 0 || wg == kem || len(p.reply.Public) != 32 || p.reply.Probe != "" || p.reply.ProbeLane != "" || p.reply.ProbeCount != 0 {
		t.Fatal("PQ reference was not a distinct retained executable and two exact peers", err, scopeErr, we, ke)
	}
	if layer == "" {
		if p.reply.Layer != "" || p.reply.Physical != "" {
			t.Fatal("PQ reference introduced an unselected Start Layer")
		}
	} else {
		for _, address := range []string{p.reply.Layer, p.reply.Physical} {
			value, err := netip.ParseAddrPort(address)
			if err != nil || value.Addr() != local || value.Port() == 0 {
				t.Fatal("PQ reference substituted its captured Start Layer", err)
			}
		}
	}
	for lane, remote := range p.lanes() {
		nonce := nodePQWFPNonce(t)
		if p.probe(t, "arm", lane, nonce) != 0 {
			t.Fatal("PQ fresh positive marker was already observed")
		}
		selected := ""
		if lane == "layer" {
			selected = layer
		}
		echo, err := nodePQWFPProbe(remote, nonce, selected, request.Password)
		if err != nil || !echo || p.probe(t, "observe", lane, nonce) == 0 {
			t.Fatal("PQ original-token positive marker did not transfer before BFE", err)
		}
	}
	return p
}

