	if err != nil || capture.SelectedDNS.Host != "192.168.50.133" || capture.SelectedDNS.Detour != "proxy" || capture.SelectedDNS.Physical || len(capture.BootstrapDNS) != 0 || capture.HomeLANAccess || capture.IPv6Mode != "on" {
		t.Fatal("PQ actual WFP lost selected policy", err)
	}
	type tuple struct {
		network string
		remote  netip.AddrPort
	}
	expected := make(map[tuple]bool)
	for _, root := range capture.PhysicalRoots {
		for _, d := range root.Destinations {
			ip, err := netip.ParseAddr(d.Host)
			if err != nil || d.Network != "tcp" && d.Network != "udp" || d.Port < 1 || d.Port > 65535 {
				t.Fatal("PQ captured root has an invalid native transport")
			}
			expected[tuple{d.Network, netip.AddrPortFrom(ip, uint16(d.Port))}] = true
		}
	}
	original := make(map[tuple]bool)
	for _, remote := range p.lanes() {
		original[tuple{"udp", remote}] = true
	}
	if !reflect.DeepEqual(expected, original) {
		t.Fatal("PQ actual WFP substituted its exact KEM/packet or Start Layer roots")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	snapshot, err := mobiletor.DesktopWindowsNodeCompositionSnapshot(ctx)
	if err != nil || snapshot.Closed || snapshot.Target != f.prepared || snapshot.Owner.Kind != "windows-isolated-token" || !snapshot.Options.RetainBaselineForHandoff || len(snapshot.Grants) == 0 {
		t.Fatal("PQ encrypted graph has no actual retained WFP/socket readback", err)
	}
	seen := make(map[tuple]bool)
	for _, grant := range snapshot.Grants {
		key := tuple{grant.Network, grant.Remote}
		if !expected[key] || grant.Capture != f.prepared.Capture || grant.Local.Addr() != p.local || grant.Binding.Owner != snapshot.Owner {
			t.Fatal("PQ native grant changed its captured protocol, peer or lower owner")
		}
		seen[key] = true
	}
	if !reflect.DeepEqual(seen, expected) {
		t.Fatal("PQ native WFP omitted a captured packet/KEM lane")
	}
}
func nodePQWFPAgreedKey(t *testing.T, f *nodePQWFPFixture, p *nodePQWFPReference, previous [32]byte, epoch int) [32]byte {
	t.Helper()
	native, ok := f.endpoint.base.(nativePQReadback)
	if !ok {
		t.Fatal("actual PQ endpoint lost native readback")
	}
	for deadline := time.Now().Add(2 * time.Second); ; {
		local, err := native.RouterVPNTestPQSnapshot()
		if err != nil {
			t.Fatal(err)
		}
		remote := p.observe(t, "stats")
		if remote.Updates >= int64(epoch+1) && local.KeyDigest == remote.Snapshot.KeyDigest && local.KeyDigest != previous {
			return local.KeyDigest
		}
		if time.Now().After(deadline) {
			t.Fatal("both isolated native peers did not adopt the same fresh PQ key", epoch)
		}
		time.Sleep(time.Millisecond)
	}
}
func nodePQWFPDrain(t *testing.T, f *nodePQWFPFixture) mobiletor.DesktopWindowsProtectionTarget {
	t.Helper()
	if err := f.close(); err != nil {
