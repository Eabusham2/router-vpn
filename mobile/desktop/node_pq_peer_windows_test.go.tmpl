						retained = f.prepared
						nodePQWFPAgreedKey(t, f, peer, [32]byte{}, 0)
						ctx, cancel := context.WithTimeout(context.Background(), 350*time.Millisecond)
						defer cancel()
						connection, err := f.endpoint.DialContext(ctx, "tcp", M.ParseSocksaddr("192.0.2.99:9999"))
						if connection != nil {
							_ = connection.Close()
						}
						observed := peer.observe(t, "stats")
						if err == nil || observed.Packets == 0 || observed.Echoes != 0 || observed.Queries != 0 {
							t.Fatal("actual WFP PQ accepted the wrong captured packet peer after native KEM")
						}
					} else {
						done := make(chan error, 1)
						go func() { done <- f.box.RouterVPNStrategyStart() }()
						completed := false
						for deadline := time.Now().Add(2 * time.Second); ; {
							select {
							case err := <-done:
								completed = true
								if err == nil {
									t.Fatal("actual WFP PQ accepted untrusted KEM or Start Layer credentials")
								}
							default:
							}
							observed := peer.observe(t, "stats")
							rejected := fault == "kem-peer" && observed.KEMRejected > 0 || fault == "aes-key" && observed.LayerRejected > 0
							if rejected {
								break
							}
							if completed || time.Now().After(deadline) {
								f.network.Cancel()
								if !completed {
									select {
									case <-done:
									case <-time.After(time.Second):
										t.Error("failed PQ credential startup did not join")
									}
								}
								t.Fatal("actual WFP PQ credential negative never reached native authenticated rejection")
							}
							time.Sleep(time.Millisecond)
						}
						observed := peer.observe(t, "stats")
						if f.endpoint.owner.Ready() || f.endpoint.owner.TransportReady() || observed.Updates != 0 || observed.Packets != 0 || observed.Queries != 0 {
							t.Fatal("untrusted native PQ gained packet or DNS readiness")
						}
						f.network.Cancel()
						if !completed {
							select {
							case err := <-done:
								if err == nil {
									t.Fatal("cancelled native PQ became successful")
								}
							case <-time.After(time.Second):
								t.Fatal("cancelled native PQ handshake did not join")
							}
						}
						retained = f.prepared
					}
					if retained.Validate() != nil || f.admitted != 1 {
						t.Fatal("PQ credential rejection bypassed exact native prepared ownership")
					}
					retained = nodePQWFPDrain(t, f)
					nodePQWFPRequireBlocked(t, peer)
				})
			}
		}
	}
}

func nodePQWFPRestoration(first, restored *nodePQWFPFixture) error {
	before, after := first.policy.Metadata(), restored.policy.Metadata()
	if first.prepared.Validate() != nil || restored.prepared.Validate() != nil || before.SessionID == after.SessionID || before.SourceSHA256 == after.SourceSHA256 || before.ConfigSHA256 == after.ConfigSHA256 || first.prepared.Capture.SourceSHA256 != before.SourceSHA256 || restored.prepared.Capture.SourceSHA256 != after.SourceSHA256 {
		return errors.New("PQ restoration reused or replaced its actual runtime identity")
	}
	before.SessionID, before.SourceSHA256, before.ConfigSHA256 = "", "", ""
	after.SessionID, after.SourceSHA256, after.ConfigSHA256 = "", "", ""
	if !reflect.DeepEqual(before, after) {
		return errors.New("PQ restoration replaced its saved original source or policy")
	}
	return nil
}
func TestRouterVPNDesktopNodeWindowsPQSuccession(t *testing.T) {
	for _, layer := range []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		t.Run(nodePQLayerName(layer), func(t *testing.T) {
			if err := mobiletor.DesktopWindowsNodeCompositionAbsent(context.Background()); err != nil {
				t.Fatal(err)
			}
			// Only one XOR peer owns the fixed shipping relay port. The intervening
			// independently keyed AWG-PQ trial uses its separately captured direct roots.
			firstPeer := nodePQWFPStartReference(t, "wg-pq", layer)
			trialPeer := nodePQWFPStartReference(t, "awg2-pq", "")
			var retained mobiletor.DesktopWindowsProtectionTarget
			nodePQWFPCleanup(t, &retained)
			original := firstPeer.original(t, "", "always")
			first := nodePQWFPBox(t, original, nil, true)
			first.start(t)
			retained = first.prepared
			nodePQWFPRequireTraffic(t, first, firstPeer, false)
			retained = nodePQWFPDrain(t, first)
			trial := nodePQWFPBox(t, trialPeer.original(t, "", "on-connect"), &retained, true)
			trial.start(t)
			retained = trial.prepared
			nodePQWFPRequireTraffic(t, trial, trialPeer, false)
			trial.network.InterfaceUpdated(context.Background())
			retained = nodePQWFPDrain(t, trial)
			// The old client is fully joined and its exact BFE grant set is empty before
			// the private reference resets just its captured client-side forwarding.
			firstPeer.observe(t, "reset-joined-client")
			restored := nodePQWFPBox(t, original, &retained, true)
			restored.start(t)
			retained = restored.prepared
			if err := nodePQWFPRestoration(first, restored); err != nil || retained.Policy != "always" {
				t.Fatal("actual PQ reverse handoff lost its saved capture", err)
			}
			first.network.InterfaceUpdated(context.Background())
			if err := first.close(); err != nil {
				t.Fatal(err)
			}
			nodePQWFPRequireTraffic(t, restored, firstPeer, false)
			retained = nodePQWFPDrain(t, restored)
		})
	}
}
func TestRouterVPNDesktopNodeWindowsPQForeignPredecessor(t *testing.T) {
	if err := mobiletor.DesktopWindowsNodeCompositionAbsent(context.Background()); err != nil {
		t.Fatal(err)
	}
	peer := nodePQWFPStartReference(t, "wg-pq", "")
	var retained mobiletor.DesktopWindowsProtectionTarget
	nodePQWFPCleanup(t, &retained)
	original := peer.original(t, "", "always")
	first := nodePQWFPBox(t, original, nil, true)
	first.start(t)
	retained = first.prepared
	nodePQWFPRequireTraffic(t, first, peer, false)
	retained = nodePQWFPDrain(t, first)
	wrong := retained
	wrong.Capture.SourceSHA256 = strings.Repeat("f", 64)
	candidate := nodePQWFPBox(t, original, &wrong, true)
	if err := candidate.box.RouterVPNStrategyStart(); err == nil || candidate.admitted != 0 {
		if candidate.admitted != 0 {
			retained = candidate.prepared
		}
		t.Fatal("foreign PQ predecessor reached actual native encrypted startup")
	}
	if err := candidate.close(); err != nil {
		t.Fatal("rejected PQ successor did not join", err)
	}
	if err := mobiletor.DesktopWindowsNodeCompositionVerifyRetained(context.Background(), retained); err != nil {
		t.Fatal("rejected PQ successor changed the original retained deny", err)
	}
}

func TestRouterVPNDesktopNodeWindowsPQCapabilityOpen(t *testing.T) {
	for _, mode := range []string{"wg-pq", "awg2-pq"} {
		for _, layer := range []string{"", "off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			if !mobilemultihop.DesktopNodePhysicalGraphSupported(mode, layer) {
				t.Fatal("prospective native PQ graph was not admitted by its exact capability", mode, layer)
			}
		}
		if mobilemultihop.DesktopNodePhysicalGraphSupported(mode, "uncaptured-layer") {
			t.Fatal("PQ capability widened the Start Layer contract")
		}
	}
	if mobilemultihop.DesktopNodePhysicalGraphSupported("unrelated-graph", "") {
		t.Fatal("PQ capability widened unrelated graph admission")
	}
}
