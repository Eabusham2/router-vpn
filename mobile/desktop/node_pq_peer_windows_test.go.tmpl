func nodePQWFPRequireBlocked(t *testing.T, p *nodePQWFPReference) {
	t.Helper()
	for lane, remote := range p.lanes() {
		if p.probe(t, "positive", lane, nodePQWFPNonce(t)) != 1 {
			t.Fatal("PQ separate-reference positive marker had no independent receipt")
		}
		nonce := nodePQWFPNonce(t)
		if p.probe(t, "arm", lane, nonce) != 0 {
			t.Fatal("PQ denied marker already had traffic")
		}
		layer := ""
		if lane == "layer" {
			layer = p.request.Layer
		}
		echo, err := nodePQWFPProbe(remote, nonce, layer, p.request.Password)
		received := p.probe(t, "observe", lane, nonce)
		if p.probe(t, "positive", lane, nodePQWFPNonce(t)) != 1 {
			t.Fatal("PQ separate-reference positive marker lost its actual route")
		}
		after := p.probe(t, "observe", lane, nonce)
		if after < received || after != 0 || echo {
			t.Fatal("ordinary token crossed PQ actual outer deny: independent peer marker receipt", lane, after)
		}
		var timeout net.Error
		if !errors.Is(err, syscall.Errno(10013)) && !(errors.As(err, &timeout) && timeout.Timeout()) {
			t.Fatal("PQ ordinary rejection had no bounded native access or timeout observation", err)
		}
	}
}
func nodePQWFPRequireNative(t *testing.T, f *nodePQWFPFixture, p *nodePQWFPReference) {
