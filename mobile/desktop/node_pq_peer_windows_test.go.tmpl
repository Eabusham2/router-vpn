const nodePQWFPLimit = 64 << 10
const nodePQWFPProbePrefix = "routervpn-pq-owned-raw-datagram/"

// All observations are owned by this exact retained peer and armed over its
// private anonymous input. They are disjoint from the actual KEM/packet data.
type nodePQWFPObservation struct {
	mu     sync.Mutex
	counts map[string]int64
}

func (o *nodePQWFPObservation) arm(nonce string) error {
	raw, err := hex.DecodeString(nonce)
	if err != nil || len(raw) != 16 || hex.EncodeToString(raw) != nonce {
		return errors.New("PQ probe nonce is not canonical")
	}
	o.mu.Lock()
	defer o.mu.Unlock()
	if o.counts == nil {
		o.counts = make(map[string]int64)
	}
	if _, exists := o.counts[nonce]; exists || len(o.counts) >= 128 {
		return errors.New("PQ probe reused its nonce or exceeded its owned bound")
	}
	o.counts[nonce] = 0
	return nil
}
func (o *nodePQWFPObservation) count(nonce string) (int64, error) {
	o.mu.Lock()
	defer o.mu.Unlock()
	count, ok := o.counts[nonce]
	if !ok {
		return 0, errors.New("PQ probe lost its exact nonce")
	}
	return count, nil
}
func (o *nodePQWFPObservation) receive(conn *net.UDPConn, body []byte, remote netip.AddrPort) (bool, error) {
	if len(body) != len(nodePQWFPProbePrefix)+32 || !bytes.HasPrefix(body, []byte(nodePQWFPProbePrefix)) {
		return false, nil
	}
	nonce := string(body[len(nodePQWFPProbePrefix):])
	o.mu.Lock()
	count, armed := o.counts[nonce]
	if armed {
		o.counts[nonce] = count + 1
	}
	o.mu.Unlock()
	if !armed {
		return false, nil
	}
	n, err := conn.WriteToUDPAddrPort(body, remote)
	if err == nil && n != len(body) {
		err = io.ErrShortWrite
	}
	return true, err
}

// A single bridge retains the same loopback KEM endpoint through an explicitly
// joined client replacement. The layer bridge instead retains a bounded exact
// connection per captured UDP sender; it cannot mix the two encrypted lanes.
type nodePQWFPBridge struct {
	listener    *net.UDPConn
	target      *net.UDPAddr
	single      *net.UDPConn
	barrier     <-chan struct{}
	observation nodePQWFPObservation
	ctx         context.Context
	cancel      context.CancelFunc
	mu          sync.Mutex
	dispatch    sync.Mutex
	remote      netip.AddrPort
	retired     map[netip.AddrPort]bool
	peers       map[netip.AddrPort]*nodePQWFPBridgePeer
	workers     sync.WaitGroup
	packets     atomic.Int64
	plain       atomic.Bool
	once        sync.Once
}

type nodePQWFPBridgePeer struct {
	connection *net.UDPConn
	done       chan struct{}
}

func newNodePQWFPBridge(t *testing.T, ip netip.Addr, target string, single bool, barrier <-chan struct{}) *nodePQWFPBridge {
	t.Helper()
	address, err := net.ResolveUDPAddr("udp4", target)
	if err != nil || !address.IP.IsLoopback() && !address.IP.Equal(net.IP(ip.AsSlice())) || address.Port == 0 {
		t.Fatal("PQ reference bridge escaped its captured local peer", err)
	}
	listener, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.AddrPortFrom(ip, 0)))
	if err != nil {
		t.Fatal(err)
	}
	if err = listener.SetWriteBuffer(65535); err != nil {
		_ = listener.Close()
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	f := &nodePQWFPBridge{listener: listener, target: address, barrier: barrier, ctx: ctx, cancel: cancel, peers: make(map[netip.AddrPort]*nodePQWFPBridgePeer), retired: make(map[netip.AddrPort]bool)}
	if single {
		f.single, err = net.DialUDP("udp4", nil, address)
		if err != nil {
			cancel()
			_ = listener.Close()
			t.Fatal(err)
		}
		f.workers.Add(1)
		go f.returnPackets(f.single, netip.AddrPort{})
	}
	f.workers.Add(1)
	go func() {
		defer f.workers.Done()
		packet := make([]byte, 65535)
		for {
			n, remote, err := listener.ReadFromUDPAddrPort(packet)
			if err != nil {
				return
			}
			if remote.Addr() != ip {
				continue
			}
			if consumed, err := f.observation.receive(listener, packet[:n], remote); consumed || err != nil {
				if err != nil {
					return
				}
				continue
			}
			if err := f.forward(packet[:n], remote); err != nil {
				return
			}
		}
	}()
	t.Cleanup(f.close)
	return f
}

// reset and one complete forwarding operation share this retained dispatch
// guard. A stale client tuple remains retired after reset, including packets
// already read before the joined replacement command acquired the guard.
func (f *nodePQWFPBridge) forward(packet []byte, remote netip.AddrPort) error {
	f.dispatch.Lock()
	defer f.dispatch.Unlock()
	f.mu.Lock()
	if f.ctx.Err() != nil {
		f.mu.Unlock()
		return f.ctx.Err()
	}
	if f.retired[remote] {
		f.mu.Unlock()
		return nil
	}
	peer := f.single
	if peer != nil {
		if f.remote.IsValid() && f.remote != remote {
			f.mu.Unlock()
			return nil
		}
		f.remote = remote
	} else {
		captured := f.peers[remote]
		if captured == nil {
			if len(f.peers) >= 16 {
				f.mu.Unlock()
				return nil
			}
			var err error
			peer, err = net.DialUDP("udp4", nil, f.target)
			if err != nil {
				f.mu.Unlock()
				return err
			}
			captured = &nodePQWFPBridgePeer{connection: peer, done: make(chan struct{})}
			f.peers[remote] = captured
			f.workers.Add(1)
			go func() { defer close(captured.done); f.returnPackets(captured.connection, remote) }()
		}
		peer = captured.connection
	}
	f.mu.Unlock()
	f.packets.Add(1)
	if bytes.Contains(packet, []byte(nodePQPayload)) {
		f.plain.Store(true)
	}
	if f.barrier != nil {
		select {
		case <-f.barrier:
		case <-f.ctx.Done():
			return f.ctx.Err()
		}
	}
	if err := peer.SetWriteDeadline(time.Now().Add(3 * time.Second)); err != nil {
		return err
	}
	_, err := peer.Write(packet)
	return err
}

func (f *nodePQWFPBridge) returnPackets(peer *net.UDPConn, captured netip.AddrPort) {
	defer f.workers.Done()
	packet := make([]byte, 65535)
	for {
		n, err := peer.Read(packet)
		if err != nil {
			return
		}
		remote := captured
		if !remote.IsValid() {
			f.mu.Lock()
			remote = f.remote
			f.mu.Unlock()
		}
		if !remote.IsValid() {
			continue
		}
		if _, err = f.listener.WriteToUDPAddrPort(packet[:n], remote); err != nil {
			return
		}
	}
}
func (f *nodePQWFPBridge) address() netip.AddrPort {
	return f.listener.LocalAddr().(*net.UDPAddr).AddrPort()
}
func (f *nodePQWFPBridge) reset() {
	f.dispatch.Lock()
	f.mu.Lock()
	if f.remote.IsValid() {
		f.retired[f.remote] = true
	}
	f.remote = netip.AddrPort{}
	joined := make([]<-chan struct{}, 0, len(f.peers))
	for remote, peer := range f.peers {
		f.retired[remote] = true
		_ = peer.connection.Close()
		joined = append(joined, peer.done)
		delete(f.peers, remote)
	}
	f.mu.Unlock()
	f.dispatch.Unlock()
	for _, done := range joined {
		<-done
	}
}
func (f *nodePQWFPBridge) close() {
	f.once.Do(func() {
		f.cancel()
		_ = f.listener.Close()
		f.mu.Lock()
		if f.single != nil {
			_ = f.single.Close()
		}
		for _, peer := range f.peers {
			_ = peer.connection.Close()
		}
		f.mu.Unlock()
		f.workers.Wait()
	})
}

func nodePQWFPInterface(t *testing.T) netip.Addr {
	t.Helper()
	logger := log.NewNOPFactory().Logger()
	updates, err := tun.NewNetworkUpdateMonitor(logger)
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := updates.Close(); err != nil {
			t.Error("PQ physical update monitor did not join", err)
		}
	}()
	monitor, err := tun.NewDefaultInterfaceMonitor(updates, logger, tun.DefaultInterfaceMonitorOptions{InterfaceFinder: control.NewDefaultInterfaceFinder()})
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := monitor.Close(); err != nil {
			t.Error("PQ default interface monitor did not join", err)
		}
	}()
	if err = updates.Start(); err != nil {
		t.Fatal(err)
	}
	if err = monitor.Start(); err != nil {
		t.Fatal(err)
	}
	selected := monitor.DefaultInterface()
	if selected == nil || selected.Flags&net.FlagUp == 0 || selected.Flags&net.FlagLoopback != 0 {
		t.Fatal("PQ native reference has no current physical interface")
	}
	for _, prefix := range selected.Addresses {
		if prefix.Addr().Is4() && prefix.Addr().IsPrivate() {
			return prefix.Addr()
		}
	}
	t.Fatal("PQ native reference requires a selected private IPv4 interface")
	return netip.Addr{}
}

type nodePQWFPRequest struct {
	Schema   int    `json:"schema"`
	Mode     string `json:"mode"`
	Layer    string `json:"layer"`
	Address  string `json:"address"`
	Public   []byte `json:"public"`
	Password string `json:"password"`
}
type nodePQWFPReply struct {
	Schema        int                       `json:"schema"`
	AppID         []byte                    `json:"app_id"`
	WG            string                    `json:"wg"`
	KEM           string                    `json:"kem"`
	Layer         string                    `json:"layer"`
	Physical      string                    `json:"physical"`
	Public        []byte                    `json:"public"`
	Parameters    map[string]string         `json:"parameters"`
	Snapshot      mobilepq.NativePQSnapshot `json:"snapshot"`
	Updates       int64                     `json:"updates"`
	Packets       int64                     `json:"packets"`
	KEMReceived   int64                     `json:"kem_received"`
	KEMRejected   int64                     `json:"kem_rejected"`
	LayerRaw      int64                     `json:"layer_raw"`
	LayerRejected int64                     `json:"layer_rejected"`
	Lanes         int                       `json:"lanes"`
	Queries       int64                     `json:"queries"`
	Echoes        int64                     `json:"echoes"`
	Rejected      int64                     `json:"rejected"`
	Plain         bool                      `json:"plain"`
	ProbeLane     string                    `json:"probe_lane"`
	Probe         string                    `json:"probe"`
	ProbeCount    int64                     `json:"probe_count"`
}

func nodePQWFPProbe(remote netip.AddrPort, nonce, layer, password string) (bool, error) {
	connection, err := net.DialTimeout("udp4", remote.String(), 750*time.Millisecond)
	if err != nil {
		return false, err
	}
	defer connection.Close()
	if err = connection.SetDeadline(time.Now().Add(750 * time.Millisecond)); err != nil {
		return false, err
	}
	payload := []byte(nodePQWFPProbePrefix + nonce)
	if layer == "aes-256-gcm+xor-whitening" {
		key, err := startwhitening.Key(mobilemultihop.NativeStartLayerMethod, password)
		if err != nil {
			return false, err
		}
		for i := range payload {
			payload[i] ^= key[i%len(key)]
		}
		clear(key[:])
	}
	if n, err := connection.Write(payload); err != nil || n != len(payload) {
		return false, errors.Join(err, io.ErrShortWrite)
	}
	answer := make([]byte, len(payload)+1)
	n, err := connection.Read(answer)
	if err != nil {
		return false, err
	}
	if !bytes.Equal(answer[:n], payload) {
		return false, errors.New("PQ raw probe changed its exact nonce")
	}
	return true, nil
}

// This is the real native PQ and packet implementation in a distinct retained
// executable. Its EOF joins all captured references and relay processes.
func TestRouterVPNDesktopNodeWindowsPQReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NODE_PQ_WFP_REFERENCE_CHILD") == "" {
		return
	}
	if os.Getenv("ROUTERVPN_NODE_PQ_WFP_REFERENCE_CHILD") != "1" {
		t.Fatal("unknown PQ reference owner")
	}
	input := bufio.NewReaderSize(os.Stdin, nodePQWFPLimit+1)
	raw, err := input.ReadSlice('\n')
	if err != nil || len(raw) == 0 || len(raw) > nodePQWFPLimit {
		t.Fatal("PQ reference request is not bounded", err)
	}
	var request nodePQWFPRequest
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.DisallowUnknownFields()
	if err = decoder.Decode(&request); err != nil {
		t.Fatal("invalid PQ reference request", err)
	}
	var extra any
	if decoder.Decode(&extra) != io.EOF || request.Schema != 1 || len(request.Public) != 32 || request.Mode != "wg-pq" && request.Mode != "awg2-pq" || request.Layer != "" && request.Layer != "aes-256-gcm" && request.Layer != "aes-256-gcm+xor-whitening" {
		t.Fatal("PQ reference request escaped its fixed graph")
	}
	local := nodePQWFPInterface(t)
	if request.Address != local.String() {
		t.Fatal("PQ reference selected another physical interface")
	}
	if request.Layer == "" && request.Password != "" {
		t.Fatal("PQ reference carried an unselected layer")
	}
	if request.Layer != "" {
		key, err := base64.StdEncoding.Strict().DecodeString(request.Password)
		valid := err == nil && len(key) == 32 && base64.StdEncoding.EncodeToString(key) == request.Password
		clear(key)
		if !valid {
			t.Fatal("PQ reference layer key was not canonical")
		}
	}
	inner := &nodePQInner{owned: make(map[io.Closer]bool)}
	t.Cleanup(inner.close)
	reference := AWG.NewNativePQTrafficReferenceWithHandler(t, request.Public, request.Mode == "awg2-pq", inner)
	server := newPQTrafficServer(t, reference, 2)
	wg := newNodePQWFPBridge(t, local, reference.Address(), true, server.initialKey)
	kem := newNodePQWFPBridge(t, local, server.conn.LocalAddr().String(), true, nil)
	var layer *nodePQLayer
	var outer *nodePQWFPBridge
	var physical netip.AddrPort
	if request.Layer != "" {
		wgInner := M.SocksaddrFrom(netip.MustParseAddr("10.78.0.1"), wg.address().Port())
		kemInner := M.SocksaddrFrom(netip.MustParseAddr("10.78.0.1"), kem.address().Port())
		layer = newNodePQLayer(t, local, request.Password, wgInner, kemInner, reference, server)
		// The same retained bridges preserve the independently captured packet/KEM
		// destinations through a joined native restoration. No endpoint is guessed.
		layer.routes[wgInner] = wg.address().String()
		layer.routes[kemInner] = kem.address().String()
		outer = newNodePQWFPBridge(t, local, layer.address().String(), false, nil)
		physical = outer.address()
		if request.Layer == "aes-256-gcm+xor-whitening" {
			physical = nodePQRelay(t, local, outer.address().String(), request.Password)
		}
	}
	scope, err := mobiletor.DesktopWindowsNodeCompositionAppID()
	if err != nil || len(scope) == 0 {
		t.Fatal("PQ reference has no executable identity", err)
	}
	bridges := map[string]*nodePQWFPBridge{"wg": wg, "kem": kem}
	if outer != nil {
		bridges["layer"] = outer
	}
	respond := func(lane, nonce string) {
		select {
		case err := <-server.failure:
			t.Fatal("native PQ reference failed", err)
		default:
		}
		snapshot, err := reference.Snapshot()
		if err != nil {
			t.Fatal("native PQ reference readback failed", err)
		}
		reply := nodePQWFPReply{Schema: 1, AppID: scope, WG: wg.address().String(), KEM: kem.address().String(), Public: reference.Public, Parameters: reference.Parameters, Snapshot: snapshot, Updates: reference.Updates(), Packets: reference.Packets(), KEMReceived: server.received.Load(), KEMRejected: server.rejected.Load(), Queries: inner.queries.Load(), Echoes: inner.echoes.Load(), Rejected: inner.rejected.Load(), Plain: reference.PlaintextSeen() || wg.plain.Load() || kem.plain.Load(), ProbeLane: lane, Probe: nonce}
		if layer != nil {
			reply.Layer = outer.address().String()
			reply.Physical = physical.String()
			reply.LayerRaw = layer.raw.Load()
			reply.LayerRejected = layer.rejected.Load()
			reply.Plain = reply.Plain || layer.plain.Load() || outer.plain.Load()
			layer.lanes.Range(func(_, v any) bool {
				if v.(*atomic.Int64).Load() > 0 {
					reply.Lanes++
				}
				return true
			})
		}
		if nonce != "" {
			reply.ProbeCount, err = bridges[lane].observation.count(nonce)
			if err != nil {
				t.Fatal(err)
			}
		}
		if err = json.NewEncoder(os.Stdout).Encode(reply); err != nil {
			t.Fatal("PQ reference acknowledgement failed", err)
		}
	}
	respond("", "")
	for {
		line, err := input.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > nodePQWFPLimit {
			t.Fatal("PQ reference lost its bounded input", err)
		}
		action := strings.TrimSuffix(string(line), "\n")
		switch action {
		case "stats":
			respond("", "")
			continue
		case "fail-dns":
			inner.failed.Store(true)
			respond("", "")
			continue
		case "restore-dns":
			inner.failed.Store(false)
			respond("", "")
			continue
		case "rekey":
			server.force(t)
			respond("", "")
			continue
		case "rehandshake":
			if err := reference.Rehandshake(); err != nil {
				t.Fatal(err)
			}
			respond("", "")
			continue
		case "reset-joined-client":
			wg.reset()
			kem.reset()
			if outer != nil {
				outer.reset()
			}
			respond("", "")
			continue
		}
		parts := strings.Split(action, " ")
		if len(parts) != 3 || len(parts[2]) != 32 || bridges[parts[1]] == nil || parts[0] != "arm" && parts[0] != "observe" && parts[0] != "positive" {
			t.Fatal("PQ reference received an unrelated observation request")
		}
		bridge := bridges[parts[1]]
		if parts[0] != "observe" {
			if err := bridge.observation.arm(parts[2]); err != nil {
				t.Fatal(err)
			}
		}
		if parts[0] == "positive" {
			remote := bridge.address()
			selected := ""
			if parts[1] == "layer" {
				remote = physical
				selected = request.Layer
			}
			echo, err := nodePQWFPProbe(remote, parts[2], selected, request.Password)
			if err != nil || !echo {
				t.Fatal("PQ reference positive marker did not transfer actual bytes", err)
			}
		}
		respond(parts[1], parts[2])
	}
}

type nodePQWFPReference struct {
	command     *exec.Cmd
	input       io.WriteCloser
	output      *os.File
	reader      *bufio.Reader
	done        chan error
	ctx         context.Context
	cancel      context.CancelFunc
	once        sync.Once
	closeErr    error
	diagnostics bytes.Buffer
	request     nodePQWFPRequest
	reply       nodePQWFPReply
	private     *ecdh.PrivateKey
	local       netip.Addr
	copyPath    string
	digest      [32]byte
}

func (p *nodePQWFPReference) read() (nodePQWFPReply, error) {
	type result struct {
		reply nodePQWFPReply
		err   error
	}
	done := make(chan result, 1)
	go func() {
		raw, err := p.reader.ReadSlice('\n')
		var reply nodePQWFPReply
		if err == nil && len(raw) <= nodePQWFPLimit {
			d := json.NewDecoder(bytes.NewReader(raw))
			d.DisallowUnknownFields()
			err = d.Decode(&reply)
			var extra any
			if err == nil && d.Decode(&extra) != io.EOF {
				err = errors.New("PQ reference appended another reply")
			}
		} else {
			err = errors.Join(err, errors.New("PQ reference response exceeded its bound"))
		}
		done <- result{reply, err}
	}()
	ctx, cancel := context.WithTimeout(p.ctx, 10*time.Second)
	defer cancel()
	select {
	case value := <-done:
		return value.reply, value.err
	case <-ctx.Done():
		p.cancel()
		_ = p.output.Close()
		<-done
		return nodePQWFPReply{}, ctx.Err()
	}
}
func (p *nodePQWFPReference) close() error {
	p.once.Do(func() {
		defer p.cancel()
		_ = p.input.Close()
		select {
		case p.closeErr = <-p.done:
		case <-time.After(10 * time.Second):
			_ = p.command.Process.Kill()
			p.closeErr = errors.Join(<-p.done, errors.New("PQ reference ignored its owned input EOF"))
		}
		p.closeErr = errors.Join(p.closeErr, p.output.Close())
		raw, err := os.ReadFile(p.copyPath)
		if err != nil || sha256.Sum256(raw) != p.digest {
			p.closeErr = errors.Join(p.closeErr, err, errors.New("retained PQ reference executable changed"))
		}
	})
	return p.closeErr
}
func (p *nodePQWFPReference) observe(t *testing.T, action string) nodePQWFPReply {
	t.Helper()
	if _, err := io.WriteString(p.input, action+"\n"); err != nil {
		t.Fatal("PQ observation lost its retained channel", err)
	}
	reply, err := p.read()
	old := p.reply
	if err != nil || reply.Schema != 1 || !bytes.Equal(reply.AppID, old.AppID) || reply.WG != old.WG || reply.KEM != old.KEM || reply.Layer != old.Layer || reply.Physical != old.Physical || !bytes.Equal(reply.Public, old.Public) || !reflect.DeepEqual(reply.Parameters, old.Parameters) || reply.Updates < old.Updates || reply.Packets < old.Packets || reply.Queries < old.Queries || reply.KEMReceived < old.KEMReceived || reply.KEMRejected < old.KEMRejected || reply.LayerRejected < old.LayerRejected {
		t.Fatal("PQ reference changed its captured owner or regressed real observations", err)
	}
	p.reply = reply
	return reply
}
func nodePQWFPNonce(t *testing.T) string {
	t.Helper()
	var nonce [16]byte
	if _, err := rand.Read(nonce[:]); err != nil {
		t.Fatal(err)
	}
	return hex.EncodeToString(nonce[:])
}
