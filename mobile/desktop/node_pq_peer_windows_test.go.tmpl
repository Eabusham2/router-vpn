	}
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	snapshot, err := mobiletor.DesktopWindowsNodeCompositionSnapshot(ctx)
	if err != nil || !snapshot.Closed || len(snapshot.Grants) != 0 || snapshot.Target != f.prepared || f.network.SocketCurrent() || f.network.Current() || f.endpoint.owner.Ready() || f.endpoint.owner.TransportReady() {
		t.Fatal("PQ native drain did not retain only its exact deny", err)
	}
	return snapshot.Target
}
func nodePQWFPRequireTraffic(t *testing.T, f *nodePQWFPFixture, p *nodePQWFPReference, rekey bool) {
	t.Helper()
	var previous [32]byte
	var priorLocal, priorRemote int64
	epochs := 1
	if rekey {
		epochs = 2
	}
	for epoch := 0; epoch < epochs; epoch++ {
		if epoch != 0 {
			p.observe(t, "rekey")
		}
		previous = nodePQWFPAgreedKey(t, f, p, previous, epoch)
		native := f.endpoint.base.(nativePQReadback)
		if epoch != 0 {
			p.observe(t, "rehandshake")
			if err := native.RouterVPNTestPQRehandshake(); err != nil {
				t.Fatal(err)
			}
		}
		for _, network := range []string{"tcp", "udp"} {
			for _, host := range []string{"192.0.2.99", "2001:db8::99"} {
				if err := f.exchange(network, host, epoch); err != nil {
					t.Fatal("actual WFP PQ encrypted payload failed", network, host, epoch, err)
				}
			}
		}
		local, err := native.RouterVPNTestPQSnapshot()
		remote := p.observe(t, "stats")
		if err != nil || local.KeyDigest != previous || remote.Snapshot.KeyDigest != previous || local.HandshakeNanos <= priorLocal || remote.Snapshot.HandshakeNanos <= priorRemote {
			t.Fatal("actual WFP PQ traffic used an old or different native key/handshake", epoch, err)
		}
		priorLocal, priorRemote = local.HandshakeNanos, remote.Snapshot.HandshakeNanos
	}
	if err := f.box.RouterVPNStrategyDNSProof(); err != nil {
		t.Fatal("actual WFP PQ selected Home DNS proof failed", err)
	}
	before := p.observe(t, "fail-dns")
	if before.Queries == 0 {
		t.Fatal("actual WFP PQ DNS never reached its selected peer")
	}
	if err := f.box.RouterVPNStrategyDNSProof(); err == nil {
		t.Fatal("actual WFP PQ reused cached selected DNS success")
	}
	after := p.observe(t, "restore-dns")
	if after.Queries <= before.Queries {
		t.Fatal("actual WFP PQ DNS failure did not reach the selected route")
	}
	if err := f.box.RouterVPNStrategyDNSProof(); err != nil {
		t.Fatal("actual WFP PQ selected DNS did not recover", err)
	}
	final := p.observe(t, "stats")
	if final.Queries <= after.Queries || final.Packets == 0 || final.KEMReceived == 0 || final.Plain || final.Rejected != 0 || p.request.Layer != "" && (final.Lanes != 2 || final.LayerRaw == 0) {
		t.Fatal("actual WFP PQ omitted ciphertext, both lanes or fresh selected DNS")
	}
	nodePQWFPRequireNative(t, f, p)
	nodePQWFPRequireBlocked(t, p)
}

