	if err != nil {
		t.Fatal(err)
	}
	f := &nodePQWFPFixture{nodePQFixture: &nodePQFixture{policy: policy}}
	buildNodePQCapturedBox(t, f.nodePQFixture, func(ctx context.Context) (context.Context, error) {
		admit := func(ctx context.Context, prepared routervpndesktoppt.NodePhysicalPrepared) error {
			if f.network == nil || f.tun == nil || f.network.SocketCurrent() || f.network.Current() || f.tun.ready.Load() || f.admitted != 0 {
				return errors.New("PQ native handoff was late, missing or repeated")
			}
			target := mobiletor.DesktopWindowsProtectionTarget{Capture: prepared.Capture, Policy: prepared.Policy, BaselineSHA256: prepared.BaselineSHA256}
			if err := mobiletor.DesktopWindowsNodeCompositionVerifyPrepared(ctx, target); err != nil {
				return err
			}
			f.prepared, f.admitted = target, 1
			return nil
		}
		if predecessor == nil {
			return routervpndesktoppt.WithNodePhysicalAdmission(ctx, policy, admit)
		}
		return routervpndesktoppt.WithNodePhysicalSuccessorAdmission(ctx, policy, *predecessor, admit)
	}, nil)
	if prepare {
		if err := f.box.RouterVPNDesktopNodePreparePhysical(policy); err != nil {
			t.Fatal("actual sealed Windows PQ factory preparation", err)
		}
	}
	outer, found := f.box.Outbound().Outbound("proxy")
	if !found {
		t.Fatal("native PQ Box omitted its actual endpoint")
	}
	f.endpoint, _ = outer.(*Endpoint)
	if f.endpoint == nil || f.endpoint.owner.Ready() || f.endpoint.owner.TransportReady() {
		t.Fatal("native PQ Box fabricated readiness or substituted its runtime")
	}
	return f
}
func nodePQWFPCleanup(t *testing.T, target *mobiletor.DesktopWindowsProtectionTarget) {
	t.Helper()
