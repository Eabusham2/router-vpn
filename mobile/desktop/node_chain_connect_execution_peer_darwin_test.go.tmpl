package routervpnamnezia

import (
	"errors"
	"net/netip"
)

// The original Darwin same-host adapter remains independently closed.
func connectExecutionPhysicalPeer(local, remote netip.Addr) error {
	if local != remote {
		return errors.New("Darwin fixture requires captured same-host physical peer")
	}
	return nil
}
