// This component executes the original installed-provider harness with an
// explicit loopback address. It grants no native physical/interface/PF proof.
func TestRouterVPNDesktopInstalledSSHysteriaLoopbackReference(t *testing.T) {
	const child = "ROUTERVPN_SS_HYSTERIA_COMPONENT_CHILD"
	if os.Getenv(child) == "1" {
		desktopExternalInstalledSSEntry = func(t *testing.T, parent *desktopNodeLayerServer, request desktopExternalInstalledSSRequest, cert tls.Certificate, final, network string, finalPorts ...uint16) desktopExternalInstalledSSPeer {
			return desktopStartSSEntryAt(t, parent, request, cert, final, network, netip.MustParseAddr("127.0.0.1"), finalPorts...)
		}
		desktopExternalInstalledReferenceProcess(t, "127.0.0.1", map[string]bool{"hysteria2": true}, true)
		return
	}
	methods := []string{"2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305"}
	for i, method := range methods {
		for _, protocol := range []string{"hysteria2"} {
			t.Run(fmt.Sprintf("method%d-%s", i, protocol), func(t *testing.T) { desktopSSHysteriaReference(t, child, method, protocol, "") })
		}
	}
	for _, fault := range []string{"entry-key", "entry-method", "password", "server-name", "trust", "final-route", "dns-route"} {
		t.Run("negative/"+fault, func(t *testing.T) { desktopSSHysteriaReference(t, child, methods[1], "hysteria2", fault) })
	}
}
func desktopSSHysteriaReference(t *testing.T, child, method, protocol, fault string, layers ...string) {
	t.Helper()
	entryMode, finalMode := "", ""
	if len(layers) != 0 {
		if len(layers) != 2 {
			t.Fatal("incomplete independent layer capture")
		}
		entryMode, finalMode = layers[0], layers[1]
	}
	entryLayerKey, finalLayerKey := desktopSSReferenceKey("2022-blake3-aes-256-gcm", 'a'), desktopSSReferenceKey("2022-blake3-aes-256-gcm", 'b')
	finalVirtual := "198.51.100.240:8388"
	if finalMode == "aes-256-gcm+xor-whitening" {
		finalVirtual = "198.51.100.240:8389"
	}
	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()
	image, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	command := exec.CommandContext(ctx, image, "-test.run=^TestRouterVPNDesktopInstalledSSHysteriaLoopbackReference$", "-test.count=1", "-test.timeout=14s")
	command.Env = append(os.Environ(), child+"=1")
	input, err := command.StdinPipe()
	if err != nil {
		t.Fatal(err)
	}
	output, err := command.StdoutPipe()
	if err != nil {
		t.Fatal(err)
	}
	var diagnostic bytes.Buffer
	command.Stderr = &diagnostic
	if err = command.Start(); err != nil {
		t.Fatal(err)
	}
	reader := STD.NewReaderSize(output, 16385)
	joined := false
	defer func() {
		_ = input.Close()
		if !joined {
			_, _ = io.Copy(io.Discard, reader)
			e := command.Wait()
			if e != nil {
				t.Error("original HY2 provider join", e, diagnostic.String())
			}
		}
	}()
	entryPassword, finalPassword := desktopSSReferenceKey(method, 'i'), desktopSSReferenceKey("2022-blake3-aes-256-gcm", 'f')
	request := desktopExternalInstalledPeerRequest{Schema: 1, Protocol: protocol, Address: "127.0.0.1", Password: finalPassword, ShadowsocksEntry: &desktopExternalInstalledSSRequest{Method: method, Password: entryPassword}}
	if entryMode != "" {
		request.SSEntryLayer = &desktopExternalInstalledLayerRequest{Mode: entryMode, Password: entryLayerKey}
	}
	if finalMode != "" {
		request.SSFinalLayer = &desktopExternalInstalledLayerRequest{Mode: finalMode, Password: finalLayerKey}
	}
	for _, item := range []struct {
		role    string
		request *desktopExternalInstalledLayerRequest
	}{{"entry", request.SSEntryLayer}, {"final", request.SSFinalLayer}} {
		if item.request == nil {
			continue
		}
		if fault == item.role+"-layer-key" {
			item.request.Fault = "layer-key"
		}
		if fault == item.role+"-whitening" {
			item.request.Fault = "whitening"
		}
	}
	if err = json.NewEncoder(input).Encode(request); err != nil {
		t.Fatal(err)
	}
	read := func() desktopExternalInstalledPeerReply {
		raw, e := reader.ReadSlice('\n')
		if e != nil || len(raw) > 16384 {
			t.Fatal("HY2 original provider readiness", e)
		}
		var reply desktopExternalInstalledPeerReply
		if e = json.Unmarshal(raw, &reply); e != nil || reply.Schema != 1 || reply.Protocol != protocol || reply.Address != finalVirtual || reply.ShadowsocksEntry == nil || reply.ShadowsocksEntry.Method != method || reply.CA == "" {
			t.Fatal("HY2 provider changed captured readiness", e)
		}
		a, e := netip.ParseAddrPort(reply.ShadowsocksEntry.Address)
		if e != nil || !a.Addr().IsLoopback() || a.Port() == 0 {
			t.Fatal("HY2 component lost original SS listener", e)
		}
		if (reply.SSEntryLayer != nil) != (entryMode != "") || (reply.SSFinalLayer != nil) != (finalMode != "") {
			t.Fatal("HY2 layer receipt substituted owner")
		}
		if reply.SSFinalLayer != nil && (reply.SSFinalLayer.PhysicalTCP != 0 || reply.SSFinalLayer.Streams != 0) {
			t.Fatal("HY2 final wrapper acquired TCP transport")
		}
		return reply
	}
	first := read()
	outerAddress := first.ShadowsocksEntry.Address
	outerPort := uint16(8388)
	if entryMode != "" {
		outerAddress = first.SSEntryLayer.Address
		if entryMode == "aes-256-gcm+xor-whitening" {
			outerPort = 8389
		}
	}
	lower := &desktopSSReferenceLower{virtual: netip.AddrPortFrom(netip.MustParseAddr("198.51.100.239"), outerPort).String(), original: outerAddress}
	manager := &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}}
	owned := service.ContextWith[adapter.OutboundManager](ctx, manager)
	entryHost, entryDetour, entryPort := "198.51.100.239", "captured-physical", uint16(8388)
	var layerClients []adapter.Outbound
	if entryMode != "" {
		firstOuter := desktopSSReferenceLayerClient(t, owned, "captured-entry-layer", "captured-physical", entryHost, outerPort, entryMode, entryLayerKey)
		layerClients = append(layerClients, firstOuter)
		manager.owners["captured-entry-layer"] = firstOuter
		entryHost, entryDetour, entryPort = "10.94.0.1", "captured-entry-layer", netip.MustParseAddrPort(first.ShadowsocksEntry.Address).Port()
	}
	selectedMethod := method
	if fault == "entry-key" {
		entryPassword = desktopSSReferenceKey(method, 'x')
	}
	if fault == "entry-method" {
		selectedMethod = "2022-blake3-chacha20-poly1305"
	}
	entry, err := SS.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), "captured-entry", option.ShadowsocksOutboundOptions{DialerOptions: option.DialerOptions{Detour: entryDetour}, ServerOptions: option.ServerOptions{Server: entryHost, ServerPort: entryPort}, Method: selectedMethod, Password: entryPassword})
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if e := entry.(io.Closer).Close(); e != nil {
			t.Error("original SS HY2 entry cleanup", e)
		}
	}()
	manager.owners["captured-entry"] = entry
	roots := x509.NewCertPool()
	if !roots.AppendCertsFromPEM([]byte(first.CA)) {
		t.Fatal("missing original reference CA")
	}
	prove := func(owner adapter.Outbound, want string) error {
		operation, stop := context.WithTimeout(ctx, time.Second)
		defer stop()
		c, e := owner.DialContext(operation, "tcp", M.ParseSocksaddr("1.1.1.1:443"))
		if e != nil {
			return e
		}
		defer c.Close()
		limit, _ := operation.Deadline()
		_ = c.SetDeadline(limit)
		secured := tls.Client(c, &tls.Config{RootCAs: roots, ServerName: "1.1.1.1", MinVersion: tls.VersionTLS12})
		defer secured.Close()
		if e = secured.HandshakeContext(operation); e != nil {
			return e
		}
		q, _ := http.NewRequestWithContext(operation, http.MethodGet, "https://1.1.1.1/cdn-cgi/trace?routervpn_proof="+strings.Repeat("ab", 16), nil)
		if e = q.Write(secured); e != nil {
			return e
		}
		answer, e := http.ReadResponse(STD.NewReader(secured), q)
		if e != nil {
			return e
		}
		defer answer.Body.Close()
		body, e := io.ReadAll(io.LimitReader(answer.Body, 1024))
		if e != nil {
			return e
		}
		if answer.StatusCode != 200 || string(body) != "ip="+want+"\n" {
			return fmt.Errorf("original public proof mismatch: %d %q", answer.StatusCode, body)
		}
		return nil
	}
	entryErr := prove(entry, "203.0.113.77")
	badOuterEntry := fault == "entry-layer-key" || fault == "entry-whitening"
	badEntry := fault == "entry-key" || fault == "entry-method" || badOuterEntry
	if (entryErr != nil) != badEntry {
		t.Fatal("original encrypted entry proof mismatch", fault, entryErr)
	}
	options := option.Hysteria2OutboundOptions{DialerOptions: option.DialerOptions{Detour: "captured-entry"}, ServerOptions: option.ServerOptions{Server: "198.51.100.240", ServerPort: 8388}, Password: finalPassword}
	if finalMode != "" {
		lastOuter := desktopSSReferenceLayerClient(t, owned, "captured-final-layer", "captured-entry", "198.51.100.240", netip.MustParseAddrPort(finalVirtual).Port(), finalMode, finalLayerKey)
		layerClients = append(layerClients, lastOuter)
		manager.owners["captured-final-layer"] = lastOuter
		options.Detour, options.Server = "captured-final-layer", "10.93.0.1"
	}
	if protocol == "hysteria2" {
		options.TLS = &option.OutboundTLSOptions{Enabled: true, ServerName: "captured-external.example", Certificate: []string{first.CA}}
	}
	switch fault {
	case "password":
		options.Password += "wrong"
	case "server-name":
		options.TLS.ServerName = "wrong-final.example"
	case "trust":
		_, ca := desktopExternalInstalledPeerCertificate(t, false)
		options.TLS.Certificate = []string{ca}
	case "final-route":
		options.Server = "198.51.100.241"
		if finalMode != "" {
			options.Server = "10.93.0.2"
		}
	}
	final, err := HY.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), "captured-final", options)
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if e := final.(io.Closer).Close(); e != nil {
			t.Error("original HY2 client close", e)
		}
	}()
	if !badEntry {
		operation, stop := context.WithTimeout(ctx, time.Second)
		destination := "203.0.113.53:5353"
		if fault == "dns-route" {
			destination = "203.0.113.52:5353"
		}
		c, e := final.DialContext(operation, "udp", M.ParseSocksaddr(destination))
		if e == nil {
			deadline, _ := operation.Deadline()
			_ = c.SetDeadline(deadline)
			dnsConn := &dns.Conn{Conn: c}
			query := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
			e = dnsConn.WriteMsg(query)
			if e == nil {
				var answer *dns.Msg
				answer, e = dnsConn.ReadMsg()
				if e == nil && (answer.Rcode != dns.RcodeSuccess || len(answer.Answer) != 1 || answer.Answer[0].(*dns.A).A.String() != "93.184.216.34") {
					e = fmt.Errorf("selected DNS response mismatch")
				}
			}
			_ = c.Close()
		}
		stop()
		if fault == "trust" || fault == "server-name" {
			// The pinned quic-go converts its local certificate verifier error
			// to TransportError(INTERNAL_ERROR), retaining the verifier message
			// but not the x509 error chain or a remote TLS alert.
			var transport *QUIC.TransportError
			wanted := "tls: failed to verify certificate: x509: certificate is valid for captured-external.example, speed.cloudflare.com, not wrong-final.example"
			matched := errors.As(e, &transport) && !transport.Remote && transport.ErrorCode == QUIC.InternalError
			if matched && fault == "server-name" {
				matched = transport.ErrorMessage == wanted
			}
			if matched && fault == "trust" {
				matched = strings.HasPrefix(transport.ErrorMessage, "tls: failed to verify certificate: x509: certificate signed by unknown authority")
			}
			if !matched {
				t.Fatalf("HY2 did not report original local certificate verification failure: %T %v", e, e)
			}
		}
		if (e != nil) != (fault != "") {
			t.Fatal("HY2 DNS/credential boundary mismatch", fault, e)
		}
		if fault == "" {
			if e = prove(final, "203.0.113.88"); e != nil {
				t.Fatal("HY2 final public proof", e)
			}
		}
	}
	if _, err = io.WriteString(input, "stats\n"); err != nil {
		t.Fatal(err)
	}
	observed := read()
	// Observe the original SS AEAD rejection without starting another request.
	// TLS failures above retain the actual local QUIC certificate verifier error.
	if badEntry {
		tick := time.NewTicker(10 * time.Millisecond)
		defer tick.Stop()
		for (badOuterEntry && observed.SSEntryLayer.AuthTCP == 0) || (!badOuterEntry && observed.ShadowsocksEntry.AuthTCP == 0) {
			select {
			case <-ctx.Done():
				t.Fatal("original HY2 rejection had no actual authentication witness", fault, ctx.Err())
			case <-tick.C:
				if _, err = io.WriteString(input, "stats\n"); err != nil {
					t.Fatal(err)
				}
				observed = read()
			}
		}
	}
	if !badOuterEntry && observed.ShadowsocksEntry.PhysicalTCP < 1 {
		t.Fatal("missing encrypted entry proof transport")
	}
	if badOuterEntry {
		if observed.SSEntryLayer.AuthTCP == 0 || observed.SSEntryLayer.Streams != 0 || observed.ShadowsocksEntry.PhysicalTCP != 0 || observed.ShadowsocksEntry.PhysicalUDP != 0 || observed.PhysicalUDP != 0 || observed.DNSQueries != 0 || observed.PublicReplies != 0 {
			t.Fatal("failed entry wrapper reached HY2 or entry proof", observed)
		}
	} else if badEntry {
		if observed.ShadowsocksEntry.AuthTCP == 0 || observed.ShadowsocksEntry.PublicReplies != 0 || observed.PhysicalUDP != 0 || observed.DNSQueries != 0 {
			t.Fatal("bad entry reached HY2", observed)
		}
	} else {
		if observed.ShadowsocksEntry.PublicReplies != 1 || observed.ShadowsocksEntry.PhysicalUDP == 0 {
			t.Fatal("HY2 omitted independent SS entry proof or UDP", observed)
		}
		if fault == "" {
			if observed.PhysicalUDP == 0 || observed.Packets == 0 || observed.DNSQueries != 1 || observed.PublicReplies != 1 || observed.AuthFailures != 0 || observed.TLSCertificateRefusals != 0 {
				t.Fatal("HY2 bypassed independent final DNS/proof", observed)
			}
		} else if observed.DNSQueries != 0 || observed.PublicReplies != 0 {
			t.Fatal("rejected HY2 reached final proof", observed)
		}
		if fault == "password" && observed.AuthFailures == 0 {
			t.Fatal("wrong HY2 password lacked authenticated server rejection", observed)
		}
		if (fault == "trust" || fault == "server-name") && observed.PhysicalUDP == 0 {
			t.Fatal("wrong HY2 trust never reached independent QUIC provider", observed)
		}
		if fault == "final-route" && observed.PhysicalUDP != 0 {
			t.Fatal("foreign final tuple reached HY2", observed)
		}
	}
	if fault == "" {
		if first.SSEntryLayer != nil {
			r := observed.SSEntryLayer
			if r.PhysicalTCP == 0 || r.PhysicalUDP == 0 || r.Streams == 0 || r.Packets == 0 || r.AuthTCP != 0 || r.AuthUDP != 0 {
				t.Fatal("entry wrapper missed independently encrypted transports", r)
			}
		}
		if first.SSFinalLayer != nil {
			r := observed.SSFinalLayer
			if r.PhysicalUDP == 0 || r.Packets == 0 || r.PhysicalTCP != 0 || r.Streams != 0 || r.AuthUDP != 0 {
				t.Fatal("HY2 wrapper is not independently authenticated UDP-only", r)
			}
		}
	}
	if fault == "final-layer-key" || fault == "final-whitening" {
		r := observed.SSFinalLayer
		if r == nil || r.AuthUDP == 0 || r.Packets != 0 || observed.PhysicalUDP != 0 {
			t.Fatal("failed final wrapper reached original QUIC", observed)
		}
	}
	if err = final.(io.Closer).Close(); err != nil {
		t.Fatal("original HY2 client join", err)
	}

	for _, layer := range layerClients {
		if err := layer.(io.Closer).Close(); err != nil {
			t.Fatal("original layer client join", err)
		}
	}

	_ = input.Close()
	_, _ = io.Copy(io.Discard, reader)
	err = command.Wait()
	joined = true
	if err != nil || ctx.Err() != nil {
		t.Fatal("HY2 provider did not join original workers", err, ctx.Err(), diagnostic.String())
	}
}

func TestRouterVPNDesktopSSHysteriaIndependentLayersReference(t *testing.T) {
	modes := []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"}
	methods := []string{"2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305"}
	for methodIndex, method := range methods {
		for a, entry := range modes {
			for b, final := range modes {
				t.Run(fmt.Sprintf("method%d/layer%d-layer%d", methodIndex, a, b), func(t *testing.T) {
					desktopSSHysteriaReference(t, "ROUTERVPN_SS_HYSTERIA_COMPONENT_CHILD", method, "hysteria2", "", entry, final)
				})
			}
		}
	}
	for _, fault := range []string{"entry-key", "entry-method", "password", "server-name", "trust", "final-route", "dns-route", "entry-layer-key", "final-layer-key", "entry-whitening", "final-whitening"} {
		t.Run("negative/"+fault, func(t *testing.T) {
			desktopSSHysteriaReference(t, "ROUTERVPN_SS_HYSTERIA_COMPONENT_CHILD", methods[1], "hysteria2", fault, modes[2], modes[2])
		})
	}
}
