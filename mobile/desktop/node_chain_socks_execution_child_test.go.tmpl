func desktopSOCKSExecutionCommandProjection(t *testing.T, prep *mobilemultihop.NodeChainExecutionPreparation) *mobilemultihop.NodeChainExecutionProjection {
	t.Helper()
	var local mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(prep.LocalSource()), &local) != nil {
		t.Fatal("original SOCKS input missing")
	}
	original, err := prep.OriginalSOCKSSource()
	if err != nil {
		t.Fatal(err)
	}
	_, meta, err := original.ReadValidated()
	if err != nil {
		t.Fatal(err)
	}
	server, err := mobilemultihop.NewNodeChainSOCKSServerPolicy(desktopExecutionJSON(t, mobilemultihop.NodeChainServerSource{
		Schema: 3, EntryID: meta.Proofs[0].ProfileID, EntryNodeID: meta.Proofs[0].NodeID, EntryMode: meta.Proofs[0].Mode,
		Nodes: local.Nodes[1:], IdentitySources: local.IdentitySources[1:],
	}))
	if err != nil {
		t.Fatal(err)
	}
	var entry struct {
		Mode      string `json:"mode"`
		Files     string `json:"files"`
		Profile   string `json:"profile_json"`
		Start     string `json:"start"`
		Bootstrap string `json:"dns_bootstrap"`
	}
	if json.Unmarshal([]byte(local.Nodes[0]), &entry) != nil {
		t.Fatal("original packet entry missing")
	}
	node, err := mobilemultihop.NewNodeProfile(entry.Mode, entry.Files, entry.Profile, entry.Start, entry.Bootstrap)
	if err != nil {
		t.Fatal(err)
	}
	key, err := node.PacketClientPublicKey()
	if err != nil {
		t.Fatal(err)
	}
	descriptor := server.Descriptor()
	digest, err := descriptor.Digest()
	if err != nil {
		t.Fatal(err)
	}
	request := multihoprelay.NodeChainRequest{Schema: 3, SessionID: strings.Repeat("1", 32), EntryNodeID: descriptor.EntryNodeID, SourceSHA256: descriptor.SourceSHA256, DescriptorSHA256: digest, DNSPolicySHA256: descriptor.DNSPolicySHA256, Epoch: strings.Repeat("2", 64), Peer: "10.77.0.2", AcquireExpiresAt: time.Now().Add(time.Minute).Unix(), Port: 32000, LocalPacketPublicKeys: []string{key}, LocalPacketPositions: []int{0}}
	for i := range descriptor.Members {
		request.Users = append(request.Users, multihoprelay.NodeChainUser{Position: i + 1, Username: strings.Repeat(fmt.Sprintf("%x", 3+i*2), 48), Password: strings.Repeat(fmt.Sprintf("%x", 4+i*2), 48)})
	}
	if err := request.Validate(descriptor); err != nil {
		t.Fatal("typed request fixture", err)
	}
	source := mobilemultihop.NodeChainExecutionSource{Schema: 3, Execution: prep.Execution(), LocalSource: prep.LocalSource(), Server: descriptor, Request: request, FirstPort: 32000, LastPort: 32000}
	policy, err := mobilemultihop.NewNodeChainSOCKSExecutionPolicy(prep, desktopExecutionJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	projection, err := prep.BindExecution(policy)
	if err != nil {
		t.Fatal(err)
	}
	return projection
}

// The original child and complete source/compiler execute. Native proof, TUN
// readback and the installed parent are explicit doubles in this component.
type desktopSOCKSExecutionChildProof struct{ *desktopExecutionProofFixture }

func (p *desktopSOCKSExecutionChildProof) CaptureSOCKSDesktopLastContext(ctx context.Context) (mobilemultihop.NodeChainExecutionLast, error) {
	return p.CaptureLastContext(ctx)
}

func newDesktopSOCKSExecutionChildFixture(t *testing.T, prep *mobilemultihop.NodeChainExecutionPreparation, projection *mobilemultihop.NodeChainExecutionProjection) *desktopExecutionRuntimeFixture {
	t.Helper()
	f := newDesktopExecutionRuntimeFixtureFromProjection(t, prep, projection)
	f.record.MTU = 1400
	f.engine.readback.MTU = 1400
	f.owner.proof = func(p *mobilemultihop.NodeChainExecutionProjection, e routerVPNDesktopExecutionEngine) (routerVPNDesktopExecutionProof, error) {
		if p != projection || e != f.engine {
			t.Fatal("SOCKS child replaced original proof capture")
		}
		return &desktopSOCKSExecutionChildProof{f.proof}, nil
	}
	return f
}

func TestRouterVPNDesktopSOCKSExecutionChildCommand(t *testing.T) {
	for _, target := range []string{"linux", "windows", "darwin"} {
		for _, setting := range []string{"server", "auto"} {
			t.Run(target+"/"+setting, func(t *testing.T) {
				prep := desktopSOCKSExecutionCommandPreparation(t, target, setting)
				physical, err := prep.SOCKSDesktopPhysicalPolicy()
				if err != nil {
					t.Fatal(err)
				}
				_, meta, _, err := physical.PhysicalReadValidated()
				if err != nil {
					t.Fatal(err)
				}
				files := desktopImportedCommandFiles(t, map[string]string{"node-chain-execution-source.json": prep.Source(), "sing-box.json": prep.Config()})
				actual, err := routerVPNNodeChainExecutionCommandCapture(files, meta.SessionID, meta.ConfigSHA256, meta.SourceSHA256, prep.SourceSHA256(), target)
				if err != nil || actual == nil || actual == prep || actual.Source() != prep.Source() || actual.Config() != prep.Config() || !actual.RequiresSOCKSExecutionObserver() {
					t.Fatal("typed SOCKS execution command lost original capture", err)
				}
				if _, err := actual.DesktopPhysicalPolicy(); err == nil {
					t.Fatal("SOCKS command borrowed paired authority")
				}
				if _, err := actual.CONNECTDesktopPhysicalPolicy(); err == nil {
					t.Fatal("SOCKS command borrowed CONNECT authority")
				}
			})
		}
	}
}

func TestRouterVPNDesktopSOCKSExecutionChildCommandRefusesSubstitution(t *testing.T) {
	prep := desktopSOCKSExecutionCommandPreparation(t, "linux", "auto")
	physical, _ := prep.SOCKSDesktopPhysicalPolicy()
	_, meta, _, err := physical.PhysicalReadValidated()
	if err != nil {
		t.Fatal(err)
	}
	for _, fault := range []string{"generic", "connect", "local", "duplicate-schema", "wrong-schema", "noncanonical-schema", "paired-source", "socks-source", "connect-source", "config", "source-digest", "physical-digest", "target"} {
		t.Run(fault, func(t *testing.T) {
			input, config, source, physicalSource, target := prep.Source(), prep.Config(), prep.SourceSHA256(), meta.SourceSHA256, "linux"
			extra := map[string]string{}
			switch fault {
			case "generic":
				other, _ := desktopExecutionCommandSource(t, "linux", "auto")
				input = other.Source()
			case "connect":
				input = desktopCONNECTExecutionCommandPreparation(t, "linux", "auto").Source()
			case "local":
				original, _ := physical.OriginalDesktopSOCKSPolicy()
				input, _ = original.LaunchInput()
			case "duplicate-schema":
				input = strings.Replace(input, "{", "{\"schema\":3,", 1)
			case "wrong-schema":
				input = strings.Replace(input, "\"schema\":3", "\"schema\":4", 1)
			case "noncanonical-schema":
				input = strings.Replace(input, "\"schema\":3", "\"schema\":3.0", 1)
			case "paired-source":
				extra["node-chain-source.json"] = "{}"
			case "socks-source":
				extra["node-chain-socks-source.json"] = "{}"
			case "connect-source":
				extra["node-chain-connect-source.json"] = "{}"
			case "config":
				config += "\n"
			case "source-digest":
				source = strings.Repeat("e", 64)
			case "physical-digest":
				physicalSource = strings.Repeat("e", 64)
			case "target":
				target = "windows"
			}
			extra["node-chain-execution-source.json"], extra["sing-box.json"] = input, config
			files := desktopImportedCommandFiles(t, extra)
			if actual, err := routerVPNNodeChainExecutionCommandCapture(files, meta.SessionID, meta.ConfigSHA256, physicalSource, source, target); err == nil || actual != nil {
				t.Fatal("SOCKS execution command admitted substituted authority")
			}
		})
	}
}

func TestRouterVPNDesktopSOCKSExecutionChildPublication(t *testing.T) {
	for _, setting := range []string{"server", "auto"} {
		t.Run(setting, func(t *testing.T) {
			prep := desktopSOCKSExecutionCommandPreparation(t, "linux", setting)
			f := newDesktopSOCKSExecutionChildFixture(t, prep, desktopSOCKSExecutionCommandProjection(t, prep))
			ctx, cancel := context.WithCancel(context.Background())
			if err := f.owner.run(ctx); err != nil {
				cancel()
				t.Fatal(err)
			}
			cancel()
			if f.owner.current(context.Background()) != nil || f.proof.lifetime.Err() != nil {
				t.Fatal("SOCKS startup context replaced retained child lifetime")
			}
			raw, err := f.owner.files.read("node-chain-execution-adoption.json", mobilemultihop.DesktopNodeChainSOCKSExecutionAdoptionRecordLimit)
			if err != nil {
				t.Fatal(err)
			}
			parent, err := mobilemultihop.ParseDesktopNodeChainSOCKSExecutionPreparation(prep.Source())
			if err != nil {
				t.Fatal(err)
			}
			projection, identity, err := mobilemultihop.ParseDesktopNodeChainSOCKSExecutionAdoptionRecord(raw, parent, f.owner.transfer)
			if err != nil || identity != f.engine.identity {
				t.Fatal("SOCKS child did not publish original typed adoption", err)
			}
			if err := f.owner.heartbeat(context.Background(), f.record); err != nil {
				t.Fatal(err)
			}
			raw, err = f.owner.files.read("node-chain-execution-ready.json", mobilemultihop.DesktopNodeChainSOCKSExecutionReadyRecordLimit)
			if err != nil {
				t.Fatal(err)
			}
			ready, err := mobilemultihop.ParseDesktopNodeChainSOCKSExecutionAdoptedReadyRecord(raw, projection, identity, f.owner.transfer)
			if err != nil || ready.SelectionEpoch != 7 || ready.Reader != 1 {
				t.Fatal("SOCKS child lost selected proof and reader heartbeat", err)
			}
			if _, err := mobilemultihop.ParseDesktopNodeChainExecutionReadyRecord(raw, projection, f.owner.transfer); err == nil {
				t.Fatal("SOCKS heartbeat acquired generic authority")
			}
			if err := f.owner.close(context.Background()); err != nil {
				t.Fatal(err)
			}
			if strings.Join(f.events, ",") != "discover,adopt,prove,join,retire" {
				t.Fatal("SOCKS child retired before joining its proof", f.events)
			}
			for _, name := range []string{"node-chain-execution-adoption.json", "node-chain-execution-ready.json", "node-chain-execution-last.json"} {
				if _, err := f.owner.files.root.Lstat(name); !errors.Is(err, os.ErrNotExist) {
					t.Fatal("retired SOCKS child retained public output", name, err)
				}
			}
		})
	}
}

func TestRouterVPNDesktopSOCKSExecutionChildSavedChoice(t *testing.T) {
	for _, winner := range []string{"local", "server"} {
		t.Run(winner, func(t *testing.T) {
			originalPrep := desktopSOCKSExecutionCommandPreparation(t, "linux", "auto")
			originalProjection := desktopSOCKSExecutionCommandProjection(t, originalPrep)
			target := mobilemultihop.Targets[1]
			last := desktopExecutionSavedChoice(t, originalPrep, originalProjection, winner, target)
			physical, _ := originalPrep.SOCKSDesktopPhysicalPolicy()
			original, _ := physical.OriginalDesktopSOCKSPolicy()
			prep, err := mobilemultihop.NewDesktopNodeChainSOCKSExecutionLastPreparation(original, "auto", last.JSON())
			if err != nil {
				t.Fatal(err)
			}
			projection := desktopSOCKSExecutionCommandProjection(t, prep)
			f := newDesktopSOCKSExecutionChildFixture(t, prep, projection)
			f.proof.last = last
			f.proof.progress.Execution = winner
			f.proof.progress.Comparison.Target = target
			choice := *f.proof.progress.Comparison.Winner
			choice.Execution = routechoice.Execution(winner)
			f.proof.progress.Comparison.Winner = &choice
			f.proof.progress.Comparison.Final.Candidate = choice
			f.proof.progress.Comparison.Measurements = nil
			f.owner.proof = func(*mobilemultihop.NodeChainExecutionProjection, routerVPNDesktopExecutionEngine) (routerVPNDesktopExecutionProof, error) {
				return nil, errors.New("SOCKS restoration reran Compare")
			}
			f.owner.lastProof = func(ctx context.Context, captured mobilemultihop.NodeChainExecutionLast, engine routerVPNDesktopExecutionEngine) (*mobilemultihop.NodeChainExecutionProjection, routerVPNDesktopExecutionProof, error) {
				if captured.JSON() != last.JSON() || engine != f.engine || ctx.Err() != nil {
					t.Fatal("SOCKS restore substituted saved choice")
				}
				f.events = append(f.events, "restore")
				return projection, &desktopSOCKSExecutionChildProof{f.proof}, nil
			}
			if err := f.owner.run(context.Background()); err != nil {
				t.Fatal(err)
			}
			if strings.Join(f.events, ",") != "discover,restore,prove" {
				t.Fatal("SOCKS restore reselected port or reran Compare", f.events)
			}
			raw, err := f.owner.files.read("node-chain-execution-last.json", 16<<10)
			if err != nil || string(raw) != last.JSON() {
				t.Fatal("SOCKS restore changed winner or target", err)
			}
			if err := f.owner.heartbeat(context.Background(), f.record); err != nil {
				t.Fatal(err)
			}
		})
	}
}

func TestRouterVPNDesktopSOCKSExecutionChildRejectsForeignOwner(t *testing.T) {
	for _, fault := range []string{"host", "preparation", "physical", "reader", "mtu", "selected-proof", "proof-kind"} {
		t.Run(fault, func(t *testing.T) {
			prep := desktopSOCKSExecutionCommandPreparation(t, "linux", "auto")
			f := newDesktopSOCKSExecutionChildFixture(t, prep, desktopSOCKSExecutionCommandProjection(t, prep))
			if fault == "proof-kind" {
				f.owner.proof = func(*mobilemultihop.NodeChainExecutionProjection, routerVPNDesktopExecutionEngine) (routerVPNDesktopExecutionProof, error) {
					return f.proof, nil
				}
				if f.owner.run(context.Background()) == nil {
					t.Fatal("SOCKS child accepted ordinary Last publisher")
				}
				return
			}
			if err := f.owner.run(context.Background()); err != nil {
				t.Fatal(err)
			}
			switch fault {
			case "host":
				f.valid.Store(false)
			case "preparation":
				f.owner.prep, _ = mobilemultihop.ParseDesktopNodeChainSOCKSExecutionPreparation(prep.Source())
			case "physical":
				other, _ := mobilemultihop.ParseDesktopNodeChainSOCKSExecutionPreparation(prep.Source())
				f.owner.physical, _ = other.SOCKSDesktopPhysicalPolicy()
			case "reader":
				f.record.Reader++
			case "mtu":
				f.record.MTU++
			case "selected-proof":
				f.proof.progress.PublicProven = false
			}
			if f.owner.heartbeat(context.Background(), f.record) == nil {
				t.Fatal("SOCKS execution published a substituted owner or proof")
			}
		})
	}
}

func TestRouterVPNDesktopSOCKSExecutionChildRetainsFailedCleanup(t *testing.T) {
	for _, fault := range []string{"remote-join", "gate-retire"} {
		t.Run(fault, func(t *testing.T) {
			prep := desktopSOCKSExecutionCommandPreparation(t, "linux", "auto")
			f := newDesktopSOCKSExecutionChildFixture(t, prep, desktopSOCKSExecutionCommandProjection(t, prep))
			if err := f.owner.run(context.Background()); err != nil {
				t.Fatal(err)
			}
			if fault == "remote-join" {
				f.proof.closeErr = errors.New("pending original DELETE")
			} else {
				f.engine.retireErr = errors.New("pending original gate")
			}
			if f.owner.close(context.Background()) == nil || f.owner.closed.Load() {
				t.Fatal("unjoined owner allowed native teardown")
			}
			if fault == "remote-join" && strings.Contains(strings.Join(f.events, ","), "retire") {
				t.Fatal("native gate retired before remote join", f.events)
			}
			f.proof.closeErr = nil
			f.engine.retireErr = nil
			if err := f.owner.close(context.Background()); err != nil || !f.owner.closed.Load() {
				t.Fatal("original cleanup retry failed", err)
			}
		})
	}
}

func TestRouterVPNDesktopSOCKSExecutionChildJoinsLateConstructor(t *testing.T) {
	prep := desktopSOCKSExecutionCommandPreparation(t, "linux", "auto")
	f := newDesktopSOCKSExecutionChildFixture(t, prep, desktopSOCKSExecutionCommandProjection(t, prep))
	original := f.owner.factory
	entered, release := make(chan struct{}), make(chan struct{})
	f.owner.factory = func(ctx context.Context, p *mobilemultihop.NodeChainExecutionPreparation, s string, current func(context.Context) error) (routerVPNDesktopExecutionEngine, error) {
		close(entered)
		<-release
		engine, _ := original(context.Background(), p, s, current)
		return engine, errors.New("late native constructor")
	}
	done := make(chan error, 1)
	go func() { done <- f.owner.run(context.Background()) }()
	<-entered
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	if f.owner.close(ctx) == nil || f.owner.closed.Load() {
		t.Fatal("canceled cleanup abandoned entered native factory")
	}
	close(release)
	if err := <-done; err == nil {
		t.Fatal("late constructor succeeded")
	}
	if f.owner.state.Load().engine.Load() == nil {
		t.Fatal("partial native owner discarded")
	}
	if _, err := f.owner.files.root.Lstat("node-chain-execution-adoption.json"); !errors.Is(err, os.ErrNotExist) {
		t.Fatal("late canceled constructor published adoption", err)
	}
	if err := f.owner.close(context.Background()); err != nil || strings.Join(f.events, ",") != "retire" {
		t.Fatal("original late engine was not retired", err, f.events)
	}
}
