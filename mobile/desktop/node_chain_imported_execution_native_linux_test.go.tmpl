// The Local entry retains the original controller/provider physical pair.
// Server workers live in a third namespace. Their first original suffix tuple
// crosses its own non-loopback veth; no portable-carrier exemption is used.
type nativeImportedRequest struct {
	Schema            int                             `json:"schema"`
	Peer              desktopNodeChainImportedRequest `json:"peer"`
	ServerPrivateKeys []string                        `json:"server_private_keys"`
	Image             string                          `json:"image"`
	ImageSHA          string                          `json:"image_sha256"`
	Fault             string                          `json:"fault"`
}

func nativeImportedRequestValid(r nativeImportedRequest) error {
	bad := errors.New("native imported execution requires complete original independent packet identities")
	n := len(r.Peer.Paired.Prefixes)
	if r.Schema != 1 || r.Peer.Schema != 2 || n < 1 || n > 6 || len(r.ServerPrivateKeys) != n+2 {
		return bad
	}
	if _, err := desktopNodeChainPeerIdentityBounds(r.Peer.Paired, 1, 6); err != nil {
		return bad
	}
	last := r.Peer
	last.Schema = 1
	last.Paired.Prefixes = last.Paired.Prefixes[n-1:]
	if desktopNodeChainImportedRequestValid(last) != nil {
		return bad
	}
	seen := map[string]bool{}
	for _, p := range r.Peer.Paired.Prefixes {
		seen[p.PrivateKey] = true
		seen[p.ClientPublicKey] = true
		seen[p.PreSharedKey] = true
	}
	for position, value := range r.ServerPrivateKeys {
		if position == 0 || position == n {
			if value != "" {
				return bad
			}
			continue
		}
		raw, err := base64.StdEncoding.Strict().DecodeString(value)
		if err != nil || len(raw) != 32 || base64.StdEncoding.EncodeToString(raw) != value || bytes.Equal(raw, make([]byte, 32)) || seen[value] {
			return bad
		}
		key, err := ecdh.X25519().NewPrivateKey(raw)
		clear(raw)
		if err != nil {
			return bad
		}
		public := base64.StdEncoding.EncodeToString(key.PublicKey().Bytes())
		if seen[public] {
			return bad
		}
		seen[value], seen[public] = true, true
	}
	switch r.Fault {
	case "", "wrong-first-key", "wrong-later-key", "wrong-middle-key", "wrong-final-key", "wrong-public", "failed-dns", "replaced-source", "carrier-change", "held-cleanup":
	default:
		return bad
	}
	return nil
}

// Independently pair the same captured nodes before compiling their Server
// source. Only the generated client keys differ. All endpoints, private APIs,
// DNS, import credentials and original profile bytes remain captured.
func nativeImportedServerSource(local string, r nativeImportedRequest) (*mobilemultihop.NodeChainServerPolicy, error) {
	bad := errors.New("native Server pairing lost original source or independent client key")
	if nativeImportedRequestValid(r) != nil {
		return nil, bad
	}
	chain, err := mobilemultihop.NewNodeChain(local)
	if err != nil {
		return nil, err
	}
	var original mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(local), &original) != nil || original.Schema != 2 || len(original.Nodes) != len(r.Peer.Paired.Prefixes)+2 || len(original.IdentitySources) != len(original.Nodes) {
		return nil, bad
	}
	proofs := chain.ProofInventory()
	n := len(r.Peer.Paired.Prefixes)
	if len(proofs) != n+2 || proofs[0].NodeID != r.Peer.Paired.Prefixes[0].NodeProofID || proofs[n+1].NodeID != r.Peer.Paired.FinalNodeProofID {
		return nil, bad
	}
	for i, prefix := range r.Peer.Paired.Prefixes {
		node, err := mobilemultihop.ParseNodeLaunchInput(original.Nodes[i])
		if err != nil || proofs[i].NodeID != prefix.NodeProofID {
			return nil, bad
		}
		key, err := node.PacketClientPublicKey()
		if err != nil || key != prefix.ClientPublicKey {
			return nil, bad
		}
	}
	var imported struct {
		Capture string `json:"capture"`
	}
	var selected struct {
		ExpectedPublicIP string `json:"expected_public_ip"`
		Profile          struct {
			External struct {
				Shadowsocks struct {
					Server   string `json:"server"`
					Port     int    `json:"port"`
					Method   string `json:"method"`
					Password string `json:"password"`
				} `json:"shadowsocks"`
			} `json:"external"`
		} `json:"profile"`
	}
	if json.Unmarshal([]byte(original.Nodes[n]), &imported) != nil || json.Unmarshal([]byte(imported.Capture), &selected) != nil {
		return nil, bad
	}
	ss := selected.Profile.External.Shadowsocks
	if selected.ExpectedPublicIP != "203.0.113.88" || ss.Server != "10.79.0.1" || ss.Port != 8388 || ss.Method != r.Peer.MiddleMethod || ss.Password != r.Peer.MiddlePassword {
		return nil, bad
	}
	source := mobilemultihop.NodeChainServerSource{Schema: 2, EntryID: proofs[0].ProfileID, EntryNodeID: proofs[0].NodeID, EntryMode: proofs[0].Mode}
	replace := func(value, key string) (string, error) {
		var files map[string][]byte
		if json.Unmarshal([]byte(value), &files) != nil || len(files) == 0 {
			return "", bad
		}
		changed := 0
		for name, data := range files {
			if !strings.HasSuffix(name, ".conf") {
				continue
			}
			lines := strings.Split(string(data), "\n")
			for i, line := range lines {
				if strings.HasPrefix(strings.TrimSpace(line), "PrivateKey=") {
					lines[i] = "PrivateKey=" + key
					changed++
				}
			}
			files[name] = []byte(strings.Join(lines, "\n"))
		}
		if changed != 1 {
			return "", bad
		}
		raw, err := json.Marshal(files)
		return string(raw), err
	}
	for position := 1; position < len(original.Nodes); position++ {
		if position == n {
			source.Nodes = append(source.Nodes, original.Nodes[position])
			source.IdentitySources = append(source.IdentitySources, "")
			continue
		}
		var input struct {
			Mode    string `json:"mode"`
			Files   string `json:"files"`
			Profile string `json:"profile_json"`
			Start   string `json:"start"`
			DNS     string `json:"dns_bootstrap"`
		}
		if json.Unmarshal([]byte(original.Nodes[position]), &input) != nil {
			return nil, bad
		}
		key := r.ServerPrivateKeys[position]
		identity, err := replace(original.IdentitySources[position], key)
		if err != nil {
			return nil, err
		}
		files := input.Files
		if position < n {
			files, err = replace(files, key)
			if err != nil {
				return nil, err
			}
		}
		node, err := mobilemultihop.NewNodeProfile(input.Mode, files, input.Profile, input.Start, input.DNS)
		if err != nil {
			return nil, err
		}
		launch, err := node.LaunchInput()
		if err != nil {
			return nil, err
		}
		source.Nodes = append(source.Nodes, launch)
		source.IdentitySources = append(source.IdentitySources, identity)
	}
	raw, err := json.Marshal(source)
	if err != nil {
		return nil, err
	}
	policy, err := mobilemultihop.NewNodeChainServerPolicy(string(raw))
	clear(raw)
	if err != nil || policy.NativeCarrierRequired() != (n > 1) {
		return nil, errors.Join(bad, err)
	}
	inventory := policy.ProofInventory()
	if len(inventory) != n+1 {
		return nil, bad
	}
	for i, p := range inventory {
		if p.Position != i+1 || p.NodeID != proofs[i+1].NodeID || p.ProfileID != proofs[i+1].ProfileID || p.Kind != proofs[i+1].Kind {
			return nil, bad
		}
	}
	return policy, nil
}

type nativeImportedUDPBridge struct {
	listener *net.UDPConn
	remote   netip.Addr
	delay    *atomic.Int64
	packets  atomic.Uint64
	mu       sync.Mutex
	closing  bool
	clients  map[netip.AddrPort]*net.UDPConn
	workers  sync.WaitGroup
	stop     chan struct{}
}

// Every byte remains original encrypted transport. This fixture owns one exact
// listener/target pair and counts actual arrivals, never successful proofs.
func nativeImportedUDPStart(t *testing.T, address, target string, remote netip.Addr, delay *atomic.Int64) *nativeImportedUDPBridge {
	t.Helper()
	listener, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.MustParseAddrPort(address)))
	if err != nil {
		t.Fatal(err)
	}
	destination, err := net.ResolveUDPAddr("udp4", target)
	if err != nil {
		listener.Close()
		t.Fatal(err)
	}
	b := &nativeImportedUDPBridge{listener: listener, remote: remote, delay: delay, clients: map[netip.AddrPort]*net.UDPConn{}, stop: make(chan struct{})}
	b.workers.Add(1)
	go func() {
		defer b.workers.Done()
		buffer := make([]byte, 65536)
		for {
			n, from, err := listener.ReadFromUDPAddrPort(buffer)
			if err != nil {
				return
			}
			if from.Addr() != remote {
				continue
			}
			b.packets.Add(1)
			b.mu.Lock()
			if b.closing {
				b.mu.Unlock()
				return
			}
			c := b.clients[from]
			if c == nil {
				if len(b.clients) >= 64 {
					b.mu.Unlock()
					return
				}
				c, err = net.DialUDP("udp4", nil, destination)
				if err != nil {
					b.mu.Unlock()
					return
				}
				b.clients[from] = c
				b.workers.Add(1)
				go func(c *net.UDPConn, from netip.AddrPort) {
					defer b.workers.Done()
					reply := make([]byte, 65536)
					for {
						n, err := c.Read(reply)
						if err != nil {
							return
						}
						if _, err = listener.WriteToUDPAddrPort(reply[:n], from); err != nil {
							return
						}
					}
				}(c, from)
			}
			b.mu.Unlock()
			if delay != nil && delay.Load() > 0 {
				timer := time.NewTimer(time.Duration(delay.Load()))
				select {
				case <-timer.C:
				case <-b.stop:
					timer.Stop()
					return
				}
			}
			if _, err = c.Write(buffer[:n]); err != nil {
				return
			}
		}
	}()
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		if err := b.close(ctx); err != nil {
			t.Error(err)
		}
	})
	return b
}
func (b *nativeImportedUDPBridge) close(ctx context.Context) error {
	if ctx == nil || ctx.Err() != nil {
		return errors.New("original UDP retirement requires live caller")
	}
	b.mu.Lock()
	if !b.closing {
		b.closing = true
		close(b.stop)
	}
	_ = b.listener.Close()
	for _, c := range b.clients {
		_ = c.Close()
	}
	b.mu.Unlock()
	done := make(chan struct{})
	go func() { b.workers.Wait(); close(done) }()
	select {
	case <-done:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}

type nativeImportedForward struct {
	*desktopNodeWGHandler
	api, peer               netip.Addr
	serverDelay, localDelay atomic.Int64
	middle                  string
}

func (h *nativeImportedForward) NewConnectionEx(ctx context.Context, c net.Conn, source, destination M.Socksaddr, done N.CloseHandlerFunc) {
	admin := destination.Addr == h.api && (destination.Port == 8787 || destination.Port >= 28440 && destination.Port <= 28447)
	local := h.middle != "" && destination.String() == "10.79.0.1:8388"
	if !admin && !local {
		h.desktopNodeWGHandler.NewConnectionEx(ctx, c, source, destination, done)
		return
	}
	if source.Addr != h.peer || !h.adopt(c, true) {
		_ = c.Close()
		if done != nil {
			done(errors.New("original private entry source changed"))
		}
		return
	}
	h.tcp.Add(1)
	go func() {
		defer h.workers.Done()
		defer h.forget(c)
		defer c.Close()
		target := destination.String()
		delay := h.localDelay.Load()
		dialer := net.Dialer{Timeout: 3 * time.Second}
		if admin {
			dialer.LocalAddr = &net.TCPAddr{IP: net.IP(h.peer.AsSlice())}
			delay = 0
			if destination.Port != 8787 {
				delay = h.serverDelay.Load()
			}
		} else {
			target = h.middle
		}
		if delay > 0 {
			timer := time.NewTimer(time.Duration(delay))
			select {
			case <-h.ctx.Done():
				timer.Stop()
				return
			case <-timer.C:
			}
		}
		raw, err := dialer.DialContext(h.ctx, "tcp4", target)
		if err == nil {
			peer, ok := raw.(*net.TCPConn)
			half, halfOK := c.(interface{ CloseWrite() error })
			if !ok || !halfOK || !h.adopt(peer, false) {
				err = errors.Join(errors.New("original reciprocal stream absent"), raw.Close())
			} else {
				defer h.forget(peer)
				defer peer.Close()
				err = desktopReferenceCopyStream(h.ctx, c, c, half, peer)
			}
		}
		if done != nil {
			done(err)
		}
	}()
}

type nativeImportedProvider struct {
	imported         *desktopNodeChainImportedPeer
	local, server    *desktopNodeChainPeer
	forward          *nativeImportedForward
	localDelay       atomic.Int64
	carrier, delayed *nativeImportedUDPBridge
}

func nativeImportedPrefixSnapshot(prefix *desktopNodeChainPrefixPeer) desktopNodeChainPrefixReply {
	value := desktopNodeChainPrefixReply{Mode: prefix.mode, RawUDP: prefix.bind.packets.Load(), TCP: prefix.handler.tcp.Load(), UDP: prefix.handler.udp.Load(), ProofQueries: prefix.proof.Load(), AuthRefusals: prefix.denied.Load()}
	if prefix.readback != nil {
		value.ParametersSHA256, _ = prefix.readback()
	}
	return value
}
func nativeImportedProviderStart(t *testing.T, r nativeImportedRequest, physical bool) *nativeImportedProvider {
	t.Helper()
	if err := nativeImportedRequestValid(r); err != nil {
		t.Fatal(err)
	}
	n := len(r.Peer.Paired.Prefixes)
	loop := netip.MustParseAddr("127.0.0.1")
	local, remote := loop, loop
	if physical {
		local, remote = netip.MustParseAddr("192.168.210.2"), netip.MustParseAddr("192.168.210.1")
	}
	p := &nativeImportedProvider{}
	api, peer := desktopNodeChainInner(0, n)
	decorate := func(original *desktopNodeWGHandler) tun.Handler {
		p.forward = &nativeImportedForward{desktopNodeWGHandler: original, api: netip.MustParseAddr(api), peer: netip.MustParseAddr(peer)}
		return p.forward
	}
	last := r.Peer
	last.Schema = 1
	last.Paired.Prefixes = r.Peer.Paired.Prefixes[n-1:]
	wrong := func(original string) string {
		key, err := base64.StdEncoding.DecodeString(original)
		if err != nil {
			t.Fatal(err)
		}
		if _, err = rand.Read(key); err != nil {
			t.Fatal(err)
		}
		return base64.StdEncoding.EncodeToString(key)
	}
	if r.Fault == "wrong-middle-key" {
		last.MiddlePassword = wrong(last.MiddlePassword)
	}
	if r.Fault == "wrong-final-key" {
		last.Paired.FinalPassword = wrong(last.Paired.FinalPassword)
	}
	boundLocal, boundRemote := loop, loop
	if n == 1 {
		boundLocal, boundRemote = local, remote
	}
	var hooks *desktopNodeChainImportedPeerHooks
	if n == 1 {
		hooks = &desktopNodeChainImportedPeerHooks{decorate: decorate, middle: func(owner *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
			return desktopStartSSProvider(t, owner, last.MiddleMethod, last.MiddlePassword, loop)
		}}
	}
	p.imported = desktopNodeChainImportedPeerStartWithHooks(t, last, boundLocal, boundRemote, nil, hooks)
	p.local = &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, n), final: p.imported.paired}
	p.local.prefixes[n-1] = p.imported.prefix
	ipc, err := desktopNodeChainPeerIdentityBounds(r.Peer.Paired, 1, 6)
	if err != nil {
		t.Fatal(err)
	}
	desktopNodeChainStartCapturedPrefixRange(t, r.Peer.Paired, local, remote, p.local, ipc, n-1, 0, func(position int, h *desktopNodeWGHandler) tun.Handler {
		if position == 0 {
			return decorate(h)
		}
		return h
	})
	clear(ipc)
	if n == 1 {
		p.forward.middle = p.imported.provider.address
	}
	if n > 1 {
		// The complete original positions are kept. Server has no fabricated entry.
		request := r.Peer.Paired
		request.Prefixes = append([]desktopNodeChainPrefixRequest(nil), request.Prefixes...)
		for i := 1; i < n; i++ {
			raw, _ := base64.StdEncoding.DecodeString(r.ServerPrivateKeys[i])
			key, _ := ecdh.X25519().NewPrivateKey(raw)
			clear(raw)
			request.Prefixes[i].ClientPublicKey = base64.StdEncoding.EncodeToString(key.PublicKey().Bytes())
		}
		if r.Fault == "wrong-first-key" || r.Fault == "wrong-later-key" {
			position := 1
			if r.Fault == "wrong-later-key" {
				position = n - 1
			}
			key, err := ecdh.X25519().GenerateKey(rand.Reader)
			if err != nil {
				t.Fatal(err)
			}
			request.Prefixes[position].ClientPublicKey = base64.StdEncoding.EncodeToString(key.PublicKey().Bytes())
		}
		ipc, err = desktopNodeChainPeerIdentityBounds(request, 1, 6)
		if err != nil {
			t.Fatal(err)
		}
		p.server = &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, n), final: p.imported.paired}
		end := &desktopNodeChainPrefixPeer{}
		p.server.prefixes[n-1] = end
		ctx, cancel := context.WithCancel(context.Background())
		end.handler = &desktopNodeWGHandler{desktopReferenceHandler: &desktopReferenceHandler{ctx: ctx, cancel: cancel, owned: map[io.Closer]bool{}, rules: map[string]desktopReferenceRule{}}}
		for _, network := range []string{"tcp", "udp"} {
			end.handler.rules[network+"/10.79.0.1:8388"] = desktopReferenceRule{Network: network, Address: "10.79.0.1", Port: 8388, Target: p.imported.provider.address}
		}
		stack, err := wg.NewDevice(wg.DeviceOptions{Context: ctx, Logger: log.NewNOPFactory().Logger(), Handler: end.handler, UDPTimeout: 5 * time.Second, ICMPTimeout: time.Second, MTU: 2000, Address: []netip.Prefix{netip.MustParsePrefix("10.78.0.1/32"), netip.MustParsePrefix("fd78:78::1/128")}})
		if err != nil {
			t.Fatal(err)
		}
		end.bind = &desktopNodeWGBind{local: loop, remote: loop}
		device, err := desktopNodeChainPrefixFactory(t, request.Prefixes[n-1], end)(ctx, stack, end.bind, ipc[n-1])
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() { end.handler.close(); device.close() })
		desktopNodeChainStartCapturedPrefixRange(t, request, loop, loop, p.server, ipc, n-1, 1, nil)
		clear(ipc)
		delayed := nativeImportedUDPStart(t, "127.0.0.1:0", p.local.prefixes[1].bind.address(), loop, &p.localDelay)
		p.delayed = delayed
		target := desktopNodeChainNext(1)
		rule := p.local.prefixes[0].handler.rules["udp/"+target]
		rule.Target = delayed.listener.LocalAddr().String()
		p.local.prefixes[0].handler.rules["udp/"+target] = rule
		if physical {
			p.carrier = nativeImportedUDPStart(t, desktopNodeChainNext(1), p.server.prefixes[1].bind.address(), netip.MustParseAddr("192.168.211.1"), nil)
		}
	}
	return p
}

type nativeImportedTCPBridge struct {
	listener net.Listener
	owner    *desktopReferenceHandler
	accepts  atomic.Uint64
}

func nativeImportedTCPStart(t *testing.T, address, target string, remote netip.Addr) *nativeImportedTCPBridge {
	t.Helper()
	listener, err := net.Listen("tcp4", address)
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	b := &nativeImportedTCPBridge{listener: listener, owner: &desktopReferenceHandler{ctx: ctx, cancel: cancel, owned: map[io.Closer]bool{}}}
	b.owner.workers.Add(1)
	go func() {
		defer b.owner.workers.Done()
		for {
			c, err := listener.Accept()
			if err != nil {
				return
			}
			address, err := netip.ParseAddrPort(c.RemoteAddr().String())
			if err != nil || address.Addr() != remote {
				c.Close()
				continue
			}
			if !b.owner.adopt(c, true) {
				c.Close()
				return
			}
			b.accepts.Add(1)
			go func() {
				defer b.owner.workers.Done()
				defer b.owner.forget(c)
				defer c.Close()
				raw, err := (&net.Dialer{Timeout: 3 * time.Second}).DialContext(ctx, "tcp4", target)
				if err != nil {
					return
				}
				peer, ok := raw.(*net.TCPConn)
				original, originalOK := c.(*net.TCPConn)
				if !ok || !originalOK || !b.owner.adopt(peer, false) {
					raw.Close()
					return
				}
				defer b.owner.forget(peer)
				defer peer.Close()
				_ = desktopReferenceCopyStream(ctx, original, original, original, peer)
			}()
		}
	}()
	t.Cleanup(func() { _ = listener.Close(); b.owner.close() })
	return b
}
func (p *nativeImportedProvider) snapshot() map[string]any {
	local := p.imported.snapshot()
	actual := p.local.snapshot()
	local.Address, local.Prefixes = actual.Address, actual.Prefixes
	server := []desktopNodeChainPrefixReply{}
	if p.server != nil {
		for _, prefix := range p.server.prefixes[1:] {
			server = append(server, nativeImportedPrefixSnapshot(prefix))
		}
	}
	var carrier, delayed uint64
	if p.carrier != nil {
		carrier = p.carrier.packets.Load()
	}
	if p.delayed != nil {
		delayed = p.delayed.packets.Load()
	}
	return map[string]any{"peer": local, "server_prefixes": server, "carrier_packets": carrier, "local_delayed_packets": delayed, "middle_address": "10.79.0.1:8388"}
}
func nativeImportedNamespace(role string) error {
	if os.Geteuid() != 0 || os.Getenv("ROUTERVPN_LINUX_GUARDIAN_TEST_NS") != "1" || os.Getenv("ROUTERVPN_NATIVE_IMPORTED_ROLE") != role {
		return errors.New("original isolated native execution role required")
	}
	current, err := os.Readlink("/proc/self/ns/net")
	if err != nil || current == os.Getenv("ROUTERVPN_NATIVE_IMPORTED_PARENT_NETNS") || os.Getenv("ROUTERVPN_NATIVE_IMPORTED_PARENT_NETNS") == "" {
		return errors.New("native execution refused original host namespace")
	}
	return nil
}
func TestRouterVPNDesktopNativeImportedProviderProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NATIVE_IMPORTED_ROLE") == "" {
		t.Skip("isolated original native provider only")
	}
	if err := nativeImportedNamespace("provider"); err != nil {
		t.Fatal(err)
	}
	reader := bufio.NewReaderSize(os.Stdin, mobilemultihop.NodeChainInputLimit+1)
	var request nativeImportedRequest
	if importedExecutionRead(reader, 64<<10, &request) != nil || nativeImportedRequestValid(request) != nil {
		t.Fatal("original native provider capture refused")
	}
	p := nativeImportedProviderStart(t, request, true)
	var directTCP *nativeImportedTCPBridge
	if len(request.Peer.Paired.Prefixes) == 1 {
		directTCP = nativeImportedTCPStart(t, "10.79.0.1:8388", p.imported.provider.address, netip.MustParseAddr("192.168.211.1"))
		p.carrier = nativeImportedUDPStart(t, "10.79.0.1:8388", p.imported.provider.address, netip.MustParseAddr("192.168.211.1"), nil)
	}
	send := func() {
		value := p.snapshot()
		var tcp uint64
		if directTCP != nil {
			tcp = directTCP.accepts.Load()
		}
		value["carrier_tcp"] = tcp
		if json.NewEncoder(os.Stdout).Encode(value) != nil {
			t.Fatal("original native provider output closed")
		}
	}
	send()
	for {
		var control struct {
			Command string `json:"command"`
		}
		if importedExecutionRead(reader, 128, &control) != nil {
			t.Fatal("original native provider control closed")
		}
		switch control.Command {
		case "quit":
			return
		case "stats":
		case "winner-local":
			p.forward.serverDelay.Store(int64(75 * time.Millisecond))
			p.localDelay.Store(0)
			p.forward.localDelay.Store(0)
		case "winner-server":
			p.forward.serverDelay.Store(0)
			p.localDelay.Store(int64(35 * time.Millisecond))
			p.forward.localDelay.Store(int64(75 * time.Millisecond))
		default:
			if err := p.imported.control(control.Command); err != nil {
				t.Fatal(err)
			}
		}
		send()
	}
}

type nativeImportedAdmin struct {
	cfg       struct{ NodeID string }
	relay     *multihoprelay.Manager
	token     string
	api, peer netip.Addr
	queries   atomic.Uint64
}

func (s *nativeImportedAdmin) authorized(r *http.Request) (net.IP, error) {
	address, err := netip.ParseAddrPort(r.RemoteAddr)
	if err != nil || address.Addr() != s.peer || r.Host != net.JoinHostPort(s.api.String(), "8787") || r.Header.Get("Authorization") != "Bearer "+s.token {
		return nil, errors.New("original native private administration refused")
	}
	return net.IP(address.Addr().AsSlice()), nil
}
func (s *nativeImportedAdmin) health(w http.ResponseWriter, r *http.Request) {
	if _, err := s.authorized(r); err != nil {
		http.Error(w, "original private entry refused", 403)
		return
	}
	if r.Method == http.MethodGet && r.URL.Path == "/health" && r.URL.RawQuery == "" && r.ContentLength == 0 && len(r.TransferEncoding) == 0 {
		s.queries.Add(1)
		_ = json.NewEncoder(w).Encode(desktopImportedWGSSHealthReply{true, s.cfg.NodeID, "router-vpn-private-agent-v1"})
		return
	}
	if r.Method == http.MethodGet && r.URL.Path == "/api/benchmark/download" && len(r.URL.Query()) == 1 {
		n, err := strconv.Atoi(r.URL.Query().Get("bytes"))
		if err == nil && n >= 65536 && n <= 8<<20 {
			w.Header().Set("Content-Length", strconv.Itoa(n))
			w.Header().Set("X-Routervpn-Benchmark", "download-v1")
			w.Header().Set("X-Routervpn-Benchmark-Bytes", strconv.Itoa(n))
			_, _ = w.Write(make([]byte, n))
			return
		}
	}
	if r.Method == http.MethodPost && r.URL.Path == "/api/benchmark/upload" && r.URL.RawQuery == "" && len(r.TransferEncoding) == 0 && r.ContentLength >= 65536 && r.ContentLength <= 8<<20 {
		n, err := io.Copy(io.Discard, io.LimitReader(r.Body, (8<<20)+1))
		if err == nil && n == r.ContentLength {
			_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "direction": "upload", "bytes": n, "server_receive_ms": 1, "peer": "captured", "proof": "authenticated tunnel-peer private throughput sink"})
			return
		}
	}
	http.NotFound(w, r)
}

type nativeImportedRunner struct {
	*importedExecutionRunner
	prefixes int
}

func (r *nativeImportedRunner) StartChain(ctx context.Context, capture multihoprelay.NodeChainCapture) (multihoprelay.NodeChainProcess, error) {
	bad := errors.New("native test launcher lost original packet carrier/source/image")
	if ctx == nil || ctx.Err() != nil || capture.Validate() != nil || r.policy == nil || r.policy.NativeCarrierRequired() != (r.prefixes > 1) {
		return nil, bad
	}
	expected, e := r.policy.Descriptor().Digest()
	actual, a := capture.Source.Digest()
	if e != nil || a != nil || expected != actual {
		return nil, bad
	}
	file, info, digest, err := captureImportedExecutionImage(r.image)
	if err != nil {
		return nil, err
	}
	defer file.Close()
	if !os.SameFile(info, r.imageInfo) || digest != r.imageSHA {
		return nil, bad
	}
	dir, err := os.MkdirTemp(r.runtime, "chain-")
	if err != nil {
		return nil, err
	}
	original, err := os.Lstat(dir)
	if err != nil {
		return nil, err
	}
	p := newImportedExecutionProcess(capture, dir, original)
	r.mu.Lock()
	r.processes = append(r.processes, p)
	r.mu.Unlock()
	p.root, err = os.OpenRoot(dir)
	if err != nil {
		return p, err
	}
	raw, err := json.Marshal(capture)
	if err != nil {
		return p, err
	}
	defer clear(raw)
	if err = os.WriteFile(filepath.Join(dir, "node-chain-capture.json"), raw, 0600); err != nil {
		return p, err
	}
	if err = os.WriteFile(filepath.Join(dir, "node-chain-source.json"), []byte(r.policy.Source()), 0600); err != nil {
		return p, err
	}
	// Explicit Darwin fixture launch seam: /proc/self/fd is a Linux launcher
	// primitive. The exact verified image/path/inode is rechecked immediately
	// before and after direct exec; the shipping IPC owner remains unmodified.
	command := exec.Command(r.image, "routervpn-node-chain-relay", "--runtime-dir", dir)
	command.Dir = dir
	command.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LANG=C", "GORACE=atexit_sleep_ms=0"}
	command.Stderr = os.Stderr
	source := r.policy.Source()
	p.current = func() bool {
		current, err := os.Lstat(r.image)
		return err == nil && os.SameFile(current, r.imageInfo) && current.Size() == r.imageInfo.Size() && current.ModTime().Equal(r.imageInfo.ModTime()) && r.policy.Source() == source
	}
	if !p.current() {
		return p, bad
	}
	if err = p.start(command); err != nil {
		return p, err
	}
	if !p.current() {
		return p, bad
	}
	nonce, err := importedExecutionNonce()
	if err != nil {
		return p, err
	}
	receipt, err := p.Snapshot(ctx, nonce)
	if err != nil || receipt.Phase != multihoprelay.NodeChainPending {
		return p, errors.Join(err, bad)
	}
	r.launches.Add(1)
	return p, nil
}

type nativeImportedChild struct {
	command                 *exec.Cmd
	input                   io.WriteCloser
	output                  io.ReadCloser
	reader                  *bufio.Reader
	done                    chan struct{}
	outcome                 error
	stopOnce                sync.Once
	readDone                chan struct{}
	closeError, retireError error
	retireRaw               []byte
}

func nativeImportedChildStart(t *testing.T, r nativeImportedRequest) *nativeImportedChild {
	t.Helper()
	image, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	file, info, digest, err := captureImportedExecutionImage(image)
	if err != nil {
		t.Fatal(err)
	}
	file.Close()
	command := exec.Command("ip", "netns", "exec", "rvpn-peer", image, "-test.run=^TestRouterVPNDesktopNativeImportedProviderProcess$", "-test.count=1", "-test.timeout=120s")
	command.Env = []string{"PATH=/usr/sbin:/usr/bin:/sbin:/bin", "GORACE=atexit_sleep_ms=0", "ROUTERVPN_LINUX_GUARDIAN_TEST_NS=1", "ROUTERVPN_NATIVE_IMPORTED_ROLE=provider", "ROUTERVPN_NATIVE_IMPORTED_PARENT_NETNS=" + os.Getenv("ROUTERVPN_NATIVE_IMPORTED_PARENT_NETNS")}
	command.Stderr = os.Stderr
	inputRead, input, err := os.Pipe()
	if err != nil {
		t.Fatal(err)
	}
	output, outputWrite, err := os.Pipe()
	if err != nil {
		inputRead.Close()
		input.Close()
		t.Fatal(err)
	}
	command.Stdin, command.Stdout = inputRead, outputWrite
	child := &nativeImportedChild{command: command, input: input, output: output, reader: bufio.NewReaderSize(output, mobilemultihop.NodeChainInputLimit+1), done: make(chan struct{}), readDone: make(chan struct{})}
	if err = command.Start(); err != nil {
		inputRead.Close()
		input.Close()
		output.Close()
		outputWrite.Close()
		t.Fatal(err)
	}
	inputRead.Close()
	outputWrite.Close()
	go func() { child.outcome = command.Wait(); close(child.done) }()
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
		defer cancel()
		if err := child.close(ctx); err != nil {
			t.Error(err)
		}
	})
	current, err := os.Lstat(image)
	if err != nil || !os.SameFile(current, info) {
		t.Fatal("native provider executable replaced")
	}
	again, _, actual, err := captureImportedExecutionImage(image)
	if err != nil || actual != digest {
		t.Fatal("native provider executable content changed")
	}
	again.Close()
	if json.NewEncoder(input).Encode(r) != nil {
		t.Fatal("original provider request failed")
	}
	return child
}
func (c *nativeImportedChild) read(t *testing.T) map[string]json.RawMessage {
	t.Helper()
	var value map[string]json.RawMessage
	if importedExecutionRead(c.reader, mobilemultihop.NodeChainInputLimit, &value) != nil {
		t.Fatal("original native provider reply missing")
	}
	return value
}
func (c *nativeImportedChild) control(t *testing.T, value string) map[string]json.RawMessage {
	t.Helper()
	if json.NewEncoder(c.input).Encode(map[string]string{"command": value}) != nil {
		t.Fatal("native provider control closed")
	}
	return c.read(t)
}
func (c *nativeImportedChild) close(ctx context.Context) error {
	if ctx == nil || ctx.Err() != nil {
		return errors.New("provider close requires live original caller")
	}
	c.stopOnce.Do(func() {
		c.closeError = json.NewEncoder(c.input).Encode(map[string]string{"command": "quit"})
		_ = c.input.Close()
		go func() { c.retireRaw, c.retireError = io.ReadAll(io.LimitReader(c.reader, 4097)); close(c.readDone) }()
	})
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-c.readDone:
	}
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-c.done:
	}
	if c.closeError != nil || c.retireError != nil || c.outcome != nil || len(c.retireRaw) > 4096 || !strings.HasSuffix(string(c.retireRaw), "PASS\n") {
		return errors.Join(errors.New("native encrypted provider did not join"), c.closeError, c.retireError, c.outcome)
	}
	_ = c.output.Close()
	return nil
}

func TestRouterVPNDesktopNativeImportedExecutionProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NATIVE_IMPORTED_ROLE") == "" {
		t.Skip("isolated original installed execution only")
	}
	if err := nativeImportedNamespace("worker"); err != nil {
		t.Fatal(err)
	}
	reader := bufio.NewReaderSize(os.Stdin, mobilemultihop.NodeChainInputLimit+1)
	var request nativeImportedRequest
	if importedExecutionRead(reader, 64<<10, &request) != nil || nativeImportedRequestValid(request) != nil {
		t.Fatal("original installed execution request refused")
	}
	image, info, digest, err := captureImportedExecutionImage(request.Image)
	if err != nil || digest != request.ImageSHA || !filepath.IsAbs(request.Image) {
		t.Fatal("original native worker image changed")
	}
	image.Close()
	provider := nativeImportedChildStart(t, request)
	send := func(value any) {
		if json.NewEncoder(os.Stdout).Encode(value) != nil {
			t.Fatal("original installed output closed")
		}
	}
	initial := provider.read(t)
	send(initial)
	var configure struct {
		LocalSource string `json:"local_source"`
		Winner      string `json:"winner"`
	}
	if importedExecutionRead(reader, mobilemultihop.NodeChainInputLimit, &configure) != nil {
		t.Fatal("original installed local capture absent")
	}
	policy, err := nativeImportedServerSource(configure.LocalSource, request)
	if err != nil {
		t.Fatal("original independent Server source refused", err)
	}
	n := len(request.Peer.Paired.Prefixes)
	api, peer := desktopNodeChainInner(0, n)
	runtimeDir := t.TempDir()
	if os.Chmod(runtimeDir, 0700) != nil {
		t.Fatal("original private native worker root unavailable")
	}
	runner := &nativeImportedRunner{importedExecutionRunner: &importedExecutionRunner{policy: policy, image: request.Image, imageSHA: digest, imageInfo: info, runtime: runtimeDir}, prefixes: n}
	manager, err := multihoprelay.New(multihoprelay.Config{ListenIP: api, FirstPort: 28440, LastPort: 28447, TTLSeconds: 300, NodeChains: []multihoprelay.NodeChainDescriptor{policy.Descriptor()}}, request.Peer.Paired.Prefixes[0].NodeProofID, runner)
	if err != nil {
		t.Fatal(err)
	}
	admin := &nativeImportedAdmin{relay: manager, token: request.Peer.Paired.Prefixes[0].APIToken, api: netip.MustParseAddr(api), peer: netip.MustParseAddr(peer)}
	admin.cfg.NodeID = request.Peer.Paired.Prefixes[0].NodeProofID
	listener, err := net.Listen("tcp4", net.JoinHostPort(api, "8787"))
	if err != nil {
		t.Fatal(err)
	}
	server := &http.Server{ReadHeaderTimeout: 2 * time.Second, Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path == nativeImportedLeasePath {
			admin.multihopNodeChainLease(w, r)
		} else {
			admin.health(w, r)
		}
	})}
	done := make(chan struct{})
	var outcome error
	go func() { outcome = server.Serve(listener); close(done) }()
	closed := false
	closeAll := func(ctx context.Context) error {
		if err := manager.Close(ctx); err != nil {
			return err
		}
		if !runner.joined() {
			return errors.New("original native carrier workers did not join")
		}
		if err := server.Shutdown(ctx); err != nil {
			return err
		}
		if err := importedExecutionJoinHTTP(ctx, done, &outcome); err != nil {
			return err
		}
		if err := provider.close(ctx); err != nil {
			return err
		}
		closed = true
		return nil
	}
	t.Cleanup(func() {
		if !closed {
			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
			defer cancel()
			if err := closeAll(ctx); err != nil {
				t.Error(err)
			}
		}
	})
	if configure.Winner != "local" && configure.Winner != "server" {
		t.Fatal("captured timing arm absent")
	}
	provider.control(t, "winner-"+configure.Winner)
	send(map[string]any{"ready": true, "source_sha256": policy.Descriptor().SourceSHA256, "carrier_required": policy.NativeCarrierRequired(), "positions": len(policy.ProofInventory())})
	for {
		var control struct {
			Command string `json:"command"`
		}
		if importedExecutionRead(reader, 128, &control) != nil {
			t.Fatal("original installed worker control closed")
		}
		if control.Command == "quit" {
			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
			err := closeAll(ctx)
			cancel()
			if err != nil {
				t.Fatal(err)
			}
			send(map[string]any{"joined": true, "launches": runner.launches.Load()})
			return
		}
		command := control.Command
		if command == "carrier-change" {
			if n < 2 {
				t.Fatal("portable suffix has no native packet carrier")
			}
			change := exec.Command("ip", "route", "replace", "198.51.100.102/32", "via", "192.168.211.2", "dev", "rvpn-ss-net", "mtu", "1280")
			if err := change.Run(); err != nil {
				t.Fatal("original carrier mutation failed", err)
			}
			command = "stats"
		}
		value := provider.control(t, command)
		value["launches"], _ = json.Marshal(runner.launches.Load())
		value["workers_joined"], _ = json.Marshal(runner.joined())
		value["entry_proofs"], _ = json.Marshal(admin.queries.Load())
		send(value)
	}
}

func nativeImportedFixture(t *testing.T, count int, mode, method string) (nativeImportedRequest, string) {
	t.Helper()
	paired, clients := desktopNodeChainPeerFixture(t, count)
	modes := make([]string, count)
	for i := range modes {
		modes[i] = mode
	}
	desktopNodeChainSetModes(t, &paired, modes)
	finalServer, err := ecdh.X25519().GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	finalClient, err := ecdh.X25519().GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	encode := base64.StdEncoding.EncodeToString
	sum := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + encode(finalServer.PublicKey().Bytes())))
	paired.FinalNodeProofID = hex.EncodeToString(sum[:])
	keySize := 32
	if method == "2022-blake3-aes-128-gcm" {
		keySize = 16
	}
	secret := make([]byte, keySize)
	if _, err = rand.Read(secret); err != nil {
		t.Fatal(err)
	}
	request := nativeImportedRequest{Schema: 1, Peer: desktopNodeChainImportedRequest{Schema: 2, Paired: paired, MiddleMethod: method, MiddlePassword: encode(secret)}, ServerPrivateKeys: make([]string, count+2)}
	clear(secret)
	for i := range request.ServerPrivateKeys {
		if i == 0 || i == count {
			continue
		}
		key, err := ecdh.X25519().GenerateKey(rand.Reader)
		if err != nil {
			t.Fatal(err)
		}
		request.ServerPrivateKeys[i] = encode(key.Bytes())
	}
	finalWG := fmt.Sprintf("[Interface]\nAddress=10.79.0.2/32,fd79:79::2/128\nPrivateKey=%s\nDNS=192.168.50.133\nMTU=2000\n[Peer]\nPublicKey=%s\nEndpoint=10.77.0.1:51820\nAllowedIPs=0.0.0.0/0,::/0\n", encode(finalClient.Bytes()), encode(finalServer.PublicKey().Bytes()))
	finalIdentity := desktopNodeChainJSON(t, map[string][]byte{"wg.conf": []byte(finalWG)})
	single := paired
	single.Prefixes = paired.Prefixes[:1]
	trio := desktopNodeChainImportedSource(t, single, clients[:1], "192.168.210.2:51820", method, request.Peer.MiddlePassword, finalIdentity)
	trioRaw, err := trio.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var middle mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(trioRaw), &middle) != nil {
		t.Fatal("component original import missing")
	}
	ordinary := desktopNodeChainPeerSource(t, paired, clients, "192.168.210.2:51820")
	raw, err := ordinary.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(raw), &source) != nil {
		t.Fatal("component original packet source missing")
	}
	source.Schema = 2
	source.Nodes = append(source.Nodes[:count], middle.Nodes[1], source.Nodes[count])
	source.IdentitySources = make([]string, count+2)
	for i, prefix := range paired.Prefixes {
		_, client := desktopNodeChainInner(i, count)
		endpoint := desktopNodeChainNext(i)
		if i == 0 {
			endpoint = "192.168.210.2:51820"
		}
		secret, _ := base64.StdEncoding.DecodeString(prefix.PrivateKey)
		key, _ := ecdh.X25519().NewPrivateKey(secret)
		clear(secret)
		config := fmt.Sprintf("[Interface]\nAddress=%s/32,fd78:78::2/128\nPrivateKey=%s\nDNS=192.168.50.133\nMTU=2000\n[Peer]\nPublicKey=%s\nPresharedKey=%s\nEndpoint=%s\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n", client, clients[i], encode(key.PublicKey().Bytes()), prefix.PreSharedKey, endpoint)
		source.IdentitySources[i] = desktopNodeChainJSON(t, map[string][]byte{"wg.conf": []byte(config)})
	}
	source.IdentitySources[count+1] = finalIdentity
	return request, desktopNodeChainJSON(t, source)
}
func TestRouterVPNDesktopNativeImportedSourcePositions(t *testing.T) {
	for count := 1; count <= 6; count++ {
		for i, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
			t.Run(fmt.Sprintf("%d-%s", count, mode), func(t *testing.T) {
				methods := []string{"2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305"}
				request, local := nativeImportedFixture(t, count, mode, methods[i])
				policy, err := nativeImportedServerSource(local, request)
				if err != nil {
					t.Fatal(err)
				}
				original, err := mobilemultihop.NewNodeChain(local)
				if err != nil {
					t.Fatal(err)
				}
				inventory := original.ProofInventory()
				var suffix mobilemultihop.NodeChainServerSource
				if json.Unmarshal([]byte(policy.Source()), &suffix) != nil {
					t.Fatal("source missing")
				}
				for position, p := range policy.ProofInventory() {
					index := position + 1
					if p.Position != index || p.NodeID != inventory[index].NodeID || p.ProfileID != inventory[index].ProfileID {
						t.Fatal("global private/public position changed")
					}
					if index < count {
						a, _ := mobilemultihop.ParseNodeLaunchInput(suffix.Nodes[position])
						var source mobilemultihop.NodeChainSource
						_ = json.Unmarshal([]byte(local), &source)
						b, _ := mobilemultihop.ParseNodeLaunchInput(source.Nodes[index])
						aKey, _ := a.PacketClientPublicKey()
						bKey, _ := b.PacketClientPublicKey()
						if aKey == bKey {
							t.Fatal("Server borrowed original Local client key")
						}
					}
				}
				if policy.NativeCarrierRequired() != (count > 1) || len(policy.ProofInventory()) != count+1 {
					t.Fatal("native carrier or full suffix count changed")
				}
			})
		}
	}
}
