type desktopOpenVPNDirectReply struct {
	Peer         desktopNodeChainImportedReply `json:"peer"`
	Local        nativeopenvpn.Profile         `json:"local"`
	Server       nativeopenvpn.Profile         `json:"server"`
	TCP          int64                         `json:"tcp"`
	UDP          int64                         `json:"udp"`
	AuthRefusals int64                         `json:"auth_refusals"`
	Streams      int64                         `json:"streams"`
	Packets      int64                         `json:"packets"`
}
type desktopOpenVPNDirectPeer struct {
	peer     *desktopNodeChainImportedPeer
	provider desktopExternalInstalledOpenVPNPeer
	local    nativeopenvpn.Profile
}

func (p *desktopOpenVPNDirectPeer) snapshot() desktopOpenVPNDirectReply {
	actual := p.provider.stats()
	return desktopOpenVPNDirectReply{Peer: p.peer.snapshot(), Local: p.local, Server: nativeopenvpn.Profile{Config: p.provider.profile, Username: p.provider.username, Password: p.provider.password}, TCP: actual.connections, UDP: actual.physicalUDP, AuthRefusals: actual.authFailures, Streams: actual.streams, Packets: actual.packets}
}

// The unused reference prefix supplies only existing paired final services.
// It is never a product member, packet carrier or proof authority. Native
// acceptance requires its packet counters to remain zero throughout.
func desktopOpenVPNDirectStart(t *testing.T, request desktopNodeChainPeerRequest, network, layer string, direct bool) *desktopOpenVPNDirectPeer {
	t.Helper()
	topology := desktopNodeChainImportedRequest{1, request, mobilemultihop.NativeStartLayerMethod, base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, 32))}
	if len(request.Prefixes) != 1 || desktopNodeChainImportedServerRequestValid(topology) != nil || (network != "tcp" && network != "udp") || (layer != "off" && layer != "aes-256-gcm" && layer != "aes-256-gcm+xor-whitening") {
		t.Fatal("uncaptured direct OpenVPN provider request")
	}
	p := new(desktopOpenVPNDirectPeer)
	loopback := netip.MustParseAddr("127.0.0.1")
	physical, client := loopback, loopback
	if direct {
		physical, client = netip.MustParseAddr("203.0.113.24"), netip.MustParseAddr(request.ClientAddress)
	}
	hooks := &desktopNodeChainImportedPeerHooks{
		decorate: func(h *desktopNodeWGHandler) tun.Handler { return h },
		middle: func(parent *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
			routes := append([]desktopNodeLayerRoute(nil), parent.routes...)
			for i := range routes {
				if routes[i].Destination == "speed.cloudflare.com:443" {
					routes[i].Destination = "93.184.216.34:443"
				}
				if layer == "aes-256-gcm+xor-whitening" && routes[i].Destination == "10.77.0.1:8388" {
					routes[i].Destination = "10.77.0.1:8389"
				}
			}
			p.provider = startDesktopInstalledOpenVPNProviderCaptured(t, parent, desktopExternalInstalledPeerRequest{OpenVPNNetwork: network}, "", "", physical, client, true, 2, &desktopOpenVPNProviderCapture{Direct: direct, Local: &p.local, Remote: netip.MustParseAddrPort("203.0.113.24:1194"), MTU: 1500, Routes: routes})
			return desktopExternalInstalledSSPeer{address: p.provider.entryRoutes[0].Target, close: p.provider.close}
		},
	}
	if layer != "off" {
		hooks.final = func(owner *desktopNodeLayerServer) desktopExternalInstalledSSPeer {
			kind := "shadowsocks"
			if layer == "aes-256-gcm+xor-whitening" {
				kind = "routervpn-aes-xor"
			}
			return desktopImportedSOCKSLayerProvider(t, owner, map[string]any{"type": kind, "password": request.FinalPassword}, "")
		}
	}
	p.peer = desktopNodeChainImportedPeerStartWithHooks(t, topology, loopback, loopback, nil, hooks)
	return p
}

func TestRouterVPNDesktopOpenVPNDirectSourceProfiles(t *testing.T) {
	directory := os.Getenv("ROUTERVPN_OPENVPN_DIRECT_PROFILES")
	if directory == "" {
		t.Skip("explicit private source export only")
	}
	for _, network := range []string{"tcp", "udp"} {
		t.Run(network, func(t *testing.T) {
			request, _ := desktopNodeChainPeerFixture(t, 1)
			p := desktopOpenVPNDirectStart(t, request, network, "off", false)
			snapshot := p.snapshot()
			local, e := nativeopenvpn.DescribePeer(snapshot.Local, base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{71}, 32)))
			server, err := nativeopenvpn.DescribePeer(snapshot.Server, base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{72}, 32)))
			if e != nil || err != nil || nativeopenvpn.ValidatePublicPair(local, server) != nil || snapshot.Local.Username == snapshot.Server.Username || snapshot.Local.Password == snapshot.Server.Password {
				t.Fatal("independent provider source missing", e, err)
			}
			if nativeopenvpn.ValidatePublicPair(local, local) == nil {
				t.Fatal("same provider identity accepted both roles")
			}
			if snapshot.TCP != 0 || snapshot.UDP != 0 || snapshot.Streams != 0 || snapshot.Packets != 0 {
				t.Fatal("source export manufactured connected authority")
			}
			raw, err := json.Marshal(snapshot)
			if err != nil {
				t.Fatal(err)
			}
			path := filepath.Join(directory, network+".json")
			file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
			if err != nil {
				t.Fatal(err)
			}
			_, err = file.Write(raw)
			closeErr := file.Close()
			if err != nil || closeErr != nil {
				t.Fatal(err, closeErr)
			}
		})
	}
}

func TestRouterVPNDesktopOpenVPNDirectServerReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_OPENVPN_DIRECT_SERVER_CHILD") == "" {
		t.Skip("isolated inherited reference only")
	}
	if os.Getenv("ROUTERVPN_OPENVPN_DIRECT_SERVER_CHILD") != "1" {
		t.Fatal("uncaptured direct OpenVPN child")
	}
	reader := bufio.NewReaderSize(os.Stdin, 32<<10+1)
	line, err := reader.ReadSlice('\n')
	if err != nil || len(line) > 32<<10 {
		t.Fatal("bounded original request required")
	}
	var request struct {
		Schema  int                         `json:"schema"`
		Paired  desktopNodeChainPeerRequest `json:"paired"`
		Network string                      `json:"network"`
		Layer   string                      `json:"layer"`
	}
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	if decoder.Decode(&request) != nil || decoder.Decode(new(any)) != io.EOF || request.Schema != 1 || request.Paired.Address != "192.168.210.2" || request.Paired.ClientAddress != "192.168.210.1" {
		t.Fatal("original direct request changed")
	}
	interfaces, err := net.Interfaces()
	physical, alias := false, false
	for _, iface := range interfaces {
		values, e := iface.Addrs()
		if e != nil {
			t.Fatal(e)
		}
		for _, value := range values {
			prefix, e := netip.ParsePrefix(value.String())
			if e != nil {
				continue
			}
			physical = physical || prefix.Addr().String() == request.Paired.Address && iface.Flags&net.FlagUp != 0 && iface.Flags&net.FlagLoopback == 0
			alias = alias || prefix.Addr().String() == "203.0.113.24" && prefix.Bits() == 32 && iface.Flags&net.FlagUp != 0
		}
	}
	if err != nil || !physical || !alias {
		t.Fatal("direct reference requires original isolated namespace and exact provider alias")
	}
	p := desktopOpenVPNDirectStart(t, request.Paired, request.Network, request.Layer, true)
	respond := func() {
		if json.NewEncoder(os.Stdout).Encode(p.snapshot()) != nil {
			t.Fatal("original reply pipe failed")
		}
	}
	respond()
	for {
		line, err = reader.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 64 {
			t.Fatal("bounded original control required")
		}
		command := strings.TrimSuffix(string(line), "\n")
		if command == "quit" {
			return
		}
		if p.peer.control(command) != nil {
			t.Fatal("uncaptured direct control")
		}
		respond()
	}
}
