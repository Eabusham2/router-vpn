func desktopImportedNaiveH3Traffic(t *testing.T, kind, first, last, fault string) {
	t.Helper()
	f := desktopImportedNaiveH3New(t, kind, first, last, fault)
	if f.startErr != nil {
		f.audit = func() {
			stats := f.entryStats()
			if fault != "entry-route" || f.lower.denied.Load() == 0 || f.lower.calls.Load() != 0 || stats.raw != 0 || stats.tcp != 0 || stats.udp != 0 || f.finalServer.rawUDP.Load() != 0 {
				t.Fatal("imported Naive H3 native startup failed without its exact foreign-tuple refusal", f.startErr)
			}
		}
		if err := f.close(); err != nil {
			t.Fatal(err)
		}
		return
	}
	entryFailure := strings.HasPrefix(fault, "entry-") || fault == "wrong-entry-ip"
	entryErr := f.connectedEntry(f.ctx)
	if entryErr != nil && !entryFailure {
		t.Fatal("actual imported Naive H3 entry did not authenticate", entryErr)
	}
	publicOK := false
	var err error
	if entryErr == nil {
		publicOK, err = desktopImportedSOCKSXrayPublic(f.ctx, f.first, f.roots, "203.0.113.88")
	}
	if publicOK == entryFailure {
		t.Fatal("imported Naive H3 independent entry proof changed", err, entryErr)
	}
	bootstrapOK, dnsOK, proofOK := false, false, false
	if publicOK {
		bootstrapOK, err = desktopImportedNaiveH3DNSExchange(f.ctx, f.bootstrap, "bootstrap.routervpn.test.")
		wantBootstrap := fault != "bootstrap-route" && !strings.HasPrefix(fault, "final-layer-") && !strings.HasPrefix(fault, "socks-")
		if bootstrapOK != wantBootstrap {
			t.Fatal("original H3 bootstrap did not use its captured lower UDP DNS", err)
		}
		if bootstrapOK {
			dnsOK, err = desktopImportedNaiveH3DNSExchange(f.ctx, f.selectedTransport, "selected.routervpn.test.")
			wantDNS := fault != "final-password" && fault != "final-user" && fault != "final-server-name" && fault != "final-certificate" && fault != "final-route" && fault != "dns-route"
			if dnsOK != wantDNS {
				t.Fatal("H3 selected UDP DNS did not traverse its original authenticated final", err)
			}
			if dnsOK {
				proofOK, err = desktopImportedSOCKSXrayProof(f.ctx, f.final, f.meta.ExitAPI, f.meta.ExitNodeID, f.meta.ExitToken)
				if proofOK != (fault != "final-identity" && fault != "final-token") {
					t.Fatal("H3 independent paired proof changed", err)
				}
			}
		}
	}
	success := fault == "success" || fault == "cancel" || fault == "close-owner" || fault == "replacement-owner"
	if (publicOK && bootstrapOK && dnsOK && proofOK) != success || f.plan.Healthy() {
		t.Fatal("imported Naive H3 confused a userspace proof with host readiness")
	}
	f.recheckConnected(t)
	if success {
		for _, network := range []string{"tcp", "udp"} {
			if err := desktopImportedSOCKSXrayEcho(f.ctx, f.final, network); err != nil {
				t.Fatal("imported Naive H3 final payload failed", network, err)
			}
		}
	}
	var replacement adapter.Outbound
	var replacementCloseOnce sync.Once
	var replacementCloseErr error
	closeReplacement := func() error {
		replacementCloseOnce.Do(func() {
			if replacement != nil {
				replacementCloseErr = replacement.(io.Closer).Close()
			}
		})
		return replacementCloseErr
	}
	if fault == "replacement-owner" {
		replacement, err = NV.NewOutbound(f.owned, nil, log.NewNOPFactory().Logger(), mobilemultihop.LocalTag, f.finalOptions)
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() {
			if err := closeReplacement(); err != nil {
				t.Error(err)
			}
		})
		if err := replacement.(adapter.Lifecycle).Start(adapter.StartStateStart); err != nil {
			t.Fatal(err)
		}
		for _, network := range []string{"tcp", "udp"} {
			if err := desktopImportedSOCKSXrayEcho(f.ctx, replacement, network); err != nil {
				t.Fatal("replacement final did not prove its own traffic", network, err)
			}
		}
	}
	if fault == "cancel" || fault == "close-owner" || fault == "replacement-owner" {
		held, err := f.final.DialContext(f.ctx, "tcp", M.ParseSocksaddr("192.0.2.99:9999"))
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() { _ = held.Close() })
		if err := held.SetDeadline(time.Now().Add(2 * time.Second)); err != nil {
			t.Fatal(err)
		}
		if err := desktopImportedSOCKSXrayExchange(held); err != nil {
			t.Fatal("retirement did not first prove its original held stream", err)
		}
		if fault == "cancel" {
			f.cancelFinal()
		} else if err := f.closeFinal(); err != nil {
			t.Fatal(err)
		}
		_ = held.SetReadDeadline(time.Now().Add(2 * time.Second))
		var body [1]byte
		if n, err := held.Read(body[:]); n != 0 || err == nil {
			t.Fatal("retired original final kept its application stream")
		} else if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
			t.Fatal("retirement waited only for the fixture deadline")
		}
		calls, streams := f.lower.calls.Load(), f.entryStats().tcp
		lateContext, stopLate := context.WithTimeout(context.Background(), 2*time.Second)
		late, lateErr := f.final.DialContext(lateContext, "tcp", M.ParseSocksaddr("192.0.2.99:9999"))
		if late != nil {
			deadline, _ := lateContext.Deadline()
			_ = late.SetDeadline(deadline)
			lateErr = desktopImportedSOCKSXrayExchange(late)
			_ = late.Close()
		}
		stopLate()
		// Naive DialEarly can return a lazy stream after caller cancellation.
		// It must fail its actual payload without obtaining another captured
		// entry connection. Explicit native Close also refuses allocation.
		if lateErr == nil || fault != "cancel" && late != nil || f.lower.calls.Load() != calls || f.entryStats().tcp != streams {
			t.Fatal("retired H3 owner acquired another physical/authenticated entry or delivered late payload", lateErr)
		}
		f.retired, f.retiredTCP = true, streams
	}
	if replacement != nil {
		for _, network := range []string{"tcp", "udp"} {
			if err := desktopImportedSOCKSXrayEcho(f.ctx, replacement, network); err != nil {
				t.Fatal("original retirement damaged the independent replacement", network, err)
			}
		}
		if err := closeReplacement(); err != nil {
			t.Fatal(err)
		}
		f.retiredTCP = f.entryStats().tcp
	}
	f.recheckConnected(t)
	if err := f.close(); err != nil {
		t.Fatal("packet native owners did not drain before physical fixture teardown", err)
	}
	f.audit = func() {
		stats := f.entryStats()
		if f.retired && stats.tcp != f.retiredTCP {
			t.Fatal("retired final opened a deferred authenticated entry stream before original peer cleanup joined")
		}
		if f.dnsRouter.calls.Load() != 0 || publicOK && bootstrapOK && f.dnsManager.reads.Load() == 0 {
			t.Fatal("literal H3 final changed its exact retained bootstrap authority")
		}
		if fault == "bootstrap-route" && (f.bootstrapHits.Load() != 0 || f.dns.Load() != 0 || f.health.Load() != 0) {
			t.Fatal("refused bootstrap borrowed selected DNS or final proof")
		}
		t.Logf("kind=%s entry_layer=%s final_layer=%s fault=%s source_sha256=%s lower=%s physical_calls=%d entry_tcp=%d entry_udp=%d bootstrap_udp=%d selected_udp=%d naive_quic=%d naive_tcp=%d naive_uot=%d", kind, first, last, fault, f.plan.SourceSHA256(), f.entryNetwork, f.lower.calls.Load(), stats.tcp, stats.udp, f.bootstrapHits.Load(), f.dns.Load(), f.finalServer.rawUDP.Load(), f.finalServer.plainTCP.Load(), f.finalServer.plainUDP.Load())
		if !reflect.DeepEqual(f.source, f.captured) || f.plan.Config() != f.config || f.plan.Healthy() {
			t.Fatal("imported Naive H3 rewrote its capture or changed its native QUIC source")
		}
		if fault == "entry-route" {
			if f.lower.denied.Load() == 0 || f.lower.calls.Load() != 0 || stats.raw != 0 {
				t.Fatal("wrong entry tuple reached original physical provider")
			}
		} else if f.lower.calls.Load() == 0 {
			t.Fatal("imported Naive H3 did not attempt the original captured physical owner")
		}
		if fault == "entry-auth" && stats.auth == 0 {
			t.Fatal("OpenVPN negative did not witness actual provider authentication rejection")
		}
		if strings.HasPrefix(fault, "entry-layer-") {
			if stats.raw != 0 || stats.tcp != 0 || stats.udp != 0 {
				t.Fatal("rejected entry layer reached the original packet provider")
			}
		} else if fault != "entry-route" && stats.raw == 0 {
			t.Fatal("packet negative did not reach its original ciphertext provider")
		}
		if entryFailure || fault == "final-route" || fault == "bootstrap-route" || strings.HasPrefix(fault, "final-layer-") || strings.HasPrefix(fault, "socks-") {
			if f.finalServer.rawUDP.Load() != 0 || f.dns.Load() != 0 || f.health.Load() != 0 {
				t.Fatal("rejected original entry or final route reached the paired engine")
			}
		} else if f.finalServer.rawUDP.Load() == 0 {
			t.Fatal("imported Naive H3 did not reach original final ciphertext")
		}
		if fault == "final-password" || fault == "final-user" || fault == "final-server-name" || fault == "final-certificate" {
			if f.dns.Load() != 0 || f.health.Load() != 0 || f.finalServer.plainTCP.Load() != 0 || f.finalServer.plainUDP.Load() != 0 {
				t.Fatal("foreign Naive credential gained final plaintext")
			}
		}
		wantedPublic := int64(1)
		if entryFailure && fault != "wrong-entry-ip" {
			wantedPublic = 0
		}
		if f.public.Load() != wantedPublic {
			t.Fatal("imported Naive H3 lost its independent public proof")
		}
		if success && (f.bootstrapHits.Load() != 1 || f.dns.Load() != 1 || f.health.Load() != 1 || f.authorized.Load() != 1 || f.finalServer.plainTCP.Load() == 0 || f.finalServer.plainUDP.Load() == 0 || stats.tcp == 0 || stats.udp == 0) {
			t.Fatal("imported Naive H3 omitted actual payload, selected DNS or distinct paired proof")
		}
		if f.socks != nil {
			f.socks.mu.Lock()
			associations := len(f.socks.relays)
			f.socks.mu.Unlock()
			if success && (associations == 0 || f.socks.server.rawUDP.Load() == 0) {
				t.Fatal("H3 SOCKS omitted its actual authenticated UDP association")
			}
			if strings.HasPrefix(fault, "socks-") {
				if associations == 0 || f.bootstrapHits.Load() != 0 || f.dns.Load() != 0 || f.health.Load() != 0 {
					t.Fatal("H3 SOCKS refusal did not retain original association and empty final authority")
				}
				if fault == "socks-relay-route" && (first == "off" && f.lower.denied.Load() == 0 || first != "off" && f.entryLayerServer.rejectedUDP.Load() == 0) {
					t.Fatal("foreign SOCKS relay did not reach its original exact-tuple rejection")
				}
				if fault == "socks-control-eof" && (f.socks.server.rawUDP.Load() == 0 || stats.udp != 0) {
					t.Fatal("SOCKS control retirement was not triggered by its original relay datagram")
				}
			}
			if f.socks.joinFailed.Load() {
				t.Fatal("original H3 SOCKS control read did not join")
			}
		}
		if fault == "dns-route" && (f.bootstrapHits.Load() != 1 || f.dns.Load() != 0 || f.health.Load() != 0) {
			t.Fatal("foreign DNS route reached original resolver or proof")
		}
		if fault == "final-identity" || fault == "final-token" {
			wanted := int64(1)
			if fault == "final-token" {
				wanted = 0
			}
			if f.dns.Load() != 1 || f.health.Load() != 1 || f.authorized.Load() != wanted {
				t.Fatal("paired final refusal lost independent DNS/token evidence")
			}
		}
		for _, role := range []struct {
			name, network string
			peer          *desktopExternalInstalledSSPeer
		}{{"entry", f.entryNetwork, f.entryCarrier}, {"final", "udp", f.finalCarrier}} {
			if role.peer == nil {
				continue
			}
			observed := role.peer.stats()
			failed := strings.HasPrefix(fault, role.name+"-layer-")
			if success && role.network == "tcp+udp" && (observed.PhysicalTCP == 0 || observed.PhysicalUDP == 0 || observed.Streams == 0 || observed.Packets == 0) {
				t.Fatal("H3 mixed entry layer omitted original TCP control/proof or UDP carrier")
			}
			if role.network == "tcp" && (observed.PhysicalUDP != 0 || observed.Packets != 0) || role.network == "udp" && (observed.PhysicalTCP != 0 || observed.Streams != 0) {
				t.Fatal("independent layer changed original physical transport", role.name)
			}
			if failed {
				if observed.AuthTCP+observed.AuthUDP == 0 || observed.Streams+observed.Packets != 0 {
					t.Fatal("independent packet layer lacks actual rejection", role.name)
				}
			} else if role.name == "final" && strings.HasPrefix(fault, "socks-") {
				if observed.PhysicalTCP+observed.PhysicalUDP+observed.Streams+observed.Packets != 0 {
					t.Fatal("refused SOCKS association reached the independent final layer")
				}
			} else if role.name == "final" && fault == "bootstrap-route" {
				if observed.PhysicalUDP == 0 || observed.AuthUDP != 0 || observed.Packets != 0 || f.finalLayerServer == nil || f.finalLayerServer.rejectedUDP.Load() == 0 {
					t.Fatal("H3 bootstrap refusal missed its authenticated final-layer route owner")
				}
			} else if !entryFailure && observed.Streams+observed.Packets == 0 {
				t.Fatal("imported Naive H3 bypassed its independent layer", role.name)
			}
		}
	}
}

// The physical boundary retains every socket until the actual native owner
// closes it. SOCKS UDP is admitted only by the original live association lease;
// other entries and Start Layers own their exact captured static tuple.
type desktopImportedNaiveH3Physical struct {
	*desktopPacketRealityPhysical
	networks     map[string]bool
	associations *desktopImportedSOCKSLayerRoutes
}

func (p *desktopImportedNaiveH3Physical) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	address, operation := p.physical, ctx
	var release func()
	if network == "udp" && p.associations != nil {
		var found bool
		address, operation, release, found = p.associations.acquire(destination.String())
		if !found || operation == nil || operation.Err() != nil {
			if release != nil {
				release()
			}
			p.denied.Add(1)
			return nil, errors.New("H3 SOCKS rejected an unowned or retired relay")
		}
	} else if !p.networks[network] || destination != p.expected {
		p.denied.Add(1)
		return nil, errors.New("H3 rejected an uncaptured lower transport or tuple")
	}
	keepLease := false
	defer func() {
		if release != nil && !keepLease {
			release()
		}
	}()
	p.mu.Lock()
	if p.closed || ctx.Err() != nil || operation.Err() != nil {
		p.mu.Unlock()
		return nil, errors.Join(ctx.Err(), operation.Err(), net.ErrClosed)
	}
	p.pending++
	p.signal()
	p.mu.Unlock()
	defer func() { p.mu.Lock(); p.pending--; p.signal(); p.mu.Unlock() }()
	p.calls.Add(1)
	raw, err := (&net.Dialer{}).DialContext(ctx, network+"4", address)
	if err != nil {
		return nil, err
	}
	connection := &desktopImportedSOCKSXrayConnection{Conn: raw, owner: p.desktopImportedSOCKSXrayPhysical}
	p.mu.Lock()
	p.connections[connection] = true
	retired := p.closed || ctx.Err() != nil || operation.Err() != nil
	p.signal()
	p.mu.Unlock()
	if retired {
		return nil, errors.Join(ctx.Err(), operation.Err(), net.ErrClosed, connection.Close())
	}
	if release == nil {
		return connection, nil
	}
	lease := &desktopImportedNaiveH3LeaseConnection{Conn: connection, release: release, joined: make(chan struct{})}
	lease.stop = context.AfterFunc(operation, func() {
		defer close(lease.joined)
		_ = connection.Close()
		lease.once.Do(release)
	})
	keepLease = true
	return lease, nil
}
func (p *desktopImportedNaiveH3Physical) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
	connection, err := p.DialContext(ctx, "udp", destination)
	if err != nil {
		return nil, err
	}
	return &desktopImportedProxyXrayPacket{Conn: connection, expected: destination}, nil
}

type desktopImportedNaiveH3LeaseConnection struct {
	net.Conn
	stop    func() bool
	release func()
	joined  chan struct{}
	once    sync.Once
}

func (c *desktopImportedNaiveH3LeaseConnection) Close() error {
	err := c.Conn.Close()
	if !c.stop() {
		<-c.joined
	}
	c.once.Do(c.release)
	return err
}

// Forward only unchanged QUIC ciphertext from each original private source to
// the captured non-loopback Naive listener. Each source keeps an independent
// connected UDP socket; teardown cancels and joins both directions.
func desktopImportedNaiveH3CiphertextBridge(t *testing.T, physical netip.Addr, target string) string {
	t.Helper()
	address, err := netip.ParseAddrPort(target)
	if err != nil || !physical.Is4() || !physical.IsPrivate() || physical.IsLoopback() || address.Addr() != physical || address.Port() == 0 {
		t.Fatal("H3 ciphertext bridge lost original physical reference tuple", err)
	}
	listener, err := net.ListenPacket("udp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	var mu sync.Mutex
	closed := false
	owners := map[string]net.Conn{}
	var workers sync.WaitGroup
	workers.Add(1)
	go func() {
		defer workers.Done()
		var body [65535]byte
		for {
			n, source, err := listener.ReadFrom(body[:])
			if err != nil {
				return
			}
			mu.Lock()
			if closed {
				mu.Unlock()
				return
			}
			peer := owners[source.String()]
			if peer == nil {
				peer, err = (&net.Dialer{}).DialContext(ctx, "udp4", target)
				if err != nil {
					mu.Unlock()
					return
				}
				owners[source.String()] = peer
				workers.Add(1)
				go func(connection net.Conn, original net.Addr) {
					defer workers.Done()
					defer connection.Close()
					var reply [65535]byte
					for {
						n, err := connection.Read(reply[:])
						if err != nil {
							return
						}
						if _, err = listener.WriteTo(reply[:n], original); err != nil {
							return
						}
					}
				}(peer, source)
			}
			mu.Unlock()
			if _, err := peer.Write(body[:n]); err != nil {
				return
			}
		}
	}()
	t.Cleanup(func() {
		mu.Lock()
		closed = true
		all := make([]net.Conn, 0, len(owners))
		for _, connection := range owners {
			all = append(all, connection)
		}
		mu.Unlock()
		cancel()
		_ = listener.Close()
		for _, connection := range all {
			_ = connection.Close()
		}
		joined := make(chan struct{})
		go func() { workers.Wait(); close(joined) }()
		select {
		case <-joined:
		case <-time.After(2 * time.Second):
			t.Error("original H3 ciphertext bridge did not join")
		}
	})
	return listener.LocalAddr().String()
}

// Exercise the new fixture's actual native SOCKS association and encrypted
// relay lifetime without a physical-network claim. The complete H3 peer matrix
// still calls desktopNodePeerInterface before constructing any graph.
func TestRouterVPNImportedNaiveH3SOCKSAssociation(t *testing.T) {
	for _, layer := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		for _, fault := range []string{"success", "relay-route", "control-eof", "cancelled"} {
			t.Run(layer+"/"+fault, func(t *testing.T) {
				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
				defer cancel()
				serverCtx, stopServer := context.WithCancel(ctx)
				defer stopServer()
				server := &desktopNodeLayerServer{ctx: serverCtx, cancel: stopServer, connections: map[io.Closer]bool{}}
				peer, socks := desktopStartImportedSOCKSProvider(t, server, "captured-h3-association", fault)
				defer peer.close()
				inner := "203.0.113.20:443"
				if layer != "off" {
					inner = "10.93.0.1:443"
				}
				private := "127.0.0.1"
				if layer != "off" {
					private = "10.93.0.1"
				}
				routes := &desktopImportedSOCKSLayerRoutes{parent: ctx, control: peer.address, private: private, leases: map[string]*desktopImportedSOCKSRelayLease{}, physical: map[string]string{}}
				defer routes.close()
				socks.mu.Lock()
				socks.entryRelay = routes.relay
				socks.mu.Unlock()
				physical := &desktopImportedNaiveH3Physical{desktopPacketRealityPhysical: newDesktopPacketRealityPhysical("tcp", M.ParseSocksaddr(inner), peer.address), networks: map[string]bool{"tcp": true}, associations: routes}
				var layerServer *desktopNodeLayerServer
				var layerRaw map[string]any
				if layer != "off" {
					layerRaw = map[string]any{"tag": "original-entry-layer", "type": "shadowsocks", "method": mobilemultihop.NativeStartLayerMethod, "password": desktopSSReferenceKey(mobilemultihop.NativeStartLayerMethod, 'q'), "server": "203.0.113.20", "server_port": float64(8388), "detour": physical.Tag()}
					if layer == "aes-256-gcm+xor-whitening" {
						layerRaw["type"] = "routervpn-aes-xor"
						layerRaw["server_port"] = float64(8389)
					}
					layerCtx, stopLayer := context.WithCancel(ctx)
					defer stopLayer()
					layerServer = &desktopNodeLayerServer{ctx: layerCtx, cancel: stopLayer, connections: map[io.Closer]bool{}, routes: []desktopNodeLayerRoute{{Network: "tcp", Destination: inner, Physical: peer.address}}, ownedUDP: routes.acquire}
					layerPeer := desktopImportedSOCKSLayerProvider(t, layerServer, layerRaw, "")
					defer layerPeer.close()
					physical.expected, physical.physical = M.ParseSocksaddr(desktopImportedSOCKSAddress(layerRaw)), layerPeer.address
					physical.associations = nil
					physical.networks["udp"] = true
				}
				defer func() {
					if err := physical.Close(); err != nil {
						t.Error(err)
					}
				}()
				manager := &desktopImportedSOCKSXrayManager{owners: map[string]adapter.Outbound{physical.Tag(): physical}}
				owned := service.ContextWith[adapter.OutboundManager](ctx, manager)
				detour := physical.Tag()
				if layerRaw != nil {
					detour = layerRaw["tag"].(string)
					owner := desktopImportedSOCKSNativeLayer(t, owned, layerRaw)
					manager.owners[detour] = owner
					defer func() {
						if closer, ok := owner.(io.Closer); ok {
							_ = closer.Close()
						}
					}()
				}
				address := M.ParseSocksaddr(inner)
				entry := desktopImportedNaiveH3Entry(t, owned, map[string]any{"type": "socks", "tag": "entry-wg", "server": address.Addr.String(), "server_port": float64(address.Port), "version": "5", "username": "captured-native-user", "password": "captured-h3-association", "detour": detour})
				caller := ctx
				if fault == "cancelled" {
					var stop context.CancelFunc
					caller, stop = context.WithCancel(ctx)
					stop()
				}
				connection, err := entry.DialContext(caller, "udp", M.ParseSocksaddr("192.0.2.99:9999"))
				if connection != nil {
					_ = connection.SetDeadline(time.Now().Add(time.Second))
					err = desktopImportedSOCKSXrayExchange(connection)
					_ = connection.Close()
				}
				if (err == nil) != (fault == "success") {
					t.Fatal("actual SOCKS association/layer result changed", fault, err)
				}
				if fault == "cancelled" && (!errors.Is(err, context.Canceled) || physical.calls.Load() != 0) {
					t.Fatal("cancelled SOCKS caller acquired lower authority", err)
				}
				if err := physical.empty(ctx); err != nil {
					t.Fatal("native SOCKS close did not release its actual lower sockets", err)
				}
				peer.close()
				socks.mu.Lock()
				associations := len(socks.relays)
				socks.mu.Unlock()
				routes.mu.Lock()
				live := len(routes.leases)
				routes.mu.Unlock()
				if live != 0 || socks.joinFailed.Load() {
					t.Fatal("original authenticated control retained relay authority after native close")
				}
				if fault == "cancelled" {
					if associations != 0 || server.rawUDP.Load() != 0 {
						t.Fatal("cancelled caller created an association")
					}
				} else if associations == 0 {
					t.Fatal("fixture failed before the actual authenticated UDP-association reply")
				}
				if fault == "success" && (server.rawUDP.Load() == 0 || server.plainUDP.Load() == 0) {
					t.Fatal("actual SOCKS UDP payload absent")
				}
				if fault == "relay-route" && (layer == "off" && physical.denied.Load() == 0 || layer != "off" && layerServer.rejectedUDP.Load() == 0) {
					t.Fatal("foreign relay escaped original owner")
				}
				if fault == "control-eof" && (server.rawUDP.Load() == 0 || server.plainUDP.Load() != 0) {
					t.Fatal("original control EOF did not precede payload")
				}
			})
		}
	}
