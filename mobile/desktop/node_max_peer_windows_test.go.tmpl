// Three native PQ assets are bounded individually by 2 MiB. This private
// original-source reply includes their normal asset and pipe JSON encodings.
const nodeMAXWFPLimit = 16 << 20
const nodeMAXWFPBuffer = 64 << 10
const nodeMAXWFPProbePrefix = "routervpn-complete-max-owned-marker/"

var nodeMAXWFPModes = []string{"max-quic-wg", "max-quic-awg", "max-tls-wg", "max-tls-awg"}
var nodeMAXWFPLayers = []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"}

// Keep the private reply pipe separate from Go's test failure report. M.Run
// captures os.Stdout for test diagnostics; changing it inside the test is too
// late and can turn an actual reference error into an opaque JSON parse error.
var nodeMAXWFPReplyOutput = os.Stdout

func TestMain(m *testing.M) {
	if os.Getenv("ROUTERVPN_NODE_MAX_WFP_REFERENCE_CHILD") != "" {
		os.Stdout = os.Stderr
	}
	os.Exit(m.Run())
}

func nodeMAXWFPReadLine(reader *bufio.Reader, maximum int) ([]byte, error) {
	var result []byte
	for {
		part, err := reader.ReadSlice('\n')
		if len(part) > maximum-len(result) {
			clear(result)
			return nil, errors.New("MAX private message exceeded its bound")
		}
		result = append(result, part...)
		if errors.Is(err, bufio.ErrBufferFull) {
			continue
		}
		return result, err
	}
}

// The optional reference wrappers preserve each retained original socket and
// every encrypted byte. Only a nonce armed through the private process channel
// is consumed before the selected outermost server protocol. Marker bytes do
// not advance protocol, authentication, payload or DNS counters.
type nodeMAXWFPObservation struct {
	mu     sync.Mutex
	owner  *nodePQLayer
	keys   map[*nodePQLayer]string
	counts map[string]int64
}

func (o *nodeMAXWFPObservation) arm(nonce string) error {
	raw, err := hex.DecodeString(nonce)
	if err != nil || len(raw) != 16 || hex.EncodeToString(raw) != nonce {
		return errors.New("MAX marker is not a canonical private nonce")
	}
	o.mu.Lock()
	defer o.mu.Unlock()
	if o.owner == nil || len(o.counts) >= 128 {
		return errors.New("MAX marker has no selected owner or exceeded its bound")
	}
	if _, found := o.counts[nonce]; found {
		return errors.New("MAX marker reused an owned nonce")
	}
	if o.counts == nil {
		o.counts = make(map[string]int64)
	}
	o.counts[nonce] = 0
	return nil
}

func (o *nodeMAXWFPObservation) count(nonce string) (int64, error) {
	o.mu.Lock()
	defer o.mu.Unlock()
	value, found := o.counts[nonce]
	if !found {
		return 0, errors.New("MAX observation lost its exact armed nonce")
	}
	return value, nil
}

func (o *nodeMAXWFPObservation) consume(owner *nodePQLayer, body []byte) bool {
	if len(body) != len(nodeMAXWFPProbePrefix)+32 || !bytes.HasPrefix(body, []byte(nodeMAXWFPProbePrefix)) {
		return false
	}
	nonce := string(body[len(nodeMAXWFPProbePrefix):])
	o.mu.Lock()
	defer o.mu.Unlock()
	if owner == nil || owner != o.owner {
		return false
	}
	count, found := o.counts[nonce]
	if found {
		o.counts[nonce] = count + 1
	}
	return found
}

type nodeMAXWFPObservedPacket struct {
	net.PacketConn
	owner       *nodePQLayer
	observation *nodeMAXWFPObservation
}

func (p *nodeMAXWFPObservedPacket) ReadFrom(body []byte) (int, net.Addr, error) {
	for {
		n, source, err := p.PacketConn.ReadFrom(body)
		if err != nil || !p.observation.consume(p.owner, body[:n]) {
			return n, source, err
		}
		if written, err := p.PacketConn.WriteTo(body[:n], source); err != nil || written != n {
			return 0, nil, errors.Join(err, io.ErrShortWrite)
		}
	}
}

type nodeMAXWFPObservedStream struct {
	net.Conn
	owner       *nodePQLayer
	observation *nodeMAXWFPObservation
	reader      *bufio.Reader
	classified  bool
}

func (p *nodeMAXWFPObservedStream) Read(body []byte) (int, error) {
	if len(body) == 0 {
		return 0, nil
	}
	if !p.classified {
		// Inspect only the matching prefix. An encrypted fragment with a
		// different first byte immediately proceeds unchanged, even if short.
		for length := 1; length <= len(nodeMAXWFPProbePrefix); length++ {
			prefix, err := p.reader.Peek(length)
			if err != nil || !bytes.Equal(prefix, []byte(nodeMAXWFPProbePrefix[:length])) {
				p.classified = true
				break
			}
		}
		if !p.classified {
			marker, err := p.reader.Peek(len(nodeMAXWFPProbePrefix) + 32)
			if err == nil && p.observation.consume(p.owner, marker) {
				if n, err := p.Conn.Write(marker); err != nil || n != len(marker) {
					return 0, errors.Join(err, io.ErrShortWrite)
				}
				_ = p.Conn.Close()
				return 0, io.EOF
			}
			p.classified = true
		}
	}
	return p.reader.Read(body)
}

func (o *nodeMAXWFPObservation) hooks(t *testing.T) *nodeMAXReferenceHooks {
	t.Helper()
	return &nodeMAXReferenceHooks{
		Interface: func(t *testing.T) (net.Interface, netip.Addr) {
			local := nodePQWFPInterface(t)
			interfaces, err := net.Interfaces()
			if err != nil {
				t.Fatal(err)
			}
			for _, iface := range interfaces {
				addresses, err := iface.Addrs()
				if err != nil {
					t.Fatal(err)
				}
				for _, address := range addresses {
					prefix, err := netip.ParsePrefix(address.String())
					if err == nil && prefix.Addr() == local {
						return iface, local
					}
				}
			}
			t.Fatal("MAX reference lost the actual selected physical interface")
			return net.Interface{}, netip.Addr{}
		},
		Packet: func(owner *nodePQLayer, connection net.PacketConn, password string) net.PacketConn {
			o.mu.Lock()
			if o.keys == nil {
				o.keys = make(map[*nodePQLayer]string)
			}
			if password != "" {
				o.keys[owner] = password
			}
			o.mu.Unlock()
			return &nodeMAXWFPObservedPacket{connection, owner, o}
		},
		Stream: func(owner *nodePQLayer, connection net.Conn) net.Conn {
			return &nodeMAXWFPObservedStream{Conn: connection, owner: owner, observation: o, reader: bufio.NewReader(connection)}
		},
	}
}

