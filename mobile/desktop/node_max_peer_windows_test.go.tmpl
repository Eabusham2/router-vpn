func nodeMAXWFPBoxWithAdmissionGuard(t *testing.T, original *mobilemultihop.NodeProfile, predecessor *mobiletor.DesktopWindowsProtectionTarget, prepare bool, guard func(mobiletor.DesktopWindowsProtectionTarget) error) *nodePQWFPFixture {
	t.Helper()
