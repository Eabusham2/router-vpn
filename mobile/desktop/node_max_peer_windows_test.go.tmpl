func TestRouterVPNDesktopNodeWindowsMAXMarkers(t *testing.T) {
	t.Run("key-epoch-barrier", nodeMAXWFPNativeKeyEpochBarrier)
	t.Run("retained-reference-readback", nodeMAXWFPRetainedReferenceReadback)
	t.Run("retained-middle-idle", nodeMAXWFPRetainedMiddleIdle)
	t.Run("reference-failure-channel", nodeMAXWFPReferenceFailureChannel)
	t.Run("marker-and-authentication", nodeMAXWFPMarkerAuthentication)
	t.Run("packet-authentication", nodeMAXWFPSSPacketAuthentication)
	t.Run("bounded-input", func(t *testing.T) {
		for _, value := range []string{"short\n", strings.Repeat("x", 8192) + "\n"} {
			got, err := nodeMAXWFPReadLine(bufio.NewReaderSize(strings.NewReader(value), 32), len(value))
			if err != nil || string(got) != value {
				t.Fatal("MAX bounded reply lost split original bytes", err)
			}
			if _, err := nodeMAXWFPReadLine(bufio.NewReaderSize(strings.NewReader(value), 32), len(value)-1); err == nil {
				t.Fatal("MAX reply exceeded its exact bounded ownership")
			}
		}
	})
	t.Run("unarmed-and-wrong-owner", func(t *testing.T) {
		owner, other := new(nodePQLayer), new(nodePQLayer)
		observed := &nodeMAXWFPObservation{owner: owner}
		nonce := strings.Repeat("a", 32)
		marker := []byte(nodeMAXWFPProbePrefix + nonce)
		if observed.consume(owner, marker) {
			t.Fatal("MAX consumed an unarmed marker")
		}
		if err := observed.arm(nonce); err != nil {
			t.Fatal(err)
		}
		if observed.consume(other, marker) || observed.consume(owner, append(marker, 0)) {
			t.Fatal("MAX marker escaped its exact owner or frame")
		}
		if count, err := observed.count(nonce); err != nil || count != 0 {
			t.Fatal("MAX wrong-owner observation changed its owned count", err)
		}
		if !observed.consume(owner, marker) {
			t.Fatal("MAX exact armed marker disappeared")
		}
		if count, err := observed.count(nonce); err != nil || count != 1 {
			t.Fatal("MAX exact armed marker has no receipt", err)
		}
		if err := observed.arm(nonce); err == nil {
			t.Fatal("MAX reused a private marker nonce")
		}
	})
	t.Run("encrypted-fragments", func(t *testing.T) {
		for _, body := range [][]byte{{0x16, 0x03, 0x01, 0x00}, []byte("rX"), []byte(nodeMAXWFPProbePrefix + strings.Repeat("b", 32))} {
			left, right := net.Pipe()
			deadline := time.Now().Add(time.Second)
			_ = left.SetDeadline(deadline)
			_ = right.SetDeadline(deadline)
			owner := new(nodePQLayer)
			observed := &nodeMAXWFPObservation{owner: owner}
			reader := &nodeMAXWFPObservedStream{Conn: left, owner: owner, observation: observed, reader: bufio.NewReader(left)}
			done := make(chan error, 1)
			go func() {
				n, err := right.Write(body)
				if err == nil && n != len(body) {
					err = io.ErrShortWrite
				}
				done <- err
			}()
			got := make([]byte, len(body))
			_, readErr := io.ReadFull(reader, got)
			_ = left.Close()
			_ = right.Close()
			writeErr := <-done
			if readErr != nil || writeErr != nil || !bytes.Equal(got, body) {
				t.Fatal("MAX marker wrapper changed an original encrypted fragment", readErr, writeErr)
			}
		}
	})
	t.Run("exact-armed-stream", func(t *testing.T) {
		left, right := net.Pipe()
		defer left.Close()
		defer right.Close()
		deadline := time.Now().Add(time.Second)
		_ = left.SetDeadline(deadline)
		_ = right.SetDeadline(deadline)
		owner := new(nodePQLayer)
		observed := &nodeMAXWFPObservation{owner: owner}
		nonce := strings.Repeat("c", 32)
		if err := observed.arm(nonce); err != nil {
			t.Fatal(err)
		}
		reader := &nodeMAXWFPObservedStream{Conn: left, owner: owner, observation: observed, reader: bufio.NewReader(left)}
		done := make(chan error, 1)
		go func() {
			body := make([]byte, 4096)
			n, err := reader.Read(body)
			if n != 0 || err != io.EOF {
				done <- errors.New("MAX marker entered the encrypted protocol")
			} else {
				done <- nil
			}
		}()
		marker := []byte(nodeMAXWFPProbePrefix + nonce)
		n, writeErr := right.Write(marker)
		answer := make([]byte, len(marker))
		_, readErr := io.ReadFull(right, answer)
		_ = right.Close()
		_ = left.Close()
		joined := <-done
		count, countErr := observed.count(nonce)
		if writeErr != nil || n != len(marker) || readErr != nil || joined != nil || countErr != nil || count != 1 || !bytes.Equal(answer, marker) {
			t.Fatal("MAX armed marker lost its exact echo or joined observation", writeErr, readErr, joined, countErr)
		}
	})
}

