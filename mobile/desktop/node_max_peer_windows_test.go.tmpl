func nodeMAXWFPRequireBlocked(t *testing.T, p *nodeMAXWFPReference) {
	t.Helper()
	if p.probe(t, "positive", nodePQWFPNonce(t)) != 1 {
		t.Fatal("MAX separate-reference positive marker has no independent receipt")
	}
	nonce := nodePQWFPNonce(t)
	if p.probe(t, "arm", nonce) != 0 {
		t.Fatal("MAX denied marker already had traffic")
	}
	echo, err := nodeMAXWFPProbe(p.source.Protocol, netip.MustParseAddrPort(p.source.Physical), nonce, p.request.Layer, p.password)
	before := p.probe(t, "observe", nonce)
	if p.probe(t, "positive", nodePQWFPNonce(t)) != 1 {
		t.Fatal("MAX independent reference lost its actual outer route")
	}
	after := p.probe(t, "observe", nonce)
	if after < before || after != 0 || echo {
		t.Fatal("ordinary token crossed MAX actual outer deny: independent peer marker receipt", p.source.Protocol, after)
	}
	var timeout net.Error
	if !errors.Is(err, syscall.Errno(10013)) && !(errors.As(err, &timeout) && timeout.Timeout()) {
		t.Fatal("MAX ordinary rejection has no bounded native denial or timeout", err)
	}
}

func nodeMAXWFPRequireNative(t *testing.T, f *nodePQWFPFixture, p *nodeMAXWFPReference) {
	t.Helper()
	if f.admitted != 1 || f.prepared.Validate() != nil || f.network.Current() || !f.network.SocketCurrent() || !f.tun.ready.Load() || f.kernel != nil || f.source != nil {
		t.Fatal("MAX native startup omitted its prepared handoff or fabricated a physical owner")
	}
	capture, err := f.policy.Capture()
	if err != nil || capture.SelectedDNS.Host != "192.168.50.133" || capture.SelectedDNS.Detour != "proxy" || capture.SelectedDNS.Physical || len(capture.BootstrapDNS) != 0 || capture.HomeLANAccess || capture.IPv6Mode != "on" {
		t.Fatal("MAX actual WFP changed selected DNS or device policy", err)
	}
	type tuple struct {
		network string
		remote  netip.AddrPort
	}
	expected := map[tuple]bool{{p.source.Protocol, netip.MustParseAddrPort(p.source.Physical)}: true}
	actual := make(map[tuple]bool)
	for _, root := range capture.PhysicalRoots {
		for _, destination := range root.Destinations {
			ip, err := netip.ParseAddr(destination.Host)
			if err != nil || destination.Network != "tcp" && destination.Network != "udp" || destination.Port < 1 || destination.Port > 65535 {
				t.Fatal("MAX captured an invalid native protocol or destination")
			}
			actual[tuple{destination.Network, netip.AddrPortFrom(ip, uint16(destination.Port))}] = true
		}
	}
	if !reflect.DeepEqual(actual, expected) {
		t.Fatal("MAX actual WFP substituted its exact outermost TCP/UDP tuple")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	snapshot, err := mobiletor.DesktopWindowsNodeCompositionSnapshot(ctx)
	if err != nil || snapshot.Closed || snapshot.Target != f.prepared || snapshot.Owner.Kind != "windows-isolated-token" || !snapshot.Options.RetainBaselineForHandoff || len(snapshot.Grants) == 0 {
		t.Fatal("MAX encrypted graph has no actual retained WFP/socket readback", err)
	}
	seen := make(map[tuple]bool)
	for _, grant := range snapshot.Grants {
		key := tuple{grant.Network, grant.Remote}
		if !expected[key] || grant.Capture != f.prepared.Capture || grant.Local.Addr() != p.local || grant.Local.Port() == 0 || grant.Binding.Owner != snapshot.Owner {
			t.Fatal("MAX native grant changed its captured transport, exact tuple or lower owner")
		}
		seen[key] = true
	}
	if !reflect.DeepEqual(seen, expected) {
		t.Fatal("MAX native WFP omitted its exact outermost physical grant")
	}
}

func nodeMAXWFPAgreedKey(t *testing.T, f *nodePQWFPFixture, p *nodeMAXWFPReference, previous [32]byte, epoch int) [32]byte {
	t.Helper()
	native, ok := f.endpoint.base.(nativePQReadback)
	if !ok {
		t.Fatal("actual MAX endpoint lost native PQ readback")
	}
	for deadline := time.Now().Add(2 * time.Second); ; {
		local, err := native.RouterVPNTestPQSnapshot()
		if err != nil {
			t.Fatal(err)
		}
		remote := p.observe(t, "stats")
		if remote.Updates >= int64(epoch+1) && local.KeyDigest == remote.Snapshot.KeyDigest && local.KeyDigest != previous {
			return local.KeyDigest
		}
		if time.Now().After(deadline) {
			t.Fatal("both isolated complete MAX peers did not adopt the same fresh PQ key", epoch)
		}
		time.Sleep(time.Millisecond)
	}
}

func nodeMAXWFPRequireTraffic(t *testing.T, f *nodePQWFPFixture, p *nodeMAXWFPReference, previous [32]byte, rekey bool) [32]byte {
	t.Helper()
	var priorLocal, priorRemote int64
	epochs := 1
	if rekey {
		epochs = 2
	}
	for epoch := 0; epoch < epochs; epoch++ {
		if epoch != 0 {
			p.observe(t, "rekey")
		}
		previous = nodeMAXWFPAgreedKey(t, f, p, previous, epoch)
		native := f.endpoint.base.(nativePQReadback)
		if epoch != 0 {
			p.observe(t, "rehandshake")
			if err := native.RouterVPNTestPQRehandshake(); err != nil {
				t.Fatal(err)
			}
		}
		for _, network := range []string{"tcp", "udp"} {
			for _, host := range []string{"192.0.2.99", "2001:db8::99"} {
				if err := f.exchange(network, host, epoch); err != nil {
					t.Fatal("actual WFP complete MAX encrypted payload failed", network, host, epoch, err)
				}
			}
		}
		local, err := native.RouterVPNTestPQSnapshot()
		remote := p.observe(t, "stats")
		if err != nil || local.KeyDigest != previous || remote.Snapshot.KeyDigest != previous || local.HandshakeNanos <= priorLocal || remote.Snapshot.HandshakeNanos <= priorRemote {
			t.Fatal("actual WFP complete MAX used a stale or different native key and handshake", epoch, err)
		}
		priorLocal, priorRemote = local.HandshakeNanos, remote.Snapshot.HandshakeNanos
	}
	if err := f.box.RouterVPNStrategyDNSProof(); err != nil {
		t.Fatal("actual WFP complete MAX selected Home DNS proof failed", err)
	}
	before := p.observe(t, "fail-dns")
	if before.Queries == 0 {
		t.Fatal("actual WFP complete MAX DNS never reached its selected native peer")
	}
	if err := f.box.RouterVPNStrategyDNSProof(); err == nil {
		t.Fatal("actual WFP complete MAX cached or bypassed selected DNS")
	}
	after := p.observe(t, "restore-dns")
	if after.Queries <= before.Queries {
		t.Fatal("actual WFP complete MAX DNS failure skipped its captured route")
	}
	if err := f.box.RouterVPNStrategyDNSProof(); err != nil {
		t.Fatal("actual WFP complete MAX selected DNS did not recover", err)
	}
	final := p.observe(t, "stats")
	if final.Queries <= after.Queries || final.Packets == 0 || final.KEMReceived == 0 || final.MiddleRaw == 0 || final.MiddlePacket == 0 || final.MiddleKEM == 0 || final.OuterRaw == 0 || final.OuterMiddle == 0 || final.Plain || final.Rejected != 0 || p.request.Layer != "" && final.MiddleOuter == 0 {
		t.Fatal("actual WFP complete MAX omitted a mandatory encrypted lane or fresh selected DNS")
	}
	nodeMAXWFPRequireNative(t, f, p)
	nodeMAXWFPRequireBlocked(t, p)
	return previous
}

