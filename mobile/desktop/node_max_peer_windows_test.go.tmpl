func nodeMAXWFPCredentials(t *testing.T, modes, outerFaults []string) {
	for _, mode := range modes {
		for _, layer := range nodeMAXWFPLayers {
			faults := []string{"kem-peer", "packet-peer", "middle-key"}
			if layer == "" {
				faults = append(faults, outerFaults...)
			}
			for _, fault := range faults {
				t.Run(mode+"/"+nodePQLayerName(layer)+"/"+fault, func(t *testing.T) {
					if err := mobiletor.DesktopWindowsNodeCompositionAbsent(context.Background()); err != nil {
						t.Fatal(err)
					}
					peer := nodeMAXWFPStartReference(t, mode, layer, fault)
					var retained mobiletor.DesktopWindowsProtectionTarget
					nodePQWFPCleanup(t, &retained)
					f := nodeMAXWFPBox(t, peer.original(t, "always"), nil, true)
					if fault == "packet-peer" {
						f.start(t)
						nodeMAXWFPAgreedKey(t, f, peer, [32]byte{}, 0)
						err := f.exchange("tcp", "192.0.2.99", 0)
						observed := peer.observe(t, "stats")
						if err == nil || observed.Packets == 0 || observed.Echoes != 0 || observed.Queries != 0 {
							t.Fatal("actual WFP MAX accepted a wrong captured packet peer after native KEM")
						}
					} else {
						done := make(chan error, 1)
						go func() { done <- f.box.RouterVPNStrategyStart() }()
						completed := false
						for deadline := time.Now().Add(12 * time.Second); ; {
							select {
							case err := <-done:
								completed = true
								if err == nil {
									t.Fatal("actual WFP MAX accepted the substituted authenticated layer credential")
								}
							default:
							}
							observed := peer.observe(t, "stats")
							witnessed := false
							switch fault {
							case "kem-peer":
								witnessed = observed.KEMRejected != 0
							case "middle-key":
								witnessed = observed.MiddleRejected != 0
							case "outer-password":
								witnessed = completed && observed.OuterRejected != 0
							case "outer-mlkem-key":
								witnessed = completed && observed.OuterRaw != 0 && observed.MLKEMRejected
							case "outer-user":
								witnessed = completed && observed.OuterRaw != 0 && observed.UserRejected
							case "outer-name", "outer-trust", "outer-reality-key":
								witnessed = completed && observed.OuterRaw != 0 && observed.OuterRejected == 0
							}
							if witnessed || completed {
								if !witnessed {
									t.Fatal("actual WFP MAX negative missed its actual authenticated rejection", fault)
								}
								break
							}
							if time.Now().After(deadline) {
								f.network.Cancel()
								select {
								case <-done:
								case <-time.After(time.Second):
									t.Error("MAX failed credential startup did not join")
								}
								t.Fatal("actual WFP MAX negative never reached its retained encrypted peer", fault)
							}
							time.Sleep(time.Millisecond)
						}
						observed := peer.observe(t, "stats")
						if f.endpoint.owner.Ready() || f.endpoint.owner.TransportReady() || observed.Updates != 0 || observed.Packets != 0 || observed.Queries != 0 {
							t.Fatal("actual WFP MAX credential failure admitted packet traffic or DNS")
						}
						if fault == "middle-key" && (layer == "" && observed.OuterRaw == 0 || layer != "" && observed.OuterRaw != 0) {
							t.Fatal("actual WFP MAX wrong paired key crossed or omitted its captured authentication stage")
						}
						if fault == "kem-peer" && (observed.OuterRaw == 0 || observed.MiddleRaw == 0) || strings.HasPrefix(fault, "outer-") && observed.KEMReceived != 0 || fault == "middle-key" && observed.KEMReceived != 0 {
							t.Fatal("actual WFP MAX negative crossed or omitted a mandatory layer", fault)
						}
						f.network.Cancel()
						if !completed {
							select {
							case err := <-done:
								if err == nil {
									t.Fatal("MAX cancelled native credential trial reported success")
								}
							case <-time.After(time.Second):
								t.Fatal("MAX cancelled native credential trial did not join")
							}
						}
					}
					retained = f.prepared
					if retained.Validate() != nil || f.admitted != 1 {
						t.Fatal("MAX credential rejection bypassed exact native prepared ownership")
					}
					retained = nodePQWFPDrain(t, f)
					nodeMAXWFPRequireBlocked(t, peer)
				})
			}
		}
	}
}

