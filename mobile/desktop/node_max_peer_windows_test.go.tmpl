// Three native PQ assets are bounded individually by 2 MiB. This private
// original-source reply includes their normal asset and pipe JSON encodings.
const nodeMAXWFPLimit = 16 << 20
const nodeMAXWFPBuffer = 64 << 10
const nodeMAXWFPProbePrefix = "routervpn-complete-max-owned-marker/"

var nodeMAXWFPModes = []string{"max-quic-wg", "max-quic-awg", "max-tls-wg", "max-tls-awg"}
var nodeMAXWFPLayers = []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"}

func nodeMAXWFPReadLine(reader *bufio.Reader, maximum int) ([]byte, error) {
	var result []byte
	for {
		part, err := reader.ReadSlice('\n')
		if len(part) > maximum-len(result) {
			clear(result)
			return nil, errors.New("MAX private message exceeded its bound")
		}
		result = append(result, part...)
		if errors.Is(err, bufio.ErrBufferFull) {
			continue
		}
		return result, err
	}
}

// The optional reference wrappers preserve each retained original socket and
// every encrypted byte. Only a nonce armed through the private process channel
// is consumed before the selected outermost server protocol. Marker bytes do
// not advance protocol, authentication, payload or DNS counters.
type nodeMAXWFPObservation struct {
	mu     sync.Mutex
	owner  *nodePQLayer
	keys   map[*nodePQLayer]string
	counts map[string]int64
}

func (o *nodeMAXWFPObservation) arm(nonce string) error {
	raw, err := hex.DecodeString(nonce)
	if err != nil || len(raw) != 16 || hex.EncodeToString(raw) != nonce {
		return errors.New("MAX marker is not a canonical private nonce")
	}
	o.mu.Lock()
	defer o.mu.Unlock()
	if o.owner == nil || len(o.counts) >= 128 {
		return errors.New("MAX marker has no selected owner or exceeded its bound")
	}
	if _, found := o.counts[nonce]; found {
		return errors.New("MAX marker reused an owned nonce")
	}
	if o.counts == nil {
		o.counts = make(map[string]int64)
	}
	o.counts[nonce] = 0
	return nil
}

func (o *nodeMAXWFPObservation) count(nonce string) (int64, error) {
	o.mu.Lock()
	defer o.mu.Unlock()
	value, found := o.counts[nonce]
	if !found {
		return 0, errors.New("MAX observation lost its exact armed nonce")
	}
	return value, nil
}

func (o *nodeMAXWFPObservation) consume(owner *nodePQLayer, body []byte) bool {
	if len(body) != len(nodeMAXWFPProbePrefix)+32 || !bytes.HasPrefix(body, []byte(nodeMAXWFPProbePrefix)) {
		return false
	}
	nonce := string(body[len(nodeMAXWFPProbePrefix):])
	o.mu.Lock()
	defer o.mu.Unlock()
	if owner == nil || owner != o.owner {
		return false
	}
	count, found := o.counts[nonce]
	if found {
		o.counts[nonce] = count + 1
	}
	return found
}

type nodeMAXWFPObservedPacket struct {
	net.PacketConn
	owner       *nodePQLayer
	observation *nodeMAXWFPObservation
}

func (p *nodeMAXWFPObservedPacket) ReadFrom(body []byte) (int, net.Addr, error) {
	for {
		n, source, err := p.PacketConn.ReadFrom(body)
		if err != nil || !p.observation.consume(p.owner, body[:n]) {
			return n, source, err
		}
		if written, err := p.PacketConn.WriteTo(body[:n], source); err != nil || written != n {
			return 0, nil, errors.Join(err, io.ErrShortWrite)
		}
	}
}

type nodeMAXWFPObservedStream struct {
	net.Conn
	owner       *nodePQLayer
	observation *nodeMAXWFPObservation
	reader      *bufio.Reader
	classified  bool
}

func (p *nodeMAXWFPObservedStream) Read(body []byte) (int, error) {
	if len(body) == 0 {
		return 0, nil
	}
	if !p.classified {
		// Inspect only the matching prefix. An encrypted fragment with a
		// different first byte immediately proceeds unchanged, even if short.
		for length := 1; length <= len(nodeMAXWFPProbePrefix); length++ {
			prefix, err := p.reader.Peek(length)
			if err != nil || !bytes.Equal(prefix, []byte(nodeMAXWFPProbePrefix[:length])) {
				p.classified = true
				break
			}
		}
		if !p.classified {
			marker, err := p.reader.Peek(len(nodeMAXWFPProbePrefix) + 32)
			if err == nil && p.observation.consume(p.owner, marker) {
				if n, err := p.Conn.Write(marker); err != nil || n != len(marker) {
					return 0, errors.Join(err, io.ErrShortWrite)
				}
				_ = p.Conn.Close()
				return 0, io.EOF
			}
			p.classified = true
		}
	}
	return p.reader.Read(body)
}

func (o *nodeMAXWFPObservation) hooks(t *testing.T) *nodeMAXReferenceHooks {
	t.Helper()
	return &nodeMAXReferenceHooks{
		Interface: func(t *testing.T) (net.Interface, netip.Addr) {
			local := nodePQWFPInterface(t)
			interfaces, err := net.Interfaces()
			if err != nil {
				t.Fatal(err)
			}
			for _, iface := range interfaces {
				addresses, err := iface.Addrs()
				if err != nil {
					t.Fatal(err)
				}
				for _, address := range addresses {
					prefix, err := netip.ParsePrefix(address.String())
					if err == nil && prefix.Addr() == local {
						return iface, local
					}
				}
			}
			t.Fatal("MAX reference lost the actual selected physical interface")
			return net.Interface{}, netip.Addr{}
		},
		Packet: func(owner *nodePQLayer, connection net.PacketConn, password string) net.PacketConn {
			o.mu.Lock()
			if o.keys == nil {
				o.keys = make(map[*nodePQLayer]string)
			}
			if password != "" {
				o.keys[owner] = password
			}
			o.mu.Unlock()
			return &nodeMAXWFPObservedPacket{connection, owner, o}
		},
		Stream: func(owner *nodePQLayer, connection net.Conn) net.Conn {
			return &nodeMAXWFPObservedStream{Conn: connection, owner: owner, observation: o, reader: bufio.NewReader(connection)}
		},
	}
}

type nodeMAXWFPRequest struct {
	Schema  int    `json:"schema"`
	Mode    string `json:"mode"`
	Layer   string `json:"layer"`
	Fault   string `json:"fault"`
	Address string `json:"address"`
}

type nodeMAXWFPSource struct {
	Mode     string `json:"mode"`
	Protocol string `json:"protocol"`
	Physical string `json:"physical"`
	Packet   string `json:"packet"`
	KEM      string `json:"kem"`
	Middle   string `json:"middle"`
	Outer    string `json:"outer"`
	Files    []byte `json:"files"`
	Profile  []byte `json:"profile"`
}

func (s nodeMAXWFPSource) digest() string {
	raw, err := json.Marshal(s)
	if err != nil {
		return ""
	}
	defer clear(raw)
	value := sha256.Sum256(raw)
	return hex.EncodeToString(value[:])
}

type nodeMAXWFPReply struct {
	Schema         int                       `json:"schema"`
	AppID          []byte                    `json:"app_id"`
	SourceSHA256   string                    `json:"source_sha256"`
	Source         *nodeMAXWFPSource         `json:"source,omitempty"`
	Password       string                    `json:"password,omitempty"`
	Snapshot       mobilepq.NativePQSnapshot `json:"snapshot"`
	Updates        int64                     `json:"updates"`
	Packets        int64                     `json:"packets"`
	KEMReceived    int64                     `json:"kem_received"`
	KEMRejected    int64                     `json:"kem_rejected"`
	MiddleRaw      int64                     `json:"middle_raw"`
	MiddleRejected int64                     `json:"middle_rejected"`
	MiddlePacket   int64                     `json:"middle_packet"`
	MiddleKEM      int64                     `json:"middle_kem"`
	MiddleOuter    int64                     `json:"middle_outer"`
	OuterRaw       int64                     `json:"outer_raw"`
	OuterRejected  int64                     `json:"outer_rejected"`
	OuterMiddle    int64                     `json:"outer_middle"`
	Queries        int64                     `json:"queries"`
	Echoes         int64                     `json:"echoes"`
	Rejected       int64                     `json:"rejected"`
	Plain          bool                      `json:"plain"`
	MLKEMRejected  bool                      `json:"mlkem_rejected"`
	UserRejected   bool                      `json:"user_rejected"`
	Probe          string                    `json:"probe"`
	ProbeCount     int64                     `json:"probe_count"`
}

func nodeMAXWFPProbe(protocol string, remote netip.AddrPort, nonce, layer, password string) (bool, error) {
	if protocol != "tcp" && protocol != "udp" {
		return false, errors.New("MAX probe changed its captured transport")
	}
	connection, err := net.DialTimeout(protocol+"4", remote.String(), 750*time.Millisecond)
	if err != nil {
		return false, err
	}
	defer connection.Close()
	if err = connection.SetDeadline(time.Now().Add(750 * time.Millisecond)); err != nil {
		return false, err
	}
	payload := []byte(nodeMAXWFPProbePrefix + nonce)
	if layer == "aes-256-gcm+xor-whitening" {
		key, err := startwhitening.Key(mobilemultihop.NativeStartLayerMethod, password)
		if err != nil {
			return false, err
		}
		for i := range payload {
			payload[i] ^= key[i%len(key)]
		}
		clear(key[:])
	}
	if n, err := connection.Write(payload); err != nil || n != len(payload) {
		return false, errors.Join(err, io.ErrShortWrite)
	}
	answer := make([]byte, len(payload))
	if protocol == "tcp" {
		_, err = io.ReadFull(connection, answer)
	} else {
		var n int
		n, err = connection.Read(answer)
		if err == nil && n != len(answer) {
			err = io.ErrUnexpectedEOF
		}
	}
	if err != nil {
		return false, err
	}
	if !bytes.Equal(payload, answer) {
		return false, errors.New("MAX marker changed its exact private nonce")
	}
	return true, nil
}

func TestRouterVPNDesktopNodeWindowsMAXReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NODE_MAX_WFP_REFERENCE_CHILD") == "" {
		return
	}
	if os.Getenv("ROUTERVPN_NODE_MAX_WFP_REFERENCE_CHILD") != "1" {
		t.Fatal("unknown MAX reference owner")
	}
	input := bufio.NewReaderSize(os.Stdin, nodeMAXWFPBuffer)
	raw, err := nodeMAXWFPReadLine(input, 256)
	if err != nil || len(raw) == 0 {
		t.Fatal("MAX reference input is not bounded", err)
	}
	var request nodeMAXWFPRequest
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.DisallowUnknownFields()
	if err = decoder.Decode(&request); err != nil {
		t.Fatal("MAX reference input is not its captured request", err)
	}
	var extra any
	if decoder.Decode(&extra) != io.EOF || request.Schema != 1 || request.Address != nodePQWFPInterface(t).String() {
		t.Fatal("MAX reference changed its captured interface or schema")
	}
	observation := new(nodeMAXWFPObservation)
	hooks := observation.hooks(t)
	var wg, kem *nodePQWFPBridge
	hooks.InnerRoutes = func(t *testing.T, f *nodePQFixture, ip netip.Addr, routes map[M.Socksaddr]string) map[M.Socksaddr]string {
		// Establish stable reference-side sources before publishing the middle
		// route map to its workers. No live map is changed during restoration.
		wg = newNodePQWFPBridge(t, ip, f.reference.Address(), true, f.server.initialKey)
		kem = newNodePQWFPBridge(t, ip, f.server.conn.LocalAddr().String(), true, nil)
		captured := make(map[M.Socksaddr]string, 2)
		for destination, target := range routes {
			switch target {
			case f.reference.Address():
				captured[destination] = wg.address().String()
			case f.server.conn.LocalAddr().String():
				captured[destination] = kem.address().String()
			default:
				t.Fatal("MAX inner reference wrapper received an uncaptured original peer")
			}
		}
		return captured
	}
	var source nodeMAXWFPSource
	f := newNodeMAXFixtureWithAssembly(t, request.Mode, request.Layer, request.Fault,
		func(t *testing.T, f *nodePQFixture, _ net.Interface, ip netip.Addr, mode, protocol string, files, profile []byte, allowed map[netip.AddrPort]bool) *nodePQFixture {
			if f.box != nil || f.kernel != nil || f.network != nil || ip.String() != request.Address || len(allowed) != 1 {
				t.Fatal("MAX reference assembly gained a client owner or changed its outer root")
			}
			var physical netip.AddrPort
			for remote, value := range allowed {
				if !value || remote.Addr() != ip || remote.Port() == 0 {
					t.Fatal("MAX reference lost its original physical tuple")
				}
				physical = remote
			}
			source = nodeMAXWFPSource{Mode: mode, Protocol: protocol, Physical: physical.String(), Files: append([]byte(nil), files...), Profile: append([]byte(nil), profile...)}
			return f
		}, hooks)
	if f.box != nil || f.kernel != nil || f.network != nil {
		t.Fatal("MAX separate reference constructed a modeled client")
	}
	source.Packet, source.KEM, source.Middle, source.Outer = f.packet.String(), f.kem.String(), f.middleDestination.String(), f.outerDestination.String()
	if wg == nil || kem == nil || f.middle.routes[f.packet] != wg.address().String() || f.middle.routes[f.kem] != kem.address().String() {
		t.Fatal("MAX private references lost their captured packet/KEM routes")
	}
	observation.mu.Lock()
	observation.owner = f.outer
	if request.Layer != "" {
		observation.owner = f.middle
	}
	password := observation.keys[f.middle]
	observation.mu.Unlock()
	if password == "" {
		t.Fatal("MAX marker lost the actual paired reference key")
	}
	scope, err := mobiletor.DesktopWindowsNodeCompositionAppID()
	if err != nil || len(scope) == 0 {
		t.Fatal("MAX reference lost its executable identity", err)
	}
	digest := source.digest()
	lane := func(owner *nodePQLayer, destination M.Socksaddr) int64 {
		value, found := owner.lanes.Load(destination)
		if !found {
			return 0
		}
		return value.(*atomic.Int64).Load()
	}
	respond := func(initial bool, nonce string) {
		select {
		case err := <-f.server.failure:
			t.Fatal("MAX actual native reference failed", err)
		default:
		}
		snapshot, err := f.reference.Snapshot()
		if err != nil {
			t.Fatal("MAX actual native reference readback failed", err)
		}
		reply := nodeMAXWFPReply{Schema: 1, AppID: scope, SourceSHA256: digest, Snapshot: snapshot, Updates: f.reference.Updates(), Packets: f.reference.Packets(), KEMReceived: f.server.received.Load(), KEMRejected: f.server.rejected.Load(), MiddleRaw: f.middle.raw.Load(), MiddleRejected: f.middle.rejected.Load(), MiddlePacket: lane(f.middle, f.packet), MiddleKEM: lane(f.middle, f.kem), MiddleOuter: lane(f.middle, f.outerDestination), OuterRaw: f.outer.raw.Load(), OuterRejected: f.outer.rejected.Load(), OuterMiddle: lane(f.outer, f.middleDestination), Queries: f.inner.queries.Load(), Echoes: f.inner.echoes.Load(), Rejected: f.inner.rejected.Load(), Plain: f.reference.PlaintextSeen() || f.middle.plain.Load() || f.outer.plain.Load() || wg.plain.Load() || kem.plain.Load(), Probe: nonce}
		if f.tlsReference != nil {
			diagnostic := f.tlsReference.process.diagnostics()
			reply.MLKEMRejected = strings.Contains(diagnostic, "ML-KEM-768 handshake failed > chacha20poly1305: message authentication failed")
			reply.UserRejected = nodeMAXTLSRejected(diagnostic, "11111111-1111-4111-8111-111111111111")
		}
		if initial {
			reply.Source, reply.Password = &source, password
		}
		if nonce != "" {
			reply.ProbeCount, err = observation.count(nonce)
			if err != nil {
				t.Fatal(err)
			}
		}
		encoded, err := json.Marshal(reply)
		if err != nil || len(encoded)+1 > nodeMAXWFPLimit {
			t.Fatal("MAX reply exceeded its captured bound", err)
		}
		if _, err = os.Stdout.Write(append(encoded, '\n')); err != nil {
			t.Fatal("MAX reference lost its private reply channel", err)
		}
		clear(encoded)
	}
	respond(true, "")
	for {
		line, err := input.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 256 {
			t.Fatal("MAX reference lost its bounded observation input", err)
		}
		action := strings.TrimSuffix(string(line), "\n")
		switch action {
		case "stats":
			respond(false, "")
			continue
		case "fail-dns":
			f.inner.failed.Store(true)
			respond(false, "")
			continue
		case "restore-dns":
			f.inner.failed.Store(false)
			respond(false, "")
			continue
		case "rekey":
			f.server.force(t)
			respond(false, "")
			continue
		case "rehandshake":
			if err := f.reference.Rehandshake(); err != nil {
				t.Fatal(err)
			}
			respond(false, "")
			continue
		case "reset-joined-client":
			wg.reset()
			kem.reset()
			respond(false, "")
			continue
		}
		parts := strings.Split(action, " ")
		if len(parts) != 2 || len(parts[1]) != 32 || parts[0] != "arm" && parts[0] != "observe" && parts[0] != "positive" {
			t.Fatal("MAX reference rejected an unrelated observation request")
		}
		if parts[0] != "observe" {
			if err := observation.arm(parts[1]); err != nil {
				t.Fatal(err)
			}
		}
		if parts[0] == "positive" {
			echo, err := nodeMAXWFPProbe(source.Protocol, netip.MustParseAddrPort(source.Physical), parts[1], request.Layer, password)
			if err != nil || !echo {
				t.Fatal("MAX separate reference marker did not traverse its exact listener", err)
			}
		}
		respond(false, parts[1])
	}
}

type nodeMAXWFPReference struct {
	command                                            *exec.Cmd
	input                                              io.WriteCloser
	output                                             *os.File
	reader                                             *bufio.Reader
	done                                               chan error
	ctx                                                context.Context
	cancel                                             context.CancelFunc
	mu                                                 sync.Mutex
	inputClosed, joined, outputClosed, killed, removed bool
	closeErr                                           error
	diagnostics                                        bytes.Buffer
	request                                            nodeMAXWFPRequest
	reply                                              nodeMAXWFPReply
	source                                             nodeMAXWFPSource
	password                                           string
	local                                              netip.Addr
	workspace, copyPath                                string
	digest                                             [32]byte
}

func (p *nodeMAXWFPReference) read(timeout time.Duration) (nodeMAXWFPReply, error) {
	type result struct {
		reply nodeMAXWFPReply
		err   error
	}
	done := make(chan result, 1)
	go func() {
		raw, err := nodeMAXWFPReadLine(p.reader, nodeMAXWFPLimit)
		defer clear(raw)
		var reply nodeMAXWFPReply
		if err == nil && len(raw) <= nodeMAXWFPLimit {
			decoder := json.NewDecoder(bytes.NewReader(raw))
			decoder.DisallowUnknownFields()
			err = decoder.Decode(&reply)
			var extra any
			if err == nil && decoder.Decode(&extra) != io.EOF {
				err = errors.New("MAX reference appended another reply")
			}
		} else {
			err = errors.Join(err, errors.New("MAX reference response exceeded its bound"))
		}
		done <- result{reply, err}
	}()
	ctx, cancel := context.WithTimeout(p.ctx, timeout)
	defer cancel()
	select {
	case value := <-done:
		return value.reply, value.err
	case <-ctx.Done():
		p.cancel()
		_ = p.output.Close()
		<-done
		return nodeMAXWFPReply{}, ctx.Err()
	}
}

func (p *nodeMAXWFPReference) close() error {
	p.mu.Lock()
	defer p.mu.Unlock()
	if !p.inputClosed {
		_ = p.input.Close()
		p.inputClosed = true
	}
	if !p.joined {
		select {
		case err := <-p.done:
			p.closeErr = errors.Join(p.closeErr, err)
			p.joined = true
		case <-time.After(10 * time.Second):
			if !p.killed {
				p.closeErr = errors.Join(p.closeErr, errors.New("MAX reference ignored its owned input EOF"))
				_ = p.command.Process.Kill()
				p.killed = true
			}
			select {
			case err := <-p.done:
				p.closeErr = errors.Join(p.closeErr, err)
				p.joined = true
			case <-time.After(10 * time.Second):
				return errors.Join(p.closeErr, errors.New("MAX reference retained its unjoined process and private workspace"))
			}
		}
	}
	p.cancel()
	if !p.outputClosed {
		_ = p.output.Close()
		p.outputClosed = true
	}
	if !p.removed {
		raw, err := os.ReadFile(p.copyPath)
		if err != nil || sha256.Sum256(raw) != p.digest {
			return errors.Join(p.closeErr, err, errors.New("retained MAX reference executable changed"))
		}
		if err = os.RemoveAll(p.workspace); err != nil {
			return errors.Join(p.closeErr, err)
		}
		p.removed = true
	}
	return p.closeErr
}

func (p *nodeMAXWFPReference) observe(t *testing.T, action string) nodeMAXWFPReply {
	t.Helper()
	if len(action) > 255 || strings.Contains(action, "\n") {
		t.Fatal("MAX observation escaped its fixed private request")
	}
	if _, err := io.WriteString(p.input, action+"\n"); err != nil {
		t.Fatal("MAX observation lost its retained channel", err)
	}
	reply, err := p.read(10 * time.Second)
	old := p.reply
	if err != nil || reply.Schema != 1 || !bytes.Equal(reply.AppID, old.AppID) || reply.SourceSHA256 != old.SourceSHA256 || reply.Source != nil || reply.Password != "" || reply.Updates < old.Updates || reply.Packets < old.Packets || reply.KEMReceived < old.KEMReceived || reply.KEMRejected < old.KEMRejected || reply.Queries < old.Queries || reply.Echoes < old.Echoes || reply.MiddleRaw < old.MiddleRaw || reply.MiddleRejected < old.MiddleRejected || reply.MiddlePacket < old.MiddlePacket || reply.MiddleKEM < old.MiddleKEM || reply.MiddleOuter < old.MiddleOuter || reply.OuterRaw < old.OuterRaw || reply.OuterRejected < old.OuterRejected || reply.OuterMiddle < old.OuterMiddle || old.MLKEMRejected && !reply.MLKEMRejected || old.UserRejected && !reply.UserRejected || old.Plain && !reply.Plain {
		t.Fatal("MAX reference changed its original source or regressed actual observations", err)
	}
	p.reply = reply
	return reply
}

func (p *nodeMAXWFPReference) probe(t *testing.T, action, nonce string) int64 {
	t.Helper()
	reply := p.observe(t, action+" "+nonce)
	if reply.Probe != nonce || reply.ProbeCount < 0 {
		t.Fatal("MAX marker changed its private nonce")
	}
	return reply.ProbeCount
}

func nodeMAXWFPStartReference(t *testing.T, mode, layer, fault string) *nodeMAXWFPReference {
	t.Helper()
	local := nodePQWFPInterface(t)
	request := nodeMAXWFPRequest{Schema: 1, Mode: mode, Layer: layer, Fault: fault, Address: local.String()}
	actual, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	contents, err := os.ReadFile(actual)
	if err != nil {
		t.Fatal(err)
	}
	workspace, err := os.MkdirTemp("", "routervpn-owned-max-reference-")
	if err != nil {
		t.Fatal(err)
	}
	copyPath := filepath.Join(workspace, "owned-complete-max-reference.test.exe")
	if err = os.WriteFile(copyPath, contents, 0700); err != nil {
		_ = os.RemoveAll(workspace)
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 240*time.Second)
	command := exec.CommandContext(ctx, copyPath, "-test.run=^TestRouterVPNDesktopNodeWindowsMAXReferenceProcess$", "-test.count=1", "-test.timeout=235s")
	command.Env = append(os.Environ(), "ROUTERVPN_NODE_MAX_WFP_REFERENCE_CHILD=1")
	input, err := command.StdinPipe()
	if err != nil {
		cancel()
		_ = os.RemoveAll(workspace)
		t.Fatal(err)
	}
	output, childOutput, err := os.Pipe()
	if err != nil {
		_ = input.Close()
		cancel()
		_ = os.RemoveAll(workspace)
		t.Fatal(err)
	}
	p := &nodeMAXWFPReference{command: command, input: input, output: output, reader: bufio.NewReaderSize(output, nodeMAXWFPBuffer), done: make(chan error, 1), ctx: ctx, cancel: cancel, request: request, local: local, workspace: workspace, copyPath: copyPath, digest: sha256.Sum256(contents)}
	command.Stdout, command.Stderr = childOutput, &p.diagnostics
	if err = command.Start(); err != nil {
		_ = input.Close()
		_ = output.Close()
		_ = childOutput.Close()
		cancel()
		_ = os.RemoveAll(workspace)
		t.Fatal(err)
	}
	_ = childOutput.Close()
	go func() { p.done <- command.Wait() }()
	t.Cleanup(func() {
		if err := p.close(); err != nil {
			// Diagnostics are read only after Wait joined its writer.
			if p.joined {
				t.Errorf("owned MAX reference did not join cleanly: %v; %s", err, p.diagnostics.String())
			} else {
				t.Errorf("owned MAX reference did not join: %v", err)
			}
		}
	})
	raw, err := json.Marshal(request)
	if err != nil || len(raw)+1 > 256 {
		t.Fatal("MAX launch request exceeded its bound", err)
	}
	if _, err = input.Write(append(raw, '\n')); err != nil {
		t.Fatal(err)
	}
	// This is reference construction (native keys and the complete servers),
	// not a relaxed path, KEM, connection, DNS or retirement deadline.
	p.reply, err = p.read(90 * time.Second)
	scope, scopeErr := mobiletor.DesktopWindowsNodeCompositionAppID()
	if err != nil || scopeErr != nil || p.reply.Schema != 1 || len(p.reply.AppID) == 0 || bytes.Equal(scope, p.reply.AppID) || p.reply.Source == nil || p.reply.SourceSHA256 != p.reply.Source.digest() || p.reply.Source.Mode != mode || p.reply.Probe != "" || p.reply.ProbeCount != 0 {
		t.Fatal("MAX reference was not a distinct retained executable and exact original source", err, scopeErr)
	}
	p.source, p.password = *p.reply.Source, p.reply.Password
	p.reply.Source, p.reply.Password = nil, ""
	remote, err := netip.ParseAddrPort(p.source.Physical)
	protocol := "udp"
	if strings.HasPrefix(mode, "max-tls-") {
		protocol = "tcp"
	}
	if err != nil || remote.Addr() != local || remote.Port() == 0 || p.source.Protocol != protocol || p.password == "" {
		t.Fatal("MAX reference replaced its actual TCP/UDP outer tuple", err)
	}
	packet, pe := netip.ParseAddrPort(p.source.Packet)
	kem, ke := netip.ParseAddrPort(p.source.KEM)
	middle, me := netip.ParseAddrPort(p.source.Middle)
	outer, oe := netip.ParseAddrPort(p.source.Outer)
	service, packetPort := netip.MustParseAddr("10.77.0.1"), uint16(51820)
	if strings.HasSuffix(mode, "-awg") {
		service, packetPort = netip.MustParseAddr("10.78.0.1"), 585
	}
	if pe != nil || ke != nil || me != nil || oe != nil || packet != netip.AddrPortFrom(service, packetPort) || kem != netip.AddrPortFrom(service, 51822) || middle.Addr() != service || outer.Addr() != service || middle.Port() == 0 || outer.Port() == 0 || packet == kem || middle == packet || middle == kem || outer == packet || outer == kem {
		t.Fatal("MAX reference changed or aliased its original packet/KEM/middle destinations")
	}
	if p.reply.Packets != 0 || p.reply.KEMReceived != 0 || p.reply.MiddleRaw != 0 || p.reply.OuterRaw != 0 || p.reply.Queries != 0 {
		t.Fatal("MAX reference opened an encrypted path before captured native admission")
	}
	nonce := nodePQWFPNonce(t)
	if p.probe(t, "arm", nonce) != 0 {
		t.Fatal("MAX fresh original-token marker already had traffic")
	}
	echo, err := nodeMAXWFPProbe(protocol, remote, nonce, layer, p.password)
	if err != nil || !echo || p.probe(t, "observe", nonce) != 1 {
		t.Fatal("MAX original-token positive marker missed its actual outer listener", err)
	}
	return p
}

func (p *nodeMAXWFPReference) original(t *testing.T, kill string) *mobilemultihop.NodeProfile {
	t.Helper()
	if p.source.digest() != p.reply.SourceSHA256 || kill != "always" && kill != "on-connect" {
		t.Fatal("MAX original source changed or lost its explicit protection choice")
	}
	profile := p.source.Profile
	if kill == "on-connect" {
		var selected map[string]any
		if json.Unmarshal(profile, &selected) != nil || selected["kill_switch_policy"] != "always" {
			t.Fatal("MAX trial changed its captured original policy")
		}
		selected["kill_switch_policy"] = kill
		var err error
		profile, err = json.Marshal(selected)
		if err != nil {
			t.Fatal(err)
		}
		defer clear(profile)
	}
	original, err := mobilemultihop.NewNodeProfile(p.source.Mode, string(p.source.Files), string(profile), "", "")
	if err != nil {
		t.Fatal("actual Windows MAX original source constructor", err)
	}
	return original
}

