				// Only the original owns the optional fixed whitening listener.
				// The temporary graph has separate keys and the opposite transport.
				trialPeer := nodeMAXWFPStartReference(t, opposite[mode], "", "")
				var retained mobiletor.DesktopWindowsProtectionTarget
				nodePQWFPCleanup(t, &retained)
				original := firstPeer.original(t, "always")
				first := nodeMAXWFPBox(t, original, nil, true)
				first.start(t)
				retained = first.prepared
				previous := nodeMAXWFPRequireTraffic(t, first, firstPeer, [32]byte{}, false)
				retained = nodePQWFPDrain(t, first)
				trial := nodeMAXWFPBox(t, trialPeer.original(t, "on-connect"), &retained, true)
				trial.start(t)
				retained = trial.prepared
				nodeMAXWFPRequireTraffic(t, trial, trialPeer, [32]byte{}, false)
				trial.network.InterfaceUpdated(context.Background())
				retained = nodePQWFPDrain(t, trial)
				firstPeer.observe(t, "reset-joined-client")
				restored := nodeMAXWFPBox(t, original, &retained, true)
				restored.start(t)
				retained = restored.prepared
				if err := nodePQWFPRestoration(first, restored); err != nil || retained.Policy != "always" {
					t.Fatal("actual MAX reverse handoff lost its saved original capture", err)
				}
				first.network.InterfaceUpdated(context.Background())
				if err := first.close(); err != nil {
					t.Fatal(err)
				}
				nodeMAXWFPRequireTraffic(t, restored, firstPeer, previous, false)
				retained = nodePQWFPDrain(t, restored)
			})
		}
	}
}

func TestRouterVPNDesktopNodeWindowsMAXForeignPredecessor(t *testing.T) {
	for _, mode := range nodeMAXWFPModes {
		t.Run(mode, func(t *testing.T) {
			if err := mobiletor.DesktopWindowsNodeCompositionAbsent(context.Background()); err != nil {
				t.Fatal(err)
			}
			peer := nodeMAXWFPStartReference(t, mode, "", "")
			var retained mobiletor.DesktopWindowsProtectionTarget
			nodePQWFPCleanup(t, &retained)
			original := peer.original(t, "always")
			first := nodeMAXWFPBox(t, original, nil, true)
			first.start(t)
			retained = first.prepared
			nodeMAXWFPRequireTraffic(t, first, peer, [32]byte{}, false)
			retained = nodePQWFPDrain(t, first)
			wrong := retained
			wrong.Capture.SourceSHA256 = strings.Repeat("f", 64)
			candidate := nodeMAXWFPBox(t, original, &wrong, true)
			if err := candidate.box.RouterVPNStrategyStart(); err == nil || candidate.admitted != 0 {
				if candidate.admitted != 0 {
					retained = candidate.prepared
				}
				t.Fatal("foreign MAX predecessor reached actual native encrypted startup")
			}
			if err := candidate.close(); err != nil {
				t.Fatal("rejected MAX successor did not join", err)
			}
			if err := mobiletor.DesktopWindowsNodeCompositionVerifyRetained(context.Background(), retained); err != nil {
				t.Fatal("rejected MAX successor changed the original retained deny", err)
			}
		})
	}
}

func TestRouterVPNDesktopNodeWindowsMAXMarkers(t *testing.T) {
	t.Run("bounded-input", func(t *testing.T) {
		for _, value := range []string{"short\n", strings.Repeat("x", 8192) + "\n"} {
			got, err := nodeMAXWFPReadLine(bufio.NewReaderSize(strings.NewReader(value), 32), len(value))
			if err != nil || string(got) != value {
				t.Fatal("MAX bounded reply lost split original bytes", err)
			}
			if _, err := nodeMAXWFPReadLine(bufio.NewReaderSize(strings.NewReader(value), 32), len(value)-1); err == nil {
				t.Fatal("MAX reply exceeded its exact bounded ownership")
			}
		}
	})
	t.Run("unarmed-and-wrong-owner", func(t *testing.T) {
		owner, other := new(nodePQLayer), new(nodePQLayer)
		observed := &nodeMAXWFPObservation{owner: owner}
		nonce := strings.Repeat("a", 32)
		marker := []byte(nodeMAXWFPProbePrefix + nonce)
		if observed.consume(owner, marker) {
			t.Fatal("MAX consumed an unarmed marker")
		}
		if err := observed.arm(nonce); err != nil {
			t.Fatal(err)
		}
		if observed.consume(other, marker) || observed.consume(owner, append(marker, 0)) {
			t.Fatal("MAX marker escaped its exact owner or frame")
		}
		if count, err := observed.count(nonce); err != nil || count != 0 {
			t.Fatal("MAX wrong-owner observation changed its owned count", err)
		}
		if !observed.consume(owner, marker) {
			t.Fatal("MAX exact armed marker disappeared")
		}
		if count, err := observed.count(nonce); err != nil || count != 1 {
			t.Fatal("MAX exact armed marker has no receipt", err)
		}
		if err := observed.arm(nonce); err == nil {
			t.Fatal("MAX reused a private marker nonce")
		}
	})
	t.Run("encrypted-fragments", func(t *testing.T) {
		for _, body := range [][]byte{{0x16, 0x03, 0x01, 0x00}, []byte("rX"), []byte(nodeMAXWFPProbePrefix + strings.Repeat("b", 32))} {
			left, right := net.Pipe()
			deadline := time.Now().Add(time.Second)
			_ = left.SetDeadline(deadline)
			_ = right.SetDeadline(deadline)
			owner := new(nodePQLayer)
			observed := &nodeMAXWFPObservation{owner: owner}
			reader := &nodeMAXWFPObservedStream{Conn: left, owner: owner, observation: observed, reader: bufio.NewReader(left)}
			done := make(chan error, 1)
			go func() {
				n, err := right.Write(body)
				if err == nil && n != len(body) {
					err = io.ErrShortWrite
				}
				done <- err
			}()
			got := make([]byte, len(body))
			_, readErr := io.ReadFull(reader, got)
			_ = left.Close()
			_ = right.Close()
			writeErr := <-done
			if readErr != nil || writeErr != nil || !bytes.Equal(got, body) {
				t.Fatal("MAX marker wrapper changed an original encrypted fragment", readErr, writeErr)
			}
		}
	})
	t.Run("exact-armed-stream", func(t *testing.T) {
		left, right := net.Pipe()
		defer left.Close()
		defer right.Close()
		deadline := time.Now().Add(time.Second)
		_ = left.SetDeadline(deadline)
		_ = right.SetDeadline(deadline)
		owner := new(nodePQLayer)
		observed := &nodeMAXWFPObservation{owner: owner}
		nonce := strings.Repeat("c", 32)
		if err := observed.arm(nonce); err != nil {
			t.Fatal(err)
		}
		reader := &nodeMAXWFPObservedStream{Conn: left, owner: owner, observation: observed, reader: bufio.NewReader(left)}
		done := make(chan error, 1)
		go func() {
			body := make([]byte, 4096)
			n, err := reader.Read(body)
			if n != 0 || err != io.EOF {
				done <- errors.New("MAX marker entered the encrypted protocol")
			} else {
				done <- nil
			}
		}()
		marker := []byte(nodeMAXWFPProbePrefix + nonce)
		n, writeErr := right.Write(marker)
		answer := make([]byte, len(marker))
		_, readErr := io.ReadFull(right, answer)
		_ = right.Close()
		_ = left.Close()
		joined := <-done
		count, countErr := observed.count(nonce)
		if writeErr != nil || n != len(marker) || readErr != nil || joined != nil || countErr != nil || count != 1 || !bytes.Equal(answer, marker) {
			t.Fatal("MAX armed marker lost its exact echo or joined observation", writeErr, readErr, joined, countErr)
		}
	})
}
