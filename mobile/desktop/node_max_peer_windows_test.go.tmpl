// This regression proves the reference's actual native key application and
// retained UDP gate. Complete KEM/MAX traffic remains the separate native
// matrix; an echo here cannot replace that cryptographic acceptance.
func nodeMAXWFPRequireKeyEpochBarrier(t *testing.T, install func([]byte) error, installed func() [32]byte) {
	t.Helper()
	var epoch pqTrafficKeyEpoch
	if gate, err := epoch.afterCurrent(); err == nil || gate != nil {
		t.Fatal("reference armed an epoch without an actual prior key")
	}
	oldKey, nextKey := bytes.Repeat([]byte{0x63}, 32), bytes.Repeat([]byte{0x74}, 32)
	defer clear(oldKey)
	defer clear(nextKey)
	if err := epoch.apply(oldKey, install); err != nil || installed() != sha256.Sum256(oldKey) {
		t.Fatal("reference initial epoch omitted its actual native key", err)
	}
	gate, err := epoch.afterCurrent()
	if err != nil || gate == nil {
		t.Fatal("reference did not capture its next owned key epoch", err)
	}
	if other, err := epoch.afterCurrent(); err == nil || other != nil {
		t.Fatal("reference replaced an already pending key epoch")
	}
	ip := netip.MustParseAddr("127.0.0.1")
	echo, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.AddrPortFrom(ip, 0)))
	if err != nil {
		t.Fatal(err)
	}
	joined := make(chan struct{})
	var received atomic.Int64
	go func() {
		defer close(joined)
		body := make([]byte, 4096)
		for {
			n, remote, err := echo.ReadFromUDPAddrPort(body)
			if err != nil {
				return
			}
			received.Add(1)
			if _, err = echo.WriteToUDPAddrPort(body[:n], remote); err != nil {
				return
			}
		}
	}()
	t.Cleanup(func() { _ = echo.Close(); <-joined })
	oldGate := make(chan struct{})
	close(oldGate)
	bridge := newNodePQWFPBridge(t, ip, echo.LocalAddr().String(), true, oldGate)
	bridge.resetWithKeyBarrier(gate)
	connection, err := net.DialUDP("udp4", nil, net.UDPAddrFromAddrPort(bridge.address()))
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = connection.Close() })
	if err := connection.SetDeadline(time.Now().Add(3 * time.Second)); err != nil {
		t.Fatal(err)
	}
	const body = "retained-next-native-key-epoch"
	if _, err := connection.Write([]byte(body)); err != nil {
		t.Fatal(err)
	}
	for deadline := time.Now().Add(time.Second); bridge.snapshot().Accepted != 1; {
		if time.Now().After(deadline) {
			t.Fatal("next key epoch never captured its actual packet")
		}
		time.Sleep(time.Millisecond)
	}
	held := func() {
		t.Helper()
		select {
		case <-gate:
			t.Fatal("reference released a key epoch without its new native key")
		default:
		}
		if actual := bridge.snapshot(); actual.Forwarded != 0 || actual.Returned != 0 || received.Load() != 0 {
			t.Fatal("restored reference used a stale one-shot key barrier", actual)
		}
	}
	held()
	if err := connection.SetReadDeadline(time.Now().Add(150 * time.Millisecond)); err != nil {
		t.Fatal(err)
	}
	probe := make([]byte, 4096)
	if n, err := connection.Read(probe); n != 0 || err == nil {
		t.Fatal("restored reference crossed its pending key gate", err)
	} else {
		var timeout net.Error
		if !errors.As(err, &timeout) || !timeout.Timeout() {
			t.Fatal("pending key gate lost its original socket", err)
		}
	}
	held()
	if err := epoch.apply(oldKey, install); err != nil || installed() != sha256.Sum256(oldKey) {
		t.Fatal("same-key native application changed its original key", err)
	}
	held()
	if err := epoch.apply(nextKey, func([]byte) error { return install(nil) }); err == nil || installed() != sha256.Sum256(oldKey) {
		t.Fatal("failed native key application released or changed an epoch", err)
	}
	held()
	if err := epoch.apply(nextKey, install); err != nil || installed() != sha256.Sum256(nextKey) {
		t.Fatal("fresh epoch omitted its real native key application", err)
	}
	select {
	case <-gate:
	default:
		t.Fatal("successful original native key application did not release its epoch")
	}
	if err := connection.SetReadDeadline(time.Now().Add(3 * time.Second)); err != nil {
		t.Fatal(err)
	}
	answer := make([]byte, 4096)
	if n, err := connection.Read(answer); err != nil || string(answer[:n]) != body {
		t.Fatal("fresh native key did not release the original retained packet", err)
	}
	pending, err := epoch.afterCurrent()
	if err != nil || pending == nil {
		t.Fatal("next original key epoch could not be captured", err)
	}
	epoch.retire()
	select {
	case <-pending:
		t.Fatal("reference retirement fabricated successful key application")
	default:
	}
	if _, err := epoch.afterCurrent(); err == nil {
		t.Fatal("retired reference accepted a new key epoch")
	}
	if err := epoch.apply(oldKey, install); err == nil || installed() != sha256.Sum256(nextKey) {
		t.Fatal("retired reference mutated its original native key", err)
	}
}

func nodeMAXWFPRetainedReferenceReadback(t *testing.T) {
	t.Helper()
	ip := netip.MustParseAddr("127.0.0.1")
	echo, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.AddrPortFrom(ip, 0)))
	if err != nil {
		t.Fatal(err)
	}
	joined := make(chan struct{})
	var received atomic.Int64
	go func() {
		defer close(joined)
		body := make([]byte, 4096)
		for {
			n, remote, err := echo.ReadFromUDPAddrPort(body)
			if err != nil {
				return
			}
			received.Add(1)
			if _, err = echo.WriteToUDPAddrPort(body[:n], remote); err != nil {
				return
			}
		}
	}()
	t.Cleanup(func() { _ = echo.Close(); <-joined })
	bridge := newNodePQWFPBridge(t, ip, echo.LocalAddr().String(), true, nil)
	otherOwner := newNodePQWFPBridge(t, ip, echo.LocalAddr().String(), true, nil)
	dial := func() *net.UDPConn {
		connection, err := net.DialUDP("udp4", nil, net.UDPAddrFromAddrPort(bridge.address()))
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() { _ = connection.Close() })
		return connection
	}
	first, replacement := dial(), dial()
	exchange := func(connection *net.UDPConn, body string, allowed bool) {
		deadline := 150 * time.Millisecond
		if allowed {
			deadline = time.Second
		}
		if err := connection.SetDeadline(time.Now().Add(deadline)); err != nil {
			t.Fatal(err)
		}
		if n, err := connection.Write([]byte(body)); err != nil || n != len(body) {
			t.Fatal("retained reference observation lost its real packet", err)
		}
		answer := make([]byte, 4096)
		n, err := connection.Read(answer)
		if allowed {
			if err != nil || string(answer[:n]) != body {
				t.Fatal("retained reference observation changed the actual permitted echo", err)
			}
		} else {
			var timeout net.Error
			if !errors.As(err, &timeout) || !timeout.Timeout() || n != 0 {
				t.Fatal("retained reference observation admitted a stale or foreign sender", err)
			}
		}
	}
	wait := func(owner *nodePQWFPBridge, expected nodePQWFPBridgeSnapshot) nodePQWFPBridgeSnapshot {
		for deadline := time.Now().Add(time.Second); ; {
			actual := owner.snapshot()
			if actual == expected {
				return actual
			}
			if time.Now().After(deadline) {
				t.Fatalf("retained reference counters lost actual packet ownership: got=%+v expected=%+v", actual, expected)
			}
			time.Sleep(time.Millisecond)
		}
	}
	exchange(first, "captured-first", true)
	before := wait(bridge, nodePQWFPBridgeSnapshot{Accepted: 1, Forwarded: 1, Returned: 1, Captured: true})
	exchange(replacement, "uncaptured-replacement", false)
	before.OtherDrops = 1
	wait(bridge, before)
	bridge.reset()
	reset := before
	reset.Captured = false
	if actual := wait(bridge, reset); !actual.follows(before) {
		t.Fatal("joined reset incorrectly erased the retained lifetime observations")
	}
	exchange(first, "retired-first", false)
	reset.RetiredDrops = 1
	wait(bridge, reset)
	exchange(replacement, "captured-replacement", true)
	after := wait(bridge, nodePQWFPBridgeSnapshot{Accepted: 2, Forwarded: 2, Returned: 2, RetiredDrops: 1, OtherDrops: 1, Captured: true})
	if received.Load() != 2 || !after.follows(before) || otherOwner.snapshot() != (nodePQWFPBridgeSnapshot{}) {
		t.Fatal("reference counters mixed owners, fabricated forwarding, or lost joined succession")
	}
	for _, regress := range []func(*nodePQWFPBridgeSnapshot){
		func(value *nodePQWFPBridgeSnapshot) { value.Accepted-- },
		func(value *nodePQWFPBridgeSnapshot) { value.Forwarded-- },
		func(value *nodePQWFPBridgeSnapshot) { value.Returned-- },
		func(value *nodePQWFPBridgeSnapshot) { value.RetiredDrops-- },
		func(value *nodePQWFPBridgeSnapshot) { value.OtherDrops-- },
	} {
		changed := after
		regress(&changed)
		if changed.follows(after) {
			t.Fatal("reference accepted a regressed retained observation")
		}
	}
	// An accepted packet may still be waiting for the reference's actual key
	// barrier. Diagnostics must distinguish that state without releasing it.
	barrier := make(chan struct{})
	held := newNodePQWFPBridge(t, ip, echo.LocalAddr().String(), true, barrier)
	connection, err := net.DialUDP("udp4", nil, net.UDPAddrFromAddrPort(held.address()))
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = connection.Close() })
	if err := connection.SetDeadline(time.Now().Add(2 * time.Second)); err != nil {
		t.Fatal(err)
	}
	if _, err := connection.Write([]byte("captured-key-barrier")); err != nil {
		t.Fatal(err)
	}
	wait(held, nodePQWFPBridgeSnapshot{Accepted: 1, Captured: true})
	if received.Load() != 2 {
		t.Fatal("reference readback crossed its retained key barrier")
	}
	close(barrier)
	body := make([]byte, 4096)
	if n, err := connection.Read(body); err != nil || string(body[:n]) != "captured-key-barrier" {
		t.Fatal("reference key barrier did not release its original actual packet", err)
	}
	wait(held, nodePQWFPBridgeSnapshot{Accepted: 1, Forwarded: 1, Returned: 1, Captured: true})
}

func nodeMAXWFPReferenceFailureChannel(t *testing.T) {
	t.Helper()
	binary, err := os.Executable()
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	command := exec.CommandContext(ctx, binary, "-test.run=^TestRouterVPNDesktopNodeWindowsMAXReferenceProcess$", "-test.count=1", "-test.timeout=8s")
	command.Env = append(os.Environ(), "ROUTERVPN_NODE_MAX_WFP_REFERENCE_CHILD=1")
	command.Stdin = strings.NewReader("{\n")
	var protocol, diagnostic bytes.Buffer
	command.Stdout, command.Stderr = &protocol, &diagnostic
	err = command.Run()
	var exit *exec.ExitError
	if ctx.Err() != nil || !errors.As(err, &exit) || exit.ExitCode() != 1 || protocol.Len() != 0 || !strings.Contains(diagnostic.String(), "MAX reference input is not its captured request") {
		t.Fatalf("MAX failed reference lost its strict protocol or original diagnostic: exit=%v protocol=%d diagnostic=%q", err, protocol.Len(), diagnostic.String())
	}
}

func nodeMAXWFPMarkerAuthentication(t *testing.T) {
	t.Helper()
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	owner := &nodePQLayer{ctx: ctx, cancel: cancel, owned: make(map[io.Closer]bool)}
	observed := &nodeMAXWFPObservation{owner: owner}
	password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x42}, 32))
	service, err := shadowaead_2022.NewServiceWithPassword(mobilemultihop.NativeStartLayerMethod, password, 10, owner, nil)
	if err != nil {
		t.Fatal(err)
	}
	hooks := &nodeMAXReferenceHooks{Stream: func(actual *nodePQLayer, connection net.Conn) net.Conn {
		return &nodeMAXWFPObservedStream{Conn: connection, owner: actual, observation: observed, reader: bufio.NewReader(connection)}
	}}
	run := func(client func(net.Conn) error) (error, error) {
		left, right := net.Pipe()
		defer left.Close()
		defer right.Close()
		deadline := time.Now().Add(2 * time.Second)
		if err := errors.Join(left.SetDeadline(deadline), right.SetDeadline(deadline)); err != nil {
			t.Fatal("MAX marker authentication fixture lost its bounded pipes", err)
		}
		if !owner.enter(left) {
			t.Fatal("MAX marker authentication fixture lost its retained connection")
		}
		done := make(chan error, 1)
		go func() { done <- nodeMAXSSStream(owner, service, left, hooks) }()
		clientErr := client(right)
		_ = right.Close()
		_ = left.Close()
		select {
		case serverErr := <-done:
			owner.workers.Wait()
			owner.mu.Lock()
			remaining := len(owner.owned)
			owner.mu.Unlock()
			if remaining != 0 {
				t.Fatal("MAX marker authentication retained a completed connection")
			}
			return serverErr, clientErr
		case <-time.After(3 * time.Second):
			t.Fatal("MAX marker authentication service did not join")
			return nil, nil
		}
	}
	nonce := strings.Repeat("d", 32)
	if err := observed.arm(nonce); err != nil {
		t.Fatal(err)
	}
	serverErr, clientErr := run(func(connection net.Conn) error {
		marker := []byte(nodeMAXWFPProbePrefix + nonce)
		if n, err := connection.Write(marker); err != nil || n != len(marker) {
			return errors.Join(err, io.ErrShortWrite)
		}
		answer := make([]byte, len(marker))
		if _, err := io.ReadFull(connection, answer); err != nil {
			return err
		}
		if !bytes.Equal(answer, marker) {
			return errors.New("MAX marker authentication received another owner's response")
		}
		return nil
	})
	count, countErr := observed.count(nonce)
	if clientErr != nil || !errors.Is(serverErr, io.EOF) || countErr != nil || count != 1 || owner.raw.Load() != 0 || owner.rejected.Load() != 0 {
		t.Fatal("MAX armed marker EOF counted as a credential rejection", serverErr, clientErr, countErr, "raw", owner.raw.Load(), "rejected", owner.rejected.Load())
	}
	serverErr, clientErr = run(func(connection net.Conn) error {
		_, err := connection.Write([]byte{0x16})
		return err
	})
	if clientErr != nil || !errors.Is(serverErr, shadowaead.ErrBadHeader) || owner.raw.Load() == 0 || owner.rejected.Load() != 0 {
		t.Fatal("MAX truncated TCP header counted as a credential rejection", serverErr, clientErr, "raw", owner.raw.Load(), "rejected", owner.rejected.Load())
	}
	valid, err := shadowaead_2022.NewWithPassword(mobilemultihop.NativeStartLayerMethod, password, nil)
	if err != nil {
		t.Fatal(err)
	}
	serverErr, clientErr = run(func(connection net.Conn) error {
		encrypted, err := valid.DialConn(connection, M.ParseSocksaddr("192.0.2.99:9999"))
		if encrypted != nil {
			_ = encrypted.Close()
		}
		return err
	})
	if clientErr != nil || serverErr == nil || !strings.Contains(serverErr.Error(), "PQ layer has no captured TCP forwarding destination") || owner.rejected.Load() != 0 {
		t.Fatal("MAX authenticated forwarding error counted as a credential rejection", serverErr, clientErr, "rejected", owner.rejected.Load())
	}
	wrong := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x24}, 32))
	method, err := shadowaead_2022.NewWithPassword(mobilemultihop.NativeStartLayerMethod, wrong, nil)
	if err != nil {
		t.Fatal(err)
	}
	serverErr, clientErr = run(func(connection net.Conn) error {
		encrypted, err := method.DialConn(connection, M.ParseSocksaddr("192.0.2.99:9999"))
		if encrypted != nil {
			_ = encrypted.Close()
		}
		return err
	})
	if serverErr == nil || !strings.Contains(serverErr.Error(), "cipher: message authentication failed") || owner.raw.Load() == 0 || owner.rejected.Load() != 1 {
		t.Fatal("MAX actual AES key rejection has no authenticated ciphertext witness", serverErr, clientErr, "raw", owner.raw.Load(), "rejected", owner.rejected.Load())
	}
	if nodeMAXSSAuthenticationFailure(serverErr) || nodeMAXSSAuthenticationFailure(errors.Join(errors.Unwrap(serverErr))) {
		t.Fatal("MAX wrapped authentication error replaced the direct cipher cause")
	}
}

func nodeMAXWFPSSPacketAuthentication(t *testing.T) {
	t.Helper()
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	owner := &nodePQLayer{ctx: ctx, cancel: cancel, owned: make(map[io.Closer]bool)}
	password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x42}, 32))
	service, err := shadowaead_2022.NewServiceWithPassword(mobilemultihop.NativeStartLayerMethod, password, 10, owner, nil)
	if err != nil {
		t.Fatal(err)
	}
	encode := func(password string, now func() time.Time) []byte {
		method, err := shadowaead_2022.NewWithPassword(mobilemultihop.NativeStartLayerMethod, password, now)
		if err != nil {
			t.Fatal(err)
		}
		left, right := net.Pipe()
		defer left.Close()
		defer right.Close()
		deadline := time.Now().Add(2 * time.Second)
		if err := errors.Join(left.SetDeadline(deadline), right.SetDeadline(deadline)); err != nil {
			t.Fatal(err)
		}
		writer := method.DialPacketConn(right)
		done := make(chan error, 1)
		go func() {
			_, err := writer.WriteTo([]byte(nodePQPayload), &net.UDPAddr{IP: net.IPv4(192, 0, 2, 99), Port: 9999})
			_ = writer.Close()
			done <- err
		}()
		body := make([]byte, 65535)
		n, readErr := left.Read(body)
		_ = left.Close()
		_ = right.Close()
		select {
		case writeErr := <-done:
			if readErr != nil || writeErr != nil || n < shadowaead_2022.PacketMinimalHeaderSize {
				t.Fatal("MAX packet credential fixture lost its actual ciphertext", readErr, writeErr, n)
			}
		case <-time.After(3 * time.Second):
			t.Fatal("MAX packet credential encoder did not join")
		}
		return body[:n]
	}
	source := M.ParseSocksaddr("192.0.2.10:4444")
	check := func(body []byte) error {
		packet := buf.NewSize(len(body))
		if _, err := packet.Write(body); err != nil {
			packet.Release()
			t.Fatal(err)
		}
		// These inputs all fail before a packet writer or forwarding owner can
		// be used. Passing nil makes an accidental acceptance fail immediately.
		err := nodeMAXSSPacket(owner, service, nil, packet, source)
		packet.Release()
		return err
	}
	if err := check([]byte{0x16}); !errors.Is(err, shadowaead_2022.ErrPacketTooShort) || owner.rejected.Load() != 0 {
		t.Fatal("MAX truncated UDP packet counted as a credential rejection", err, "rejected", owner.rejected.Load())
	}
	stale := encode(password, func() time.Time { return time.Now().Add(-time.Minute) })
	if err := check(stale); !errors.Is(err, shadowaead_2022.ErrBadTimestamp) || owner.rejected.Load() != 0 {
		t.Fatal("MAX authenticated stale UDP packet counted as a credential rejection", err, "rejected", owner.rejected.Load())
	}
	wrong := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x24}, 32))
	if err := check(encode(wrong, nil)); err == nil || !strings.Contains(err.Error(), "decrypt packet: cipher: message authentication failed") || owner.rejected.Load() != 1 {
		t.Fatal("MAX actual UDP AES key rejection has no authenticated ciphertext witness", err, "rejected", owner.rejected.Load())
	}
}

// This real SS2022 client/server regression uses the same nodeMAXSS constructor
// as the native complete-MAX reference. Its final UDP echo is an explicit model
// of packet ciphertext, not an additional WG/AWG, KEM or WFP acceptance claim.
func nodeMAXWFPRetainedMiddleIdle(t *testing.T) {
	t.Helper()
	if nodeMAXReferenceLifetime != 240*time.Second {
		t.Fatal("MAX reference changed its existing bounded child lifetime")
	}
	ip := netip.MustParseAddr("127.0.0.1")
	echo, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.AddrPortFrom(ip, 0)))
	if err != nil {
		t.Fatal(err)
	}
	joined := make(chan struct{})
	go func() {
		defer close(joined)
		body := make([]byte, 65535)
		for {
			n, remote, err := echo.ReadFromUDPAddrPort(body)
			if err != nil {
				return
			}
			if _, err = echo.WriteToUDPAddrPort(body[:n], remote); err != nil {
				return
			}
		}
	}()
	t.Cleanup(func() { _ = echo.Close(); <-joined })
	gate := make(chan struct{})
	close(gate)
	bridge := newNodePQWFPBridge(t, ip, echo.LocalAddr().String(), true, gate)
	destination := M.SocksaddrFrom(netip.MustParseAddr("192.0.2.99"), 9999)
	secret := nodeMAXSecret(t)
	middle := nodeMAXSS(t, nodeMAXUDP(t, ip), nil, secret,
		map[M.Socksaddr]string{destination: bridge.address().String()}, nil, destination, gate, nil)
	newClient := func(password string) net.PacketConn {
		t.Helper()
		method, err := SSClient2022.NewMethod(context.Background(), mobilemultihop.NativeStartLayerMethod, SSClient.MethodOptions{Password: password})
		if err != nil {
			t.Fatal(err)
		}
		wire, err := net.DialUDP("udp4", nil, net.UDPAddrFromAddrPort(middle.address()))
		if err != nil {
			t.Fatal(err)
		}
		client := method.DialPacketConn(wire)
		t.Cleanup(func() { _ = client.Close() })
		return client
	}
	transfer := func(client net.PacketConn, label string) error {
		var nonce [16]byte
		if _, err := rand.Read(nonce[:]); err != nil {
			return err
		}
		payload := append([]byte(nodePQPayload+label+"/"), nonce[:]...)
		if err := client.SetDeadline(time.Now().Add(2 * time.Second)); err != nil {
			return err
		}
		if n, err := client.WriteTo(payload, destination); err != nil || n != len(payload) {
			return errors.Join(err, io.ErrShortWrite)
		}
		answer := make([]byte, 65535)
		n, from, err := client.ReadFrom(answer)
		if err != nil {
			return err
		}
		if !bytes.Equal(answer[:n], payload) || from.String() != destination.String() {
			return errors.New("MAX middle changed its exact encrypted payload or reply destination")
		}
		return nil
	}
	wait := func(want nodePQWFPBridgeSnapshot) {
		t.Helper()
		for deadline := time.Now().Add(time.Second); ; {
			actual := bridge.snapshot()
			if actual == want {
				return
			}
			if time.Now().After(deadline) {
				t.Fatal("MAX middle lost its independently received original association", want, actual)
			}
			time.Sleep(time.Millisecond)
		}
	}
	client := newClient(secret)
	if err := transfer(client, "before-idle"); err != nil {
		t.Fatal("MAX original authenticated middle was not usable", err)
	}
	state := nodePQWFPBridgeSnapshot{Accepted: 1, Forwarded: 1, Returned: 1, Captured: true}
	wait(state)
	// The old reference expired both its authenticated session and UDP NAT at
	// ten seconds. Cross that actual clock boundary without extending any
	// production transfer, startup, crypto, or child-retirement deadline.
	timer := time.NewTimer(11 * time.Second)
	defer timer.Stop()
	select {
	case <-timer.C:
	case <-middle.ctx.Done():
		t.Fatal("MAX retained middle retired before its original idle interval")
	}
	if err := transfer(client, "after-idle"); err != nil {
		t.Fatal("MAX retained authenticated middle changed its owned UDP association", err)
	}
	state.Accepted, state.Forwarded, state.Returned = 2, 2, 2
	wait(state)
	wrong := newClient(nodeMAXSecret(t))
	rejected := middle.rejected.Load()
	if err := transfer(wrong, "wrong-key"); err == nil || middle.rejected.Load() <= rejected {
		t.Fatal("MAX retained middle accepted an incorrect authenticated key", err)
	}
	wait(state)
	foreign, err := net.DialUDP("udp4", nil, net.UDPAddrFromAddrPort(bridge.address()))
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = foreign.Close() })
	if err := foreign.SetWriteDeadline(time.Now().Add(time.Second)); err != nil {
		t.Fatal(err)
	}
	if n, err := foreign.Write([]byte("uncaptured-inner-sender")); err != nil || n != len("uncaptured-inner-sender") {
		t.Fatal("MAX middle foreign-source control never reached its owned listener", err)
	}
	state.OtherDrops++
	wait(state)
	bridge.resetWithKeyBarrier(gate)
	if err := transfer(client, "retired-source"); err == nil {
		t.Fatal("MAX middle re-admitted its explicitly retired source")
	}
	state.Captured = false
	state.RetiredDrops++
	wait(state)
	successor := newClient(secret)
	if err := transfer(successor, "new-owned-source"); err != nil {
		t.Fatal("MAX middle did not admit its independently authenticated successor", err)
	}
	state.Captured = true
	state.Accepted, state.Forwarded, state.Returned = 3, 3, 3
	wait(state)
	if middle.plain.Load() || middle.raw.Load() != 5 {
		t.Fatal("MAX middle bypassed encryption or lost an actual input packet", middle.raw.Load())
	}
	middle.close()
	middle.mu.Lock()
	closed := middle.closing && len(middle.owned) == 0 && middle.ctx.Err() != nil
	middle.mu.Unlock()
	if !closed {
		t.Fatal("MAX retained middle failed immediate owned cancellation and join")
	}
}
