package routervpndesktoppt

import (
	"context"
	"errors"
	"strings"
	"testing"

	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

func TestRouterVPNNodePhysicalAdmissionRetainsExactPolicy(t *testing.T) {
	policy := nodePhysicalPolicyFixture(t, "windows")
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	want := errors.New("captured handoff callback")
	owned, err := WithNodePhysicalAdmission(ctx, policy, func(context.Context, NodePhysicalPrepared) error { return want })
	if err != nil {
		t.Fatal(err)
	}
	admit, err := nodePhysicalAdmissionFor(owned, policy)
	if err != nil || !errors.Is(admit(owned, NodePhysicalPrepared{}), want) {
		t.Fatal("native handoff callback changed its exact owner", err)
	}
	prepared := NodePhysicalPrepared{Capture: mobiletor.DesktopSocketCapture{SessionID: policy.Metadata().SessionID, SourceSHA256: policy.Metadata().SourceSHA256,
		NetworkID: strings.Repeat("a", 32)}, Policy: policy.Metadata().KillSwitchPolicy, BaselineSHA256: strings.Repeat("b", 64)}
	if err := CompleteNodePhysicalAdmission(owned, policy, prepared); !errors.Is(err, want) {
		t.Fatal("actual native handoff dispatch lost its captured callback", err)
	}
	for _, mutate := range []func(*NodePhysicalPrepared){
		func(v *NodePhysicalPrepared) { v.Capture.SourceSHA256 = strings.Repeat("c", 64) },
		func(v *NodePhysicalPrepared) { v.Capture.NetworkID = strings.Repeat("A", 32) },
		func(v *NodePhysicalPrepared) { v.Policy = "off" },
		func(v *NodePhysicalPrepared) { v.BaselineSHA256 = "" },
	} {
		changed := prepared
		mutate(&changed)
		if err := CompleteNodePhysicalAdmission(owned, policy, changed); err == nil || errors.Is(err, want) {
			t.Fatal("foreign native baseline reached the handoff callback", err)
		}
	}
	identical := nodePhysicalPolicyFixture(t, "windows")
	if identical.Config() != policy.Config() {
		t.Fatal("substitution fixture differs")
	}
	if _, err := nodePhysicalAdmissionFor(owned, identical); err == nil {
		t.Fatal("an equal but differently owned graph adopted handoff authority")
	}
	if _, err := WithNodePhysicalAdmission(owned, policy, admit); err == nil {
		t.Fatal("native handoff callback was replaceable")
	}
	if _, err := nodePhysicalAdmissionFor(ctx, policy); err == nil {
		t.Fatal("JSON-only native lifetime acquired handoff authority")
	}
	if _, err := WithNodePhysicalAdmission(nil, policy, admit); err == nil {
		t.Fatal("missing native lifetime acquired handoff authority")
	}
	if _, err := WithNodePhysicalAdmission(ctx, policy, nil); err == nil {
		t.Fatal("missing native callback acquired handoff authority")
	}
	cancel()
	if _, err := nodePhysicalAdmissionFor(owned, policy); err == nil {
		t.Fatal("cancelled native lifetime retained handoff authority")
	}
}

func TestRouterVPNNodePhysicalAdmissionCapturesExactPredecessor(t *testing.T) {
	policy := nodePhysicalPolicyFixture(t, "windows")
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	admit := func(context.Context, NodePhysicalPrepared) error { return nil }
	original := mobiletor.DesktopWindowsProtectionTarget{Capture: mobiletor.DesktopSocketCapture{SessionID: strings.Repeat("1", 32), SourceSHA256: strings.Repeat("2", 64), NetworkID: strings.Repeat("3", 32)},
		Policy: "always", BaselineSHA256: strings.Repeat("4", 64)}
	input := original
	owned, err := WithNodePhysicalSuccessorAdmission(ctx, policy, input, admit)
	if err != nil {
		t.Fatal(err)
	}
	input.Capture.NetworkID, input.BaselineSHA256, input.Policy = strings.Repeat("a", 32), strings.Repeat("b", 64), "on-connect"
	first, err := nodePhysicalPredecessorFor(owned, policy)
	if err != nil || first == nil || *first != original {
		t.Fatal("native predecessor was not captured before waiting", err)
	}
	first.Capture.SourceSHA256 = strings.Repeat("c", 64)
	again, err := nodePhysicalPredecessorFor(owned, policy)
	if err != nil || again == nil || *again != original {
		t.Fatal("native predecessor readback exposed mutable ownership", err)
	}
	if _, err := nodePhysicalPredecessorFor(owned, nodePhysicalPolicyFixture(t, "windows")); err == nil {
		t.Fatal("equal graph adopted another predecessor capability")
	}
	if _, err := WithNodePhysicalSuccessorAdmission(ctx, policy, mobiletor.DesktopWindowsProtectionTarget{}, admit); err == nil {
		t.Fatal("malformed predecessor acquired native admission")
	}
	if _, err := WithNodePhysicalSuccessorAdmission(owned, policy, original, admit); err == nil {
		t.Fatal("native predecessor replaced an existing admission owner")
	}
	initial, err := WithNodePhysicalAdmission(ctx, policy, admit)
	if err != nil {
		t.Fatal(err)
	}
	if target, err := nodePhysicalPredecessorFor(initial, policy); err != nil || target != nil {
		t.Fatal("initial native admission did not require explicit absence", err)
	}
	cancel()
	if _, err := nodePhysicalPredecessorFor(owned, policy); err == nil {
		t.Fatal("cancelled graph retained predecessor authority")
	}
}

func TestRouterVPNNodePhysicalJournalAdmissionCapturesDurableBarrier(t *testing.T) {
	policy := nodePhysicalPolicyFixture(t, "windows")
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	want := errors.New("exact durable parent acknowledgment")
	barrier := func(context.Context, mobiletor.DesktopWindowsProtectionCommit) error { return want }
	admit := func(context.Context, NodePhysicalPrepared) error { return nil }
	predecessor := mobiletor.DesktopWindowsProtectionTarget{Capture: mobiletor.DesktopSocketCapture{SessionID: strings.Repeat("1", 32), SourceSHA256: strings.Repeat("2", 64), NetworkID: strings.Repeat("3", 32)}, Policy: "always", BaselineSHA256: strings.Repeat("4", 64)}
	original := predecessor
	owned, err := WithNodePhysicalJournalAdmission(ctx, policy, &predecessor, barrier, admit)
	if err != nil {
		t.Fatal(err)
	}
	predecessor.BaselineSHA256 = strings.Repeat("a", 64)
	actual, err := nodePhysicalPredecessorFor(owned, policy)
	if err != nil || actual == nil || *actual != original {
		t.Fatal("durable callback retained mutable predecessor authority", err)
	}
	callback, err := nodePhysicalCommitFor(owned, policy)
	if err != nil || callback == nil || !errors.Is(callback(ctx, mobiletor.DesktopWindowsProtectionCommit{}), want) {
		t.Fatal("native factory lost its captured durable callback", err)
	}
	if _, err := WithNodePhysicalJournalAdmission(ctx, policy, nil, nil, admit); err == nil {
		t.Fatal("durable factory accepted a missing parent acknowledgment")
	}
	if _, err := nodePhysicalCommitFor(owned, nodePhysicalPolicyFixture(t, "windows")); err == nil {
		t.Fatal("another compiled graph adopted durable commit authority")
	}
	cancel()
	if _, err := nodePhysicalCommitFor(owned, policy); err == nil {
		t.Fatal("retired graph retained durable commit authority")
	}
}
