package routervpndesktoppt

import (
	"context"
	"errors"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// This callback is an owned native capability installed by the command before
// constructing its Box. Imported options cannot approve a protection handoff.
type ExternalPhysicalPrepared struct {
	Capture        mobiletor.DesktopSocketCapture
	Policy         string
	BaselineSHA256 string
}

type ExternalPhysicalAdmission func(context.Context, ExternalPhysicalPrepared) error
type externalPhysicalAdmissionKey struct{}
type externalPhysicalAdmissionOwner struct {
	policy      *mobilemultihop.DesktopExternalPolicy
	admit       ExternalPhysicalAdmission
	predecessor *mobiletor.DesktopWindowsProtectionTarget
	commit      mobiletor.DesktopWindowsProtectionCommitBarrier
}

func WithExternalPhysicalAdmission(ctx context.Context, policy *mobilemultihop.DesktopExternalPolicy, admit ExternalPhysicalAdmission) (context.Context, error) {
	return withExternalPhysicalAdmission(ctx, policy, nil, nil, admit)
}

// The authenticated parent supplies this durable barrier for the exact sealed
// external policy. A staged transfer record cannot construct the callback or
// replace the original native predecessor capability.
func WithExternalPhysicalJournalAdmission(ctx context.Context, policy *mobilemultihop.DesktopExternalPolicy,
	predecessor *mobiletor.DesktopWindowsProtectionTarget, commit mobiletor.DesktopWindowsProtectionCommitBarrier,
	admit ExternalPhysicalAdmission) (context.Context, error) {
	if commit == nil || predecessor != nil && predecessor.Validate() != nil {
		return nil, errors.New("ordinary external journal admission has no exact durable transaction")
	}
	var previous *mobiletor.DesktopWindowsProtectionTarget
	if predecessor != nil {
		copy := *predecessor
		previous = &copy
	}
	return withExternalPhysicalAdmission(ctx, policy, previous, commit, admit)
}

func withExternalPhysicalAdmission(ctx context.Context, policy *mobilemultihop.DesktopExternalPolicy,
	predecessor *mobiletor.DesktopWindowsProtectionTarget, commit mobiletor.DesktopWindowsProtectionCommitBarrier,
	admit ExternalPhysicalAdmission) (context.Context, error) {
	if ctx == nil || ctx.Err() != nil || policy == nil || policy.Validate() != nil || admit == nil ||
		policy.Metadata().TargetOS != "windows" || ctx.Value(externalPhysicalAdmissionKey{}) != nil {
		return nil, errors.New("ordinary physical handoff requires its unique captured native policy")
	}
	return context.WithValue(ctx, externalPhysicalAdmissionKey{}, &externalPhysicalAdmissionOwner{
		policy: policy, admit: admit, predecessor: predecessor, commit: commit,
	}), nil
}

func externalPhysicalCommitFor(ctx context.Context, policy *mobilemultihop.DesktopExternalPolicy) (mobiletor.DesktopWindowsProtectionCommitBarrier, error) {
	if _, err := externalPhysicalAdmissionFor(ctx, policy); err != nil {
		return nil, err
	}
	return ctx.Value(externalPhysicalAdmissionKey{}).(*externalPhysicalAdmissionOwner).commit, nil
}

func externalPhysicalPredecessorFor(ctx context.Context, policy *mobilemultihop.DesktopExternalPolicy) (*mobiletor.DesktopWindowsProtectionTarget, error) {
	if _, err := externalPhysicalAdmissionFor(ctx, policy); err != nil {
		return nil, err
	}
	owner := ctx.Value(externalPhysicalAdmissionKey{}).(*externalPhysicalAdmissionOwner)
	if owner.predecessor == nil {
		return nil, nil
	}
	captured := *owner.predecessor
	if err := captured.Validate(); err != nil {
		return nil, err
	}
	return &captured, nil
}

func externalPhysicalAdmissionFor(ctx context.Context, policy *mobilemultihop.DesktopExternalPolicy) (ExternalPhysicalAdmission, error) {
	if ctx == nil || ctx.Err() != nil || policy == nil {
		return nil, errors.New("ordinary physical handoff lost its native lifetime")
	}
	owner, ok := ctx.Value(externalPhysicalAdmissionKey{}).(*externalPhysicalAdmissionOwner)
	if !ok || owner == nil || owner.policy != policy || owner.admit == nil {
		return nil, errors.New("ordinary physical handoff has no captured native admission")
	}
	return owner.admit, nil
}

// CompleteExternalPhysicalAdmission consumes only a previously installed
// native capability for this same policy object. It does not create or verify
// kernel policy; the Windows factory supplies its independently read baseline.
func CompleteExternalPhysicalAdmission(ctx context.Context, policy *mobilemultihop.DesktopExternalPolicy, prepared ExternalPhysicalPrepared) error {
	admit, err := externalPhysicalAdmissionFor(ctx, policy)
	if err != nil {
		return err
	}
	metadata := policy.Metadata()
	if prepared.Capture.SessionID != metadata.SessionID || prepared.Capture.SourceSHA256 != metadata.SourceSHA256 ||
		prepared.Policy != metadata.KillSwitchPolicy || !networkSessionID.MatchString(prepared.Capture.NetworkID) || !networkSourceID.MatchString(prepared.BaselineSHA256) {
		return errors.New("ordinary physical handoff substituted its captured native baseline")
	}
	return admit(ctx, prepared)
}
