func TestRouterVPNNativeLinuxResolverClosesDecodedFDArrays(t *testing.T) {
	for _, shape := range []string{"array", "variant-array", "dictionary-array", "structure-array", "dictionary-key", "dictionary-value"} {
		for _, matched := range []bool{false, true} {
			t.Run(fmt.Sprintf("%s/matched-%t", shape, matched), func(t *testing.T) {
				original, err := os.Open("/dev/null")
				if err != nil {
					t.Fatal(err)
				}
				defer original.Close()
				pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
				if err != nil {
					t.Fatal(err)
				}
				open := func(fd int) *net.UnixConn {
					file := os.NewFile(uintptr(fd), "original-FD-array-stream")
					conn, err := net.FileConn(file)
					file.Close()
					if err != nil {
						t.Fatal(err)
					}
					return conn.(*net.UnixConn)
				}
				client, server := open(pair[0]), open(pair[1])
				defer client.Close()
				defer server.Close()
				deadline := time.Now().Add(3 * time.Second)
				client.SetDeadline(deadline)
				server.SetDeadline(deadline)
				serverDone := make(chan error, 1)
				go func() { serverDone <- resolverTestBus(server, int(original.Fd()), shape) }()
				defer func() {
					server.Close()
					select {
					case err := <-serverDone:
						if err != nil && !errors.Is(err, net.ErrClosed) && !errors.Is(err, io.EOF) {
							t.Error(err)
						}
					case <-time.After(time.Second):
						t.Error("original array fixture not joined")
					}
				}()
				conn, err := dbus.DialUnix(client)
				if err != nil {
					t.Fatal(err)
				}
				defer conn.Close()
				if err = conn.Auth([]dbus.Auth{dbus.AuthExternal("0")}); err != nil {
					t.Fatal(err)
				}
				if err = conn.Hello(); err != nil {
					t.Fatal(err)
				}
				ctx, cancel := context.WithDeadline(context.Background(), deadline)
				defer cancel()
				actual := conn.Object("org.freedesktop.DBus", "/org/freedesktop/DBus").CallWithContext(ctx, "org.freedesktop.DBus.GetConnectionCredentials", dbus.FlagNoAutoStart, ":1.77")
				if actual.Err != nil || len(actual.Body) != 1 {
					t.Fatal("actual native FD-array decode", actual.Err, actual.Body)
				}
				received := map[int]*os.File{}
				// Snapshot the decoded native descriptor number for the assertion. Close
				// this observational wrapper before another native allocation can reuse it.
				if err = resolverMessageFDs(actual.Body, received); err != nil || len(received) != 1 {
					t.Fatal("actual decoded FD array missing", shape, err, actual.Body)
				}
				r := &routerVPNLinuxResolver{unique: ":1.77"}
				var pending *routerVPNResolverCall
				if matched {
					pending = resolverTestPending(r, false)
				}
				r.incoming(&dbus.Message{Type: dbus.TypeMethodReply, Headers: map[dbus.HeaderField]dbus.Variant{dbus.FieldReplySerial: dbus.MakeVariant(uint32(17)), dbus.FieldSender: dbus.MakeVariant(":1.77")}, Body: actual.Body})
				if matched {
					if len(pending.fds) != 1 {
						t.Fatal("actual decoded FD array omitted retained descriptor", shape)
					}
					if err = r.clear(pending); err != nil {
						t.Fatal(err)
					}
				}
				for fd, file := range received {
					_, err = unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0)
					closeErr := file.Close()
					if !errors.Is(err, unix.EBADF) {
						t.Fatal("decoded FD array leaked native descriptor", shape, matched, err, closeErr)
					}
				}
			})
		}
	}
}

// Exercise the actual fixed named endpoint through the production O_PATH ->
// /proc/self/fd -> Unix connect/authentication path. Every mutation is inside
// fresh original user/network/mount namespaces with a private /run tmpfs.
func TestRouterVPNNativeLinuxResolverNamedBusNamespace(t *testing.T) {
	const marker = "ROUTERVPN_NATIVE_RESOLVER_NAMED_CASE"
	cases := []string{"original-authenticated", "replaced-endpoint", "untrusted-ancestor", "cancelled-original-child", "resolved-authority", "resolved-authority-namespace", "resolved-authority-daemon-namespace"}
	selected := os.Getenv(marker)
	if selected == "" {
		if os.Geteuid() != 0 {
			t.Fatal("named-bus namespace fixture requires its fixed privileged launcher")
		}
		image, err := os.Executable()
		if err != nil {
			t.Fatal(err)
		}
		var originals []*os.File
		for _, name := range []string{"user", "net", "mnt"} {
			file, err := os.Open("/proc/thread-self/ns/" + name)
			if err != nil {
				t.Fatal(err)
			}
			originals = append(originals, file)
			defer file.Close()
		}
		run, err := os.Open("/run")
		if err != nil {
			t.Fatal(err)
		}
		defer run.Close()
		runInfo, err := run.Stat()
		if err != nil {
			t.Fatal(err)
		}
		for _, name := range cases {
			t.Run(name, func(t *testing.T) {
				ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
				defer cancel()
				pidfd := -1
				command := exec.CommandContext(ctx, image, "-test.v", "-test.run=^TestRouterVPNNativeLinuxResolverNamedBusNamespace$", "-test.timeout=10s")
				command.SysProcAttr = &syscall.SysProcAttr{Cloneflags: syscall.CLONE_NEWUSER | syscall.CLONE_NEWNET | syscall.CLONE_NEWNS,
					UidMappings: []syscall.SysProcIDMap{{ContainerID: 0, HostID: os.Geteuid(), Size: 1}},
					GidMappings: []syscall.SysProcIDMap{{ContainerID: 0, HostID: os.Getegid(), Size: 1}}, GidMappingsEnableSetgroups: false, PidFD: &pidfd}
				command.ExtraFiles = append([]*os.File(nil), originals...)
				command.Env = []string{"PATH=/usr/sbin:/usr/bin:/sbin:/bin", marker + "=" + name}
				var readyRead, readyWrite *os.File
				if name == "cancelled-original-child" {
					readyRead, readyWrite, err = os.Pipe()
					if err != nil {
						t.Fatal(err)
					}
					defer readyRead.Close()
					defer readyWrite.Close()
					command.ExtraFiles = append(command.ExtraFiles, readyWrite)
				}
				var output bytes.Buffer
				command.Stdout, command.Stderr = &output, &output
				if err := command.Start(); err != nil {
					t.Fatal("original named-bus namespace child failed", err)
				}
				if pidfd < 0 {
					cancel()
					waitErr := command.Wait()
					t.Fatal("named child omitted original creation pidfd after join", waitErr)
				}
				originalPIDFD := os.NewFile(uintptr(pidfd), "original-created-named-bus-child")
				defer originalPIDFD.Close()
				pidfdInfo, captureErr := originalPIDFD.Stat()
				if captureErr != nil {
					cancel()
				}
				var readyErr error
				if readyRead != nil {
					_ = readyWrite.Close()
					deadline, _ := ctx.Deadline()
					readyErr = readyRead.SetReadDeadline(deadline)
					var ack [1]byte
					if readyErr == nil {
						_, readyErr = io.ReadFull(readyRead, ack[:])
						if readyErr == nil && ack[0] != 'R' {
							readyErr = errors.New("original named child omitted private namespace acknowledgement")
						}
					}
					cancel()
				}
				waitErr := command.Wait()
				if captureErr != nil || readyErr != nil {
					t.Fatal("original named child capture/readiness failed after join", captureErr, readyErr, waitErr, output.String())
				}
				retired, retireErr := resolverPIDFDCurrent(originalPIDFD, originalPIDFD, pidfdInfo)
				if retireErr != nil || !retired {
					t.Fatal("original named-bus child was not joined", retired, retireErr)
				}
				body := output.String()
				child := "TestRouterVPNNativeLinuxResolverNamedBusNamespace"
				witness := "NAMED-RESOLVER original-authentication-and-cleanup=" + name
				if name == "cancelled-original-child" {
					status, ok := command.ProcessState.Sys().(syscall.WaitStatus)
					if waitErr == nil || ctx.Err() == nil || !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL || strings.Count(body, "=== RUN   "+child+"/"+name+"\n") != 1 {
						t.Fatal("original named child cancellation did not join its exact created process", waitErr, body)
					}
				} else {
					if waitErr != nil {
						t.Fatal("original named-bus namespace child failed", waitErr, body)
					}
					if strings.Count(body, witness) != 1 || strings.Count(body, "=== RUN   "+child+"\n") != 1 || strings.Count(body, "=== RUN   "+child+"/"+name+"\n") != 1 ||
						strings.Count(body, "--- PASS: "+child+" ") != 1 || strings.Count(body, "--- PASS: "+child+"/"+name+" ") != 1 || strings.Contains(body, "--- SKIP:") || strings.Contains(body, "--- FAIL:") || strings.Contains(body, "DATA RACE") || strings.Contains(body, "panic:") {
						t.Fatal("original named-bus child omitted its actual endpoint verdict", name, body)
					}
				}
				for i, namespace := range []string{"user", "net", "mnt"} {
					before, e := originals[i].Stat()
					current, other := os.Stat("/proc/thread-self/ns/" + namespace)
					if e != nil || other != nil || !os.SameFile(before, current) {
						t.Fatal("named-bus child changed original parent namespace", namespace, e, other)
					}
				}
				current, err := os.Stat("/run")
				if err != nil || !os.SameFile(runInfo, current) {
					t.Fatal("named-bus child changed parent /run", err)
				}
				// Never forward nested child RUN/PASS lines to the exact outer gate.
				t.Log(witness)
			})
		}
		return
	}
	known := false
	for _, name := range cases {
		known = known || selected == name
	}
	if !known {
		t.Fatal("unknown original named-bus namespace case")
	}
	for i, name := range []string{"user", "net", "mnt"} {
		original := os.NewFile(uintptr(3+i), "original-named-bus-parent-"+name)
		defer original.Close()
		before, err := original.Stat()
		current, other := os.Stat("/proc/thread-self/ns/" + name)
		var fs syscall.Statfs_t
		if err != nil || other != nil || syscall.Fstatfs(int(original.Fd()), &fs) != nil || fs.Type != 0x6e736673 || os.SameFile(before, current) {
			t.Fatal("named-bus fixture did not retain distinct original namespaces", name, err, other)
		}
	}
	if err := syscall.Mount("", "/", "", syscall.MS_REC|syscall.MS_PRIVATE, ""); err != nil {
		t.Fatal("private original mount propagation", err)
	}
	if err := syscall.Mount("tmpfs", "/run", "tmpfs", 0, "mode=0755"); err != nil {
		t.Fatal("private original resolver run directory", err)
	}
	t.Run(selected, func(t *testing.T) {
		if selected == "cancelled-original-child" {
			ready := os.NewFile(uintptr(6), "original-named-child-ready")
			if _, err := ready.Write([]byte{'R'}); err != nil {
				t.Fatal(err)
			}
			if err := ready.Close(); err != nil {
				t.Fatal(err)
			}
			select {} // Original parent cancellation must join this exact process.
		}
		if strings.HasPrefix(selected, "resolved-authority") {
			resolvedNamedAuthorityCase(t, selected)
		} else {
			resolverNamedBusCase(t, selected)
		}
		t.Log("NAMED-RESOLVER original-authentication-and-cleanup=" + selected)
	})
}

func resolverNamedBusCase(t *testing.T, selected string) {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	native := resolverTestNative(t)
	r := &native.routervpnResolver
	if err := os.Mkdir("/run/dbus", 0755); err != nil {
		t.Fatal(err)
	}
	const path = "/run/dbus/system_bus_socket"
	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
	if err != nil {
		t.Fatal("actual named Unix bind unavailable", err)
	}
	listener.SetUnlinkOnClose(false)
	deadline, _ := ctx.Deadline()
	if err = listener.SetDeadline(deadline); err != nil {
		t.Fatal(err)
	}
	originalInfo, err := os.Lstat(path)
	if err != nil {
		t.Fatal(err)
	}
	originalPath := path
	var replacement *net.UnixListener
	var replacementInfo os.FileInfo
	accepted := make(chan *net.UnixConn, 1)
	served := make(chan error, 1)
	go func() {
		connection, err := listener.AcceptUnix()
		if connection != nil {
			accepted <- connection
		}
		close(accepted)
		if err == nil {
			defer connection.Close()
			if err = connection.SetDeadline(deadline); err == nil {
				err = resolverTestBus(connection, -1, "")
			}
		}
		served <- err
	}()
	cleaned := false
	cleanup := func() {
		if cleaned {
			return
		}
		cleanupCtx, stop := context.WithTimeout(context.Background(), 2*time.Second)
		defer stop()
		if err := native.routervpnLinuxResolverRetire(cleanupCtx); err != nil {
			t.Error("original named-bus resolver did not retire", err)
		}
		if err := listener.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
			t.Error(err)
		}
		select {
		case connection := <-accepted:
			if connection != nil {
				_ = connection.Close()
			} else if selected != "untrusted-ancestor" {
				t.Error("named original endpoint was never accepted")
			}
			if connection != nil && selected == "untrusted-ancestor" {
				t.Error("untrusted named ancestor reached original server")
			}
		case <-cleanupCtx.Done():
			t.Error("original named listener accept was not joined")
			return
		}
		select {
		case err := <-served:
			if err != nil && !errors.Is(err, io.EOF) && !errors.Is(err, net.ErrClosed) {
				t.Error("original named-bus server failed", err)
			}
		case <-cleanupCtx.Done():
			t.Error("original named-bus server was not joined")
			return
		}
		if replacement != nil {
			// Prove original retirement did not close or unlink the newer endpoint.
			current, err := os.Lstat(path)
			if err != nil || !os.SameFile(current, replacementInfo) {
				t.Error("original retirement changed replacement socket", err)
			} else {
				client, err := (&net.Dialer{}).DialContext(cleanupCtx, "unix", path)
				if err != nil {
					t.Error("original retirement stopped replacement endpoint", err)
				} else {
					replacementDeadline, _ := cleanupCtx.Deadline()
					_ = replacement.SetDeadline(replacementDeadline)
					peer, err := replacement.AcceptUnix()
					if err != nil {
						t.Error(err)
					} else {
						_ = peer.Close()
					}
					_ = client.Close()
				}
			}
			if err := replacement.Close(); err != nil {
				t.Error(err)
			}
		}
		for _, item := range []struct {
			path string
			info os.FileInfo
		}{{originalPath, originalInfo}, {path, replacementInfo}} {
			if item.info == nil {
				continue
			}
			current, err := os.Lstat(item.path)
			if err != nil || !os.SameFile(current, item.info) {
				t.Error("fixture refuses replacement socket cleanup", item.path, err)
				continue
			}
			if err := os.Remove(item.path); err != nil {
				t.Error(err)
			}
			if _, err := os.Lstat(item.path); !errors.Is(err, os.ErrNotExist) {
				t.Error("original fixture socket still present", item.path, err)
			}
		}
		cleaned = true
	}
	t.Cleanup(cleanup)
	if selected == "untrusted-ancestor" {
		if err := os.Chmod("/run/dbus", 0777); err != nil {
			t.Fatal(err)
		}
		exists, err := r.captureBus(ctx)
		if err == nil || exists || r.transport != nil {
			t.Fatal("untrusted original named ancestor was accepted", exists, err)
		}
		cleanup()
		return
	}
	exists, err := r.captureBus(ctx)
	if err != nil || !exists {
		t.Fatal("actual original named bus was not captured/authenticated", exists, err)
	}
	if r.bus == nil || !os.SameFile(r.busInfo, originalInfo) || r.transport == nil || r.connection == nil {
		t.Fatal("named capture lost original endpoint capability")
	}
	if err := r.busCurrent(); err != nil {
		t.Fatal(err)
	}
	pending, err := r.query(ctx, "NameHasOwner", "org.freedesktop.resolve1")
	if err != nil {
		t.Fatal("actual named original authenticated query", err)
	}
	var available bool
	if err := pending.call.Store(&available); err != nil || !available {
		t.Fatal("named query did not return its original result", err)
	}
	if err := r.clear(pending); err != nil {
		t.Fatal(err)
	}
	if selected == "replaced-endpoint" {
		originalPath = path + ".original"
		if err := os.Rename(path, originalPath); err != nil {
			t.Fatal(err)
		}
		replacement, err = net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
		if err != nil {
			t.Fatal(err)
		}
		replacement.SetUnlinkOnClose(false)
		replacementInfo, err = os.Lstat(path)
		if err != nil {
			t.Fatal(err)
		}
		if os.SameFile(originalInfo, replacementInfo) {
			t.Fatal("named replacement reused original socket identity")
		}
		if err := r.busCurrent(); err == nil {
			t.Fatal("replaced original named bus path was accepted")
		}
		if _, err := r.captureBus(ctx); err == nil {
			t.Fatal("replacement named endpoint was recaptured")
		}
	}
	cleanup()
}
