func TestRouterVPNNodeMTUNativeBoxCloseFailureRemainsUnacknowledged(t *testing.T) {
	fixture := &desktopNodeMTUCloseService{}
	registry := include.ServiceRegistry()
	boxService.Register[struct{}](registry, "routervpn-node-close-fixture", func(_ context.Context, _ log.ContextLogger, tag string, _ struct{}) (adapter.Service, error) {
		fixture.Adapter = boxService.NewAdapter("routervpn-node-close-fixture", tag)
		return fixture, nil
	})
	ctx, cancel := context.WithCancel(box.Context(context.Background(), include.InboundRegistry(), include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), registry, include.CertificateProviderRegistry()))
	defer cancel()
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(`{"log":{"disabled":true},"outbounds":[{"type":"direct","tag":"direct"}],"services":[{"type":"routervpn-node-close-fixture","tag":"owned-close"}]}`))
	if err != nil {
		t.Fatal(err)
	}
	instance, err := box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = instance.Close() })
	if err := instance.RouterVPNStrategyStart(); err != nil {
		t.Fatal(err)
	}
	owner := &routerVPNExternalNative{box: instance, cancel: cancel}
	for retry := 0; retry < 2; retry++ {
		if err := owner.Close(); err == nil || fixture.closes.Load() != 1 {
			t.Fatal("a failed native Box close became a clean acknowledgement or re-entered its retired managers", err)
		}
	}
}

type desktopNodeMTUStartupInbound struct {
	inbound.Adapter
	ctx      context.Context
	entered  chan struct{}
	force    chan struct{}
	canceled atomic.Bool
	closes   atomic.Int32
}

func (fixture *desktopNodeMTUStartupInbound) waitForCancellation() error {
	close(fixture.entered)
	select {
	case <-fixture.ctx.Done():
		fixture.canceled.Store(true)
		return fixture.ctx.Err()
	case <-fixture.force:
		return errors.New("test-only failed-start release")
	}
}
func (fixture *desktopNodeMTUStartupInbound) Start(stage adapter.StartStage) error {
	if stage == adapter.StartStateStart {
		return fixture.waitForCancellation()
	}
	return nil
}
func (fixture *desktopNodeMTUStartupInbound) Close() error {
	fixture.closes.Add(1)
	return nil
}

func TestRouterVPNNodeMTUOwnedCancellationInterruptsNativeStartup(t *testing.T) {
	for _, phase := range []string{"construction", "start"} {
		for _, trigger := range []string{"stop-file", "parent-context"} {
			t.Run(phase+"/"+trigger, func(t *testing.T) {
				directory, digest := desktopNodeMTUPrivateWorkspace(t)
				fixture := &desktopNodeMTUStartupInbound{entered: make(chan struct{}), force: make(chan struct{})}
				registry := include.InboundRegistry()
				inbound.Register[option.TunInboundOptions](registry, C.TypeTun, func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
					fixture.Adapter, fixture.ctx = inbound.NewAdapter(C.TypeTun, tag), ctx
					if phase == "construction" {
						return nil, fixture.waitForCancellation()
					}
					return fixture, nil
				})
				previous := globalCtx
				globalCtx = box.Context(context.Background(), registry, include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
				defer func() { globalCtx = previous }()
				ctx, cancel := context.WithCancel(context.Background())
				defer cancel()
				done := make(chan error, 1)
				go func() { done <- routerVPNRunNodeMTU(ctx, directory, desktopExternalSession, digest) }()
				var release sync.Once
				finished := false
				defer func() {
					release.Do(func() { close(fixture.force) })
					cancel()
					if !finished {
						_ = desktopExternalWait(t, done)
					}
				}()
				select {
				case <-fixture.entered:
				case <-time.After(3 * time.Second):
					t.Fatal("actual native constructor/start did not enter its captured wait")
				}
				if trigger == "stop-file" {
					desktopExternalStopFile(t, directory, desktopExternalSession, digest)
				} else {
					cancel()
				}
				select {
				case err := <-done:
					finished = true
					if err != nil && strings.Contains(err.Error(), "test-only") {
						t.Fatal("native startup returned the emergency fixture release")
					}
				case <-time.After(3 * time.Second):
					t.Fatal("owned cancellation did not reach the in-flight native context")
				}
				if !fixture.canceled.Load() || phase == "start" && fixture.closes.Load() != 1 {
					t.Fatal("native cancellation did not drain its exact startup owner", fixture.canceled.Load(), fixture.closes.Load())
				}
				desktopNodeMTUStopped(t, directory, digest)
				if _, err := os.Stat(filepath.Join(directory, "node-mtu-status.json")); !errors.Is(err, os.ErrNotExist) {
					t.Fatal("canceled startup published a running MTU owner", err)
				}
			})
		}
	}
}
