// Capture bytes once per parent process. Every provider still receives a new
// exclusive file and therefore its own executable path/AppID and lifetime.
type desktopExternalWFPImage struct {
	data string
	size int64
	digest [32]byte
}
var desktopExternalWFPImageSource struct {
	once sync.Once
	image *desktopExternalWFPImage
	err error
}
func desktopExternalWFPCaptureImage(path string) (*desktopExternalWFPImage, error) {
	named, err := os.Stat(path)
	if err != nil { return nil, err }
	if !named.Mode().IsRegular() || named.Size() <= 0 || named.Size() > 512<<20 {
		return nil, errors.New("provider source is not a bounded regular image")
	}
	file, err := os.Open(path)
	if err != nil { return nil, err }
	defer file.Close()
	before, err := file.Stat()
	if err != nil || !os.SameFile(named,before) || named.Size()!=before.Size() || !named.ModTime().Equal(before.ModTime()) {
		return nil, errors.Join(err,errors.New("provider source identity changed before capture"))
	}
	raw, err := io.ReadAll(io.LimitReader(file,before.Size()+1))
	if err != nil { return nil, err }
	after, err := file.Stat()
	if err != nil { return nil, err }
	current, err := os.Stat(path)
	if err != nil { return nil, err }
	if int64(len(raw))!=before.Size() || !os.SameFile(before,after) || !os.SameFile(before,current) ||
		after.Size()!=before.Size() || current.Size()!=before.Size() ||
		!after.ModTime().Equal(before.ModTime()) || !current.ModTime().Equal(before.ModTime()) {
		return nil, errors.New("provider source changed during capture")
	}
	if err:=file.Close(); err!=nil { return nil,err }
	return &desktopExternalWFPImage{data:string(raw),size:before.Size(),digest:sha256.Sum256(raw)},nil
}
func desktopExternalWFPCapturedImage() (*desktopExternalWFPImage,error) {
	desktopExternalWFPImageSource.once.Do(func(){
		path,err:=os.Executable()
		if err!=nil {desktopExternalWFPImageSource.err=err;return}
		desktopExternalWFPImageSource.image,desktopExternalWFPImageSource.err=desktopExternalWFPCaptureImage(path)
	})
	return desktopExternalWFPImageSource.image,desktopExternalWFPImageSource.err
}
type desktopExternalWFPImageWriter struct {
	writer io.WriteCloser
	closed bool
}
func (w *desktopExternalWFPImageWriter) close() error {
	if w==nil || w.closed {return nil}
	err:=w.writer.Close()
	if err==nil || errors.Is(err,os.ErrClosed) {w.closed=true}
	return err
}
// The returned owner is retained even on failure, so cleanup can retry Close
// on that same object. No partial or unacknowledged copy may be launched.
func (image *desktopExternalWFPImage) write(writer io.WriteCloser) (*desktopExternalWFPImageWriter,error) {
	owner:=&desktopExternalWFPImageWriter{writer:writer}
	var failure error
	if image==nil || int64(len(image.data))!=image.size || image.size==0 {
		failure=errors.New("provider source snapshot is incomplete")
	} else {
		hash:=sha256.New()
		buffer:=make([]byte,64<<10)
		for offset:=0;offset<len(image.data); {
			end:=min(offset+(64<<10),len(image.data))
			// Deliberately avoid WriterTo/ReadFrom fast paths which can merge
			// this into the original whole-image Windows WriteFile call.
			chunk:=buffer[:end-offset]
			copy(chunk,image.data[offset:end])
			n,err:=writer.Write(chunk)
			if n<0 || n>len(chunk) {failure=errors.New("provider copy returned an invalid byte count");break}
			_,_=hash.Write(chunk[:n])
			offset+=n
			if err!=nil {failure=err;break}
			if n!=len(chunk) {failure=io.ErrShortWrite;break}
		}
		if failure==nil && !bytes.Equal(hash.Sum(nil),image.digest[:]) {
			failure=errors.New("provider copy changed its captured source bytes")
		}
	}
	return owner,errors.Join(failure,owner.close())
}
func (image *desktopExternalWFPImage) create(path string) (*desktopExternalWFPImageWriter,error) {
	file,err:=os.OpenFile(path,os.O_WRONLY|os.O_CREATE|os.O_EXCL,0700)
	if err!=nil {return nil,err}
	return image.write(file)
}

func desktopExternalWFPStartReferenceCaptured(t *testing.T, ca *desktopExternalIntegrationCA, fault, protocol string, layer *desktopExternalWFPLayerRequest) *desktopExternalWFPReference {
	t.Helper()
	if (protocol == "hysteria2-layer") != (layer != nil) {
		t.Fatal("reference lost its exact HY2 layer selection")
	}
	peerTest := "TestRouterVPNDesktopExternalWindowsHysteria2Peer"
	if protocol == "router-server" {
		peerTest = "TestRouterVPNDesktopExternalWindowsRouterServerPeer"
	} else if protocol == "socks5" {
		peerTest = "TestRouterVPNDesktopExternalWindowsSOCKSPeer"
	} else if protocol == "wireguard" || protocol == "awg2-fast" || protocol == "awg2-strong" {
		peerTest = "TestRouterVPNDesktopExternalWindowsPacketPeer"
	} else if protocol == "hysteria2-layer" {
		peerTest = "TestRouterVPNDesktopExternalWindowsHysteria2LayerPeer"
	} else if strings.HasPrefix(protocol, "ss-entry/") {
		peerTest = "TestRouterVPNDesktopExternalWindowsSSEntryPeer"
	} else if protocol != "hysteria2" {
		t.Fatal("unknown native external reference protocol")
	}
	image, err := desktopExternalWFPCapturedImage()
	if err != nil { t.Fatal(err) }
	copyPath := filepath.Join(t.TempDir(), "retained-external-provider.test.exe")
	owner, err := image.create(copyPath)
	if owner != nil {
		t.Cleanup(func(){
			if err:=owner.close();err!=nil {t.Error("provider image writer did not close",err)}
		})
	}
	if err != nil { t.Fatal("provider image copy failed",err) }
	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
	command := exec.CommandContext(ctx, copyPath, "-test.run=^"+peerTest+"$", "-test.count=1", "-test.timeout=85s")
	command.Env = append(os.Environ(), "ROUTERVPN_EXTERNAL_WFP_PEER=1")
	input, err := command.StdinPipe()
	if err != nil {
		cancel()
		t.Fatal(err)
	}
	output, childOutput, err := os.Pipe()
	if err != nil {
		_ = input.Close()
		cancel()
		t.Fatal(err)
	}
	p := &desktopExternalWFPReference{command: command, input: input, output: output, reader: bufio.NewReaderSize(output, desktopExternalWFPLimit+1), done: make(chan error, 1), cancel: cancel, local: desktopExternalWFPAddress(t)}
	command.Stdout, command.Stderr = childOutput, &p.diagnostics
	if err := command.Start(); err != nil {
		_ = input.Close()
		_ = output.Close()
		_ = childOutput.Close()
		cancel()
		t.Fatal(err)
	}
	_ = childOutput.Close()
	go func() { p.done <- command.Wait() }()
	t.Cleanup(func() {
		if err := p.close(); err != nil {
			t.Error("external provider cleanup", err, p.diagnostics.String())
		}
	})
	publicCertificate := ca.certificate(t, true)
	if protocol == "router-server" {
		publicCertificate = desktopWFPRouterCompareCertificate(t, ca)
	}
	public, key := desktopExternalWFPCertificate(t, publicCertificate)
	proxy, proxyKey := desktopExternalWFPCertificate(t, ca.certificate(t, true))
	if fault == "final-trust" && strings.HasPrefix(protocol, "ss-entry/hysteria2/") {
		proxy, proxyKey = desktopExternalWFPCertificate(t, newDesktopExternalIntegrationCA(t).certificate(t, true))
	}
	if fault == "trust" {
		if protocol != "hysteria2" && protocol != "hysteria2-layer" {
			public, key = desktopExternalWFPCertificate(t, newDesktopExternalIntegrationCA(t).certificate(t, true))
		} else {
			proxy, proxyKey = desktopExternalWFPCertificate(t, newDesktopExternalIntegrationCA(t).certificate(t, true))
		}
	}
	request := desktopExternalWFPRequest{Schema: 1, Operation: "start", Address: p.local.String(), Fault: fault, Certificate: public, Key: key, ProxyCertificate: proxy, ProxyKey: proxyKey}
	if strings.HasPrefix(protocol, "ss-entry/") {
		parts := strings.Split(protocol, "/")
		if len(parts) != 3 && len(parts) != 5 {
			t.Fatal("SS entry reference selection malformed")
		}
		request.SSEntry = &desktopExternalWFPSSEntryRequest{Final: parts[1], Method: parts[2]}
		if len(parts) == 5 {
			request.SSEntry.EntryLayer, request.SSEntry.FinalLayer = parts[3], parts[4]
			if request.SSEntry.EntryLayer == "off" {
				request.SSEntry.EntryLayer = ""
			}
			if request.SSEntry.FinalLayer == "off" {
				request.SSEntry.FinalLayer = ""
			}
		}
		p.ssEntry = request.SSEntry
	}
	if protocol == "wireguard" || protocol == "awg2-fast" || protocol == "awg2-strong" {
		request.Packet, p.packet = desktopExternalWFPPacketKeys(t, protocol)
	}
	if protocol == "router-server" {
		request.Packet, p.packet = desktopExternalWFPPacketKeys(t, "wireguard")
		request.RouterServer = desktopWFPRouterServerCapture(p.packet)
	}
	if layer != nil {
		captured := *layer
		request.Layer, p.layer = &captured, layer
	}
	encoded, err := json.Marshal(request)
	if err != nil || len(encoded)+1 > desktopExternalWFPLimit {
		t.Fatal("external provider initial capture exceeded bound", err)
	}
	if _, err = input.Write(append(encoded, '\n')); err != nil {
		t.Fatal(err)
	}
	clear(key)
	clear(proxyKey)
	clear(encoded)
	if request.Packet != nil {
		request.Packet.PrivateKey, request.Packet.PreSharedKey = "", ""
		clear(request.Packet.Parameters)
	}
	p.initial, err = p.read()
	p.remote, _ = netip.ParseAddrPort(p.initial.Address)
	scope, scopeErr := mobiletor.DesktopWindowsNodeCompositionAppID()
	if err != nil || scopeErr != nil || p.initial.Schema != 1 || p.remote.Addr() != p.local || p.remote.Port() == 0 || len(p.initial.AppID) == 0 || bytes.Equal(scope, p.initial.AppID) || p.initial.Packets != 0 || p.initial.DNS != 0 || p.initial.Public != 0 || p.initial.Closed {
		t.Fatal("external provider has no separate actual captured executable", err, scopeErr)
	}
	if !desktopWFPRouterServerInitialReceipt(request.RouterServer, p.initial.RouterServer) {
		t.Fatal("Router Server initial authority or counters changed")
	}
	if !desktopWFPSSEntryInitialReceipt(p.ssEntry, p.initial, p.local, p.remote, fault) {
		t.Fatal("SS entry layer initial receipt changed captured owners")
	}
	if layer == nil && (p.initial.LayerMode != "" || p.initial.InnerAddress != "" || p.initial.LayerPackets != 0 || p.initial.LayerAccepted != 0 || p.initial.LayerForwarded != 0 || p.initial.LayerRejected != 0) {
		t.Fatal("ordinary reference acquired an unrequested HY2 layer")
	}
	if layer != nil {
		inner, parseErr := netip.ParseAddrPort(p.initial.InnerAddress)
		if parseErr != nil || inner.Addr() != p.local || inner.Port() == 0 || inner == p.remote || p.initial.LayerMode != layer.Mode ||
			layer.Mode == "aes-256-gcm+xor-whitening" && p.remote.Port() != 8389 || p.initial.LayerPackets != 0 || p.initial.LayerAccepted != 0 || p.initial.LayerForwarded != 0 || p.initial.LayerRejected != 0 {
			t.Fatal("HY2 layer reference changed its captured private and physical owners", parseErr)
		}
	}
	if protocol == "socks5" {
		probe, parseErr := netip.ParseAddrPort(p.initial.ProbeUDP)
		if parseErr != nil || probe.Addr() != p.local || probe.Port() == 0 || p.initial.TCP != 0 || p.initial.Rejected != 0 || p.initial.AuthFailures != 0 || len(p.initial.SOCKS) != 0 {
			t.Fatal("SOCKS reference changed its initial physical listeners or observations", parseErr)
		}
	}
	return p
}

func desktopExternalWFPNonce(t *testing.T) string {
	t.Helper()
	var raw [16]byte
	if _, err := rand.Read(raw[:]); err != nil {
		t.Fatal(err)
	}
	return hex.EncodeToString(raw[:])
}

func desktopExternalWFPRequireBlocked(t *testing.T, p *desktopExternalWFPReference) {
	t.Helper()
	if p.call(t, "self", desktopExternalWFPNonce(t)).Observed != 1 {
		t.Fatal("separate external provider did not prove actual UDP reachability")
	}
	nonce := desktopExternalWFPNonce(t)
	if p.call(t, "arm", nonce).Observed != 0 {
		t.Fatal("fresh external probe already observed")
	}
	echo, err := desktopExternalWFPExchange(p.remote, nonce)
	if p.call(t, "observe", nonce).Observed != 0 || echo {
		t.Fatal("ordinary token bypassed actual external WFP UDP deny: independent peer marker")
	}
	var timeout net.Error
	if !errors.Is(err, syscall.Errno(10013)) && !(errors.As(err, &timeout) && timeout.Timeout()) {
		t.Fatal("ordinary UDP denial lacked actual bounded result", err)
	}
	if p.call(t, "self", desktopExternalWFPNonce(t)).Observed != 1 || p.call(t, "observe", nonce).Observed != 0 {
		t.Fatal("denied external marker arrived after independently live provider readback")
	}
}

// The real Wintun handle supplies identity to the unchanged BFE BindTunnel.
// Only packet pumping and route/address/DNS installation are omitted. MTU is
// the captured reader option; the separate production routing gate owns its
// kernel interface setting, and the ordinary Box suite owns MTU replacement.
type desktopExternalWFPTUN struct {
	inbound.Adapter
	mu                     sync.Mutex
	ctx                    context.Context
	options                option.TunInboundOptions
	reader                 *tun.NativeTun
	index                  int
	luid                   uint64
	ready, claimed, closed bool
	guard                  func() bool
	guardContext           func(context.Context) error
}

func (t *desktopExternalWFPTUN) Start(stage adapter.StartStage) error {
	t.mu.Lock()
	defer t.mu.Unlock()
	if stage == adapter.StartStateStart {
		if t.reader != nil || t.closed {
			return errors.New("external Wintun reader startup repeated")
		}
		reader, err := tun.New(tun.Options{Name: t.options.InterfaceName, MTU: t.options.MTU, AutoRoute: false, DNSMode: tun.DNSModeDisabled, EXP_ExternalConfiguration: true})
		if err != nil {
			return err
		}
		var ok bool
		t.reader, ok = reader.(*tun.NativeTun)
		if !ok || t.reader == nil {
			_ = reader.Close()
			return errors.New("external Wintun fixture lost its actual native handle")
		}
		if err := t.reader.Start(); err != nil {
			return err
		}
		t.luid = t.reader.LUID()
		wait, cancel := context.WithTimeout(t.ctx, 10*time.Second)
		defer cancel()
		tick := time.NewTicker(10 * time.Millisecond)
		defer tick.Stop()
		for {
			actual, err := net.InterfaceByName(t.options.InterfaceName)
			if err == nil && actual.Flags&net.FlagUp != 0 && actual.Flags&net.FlagLoopback == 0 {
				t.index = actual.Index
				break
			}
			select {
			case <-wait.Done():
				return errors.New("owned external Wintun interface never became ready")
			case <-tick.C:
			}
		}
	}
	if stage == adapter.StartStateStarted {
		if t.reader == nil || t.index <= 0 || t.luid == 0 {
			return errors.New("external Wintun readiness preceded actual identity")
		}
		t.ready = true
	}
	return nil
}
func (t *desktopExternalWFPTUN) Close() error {
	t.mu.Lock()
	defer t.mu.Unlock()
	t.closed = true
	t.ready = false
	if t.reader != nil {
		return t.reader.Close()
	}
	return nil
}
func (t *desktopExternalWFPTUN) readback() (string, int, int, error) {
	if !t.ready || t.closed || t.reader == nil || t.luid == 0 || t.reader.LUID() != t.luid {
		return "", 0, 0, errors.New("external Wintun owner is retired")
	}
	name, err := t.reader.Name()
	actual, readErr := net.InterfaceByIndex(t.index)
	mtu, mtuErr := t.reader.MTU()
	if err != nil || readErr != nil || mtuErr != nil || actual.Name != name || name != t.options.InterfaceName || actual.Flags&net.FlagUp == 0 || actual.Flags&net.FlagLoopback != 0 || mtu != int(t.options.MTU) {
		return "", 0, 0, errors.New("external Wintun actual handle/interface changed")
	}
	return name, t.index, mtu, nil
}
func (t *desktopExternalWFPTUN) RouterVPNDesktopMTU(guard func() bool) (string, int, int, error) {
	t.mu.Lock()
	defer t.mu.Unlock()
	if t.claimed || guard == nil || !guard() {
		return "", 0, 0, errors.New("external Wintun claim is stale")
	}
	name, index, mtu, err := t.readback()
	if err == nil {
		t.claimed = true
		t.guard = guard
	}
	return name, index, mtu, err
}
func (t *desktopExternalWFPTUN) RouterVPNDesktopMTUInterface() (string, int, int, error) {
	t.mu.Lock()
	defer t.mu.Unlock()
	if !t.claimed || t.guard == nil || !t.guard() {
		return "", 0, 0, errors.New("external Wintun readback is unclaimed or stale")
	}
	return t.readback()
}

func (t *desktopExternalWFPTUN) RouterVPNDesktopMTUContext(ctx context.Context, guard func(context.Context) error) (string, int, int, error) {
	if err := adapter.RouterVPNLockContext(ctx, &t.mu); err != nil {
		return "", 0, 0, err
	}
	defer t.mu.Unlock()
	if t.claimed || guard == nil {
		return "", 0, 0, errors.New("external Wintun claim is stale")
	}
	if err := guard(ctx); err != nil {
		return "", 0, 0, err
	}
	name, index, mtu, err := t.readback()
	if err != nil {
		return "", 0, 0, err
	}
	if err := ctx.Err(); err != nil {
		return "", 0, 0, err
	}
	t.claimed, t.guardContext = true, guard
	t.guard = func() bool { return guard(t.ctx) == nil }
	return name, index, mtu, nil
}
func (t *desktopExternalWFPTUN) RouterVPNDesktopMTUInterfaceContext(ctx context.Context) (string, int, int, error) {
	if err := adapter.RouterVPNLockContext(ctx, &t.mu); err != nil {
		return "", 0, 0, err
	}
	defer t.mu.Unlock()
	if !t.claimed || t.guardContext == nil {
		return "", 0, 0, errors.New("external Wintun readback has no bounded owner")
	}
	if err := t.guardContext(ctx); err != nil {
		return "", 0, 0, err
	}
	name, index, mtu, err := t.readback()
	if err != nil {
		return "", 0, 0, err
	}
	if err := ctx.Err(); err != nil {
		return "", 0, 0, err
	}
	return name, index, mtu, nil
}

type desktopExternalWFPFixture struct {
