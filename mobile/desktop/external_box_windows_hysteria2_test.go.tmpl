// This fixture uses the shipping native external owner, BFE/isolated sockets,
// encrypted Hysteria2, DNS/TLS proof and exact retained successor. Its observer
// adds only the actual test AppID to every rule; the copied provider executable
// is independently outside that scope. The uniquely owned Wintun reader never
// installs routes, addresses or DNS. Journal storage callbacks and the inbound
// packet pump remain explicit fixtures; this is not app/device acceptance.
const desktopExternalWFPLimit = 64 << 10
const desktopExternalWFPProbePrefix = "routervpn-ordinary-wfp:"

type desktopExternalWFPRequest struct {
	RouterServer                                 *desktopWFPRouterServerRequest    `json:"router_server,omitempty"`
	SSEntry                                      *desktopExternalWFPSSEntryRequest `json:"ss_entry,omitempty"`
	Layer                                        *desktopExternalWFPLayerRequest   `json:"layer,omitempty"`
	Packet                                       *desktopExternalWFPPacketRequest  `json:"packet,omitempty"`
	Schema                                       int                               `json:"schema"`
	Operation                                    string                            `json:"operation"`
	Address                                      string                            `json:"address,omitempty"`
	Fault                                        string                            `json:"fault,omitempty"`
	Certificate, Key, ProxyCertificate, ProxyKey []byte
	Nonce                                        string `json:"nonce,omitempty"`
}

type desktopExternalWFPReply struct {
	RouterServer                                                       *desktopWFPRouterServerReceipt `json:"router_server,omitempty"`
	SSEntryInner                                                       string
	SSEntryLayer, SSFinalLayer                                         *desktopWFPSSEntryLayerReceipt
	SSEntryTCP, SSEntryUDP, SSEntryRejected, SSEntryPublic, SSEntryTLS int32
	LayerLatencyDNS, LayerLatencyTLS, LayerLatencyRequests             int32  `json:",omitempty"`
	LayerMode, InnerAddress                                            string `json:",omitempty"`
	LayerPackets, LayerAccepted, LayerForwarded, LayerRejected         int32  `json:",omitempty"`
	Schema                                                             int    `json:"schema"`
	Address                                                            string `json:"address"`
	AppID                                                              []byte `json:"app_id"`
	Nonce                                                              string `json:"nonce,omitempty"`
	Observed                                                           int    `json:"observed"`
	Packets, DNS, UDPDNS, TLS, Public, Attempts                        int32
	Closed                                                             bool                                 `json:"closed"`
	TCP, Rejected, AuthFailures                                        int32                                `json:",omitempty"`
	ProbeUDP                                                           string                               `json:"probe_udp,omitempty"`
	SOCKSRefusals                                                      []desktopExternalSOCKSRefusalReceipt `json:"socks_refusals,omitempty"`
	SOCKS                                                              []desktopExternalSOCKSWFPReceipt     `json:"socks,omitempty"`
}

func desktopExternalWFPAddress(t *testing.T) netip.Addr {
	t.Helper()
	logger := log.NewNOPFactory().Logger()
	updates, err := tun.NewNetworkUpdateMonitor(logger)
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := updates.Close(); err != nil {
			t.Error("external physical monitor did not join", err)
		}
	}()
	monitor, err := tun.NewDefaultInterfaceMonitor(updates, logger, tun.DefaultInterfaceMonitorOptions{InterfaceFinder: control.NewDefaultInterfaceFinder()})
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := monitor.Close(); err != nil {
			t.Error("external default monitor did not join", err)
		}
	}()
	if err := updates.Start(); err != nil {
		t.Fatal(err)
	}
	if err := monitor.Start(); err != nil {
		t.Fatal(err)
	}
	selected := monitor.DefaultInterface()
	if selected == nil || selected.Flags&net.FlagUp == 0 || selected.Flags&net.FlagLoopback != 0 {
		t.Fatal("external peer has no actual selected interface")
	}
	for _, prefix := range selected.Addresses {
		if prefix.Addr().Is4() && prefix.Addr().IsPrivate() {
			return prefix.Addr()
		}
	}
	t.Fatal("external WFP fixture requires the selected private IPv4 interface")
	return netip.Addr{}
}

func desktopExternalWFPCertificate(t *testing.T, cert tls.Certificate) ([]byte, []byte) {
	t.Helper()
	var chain []byte
	for _, der := range cert.Certificate {
		chain = append(chain, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})...)
	}
	key, err := x509.MarshalPKCS8PrivateKey(cert.PrivateKey)
	if err != nil {
		t.Fatal(err)
	}
	defer clear(key)
	return chain, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: key})
}

type desktopExternalWFPDatagrams struct {
	net.PacketConn
	packets  atomic.Int32
	mu       sync.Mutex
	observed map[string]int
}

func (p *desktopExternalWFPDatagrams) ReadFrom(body []byte) (int, net.Addr, error) {
	for {
		n, source, err := p.PacketConn.ReadFrom(body)
		if err != nil {
			return n, source, err
		}
		if bytes.HasPrefix(body[:n], []byte(desktopExternalWFPProbePrefix)) {
			nonce := string(body[len(desktopExternalWFPProbePrefix):n])
			p.mu.Lock()
			_, owned := p.observed[nonce]
			if owned {
				p.observed[nonce]++
			}
			p.mu.Unlock()
			if owned {
				_, _ = p.PacketConn.WriteTo(body[:n], source)
			}
			continue
		}
		p.packets.Add(1)
		return n, source, nil
	}
}

func desktopExternalWFPExchange(address netip.AddrPort, nonce string) (bool, error) {
	connection, err := net.DialUDP("udp4", nil, net.UDPAddrFromAddrPort(address))
	if err != nil {
		return false, err
	}
	defer connection.Close()
	if err := connection.SetDeadline(time.Now().Add(time.Second)); err != nil {
		return false, err
	}
	body := []byte(desktopExternalWFPProbePrefix + nonce)
	if n, err := connection.Write(body); err != nil || n != len(body) {
		return false, errors.Join(err, io.ErrShortWrite)
	}
	answer := make([]byte, len(body)+1)
	n, err := connection.Read(answer)
	return n == len(body) && bytes.Equal(answer[:n], body), err
}

func desktopExternalWFPReadRequest(input *bufio.Reader) (desktopExternalWFPRequest, error) {
	return desktopExternalWFPReadCapturedRequest(input, false)
}

func desktopExternalWFPReadCapturedRequest(input *bufio.Reader, layer bool) (desktopExternalWFPRequest, error) {
	raw, err := input.ReadSlice('\n')
	if err != nil {
		return desktopExternalWFPRequest{}, err
	}
	if len(raw) > desktopExternalWFPLimit {
		return desktopExternalWFPRequest{}, errors.New("external peer request exceeded its bound")
	}
	var request desktopExternalWFPRequest
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.DisallowUnknownFields()
	if err := decoder.Decode(&request); err != nil {
		return request, err
	}
	var trailing any
	if decoder.Decode(&trailing) != io.EOF || request.Schema != 1 || request.Layer != nil && (!layer || request.Packet != nil) || request.SSEntry != nil && (request.Packet != nil || request.Layer != nil) || request.Operation != "start" && (request.Packet != nil || request.Layer != nil || request.SSEntry != nil) {
		return request, errors.New("external peer request changed its exact schema")
	}
	return request, nil
}

// The provider is a separately retained executable, never a fixture-returned
// connection or a resolver on the ordinary network. Its actual pinned QUIC
// service accepts only the selected inner DNS and fixed TLS proof destination.
func TestRouterVPNDesktopExternalWindowsHysteria2Peer(t *testing.T) {
	desktopExternalWFPRunPeer(t, "hysteria2")
}

func desktopExternalWFPRunPeer(t *testing.T, protocol string) {
	if os.Getenv("ROUTERVPN_EXTERNAL_WFP_PEER") == "" {
		return
	}
	if os.Getenv("ROUTERVPN_EXTERNAL_WFP_PEER") != "1" {
		t.Fatal("unknown external peer owner")
	}
	input := bufio.NewReaderSize(os.Stdin, desktopExternalWFPLimit+1)
	request, err := desktopExternalWFPReadCapturedRequest(input, protocol == "hysteria2-layer")
	if err != nil || request.Operation != "start" || request.Address != desktopExternalWFPAddress(t).String() || request.Nonce != "" {
		t.Fatal("external peer did not receive its exact initial capture", err)
	}
	if (protocol == "router-server") != (request.RouterServer != nil) {
		t.Fatal("Router Server provider changed its original family")
	}
	if (protocol == "ss-entry") != (request.SSEntry != nil) {
		t.Fatal("SS entry reference changed captured family")
	}
	if (protocol == "hysteria2-layer") != (request.Layer != nil) {
		t.Fatal("HY2 layer reference changed its captured graph family")
	}
	if request.Layer != nil && (request.Layer.Mode != "aes-256-gcm" && request.Layer.Mode != "aes-256-gcm+xor-whitening" || request.Layer.Password == "") {
		t.Fatal("HY2 layer reference lost its original private layer")
	}
	if protocol != "packet" && protocol != "router-server" {
		if request.Packet != nil {
			t.Fatal("non-packet provider acquired packet keys")
		}
		switch request.Fault {
		case "", "password", "trust", "dns", "exit", "held":
		case "entry-key", "entry-exit", "final-key", "entry-layer-key", "final-layer-key", "entry-whitening", "final-whitening", "entry-layer-inner", "final-layer-inner":
			if protocol != "ss-entry" {
				t.Fatal("unowned SS entry credential fault")
			}
		case "final-trust":
			if protocol != "ss-entry" || request.SSEntry == nil || request.SSEntry.Final != "hysteria2" {
				t.Fatal("unowned SS entry final trust fault")
			}
		case "layer-key", "whitening":
			if request.Layer == nil || request.Fault == "whitening" && request.Layer.Mode != "aes-256-gcm+xor-whitening" {
				t.Fatal("unowned HY2 layer negative")
			}
		default:
			t.Fatal("unknown external provider fault")
		}
	}
	certificate, err := tls.X509KeyPair(request.Certificate, request.Key)
	if err != nil {
		t.Fatal("external inner TLS certificate", err)
	}
	proxy, err := tls.X509KeyPair(request.ProxyCertificate, request.ProxyKey)
	if err != nil {
		t.Fatal("external QUIC TLS certificate", err)
	}
	packet, err := net.ListenPacket("udp4", net.JoinHostPort(request.Address, "0"))
	if err != nil {
		t.Fatal(err)
	}
	observed := &desktopExternalWFPDatagrams{PacketConn: packet, observed: make(map[string]int)}
	ctx, cancel := context.WithCancel(context.Background())
	peer := &desktopExternalIntegrationPeer{packet: observed, protocol: "hysteria2", certificate: certificate, proxyCertificate: proxy,
		connections: make(map[net.Conn]bool), packetConnections: make(map[N.PacketConn]bool), ctx: ctx, cancel: cancel,
		badDNS: request.Fault == "dns", badIP: request.Fault == "exit"}
	if request.Layer != nil {
		peer.latency = &desktopExternalLatencyPeer{certificate: certificate, fault: "latency-ok"}
	}
	if request.Fault == "held" || request.RouterServer != nil && request.Fault == "compare-held-server" {
		peer.publicEntered, peer.publicRelease = make(chan struct{}), make(chan struct{})
	}
	var protocolErr error
	var layer *desktopExternalHysteriaLayerPeer
	var ssEntry *desktopWFPSSEntryForward
	var routerServer *desktopWFPRouterServer
	address, innerAddress, layerMode := packet.LocalAddr().String(), "", ""
	closed := false
	closePeer := func() {
		if !closed {
			closed = true
			peer.close()
		}
	}
	defer closePeer()
	if protocol == "router-server" {
		routerServer = desktopWFPStartRouterServerPeer(t, peer, request)
		clear(request.Key)
		clear(request.ProxyKey)
	} else if protocol == "packet" {
		desktopExternalWFPStartPacketPeer(t, peer, request.Packet, request.Fault)
		clear(request.Key)
		clear(request.ProxyKey)
	} else if protocol == "ss-entry" {
		ssEntry = desktopExternalWFPStartSSEntryPeer(t, peer, observed, request)
		observed = ssEntry.outer
		address = observed.LocalAddr().String()
		clear(request.Key)
		clear(request.ProxyKey)
	} else {
		logger := log.NewNOPFactory().NewLogger("external-wfp-reference")
		tlsConfig, err := boxTLS.NewServer(ctx, logger, option.InboundTLSOptions{Enabled: true, Certificate: []string{string(request.ProxyCertificate)}, Key: []string{string(request.ProxyKey)}})
		clear(request.Key)
		clear(request.ProxyKey)
		if err != nil {
			t.Fatal(err)
		}
		server, err := HYQUIC.NewService[int](HYQUIC.ServiceOptions{Context: ctx, Logger: logger, TLSConfig: tlsConfig, UDPTimeout: 10 * time.Second, Handler: peer})
		peer.closeProtocol = func() {
			if server != nil {
				protocolErr = server.Close()
			}
			protocolErr = errors.Join(protocolErr, tlsConfig.Close())
		}
		if err != nil {
			t.Fatal(err)
		}
		password := desktopExternalIntegrationPassword
		if request.Fault == "password" {
			password += "-wrong"
		}
		server.UpdateUsers([]int{1}, []string{password})
		var inner net.PacketConn = observed
		if request.Layer != nil {
			inner = packet
		}
		if err = tlsConfig.Start(); err == nil {
			err = server.Start(inner)
		}
		if err != nil {
			t.Fatal("actual external QUIC provider startup", err)
		}
		if request.Layer != nil {
			port := "0"
			if request.Layer.Mode == "aes-256-gcm+xor-whitening" {
				port = "8389"
			}
			outer, err := net.ListenPacket("udp4", net.JoinHostPort(request.Address, port))
			if err != nil {
				t.Fatal("captured HY2 layer bind", err)
			}
			observed = &desktopExternalWFPDatagrams{PacketConn: outer, observed: make(map[string]int)}
			peer.packet = observed
			innerAddress, address, layerMode = packet.LocalAddr().String(), outer.LocalAddr().String(), request.Layer.Mode
			layer, err = newDesktopExternalHysteriaLayerPeer(ctx, observed, netip.MustParseAddrPort(innerAddress), request.Layer.Mode, request.Layer.Password, request.Fault)
			if err != nil {
				t.Fatal("actual HY2 layer provider startup", err)
			}
			closeInner := peer.closeProtocol
			peer.closeProtocol = func() { layerErr := layer.Close(); closeInner(); protocolErr = errors.Join(layerErr, protocolErr) }
			request.Layer.Password = ""
		}
	}
	appID, err := mobiletor.DesktopWindowsNodeCompositionAppID()
	if err != nil || len(appID) == 0 {
		t.Fatal("external peer executable identity", err)
	}
	respond := func(nonce string, isClosed bool) {
		if !isClosed && peer.awgReadback != nil {
			if err := peer.awgReadback(); err != nil {
				t.Fatal(err)
			}
		}
		observed.mu.Lock()
		count := observed.observed[nonce]
		observed.mu.Unlock()
		reply := desktopExternalWFPReply{Schema: 1, Address: address, AppID: appID, Nonce: nonce, Observed: count,
			Packets: observed.packets.Load(), DNS: peer.dnsQueries.Load(), UDPDNS: peer.udpQueries.Load(), TLS: peer.tlsHandshakes.Load(), Public: peer.publicRequests.Load(), Attempts: peer.publicAttempts.Load(), Closed: isClosed,
			LayerMode: layerMode, InnerAddress: innerAddress}
		reply.AuthFailures = peer.authFailures.Load()
		if routerServer != nil {
			reply.RouterServer = routerServer.receipt()
			reply.DNS = routerServer.finalPeer.dnsQueries.Load() + routerServer.localPeer.dnsQueries.Load()
			reply.UDPDNS = routerServer.finalPeer.udpQueries.Load() + routerServer.localPeer.udpQueries.Load()
			reply.TLS = routerServer.finalPeer.tlsHandshakes.Load() + routerServer.localPeer.tlsHandshakes.Load()
			reply.Public = routerServer.finalPeer.publicRequests.Load() + routerServer.localPeer.publicRequests.Load()
			reply.Attempts = routerServer.finalPeer.publicAttempts.Load() + routerServer.localPeer.publicAttempts.Load()
		}
		if ssEntry != nil {
			reply.SSEntryInner = ssEntry.inner
			reply.SSEntryLayer = ssEntry.entryLayer.receipt()
			reply.SSFinalLayer = ssEntry.finalLayer.receipt()
			reply.SSEntryPublic, reply.SSEntryTLS = ssEntry.entryProof.publicRequests.Load(), ssEntry.entryProof.tlsHandshakes.Load()
			reply.SSEntryTCP, reply.SSEntryUDP, reply.SSEntryRejected = ssEntry.streams.Load(), ssEntry.packets.Load(), ssEntry.rejected.Load()
		}
		if layer != nil {
			reply.LayerPackets, reply.LayerAccepted, reply.LayerForwarded, reply.LayerRejected = layer.raw.Load(), layer.authenticated.Load(), layer.forwarded.Load(), layer.rejected.Load()
		}
		if layer != nil && peer.latency != nil {
			reply.LayerLatencyDNS, reply.LayerLatencyTLS, reply.LayerLatencyRequests = peer.latency.queries.Load(), peer.latency.handshakes.Load(), peer.latency.requests.Load()
		}
		if err := json.NewEncoder(os.Stdout).Encode(reply); err != nil {
			t.Fatal(err)
		}
	}
	respond("", false)
	for {
		command, err := desktopExternalWFPReadRequest(input)
		if errors.Is(err, io.EOF) {
			closePeer()
			if !desktopExternalWFPCloseJoined(protocolErr, 0) {
				t.Fatal("actual external peer cleanup failed", protocolErr)
			}
			respond("", true)
			return
		}
		if err != nil || command.Address != "" || command.Fault != "" || command.Layer != nil || len(command.Certificate)+len(command.Key)+len(command.ProxyCertificate)+len(command.ProxyKey) != 0 {
			t.Fatal("external peer command escaped captured owner", err)
		}
		switch command.Operation {
		case "stats":
			if command.Nonce != "" {
				t.Fatal("statistics acquired a probe identity")
			}
		case "release":
			if peer.publicRelease == nil || command.Nonce != "" {
				t.Fatal("uncaptured held response release")
			}
			select {
			case <-peer.publicRelease:
				t.Fatal("duplicate held response release")
			default:
				close(peer.publicRelease)
			}
		case "arm", "observe", "self":
			raw, err := hex.DecodeString(command.Nonce)
			if err != nil || len(raw) != 16 || command.Nonce != hex.EncodeToString(raw) {
				t.Fatal("external probe nonce changed")
			}
			observed.mu.Lock()
			_, exists := observed.observed[command.Nonce]
			if command.Operation == "arm" || command.Operation == "self" {
				if exists {
					observed.mu.Unlock()
					t.Fatal("probe nonce was replayed")
				}
				observed.observed[command.Nonce] = 0
			} else if !exists {
				observed.mu.Unlock()
				t.Fatal("uncaptured probe observation")
			}
			observed.mu.Unlock()
			if command.Operation == "self" {
				ok, err := desktopExternalWFPExchange(netip.MustParseAddrPort(address), command.Nonce)
				if !ok || err != nil {
					t.Fatal("actual provider self probe failed", err)
				}
			}
		default:
			t.Fatal("unsupported external peer command")
		}
		respond(command.Nonce, false)
	}
}

// Only an exact already-closed leaf is benign. A joined sibling failure,
// empty unwrapping wrapper, or cyclic/deep error remains a cleanup failure.
func desktopExternalWFPCloseJoined(err error, depth int) bool {
	if err == nil {
		return true
	}
	if depth >= 16 {
		return false
	}
	if many, ok := err.(interface{ Unwrap() []error }); ok {
		children := many.Unwrap()
		if len(children) == 0 {
			return false
		}
		for _, child := range children {
			if child == nil || !desktopExternalWFPCloseJoined(child, depth+1) {
				return false
			}
		}
		return true
	}
	if one, ok := err.(interface{ Unwrap() error }); ok {
		child := one.Unwrap()
		return child != nil && desktopExternalWFPCloseJoined(child, depth+1)
	}
	return err == net.ErrClosed
}

type desktopExternalWFPReference struct {
	ssEntry     *desktopExternalWFPSSEntryRequest
	layer       *desktopExternalWFPLayerRequest
	command     *exec.Cmd
	input       io.WriteCloser
	output      *os.File
	reader      *bufio.Reader
	diagnostics desktopExternalWFPDiagnostics
	done        chan error
	cancel      context.CancelFunc
	local       netip.Addr
	remote      netip.AddrPort
	packet      *desktopExternalWFPPacketCapture
	initial     desktopExternalWFPReply
	closed      bool
}

func (p *desktopExternalWFPReference) read() (desktopExternalWFPReply, error) {
	type response struct {
		raw []byte
		err error
	}
	done := make(chan response, 1)
	go func() { raw, err := p.reader.ReadSlice('\n'); done <- response{bytes.Clone(raw), err} }()
	select {
	case value := <-done:
		if value.err != nil || len(value.raw) > desktopExternalWFPLimit {
			return desktopExternalWFPReply{}, errors.Join(value.err, errors.New("external peer response is not bounded"))
		}
		var reply desktopExternalWFPReply
		decoder := json.NewDecoder(bytes.NewReader(value.raw))
		decoder.DisallowUnknownFields()
		if err := decoder.Decode(&reply); err != nil {
			return reply, err
		}
		var extra any
		if decoder.Decode(&extra) != io.EOF {
			return reply, errors.New("external peer response has trailing data")
		}
		return reply, nil
	case <-time.After(12 * time.Second):
		p.cancel()
		_ = p.output.Close()
		select {
		case <-done:
		case <-time.After(12 * time.Second):
			return desktopExternalWFPReply{}, errors.New("original external peer acknowledgement reader failed to reap")
		}
		return desktopExternalWFPReply{}, errors.New("external peer acknowledgement did not join")
	}
}

func (p *desktopExternalWFPReference) call(t *testing.T, operation, nonce string) desktopExternalWFPReply {
	t.Helper()
	if p.closed {
		t.Fatal("retired external provider command")
	}
	if err := json.NewEncoder(p.input).Encode(desktopExternalWFPRequest{Schema: 1, Operation: operation, Nonce: nonce}); err != nil {
		t.Fatal(err)
	}
	reply, err := p.read()
	if err != nil || reply.Schema != 1 || reply.Address != p.remote.String() || !bytes.Equal(reply.AppID, p.initial.AppID) || reply.Nonce != nonce || reply.Closed || reply.ProbeUDP != p.initial.ProbeUDP || reply.LayerMode != p.initial.LayerMode || reply.InnerAddress != p.initial.InnerAddress || (!desktopWFPSSEntryReplyIdentity(reply, p.initial) || !desktopWFPRouterServerReplyIdentity(reply, p.initial)) {
		t.Fatal("external peer acknowledgement changed owner", err)
	}
	return reply
}

// The cleanup receipt has already been authenticated. Drain only the original
// pipe, concurrently with waiting for that same process; final Go test output
// must never block the provider's exit or become an unbounded diagnostic sink.
func desktopExternalWFPJoinOutput(reader io.Reader, closeOutput func() error, process <-chan error, cancel func(), bound time.Duration) error {
	const maximum = 256 << 10
	drained := make(chan error, 1)
	go func() {
		n, err := io.Copy(io.Discard, io.LimitReader(reader, maximum+1))
		if n > maximum {
			err = errors.Join(err, errors.New("external provider final output exceeded bound"))
		}
		drained <- err
	}()
	timer := time.NewTimer(bound)
	defer timer.Stop()
	var failure error
	stopped := false
	stop := func() {
		if !stopped {
			stopped = true
			cancel()
			_ = closeOutput()
		}
	}
	for drained != nil || process != nil {
		select {
		case err := <-drained:
			drained = nil
			failure = errors.Join(failure, err)
			if err != nil {
				stop()
			}
		case err := <-process:
			process = nil
			failure = errors.Join(failure, err)
			if err != nil {
				stop()
			}
		case <-timer.C:
			failure = errors.Join(failure, errors.New("external provider process/output did not join"))
			stop()
			// Cancellation terminates the original process and closing its own pipe
			// releases the sole reader. Bound reaping too; never wait forever after kill.
			reap := time.NewTimer(bound)
			defer reap.Stop()
			for drained != nil || process != nil {
				select {
				case err := <-drained:
					drained = nil
					failure = errors.Join(failure, err)
				case err := <-process:
					process = nil
					failure = errors.Join(failure, err)
				case <-reap.C:
					return errors.Join(failure, errors.New("external provider original reader/process failed to reap"))
				}
			}
		}
	}
	return failure
}

type desktopExternalWFPDiagnostics struct {
	mu       sync.Mutex
	data     []byte
	overflow bool
}

func (d *desktopExternalWFPDiagnostics) Write(p []byte) (int, error) {
	d.mu.Lock()
	defer d.mu.Unlock()
	size := len(p)
	remaining := (64 << 10) - len(d.data)
	if len(p) > remaining {
		p = p[:remaining]
		d.overflow = true
	}
	d.data = append(d.data, p...)
	return size, nil
}
func (d *desktopExternalWFPDiagnostics) String() string {
	d.mu.Lock()
	defer d.mu.Unlock()
	value := string(d.data)
	if d.overflow {
		value += "\n[external provider diagnostics exceeded bound]"
	}
	return value
}

func (p *desktopExternalWFPReference) close() error {
	if p.closed {
		return nil
	}
	p.closed = true
	failure := p.input.Close()
	reply, err := p.read()
	if err != nil || reply.Schema != 1 || !reply.Closed || reply.Nonce != "" || reply.Address != p.remote.String() || !bytes.Equal(reply.AppID, p.initial.AppID) || reply.ProbeUDP != p.initial.ProbeUDP || reply.LayerMode != p.initial.LayerMode || reply.InnerAddress != p.initial.InnerAddress || (!desktopWFPSSEntryReplyIdentity(reply, p.initial) || !desktopWFPRouterServerReplyIdentity(reply, p.initial)) {
		failure = errors.Join(failure, err, errors.New("external provider did not acknowledge joined cleanup"))
		p.cancel()
	}
	failure = errors.Join(failure, desktopExternalWFPJoinOutput(p.reader, p.output.Close, p.done, p.cancel, 12*time.Second))
	failure = errors.Join(failure, p.output.Close())
	p.cancel()
	return failure
}

