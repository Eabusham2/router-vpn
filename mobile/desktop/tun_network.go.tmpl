package tun

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/routervpn/desktopnetwork"
	"runtime"
)

func (t *Inbound) RouterVPNDesktopNetworkReceipt() (string, error) {
	t.routervpnLifecycle.Lock()
	defer t.routervpnLifecycle.Unlock()
	if !t.routervpnDesktop {
		return "", errors.New("network receipt has no retained desktop TUN owner")
	}
	name, index, mtu, err := t.routervpnDesktopInterface()
	if err != nil {
		return "", err
	}
	reader, ok := t.tunIf.(interface{ RouterVPNDesktopNetworkReceipt() (string, error) })
	if !ok {
		return "", errors.New("native TUN cannot attest its actual routing calls")
	}
	raw, err := reader.RouterVPNDesktopNetworkReceipt()
	if err != nil {
		return "", err
	}
	receipt, err := desktopnetwork.ParseDesktopNetworkReceipt(raw)
	if err != nil || receipt.TargetOS != runtime.GOOS || receipt.Name != name || receipt.Index != uint32(index) || receipt.MTU != mtu {
		return "", errors.New("native routing receipt differs from the retained TUN")
	}
	if _, _, _, err := t.routervpnDesktopInterface(); err != nil {
		return "", err
	}
	return raw, nil
}

// Context variants never enter the legacy unbounded guard or ambient
// interface lookup. The original desktop owner supplies the read-only guard
// at claim time, and replacement readers retain that exact callback.
func (t *Inbound) RouterVPNDesktopMTUContext(ctx context.Context, guard func(context.Context) error) (string, int, int, error) {
	if err := desktopnetwork.LockContext(ctx, &t.routervpnLifecycle); err != nil {
		return "", 0, 0, err
	}
	defer t.routervpnLifecycle.Unlock()
	if t.platformInterface != nil || t.autoRedirect != nil || t.tunOptions.NetNs != "" || guard == nil || t.routervpnDesktop ||
		(runtime.GOOS != "linux" && runtime.GOOS != "darwin" && runtime.GOOS != "windows") {
		return "", 0, 0, errors.New("desktop MTU requires its original unclaimed native TUN")
	}
	if err := guard(ctx); err != nil {
		return "", 0, 0, err
	}
	name, index, mtu, err := t.routervpnDesktopInterfaceContext(ctx)
	if err != nil {
		return "", 0, 0, err
	}
	if err := guard(ctx); err != nil {
		return "", 0, 0, err
	}
	if err := ctx.Err(); err != nil {
		return "", 0, 0, err
	}
	t.routervpnDesktop, t.routervpnDesktopIndex = true, index
	t.routervpnDesktopGuardContext = guard
	t.routervpnDesktopGuard = func() bool { return guard(t.ctx) == nil }
	return name, index, mtu, nil
}

func (t *Inbound) RouterVPNDesktopMTUInterfaceContext(ctx context.Context) (string, int, int, error) {
	if err := desktopnetwork.LockContext(ctx, &t.routervpnLifecycle); err != nil {
		return "", 0, 0, err
	}
	defer t.routervpnLifecycle.Unlock()
	if !t.routervpnDesktop {
		return "", 0, 0, errors.New("desktop MTU owner is missing")
	}
	return t.routervpnDesktopInterfaceContext(ctx)
}

func (t *Inbound) routervpnDesktopInterfaceContext(ctx context.Context) (string, int, int, error) {
	if err := ctx.Err(); err != nil {
		return "", 0, 0, err
	}
	if !t.routervpnReady || t.tunIf == nil {
		return "", 0, 0, errors.New("desktop TUN or physical path retired")
	}
	if t.routervpnDesktopGuardContext != nil {
		if err := t.routervpnDesktopGuardContext(ctx); err != nil {
			return "", 0, 0, err
		}
	} else if t.routervpnDesktopGuard != nil {
		return "", 0, 0, errors.New("desktop TUN omitted its captured context guard")
	}
	if err := ctx.Err(); err != nil {
		return "", 0, 0, err
	}
	reader, ok := t.tunIf.(interface {
		RouterVPNDesktopNetworkInterfaceContext(context.Context) (string, int, int, error)
	})
	if !ok {
		return "", 0, 0, errors.New("original native TUN omitted its bounded interface read")
	}
	name, index, mtu, err := reader.RouterVPNDesktopNetworkInterfaceContext(ctx)
	if err != nil {
		return "", 0, 0, err
	}
	if name == "" || name != t.tunOptions.Name || index < 1 || mtu < 1280 || mtu > 9000 ||
		t.routervpnDesktopIndex != 0 && index != t.routervpnDesktopIndex || mtu != int(t.tunOptions.MTU) {
		return "", 0, 0, errors.New("native TUN identity or MTU readback changed")
	}
	if t.routervpnDesktopGuardContext != nil {
		if err := t.routervpnDesktopGuardContext(ctx); err != nil {
			return "", 0, 0, err
		}
	}
	if err := ctx.Err(); err != nil {
		return "", 0, 0, err
	}
	return name, index, mtu, nil
}

func (t *Inbound) RouterVPNDesktopNetworkReceiptContext(ctx context.Context) (string, error) {
	if err := desktopnetwork.LockContext(ctx, &t.routervpnLifecycle); err != nil {
		return "", err
	}
	defer t.routervpnLifecycle.Unlock()
	if !t.routervpnDesktop {
		return "", errors.New("network receipt has no retained desktop TUN owner")
	}
	name, index, mtu, err := t.routervpnDesktopInterfaceContext(ctx)
	if err != nil {
		return "", err
	}
	reader, ok := t.tunIf.(interface {
		RouterVPNDesktopNetworkReceiptContext(context.Context) (string, error)
	})
	if !ok {
		return "", errors.New("native TUN cannot attest its bounded routing calls")
	}
	raw, err := reader.RouterVPNDesktopNetworkReceiptContext(ctx)
	if err != nil || ctx.Err() != nil {
		return "", errors.Join(err, ctx.Err())
	}
	receipt, err := desktopnetwork.ParseDesktopNetworkReceipt(raw)
	if err != nil || receipt.TargetOS != runtime.GOOS || receipt.Name != name || receipt.Index != uint32(index) || receipt.MTU != mtu {
		return "", errors.New("native routing receipt differs from the retained TUN")
	}
	if _, _, _, err := t.routervpnDesktopInterfaceContext(ctx); err != nil {
		return "", err
	}
	if err := ctx.Err(); err != nil {
		return "", err
	}
	return raw, nil
}

// Only an unstarted original inbound accepts its creator's startup budget.
// The method supplies cancellation to native ledger reads, never ownership.
func (t *Inbound) RouterVPNDesktopNetworkStartup(ctx context.Context) error {
	if err := desktopnetwork.LockContext(ctx, &t.routervpnLifecycle); err != nil {
		return err
	}
	defer t.routervpnLifecycle.Unlock()
	if ctx == nil || ctx.Err() != nil || t.routervpnReady || t.tunIf != nil || t.platformInterface != nil || t.tunOptions.NetNs != "" || t.tunOptions.EXP_ExternalConfiguration {
		return errors.New("native routing startup requires its original unstarted inbound")
	}
	if _, ok := ctx.Deadline(); !ok {
		return errors.New("native routing startup requires its original deadline")
	}
	t.tunOptions.RouterVPNNetworkContext = ctx
	t.routervpnStandardStartup = true
	return nil
}

// This path is restricted to the fixed stock child. It retains partial native
// construction and each completed close stage across bounded Stop retries.
// A later Box.Close sees the same successful native receipt and is idempotent.
func (t *Inbound) RouterVPNDesktopNetworkRetire(ctx context.Context) (string, error) {
	t.routervpnLifecycle.Lock()
	defer t.routervpnLifecycle.Unlock()
	return t.routervpnDesktopNetworkRetireLocked(ctx)
}

func (t *Inbound) RouterVPNDesktopTunCloseContext(ctx context.Context) error {
	if err := desktopnetwork.LockContext(ctx, &t.routervpnLifecycle); err != nil {
		return err
	}
	defer t.routervpnLifecycle.Unlock()
	if runtime.GOOS != "linux" {
		return errors.New("native context close requires Linux")
	}
	_, err := t.routervpnDesktopTunRetireLocked(ctx)
	return err
}

func (t *Inbound) routervpnDesktopNetworkRetireLocked(ctx context.Context) (string, error) {
	if !t.routervpnStandardStartup || t.routervpnDesktop {
		return "", errors.New("native retirement has no original stock inbound authority")
	}
	return t.routervpnDesktopTunRetireLocked(ctx)
}

func (t *Inbound) routervpnDesktopTunRetireLocked(ctx context.Context) (string, error) {
	if runtime.GOOS != "linux" || t.platformInterface != nil || t.autoRedirect != nil || t.tunOptions.NetNs != "" || t.tunOptions.EXP_ExternalConfiguration {
		return "", errors.New("native retirement has no original stock inbound authority")
	}
	if t.routervpnRetirementReceipt != "" {
		return t.routervpnRetirementReceipt, nil
	}
	if ctx == nil || ctx.Err() != nil {
		return "", errors.New("native retirement lost its bounded Stop caller")
	}
	if _, bounded := ctx.Deadline(); !bounded {
		return "", errors.New("native retirement requires its captured Stop deadline")
	}
	t.routervpnReady = false
	if t.tunStack != nil {
		if err := t.tunStack.Close(); err != nil {
			return "", err
		}
		t.tunStack = nil
	}
	if ctx.Err() != nil {
		return "", ctx.Err()
	}
	var raw string
	var err error
	if t.tunIf == nil {
		// New retains a nonnil original native value on every post-open error.
		// This branch therefore cannot disguise a partially created TUN.
		raw, err = desktopnetwork.CanonicalDesktopNetworkRetirementReceipt(desktopnetwork.DesktopNetworkRetirementReceipt{Schema: 1, TargetOS: "linux", Objects: []desktopnetwork.DesktopNetworkObject{}})
	} else {
		reader, ok := t.tunIf.(interface {
			RouterVPNDesktopNetworkRetire(context.Context) (string, error)
		})
		if !ok {
			return "", errors.New("original native inbound has no retained retirement capability")
		}
		raw, err = reader.RouterVPNDesktopNetworkRetire(ctx)
	}
	if err != nil {
		return "", err
	}
	receipt, err := desktopnetwork.ParseDesktopNetworkRetirementReceipt(raw)
	if err != nil || receipt.Created && receipt.Name != t.tunOptions.Name || ctx.Err() != nil {
		return "", errors.New("native retirement ledger differs from its original inbound or caller")
	}
	t.routervpnRetirementReceipt = raw
	return raw, nil
}

// This read captures only the successfully started original stock inbound's
// native ledger. It grants no MTU replacement authority and performs no
// ambient interface lookup; NativeTun binds its actual creation index and the
// caller's original bounded startup inventory.
func (t *Inbound) RouterVPNDesktopNetworkStartupReceipt(ctx context.Context, guard func() bool) (string, error) {
	t.routervpnLifecycle.Lock()
	defer t.routervpnLifecycle.Unlock()
	if ctx == nil || ctx.Err() != nil || t.tunOptions.RouterVPNNetworkContext != ctx || !t.routervpnReady || t.tunIf == nil ||
		t.platformInterface != nil || t.autoRedirect != nil || t.tunOptions.NetNs != "" || t.tunOptions.EXP_ExternalConfiguration || guard == nil || !guard() {
		return "", errors.New("native startup receipt lost its original ready inbound")
	}
	var raw string
	var err error
	if runtime.GOOS == "linux" {
		if _, bounded := ctx.Deadline(); !bounded {
			return "", errors.New("native startup receipt requires its original deadline")
		}
		reader, ok := t.tunIf.(interface {
			RouterVPNDesktopNetworkReceiptContext(context.Context) (string, error)
		})
		if !ok {
			return "", errors.New("original native inbound has no bounded successful-call ledger")
		}
		raw, err = reader.RouterVPNDesktopNetworkReceiptContext(ctx)
	} else {
		reader, ok := t.tunIf.(interface{ RouterVPNDesktopNetworkReceipt() (string, error) })
		if !ok {
			return "", errors.New("original native inbound has no successful-call ledger")
		}
		raw, err = reader.RouterVPNDesktopNetworkReceipt()
	}
	if err != nil {
		return "", err
	}
	receipt, err := desktopnetwork.ParseDesktopNetworkReceipt(raw)
	if err != nil || receipt.TargetOS != runtime.GOOS || receipt.Name != t.tunOptions.Name || receipt.Index < 1 || receipt.MTU != int(t.tunOptions.MTU) || ctx.Err() != nil || !guard() {
		return "", errors.New("native startup ledger differs from its original inbound or caller")
	}
	return raw, nil
}

// The manager calls this only on its newly constructed, still unstarted MTU
// adapters. It does not replace their Box/session lifetime or source policy.
func (t *Inbound) RouterVPNDesktopMTUStartupContext(ctx context.Context) error {
	if err := desktopnetwork.LockContext(ctx, &t.routervpnLifecycle); err != nil {
		return err
	}
	defer t.routervpnLifecycle.Unlock()
	if ctx == nil || ctx.Err() != nil || t.routervpnReady || t.tunIf != nil || t.tunStack != nil || t.platformInterface != nil || t.autoRedirect != nil || t.tunOptions.NetNs != "" || t.tunOptions.EXP_ExternalConfiguration {
		return errors.New("MTU construction lost its original unstarted native adapter")
	}
	if _, ok := ctx.Deadline(); !ok {
		return errors.New("MTU construction requires its original operation deadline")
	}
	t.tunOptions.RouterVPNNetworkContext = ctx
	return nil
}

// A completed retirement remains distinct from a live Ready receipt. Partial
// construction supplies no fabricated Ready; its original owner stays retained
// until actual native retirement succeeds and yields its complete call history.
func (t *Inbound) RouterVPNDesktopMTUReceiptContext(ctx context.Context) (ready, retired string, failure error) {
	if err := desktopnetwork.LockContext(ctx, &t.routervpnLifecycle); err != nil {
		return "", "", err
	}
	defer t.routervpnLifecycle.Unlock()
	if err := ctx.Err(); err != nil {
		return "", "", err
	}
	if _, ok := ctx.Deadline(); !ok {
		return "", "", errors.New("MTU evidence requires its original deadline")
	}
	if t.routervpnRetirementReceipt != "" {
		return "", t.routervpnRetirementReceipt, nil
	}
	if !t.routervpnReady || t.tunIf == nil {
		return "", "", nil
	}
	name, index, mtu, err := t.routervpnDesktopInterfaceContext(ctx)
	if err != nil {
		return "", "", err
	}
	reader, ok := t.tunIf.(interface {
		RouterVPNDesktopNetworkReceiptContext(context.Context) (string, error)
	})
	if !ok {
		return "", "", errors.New("MTU native adapter omitted its original routing ledger")
	}
	raw, err := reader.RouterVPNDesktopNetworkReceiptContext(ctx)
	if err != nil || ctx.Err() != nil {
		return "", "", errors.Join(err, ctx.Err())
	}
	receipt, err := desktopnetwork.ParseDesktopNetworkReceipt(raw)
	if err != nil || receipt.Name != name || receipt.Index != uint32(index) || receipt.MTU != mtu {
		return "", "", errors.New("MTU receipt changed its original native interface")
	}
	if _, _, _, err = t.routervpnDesktopInterfaceContext(ctx); err != nil {
		return "", "", err
	}
	return raw, "", ctx.Err()
}
