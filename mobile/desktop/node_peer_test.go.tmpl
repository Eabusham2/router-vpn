func desktopNodePeerOriginal(t *testing.T, mode string, config desktopReferenceConfiguration, options Options, ip netip.Addr, remote netip.AddrPort, wrongKey, cover bool, killPolicy string) *mobilemultihop.NodeProfile {
	t.Helper()
	public := options.Peers[0].PublicKey
	if wrongKey {
		_, public = keys(t)
	}
	id := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + public))
	var parameters strings.Builder
	if mode != "wg" {
		for _, key := range []string{"jc", "jmin", "jmax", "s1", "s2", "s3", "s4", "h1", "h2", "h3", "h4"} {
			fmt.Fprintf(&parameters, "%s=%s\n", key, config.Parameters[key])
		}
	}
	text := "[Interface]\nAddress=10.78.0.2/32,fd78:78::2/128\nPrivateKey=" + options.PrivateKey + "\nDNS=192.168.50.133\n" + parameters.String() + "[Peer]\nPublicKey=" + public + "\nPresharedKey=" + options.Peers[0].PreSharedKey + "\nEndpoint=" + remote.String() + "\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n"
	asset := "wg.conf"
	if mode != "wg" {
		asset = "awg.conf"
	}
	files, _ := json.Marshal(map[string]string{asset: base64.StdEncoding.EncodeToString([]byte(text))})
	profileValues := map[string]any{"id": "captured-native-node", "node_kind": "router-vpn", "node_proof_id": hex.EncodeToString(id[:]), "router_api": "http://10.78.0.1:8787", "api_token": "private-fixture-node-token", "endpoint": ip.String(),
		"dns_mode": "home", "adguard_ipv4": "192.168.50.133", "kill_switch_policy": killPolicy, "ipv6_mode": "on", "home_lan_access": false, "mtu_policy": "auto"}
	if cover {
		profileValues["daita_enabled"], profileValues["daita_rate_kbps"], profileValues["daita_host"] = true, 64, "10.78.0.1"
	}
	profile, _ := json.Marshal(profileValues)
	original, err := mobilemultihop.NewNodeProfile(mode, string(files), string(profile), "", "")
	if err != nil {
		t.Fatal(err)
	}
	return original
}

func newDesktopNodePeerFixture(t *testing.T, mode string, wrongKey bool, configuredCover ...bool) *desktopNodePeerFixture {
	t.Helper()
	if len(configuredCover) > 1 {
		t.Fatal("unexpected captured cover selection count")
	}
	return newDesktopNodePeerFixtureWithReference(t, mode, wrongKey, len(configuredCover) == 1 && configuredCover[0], nil)
}

func newDesktopNodePeerFixtureWithReference(t *testing.T, mode string, wrongKey, configuredCover bool, configure func(*desktopReferenceConfiguration)) *desktopNodePeerFixture {
	t.Helper()
	iface, ip := desktopNodePeerInterface(t)
	config, options := desktopReferenceFixture(t)
	if mode == "awg2-strong" {
		config.Parameters["jc"], config.Parameters["jmax"] = "8", "1200"
	}
	config.Echo = append(config.Echo,
		desktopReferenceRule{Network: "tcp", Address: "2001:db8::99", Port: 9999},
		desktopReferenceRule{Network: "udp", Address: "2001:db8::99", Port: 9999})
	if configure != nil {
		configure(&config)
	}
	peer, err := startDesktopNodePeer(config, mode, ip)
	if err != nil {
		t.Fatal("actual encrypted reference start", err)
	}
	t.Cleanup(peer.close)
	remote := netip.MustParseAddrPort(peer.bind.address())
	original := desktopNodePeerOriginal(t, mode, config, options, ip, remote, wrongKey, configuredCover, "always")
	policy, err := mobilemultihop.NewDesktopNodePolicy(original, strings.Repeat("c", 32), runtime.GOOS)
	if err != nil {
		t.Fatal(err)
	}
	f := &desktopNodePeerFixture{policy: policy, peer: peer}
	ins := inbound.NewRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
		f.tun = &desktopNodePeerTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag)}
		return f.tun, nil
	})
	outs := outbound.NewRegistry()
	routervpndesktoppt.RegisterNodePhysicalOutbound(outs)
	endpoints := endpoint.NewRegistry()
	RegisterEndpoint(endpoints)
	WG.RegisterEndpoint(endpoints)
	dnsRegistry := dns.NewTransportRegistry()
	DNST.RegisterUDP(dnsRegistry)
	DNST.RegisterTCP(dnsRegistry)
	services := boxService.NewRegistry()
	routervpnperformance.RegisterService(services)
	boxService.Register[routervpndesktoppt.NodeCaptureOptions](services, mobilemultihop.DesktopNodeNetworkType, func(ctx context.Context, logger log.ContextLogger, tag string, options routervpndesktoppt.NodeCaptureOptions) (adapter.Service, error) {
		owned, err := routervpndesktoppt.NewNodeNetworkOwner(ctx, logger, tag, options)
		if err == nil {
			f.network = owned.(*routervpndesktoppt.NodeNetworkOwner)
		}
		return owned, err
	})
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx = box.Context(ctx, ins, outs, endpoints, dnsRegistry, services, certificate.NewRegistry())
	native, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(policy.Config()))
	if err != nil {
		t.Fatal(err)
	}
	native.Log = &option.LogOptions{Disabled: true}
	f.box, err = box.New(box.Options{Context: ctx, Options: native})
	if err != nil {
		t.Fatal(err)
	}
	f.kernel = &desktopNodePeerKernel{owner: mobiletor.DesktopSocketKernelOwner{Kind: "unix-isolated-uid", IdentitySHA256: strings.Repeat("d", 64), Generation: 1, ProcessID: uint32(os.Getpid())}, iface: iface, local: ip, remote: remote, network: f.network, tun: f.tun, grants: map[string]mobiletor.DesktopSocketGrant{}}
	f.kernel.live.Store(true)
	f.source = &desktopNodePeerSource{desktopNodePeerKernel: f.kernel}
	t.Cleanup(func() {
		if err := f.close(); err != nil {
			t.Error("actual node Box did not join", err)
		}
		if !f.source.closed.Load() {
			t.Error("actual node Box discarded its physical owner")
		}
	})
	if err := f.network.PrepareNodePhysicalBroker(policy, func(ctx context.Context, capture mobiletor.DesktopSocketCapture, current func() bool) (*mobiletor.DesktopSocketBroker, mobiletor.DesktopSocketSource, error) {
		if f.tun.ready.Load() || f.network.SocketCurrent() || f.network.Current() {
			t.Error("actual node source initialized after TUN or socket admission")
		}
		f.kernel.capture = capture
		broker, err := mobiletor.NewDesktopSocketBroker(ctx, capture, f.kernel, current)
		return broker, f.source, err
	}); err != nil {
		t.Fatal(err)
	}
	return f
}

func (f *desktopNodePeerFixture) exchange(network string, hosts ...string) error {
	outer, found := f.box.Outbound().Outbound("proxy")
	if !found {
		return errors.New("actual encrypted endpoint is missing")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()
	host := "192.0.2.99"
	if len(hosts) == 1 {
		host = hosts[0]
	} else if len(hosts) != 0 {
		return errors.New("unexpected peer destination count")
	}
	connection, err := outer.DialContext(ctx, network, M.ParseSocksaddr(net.JoinHostPort(host, "9999")))
	if err != nil {
		return err
	}
	defer connection.Close()
	_ = connection.SetDeadline(time.Now().Add(2 * time.Second))
	message := bytes.Repeat([]byte("retained-native-node-"), 32)
	if _, err = connection.Write(message); err != nil {
		return err
	}
	response := make([]byte, len(message))
	if _, err = io.ReadFull(connection, response); err != nil {
		return err
	}
	if !bytes.Equal(message, response) {
		return errors.New("encrypted peer returned different payload")
	}
	return nil
}

func TestRouterVPNDesktopNodeEncryptedPreReadyHandshake(t *testing.T) {
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		t.Run(mode, func(t *testing.T) {
			f := newDesktopNodePeerFixture(t, mode, false)
			if err := f.box.RouterVPNStrategyStart(); err != nil {
				t.Fatal("actual eager encrypted Box startup", err)
			}
			f.kernel.mu.Lock()
			early, requests := f.kernel.preTUN, f.kernel.requests
			f.kernel.mu.Unlock()
			if early < 1 || requests < 1 || f.network.Current() || !f.network.SocketCurrent() {
				t.Fatal("eager encrypted peer skipped prepared startup or fabricated ready proof", early, requests)
			}
			for _, network := range []string{"tcp", "udp"} {
				for _, host := range []string{"192.0.2.99", "2001:db8::99"} {
					if err := f.exchange(network, host); err != nil {
						t.Fatal("real encrypted payload did not use captured native lower", network, host, err)
					}
				}
			}
			if f.peer.bind.packets.Load() == 0 {
				t.Fatal("successful payload had no actual encrypted peer packets")
			}
			f.network.InterfaceUpdated(context.Background())
			if f.network.Current() || f.network.SocketCurrent() || f.kernel.live.Load() {
				t.Fatal("physical transition retained old endpoint permission")
			}
			if err := f.exchange("udp"); err == nil {
				t.Fatal("retired node generation delivered another encrypted payload")
			}
			if err := f.close(); err != nil {
				t.Fatal(err)
			}
			f.kernel.mu.Lock()
			remaining := len(f.kernel.grants)
			f.kernel.mu.Unlock()
			if remaining != 0 || !f.source.closed.Load() {
				t.Fatal("encrypted native close retained socket grants")
			}
		})
	}
}

func TestRouterVPNDesktopNodeEncryptedWrongPeerRejected(t *testing.T) {
	for _, mode := range []string{"wg", "awg2-strong"} {
		t.Run(mode, func(t *testing.T) {
			f := newDesktopNodePeerFixture(t, mode, true)
			if err := f.box.RouterVPNStrategyStart(); err != nil {
				t.Fatal("wrong-key negative must reach the real encrypted peer", err)
			}
			if err := f.exchange("udp"); err == nil {
				t.Fatal("wrong encrypted peer key delivered a payload")
			}
			if f.peer.bind.packets.Load() == 0 || f.network.Current() {
				t.Fatal("wrong-key negative missed actual encrypted traffic or fabricated ready proof")
			}
		})
	}
}

func TestRouterVPNDesktopNodeEncryptedConfiguredCoverStartup(t *testing.T) {
	f := newDesktopNodePeerFixture(t, "awg2-strong", false, true)
	if err := f.box.RouterVPNStrategyStart(); err != nil {
		t.Fatal("captured cover settings changed eager encrypted startup", err)
	}
	services := f.box.RouterVPNServices()
	if len(services) != 2 || services[0].Type() != "routervpn-cover" || services[1] != f.network {
		t.Fatal("configured cover or appended Node owner changed native service order")
	}
	cover, ok := services[0].(*routervpnperformance.Service)
	if !ok {
		t.Fatal("configured cover did not construct its actual shipping native service")
	}
	var status struct {
		Requested bool   `json:"requested"`
		Active    bool   `json:"active"`
		SentBytes uint64 `json:"sent_bytes"`
		RateKbps  int    `json:"rate_kbps"`
	}
	if err := json.Unmarshal([]byte(cover.StatusJSON()), &status); err != nil || !status.Requested || status.Active || status.SentBytes != 0 || status.RateKbps != 64 || cover.Healthy() || f.network.Current() {
		t.Fatal("native startup discarded cover policy or fabricated post-proof padding readiness", err)
	}
	if err := f.exchange("udp"); err != nil {
		t.Fatal("configured cover prevented the real captured encrypted path", err)
	}
	// Cover activation/traffic still requires the later captured node proof.
	// This test closes only startup order and preservation, not that live phase.
	if err := f.close(); err != nil || !f.source.closed.Load() {
		t.Fatal("configured native services did not join their exact owner", err)
	}
}
