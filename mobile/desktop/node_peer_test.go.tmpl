// This desktop-only test is installed into the existing reference package.
// The client is the real compiled Box, WG/AWG endpoint, Node lower and broker.
// Only OS permits and the TUN are fixtures. The peer uses the unmodified pinned
// cryptographic backend and an actual UDP socket; no successful packet result
// is supplied by a mock. This alone does not establish Windows BFE acceptance.
type desktopNodePeerBind struct {
	referenceBind
	ip netip.Addr
}

func (b *desktopNodePeerBind) Open(uint16) ([]awgconn.ReceiveFunc, uint16, error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.c != nil || !b.ip.Is4() || b.ip.IsLoopback() {
		return nil, 0, errors.New("node reference requires its one actual local IPv4 binding")
	}
	c, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.AddrPortFrom(b.ip, 0)))
	if err != nil {
		return nil, 0, err
	}
	b.c = c
	receive := func(packets [][]byte, sizes []int, endpoints []awgconn.Endpoint) (int, error) {
		n, remote, err := c.ReadFromUDPAddrPort(packets[0])
		if err != nil {
			return 0, err
		}
		if remote.Addr() != b.ip {
			return 0, errors.New("node reference refused a non-fixture peer")
		}
		sizes[0], endpoints[0] = n, peerEndpoint(remote)
		b.packets.Add(1)
		return 1, nil
	}
	return []awgconn.ReceiveFunc{receive}, uint16(c.LocalAddr().(*net.UDPAddr).Port), nil
}

type desktopNodeWGPeerBind struct{ *desktopNodePeerBind }

func (b *desktopNodeWGPeerBind) Open(port uint16) ([]wgconn.ReceiveFunc, uint16, error) {
	reads, port, err := b.desktopNodePeerBind.Open(port)
	if err != nil {
		return nil, 0, err
	}
	converted := make([]wgconn.ReceiveFunc, len(reads))
	for i, read := range reads {
		converted[i] = func(packets [][]byte, sizes []int, endpoints []wgconn.Endpoint) (int, error) {
			values := make([]awgconn.Endpoint, len(endpoints))
			n, err := read(packets, sizes, values)
			for j := 0; j < n; j++ {
				endpoints[j] = values[j]
			}
			return n, err
		}
	}
	return converted, port, nil
}
func (b *desktopNodeWGPeerBind) Send(packets [][]byte, endpoint wgconn.Endpoint, offset int) error {
	trimmed := make([][]byte, len(packets))
	for i, p := range packets {
		if offset < 0 || offset > len(p) {
			return errors.New("invalid node peer WG offset")
		}
		trimmed[i] = p[offset:]
	}
	return b.desktopNodePeerBind.Send(trimmed, endpoint)
}
func (b *desktopNodeWGPeerBind) ParseEndpoint(value string) (wgconn.Endpoint, error) {
	return b.desktopNodePeerBind.ParseEndpoint(value)
}
func (*desktopNodeWGPeerBind) SetReservedForEndpoint(_ netip.AddrPort, reserved [3]byte) {
	if reserved != [3]byte{} {
		panic("reference has no reserved-byte policy")
	}
}

type desktopNodePeer struct {
	bind      *desktopNodePeerBind
	closeOnce sync.Once
	stop      func()
}

func (p *desktopNodePeer) close() { p.closeOnce.Do(p.stop) }

func startDesktopNodePeer(config desktopReferenceConfiguration, mode string, ip netip.Addr) (*desktopNodePeer, error) {
	ipc, addresses, rules, err := validateDesktopReference(config)
	if err != nil {
		return nil, err
	}
	ctx, cancel := context.WithCancel(context.Background())
	handler := &desktopReferenceHandler{ctx: ctx, cancel: cancel, rules: rules, owned: map[io.Closer]bool{}}
	stack, err := wg.NewDevice(wg.DeviceOptions{Context: ctx, Logger: log.NewNOPFactory().Logger(), Handler: handler, UDPTimeout: 30 * time.Second, ICMPTimeout: time.Second, MTU: 1400, Address: addresses})
	if err != nil {
		cancel()
		return nil, err
	}
	bind := &desktopNodePeerBind{ip: ip}
	peer := &desktopNodePeer{bind: bind}
	if mode == "wg" {
		// The shared validator checks keys, private addresses and bounded echo
		// rules. Standard WireGuard receives none of AWG's parameter lines.
		var standard strings.Builder
		for _, line := range strings.Split(ipc, "\n") {
			key, _, ok := strings.Cut(line, "=")
			if !ok {
				continue
			}
			if _, awgParameter := config.Parameters[key]; !awgParameter {
				standard.WriteString(line + "\n")
			}
		}
		device := wgdevice.NewDevice(ctx, stack, &desktopNodeWGPeerBind{bind}, &wgdevice.Logger{Verbosef: func(string, ...any) {}, Errorf: func(string, ...any) {}}, 0)
		stack.SetDevice(device)
		peer.stop = func() { handler.close(); device.Close() }
		if err = device.IpcSet(standard.String()); err == nil {
			err = stack.Start()
		}
		if err == nil {
			err = device.Up()
		}
	} else {
		wrapped := wrapTun(stack)
		device := awg.NewDevice(wrapped, bind, &awg.Logger{Verbosef: func(string, ...any) {}, Errorf: func(string, ...any) {}})
		peer.stop = func() { handler.close(); device.Close() }
		if err = device.IpcSet(ipc); err == nil {
			err = wrapped.configuredPadding(32)
		}
		if err == nil {
			err = stack.Start()
		}
		if err == nil {
			err = device.Up()
		}
	}
	if err != nil {
		peer.close()
		return nil, err
	}
	return peer, nil
}

func desktopNodePeerInterface(t *testing.T) (net.Interface, netip.Addr) {
	t.Helper()
	interfaces, err := net.Interfaces()
	if err != nil {
		t.Fatal(err)
	}
	for _, iface := range interfaces {
		if iface.Flags&net.FlagUp == 0 || iface.Flags&net.FlagLoopback != 0 {
			continue
		}
		addresses, err := iface.Addrs()
		if err != nil {
			t.Fatal(err)
		}
		for _, value := range addresses {
			prefix, err := netip.ParsePrefix(value.String())
			if err == nil && prefix.Addr().Is4() && prefix.Addr().IsPrivate() {
				return iface, prefix.Addr()
			}
		}
	}
	t.Fatal("actual private non-loopback IPv4 interface is required")
	return net.Interface{}, netip.Addr{}
}

type desktopNodePeerTUN struct {
	inbound.Adapter
	ready, closed atomic.Bool
}

func (t *desktopNodePeerTUN) Start(stage adapter.StartStage) error {
	if stage == adapter.StartStateStart {
		t.ready.Store(true)
	}
	return nil
}
func (t *desktopNodePeerTUN) Close() error { t.closed.Store(true); return nil }

type desktopNodePeerKernel struct {
	capture          mobiletor.DesktopSocketCapture
	owner            mobiletor.DesktopSocketKernelOwner
	iface            net.Interface
	local            netip.Addr
	remote           netip.AddrPort
	network          *routervpndesktoppt.NodeNetworkOwner
	tun              *desktopNodePeerTUN
	live             atomic.Bool
	mu               sync.Mutex
	grants           map[string]mobiletor.DesktopSocketGrant
	preTUN, requests int
}

func (p *desktopNodePeerKernel) Owner() (mobiletor.DesktopSocketKernelOwner, error) {
	return p.owner, nil
}
func (p *desktopNodePeerKernel) Current(c mobiletor.DesktopSocketCapture, o mobiletor.DesktopSocketKernelOwner) bool {
	return p.live.Load() && c == p.capture && o == p.owner
}
func (p *desktopNodePeerKernel) Select(ctx context.Context, c mobiletor.DesktopSocketCapture, network string, remote netip.AddrPort) (mobiletor.DesktopSocketBinding, error) {
	if ctx.Err() != nil || !p.Current(c, p.owner) || network != "udp" || remote != p.remote {
		return mobiletor.DesktopSocketBinding{}, errors.New("node peer fixture rejected another outer tuple")
	}
	return mobiletor.DesktopSocketBinding{Owner: p.owner, InterfaceName: p.iface.Name, InterfaceIndex: uint32(p.iface.Index), LocalAddress: p.local}, nil
}
func (p *desktopNodePeerKernel) Bind(ctx context.Context, c mobiletor.DesktopSocketCapture, b mobiletor.DesktopSocketBinding, network string, raw syscall.RawConn) error {
	if ctx.Err() != nil || !p.Current(c, b.Owner) || b.LocalAddress != p.local || b.InterfaceIndex != uint32(p.iface.Index) || b.InterfaceName != p.iface.Name || network != "udp4" || raw == nil {
		return errors.New("node peer fixture lost its actual binding")
	}
	return raw.Control(func(uintptr) {})
}
func (p *desktopNodePeerKernel) Grant(ctx context.Context, q mobiletor.DesktopSocketGrant) (mobiletor.DesktopSocketReceipt, error) {
	if ctx.Err() != nil || !p.Current(q.Capture, q.Binding.Owner) || q.Network != "udp" || q.Remote != p.remote || q.Local.Addr() != p.local || q.Local.Port() == 0 || !p.network.SocketCurrent() {
		return mobiletor.DesktopSocketReceipt{}, errors.New("node eager socket preceded captured handshake admission")
	}
	p.mu.Lock()
	defer p.mu.Unlock()
	if old, ok := p.grants[q.SocketID]; ok {
		identity := q
		identity.Sequence = old.Sequence
		if old != identity {
			return mobiletor.DesktopSocketReceipt{}, errors.New("node socket renewal changed its owner")
		}
	}
	p.grants[q.SocketID] = q
	p.requests++
	if !p.tun.ready.Load() && !p.network.Current() {
		p.preTUN++
	}
	now := time.Now()
	return mobiletor.DesktopSocketReceipt{Grant: q, ObservedAt: now.UnixMilli(), ExpiresAt: now.Add(10 * time.Second).UnixMilli()}, nil
}
func (p *desktopNodePeerKernel) Revoke(_ context.Context, q mobiletor.DesktopSocketGrant) error {
	p.mu.Lock()
	defer p.mu.Unlock()
	old, ok := p.grants[q.SocketID]
	if ok && (old.Capture != q.Capture || old.Local != q.Local || old.Remote != q.Remote) {
		return errors.New("node peer revoke changed owner")
	}
	delete(p.grants, q.SocketID)
	return nil
}

type desktopNodePeerSource struct {
	*desktopNodePeerKernel
	closed atomic.Bool
}

func (*desktopNodePeerSource) CreateSocket(context.Context, mobiletor.DesktopSocketCreation) (mobiletor.DesktopSocketCreated, error) {
	return mobiletor.DesktopSocketCreated{}, errors.New("fixture cannot fabricate sockets")
}
func (p *desktopNodePeerSource) Cancel() { p.live.Store(false) }
func (p *desktopNodePeerSource) Close(ctx context.Context) error {
	p.Cancel()
	p.mu.Lock()
	defer p.mu.Unlock()
	if ctx.Err() != nil || len(p.grants) != 0 {
		return errors.New("node fixture close preceded actual socket retirement")
	}
	p.closed.Store(true)
	return nil
}

