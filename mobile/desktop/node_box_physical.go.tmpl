// Private node graphs use their own final tag. Capture their actual parsed
// options at Box construction without widening the External/Tor source gate.
// Only the separate compiled Node service makes this snapshot eligible.
func routerVPNNodeOptionsDigest(ctx context.Context, options option.Options) string {
	if options.Route == nil || options.Route.Final != "proxy" {
		return ""
	}
	owned := 0
	services := make([]option.Service, 0, len(options.Services))
	for _, service := range options.Services {
		if service.Type == mobilemultihop.DesktopNodeNetworkType && service.Tag == mobilemultihop.DesktopNodeNetworkTag {
			owned++
		}
		if service.Type != C.TypeOOMKiller {
			services = append(services, service)
		}
	}
	if owned != 1 {
		return ""
	}
	options.Log, options.Services = nil, services
	encoded, err := json.MarshalContext(ctx, options)
	if err != nil {
		return ""
	}
	sum := sha256.Sum256(encoded)
	return hex.EncodeToString(sum[:])
}

// Preparation compares the actual complete Box options with the separately
// sealed desktop adaptation. The service creates its native deny baseline in
// Initialize; WG/AWG may then open only their captured outer handshake sockets
// during endpoint Start. This method itself opens neither a socket nor a TUN.
func (s *Box) RouterVPNDesktopNodePreparePhysical(policy *mobilemultihop.DesktopNodePolicy) error {
	_, err := s.RouterVPNDesktopNodePreparePhysicalOwned(policy)
	return err
}

// RouterVPNDesktopNodePreparation is captured before native startup, including
// a partial preparation failure. It retains the exact source for cleanup;
// looking it up from a later, cancelled or replacement Box is unnecessary.
type RouterVPNDesktopNodePreparation struct {
	network *routervpndesktoppt.NodeNetworkOwner
	policy  mobilemultihop.DesktopPhysicalPolicy
}

func (s *Box) RouterVPNDesktopNodePreparePhysicalOwned(policy *mobilemultihop.DesktopNodePolicy) (*RouterVPNDesktopNodePreparation, error) {
	if !routerVPNDesktopNodePhysicalAvailable(policy) {
		return nil, errors.New("this native target has no admitted Router node physical factory")
	}
	_, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	owner := &RouterVPNDesktopNodePreparation{network: network, policy: policy}
	return owner, network.PrepareNodePhysicalPolicy(policy)
}

func (p *RouterVPNDesktopNodePreparation) RetainedProtection(ctx context.Context) (*mobiletor.DesktopWindowsProtectionTarget, bool, error) {
	if p == nil || p.network == nil || p.policy == nil {
		return nil, false, errors.New("Router node preparation has no captured retirement owner")
	}
	return p.network.RetainedPhysicalProtection(ctx, p.policy)
}

func routerVPNDesktopNodePhysicalAvailable(policy *mobilemultihop.DesktopNodePolicy) bool {
	if runtime.GOOS != "windows" || policy == nil {
		return false
	}
	meta := policy.Metadata()
	// Each admitted eager/lazy composition uses the same sealed lower object.
	// Other graph families retain their explicit native acceptance boundary.
	return meta.TargetOS == "windows" && mobilemultihop.DesktopNodePhysicalGraphSupported(meta.Mode, meta.StartLayer)
}

func (s *Box) routerVPNDesktopNodePhysical(policy mobilemultihop.DesktopPhysicalPolicy) (option.Options, *routervpndesktoppt.NodeNetworkOwner, error) {
	var empty option.Options
	if s == nil || s.ctx == nil || s.ctx.Err() != nil || s.service == nil || s.routerVPNNodeOptions == "" ||
		policy == nil {
		return empty, nil, errors.New("Router node physical preparation lost its complete native Box")
	}
	config, meta, _, err := mobilemultihop.ReadDesktopPhysicalPolicy(policy)
	if err != nil {
		return empty, nil, err
	}
	compiled, err := json.UnmarshalExtendedContext[option.Options](s.ctx, []byte(config))
	if err != nil || meta.TargetOS != runtime.GOOS || routerVPNNodeOptionsDigest(s.ctx, compiled) != s.routerVPNNodeOptions {
		return empty, nil, errors.New("Router node physical policy differs from its actual derived native graph")
	}
	raw, found := s.service.Get(mobilemultihop.DesktopNodeNetworkTag)
	network, ok := raw.(*routervpndesktoppt.NodeNetworkOwner)
	if !found || !ok || network == nil || !network.Matches(meta.SessionID, meta.SourceSHA256) {
		return empty, nil, errors.New("Router node physical policy has another captured native service")
	}
	return compiled, network, nil
}

// RouterVPNDesktopNodePhysical retains the started native graph and its exact
// physical owner through TUN changes. Its construction does not stand in for
// authenticated node or selected-DNS proof; the controller's existing proofs
// still precede Connected. Public metadata cannot construct this capability.
type RouterVPNDesktopNodePhysical struct {
	mu            sync.Mutex
	instance      *Box
	ctx           context.Context
	policy        mobilemultihop.DesktopPhysicalPolicy
	network       *routervpndesktoppt.NodeNetworkOwner
	inbound       adapter.Inbound
	reader        routerVPNDesktopTorTUN
	interfaceName string
	name          string
	index, mtu    int
	detached      bool
}

func (s *Box) RouterVPNDesktopNodeActivatePhysical(policy *mobilemultihop.DesktopNodePolicy) (*RouterVPNDesktopNodePhysical, error) {
	if !routerVPNDesktopNodePhysicalAvailable(policy) {
		return nil, errors.New("this native target has no admitted Router node physical factory")
	}
	return s.routerVPNDesktopNodeActivatePhysical(policy)
}

func (s *Box) routerVPNDesktopNodeActivatePhysical(policy mobilemultihop.DesktopPhysicalPolicy) (_ *RouterVPNDesktopNodePhysical, failure error) {
	compiled, network, err := s.routerVPNDesktopNodePhysical(policy)
	if err != nil {
		return nil, err
	}
	_, meta, capture, err := mobilemultihop.ReadDesktopPhysicalPolicy(policy)
	inboundCount := 1
	if meta.Kind == "imported" {
		inboundCount = 3
	}
	if err != nil || len(compiled.Inbounds) != inboundCount || compiled.Inbounds[0].Tag != capture.TUNTag {
		return nil, errors.New("Router node physical activation lost its one captured TUN")
	}
	options, ok := compiled.Inbounds[0].Options.(*option.TunInboundOptions)
	if !ok || compiled.Inbounds[0].Type != C.TypeTun || options.InterfaceName == "" && meta.TargetOS != "darwin" {
		return nil, errors.New("Router node physical activation lost its derived interface policy")
	}
	inbound, found := s.inbound.Get(capture.TUNTag)
	reader, ok := inbound.(routerVPNDesktopTorTUN)
	if !found || !ok || inbound.Type() != C.TypeTun {
		return nil, errors.New("Router node physical activation lost its actual native TUN reader")
	}
	ctx, err := network.Activate(policy)
	if err != nil {
		return nil, err
	}
	defer func() {
		if failure != nil {
			// Box/service cleanup retains every partial source and socket. An
			// activation failure revokes their generation before returning.
			network.Cancel()
		}
	}()
	owner := &RouterVPNDesktopNodePhysical{instance: s, ctx: ctx, policy: policy, network: network,
		inbound: inbound, reader: reader, interfaceName: options.InterfaceName}
	bounded, ok := reader.(interface {
		RouterVPNDesktopMTUContext(context.Context, func(context.Context) error) (string, int, int, error)
	})
	if !ok {
		return nil, errors.New("Router node TUN lacks its bounded generation guard")
	}
	name, index, mtu, err := bounded.RouterVPNDesktopMTUContext(ctx, owner.generationCurrentContext)
	expectedMTU := capture.ConfiguredMTU
	if restored := meta.RestoredMTU; restored != 0 {
		expectedMTU = restored
	}
	if err != nil || name == "" || options.InterfaceName != "" && name != options.InterfaceName || index < 1 || mtu != expectedMTU {
		return nil, errors.New("Router node native TUN differs from its captured graph")
	}
	if err := owner.bindPhysicalTunnel(ctx, reader, name, uint32(index)); err != nil {
		return nil, err
	}
	owner.name, owner.index, owner.mtu = name, index, mtu
	if !owner.Current() {
		return nil, errors.New("Router node physical activation changed before delivery")
	}
	return owner, nil
}

// This callback is also held by the TUN reader, whose own lock can be held
// during MTU replacement. It therefore consults only the permanent generation,
// never this binding's mutex or the inbound manager being replaced.
func (owner *RouterVPNDesktopNodePhysical) generationCurrent() bool {
	return owner != nil && owner.ctx != nil && owner.ctx.Err() == nil && owner.network != nil && owner.network.Current()
}

func (owner *RouterVPNDesktopNodePhysical) generationCurrentContext(ctx context.Context) error {
	if ctx == nil {
		return errors.New("Router node observation has no caller")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if owner == nil || owner.ctx == nil || owner.ctx.Err() != nil || owner.network == nil {
		return errors.New("Router node physical generation is retired")
	}
	return owner.network.CurrentContext(ctx)
}
func (owner *RouterVPNDesktopNodePhysical) readbackContext(ctx context.Context) (string, int, int, error) {
	if err := owner.generationCurrentContext(ctx); err != nil {
		return "", 0, 0, err
	}
	if owner.detached || owner.instance == nil || owner.inbound == nil || owner.reader == nil {
		return "", 0, 0, errors.New("Router node physical TUN is retired or detached")
	}
	current, found, err := adapter.RouterVPNInboundContext(ctx, owner.instance.inbound, owner.inbound.Tag())
	if err != nil {
		return "", 0, 0, err
	}
	if !found || current != owner.inbound {
		return "", 0, 0, errors.New("Router node physical TUN was replaced")
	}
	reader, ok := owner.reader.(interface {
		RouterVPNDesktopMTUInterfaceContext(context.Context) (string, int, int, error)
	})
	if !ok {
		return "", 0, 0, errors.New("Router node TUN has no bounded native readback")
	}
	name, index, mtu, err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
	if err != nil {
		return "", 0, 0, err
	}
	if name != owner.name || index != owner.index || mtu != owner.mtu {
		return "", 0, 0, errors.New("Router node physical TUN changed its proved readback")
	}
	if err := owner.generationCurrentContext(ctx); err != nil {
		return "", 0, 0, err
	}
	return name, index, mtu, nil
}
func (owner *RouterVPNDesktopNodePhysical) CurrentContext(ctx context.Context) error {
	if owner == nil {
		return errors.New("Router node physical owner is unavailable")
	}
	if err := adapter.RouterVPNLockContext(ctx, &owner.mu); err != nil {
		return err
	}
	defer owner.mu.Unlock()
	_, _, _, err := owner.readbackContext(ctx)
	return err
}
func (owner *RouterVPNDesktopNodePhysical) ClaimTUNContext(ctx context.Context, guard func(context.Context) error) (string, int, int, error) {
	if owner == nil || guard == nil {
		return "", 0, 0, errors.New("Router node MTU has no bounded physical guard")
	}
	if err := guard(ctx); err != nil {
		return "", 0, 0, err
	}
	if err := adapter.RouterVPNLockContext(ctx, &owner.mu); err != nil {
		return "", 0, 0, err
	}
	name, index, mtu, err := owner.readbackContext(ctx)
	owner.mu.Unlock()
	if err != nil {
		return "", 0, 0, err
	}
	if err := guard(ctx); err != nil {
		return "", 0, 0, err
	}
	return name, index, mtu, nil
}

func (owner *RouterVPNDesktopNodePhysical) readback() (string, int, int, error) {
	if !owner.generationCurrent() || owner.detached || owner.instance == nil || owner.inbound == nil || owner.reader == nil {
		return "", 0, 0, errors.New("Router node physical TUN owner is retired or detached")
	}
	actual, found := owner.instance.inbound.Get(owner.inbound.Tag())
	if !found || actual != owner.inbound {
		return "", 0, 0, errors.New("Router node physical TUN was replaced by another owner")
	}
	name, index, mtu, err := owner.reader.RouterVPNDesktopMTUInterface()
	if err != nil || name != owner.name || index != owner.index || mtu != owner.mtu || !owner.generationCurrent() {
		return "", 0, 0, errors.New("Router node physical TUN changed its proved readback")
	}
	return name, index, mtu, nil
}

func (owner *RouterVPNDesktopNodePhysical) Current() bool {
	if owner == nil {
		return false
	}
	owner.mu.Lock()
	defer owner.mu.Unlock()
	_, _, _, err := owner.readback()
	return err == nil
}

func (owner *RouterVPNDesktopNodePhysical) ClaimTUN(guard func() bool) (string, int, int, error) {
	if owner == nil || guard == nil || !guard() {
		return "", 0, 0, errors.New("Router node MTU has no captured physical owner")
	}
	owner.mu.Lock()
	name, index, mtu, err := owner.readback()
	owner.mu.Unlock()
	// The caller's composite guard may consult Current. Never invoke that
	// callback while holding this binding's mutex.
	if err != nil || !guard() {
		return "", 0, 0, errors.Join(err, errors.New("Router node MTU physical capture changed"))
	}
	return name, index, mtu, nil
}

func (owner *RouterVPNDesktopNodePhysical) Cancel() {
	if owner != nil && owner.network != nil {
		owner.network.Cancel()
	}
}

// Retire the old virtual-interface permission before the native TUN changes.
// The existing manager transaction returns either its exact candidate or its
// exact rollback reader. Only that result can acquire the replacement grant;
// user cancellation cannot authorize adopting an unrelated current reader.
func (owner *RouterVPNDesktopNodePhysical) ChangeMTU(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
	if owner == nil || owner.instance == nil {
		return nil, errors.New("Router node physical MTU replacement has no native Box")
	}
	return owner.changeMTU(ctx, expected, mtu, owner.instance.RouterVPNChangeMTU)
}

// The private operation parameter lets the native manager transaction be
// exercised with a harmless TUN reader in composition tests. The only public
// entry above always supplies the shipping Box replacement operation.
func (owner *RouterVPNDesktopNodePhysical) changeMTU(ctx context.Context, expected adapter.Inbound, mtu int,
	change func(context.Context, adapter.Inbound, int) (adapter.Inbound, error)) (adapter.Inbound, error) {
	if owner == nil || ctx == nil || ctx.Err() != nil || expected == nil || change == nil || mtu < 1280 || mtu > 9000 {
		return nil, errors.New("Router node physical MTU replacement has no live bounded request")
	}
	if !mobilemtu.SameOperationContext(ctx, ctx) {
		work, finish, err := mobilemtu.WithOperationContext(ctx, 10*time.Second, 3*time.Second)
		if err != nil {
			return nil, err
		}
		defer finish()
		ctx = work
	}
	if err := adapter.RouterVPNLockContext(ctx, &owner.mu); err != nil {
		return nil, err
	}
	defer owner.mu.Unlock()
	name, index, _, err := owner.readbackContext(ctx)
	if err != nil || owner.inbound != expected {
		return nil, errors.Join(err, errors.New("Router node physical MTU request has another native reader"))
	}
	if err := owner.network.RetirePhysicalTunnel(ctx, name, uint32(index)); err != nil {
		// An entered OS operation may have retired the grant before returning
		// an expiry or failure. Keep that exact owner fail closed until joined
		// teardown proves its outcome; a live TUN alone is not a usable path.
		owner.network.CancelAdmission()
		return nil, err
	}
	owner.detached = true
	next, changeErr := change(ctx, expected, mtu)
	finalize := ctx
	if changeErr != nil || ctx.Err() != nil {
		// The native manager may already have spent part of this allowance
		// restoring its returned reader. Physical admission must reuse it.
		finalize, err = mobilemtu.OperationCleanupContext(ctx)
		if err != nil {
			owner.network.CancelAdmission()
			return next, errors.Join(changeErr, ctx.Err(), err)
		}
	}
	err = owner.adoptTUN(finalize, next)
	if err != nil && finalize == ctx && mobiletor.ObservationContextExpired(ctx, err) {
		// Only pure work expiry can finish this same returned transaction.
		// A changed native reader or policy never receives another attempt.
		cleanup, cleanupErr := mobilemtu.OperationCleanupContext(ctx)
		if cleanupErr == nil {
			cleanupErr = owner.adoptTUN(cleanup, next)
		}
		if cleanupErr == nil {
			err = nil
		} else {
			err = errors.Join(err, cleanupErr)
		}
	}
	if err != nil {
		owner.network.CancelAdmission()
		return next, errors.Join(changeErr, err)
	}
	return next, errors.Join(changeErr, ctx.Err())
}

func (owner *RouterVPNDesktopNodePhysical) adoptTUN(ctx context.Context, next adapter.Inbound) error {
	if err := owner.generationCurrentContext(ctx); err != nil {
		return err
	}
	if !owner.detached && next == owner.inbound {
		_, _, _, err := owner.readbackContext(ctx)
		return err
	}
	if !owner.detached || next == nil || next.Type() != C.TypeTun || next.Tag() != owner.inbound.Tag() {
		return errors.New("Router node physical replacement lost its native generation")
	}
	current, found, err := adapter.RouterVPNInboundContext(ctx, owner.instance.inbound, next.Tag())
	if err != nil {
		return err
	}
	reader, ok := next.(routerVPNDesktopTorTUN)
	if !found || current != next || !ok {
		return errors.New("Router node physical replacement is not the returned native reader")
	}
	// The native MTU transaction already carries this generation guard into
	// its candidate and rollback readers. Do not claim their ownership again.
	name, index, mtu, err := reader.RouterVPNDesktopMTUInterfaceContext(ctx)
	if err != nil {
		return err
	}
	if name == "" || owner.interfaceName != "" && name != owner.interfaceName || index < 1 || mtu < 1280 || mtu > 9000 {
		return errors.New("Router node physical replacement has an invalid TUN identity")
	}
	if err := owner.bindPhysicalTunnel(ctx, reader, name, uint32(index)); err != nil {
		return err
	}
	owner.inbound, owner.reader, owner.name, owner.index, owner.mtu, owner.detached = next, reader, name, index, mtu, false
	_, _, _, err = owner.readbackContext(ctx)
	return err
}
