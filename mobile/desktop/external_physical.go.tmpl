type externalPhysicalDestination struct {
	network string
	address netip.AddrPort
}

// Only the exact complete root and actual physical bootstrap dependencies are
// eligible. This is a request constraint, not an endpoint-wide firewall permit;
// the broker still creates, proves and retires each individual kernel socket.
func externalPhysicalDestinations(capture mobilemultihop.ExternalDesktopCapture) (map[externalPhysicalDestination]bool, error) {
	result := make(map[externalPhysicalDestination]bool)
	add := func(network, host string, port int) error {
		address, err := netip.ParseAddr(host)
		if err != nil || address.String() != host || address.Is4In6() || address.Zone() != "" || address.IsUnspecified() || address.IsMulticast() ||
			port < 1 || port > 65535 || (network != "tcp" && network != "udp") || capture.IPv6Mode == "off" && address.Is6() {
			return errors.New("ordinary desktop lower path requires its exact captured numeric protocol tuple")
		}
		result[externalPhysicalDestination{network, netip.AddrPortFrom(address, uint16(port))}] = true
		return nil
	}
	for _, root := range capture.PhysicalRoots {
		if root.DynamicSOCKSUDP {
			return nil, errors.New("ordinary SOCKS UDP requires a retained native control association")
		}
		for _, destination := range root.Destinations {
			if err := add(destination.Network, destination.Host, destination.Port); err != nil {
				return nil, err
			}
		}
	}
	for _, dns := range capture.BootstrapDNS {
		if !dns.Physical {
			continue
		}
		var network string
		switch dns.Type {
		case "tcp", "tls", "https":
			network = "tcp"
		case "udp", "quic", "h3":
			network = "udp"
		default:
			return nil, errors.New("ordinary physical DNS lost its captured transport")
		}
		if dns.Tag == capture.SelectedDNS.Tag || dns.Detour != "" {
			return nil, errors.New("selected or already routed DNS cannot become a physical exception")
		}
		if err := add(network, dns.Host, dns.Port); err != nil {
			return nil, err
		}
	}
	if len(result) == 0 || len(result) > 64 {
		return nil, errors.New("ordinary desktop lower path has no bounded physical dependency set")
	}
	return result, nil
}

type ExternalPhysicalOutbound struct {
	outbound.Adapter
	mu      sync.Mutex
	ctx     context.Context
	options ExternalCaptureOptions
	owner   *ExternalNetworkOwner
	allowed map[externalPhysicalDestination]bool
	closed  bool
}

func RegisterExternalPhysicalOutbound(registry *outbound.Registry) {
	outbound.Register[ExternalCaptureOptions](registry, mobilemultihop.DesktopExternalPhysicalType, NewExternalPhysicalOutbound)
}

func NewExternalPhysicalOutbound(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options ExternalCaptureOptions) (adapter.Outbound, error) {
	if ctx == nil || ctx.Err() != nil || tag != mobilemultihop.DesktopExternalPhysicalTag ||
		!networkSessionID.MatchString(options.SessionID) || !networkSourceID.MatchString(options.SourceSHA256) {
		return nil, errors.New("ordinary desktop physical outbound requires its exact captured native source")
	}
	return &ExternalPhysicalOutbound{Adapter: outbound.NewAdapter(mobilemultihop.DesktopExternalPhysicalType, tag, []string{"tcp", "udp"}, nil), ctx: ctx, options: options}, nil
}

func (o *ExternalPhysicalOutbound) prepare(owner *ExternalNetworkOwner, allowed map[externalPhysicalDestination]bool) error {
	if owner == nil || owner.capture != o.options || len(allowed) == 0 || len(allowed) > 64 {
		return errors.New("ordinary desktop lower object has another captured owner")
	}
	o.mu.Lock()
	defer o.mu.Unlock()
	if o.closed || o.ctx.Err() != nil || o.owner != nil {
		return errors.New("ordinary desktop lower object was already prepared or retired")
	}
	o.allowed = make(map[externalPhysicalDestination]bool, len(allowed))
	for key, permitted := range allowed {
		o.allowed[key] = permitted
	}
	o.owner = owner
	return nil
}

func (o *ExternalPhysicalOutbound) current(ctx context.Context, network string, destination M.Socksaddr) (*mobiletor.DesktopSocketBroker, error) {
	if ctx == nil || ctx.Err() != nil || o.ctx.Err() != nil || destination.IsDomain() || !destination.IsValid() || destination.Port == 0 {
		return nil, errors.New("ordinary desktop lower socket has no current numeric captured destination")
	}
	address, err := netip.ParseAddrPort(destination.String())
	if err != nil {
		return nil, err
	}
	var base string
	switch network {
	case "tcp", "tcp4", "tcp6":
		base = "tcp"
	case "udp", "udp4", "udp6":
		base = "udp"
	default:
		return nil, errors.New("ordinary desktop lower socket has another outer protocol")
	}
	o.mu.Lock()
	owner, allowed, closed := o.owner, o.allowed[externalPhysicalDestination{base, address}], o.closed
	o.mu.Unlock()
	if closed || !allowed || owner == nil || !owner.Current() {
		return nil, errors.New("ordinary desktop lower socket lost its captured native capability")
	}
	manager := service.FromContext[adapter.OutboundManager](o.ctx)
	if manager == nil {
		return nil, errors.New("ordinary desktop lower manager is unavailable")
	}
	selected, found := manager.Outbound(mobilemultihop.DesktopExternalPhysicalTag)
	if !found || selected != o {
		return nil, errors.New("ordinary desktop lower object was replaced")
	}
	owner.mu.Lock()
	broker := owner.broker
	owner.mu.Unlock()
	if broker == nil || !broker.Matches(owner.brokerCapture()) {
		return nil, errors.New("ordinary desktop broker belongs to another native generation")
	}
	return broker, nil
}

// Ordinary native protocols retain this exact object through their compiled
// detour. No default dialer or host resolver exists here. Tor's separate lower
// object still requires its own private activated request context unchanged.
func (o *ExternalPhysicalOutbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	broker, err := o.current(ctx, network, destination)
	if err != nil {
		return nil, err
	}
	return broker.DialContext(ctx, network, destination.String())
}

func (o *ExternalPhysicalOutbound) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
	broker, err := o.current(ctx, "udp", destination)
	if err != nil {
		return nil, err
	}
	packet, err := broker.ListenPacket(ctx, "udp", destination.String())
	if err != nil {
		return nil, err
	}
	// Dial cancellation applies only to establishment. A retained packet socket
	// lives under its native owner, not a caller's completed request deadline.
	return &externalPhysicalPacket{PacketConn: packet, ctx: o.ctx, owner: o}, nil
}

type externalPhysicalPacket struct {
	net.PacketConn
	ctx   context.Context
	owner *ExternalPhysicalOutbound
}

func (c *externalPhysicalPacket) WriteTo(p []byte, address net.Addr) (int, error) {
	if address == nil {
		return 0, errors.New("ordinary packet destination is missing")
	}
	if _, err := c.owner.current(c.ctx, "udp", M.ParseSocksaddr(address.String())); err != nil {
		return 0, err
	}
	return c.PacketConn.WriteTo(p, address)
}

func (o *ExternalPhysicalOutbound) Close() error {
	o.mu.Lock()
	o.closed = true
	owner := o.owner
	o.mu.Unlock()
	if owner == nil {
		return nil
	}
	// Box can close outbounds before services, or cancel construction before
	// Initialize. Revoke the same proof/factory owner now; its service Close
	// still retains and joins a constructor that has not returned yet.
	owner.Cancel()
	owner.mu.Lock()
	broker := owner.broker
	owner.mu.Unlock()
	if broker == nil {
		return nil
	}
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	return broker.Close(ctx)
}
