func desktopOpenVPNExecutionPhysicalPreparation(t *testing.T, name, target, execution string) (*mobilemultihop.NodeChainExecutionPreparation, *mobilemultihop.DesktopNodeChainOpenVPNExecutionPhysicalPolicy) {
	t.Helper()
	local, _, _ := openVPNExecutionNativeSources(t, name, execution)
	original, err := mobilemultihop.NewDesktopNodeChainPolicy(local, strings.Repeat("a", 32), target, 0)
	if err != nil {
		t.Fatal(err)
	}
	prep, err := mobilemultihop.NewDesktopNodeChainOpenVPNExecutionPreparation(original, execution)
	if err != nil {
		t.Fatal(err)
	}
	physical, err := prep.OpenVPNDesktopPhysicalPolicy()
	if err != nil {
		t.Fatal(err)
	}
	return prep, physical
}

// The provider endpoint and every manager are real. Only the unstarted TUN is
// a component fixture. It has no host permission, connection or traffic proof.
func desktopOpenVPNExecutionPhysicalBox(t *testing.T, prep *mobilemultihop.NodeChainExecutionPreparation, change func(map[string]any)) (*Box, *desktopTorBoxTUN, error) {
	t.Helper()
	var tun *desktopTorBoxTUN
	ins := inbound.NewRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.TunInboundOptions) (adapter.Inbound, error) {
		tun = &desktopTorBoxTUN{Adapter: inbound.NewAdapter(C.TypeTun, tag), name: options.InterfaceName, index: 772, mtu: int(options.MTU)}
		return tun, nil
	})
	outs := outbound.NewRegistry()
	group.RegisterSelector(outs)
	G.RegisterOutbound(outs)
	shadowsocks.RegisterOutbound(outs)
	routervpndesktoppt.RegisterNodePhysicalOutbound(outs)
	ends := endpoint.NewRegistry()
	wireguard.RegisterEndpoint(ends)
	AWG.RegisterEndpoint(ends)
	openvpn.RegisterEndpoint(ends)
	ds := dns.NewTransportRegistry()
	DNST.RegisterUDP(ds)
	services := boxService.NewRegistry()
	routervpndesktoppt.RegisterNodeNetworkOwner(services)
	ctx := Context(t.Context(), ins, outs, ends, ds, services, certificate.NewRegistry())
	ctx, err := RouterVPNNodeOpenVPNExecutionContext(ctx, prep)
	if err != nil {
		t.Fatal(err)
	}
	var graph map[string]any
	if err := json.Unmarshal([]byte(prep.Config()), &graph); err != nil {
		t.Fatal(err)
	}
	if change != nil {
		change(graph)
	}
	raw, err := json.Marshal(graph)
	if err != nil {
		t.Fatal(err)
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, raw)
	if err != nil {
		return nil, tun, err
	}
	options.Log = &option.LogOptions{Disabled: true}
	instance, err := New(Options{Context: ctx, Options: options})
	if instance != nil {
		t.Cleanup(func() {
			select {
			case <-instance.done:
				return
			default:
			}
			if err := instance.Close(); err != nil {
				t.Error("original OpenVPN Box failed close", err)
			}
		})
	}
	return instance, tun, err
}

func TestRouterVPNDesktopOpenVPNExecutionPhysicalActualBox(t *testing.T) {
	for _, name := range []string{"3-tcp", "3-udp", "4-tcp", "4-udp", "8-tcp", "8-udp"} {
		for _, execution := range []string{"server", "auto"} {
			t.Run(name+"/"+execution, func(t *testing.T) {
				prep, physical := desktopOpenVPNExecutionPhysicalPreparation(t, name, runtime.GOOS, execution)
				instance, tun, err := desktopOpenVPNExecutionPhysicalBox(t, prep, nil)
				if err != nil || instance == nil || tun == nil {
					t.Fatal("original desktop OpenVPN Box refused", err)
				}
				c, ok := instance.ctx.Value(routerVPNOpenVPNExecutionKey{}).(*routerVPNOpenVPNExecutionConstruction)
				original, sourceErr := prep.OriginalOpenVPNSource()
				if !ok || c == nil || c.prep != prep || c.source != original || sourceErr != nil || c.instance != instance || c.manager != instance.endpoint || c.endpoint == nil || c.close == nil {
					t.Fatal("desktop Box replaced concrete OpenVPN owner")
				}
				if _, _, err := c.endpoint.RouterVPNConnectedCapacityContext(t.Context()); !errors.Is(err, nativeopenvpn.ErrRemotePending) || c.state != nil {
					t.Fatal("unused Local provider manufactured a connection", err)
				}
				if !routerVPNDesktopNodeChainOpenVPNExecutionPhysicalTarget(physical, runtime.GOOS) {
					t.Fatal("original OpenVPN execution target refused")
				}
				_, network, err := instance.routerVPNDesktopNodePhysical(physical)
				if err != nil || network == nil || network.Current() || network.SocketCurrent() || tun.ready || tun.claimed {
					t.Fatal("closed OpenVPN execution fabricated physical readiness", err)
				}
				local, err := physical.OriginalDesktopOpenVPNPolicy()
				if err != nil {
					t.Fatal(err)
				}
				if _, _, err := instance.routerVPNDesktopNodePhysical(local); err == nil {
					t.Fatal("Local policy borrowed execution physical authority")
				}
				captured, err := routerVPNNodeChainExecutionPhysicalPolicy(prep)
				if err != nil || captured != physical {
					t.Fatal("MTU dispatch replaced exact OpenVPN physical owner", err)
				}
				if owner, err := instance.routerVPNDesktopNodeActivatePhysical(physical); err == nil || owner != nil {
					t.Fatal("unprepared OpenVPN Box acquired physical permission")
				}
				if err := instance.Close(); err != nil {
					t.Fatal("original OpenVPN Box failed to retire", err)
				}
				if err := c.close.JoinContext(t.Context(), instance); err != nil {
					t.Fatal("original OpenVPN close receipt did not join", err)
				}
			})
		}
	}
}

func TestRouterVPNDesktopOpenVPNExecutionPhysicalTarget(t *testing.T) {
	for _, target := range []string{"linux", "windows", "darwin"} {
		t.Run(target, func(t *testing.T) {
			_, physical := desktopOpenVPNExecutionPhysicalPreparation(t, "8-udp", target, "auto")
			if !routerVPNDesktopNodeChainOpenVPNExecutionPhysicalTarget(physical, target) {
				t.Fatal("original typed OpenVPN target refused")
			}
			for _, other := range []string{"linux", "windows", "darwin", "foreign"} {
				if other != target && routerVPNDesktopNodeChainOpenVPNExecutionPhysicalTarget(physical, other) {
					t.Fatal("foreign target acquired OpenVPN execution ownership")
				}
			}
			copy := *physical
			if routerVPNDesktopNodeChainOpenVPNExecutionPhysicalTarget(&copy, target) {
				t.Fatal("copied OpenVPN physical policy acquired authority")
			}
		})
	}
}

func TestRouterVPNDesktopOpenVPNExecutionPhysicalChangedGraph(t *testing.T) {
	for _, fault := range []string{"provider-password", "provider-remote", "middle-detour", "final-detour", "dns", "physical-source", "mtu", "open-gate"} {
		t.Run(fault, func(t *testing.T) {
			prep, physical := desktopOpenVPNExecutionPhysicalPreparation(t, "4-udp", runtime.GOOS, "auto")
			local, err := physical.OriginalDesktopOpenVPNPolicy()
			if err != nil {
				t.Fatal(err)
			}
			_, meta, capture, err := local.ReadValidated()
			if err != nil {
				t.Fatal(err)
			}
			middle := meta.Prefixes[len(meta.Prefixes)-2].Tag
			instance, tun, err := desktopOpenVPNExecutionPhysicalBox(t, prep, func(graph map[string]any) {
				find := func(tag string) map[string]any {
					for _, field := range []string{"outbounds", "endpoints"} {
						for _, value := range graph[field].([]any) {
							row := value.(map[string]any)
							if row["tag"] == tag {
								return row
							}
						}
					}
					t.Fatal("original captured member absent")
					return nil
				}
				switch fault {
				case "provider-password":
					find(middle)["password"] = "foreign-provider"
				case "provider-remote":
					find(middle)["server"] = "203.0.113.25"
				case "middle-detour":
					delete(find(middle), "detour")
				case "final-detour":
					find(meta.Prefixes[len(meta.Prefixes)-1].Tag)["detour"] = meta.Prefixes[0].Tag
				case "dns":
					found := false
					for _, value := range graph["dns"].(map[string]any)["servers"].([]any) {
						row := value.(map[string]any)
						if row["tag"] == capture.SelectedDNS.Tag {
							row["server"] = "192.168.50.134"
							found = true
						}
					}
					if !found {
						t.Fatal("original selected DNS absent")
					}
				case "physical-source":
					graph["services"].([]any)[0].(map[string]any)["source_sha256"] = strings.Repeat("e", 64)
				case "mtu":
					row := graph["inbounds"].([]any)[0].(map[string]any)
					row["mtu"] = row["mtu"].(float64) + 16
				case "open-gate":
					graph["route"].(map[string]any)["final"] = mobilemultihop.SelectorTag
				}
			})
			if err == nil || instance != nil || tun != nil {
				t.Fatal("changed OpenVPN graph reached original native construction", err)
			}
		})
	}
}
