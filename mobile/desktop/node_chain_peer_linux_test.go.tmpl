func desktopNodeChainPeerOutbounds(t *testing.T, ctx context.Context, chain *mobilemultihop.NodeChain, physicalAddress string, mutate func(int, map[string]any)) []adapter.Outbound {
	t.Helper()
	var graph map[string]any
	if json.Unmarshal([]byte(chain.Config()), &graph) != nil {
		t.Fatal("compiled ordered graph lost")
	}
	physical, err := chain.PhysicalEgress()
	if err != nil || len(physical) != 1 {
		t.Fatal("ordered chain has unexpected physical bypass", err)
	}
	lower := &desktopSSReferenceLower{virtual: net.JoinHostPort(physical[0].Host, strconv.Itoa(physical[0].Port)), original: physicalAddress}
	manager := &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}}
	owned := service.ContextWith[adapter.OutboundManager](ctx, manager)
	owned = service.ContextWith[adapter.NetworkManager](owned, &desktopImportedPacketNetwork{})
	var outbounds []adapter.Outbound
	for position, tag := range chain.PrefixTags() {
		var row map[string]any
		for _, family := range []string{"endpoints", "outbounds"} {
			for _, raw := range graph[family].([]any) {
				value := raw.(map[string]any)
				if value["tag"] == tag {
					row = value
				}
			}
		}
		if row == nil {
			t.Fatal("compiled prefix vanished", tag)
		}
		if position == 0 {
			row["detour"] = "captured-physical"
		}
		if mutate != nil {
			mutate(position, row)
		}
		raw := []byte(desktopNodeChainJSON(t, row))
		var out adapter.Outbound
		switch row["type"] {
		case "wireguard":
			var options option.WireGuardEndpointOptions
			if json.Unmarshal(raw, &options) != nil {
				t.Fatal("invalid compiled WG options")
			}
			out, err = WG.NewEndpoint(owned, &desktopNodeChainRejectInbound{}, log.NewNOPFactory().Logger(), tag, options)
		case mobilemultihop.AmneziaType:
			var options Options
			if json.Unmarshal(raw, &options) != nil {
				t.Fatal("invalid compiled AWG options")
			}
			out, err = NewEndpoint(owned, &desktopNodeChainRejectInbound{}, log.NewNOPFactory().Logger(), tag, options)
		case "shadowsocks":
			var options option.ShadowsocksOutboundOptions
			if json.Unmarshal(raw, &options) != nil {
				t.Fatal("invalid compiled SS options")
			}
			out, err = SS.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), tag, options)
		case "hysteria2":
			var options option.Hysteria2OutboundOptions
			if json.Unmarshal(raw, &options) != nil {
				t.Fatal("invalid compiled Hysteria2 options")
			}
			out, err = HY.NewOutbound(owned, nil, log.NewNOPFactory().Logger(), tag, options)
		default:
			t.Fatal("uncaptured reference transport", row["type"])
		}
		if err != nil {
			t.Fatal(err)
		}
		manager.owners[tag] = out
		outbounds = append(outbounds, out)
		closer, ok := out.(io.Closer)
		if !ok {
			t.Fatal("native prefix lost its close owner")
		}
		t.Cleanup(func() {
			if err := closer.Close(); err != nil {
				t.Error(err)
			}
		})
	}
	for _, stage := range []adapter.StartStage{adapter.StartStateInitialize, adapter.StartStateStart, adapter.StartStatePostStart, adapter.StartStateStarted} {
		for _, out := range outbounds {
			if starter, ok := out.(adapter.Lifecycle); ok {
				if err := starter.Start(stage); err != nil {
					t.Fatal(err)
				}
			}
		}
	}
	return outbounds
}

type desktopNodeChainCipherCase struct {
	name  string
	modes []string
}

func desktopNodeChainCipherCases() []desktopNodeChainCipherCase {
	return []desktopNodeChainCipherCase{
		{"3-nodes", []string{"wg", "wg"}}, {"4-nodes", []string{"wg", "wg", "wg"}},
		{"awg-fast-wg-3-nodes", []string{"awg2-fast", "wg"}},
		{"wg-awg-strong-3-nodes", []string{"wg", "awg2-strong"}},
		{"awg-strong-awg-fast-3-nodes", []string{"awg2-strong", "awg2-fast"}},
		{"wg-awg-fast-awg-strong-4-nodes", []string{"wg", "awg2-fast", "awg2-strong"}},
		{"awg-fast-awg-strong-wg-4-nodes", []string{"awg2-fast", "awg2-strong", "wg"}},
		{"awg-strong-wg-awg-fast-4-nodes", []string{"awg2-strong", "wg", "awg2-fast"}},
	}
}
func desktopNodeChainSetModes(t *testing.T, request *desktopNodeChainPeerRequest, modes []string) {
	t.Helper()
	if len(modes) != len(request.Prefixes) {
		t.Fatal("ordered cipher inventory changed")
	}
	for i, mode := range modes {
		request.Prefixes[i].Mode = mode
		if mode == "wg" {
			request.Prefixes[i].Parameters = nil
			continue
		}
		if !awgpolicy.IsMode(mode) {
			t.Fatal("unknown fixture cipher")
		}
		values := parameters()
		// Per-prefix wire parameters are independent even when two members
		// use the same product mode. No shared/default server substitution.
		values["s1"] = strconv.Itoa(56 + i)
		values["s4"] = strconv.Itoa(32 + i)
		if mode == "awg2-strong" {
			values["jc"], values["jmax"] = "8", "1200"
		}
		request.Prefixes[i].Parameters = values
	}
}

func TestRouterVPNDesktopNodeChainPeerCapture(t *testing.T) {
	r, _ := desktopNodeChainPeerFixture(t, 3)
	if _, err := desktopNodeChainPeerIdentity(r); err != nil {
