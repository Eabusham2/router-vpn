// Each reference prefix owns its independent real WG or Amnezia cryptographic device.
// Only its next encrypted UDP tuple and its own authenticated health service
// are reachable. The final encrypted prefix reaches the separately keyed SS2022
// service. No caller can supply a forwarding destination or executable command.
type desktopNodeChainPrefixRequest struct {
	Mode            string            `json:"mode"`
	Parameters      map[string]string `json:"parameters,omitempty"`
	PrivateKey      string            `json:"private_key"`
	ClientPublicKey string            `json:"client_public_key"`
	PreSharedKey    string            `json:"pre_shared_key"`
	NodeProofID     string            `json:"node_proof_id"`
	APIToken        string            `json:"api_token"`
}

type desktopNodeChainPeerRequest struct {
	Schema           int                             `json:"schema"`
	Address          string                          `json:"address"`
	ClientAddress    string                          `json:"client_address"`
	Prefixes         []desktopNodeChainPrefixRequest `json:"prefixes"`
	FinalPassword    string                          `json:"final_password"`
	FinalNodeProofID string                          `json:"final_node_proof_id"`
	FinalAPIToken    string                          `json:"final_api_token"`
	BenchmarkPort    int                             `json:"benchmark_port,omitempty"`
}

type desktopNodeChainPrefixReply struct {
	Mode             string `json:"mode"`
	ParametersSHA256 string `json:"parameters_sha256,omitempty"`
	RawUDP           int64  `json:"raw_udp"`
	TCP              int64  `json:"tcp"`
	UDP              int64  `json:"udp"`
	ProofQueries     uint64 `json:"proof_queries"`
	AuthRefusals     uint64 `json:"auth_refusals"`
}

type desktopNodeChainPeerReply struct {
	Schema    int                             `json:"schema"`
	Address   string                          `json:"address"`
	PublicCA  string                          `json:"public_ca"`
	Prefixes  []desktopNodeChainPrefixReply   `json:"prefixes"`
	Final     desktopImportedWGSSReply        `json:"final"`
	Benchmark *desktopNodeChainBenchmarkReply `json:"benchmark,omitempty"`
}

func desktopNodeChainInner(position, count int) (string, string) {
	if position == count-1 {
		return "10.78.0.1", "10.78.0.2"
	}
	return fmt.Sprintf("10.%d.0.1", 80+position), fmt.Sprintf("10.%d.0.2", 80+position)
}

func desktopNodeChainNext(position int) string {
	return fmt.Sprintf("198.51.100.%d:51820", 101+position)
}

// Linux retains its original isolated namespace pair. The separate Darwin
// executable accepts only the one currently owned physical IPv4 observed by
// its explicit native runner; these values grant no client socket/PF rights.
func desktopNodeChainReferenceAddressPair(address, client string) bool {
	if runtime.GOOS == "linux" {
		return address == "192.168.210.2" && client == "192.168.210.1"
	}
	if runtime.GOOS != "darwin" || os.Geteuid() != 0 || os.Getenv("ROUTERVPN_DARWIN_NODE_CHAIN_REFERENCE") != "1" ||
		address != client || address != os.Getenv("ROUTERVPN_DARWIN_NODE_CHAIN_ADDRESS") {
		return false
	}
	wanted, err := netip.ParseAddr(address)
	if err != nil || wanted.String() != address || !wanted.Is4() || !wanted.IsGlobalUnicast() || wanted.IsLoopback() {
		return false
	}
	interfaces, err := net.Interfaces()
	if err != nil {
		return false
	}
	found := 0
	for _, device := range interfaces {
		if device.Flags&net.FlagUp == 0 || device.Flags&net.FlagLoopback != 0 {
			continue
		}
		addresses, err := device.Addrs()
		if err != nil {
			return false
		}
		for _, value := range addresses {
			prefix, err := netip.ParsePrefix(value.String())
			if err == nil && prefix.Addr().Unmap() == wanted {
				found++
			}
		}
	}
	return found == 1
}

func desktopNodeChainPeerIdentity(request desktopNodeChainPeerRequest) ([]string, error) {
	bad := errors.New("ordered reference requires complete independent captured peers")
	if request.Schema != 1 || !desktopNodeChainReferenceAddressPair(request.Address, request.ClientAddress) ||
		len(request.Prefixes) < 2 || len(request.Prefixes) > 3 ||
		(request.BenchmarkPort != 0 && request.BenchmarkPort != 45998) {
		return nil, bad
	}
	seenKeys, seenIDs, seenTokens := map[string]bool{}, map[string]bool{}, map[string]bool{}
	readKey := func(encoded string) ([]byte, error) {
		raw, err := base64.StdEncoding.Strict().DecodeString(encoded)
		if err != nil || len(raw) != 32 || bytes.Equal(raw, make([]byte, 32)) || base64.StdEncoding.EncodeToString(raw) != encoded || seenKeys[encoded] {
			clear(raw)
			return nil, bad
		}
		seenKeys[encoded] = true
		return raw, nil
	}
	checkIdentity := func(node, token string) bool {
		raw, err := hex.DecodeString(node)
		if err != nil || len(raw) != 32 || hex.EncodeToString(raw) != node || seenIDs[node] || seenTokens[token] ||
			len(token) < 16 || len(token) > 256 || strings.ContainsAny(token, "\r\n\x00") {
			return false
		}
		seenIDs[node], seenTokens[token] = true, true
		return true
	}
	var result []string
	for position, prefix := range request.Prefixes {
		if prefix.Mode == "wg" {
			if len(prefix.Parameters) != 0 {
				return nil, bad
			}
		} else if !awgpolicy.IsMode(prefix.Mode) {
			return nil, bad
		} else if _, err := awgpolicy.ParametersUAPI(prefix.Parameters); err != nil {
			return nil, bad
		}
		private, e1 := readKey(prefix.PrivateKey)
		client, e2 := readKey(prefix.ClientPublicKey)
		psk, e3 := readKey(prefix.PreSharedKey)
		if e1 != nil || e2 != nil || e3 != nil {
			clear(private)
			clear(client)
			clear(psk)
			return nil, bad
		}
		server, err := ecdh.X25519().NewPrivateKey(private)
		if err != nil || bytes.Equal(server.PublicKey().Bytes(), client) || !checkIdentity(prefix.NodeProofID, prefix.APIToken) {
			clear(private)
			clear(client)
			clear(psk)
			return nil, bad
		}
		public := base64.StdEncoding.EncodeToString(server.PublicKey().Bytes())
		identity := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + public))
		if prefix.NodeProofID != hex.EncodeToString(identity[:]) || seenKeys[public] {
			clear(private)
			clear(client)
			clear(psk)
			return nil, bad
		}
		seenKeys[public] = true
		_, address := desktopNodeChainInner(position, len(request.Prefixes))
		result = append(result, fmt.Sprintf("private_key=%x\npublic_key=%x\npreshared_key=%x\nallowed_ip=%s/32\nallowed_ip=fd78:78::2/128\n", private, client, psk, address))
		clear(private)
		clear(client)
		clear(psk)
	}
	password, err := readKey(request.FinalPassword)
	clear(password)
	if err != nil || !checkIdentity(request.FinalNodeProofID, request.FinalAPIToken) {
		return nil, bad
	}
	return result, nil
}

type desktopNodeChainPrefixPeer struct {
	mode          string
	readback      func() (string, error)
	bind          *desktopNodeWGBind
	handler       *desktopNodeWGHandler
	proof, denied atomic.Uint64
	wrong, held   atomic.Bool
}

type desktopNodeChainPeer struct {
	prefixes  []*desktopNodeChainPrefixPeer
	final     *desktopImportedWGSSPeer
	benchmark *desktopNodeChainBenchmark
}

func (p *desktopNodeChainPeer) snapshot() desktopNodeChainPeerReply {
	r := desktopNodeChainPeerReply{Schema: 1, Address: p.prefixes[0].bind.address(), PublicCA: p.final.ca, Final: p.final.snapshot()}
	for _, prefix := range p.prefixes {
		parameters := ""
		if prefix.readback != nil {
			// A missing/failed readback cannot become an AWG receipt. Both
			// the component and installed consumers require the original hash.
			parameters, _ = prefix.readback()
		}
		r.Prefixes = append(r.Prefixes, desktopNodeChainPrefixReply{Mode: prefix.mode, ParametersSHA256: parameters,
			RawUDP: prefix.bind.packets.Load(), TCP: prefix.handler.tcp.Load(), UDP: prefix.handler.udp.Load(),
			ProofQueries: prefix.proof.Load(), AuthRefusals: prefix.denied.Load()})
	}
	if p.benchmark != nil {
		r.Benchmark = p.benchmark.snapshot()
	}
	return r
}

func (p *desktopNodeChainPeer) control(command string) error {
	if command == "hold-benchmark" || command == "release-benchmark" {
		if p.benchmark == nil {
			return errors.New("ordered benchmark control has no captured sink")
		}
		p.benchmark.held.Store(command == "hold-benchmark")
		return nil
	}
	for _, action := range []string{"wrong-node", "restore-node", "hold-node", "release-node"} {
		if text, found := strings.CutPrefix(command, action+":"); found {
			index, err := strconv.Atoi(text)
			if err != nil || index < 0 || index >= len(p.prefixes) || strconv.Itoa(index) != text {
				return errors.New("uncaptured ordered prefix control")
			}
			if action == "wrong-node" || action == "restore-node" {
				p.prefixes[index].wrong.Store(action == "wrong-node")
			}
			if action == "hold-node" || action == "release-node" {
				p.prefixes[index].held.Store(action == "hold-node")
			}
			return nil
		}
	}
	return p.final.control(command, true)
}

// Choose the actual cipher from the original canonical request. The shared
// transport wrapper only adapts the owned physical bind; it never converts AWG
// into WG or fabricates an Amnezia parameter receipt.
func desktopNodeChainPrefixFactory(t *testing.T, identity desktopNodeChainPrefixRequest, peer *desktopNodeChainPrefixPeer) desktopNodeUDPReferenceFactory {
	t.Helper()
	peer.mode = identity.Mode
	if identity.Mode == "wg" {
		if len(identity.Parameters) != 0 {
			t.Fatal("WG prefix carried unowned AWG parameters")
		}
		return startDesktopNodeWGReferenceDevice
	}
	if !awgpolicy.IsMode(identity.Mode) {
		t.Fatal("uncaptured ordered cipher")
	}
	parameters, err := awgpolicy.ParametersUAPI(identity.Parameters)
	if err != nil {
		t.Fatal(err)
	}
	expected, err := desktopNodeAWGParameterDigest(identity.Parameters)
	if err != nil {
		t.Fatal(err)
	}
	padding, err := strconv.Atoi(identity.Parameters["s4"])
	if err != nil {
		t.Fatal(err)
	}
	actual := desktopNodeAWGReferenceFactory(expected, padding)
	return func(ctx context.Context, stack wg.Device, bind *desktopNodeWGBind, ipc string) (desktopNodeUDPReferenceDevice, error) {
		first, rest, found := strings.Cut(ipc, "\n")
		if !found || !strings.HasPrefix(first, "private_key=") {
			return desktopNodeUDPReferenceDevice{}, errors.New("ordered AWG lost original key IPC")
		}
		device, err := actual(ctx, stack, bind, first+"\n"+parameters+rest)
		if err != nil {
			return desktopNodeUDPReferenceDevice{}, err
		}
		if device.readback == nil {
			device.close()
			return desktopNodeUDPReferenceDevice{}, errors.New("ordered AWG lacks native parameter readback")
		}
		if digest, err := device.readback(); err != nil || digest != expected {
			device.close()
			return desktopNodeUDPReferenceDevice{}, errors.New("ordered AWG parameter receipt changed")
		}
		peer.readback = device.readback
		return device, nil
	}
}

func desktopNodeChainPeerStart(t *testing.T, request desktopNodeChainPeerRequest, local, remote netip.Addr) *desktopNodeChainPeer {
	t.Helper()
	ipcs, err := desktopNodeChainPeerIdentity(request)
	if err != nil {
		t.Fatal(err)
	}
	loopback := netip.MustParseAddr("127.0.0.1")
	if !(local == netip.MustParseAddr(request.Address) && remote == netip.MustParseAddr(request.ClientAddress)) && !(local == loopback && remote == loopback) {
		t.Fatal("ordered reference lost its original isolated physical pair")
	}
	count := len(request.Prefixes)
	p := &desktopNodeChainPeer{prefixes: make([]*desktopNodeChainPrefixPeer, count)}
	last := request.Prefixes[count-1]
	p.prefixes[count-1] = &desktopNodeChainPrefixPeer{}
	lastFactory := desktopNodeChainPrefixFactory(t, last, p.prefixes[count-1])
	p.final = desktopImportedWGSSStartWithFactory(t, desktopImportedWGSSRequest{Schema: 1, Address: request.Address, ClientAddress: request.ClientAddress,
		PrivateKey: last.PrivateKey, ClientPublicKey: last.ClientPublicKey, PreSharedKey: last.PreSharedKey,
		FinalPassword: request.FinalPassword, NodeProofID: request.FinalNodeProofID, Token: request.FinalAPIToken, Cover: true}, loopback, loopback, lastFactory)
	p.prefixes[count-1].bind, p.prefixes[count-1].handler = p.final.bind, p.final.entry
	if request.BenchmarkPort != 0 {
		p.benchmark = desktopNodeChainBenchmarkStart(t, request.BenchmarkPort)
		p.final.final.routes = append(p.final.final.routes, desktopNodeLayerRoute{Network: "udp", Destination: "10.77.0.1:45998", Physical: p.benchmark.address})
	}
	delete(p.final.entry.rules, "tcp/1.1.1.1:443")
	// Keep the original bounded benchmark/health server, requiring the final
	// captured token before any request reaches it. No public fallback exists.
	health, found := p.final.final.route("tcp", desktopNodeRouterHealthTarget)
	if !found {
		t.Fatal("final reference lost its original private service")
	}
	transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, ResponseHeaderTimeout: 2 * time.Second,
		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
			if network != "tcp" || address != health {
				return nil, errors.New("uncaptured final health forwarding")
			}
			return (&net.Dialer{}).DialContext(ctx, network, address)
		}}
	t.Cleanup(transport.CloseIdleConnections)
	finalHealth := desktopImportedWGSSHTTP(t, nil, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Host != desktopNodeRouterHealthTarget || r.Header.Get("Authorization") != "Bearer "+request.FinalAPIToken || r.ContentLength > 16<<20 || len(r.TransferEncoding) != 0 {
			http.Error(w, "forbidden", http.StatusForbidden)
			return
		}
		captured := r.Clone(r.Context())
		captured.RequestURI = ""
		captured.URL.Scheme = "http"
		captured.URL.Host = health
		response, err := transport.RoundTrip(captured)
		if err != nil {
			http.Error(w, "private service unavailable", http.StatusBadGateway)
			return
		}
		defer response.Body.Close()
		for name, values := range response.Header {
			for _, value := range values {
				w.Header().Add(name, value)
			}
		}
		w.WriteHeader(response.StatusCode)
		_, _ = io.Copy(w, io.LimitReader(response.Body, 16<<20+1))
	}))
	certificate, ca := desktopImportedWGSSCertificate(t)
	p.final.ca = ca
	public := desktopImportedWGSSHTTP(t, &certificate, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		query := r.URL.Query()
		nonce := query.Get("routervpn_proof")
		decoded, nonceError := hex.DecodeString(nonce)
		if r.Method != http.MethodGet || r.Host != "1.1.1.1" || r.URL.Path != "/cdn-cgi/trace" ||
			r.ContentLength != 0 || len(r.TransferEncoding) != 0 ||
			(r.URL.RawQuery != "" && (len(query) != 1 || len(query["routervpn_proof"]) != 1 || nonceError != nil || len(decoded) != 16 || hex.EncodeToString(decoded) != nonce)) {
			http.NotFound(w, r)
			return
		}
		p.final.finalPublic.Add(1)
		w.Header().Set("Content-Type", "text/plain")
		if p.final.wrongPublic.Load() {
			fmt.Fprint(w, "ip=203.0.113.90\n")
		} else {
			fmt.Fprint(w, "ip=203.0.113.89\n")
		}
	}))
	for i := range p.final.final.routes {
		route := &p.final.final.routes[i]
		if route.Network == "tcp" && route.Destination == desktopNodeRouterHealthTarget {
			route.Physical = finalHealth
		}
		if route.Network == "tcp" && route.Destination == "1.1.1.1:443" {
			route.Physical = public
		}
	}
	for position := count - 1; position >= 0; position-- {
		prefix := p.prefixes[position]
		if prefix == nil {
			prefix = &desktopNodeChainPrefixPeer{}
			p.prefixes[position] = prefix
		}
		identity := request.Prefixes[position]
		inner, _ := desktopNodeChainInner(position, count)
		target := net.JoinHostPort(inner, "8787")
		service := desktopImportedWGSSHTTP(t, nil, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if r.Host != target {
				http.NotFound(w, r)
				return
			}
			if r.URL.Path == "/api/benchmark/download" || r.URL.Path == "/api/benchmark/upload" {
				if r.Header.Get("Authorization") != "Bearer "+identity.APIToken {
					prefix.denied.Add(1)
					http.Error(w, "forbidden", http.StatusForbidden)
					return
				}
				if prefix.held.Load() {
					<-r.Context().Done()
					return
				}
				if r.URL.Path == "/api/benchmark/download" {
					n, err := strconv.Atoi(r.URL.Query().Get("bytes"))
					if err != nil || n < 65536 || n > 8<<20 || r.Method != http.MethodGet || len(r.URL.Query()) != 1 || r.ContentLength != 0 || len(r.TransferEncoding) != 0 {
						http.NotFound(w, r)
						return
					}
					w.Header().Set("Content-Length", strconv.Itoa(n))
					w.Header().Set("X-Routervpn-Benchmark", "download-v1")
					w.Header().Set("X-Routervpn-Benchmark-Bytes", strconv.Itoa(n))
					_, _ = w.Write(make([]byte, n))
					return
				}
				if r.Method != http.MethodPost || r.URL.RawQuery != "" || r.ContentLength < 65536 || r.ContentLength > 8<<20 || len(r.TransferEncoding) != 0 {
					http.NotFound(w, r)
					return
				}
				n, err := io.Copy(io.Discard, io.LimitReader(r.Body, (8<<20)+1))
				if err != nil || n != r.ContentLength {
					http.Error(w, "short upload", 400)
					return
				}
				_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "direction": "upload", "bytes": n, "server_receive_ms": 1, "peer": "captured", "proof": "authenticated tunnel-peer private throughput sink"})
				return
			}
			if r.Method != http.MethodGet || r.Host != target || r.URL.Path != "/health" || r.URL.RawQuery != "" || r.ContentLength != 0 || len(r.TransferEncoding) != 0 {
				http.NotFound(w, r)
				return
			}
			if r.Header.Get("Authorization") != "Bearer "+identity.APIToken {
				prefix.denied.Add(1)
				http.Error(w, "forbidden", http.StatusForbidden)
				return
			}
			prefix.proof.Add(1)
			if prefix.held.Load() {
				<-r.Context().Done()
				return
			}
			node := identity.NodeProofID
			if prefix.wrong.Load() {
				node = strings.Repeat("f", 64)
				if node == identity.NodeProofID {
					node = strings.Repeat("e", 64)
				}
			}
			w.Header().Set("Content-Type", "application/json")
			_ = json.NewEncoder(w).Encode(desktopImportedWGSSHealthReply{true, node, "router-vpn-private-agent-v1"})
		}))
		if position == count-1 {
			prefix.handler.rules["tcp/"+target] = desktopReferenceRule{Network: "tcp", Address: inner, Port: 8787, Target: service}
			continue
		}
		next := netip.MustParseAddrPort(desktopNodeChainNext(position + 1))
		rules := map[string]desktopReferenceRule{
			"tcp/" + target:        {Network: "tcp", Address: inner, Port: 8787, Target: service},
			"udp/" + next.String(): {Network: "udp", Address: next.Addr().String(), Port: int(next.Port()), Target: p.prefixes[position+1].bind.address()},
		}
		ctx, cancel := context.WithCancel(context.Background())
		prefix.handler = &desktopNodeWGHandler{desktopReferenceHandler: &desktopReferenceHandler{ctx: ctx, cancel: cancel, rules: rules, owned: map[io.Closer]bool{}}}
		stack, err := wg.NewDevice(wg.DeviceOptions{Context: ctx, Logger: log.NewNOPFactory().Logger(), Handler: prefix.handler, UDPTimeout: 5 * time.Second, ICMPTimeout: time.Second, MTU: 2000,
			Address: []netip.Prefix{netip.MustParsePrefix(inner + "/32"), netip.MustParsePrefix("fd78:78::1/128")}})
		if err != nil {
			prefix.handler.close()
			t.Fatal(err)
		}
		bindLocal, bindRemote := loopback, loopback
		if position == 0 {
			bindLocal, bindRemote = local, remote
		}
		prefix.bind = &desktopNodeWGBind{local: bindLocal, remote: bindRemote}
		device, err := desktopNodeChainPrefixFactory(t, identity, prefix)(ctx, stack, prefix.bind, ipcs[position])
		ipcs[position] = ""
		if err != nil {
			prefix.handler.close()
			t.Fatal(err)
		}
		t.Cleanup(func() { prefix.handler.close(); device.close() })
	}
	clear(ipcs)
	return p
}

func TestRouterVPNDesktopNodeChainReferenceProcess(t *testing.T) {
	if os.Getenv("ROUTERVPN_NODE_CHAIN_REFERENCE_CHILD") == "" {
		return
	}
	if os.Getenv("ROUTERVPN_NODE_CHAIN_REFERENCE_CHILD") != "1" {
		t.Fatal("uncaptured ordered reference invocation")
	}
	reader := bufio.NewReaderSize(os.Stdin, 32<<10+1)
	line, err := reader.ReadSlice('\n')
	if err != nil || len(line) > 32<<10 {
		t.Fatal("ordered reference requires its bounded inherited request")
	}
	var request desktopNodeChainPeerRequest
	decoder := json.NewDecoder(bytes.NewReader(line))
	decoder.DisallowUnknownFields()
	if decoder.Decode(&request) != nil || decoder.Decode(new(any)) != io.EOF {
		t.Fatal("ordered reference request shape changed")
	}
	if _, err := desktopNodeChainPeerIdentity(request); err != nil {
		t.Fatal(err)
	}
	local, remote := desktopNodeChainPeerPhysicalNamespace(t, request)
	peer := desktopNodeChainPeerStart(t, request, local, remote)
	desktopNodeChainPeerServe(t, reader, peer, func() any { return peer.snapshot() })
}

func desktopNodeChainPeerPhysicalNamespace(t *testing.T, request desktopNodeChainPeerRequest) (netip.Addr, netip.Addr) {
	t.Helper()
	local, remote := netip.MustParseAddr(request.Address), netip.MustParseAddr(request.ClientAddress)
	interfaces, err := net.Interfaces()
	found := false
	for _, iface := range interfaces {
		addresses, e := iface.Addrs()
		if e != nil {
			t.Fatal(e)
		}
		for _, address := range addresses {
			prefix, e := netip.ParsePrefix(address.String())
			found = found || e == nil && prefix.Addr() == local && iface.Flags&net.FlagUp != 0 && iface.Flags&net.FlagLoopback == 0
		}
	}
	if err != nil || !found {
		t.Fatal("ordered reference requires its original physical namespace", err)
	}
	return local, remote
}

func desktopNodeChainPeerServe(t *testing.T, reader *bufio.Reader, peer *desktopNodeChainPeer, snapshot func() any) {
	t.Helper()
	respond := func() {
		if json.NewEncoder(os.Stdout).Encode(snapshot()) != nil {
			t.Fatal("ordered reply pipe failed")
		}
	}
	respond()
	for {
		line, err := reader.ReadSlice('\n')
		if errors.Is(err, io.EOF) && len(line) == 0 {
			return
		}
		if err != nil || len(line) > 32 {
			t.Fatal("ordered reference control pipe failed")
		}
		if peer.control(strings.TrimSuffix(string(line), "\n")) != nil {
			t.Fatal("uncaptured ordered reference control")
		}
		respond()
	}
}

