	}
	for _, fault := range []string{"schema", "address", "count", "missing-middle", "key", "same-key", "same-id", "same-token", "wrong-proof", "final-key", "final-id", "final-token"} {
		t.Run(fault, func(t *testing.T) {
			bad := r
			bad.Prefixes = append([]desktopNodeChainPrefixRequest(nil), r.Prefixes...)
			switch fault {
			case "schema":
				bad.Schema = 2
			case "address":
				bad.Address = "127.0.0.1"
			case "count":
				bad.Prefixes = append(bad.Prefixes, bad.Prefixes[0])
			case "missing-middle":
				bad.Prefixes = bad.Prefixes[:1]
			case "key":
				bad.Prefixes[1].PrivateKey = "invalid"
			case "same-key":
				bad.Prefixes[1].PrivateKey = bad.Prefixes[0].PrivateKey
			case "same-id":
				bad.Prefixes[1].NodeProofID = bad.Prefixes[0].NodeProofID
			case "same-token":
				bad.Prefixes[1].APIToken = bad.Prefixes[0].APIToken
			case "wrong-proof":
				bad.Prefixes[1].NodeProofID = strings.Repeat("e", 64)
			case "final-key":
				bad.FinalPassword = bad.Prefixes[1].PreSharedKey
			case "final-id":
				bad.FinalNodeProofID = bad.Prefixes[1].NodeProofID
			case "final-token":
				bad.FinalAPIToken = ""
			}
			if _, err := desktopNodeChainPeerIdentity(bad); err == nil {
				t.Fatal("foreign ordered reference accepted", fault)
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainPeerAWGCapture(t *testing.T) {
	for _, fault := range []string{"complete", "missing-mode", "unknown-mode", "wg-parameters", "missing-parameters", "missing-s4", "unknown-parameter", "invalid-parameter", "injected-parameter", "same-public-key"} {
		t.Run(fault, func(t *testing.T) {
			request, _ := desktopNodeChainPeerFixture(t, 3)
			desktopNodeChainSetModes(t, &request, []string{"wg", "awg2-fast", "awg2-strong"})
			switch fault {
			case "missing-mode":
				request.Prefixes[1].Mode = ""
			case "unknown-mode":
				request.Prefixes[1].Mode = "awg"
			case "wg-parameters":
				request.Prefixes[1].Mode = "wg"
			case "missing-parameters":
				request.Prefixes[1].Parameters = nil
			case "missing-s4":
				delete(request.Prefixes[1].Parameters, "s4")
			case "unknown-parameter":
				request.Prefixes[1].Parameters["foreign"] = "1"
			case "invalid-parameter":
				request.Prefixes[1].Parameters["jc"] = "-1"
			case "injected-parameter":
				request.Prefixes[1].Parameters["h1"] += "\nlisten_port=1"
			case "same-public-key":
				request.Prefixes[2].ClientPublicKey = request.Prefixes[0].ClientPublicKey
			}
			_, err := desktopNodeChainPeerIdentity(request)
			if (err == nil) != (fault == "complete") {
				t.Fatal("ordered mixed cipher capture lost exact authority", fault, err)
			}
		})
	}
}

func TestRouterVPNDesktopNodeChainPeerTraffic(t *testing.T) {
	for _, scenario := range desktopNodeChainCipherCases() {
		count := len(scenario.modes)
		var addresses []string
		t.Run(scenario.name, func(t *testing.T) {
			request, clients := desktopNodeChainPeerFixture(t, count)
			desktopNodeChainSetModes(t, &request, scenario.modes)
			loopback := netip.MustParseAddr("127.0.0.1")
			peer := desktopNodeChainPeerStart(t, request, loopback, loopback)
			for _, prefix := range peer.prefixes {
				addresses = append(addresses, prefix.bind.address())
			}
			physical := netip.MustParseAddrPort(peer.prefixes[0].bind.address())
			sourceAddress := net.JoinHostPort(request.Address, strconv.Itoa(int(physical.Port())))
			chain := desktopNodeChainPeerSource(t, request, clients, sourceAddress)
			ctx, cancel := context.WithTimeout(pause.WithDefaultManager(context.Background()), 45*time.Second)
			defer cancel()
			outbounds := desktopNodeChainPeerOutbounds(t, ctx, chain, peer.prefixes[0].bind.address(), nil)
			final := outbounds[len(outbounds)-1]
			get := func(parent context.Context, out adapter.Outbound, target, token string, trust bool) ([]byte, error) {
				call, stop := context.WithTimeout(parent, 1500*time.Millisecond)
				defer stop()
				roots := x509.NewCertPool()
				if trust && !roots.AppendCertsFromPEM([]byte(peer.final.ca)) {
					t.Fatal("original private test root missing")
				}
				transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, TLSClientConfig: &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}, DialContext: func(c context.Context, n, a string) (net.Conn, error) {
					return out.DialContext(c, n, M.ParseSocksaddr(a))
				}}
				defer transport.CloseIdleConnections()
				req, _ := http.NewRequestWithContext(call, http.MethodGet, target, nil)
				if token != "" {
					req.Header.Set("Authorization", "Bearer "+token)
				}
				response, err := (&http.Client{Transport: transport}).Do(req)
				if err != nil {
					return nil, err
				}
				defer response.Body.Close()
				body, err := io.ReadAll(io.LimitReader(response.Body, 8193))
				if response.StatusCode != 200 || len(body) > 8192 {
					return nil, errors.New("unproved private HTTP response")
				}
				return body, err
			}
			packet := func(out adapter.Outbound, body []byte, target string) ([]byte, error) {
				call, stop := context.WithTimeout(ctx, 500*time.Millisecond)
				defer stop()
				c, err := out.DialContext(call, "udp", M.ParseSocksaddr(target))
				if err != nil {
					return nil, err
				}
				defer c.Close()
				deadline, _ := call.Deadline()
				_ = c.SetDeadline(deadline)
				if n, err := c.Write(body); err != nil || n != len(body) {
					return nil, errors.Join(err, io.ErrShortWrite)
				}
				reply := make([]byte, mtuprobe.MaxBytes+1)
				n, err := c.Read(reply)
				return reply[:n], err
			}
			for i, prefix := range request.Prefixes {
				t.Run(fmt.Sprintf("prefix-%d-authenticated", i), func(t *testing.T) {
					inner, _ := desktopNodeChainInner(i, count)
					before := peer.snapshot()
					expected := ""
					if prefix.Mode != "wg" {
						var err error
						expected, err = desktopNodeAWGParameterDigest(prefix.Parameters)
						if err != nil {
							t.Fatal(err)
						}
					}
					if before.Prefixes[i].Mode != prefix.Mode || before.Prefixes[i].ParametersSHA256 != expected {
						t.Fatal("prefix native cipher/parameter receipt changed", i)
					}
					body, err := get(ctx, outbounds[i], "http://"+net.JoinHostPort(inner, "8787")+"/health", prefix.APIToken, false)
					var result desktopImportedWGSSHealthReply
					after := peer.snapshot()
					if err != nil || json.Unmarshal(body, &result) != nil || !result.OK || result.NodeID != prefix.NodeProofID || result.Proof != "router-vpn-private-agent-v1" || after.Prefixes[i].ProofQueries != before.Prefixes[i].ProofQueries+1 {
						t.Fatal("prefix did not prove its own real encrypted path", i, err, after)
					}
					for j := 0; j <= i; j++ {
						if after.Prefixes[j].RawUDP <= before.Prefixes[j].RawUDP {
							t.Fatal("prefix proof bypassed encrypted predecessor", i, j)
						}
					}
					for j := i + 1; j < count; j++ {
						// WG may send its own captured keepalive while another
						// prefix is measured. Only a real private query proves
						// the successor; a raw UDP packet does not.
						if after.Prefixes[j].ProofQueries != before.Prefixes[j].ProofQueries {
							t.Fatal("prefix proof crossed an unrelated successor", i, j)
						}
					}
				})
			}
			t.Run("final-private-public-and-selected-dns", func(t *testing.T) {
				before := peer.snapshot()
				body, err := get(ctx, final, "http://"+desktopNodeRouterHealthTarget+"/health", request.FinalAPIToken, false)
				var result desktopImportedWGSSHealthReply
				if err != nil || json.Unmarshal(body, &result) != nil || result.NodeID != request.FinalNodeProofID {
					t.Fatal("final private identity was substituted", err)
				}
				body, err = get(ctx, final, "https://1.1.1.1/cdn-cgi/trace?routervpn_proof="+strings.Repeat("a", 32), "", true)
				if err != nil || string(body) != "ip=203.0.113.89\n" {
					t.Fatal("ordered final TLS proof failed", err)
				}
				q := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
				wire, _ := q.Pack()
				reply, err := packet(final, wire, "192.168.50.133:53")
				var answer dns.Msg
				if err != nil || answer.Unpack(reply) != nil || answer.Id != q.Id || answer.Rcode != dns.RcodeSuccess {
					t.Fatal("selected final DNS failed", err)
				}
				after := peer.snapshot()
				if after.Final.RouterQueries != before.Final.RouterQueries+1 || after.Final.FinalPublicQueries != before.Final.FinalPublicQueries+1 || after.Final.DNSQueries != before.Final.DNSQueries+1 {
					t.Fatal("final service counters changed", after)
				}
				for i := range after.Prefixes {
					if after.Prefixes[i].RawUDP <= before.Prefixes[i].RawUDP || after.Prefixes[i].UDP == 0 || after.Prefixes[i].ProofQueries != before.Prefixes[i].ProofQueries {
						t.Fatal("final traffic omitted a real middle transport", i, before.Prefixes[i], after.Prefixes[i])
					}
				}
			})
			t.Run("wrong-middle-token-and-identity", func(t *testing.T) {
				inner, _ := desktopNodeChainInner(1, count)
				target := "http://" + net.JoinHostPort(inner, "8787") + "/health"
				before := peer.snapshot()
				if _, err := get(ctx, outbounds[1], target, request.Prefixes[0].APIToken, false); err == nil {
					t.Fatal("another node token reached the middle")
				}
				if peer.snapshot().Prefixes[1].AuthRefusals != before.Prefixes[1].AuthRefusals+1 {
					t.Fatal("wrong token did not reach the actual middle refusal")
				}
				for _, control := range []string{"wrong-node:1", "restore-node:1"} {
					if err := peer.control(control); err != nil {
						t.Fatal(err)
					}
					body, err := get(ctx, outbounds[1], target, request.Prefixes[1].APIToken, false)
					var response desktopImportedWGSSHealthReply
					if err != nil || json.Unmarshal(body, &response) != nil || (response.NodeID == request.Prefixes[1].NodeProofID) != (control == "restore-node:1") {
						t.Fatal("middle identity control did not affect actual response", err)
					}
				}
			})
			t.Run("middle-cannot-bypass-final-dns", func(t *testing.T) {
				q := new(dns.Msg).SetQuestion("example.com.", dns.TypeA)
				wire, _ := q.Pack()
				before := peer.snapshot()
				if _, err := packet(outbounds[count-1], wire, "192.168.50.133:53"); err == nil {
					t.Fatal("middle bypassed final DNS")
				}
				if peer.snapshot().Final.DNSQueries != before.Final.DNSQueries {
					t.Fatal("middle reached final service without final key")
				}
			})
			t.Run("authenticated-final-mtu", func(t *testing.T) {
				before := peer.snapshot()
				for _, token := range []string{request.FinalAPIToken, request.Prefixes[1].APIToken} {
					wire, err := mtuprobe.Request(1252, token, request.FinalNodeProofID, time.Now())
					if err != nil {
						t.Fatal(err)
					}
					reply, err := packet(final, wire, desktopNodeRouterCoverTarget)
					valid := err == nil && mtuprobe.ValidateReply(wire, reply, request.FinalAPIToken, request.FinalNodeProofID, time.Now()) == nil
					if valid != (token == request.FinalAPIToken) {
						t.Fatal("final MTU accepted another private authority", err)
					}
				}
				after := peer.snapshot()
				if after.Final.MTUQueries != before.Final.MTUQueries+2 || after.Final.MTUReplies != before.Final.MTUReplies+1 {
					t.Fatal("MTU did not reach the final encrypted responder", after)
				}
			})
			t.Run("held-middle-cancellation", func(t *testing.T) {
				_ = peer.control("hold-node:1")
				defer peer.control("release-node:1")
				call, stop := context.WithTimeout(ctx, 60*time.Millisecond)
				defer stop()
				inner, _ := desktopNodeChainInner(1, count)
				if _, err := get(call, outbounds[1], "http://"+net.JoinHostPort(inner, "8787")+"/health", request.Prefixes[1].APIToken, false); !errors.Is(err, context.DeadlineExceeded) {
					t.Fatal("held middle lost caller cancellation", err)
				}
			})
			faults := []string{"middle-key", "omit-middle", "final-key"}
			awgPosition := -1
			for i, mode := range scenario.modes {
				if mode != "wg" {
					awgPosition = i
					break
				}
			}
			if awgPosition >= 0 {
				faults = append(faults, "awg-parameters")
			}
			for _, fault := range faults {
				t.Run(fault, func(t *testing.T) {
					// Each negative owns independent peers and client identities.
					// A second same-key client would rebind the server's original
					// endpoint and could invalidate the intended fault witness.
					request, clients := desktopNodeChainPeerFixture(t, count)
					desktopNodeChainSetModes(t, &request, scenario.modes)
					peer := desktopNodeChainPeerStart(t, request, loopback, loopback)
					physical := netip.MustParseAddrPort(peer.prefixes[0].bind.address())
					chain := desktopNodeChainPeerSource(t, request, clients, net.JoinHostPort(request.Address, strconv.Itoa(int(physical.Port()))))
					before := peer.snapshot()
					bad := desktopNodeChainPeerOutbounds(t, ctx, chain, peer.prefixes[0].bind.address(), func(i int, row map[string]any) {
						if fault == "awg-parameters" && i == awgPosition {
							row["amnezia"].(map[string]any)["h1"] = "51000000-51999999"
						}
						if fault == "middle-key" && i == 1 {
							key, _ := ecdh.X25519().GenerateKey(rand.Reader)
							row["private_key"] = base64.StdEncoding.EncodeToString(key.Bytes())
						}
						if fault == "omit-middle" && i == len(request.Prefixes) {
							row["detour"] = chain.PrefixTags()[0]
						}
						if fault == "final-key" && i == len(request.Prefixes) {
							row["password"] = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{0x49}, 32))
						}
					})
					// Establish the intact encrypted predecessor before measuring
					// the intended refusal. Cold WG handshake time is not evidence
					// that an incorrect final key was actually rejected.
					warmPosition := len(request.Prefixes) - 1
					if fault == "middle-key" {
						warmPosition = 0
					}
					if fault == "awg-parameters" {
						warmPosition = awgPosition - 1
					}
					if warmPosition >= 0 {
						warmAddress, _ := desktopNodeChainInner(warmPosition, len(request.Prefixes))
						body, err := get(ctx, bad[warmPosition], "http://"+net.JoinHostPort(warmAddress, "8787")+"/health", request.Prefixes[warmPosition].APIToken, false)
						var proved desktopImportedWGSSHealthReply
						if err != nil || json.Unmarshal(body, &proved) != nil || proved.NodeID != request.Prefixes[warmPosition].NodeProofID {
							t.Fatal("negative case lost its intact original predecessor", fault, err)
						}
					}
					// An invalid encrypted identity may already have sent its first
					// handshake during native Start. Retain that original zero
					// baseline; the normal handshake retry interval is not a
					// reason to lengthen this refusal deadline.
					if fault != "middle-key" && fault != "awg-parameters" {
						before = peer.snapshot()
					}
					call, stop := context.WithTimeout(ctx, 300*time.Millisecond)
					defer stop()
					if _, err := get(call, bad[len(bad)-1], "http://"+desktopNodeRouterHealthTarget+"/health", request.FinalAPIToken, false); err == nil {
						t.Fatal("broken complete chain reached final proof", fault)
					}
					after := peer.snapshot()
					if after.Final.RouterQueries != before.Final.RouterQueries {
						t.Fatal("broken middle/final acquired final identity", fault, after)
					}
					if fault == "middle-key" && (after.Prefixes[1].RawUDP <= before.Prefixes[1].RawUDP || after.Prefixes[1].TCP != before.Prefixes[1].TCP || after.Prefixes[1].UDP != before.Prefixes[1].UDP) {
						t.Fatal("wrong middle key did not reach independent cryptographic refusal", before.Prefixes[1], after.Prefixes[1])
					}
					if fault == "awg-parameters" && (after.Prefixes[awgPosition].RawUDP <= before.Prefixes[awgPosition].RawUDP || after.Prefixes[awgPosition].TCP != before.Prefixes[awgPosition].TCP || after.Prefixes[awgPosition].UDP != before.Prefixes[awgPosition].UDP) {
						t.Fatal("changed AWG parameters did not reach real cryptographic refusal", awgPosition)
					}
					if fault == "final-key" && (after.Final.FinalRawTCP <= before.Final.FinalRawTCP || after.Final.FinalTCP != before.Final.FinalTCP) {
						t.Fatal("wrong final key did not reach independent SS refusal")
					}
				})
			}
		})
		for _, address := range addresses {
			connection, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.MustParseAddrPort(address)))
			if err != nil {
				t.Fatal("ordered peer leaked its original UDP owner", address, err)
			}
			_ = connection.Close()
		}
	}
}

// This optional private benchmark is a separate final-only route. The existing
// unauthenticated cover endpoint and its 1200-byte limit are unchanged.
type desktopNodeChainBenchmarkReply struct {
	Port           int    `json:"port"`
	Packets        uint64 `json:"packets"`
	Replies        uint64 `json:"replies"`
	ReceivedBytes  uint64 `json:"received_bytes"`
	SentBytes      uint64 `json:"sent_bytes"`
	Held           bool   `json:"held"`
	HeldPackets    uint64 `json:"held_packets"`
	MaximumPayload uint64 `json:"maximum_payload"`
}
type desktopNodeChainBenchmark struct {
	address                                                string
	held                                                   atomic.Bool
	packets, replies, received, sent, heldPackets, maximum atomic.Uint64
}

func (p *desktopNodeChainBenchmark) snapshot() *desktopNodeChainBenchmarkReply {
	return &desktopNodeChainBenchmarkReply{45998, p.packets.Load(), p.replies.Load(), p.received.Load(), p.sent.Load(), p.held.Load(), p.heldPackets.Load(), p.maximum.Load()}
}
func desktopNodeChainBenchmarkStart(t *testing.T, port int) *desktopNodeChainBenchmark {
	t.Helper()
	if port != 45998 {
		t.Fatal("ordered benchmark requires its exact captured final port")
	}
	connection, err := net.ListenPacket("udp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	p := &desktopNodeChainBenchmark{address: connection.LocalAddr().String()}
	done := make(chan struct{})
	go func() {
		defer close(done)
		body := make([]byte, 8973)
		for {
			n, from, err := connection.ReadFrom(body)
			if err != nil {
				return
			}
			if n < 1 || n > 8972 {
				continue
			}
			p.packets.Add(1)
			p.received.Add(uint64(n))
			for old := p.maximum.Load(); uint64(n) > old; old = p.maximum.Load() {
				if p.maximum.CompareAndSwap(old, uint64(n)) {
					break
				}
			}
			if p.held.Load() {
				p.heldPackets.Add(1)
				continue
			}
			if wrote, err := connection.WriteTo(body[:n], from); err == nil && wrote == n {
				p.replies.Add(1)
				p.sent.Add(uint64(wrote))
			}
		}
	}()
	t.Cleanup(func() { connection.Close(); <-done })
	return p
}

func TestRouterVPNDesktopNodeChainBenchmarkCapture(t *testing.T) {
	for _, port := range []int{-1, 1, 45999, 65536} {
		t.Run(fmt.Sprintf("reject-port-%d", port), func(t *testing.T) {
			request, _ := desktopNodeChainPeerFixture(t, 2)
			request.BenchmarkPort = port
			if _, err := desktopNodeChainPeerIdentity(request); err == nil {
				t.Fatal("uncaptured final benchmark port accepted")
			}
		})
	}
	t.Run("absent-control", func(t *testing.T) {
		p := &desktopNodeChainPeer{}
		if p.control("hold-benchmark") == nil || p.control("release-benchmark") == nil {
			t.Fatal("missing original benchmark accepted control")
		}
	})
	t.Run("real-bounded-echo-and-hold", func(t *testing.T) {
		p := desktopNodeChainBenchmarkStart(t, 45998)
		peer := &desktopNodeChainPeer{benchmark: p}
		c, err := net.Dial("udp4", p.address)
		if err != nil {
			t.Fatal(err)
		}
		defer c.Close()
		// UDP delivery can precede the sender's post-WriteTo accounting. Join
		// the exact monotonic receipt instead of racing that original writer.
		snapshot := func(packets, replies, received, sent uint64) *desktopNodeChainBenchmarkReply {
			t.Helper()
			deadline := time.Now().Add(time.Second)
			for {
				state := p.snapshot()
				if state.Packets >= packets && state.Replies >= replies && state.ReceivedBytes >= received && state.SentBytes >= sent {
					return state
				}
				if !time.Now().Before(deadline) {
					t.Fatal("original benchmark accounting did not join", state)
				}
				time.Sleep(time.Millisecond)
			}
		}
		body := bytes.Repeat([]byte{0x71}, 8972)
		for _, size := range []int{1, 1200, 1252, 8972} {
			c.SetDeadline(time.Now().Add(time.Second))
			if _, err := c.Write(body[:size]); err != nil {
				t.Fatal(err)
			}
			reply := make([]byte, size+1)
			n, err := c.Read(reply)
			if err != nil || n != size || !bytes.Equal(reply[:n], body[:size]) {
				t.Fatal("original native UDP benchmark changed bounded payload", size, err)
			}
		}
		before := snapshot(4, 4, 11425, 11425)
		if before.Packets != 4 || before.Replies != 4 || before.ReceivedBytes != 11425 || before.SentBytes != 11425 || before.MaximumPayload != 8972 {
			t.Fatal("native benchmark counters changed", before)
		}
		if err := peer.control("hold-benchmark"); err != nil {
			t.Fatal(err)
		}
		c.SetDeadline(time.Now().Add(150 * time.Millisecond))
		c.Write(body[:1252])
		reply := make([]byte, 1253)
		if _, err := c.Read(reply); err == nil {
			t.Fatal("held original benchmark replied")
		}
		held := snapshot(5, 4, 12677, 11425)
		if held.HeldPackets != 1 || held.Replies != before.Replies || held.SentBytes != before.SentBytes || !held.Held {
			t.Fatal("held benchmark lost original packet/counters", held)
		}
		if err := peer.control("release-benchmark"); err != nil {
			t.Fatal(err)
		}
		c.SetDeadline(time.Now().Add(time.Second))
		c.Write(body[:1252])
		n, err := c.Read(reply)
		if err != nil || n != 1252 || !bytes.Equal(reply[:n], body[:1252]) {
			t.Fatal("released original benchmark did not resume", err)
		}
		after := snapshot(6, 5, 13929, 12677)
		if after.Replies != before.Replies+1 || after.HeldPackets != 1 || after.Held {
			t.Fatal("benchmark replayed a held packet", after)
		}
	})
}

func TestRouterVPNDesktopNodeChainDarwinReferenceCapture(t *testing.T) {
	if runtime.GOOS != "darwin" {
		return
	}
	request, _ := desktopNodeChainPeerFixture(t, 2)
	address := os.Getenv("ROUTERVPN_DARWIN_NODE_CHAIN_ADDRESS")
	if request.Address != address || request.ClientAddress != address {
		t.Fatal("Darwin reference fixture substituted its original captured physical address")
	}
	if _, err := desktopNodeChainPeerIdentity(request); err != nil {
		t.Fatal("Darwin reference fixture lost its complete original identity", err)
	}
	for _, fault := range []string{"missing-reference", "foreign-address", "linux-pair", "source-address"} {
		t.Run(fault, func(t *testing.T) {
			changed := request
			switch fault {
			case "missing-reference":
				t.Setenv("ROUTERVPN_DARWIN_NODE_CHAIN_REFERENCE", "")
			case "foreign-address":
				t.Setenv("ROUTERVPN_DARWIN_NODE_CHAIN_ADDRESS", "127.0.0.1")
			case "linux-pair":
				changed.Address, changed.ClientAddress = "192.168.210.2", "192.168.210.1"
			case "source-address":
				changed.ClientAddress = "127.0.0.1"
			}
			if _, err := desktopNodeChainPeerIdentity(changed); err == nil {
				t.Fatal("Darwin reference accepted a foreign physical capture", fault)
			}
		})
	}
}
