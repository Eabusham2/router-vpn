//go:build darwin

package tun

import (
	"context"
	"errors"
	"fmt"
	"net"
	"net/netip"
	"syscall"
)

func (t *NativeTun) routervpnNetworkInterface() (*net.Interface, uint64, error) {
	current, err := net.InterfaceByName(t.options.Name)
	if err != nil || t.routervpnOwnedIndex < 1 || current.Index != t.routervpnOwnedIndex {
		return nil, 0, errors.New("native Darwin receipt lost its original TUN")
	}
	return current, 0, nil
}

func routervpnDarwinNetworkObjects() ([]DesktopNetworkObject, error) {
	return routervpnDarwinNetworkObjectsFrom(syscall.RouteRIB)
}

func routervpnDarwinNetworkObjectsFrom(read func(int, int) ([]byte, error)) ([]DesktopNetworkObject, error) {
	objects, err := desktopDarwinReadRouteDump2(read)
	if err != nil {
		return nil, err
	}
	filtered := make([]DesktopNetworkObject, 0, len(objects))
	for _, object := range objects {
		derived, err := DesktopDarwinDerivedRoute(object, objects)
		if err != nil {
			return nil, err
		}
		if !derived {
			filtered = append(filtered, object)
		}
	}
	return filtered, nil
}

func (t *NativeTun) routervpnExecRoute(action int, scoped bool, index int, destination netip.Prefix, gateway netip.Addr) error {
	err := execRoute(action, scoped, index, destination, gateway)
	if err != nil || action != syscall.RTM_ADD {
		return err
	}
	objects, observed := routervpnDarwinNetworkObjects()
	var matches []DesktopNetworkObject
	for _, object := range objects {
		if object.Index == uint32(t.routervpnOwnedIndex) && object.Destination == destination.String() && object.Gateway == gateway.String() {
			matches = append(matches, object)
		}
	}
	if observed != nil || len(matches) != 1 {
		t.routervpnNetworkFailure(errors.New("native Darwin route add has no unique current readback"))
		return nil
	}
	t.routervpnNetworkAdded(matches[0])
	return nil
}

func (t *NativeTun) routervpnNetworkObjects(receipt DesktopNetworkReceipt) ([]DesktopNetworkObject, error) {
	current, err := routervpnDarwinNetworkObjects()
	if err != nil {
		return nil, err
	}
	objects := append([]DesktopNetworkObject(nil), receipt.Objects...)
	for _, object := range receipt.Objects {
		if !routervpnNetworkHasObject(current, object) {
			return nil, errors.New("native Darwin receipt lost an installed route")
		}
	}
	for _, object := range current {
		if object.Index != receipt.Index || routervpnNetworkHasObject(objects, object) {
			continue
		}
		if object.Flags&syscall.RTF_STATIC != 0 || !routervpnNetworkAddressRoute(receipt, object) {
			return nil, routervpnDarwinUnrelatedRouteError(receipt, object)
		}
		objects = append(objects, object)
	}
	return objects, nil
}

// Failure-only numeric shape: retain the original refusal and disclose no
// address, gateway, interface name, arbitrary native error, or receipt text.
func routervpnDarwinUnrelatedRouteError(receipt DesktopNetworkReceipt, object DesktopNetworkObject) error {
	prefix, _ := netip.ParsePrefix(object.Destination)
	destinationIsAddress, gatewayIsAddress := false, false
	for _, value := range receipt.Addresses {
		address, err := netip.ParsePrefix(value)
		if err == nil {
			destinationIsAddress = destinationIsAddress || prefix.IsValid() && prefix.Bits() == address.Addr().BitLen() && prefix.Addr() == address.Addr()
			gatewayIsAddress = gatewayIsAddress || object.Gateway == address.Addr().String()
		}
	}
	return fmt.Errorf("native Darwin TUN has an unrelated route: family=%d flags=%#x prefix_bits=%d gateway_present=%t destination_is_address=%t gateway_is_address=%t address_route=%t",
		object.Family, object.Flags, prefix.Bits(), object.Gateway != "", destinationIsAddress, gatewayIsAddress, routervpnNetworkAddressRoute(receipt, object))
}

func (t *NativeTun) routervpnNetworkAddresses(current *net.Interface) ([]net.Addr, error) {
	return current.Addrs()
}

// The native OS inventory remains synchronous; a canceled caller never adopts
// its result. Linux supplies the same caller to each interruptible native dump.
func (t *NativeTun) routervpnNetworkInterfaceContext(ctx context.Context) (*net.Interface, uint64, error) {
	if ctx == nil {
		return nil, 0, errors.New("native receipt lost its read operation")
	}
	if err := ctx.Err(); err != nil {
		return nil, 0, err
	}
	return t.routervpnNetworkInterface()
}

func (t *NativeTun) routervpnNetworkAddressesContext(ctx context.Context, current *net.Interface) ([]net.Addr, error) {
	if ctx == nil {
		return nil, errors.New("native receipt lost its read operation")
	}
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	return t.routervpnNetworkAddresses(current)
}

func (t *NativeTun) routervpnNetworkObjectsContext(ctx context.Context, receipt DesktopNetworkReceipt) ([]DesktopNetworkObject, error) {
	if ctx == nil {
		return nil, errors.New("native receipt lost its read operation")
	}
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	return t.routervpnNetworkObjects(receipt)
}
