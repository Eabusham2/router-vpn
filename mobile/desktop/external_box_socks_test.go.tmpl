// The normal pinned SOCKS server handles authentication, CONNECT and UDP
// framing. Only deliberately malicious server replies use the wire encoders
// below. Each successful UDP control creates a real, independently retained
// listener. Its exact address is admitted by the explicitly modeled OS
// boundary, never by a new shared permission in the native physical outbound.
type desktopExternalSOCKSPeer struct {
	peer        *desktopExternalIntegrationPeer
	fault       string
	mu          sync.Mutex
	relays      []*desktopExternalSOCKSRelay
	refused     atomic.Int32
	refusedDone chan struct{}
	refusedOnce sync.Once
	joinFailed  atomic.Bool
}

type desktopExternalSOCKSControl struct {
	net.Conn
	associated atomic.Bool
	readDone   chan struct{}
	readOnce   sync.Once
}

func (c *desktopExternalSOCKSControl) Read(body []byte) (int, error) {
	// All request/authentication reads precede PacketListener.ListenPacket.
	// The pinned server then owns the one TCP association observer.
	if c.associated.Load() {
		defer c.readOnce.Do(func() { close(c.readDone) })
	}
	return c.Conn.Read(body)
}

type desktopExternalSOCKSRelay struct {
	net.PacketConn
	owner       *desktopExternalSOCKSPeer
	control     *desktopExternalSOCKSControl
	address     netip.AddrPort
	readStarted atomic.Bool
	closeOnce   sync.Once
	closed      chan struct{}
	mu          sync.Mutex
	client      netip.AddrPort
	packets     int
}

func newDesktopExternalSOCKSPeer(peer *desktopExternalIntegrationPeer, fault string) *desktopExternalSOCKSPeer {
	peer.kernel.socksRelays = make(map[netip.AddrPort]bool)
	return &desktopExternalSOCKSPeer{peer: peer, fault: fault, refusedDone: make(chan struct{})}
}

func (p *desktopExternalSOCKSPeer) snapshot() []*desktopExternalSOCKSRelay {
	p.mu.Lock()
	defer p.mu.Unlock()
	return append([]*desktopExternalSOCKSRelay(nil), p.relays...)
}

type desktopExternalSOCKSListener struct {
	owner   *desktopExternalSOCKSPeer
	control *desktopExternalSOCKSControl
	relay   *desktopExternalSOCKSRelay
}

func (l *desktopExternalSOCKSListener) ListenPacket(config net.ListenConfig, ctx context.Context, network, address string) (net.PacketConn, error) {
	peer := l.owner.peer
	if network != "udp" || address != net.JoinHostPort(peer.kernel.local.String(), "0") || !peer.kernel.local.Is4() || l.relay != nil || ctx.Err() != nil {
		return nil, errors.New("SOCKS peer changed its captured association listener")
	}
	var packet net.PacketConn
	var err error
	for attempt := 0; attempt < 3; attempt++ {
		packet, err = config.ListenPacket(ctx, network, address)
		if err != nil {
			return nil, err
		}
		if packet.LocalAddr().(*net.UDPAddr).Port != int(peer.kernel.remote.Port()) {
			break
		}
		_ = packet.Close()
		packet = nil
	}
	if packet == nil {
		return nil, errors.New("SOCKS fixture could not retain a distinct real relay port")
	}
	remote := packet.LocalAddr().(*net.UDPAddr).AddrPort()
	if remote == peer.kernel.remote || remote.Addr() != peer.kernel.local || remote.Port() == 0 {
		_ = packet.Close()
		return nil, errors.New("SOCKS peer did not negotiate an independent UDP relay")
	}
	relay := &desktopExternalSOCKSRelay{PacketConn: packet, owner: l.owner, control: l.control, address: remote, closed: make(chan struct{})}
	peer.kernel.mu.Lock()
	if peer.kernel.socksRelays[remote] || !peer.kernel.source.live.Load() {
		peer.kernel.mu.Unlock()
		_ = packet.Close()
		return nil, errors.New("SOCKS fixture attempted to reuse an active listener owner")
	}
	peer.kernel.socksRelays[remote] = true
	peer.kernel.mu.Unlock()
	l.relay = relay
	l.control.associated.Store(true)
	l.owner.mu.Lock()
	l.owner.relays = append(l.owner.relays, relay)
	l.owner.mu.Unlock()
	return relay, nil
}

func (r *desktopExternalSOCKSRelay) ReadFrom(body []byte) (int, net.Addr, error) {
	r.readStarted.Store(true)
	for {
		n, source, err := r.PacketConn.ReadFrom(body)
		if err != nil {
			return n, source, err
		}
		allowed, known, _ := r.owner.peer.kernel.grantedPacketTo(r.address, source, time.Now())
		if !allowed {
			if !known {
				r.owner.peer.bypassed.Add(1)
			}
			continue
		}
		client := source.(*net.UDPAddr).AddrPort()
		r.mu.Lock()
		if r.client.IsValid() && r.client != client {
			r.mu.Unlock()
			r.owner.peer.bypassed.Add(1)
			continue
		}
		r.client, r.packets = client, r.packets+1
		r.mu.Unlock()
		r.owner.peer.physicalUDP.Add(1)
		if r.owner.fault == "control-eof" {
			// Retire the actual authenticated control after seeing the first
			// granted packet. No DNS/public success is substituted for its EOF.
			_ = r.control.Conn.Close()
			return 0, nil, net.ErrClosed
		}
		return n, source, nil
	}
}

func (r *desktopExternalSOCKSRelay) Close() error {
	var failure error
	r.closeOnce.Do(func() {
		failure = r.PacketConn.Close()
		r.owner.peer.kernel.mu.Lock()
		delete(r.owner.peer.kernel.socksRelays, r.address)
		r.owner.peer.kernel.mu.Unlock()
		close(r.closed)
	})
	return failure
}

func (p *desktopExternalSOCKSPeer) serve(connection net.Conn) (failure error) {
	control := &desktopExternalSOCKSControl{Conn: connection, readDone: make(chan struct{})}
	listener := &desktopExternalSOCKSListener{owner: p, control: control}
	defer func() {
		_ = control.Conn.Close()
		if listener.relay != nil {
			_ = listener.relay.Close()
			// Reaching the pinned first-packet read proves its TCP observer
			// was launched. Join that read before the provider worker retires.
			if listener.relay.readStarted.Load() {
				select {
				case <-control.readDone:
				case <-time.After(3 * time.Second):
					p.joinFailed.Store(true)
					failure = errors.Join(failure, errors.New("SOCKS provider TCP observer did not join"))
				}
			}
		}
	}()
	if p.fault == "auth-downgrade" || p.fault == "relay-domain" || p.fault == "relay-wildcard" || p.fault == "relay-zero" || p.fault == "relay-uncaptured" {
		return p.refuse(control)
	}
	password := desktopExternalIntegrationPassword
	if p.peer.badAuth {
		password += "-different-peer"
	}
	authenticator := auth.NewAuthenticator([]auth.User{{Username: desktopExternalIntegrationUser, Password: password}})
	err := socks.HandleConnectionEx(p.peer.ctx, control, bufio.NewReader(control), authenticator, p.peer, listener,
		5*time.Second, M.SocksaddrFromNet(connection.RemoteAddr()), nil)
	if p.peer.badAuth && err != nil {
		p.peer.authFailures.Add(1)
		// The pinned server's diagnostic includes credentials. Keep only the
		// fixed test phase, while its real authentication verdict is unchanged.
		return errors.New("captured SOCKS authentication rejected")
	}
	return err
}

func (p *desktopExternalSOCKSPeer) refuse(connection net.Conn) error {
	reader := bufio.NewReader(connection)
	offer, err := socks5.ReadAuthRequest(reader)
	if err != nil || len(offer.Methods) != 1 || offer.Methods[0] != socks5.AuthTypeUsernamePassword {
		return errors.New("SOCKS negative peer lost the exact offered authentication method")
	}
	if p.fault == "auth-downgrade" {
		if err := socks5.WriteAuthResponse(connection, socks5.AuthResponse{Method: socks5.AuthTypeNotRequired}); err != nil {
			return err
		}
	} else {
		if err := socks5.WriteAuthResponse(connection, socks5.AuthResponse{Method: socks5.AuthTypeUsernamePassword}); err != nil {
			return err
		}
		credentials, err := socks5.ReadUsernamePasswordAuthRequest(reader)
		if err != nil || credentials.Username != desktopExternalIntegrationUser || credentials.Password != desktopExternalIntegrationPassword {
			return errors.New("SOCKS reply negative changed original credentials")
		}
		if err := socks5.WriteUsernamePasswordAuthResponse(connection, socks5.UsernamePasswordAuthResponse{Status: socks5.UsernamePasswordStatusSuccess}); err != nil {
			return err
		}
		request, err := socks5.ReadRequest(reader)
		if err != nil || request.Command != socks5.CommandUDPAssociate {
			return errors.New("SOCKS reply negative lost its actual UDP association request")
		}
		bind := M.Socksaddr{Addr: p.peer.kernel.local, Port: p.peer.kernel.remote.Port()}
		switch p.fault {
		case "relay-domain":
			bind = M.ParseSocksaddr("unrequested-relay.example:5353")
		case "relay-wildcard":
			bind.Addr = netip.IPv4Unspecified()
		case "relay-zero":
			bind.Port = 0
		case "relay-uncaptured":
			// The control port has no bound UDP listener or independent grant.
			// This is an exact OS-fixture refusal, not a private-IP policy test.
		}
		if err := socks5.WriteResponse(connection, socks5.Response{ReplyCode: socks5.ReplyCodeSuccess, Bind: bind}); err != nil {
			return err
		}
	}
	var body [1]byte
	n, err := reader.Read(body[:])
	if n != 0 || !errors.Is(err, io.EOF) {
		return errors.New("SOCKS rejected reply did not retire its original TCP control")
	}
	p.refused.Add(1)
	p.refusedOnce.Do(func() { close(p.refusedDone) })
	return nil
}

func (p *desktopExternalSOCKSPeer) joined(t *testing.T) {
	t.Helper()
	if p.joinFailed.Load() {
		t.Error("SOCKS provider did not join its original TCP observer")
	}
	for _, relay := range p.snapshot() {
		select {
		case <-relay.closed:
		default:
			t.Error("SOCKS provider retained an owned UDP listener after peer cleanup")
		}
	}
	p.peer.kernel.mu.Lock()
	remaining := len(p.peer.kernel.socksRelays)
	p.peer.kernel.mu.Unlock()
	if remaining != 0 {
		t.Error("SOCKS OS fixture retained a retired provider tuple")
	}
}

func (p *desktopExternalSOCKSPeer) proved(t *testing.T, f *desktopExternalIntegrationFixture) {
	t.Helper()
	capture, err := f.policy.Capture()
	if err != nil || len(capture.PhysicalRoots) != 1 || len(capture.PhysicalRoots[0].Destinations) != 1 ||
		!capture.PhysicalRoots[0].DynamicSOCKSUDP || capture.PhysicalRoots[0].SOCKSVersion != "5" ||
		capture.PhysicalRoots[0].SOCKSControl == nil || capture.PhysicalRoots[0].SOCKSControl.Network != "tcp" ||
		capture.PhysicalRoots[0].Destinations[0].Network != "tcp" || capture.SelectedDNS.Type != "udp" || capture.SelectedDNS.Physical ||
		p.peer.listener == nil || p.peer.packet != nil || p.peer.accepted.Load() < 2 ||
		p.peer.physicalUDP.Load() == 0 || p.peer.udpQueries.Load() != p.peer.dnsQueries.Load() || p.peer.udpQueries.Load() == 0 {
		t.Fatal("SOCKS proof lost its original TCP control, dynamic UDP association or selected DNS", err, p.peer.diagnostic())
	}
	relays := p.snapshot()
	if len(relays) == 0 {
		t.Fatal("SOCKS proof never negotiated a real relay")
	}
	for _, relay := range relays {
		if relay.address == p.peer.kernel.remote || relay.address.Port() == 0 {
			t.Fatal("SOCKS provider guessed the UDP control port")
		}
	}
	physical, exists := f.box.outbound.Outbound(mobilemultihop.DesktopExternalPhysicalTag)
	if !exists {
		t.Fatal("SOCKS proof lost its actual lower manager")
	}
	if connection, err := physical.DialContext(context.Background(), "udp", M.SocksaddrFromNetIP(relays[0].address)); err == nil || connection != nil {
		if connection != nil {
			_ = connection.Close()
		}
		t.Fatal("authenticated SOCKS reply broadened the ordinary shared lower map")
	}
}

func (p *desktopExternalSOCKSPeer) rejected(t *testing.T, fault string) {
	t.Helper()
	if fault == "auth-downgrade" || fault == "relay-domain" || fault == "relay-wildcard" || fault == "relay-zero" || fault == "relay-uncaptured" {
		// Require actual client EOF before cleanup can close the provider end.
		select {
		case <-p.refusedDone:
		case <-time.After(3 * time.Second):
			t.Fatal("rejected SOCKS reply did not close its original native control", p.peer.diagnostic())
		}
		p.peer.close()
		if p.refused.Load() == 0 || p.peer.accepted.Load() == 0 || len(p.snapshot()) != 0 || p.peer.physicalUDP.Load() != 0 ||
			p.peer.dnsQueries.Load() != 0 || p.peer.publicAttempts.Load() != 0 || p.peer.bypassed.Load() != 0 {
			t.Fatal("invalid SOCKS reply escaped the original control-only rejection", fault, p.peer.diagnostic())
		}
	}
	if fault == "control-eof" && (len(p.snapshot()) == 0 || p.peer.physicalUDP.Load() == 0 || p.peer.dnsQueries.Load() != 0 || p.peer.publicAttempts.Load() != 0) {
		t.Fatal("TCP control EOF did not retire the actual first UDP association", p.peer.diagnostic())
	}
}

func desktopExternalSOCKSExchange(connection net.Conn, id uint16) error {
	if err := connection.SetDeadline(time.Now().Add(3 * time.Second)); err != nil {
		return err
	}
	question := new(mDNS.Msg).SetQuestion("example.com.", mDNS.TypeA)
	question.Id = id
	raw, err := question.Pack()
	if err != nil {
		return err
	}
	if n, err := connection.Write(raw); err != nil || n != len(raw) {
		return errors.Join(err, errors.New("SOCKS independent association did not send complete DNS bytes"))
	}
	buffer := make([]byte, 4096)
	n, err := connection.Read(buffer)
	var response mDNS.Msg
	if err != nil || response.Unpack(buffer[:n]) != nil || response.Id != id || !response.Response || len(response.Answer) != 1 {
		return errors.Join(err, errors.New("SOCKS association returned another DNS transaction"))
	}
	answer, ok := response.Answer[0].(*mDNS.A)
	if !ok || answer.A.String() != "93.184.216.34" {
		return errors.New("SOCKS association bypassed selected DNS response validation")
	}
	return nil
}

func (r *desktopExternalSOCKSRelay) receipts(t *testing.T) (tcp, udp mobiletor.DesktopSocketGrant) {
	t.Helper()
	r.mu.Lock()
	client, packets := r.client, r.packets
	r.mu.Unlock()
	if !client.IsValid() || packets == 0 {
		t.Fatal("SOCKS association never observed a granted native packet")
	}
	control := r.control.RemoteAddr().(*net.TCPAddr).AddrPort()
	kernel := r.owner.peer.kernel
	kernel.mu.Lock()
	defer kernel.mu.Unlock()
	for _, receipt := range kernel.issued {
		grant := receipt.grant
		if grant.Network == "tcp" && grant.Local == control && grant.Remote == kernel.remote {
			tcp = grant
		}
		if grant.Network == "udp" && grant.Local == client && grant.Remote == r.address {
			udp = grant
		}
	}
	if tcp.SocketID == "" || udp.SocketID == "" || tcp.SocketID == udp.SocketID || tcp.Capture != udp.Capture || tcp.Capture != kernel.source.capture {
		t.Fatal("SOCKS peer lost its separate original control and UDP socket receipts")
	}
	return
}

func desktopExternalSOCKSIntegration(t *testing.T, ca *desktopExternalIntegrationCA) {
	if runtime.GOOS != "linux" && runtime.GOOS != "windows" {
		t.Fatal("ordinary SOCKS5 association acceptance requires the captured native host")
	}
	t.Run("socks5/dns-cached-control-loss", desktopExternalSOCKSDNSCachedLoss)
	t.Run("socks5/selected-dns-retained-control-retirement", func(t *testing.T) {
		f := newDesktopExternalIntegrationFixture(t, ca, "socks5", "")
		f.prove(t)
		var retired *desktopExternalSOCKSRelay
		var retiredTCP, retiredUDP string
		for operation := 0; operation < 2; operation++ {
			if operation != 0 {
				before := f.peer.udpQueries.Load()
				associations := len(f.peer.socks.snapshot())
				if err := f.proof.engine.DNSProof(context.Background(), "tun-in"); err != nil {
					t.Fatal("selected DNS failed after observed original cache retirement", err)
				}
				if f.peer.udpQueries.Load() <= before || len(f.peer.socks.snapshot()) != associations+1 {
					t.Fatal("selected DNS did not create exactly one new authenticated provider association")
				}
			}
			var selected *desktopExternalSOCKSRelay
			for _, relay := range f.peer.socks.snapshot() {
				select {
				case <-relay.closed:
					continue
				default:
				}
				if selected != nil {
					t.Fatal("selected DNS retained multiple provider associations")
				}
				selected = relay
			}
			if selected == nil {
				t.Fatal("successful proof incorrectly discarded the retained DNS connection")
			}
			tcp, udp := selected.receipts(t)
			if retired != nil && (selected == retired || selected.control == retired.control || tcp.SocketID == retiredTCP || udp.SocketID == retiredUDP) {
				t.Fatal("reconnected DNS reused its retired control or native socket owner")
			}
			retired, retiredTCP, retiredUDP = selected, tcp.SocketID, udp.SocketID
			deadline := time.Now().Add(2 * time.Second)
			for {
				f.kernel.mu.Lock()
				count := len(f.kernel.grants)
				_, control := f.kernel.grants[tcp.SocketID]
				_, packet := f.kernel.grants[udp.SocketID]
				f.kernel.mu.Unlock()
				if count == 2 && control && packet {
					break
				}
				if !time.Now().Before(deadline) {
					t.Fatal("selected DNS did not retain exactly its original TCP and UDP grants")
				}
				time.Sleep(time.Millisecond)
			}
			root, found := f.box.outbound.Outbound(mobilemultihop.ExternalFinalTag)
			observer, ok := root.(interface {
				ObserveAssociationRetirement(netip.AddrPort, netip.AddrPort) (func(context.Context) error, error)
			})
			if !found || !ok {
				t.Fatal("selected DNS lost its exact native retirement observer")
			}
			wait, err := observer.ObserveAssociationRetirement(tcp.Local, udp.Remote)
			if err != nil {
				t.Fatal("selected DNS could not capture its original control/relay retirement", err)
			}
			_ = selected.control.Conn.Close()
			select {
			case <-selected.closed:
			case <-time.After(2 * time.Second):
				t.Fatal("selected DNS provider control did not join")
			}
			deadline = time.Now().Add(2 * time.Second)
			for {
				f.kernel.mu.Lock()
				count := len(f.kernel.grants)
				f.kernel.mu.Unlock()
				if count == 0 {
					break
				}
				if !time.Now().Before(deadline) {
					t.Fatal("explicit DNS control retirement did not join its exact socket grants")
				}
				time.Sleep(time.Millisecond)
			}
			// A forced native read deadline may report a timeout while the old
			// DNS receiver is retiring. Do not use that error as retry permission.
			// The pinned pool removes its shared slot before calling this exact
			// returned connection's Close; observe that joined operation instead.
			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
			err = wait(ctx)
			cancel()
			if err != nil {
				t.Fatal("selected DNS did not automatically retire its original cached connection", err)
			}
			if !f.proof.Healthy() || !f.network.Current() {
				t.Fatal("DNS association retirement replaced its original healthy source")
			}
		}
	})
	t.Run("socks5/independent-associations-control-eof", func(t *testing.T) {
		f := newDesktopExternalIntegrationFixture(t, ca, "socks5", "")
		f.prove(t)
		before := len(f.peer.socks.snapshot())
		ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
		defer cancel()
		root, exists := f.box.outbound.Outbound(mobilemultihop.ExternalFinalTag)
		if !exists {
			t.Fatal("actual native SOCKS root disappeared after proof")
		}
		a, err := root.DialContext(ctx, "udp", M.ParseSocksaddr(desktopExternalIntegrationDNS))
		if err != nil {
			t.Fatal("first actual association", err)
		}
		defer a.Close()
		b, err := root.DialContext(ctx, "udp", M.ParseSocksaddr(desktopExternalIntegrationDNS))
		if err != nil {
			t.Fatal("second actual association", err)
		}
		defer b.Close()
		if err := desktopExternalSOCKSExchange(a, 401); err != nil {
			t.Fatal(err)
		}
		if err := desktopExternalSOCKSExchange(b, 402); err != nil {
			t.Fatal(err)
		}
		relays := f.peer.socks.snapshot()
		if len(relays) != before+2 {
			t.Fatal("native associations did not retain separate original controls")
		}
		first, second := relays[before], relays[before+1]
		aTCP, aUDP := first.receipts(t)
		bTCP, bUDP := second.receipts(t)
		if aTCP.SocketID == bTCP.SocketID || aUDP.SocketID == bUDP.SocketID || aUDP.Local == bUDP.Local || first.control == second.control {
			t.Fatal("independent associations aliased an original control or physical socket")
		}
		_ = first.control.Conn.Close()
		select {
		case <-first.closed:
		case <-ctx.Done():
			t.Fatal("first control EOF did not retire its actual provider relay")
		}
		// Observe the native control observer revoke its exact two grants before
		// testing closure. A timed-out DNS operation is not evidence of EOF.
		deadline := time.NewTimer(2 * time.Second)
		defer deadline.Stop()
		tick := time.NewTicker(time.Millisecond)
		defer tick.Stop()
		for {
			f.kernel.mu.Lock()
			_, oldTCP := f.kernel.grants[aTCP.SocketID]
			_, oldUDP := f.kernel.grants[aUDP.SocketID]
			_, nextTCP := f.kernel.grants[bTCP.SocketID]
			_, nextUDP := f.kernel.grants[bUDP.SocketID]
			f.kernel.mu.Unlock()
			if !nextTCP || !nextUDP {
				t.Fatal("first control EOF revoked a sibling association grant")
			}
			if !oldTCP && !oldUDP {
				break
			}
			select {
			case <-deadline.C:
				t.Fatal("first control EOF did not revoke its original TCP and UDP grants")
			case <-tick.C:
			}
		}
		if err := a.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil && !errors.Is(err, net.ErrClosed) {
			t.Fatal(err)
		}
		var retired [1]byte
		if _, err := a.Read(retired[:]); !errors.Is(err, net.ErrClosed) {
			t.Fatal("retired first control did not close its exact UDP reader", err)
		}
		if _, err := a.Write(retired[:]); !errors.Is(err, net.ErrClosed) {
			t.Fatal("retired first control retained UDP write authority", err)
		}
		if err := a.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
			t.Fatal("first native association did not join", err)
		}
		f.kernel.mu.Lock()
		_, oldTCP := f.kernel.grants[aTCP.SocketID]
		_, oldUDP := f.kernel.grants[aUDP.SocketID]
		_, nextTCP := f.kernel.grants[bTCP.SocketID]
		_, nextUDP := f.kernel.grants[bUDP.SocketID]
		f.kernel.mu.Unlock()
		if oldTCP || oldUDP || !nextTCP || !nextUDP {
			t.Fatal("association cleanup revoked a sibling or retained its own physical grants")
		}
		if err := desktopExternalSOCKSExchange(b, 404); err != nil || !f.proof.Healthy() || !f.network.Current() {
			t.Fatal("retired association destroyed a current sibling or proof owner", err)
		}
		f.peer.socks.proved(t, f)
	})
	for _, replacement := range []bool{false, true} {
		name := "cancelled-proof"
		if replacement {
			name = "replacement-keeps-new-source"
		}
		t.Run("socks5/"+name, func(t *testing.T) {
			f := newDesktopExternalIntegrationFixture(t, ca, "socks5", "held-proof")
			finished := make(chan error, 1)
			go func() {
				raw, err := f.proof.Run()
				if raw != "" {
					err = errors.New("retired SOCKS proof published a response")
				}
				finished <- err
			}()
			select {
			case <-f.peer.publicEntered:
			case <-time.After(5 * time.Second):
				t.Fatal("SOCKS cancellation did not reach real selected DNS and public TLS", f.peer.diagnostic())
			}
			var next *desktopExternalIntegrationFixture
			if replacement {
				next = newDesktopExternalIntegrationFixture(t, ca, "socks5", "")
				next.prove(t)
			}
			f.network.InterfaceUpdated(context.Background())
			close(f.peer.publicRelease)
			select {
			case err := <-finished:
				if err == nil || f.proof.Healthy() || f.network.Current() || !f.source.cancelled.Load() {
					t.Fatal("retired SOCKS proof retained native publication", err)
				}
			case <-time.After(3 * time.Second):
				t.Fatal("cancelled SOCKS proof did not join its captured operation")
			}
			if lease, err := f.box.RouterVPNExternalClaimMTU(f.proof, f.originalSource, f.originalCapture); err == nil || lease != nil {
				t.Fatal("cancelled SOCKS proof acquired MTU authority")
			}
			if next != nil {
				if !next.proof.Healthy() || !next.network.Current() || next.source.cancelled.Load() || next.policy.Metadata().OriginalSourceSHA256 == f.policy.Metadata().OriginalSourceSHA256 {
					t.Fatal("old association cancellation changed its replacement source")
				}
				if err := mobilemultihop.ProveExternalPublicIP(context.Background(), next.proof.engine.Dial, mobilemultihop.ExternalFinalTag, desktopExternalIntegrationIP); err != nil {
					t.Fatal(fmt.Errorf("replacement lost fresh public proof: %w", err))
				}
			}
		})
	}
}

// The provider records only the original authenticated refusal transaction.
// Terminal transport identity is normalized by the OS-specific caller; no
// timeout, arbitrary read error or readable payload can prove retirement.
type desktopExternalSOCKSRefusalReceipt struct {
	Control, Server, Relay            string
	Authenticated, Associate, Replied bool
	Bytes                             int
	Terminal, Failure                 string
}

func desktopExternalSOCKSRefusalTerminal(n int, err, reset error) string {
	if n != 0 {
		return "data"
	}
	if err == io.EOF {
		return "eof"
	}
	operation, ok := err.(*net.OpError)
	if reset != nil && ok && operation.Op == "read" &&
		(operation.Net == "tcp" || operation.Net == "tcp4" || operation.Net == "tcp6") {
		native := operation.Err
		if call, ok := native.(*os.SyscallError); ok {
			native = call.Err
		}
		if native == reset {
			return "reset"
		}
	}
	return "unproved"
}

func desktopExternalSOCKSRefusalValid(r desktopExternalSOCKSRefusalReceipt, control, server, relay string) bool {
	for _, text := range []string{control, server, relay} {
		address, err := netip.ParseAddrPort(text)
		if err != nil || address.Port() == 0 || address.Addr().IsUnspecified() {
			return false
		}
	}
	return r.Control == control && r.Server == server && r.Relay == relay && r.Authenticated && r.Associate && r.Replied &&
		r.Bytes == 0 && (r.Terminal == "eof" || r.Terminal == "reset") && r.Failure == ""
}

func desktopExternalSOCKSRefusalChecks(t *testing.T) {
	t.Helper()
	reset := errors.New("exact native reset sentinel")
	for _, scenario := range []struct {
		name string
		n    int
		err  error
		want string
	}{
		{"eof", 0, io.EOF, "eof"}, {"reset", 0, &net.OpError{Op: "read", Net: "tcp4", Err: reset}, "reset"},
		{"data-eof", 1, io.EOF, "data"}, {"data-reset", 1, &net.OpError{Op: "read", Net: "tcp4", Err: reset}, "data"},
		{"syscall-reset", 0, &net.OpError{Op: "read", Net: "tcp", Err: &os.SyscallError{Syscall: "wsarecv", Err: reset}}, "reset"},
		{"outer-mixed-reset", 0, errors.Join(&net.OpError{Op: "read", Net: "tcp", Err: reset}, errors.New("other failure")), "unproved"},
		{"mixed-reset", 0, &net.OpError{Op: "read", Net: "tcp", Err: errors.Join(reset, errors.New("other failure"))}, "unproved"},
		{"nil", 0, nil, "unproved"}, {"timeout", 0, &net.OpError{Op: "read", Net: "tcp", Err: os.ErrDeadlineExceeded}, "unproved"},
		{"other-error", 0, errors.New("connection reset by peer"), "unproved"},
		{"raw-reset", 0, reset, "unproved"}, {"write-reset", 0, &net.OpError{Op: "write", Net: "tcp", Err: reset}, "unproved"},
		{"udp-reset", 0, &net.OpError{Op: "read", Net: "udp", Err: reset}, "unproved"},
	} {
		t.Run(scenario.name, func(t *testing.T) {
			if got := desktopExternalSOCKSRefusalTerminal(scenario.n, scenario.err, reset); got != scenario.want {
				t.Fatal("refusal terminal changed", got)
			}
		})
	}
	if desktopExternalSOCKSRefusalValid(desktopExternalSOCKSRefusalReceipt{Authenticated: true, Associate: true, Replied: true, Terminal: "eof"}, "", "", "") {
		t.Fatal("empty original identity accepted")
	}
	original := desktopExternalSOCKSRefusalReceipt{Control: "192.168.1.2:45678", Server: "192.168.1.3:1080", Relay: "10.254.253.252:5353", Authenticated: true, Associate: true, Replied: true, Terminal: "eof"}
	if !desktopExternalSOCKSRefusalValid(original, original.Control, original.Server, original.Relay) {
		t.Fatal("complete original refusal lost its terminal evidence")
	}
	for _, field := range []string{"control", "server", "relay", "auth", "associate", "reply", "bytes", "timeout", "other-error", "failure"} {
		t.Run("receipt-"+field, func(t *testing.T) {
			r := original
			switch field {
			case "control":
				r.Control = "192.168.1.2:45679"
			case "server":
				r.Server = "192.168.1.4:1080"
			case "relay":
				r.Relay = "10.254.253.251:5353"
			case "auth":
				r.Authenticated = false
			case "associate":
				r.Associate = false
			case "reply":
				r.Replied = false
			case "bytes":
				r.Bytes = 1
			case "timeout":
				r.Terminal = "timeout"
			case "other-error":
				r.Terminal = "unproved"
			case "failure":
				r.Failure = "provider read failed"
			}
			if desktopExternalSOCKSRefusalValid(r, original.Control, original.Server, original.Relay) {
				t.Fatal("changed refusal receipt accepted", field)
			}
		})
	}
}

func TestRouterVPNDesktopSOCKSRefusalEvidence(t *testing.T) { desktopExternalSOCKSRefusalChecks(t) }

// A closed-only tree identifies the original transport's terminal callback.
// A timeout, cancellation, mixed failure or textual lookalike is never a retry.
func desktopExternalSOCKSDNSClosed(err error, depth int) bool {
	if err == nil || depth >= 16 {
		return false
	}
	if err == net.ErrClosed {
		return true
	}
	if joined, ok := err.(interface{ Unwrap() []error }); ok {
		children := joined.Unwrap()
		if len(children) == 0 || len(children) > 16 {
			return false
		}
		for _, child := range children {
			if !desktopExternalSOCKSDNSClosed(child, depth+1) {
				return false
			}
		}
		return true
	}
	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
		return desktopExternalSOCKSDNSClosed(wrapped.Unwrap(), depth+1)
	}
	return false
}

// Only this deterministic scheduling test models the DNS wire. It exercises
// the unchanged pinned multiplexer, keeping the second write entered while
// the old receive loop invalidates its original cached connection.
type desktopExternalSOCKSDNSConn struct {
	net.Conn
	held                                                                    bool
	responses                                                               chan []byte
	readEntered, readRelease, writeEntered, writeRelease, writeDone, closed chan struct{}
	readCount, writeCount                                                   atomic.Int32
	once                                                                    sync.Once
}

func (c *desktopExternalSOCKSDNSConn) Read(b []byte) (int, error) {
	if c.held && c.readCount.Add(1) == 2 {
		close(c.readEntered)
		select {
		case <-c.readRelease:
			return 0, net.ErrClosed
		case <-c.closed:
			return 0, net.ErrClosed
		}
	}
	select {
	case response := <-c.responses:
		return copy(b, response), nil
	case <-c.closed:
		return 0, net.ErrClosed
	}
}
func (c *desktopExternalSOCKSDNSConn) Write(b []byte) (int, error) {
	if c.held && c.writeCount.Add(1) == 2 {
		close(c.writeEntered)
		// Keep the already-entered write suspended even when Close has retired
		// the connection; only the test releases its scheduled return.
		<-c.writeRelease
		close(c.writeDone)
		return 0, net.ErrClosed
	}
	var q mDNS.Msg
	if err := q.Unpack(b); err != nil {
		return 0, err
	}
	answer := new(mDNS.Msg).SetReply(&q)
	raw, err := answer.Pack()
	if err != nil {
		return 0, err
	}
	select {
	case c.responses <- raw:
		return len(b), nil
	case <-c.closed:
		return 0, net.ErrClosed
	}
}
func (c *desktopExternalSOCKSDNSConn) Close() error {
	c.once.Do(func() { close(c.closed) })
	return nil
}
func (c *desktopExternalSOCKSDNSConn) SetDeadline(time.Time) error      { return nil }
func (c *desktopExternalSOCKSDNSConn) SetReadDeadline(time.Time) error  { return nil }
func (c *desktopExternalSOCKSDNSConn) SetWriteDeadline(time.Time) error { return nil }

type desktopExternalSOCKSDNSDialer struct {
	connections []*desktopExternalSOCKSDNSConn
	calls       atomic.Int32
}

func (d *desktopExternalSOCKSDNSDialer) DialContext(ctx context.Context, network string, address M.Socksaddr) (net.Conn, error) {
	index := int(d.calls.Add(1)) - 1
	if ctx.Err() != nil || network != "udp" || address.String() != "192.168.50.53:5353" || index >= len(d.connections) {
		return nil, errors.New("DNS scheduling fixture changed exact dial ownership")
	}
	return d.connections[index], nil
}
func (d *desktopExternalSOCKSDNSDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
	return nil, errors.New("DNS scheduling fixture used another transport")
}
func desktopExternalSOCKSDNSCachedLoss(t *testing.T) {
	for _, failure := range []error{nil, context.Canceled, context.DeadlineExceeded, os.ErrDeadlineExceeded, errors.New(net.ErrClosed.Error()), errors.Join(net.ErrClosed, context.Canceled), errors.Join(net.ErrClosed, os.ErrDeadlineExceeded)} {
		if desktopExternalSOCKSDNSClosed(failure, 0) {
			t.Fatal("unrelated DNS failure became cached-control retirement", failure)
		}
	}
	if !desktopExternalSOCKSDNSClosed(fmt.Errorf("original read: %w", net.ErrClosed), 0) {
		t.Fatal("original closed connection lost its terminal cause")
	}
	makeConn := func(held bool) *desktopExternalSOCKSDNSConn {
		return &desktopExternalSOCKSDNSConn{held: held, responses: make(chan []byte, 1), readEntered: make(chan struct{}), readRelease: make(chan struct{}), writeEntered: make(chan struct{}), writeRelease: make(chan struct{}), writeDone: make(chan struct{}), closed: make(chan struct{})}
	}
	first, second := makeConn(true), makeConn(false)
	t.Cleanup(func() {
		select {
		case <-first.writeRelease:
		default:
			close(first.writeRelease)
		}
		select {
		case <-first.readRelease:
		default:
			close(first.readRelease)
		}
		_ = first.Close()
		_ = second.Close()
	})
	dialer := &desktopExternalSOCKSDNSDialer{connections: []*desktopExternalSOCKSDNSConn{first, second}}
	transport := dnsTransport.NewUDPRaw(log.NewNOPFactory().Logger(), dnsCore.NewTransportAdapter("udp", "original-socks-dns", nil), dialer, M.ParseSocksaddr("192.168.50.53:5353"))
	defer transport.Close()
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()
	wait := func(done <-chan struct{}) {
		select {
		case <-done:
		case <-ctx.Done():
			t.Fatal("DNS scheduling fixture missed exact entered boundary", ctx.Err())
		}
	}
	question := new(mDNS.Msg).SetQuestion("example.com.", mDNS.TypeA)
	if _, err := transport.Exchange(ctx, question); err != nil {
		t.Fatal(err)
	}
	wait(first.readEntered)
	failed := make(chan error, 1)
	returned := make(chan struct{})
	go func() {
		defer close(returned)
		transport.ExchangeAsync(ctx, question, func(_ *mDNS.Msg, err error) { failed <- err })
	}()
	wait(first.writeEntered)
	close(first.readRelease)
	select {
	case err := <-failed:
		if !desktopExternalSOCKSDNSClosed(err, 0) {
			t.Fatal("original cached read did not return its exact terminal error", err)
		}
	case <-ctx.Done():
		t.Fatal(ctx.Err())
	}
	if dialer.calls.Load() != 1 {
		t.Fatal("failed in-flight query retried itself")
	}
	if answer, err := transport.Exchange(ctx, question); err != nil || answer == nil || answer.Id != question.Id || !answer.Response || dialer.calls.Load() != 2 {
		t.Fatal("next query did not use the independently new cached connection", err)
	}
	close(first.writeRelease)
	wait(first.writeDone)
	wait(returned)
	select {
	case err := <-failed:
		t.Fatal("retired DNS write completed its callback twice", err)
	default:
	}
}
