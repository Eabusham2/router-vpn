			var closeErr error
			if server != nil {
				closeErr = server.Close()
			}
			closeErr = errors.Join(closeErr, tlsConfig.Close())
			_ = finalTCP.Close()
			_ = finalUDP.Close()
			if !desktopExternalWFPCloseJoined(closeErr, 0) {
				t.Error("SS entry HY2 provider close failed", closeErr)
			}
		}
		if err != nil {
			t.Fatal(err)
		}
		password := desktopExternalIntegrationPassword
		if r.Fault == "final-key" {
			password += "-wrong"
		}
		server.UpdateUsers([]int{1}, []string{password})
		if err = tlsConfig.Start(); err == nil {
			err = server.Start(finalUDP)
		}
		if err != nil {
			t.Fatal("independent SS entry HY2 startup", err)
		}
