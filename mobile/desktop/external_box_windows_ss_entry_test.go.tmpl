						deadline.Stop()
						after := p.call(t, "stats", "")
						if after.SSFinalLayer == nil || !after.SSFinalLayer.UDPOnly || after.SSFinalLayer.RawTCP != 0 || after.SSFinalLayer.TCP != 0 || after.DNS != before.DNS || after.Public != before.Public || !f.proof.Healthy() || !f.network.Current() {
							t.Fatal("forbidden TCP changed final authority", after)
						}
						desktopExternalWFPSSEntrySnapshot(t, f, p, final)
						retained = f.drain(t)
						return
					}
					if strings.HasPrefix(name, "reject/") || name == "cancelled-proof" {
						type result struct {
							raw string
							err error
						}
						done := make(chan result, 1)
						go func() { raw, e := f.proof.Run(); done <- result{raw, e} }()
						if name == "reject/entry-key" || name == "reject/final-key" {
							limit := time.NewTimer(10 * time.Second)
							defer limit.Stop()
						credentialRejection:
							for p.call(t, "stats", "").AuthFailures == 0 {
								select {
								case outcome := <-done:
									if final != "hysteria2" || name != "reject/final-key" || p.call(t, "stats", "").AuthFailures == 0 {
										t.Fatal("SS credential proof ended without native authentication rejection", outcome.err)
									}
									done <- outcome
									break credentialRejection
								case <-limit.C:
									f.proof.Cancel()
									t.Fatal("SS credential rejection not observed")
								case <-time.After(10 * time.Millisecond):
								}
							}
							f.proof.Cancel()
						}
						if strings.Contains(name, "-layer-") || strings.Contains(name, "-whitening") {
							limit := time.NewTimer(10 * time.Second)
							defer limit.Stop()
						layerRejection:
							for {
								observed := p.call(t, "stats", "")
								receipt := observed.SSFinalLayer
								if strings.HasPrefix(name, "reject/entry-") {
									receipt = observed.SSEntryLayer
								}
								if receipt != nil && receipt.Rejected > 0 {
									break
								}
								select {
								case result := <-done:
									done <- result
									observed := p.call(t, "stats", "")
									receipt := observed.SSFinalLayer
									if strings.HasPrefix(name, "reject/entry-") {
										receipt = observed.SSEntryLayer
									}
									if receipt == nil || receipt.Rejected == 0 {
										t.Fatal("layer proof ended before independent rejection", result.err)
									}
									break layerRejection
								case <-limit.C:
									f.proof.Cancel()
									t.Fatal("SS wrapper rejection was not observed")
								case <-time.After(10 * time.Millisecond):
								}
							}
							f.proof.Cancel()
						}
						if name == "cancelled-proof" {
							limit := time.NewTimer(10 * time.Second)
							defer limit.Stop()
							for p.call(t, "stats", "").Public != 1 {
								select {
								case <-limit.C:
									f.proof.Cancel()
									t.Fatal("SS proof did not reach held authenticated response")
								case <-time.After(10 * time.Millisecond):
								}
							}
							f.proof.Cancel()
							p.call(t, "release", "")
						}
						select {
						case outcome := <-done:
							if outcome.err == nil || outcome.raw != "" || f.proof.Healthy() || f.network.Current() {
								t.Fatal("rejected SS proof acquired authority")
							}
						case <-time.After(12 * time.Second):
							f.proof.Cancel()
							t.Fatal("SS rejection failed to join")
						}
						stats := p.call(t, "stats", "")
						if final == "hysteria2" && stats.SSFinalLayer != nil && (!stats.SSFinalLayer.UDPOnly || stats.SSFinalLayer.RawTCP != 0 || stats.SSFinalLayer.TCP != 0) {
							t.Fatal("rejected HY2 path acquired forbidden wrapper TCP", stats)
						}
						if final == "hysteria2" && name == "reject/final-key" && (stats.AuthFailures == 0 || stats.SSEntryTLS != 1 || stats.SSEntryUDP == 0 || stats.SSEntryTCP != 0 || stats.DNS != 0 || stats.UDPDNS != 0 || stats.TLS != 0) {
							t.Fatal("wrong HY2 credential reached final data or bypassed SS carrier", stats)
						}
						if name == "reject/final-trust" && (stats.SSEntryPublic != 1 || stats.SSEntryTLS != 1 || stats.SSEntryUDP == 0 || stats.DNS != 0 || stats.Public != 0 || stats.TLS != 0) {
							t.Fatal("untrusted final bypassed independent entry or reached final proof", stats)
						}
						if name == "reject/entry-exit" && (stats.SSEntryPublic != 1 || stats.SSEntryTLS != 1 || stats.SSEntryTCP != 0 || stats.DNS != 0) {
							t.Fatal("wrong entry IP reached final path", stats)
						}
						if name == "reject/entry-key" && (stats.SSEntryPublic != 0 || stats.SSEntryTCP != 0 || stats.DNS != 0) {
							t.Fatal("wrong entry credential reached inner proof", stats)
						}
						entryBlocked := name == "reject/entry-key" || strings.HasPrefix(name, "reject/entry-layer-") || name == "reject/entry-whitening"
						if entryBlocked && (stats.SSEntryPublic != 0 || stats.DNS != 0 || stats.TLS != 0 || stats.Public != 0) {
							t.Fatal("rejected outer entry wrapper reached inner authority", stats)
						}
						if !entryBlocked && stats.SSEntryPublic != 1 {
							t.Fatal("final rejection omitted independent entry proof", stats)
						}
						if name == "cancelled-proof" {
							if stats.Public != 1 || stats.Attempts != 1 || stats.TLS != 1 {
								t.Fatal("cancelled SS proof replayed held request", stats)
							}
						} else if stats.Public != 0 && name != "reject/exit" {
							t.Fatal("failed SS path reached public proof", stats)
						}
						retained = f.drain(t)
						return
					}
					prove(f)
					oracle := desktopExternalWFPStartReference(t, ca, "")
					desktopExternalWFPRequireBlocked(t, oracle)
					retained = f.drain(t)
					desktopExternalWFPRequireBlocked(t, oracle)
					if name == "successor-and-original-restore" || strings.HasPrefix(name, "layers/") {
						previous := retained
						next := desktopExternalWFPBox(t, original, source, capture, &previous, false)
						next.start(t)
						prove(next)
						if next.original != original || next.source != source || next.capture != capture || next.prepared.Capture.SessionID == previous.Capture.SessionID || f.proof.Healthy() {
							t.Fatal("SS restore replaced original imported graph")
						}
						retained = next.drain(t)
					}
				})
			}
		})
	}
}
