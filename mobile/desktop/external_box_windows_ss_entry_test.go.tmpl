func desktopExternalWFPSSEntrySnapshot(t *testing.T, f *desktopExternalWFPFixture, p *desktopExternalWFPReference, final string) {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	// Hold a real final DNS TCP conversation while observing its entry grant.
	// Completed public proofs close their short-lived TCP sockets, so their old
	// grants must never be mistaken for currently owned WFP authority.
	c, e := f.proof.engine.Dial(ctx, mobilemultihop.ExternalFinalTag, desktopExternalIntegrationDNS)
	if e != nil {
		t.Fatal("SS entry live grant conversation", e)
	}
	defer c.Close()
	_ = c.SetDeadline(time.Now().Add(3 * time.Second))
	dns := &mDNS.Conn{Conn: c}
	q := new(mDNS.Msg)
	q.SetQuestion("example.com.", mDNS.TypeA)
	if e = dns.WriteMsg(q); e != nil {
		t.Fatal(e)
	}
	if _, e = dns.ReadMsg(); e != nil {
		t.Fatal(e)
	}
	actual, e := mobiletor.DesktopWindowsNodeCompositionSnapshot(ctx)
	if e != nil || actual.Closed || actual.Target != f.prepared || actual.TunnelLUID != f.tun.luid || actual.Owner.Kind != "windows-isolated-token" || !actual.Options.RetainBaselineForHandoff || actual.TunnelName != f.tun.options.InterfaceName || actual.TunnelIndex != uint32(f.tun.index) || len(actual.Grants) == 0 {
		t.Fatal("SS entry lost actual WFP/TUN capture", e)
	}
	hasUDP := false
	for _, grant := range actual.Grants {
		hasUDP = hasUDP || grant.Network == "udp"
		if grant.Remote != p.remote || grant.Local.Addr() != p.local || grant.Capture != f.prepared.Capture || grant.Binding.Owner != actual.Owner || grant.Sequence == 0 || grant.Network != "tcp" && grant.Network != "udp" || final != "shadowsocks" && final != "hysteria2" && grant.Network != "tcp" {
			t.Fatal("SS final escaped captured entry WFP authority")
		}
	}
	if final == "hysteria2" && !hasUDP {
		t.Fatal("HY2 lost original SS UDP carrier grant")
	}
}
