const desktopWFPSSEntryFinal = "198.51.100.240:8388"

type desktopExternalWFPSSEntryRequest struct{ Method, Final, EntryLayer, FinalLayer string }

type desktopWFPSSEntryLayerReceipt struct {
	Mode, Address, Private             string
	RawTCP, RawUDP, TCP, UDP, Rejected int32
	UDPOnly                            bool
}

func (h *desktopWFPSSEntryForward) receipt() *desktopWFPSSEntryLayerReceipt {
	if h == nil {
		return nil
	}
	return &desktopWFPSSEntryLayerReceipt{Mode: h.mode, Address: h.outer.LocalAddr().String(), Private: h.logical, UDPOnly: h.udpOnly, RawTCP: h.rawTCP.Load(), RawUDP: h.rawUDP.Load(), TCP: h.streams.Load(), UDP: h.packets.Load(), Rejected: h.rejected.Load()}
}
func desktopWFPSSEntryReplyIdentity(a, b desktopExternalWFPReply) bool {
	same := func(x, y *desktopWFPSSEntryLayerReceipt) bool {
		if x == nil || y == nil {
			return x == nil && y == nil
		}
		return x.Mode == y.Mode && x.Address == y.Address && x.Private == y.Private && x.UDPOnly == y.UDPOnly
	}
	return a.SSEntryInner == b.SSEntryInner && same(a.SSEntryLayer, b.SSEntryLayer) && same(a.SSFinalLayer, b.SSFinalLayer)
}
func desktopWFPSSEntryInitialReceipt(request *desktopExternalWFPSSEntryRequest, reply desktopExternalWFPReply, local netip.Addr, remote netip.AddrPort, fault string) bool {
	if request == nil {
		return reply.SSEntryInner == "" && reply.SSEntryLayer == nil && reply.SSFinalLayer == nil
	}
	inner, err := netip.ParseAddrPort(reply.SSEntryInner)
	if err != nil || inner.Addr() != local || inner.Port() == 0 || request.EntryLayer == "" && inner != remote || request.EntryLayer != "" && inner == remote || reply.SSEntryTCP != 0 || reply.SSEntryUDP != 0 || reply.SSEntryPublic != 0 || reply.SSEntryTLS != 0 || reply.SSEntryRejected != 0 {
		return false
	}
	for _, row := range []struct {
		role, mode, private string
		receipt             *desktopWFPSSEntryLayerReceipt
	}{{"entry", request.EntryLayer, netip.AddrPortFrom(netip.MustParseAddr("10.94.0.1"), inner.Port()).String(), reply.SSEntryLayer}, {"final", request.FinalLayer, "10.93.0.1:8388", reply.SSFinalLayer}} {
		if row.mode == "" {
			if row.receipt != nil {
				return false
			}
			continue
		}
		private := row.private
		if fault == row.role+"-layer-inner" {
			private = "10.95.0.1:1"
		}
		if row.receipt == nil || row.receipt.Mode != row.mode || row.receipt.UDPOnly != (row.role == "final" && request.Final == "hysteria2") || row.receipt.Private != private || row.receipt.RawTCP != 0 || row.receipt.RawUDP != 0 || row.receipt.TCP != 0 || row.receipt.UDP != 0 || row.receipt.Rejected != 0 {
			return false
		}
		address, err := netip.ParseAddrPort(row.receipt.Address)
		if err != nil || address.Port() == 0 || row.role == "entry" && address != remote || row.role == "final" && !address.Addr().IsLoopback() || row.role == "entry" && row.mode == "aes-256-gcm+xor-whitening" && address.Port() != 8389 {
			return false
		}
	}
	return true
}
func desktopWFPSSEntryReceiptIdentityControl(t *testing.T) {
	t.Helper()
	original := desktopExternalWFPReply{SSEntryInner: "192.0.2.1:1234", SSEntryLayer: &desktopWFPSSEntryLayerReceipt{Mode: "aes-256-gcm", Address: "192.0.2.1:1235", Private: "10.94.0.1:1234"}, SSFinalLayer: &desktopWFPSSEntryLayerReceipt{Mode: "aes-256-gcm", Address: "127.0.0.1:1236", Private: "10.93.0.1:8388"}}
	clone := func() desktopExternalWFPReply {
		copy := original
		entry, last := *original.SSEntryLayer, *original.SSFinalLayer
		copy.SSEntryLayer, copy.SSFinalLayer = &entry, &last
		return copy
	}
	counters := clone()
	counters.SSEntryLayer.TCP = 3
	counters.SSFinalLayer.UDP = 5
	if !desktopWFPSSEntryReplyIdentity(counters, original) {
		t.Fatal("real counters changed static original identity")
	}
	for _, fault := range []string{"raw-inner", "entry-mode", "entry-address", "entry-private", "final-mode", "final-address", "final-private", "final-network", "missing-entry", "missing-final"} {
		changed := clone()
		switch fault {
		case "raw-inner":
			changed.SSEntryInner = "192.0.2.1:9999"
		case "entry-mode":
			changed.SSEntryLayer.Mode = "aes-256-gcm+xor-whitening"
		case "entry-address":
			changed.SSEntryLayer.Address = "192.0.2.1:9999"
		case "entry-private":
			changed.SSEntryLayer.Private = "10.94.0.1:9999"
		case "final-mode":
			changed.SSFinalLayer.Mode = "aes-256-gcm+xor-whitening"
		case "final-address":
			changed.SSFinalLayer.Address = "127.0.0.1:9999"
		case "final-private":
			changed.SSFinalLayer.Private = "10.93.0.1:9999"
		case "final-network":
			changed.SSFinalLayer.UDPOnly = true
		case "missing-entry":
			changed.SSEntryLayer = nil
		case "missing-final":
			changed.SSFinalLayer = nil
		}
		if desktopWFPSSEntryReplyIdentity(changed, original) {
			t.Fatal("changed independent layer receipt admitted", fault)
		}
	}
}

func desktopWFPSSEntryPassword(method string, value byte) string {
	size := 32
	if method == "2022-blake3-aes-128-gcm" {
		size = 16
	}
	return base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{value}, size))
}
func TestRouterVPNDesktopExternalWindowsSSEntryPeer(t *testing.T) {
	desktopExternalWFPRunPeer(t, "ss-entry")
}

func desktopWFPSSEntryAuthError(err error) bool {
	for i := 0; err != nil && i < 16; i++ {
		if _, joined := err.(interface{ Unwrap() []error }); joined {
			return false
		}
		next := errors.Unwrap(err)
		if next == nil {
			return err.Error() == "cipher: message authentication failed" || err.Error() == "chacha20poly1305: message authentication failed"
		}
		err = next
	}
	return false
}

type desktopWFPSSEntryForward struct {
	*desktopExternalIntegrationPeer
	entryProof                 *desktopExternalIntegrationPeer
	target                     string
	final                      string
	streams, packets, rejected atomic.Int32
	rawTCP, rawUDP             atomic.Int32
	logical, inner, mode       string
	udpOnly                    bool
	wireKey                    *[32]byte
	outer                      *desktopExternalWFPDatagrams
	entryLayer, finalLayer     *desktopWFPSSEntryForward
}

func (h *desktopWFPSSEntryForward) destination() string {
	if h.logical != "" {
		return h.logical
	}
	return desktopWFPSSEntryFinal
}

type desktopWFPSSEntryWhiteningStream struct {
	net.Conn
	key                     [32]byte
	readMu, writeMu         sync.Mutex
	readOffset, writeOffset uint64
}

func (c *desktopWFPSSEntryWhiteningStream) Read(body []byte) (int, error) {
	c.readMu.Lock()
	defer c.readMu.Unlock()
	n, err := c.Conn.Read(body)
	for i := 0; i < n; i++ {
		body[i] ^= c.key[(c.readOffset+uint64(i))%32]
	}
	c.readOffset += uint64(n)
	return n, err
}
func (c *desktopWFPSSEntryWhiteningStream) Write(body []byte) (int, error) {
	c.writeMu.Lock()
	defer c.writeMu.Unlock()
	wire := append([]byte(nil), body...)
	for i := range wire {
		wire[i] ^= c.key[(c.writeOffset+uint64(i))%32]
	}
	n, err := c.Conn.Write(wire)
	c.writeOffset += uint64(n)
	clear(wire)
	return n, err
}
func (h *desktopWFPSSEntryForward) NewConnection(ctx context.Context, c net.Conn, m M.Metadata) error {
	if h.entryProof != nil && m.Destination.String() == "1.1.1.1:443" {
		return h.entryProof.serve(c, m.Destination.String())
	}
	if h.final == "hysteria2" || m.Destination.String() != h.destination() {
		h.rejected.Add(1)
		return errors.New("SS entry rejected uncaptured final")
	}
	remote, err := (&net.Dialer{}).DialContext(ctx, "tcp", h.target)
	if err != nil {
		return err
	}
	defer remote.Close()
	stop := context.AfterFunc(h.ctx, func() { _ = c.Close(); _ = remote.Close() })
	defer stop()
	h.streams.Add(1)
	done := make(chan struct{})
	go func() { _, _ = io.Copy(remote, c); _ = remote.Close(); _ = c.Close(); close(done) }()
	_, _ = io.Copy(c, remote)
	_ = remote.Close()
	_ = c.Close()
	<-done
	return nil
}

// The pinned CachedPacketConn owns an unsynchronized initial packet. Take it
// before publishing the connection to concurrent cancellation/retirement. Only
// this bounded memory copy is locked; blocking transport reads remain closable.
type desktopWFPOwnedInitialPacket struct {
	N.PacketConn
	mu     sync.Mutex
	first  *N.PacketBuffer
	closed bool
}

func desktopWFPOwnInitialPacket(connection N.PacketConn) N.PacketConn {
	cached, ok := connection.(*B.CachedPacketConn)
	if !ok {
		return connection
	}
	first := cached.ReadCachedPacket()
	if first != nil && first.Buffer == nil {
		N.PutPacketBuffer(first)
		first = nil
	}
	return &desktopWFPOwnedInitialPacket{PacketConn: connection, first: first}
}
func (c *desktopWFPOwnedInitialPacket) ReadPacket(body *buf.Buffer) (M.Socksaddr, error) {
	c.mu.Lock()
	if c.closed {
		c.mu.Unlock()
		return M.Socksaddr{}, net.ErrClosed
	}
	if first := c.first; first != nil {
		c.first = nil
		destination := first.Destination
		var err error
		if first.Buffer != nil {
			_, err = body.ReadOnceFrom(first.Buffer)
			first.Buffer.Release()
		}
		N.PutPacketBuffer(first)
		c.mu.Unlock()
		return destination, err
	}
	c.mu.Unlock()
	return c.PacketConn.ReadPacket(body)
}
func (c *desktopWFPOwnedInitialPacket) Close() error {
	c.mu.Lock()
	c.closed = true
	if first := c.first; first != nil {
		c.first = nil
		if first.Buffer != nil {
			first.Buffer.Release()
		}
		N.PutPacketBuffer(first)
	}
	c.mu.Unlock()
	return c.PacketConn.Close()
}

func (h *desktopWFPSSEntryForward) NewPacketConnection(ctx context.Context, c N.PacketConn, m M.Metadata) error {
	if (h.final != "shadowsocks" && h.final != "hysteria2") || m.Destination.String() != h.destination() {
		h.rejected.Add(1)
		return errors.New("SS entry rejected unowned UDP final")
	}
	// Capture the real SS writer before the initial-packet ownership wrapper.
	// That wrapper deliberately exposes only PacketConn, so querying it would
	// hide the SS2022 header and AEAD trailer requirements.
	front, rear := N.CalculateFrontHeadroom(c), N.CalculateRearHeadroom(c)
	if front < 0 || rear < 0 || front > 4096 || rear > 4096 {
		_ = c.Close()
		return errors.New("SS entry reply exceeds captured native writer bounds")
	}
	c = desktopWFPOwnInitialPacket(c)
	h.mu.Lock()
	if h.closing {
		h.mu.Unlock()
		_ = c.Close()
		return net.ErrClosed
	}
	h.packetConnections[c] = true
	h.workers.Add(1)
	h.mu.Unlock()
	defer func() { _ = c.Close(); h.mu.Lock(); delete(h.packetConnections, c); h.mu.Unlock(); h.workers.Done() }()
	remote, err := (&net.Dialer{}).DialContext(ctx, "udp", h.target)
	if err != nil {
		return err
	}
	defer remote.Close()
	stop := context.AfterFunc(h.ctx, func() { _ = c.Close(); _ = remote.Close() })
	defer stop()
	h.packets.Add(1)
	done := make(chan struct{})
	go func() {
		defer close(done)
		for {
			body := buf.NewPacket()
			n, e := remote.Read(body.FreeBytes())
			if e != nil {
				body.Release()
				_ = c.Close()
				return
			}
			// Keep the UDP payload bound unchanged; header/trailer capacity is
			// separate and belongs to this captured encrypted writer only.
			reply := buf.NewSize(front + n + rear)
			reply.Resize(front, 0)
			_, _ = reply.Write(body.FreeBytes()[:n])
			body.Release()
			if e = c.WritePacket(reply, m.Destination); e != nil {
				_ = c.Close()
				return
			}
		}
	}()
	for {
		body := buf.NewPacket()
		dst, e := c.ReadPacket(body)
		if e == nil && dst != m.Destination {
			e = errors.New("SS entry destination changed")
		}
		if e == nil {
			_, e = remote.Write(body.Bytes())
		}
		body.Release()
		if e != nil {
			break
		}
	}
	_ = remote.Close()
	<-done
	return nil
}

type desktopWFPSSEntryRetiredPacket struct {
	N.PacketConn
	closed atomic.Int32
}

func (c *desktopWFPSSEntryRetiredPacket) Close() error { c.closed.Add(1); return nil }
func desktopWFPSSEntryRetiredInitialPacket(t *testing.T) {
	t.Helper()
	transport := &desktopWFPSSEntryRetiredPacket{}
	destination := M.ParseSocksaddr(desktopWFPSSEntryFinal)
	cached := B.NewCachedPacketConn(transport, buf.As([]byte("original initial packet")), destination)
	defer cached.Close()
	owner := &desktopWFPSSEntryForward{desktopExternalIntegrationPeer: &desktopExternalIntegrationPeer{closing: true}, final: "shadowsocks"}
	err := owner.NewPacketConnection(context.Background(), cached, M.Metadata{Destination: destination})
	if !errors.Is(err, net.ErrClosed) || transport.closed.Load() != 1 {
		t.Fatal("retired SS owner failed to close transferred initial packet", err, transport.closed.Load())
	}
}

// The entry and final are independent pinned services in the retained provider
// executable. Entry TLS proof terminates here; only the captured final tuple
// is forwardable after entry AEAD.
type desktopWFPSSEntryFinalHandler struct {
	*desktopExternalIntegrationPeer
}

func (h *desktopWFPSSEntryFinalHandler) NewPacketConnection(ctx context.Context, c N.PacketConn, m M.Metadata) error {
	var result error
	h.NewPacketConnectionEx(ctx, desktopWFPOwnInitialPacket(c), m.Source, m.Destination, func(e error) { result = e })
	return result
}
func desktopWFPSSEntryAddressInUse(err error) bool {
	if runtime.GOOS == "windows" {
		// Winsock returns WSAEADDRINUSE. Go's Windows EADDRINUSE is a
		// different, synthetic POSIX value and does not match a native bind.
		return errors.Is(err, syscall.Errno(10048))
	}
	return errors.Is(err, syscall.EADDRINUSE)
}

func desktopWFPSSEntryPortPair(ip netip.Addr, listenTCP func(string, string) (net.Listener, error)) (net.Listener, net.PacketConn, error) {
	candidates, err := desktopWFPSSEntryPortCandidates(runtime.GOOS == "windows", rand.Reader)
	if err != nil {
		return nil, nil, err
	}
	return desktopWFPSSEntryPortPairCandidates(ip, candidates, net.ListenPacket, listenTCP)
}

func desktopWFPSSEntryPortCandidates(windows bool, entropy io.Reader) ([3]uint16, error) {
	var result [3]uint16
	if !windows {
		return result, nil // Preserve the ordinary native port-zero allocator.
	}
	var seed [4]byte
	if entropy == nil {
		return result, errors.New("layer pair has no candidate entropy")
	}
	if _, err := io.ReadFull(entropy, seed[:]); err != nil {
		return result, fmt.Errorf("layer pair candidate entropy: %w", err)
	}
	// Port zero selects from independent TCP and UDP dynamic ranges. A run
	// of UDP-selected ports can all be forbidden to TCP. Diversify three
	// candidates outside the default Windows dynamic range; only retained
	// successful binds prove availability. No host reservation is changed.
	start := uint32(seed[0])<<8 | uint32(seed[1])
	stride := (uint32(seed[2])<<8 | uint32(seed[3])) | 1
	for i := range result {
		// An odd stride in this power-of-two ring makes the three distinct.
		result[i] = uint16(16384 + ((start + uint32(i)*stride) & 32767))
	}
	return result, nil
}

func desktopWFPSSEntryAllocationError(err error) bool {
	return desktopWFPSSEntryAddressInUse(err) || runtime.GOOS == "windows" && errors.Is(err, syscall.Errno(10013))
}

func desktopWFPSSEntryPortPairCandidates(ip netip.Addr, candidates [3]uint16, listenUDP func(string, string) (net.PacketConn, error), listenTCP func(string, string) (net.Listener, error)) (net.Listener, net.PacketConn, error) {
	if !ip.Is4() || listenUDP == nil || listenTCP == nil {
		return nil, nil, errors.New("layer pair requires its captured IPv4 listener constructors")
	}
	if candidates != [3]uint16{} {
		seen := make(map[uint16]bool)
		for _, port := range candidates {
			if port < 16384 || port >= 49152 || seen[port] {
				return nil, nil, errors.New("layer pair changed its three distinct candidate ports")
			}
			seen[port] = true
		}
	}
	var last error
	for attempt := 0; attempt < 3; attempt++ {
		requested := netip.AddrPortFrom(ip, candidates[attempt])
		packet, err := listenUDP("udp4", requested.String())
		if err != nil {
			if packet != nil {
				if closeErr := packet.Close(); closeErr != nil {
					return nil, nil, errors.Join(err, closeErr)
				}
			}
			last = fmt.Errorf("UDP listener: %w", err)
			if desktopWFPSSEntryAllocationError(err) {
				continue
			}
			return nil, nil, last
		}
		var actual netip.AddrPort
		if packet != nil && packet.LocalAddr() != nil {
			actual, err = netip.ParseAddrPort(packet.LocalAddr().String())
		}
		if packet == nil || err != nil || actual.Addr() != ip || actual.Port() == 0 || requested.Port() != 0 && actual.Port() != requested.Port() {
			var closeErr error
			if packet != nil {
				closeErr = packet.Close()
			}
			return nil, nil, errors.Join(errors.New("layer UDP listener replaced its captured candidate endpoint"), err, closeErr)
		}
		// Keep the original UDP owner throughout the matching TCP bind.
		listener, err := listenTCP("tcp4", actual.String())
		if err == nil && listener != nil && listener.Addr() != nil && listener.Addr().String() == actual.String() {
			return listener, packet, nil
		}
		if err == nil {
			err = errors.New("paired TCP listener replaced its retained UDP endpoint")
		}
		var closeErr error
		if listener != nil {
			closeErr = listener.Close()
		}
		closeErr = errors.Join(closeErr, packet.Close())
		if closeErr != nil {
			return nil, nil, errors.Join(err, closeErr)
		}
		last = fmt.Errorf("paired TCP listener: %w", err)
		if !desktopWFPSSEntryAllocationError(err) {
			return nil, nil, last
		}
	}
	return nil, nil, fmt.Errorf("layer pair exhausted three retained candidates: %w", last)
}

func desktopExternalWFPStartSSEntryPeer(t *testing.T, p *desktopExternalIntegrationPeer, observed *desktopExternalWFPDatagrams, r desktopExternalWFPRequest) *desktopWFPSSEntryForward {
	t.Helper()
	selected := r.SSEntry
	if selected != nil {
		for _, mode := range []string{selected.EntryLayer, selected.FinalLayer} {
			if mode != "" && mode != "aes-256-gcm" && mode != "aes-256-gcm+xor-whitening" {
				t.Fatal("uncaptured SS layer mode")
			}
		}
		if selected.Final != "shadowsocks" && selected.Final != "hysteria2" && (selected.EntryLayer != "" || selected.FinalLayer != "") {
			t.Fatal("layered Windows SS graph requires SS or HY2 final")
		}
	}
	if selected == nil || (selected.Final != "shadowsocks" && selected.Final != "http-connect" && selected.Final != "https-connect" && selected.Final != "hysteria2") {
		t.Fatal("unowned SS final")
	}
	for _, item := range []struct{ role, mode string }{{"entry", selected.EntryLayer}, {"final", selected.FinalLayer}} {
		if strings.HasPrefix(r.Fault, item.role+"-layer-") && item.mode == "" || r.Fault == item.role+"-whitening" && item.mode != "aes-256-gcm+xor-whitening" {
			t.Fatal("SS layer negative lacks original wrapper")
		}
	}
	switch selected.Method {
	case "2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305":
	default:
		t.Fatal("unowned SS entry cipher")
	}
	p.protocol = selected.Final
	listener, entryUDP, e := desktopWFPSSEntryPortPair(netip.MustParseAddr(r.Address), net.Listen)
	if e != nil {
		t.Fatal("SS entry retained TCP/UDP pair", e)
	}
	if e = observed.Close(); e != nil {
		listener.Close()
		entryUDP.Close()
		t.Fatal("unused original UDP owner did not close", e)
	}
	observed = &desktopExternalWFPDatagrams{PacketConn: entryUDP, observed: map[string]int{}}
	p.packet, p.listener = observed, listener
	finalTCP, finalUDP, e := desktopWFPSSEntryPortPair(netip.MustParseAddr("127.0.0.1"), net.Listen)
	if e != nil {
		t.Fatal("SS final retained TCP/UDP pair", e)
	}
	p.closeProtocol = func() { _ = finalTCP.Close(); _ = finalUDP.Close() }
	entryProof := &desktopExternalIntegrationPeer{ctx: p.ctx, certificate: p.certificate, badIP: r.Fault != "entry-exit"}
	forward := &desktopWFPSSEntryForward{entryProof: entryProof, desktopExternalIntegrationPeer: p, target: finalTCP.Addr().String(), final: selected.Final}
	entryPassword := desktopWFPSSEntryPassword(selected.Method, 31)
	if r.Fault == "entry-key" {
		entryPassword = desktopWFPSSEntryPassword(selected.Method, 32)
	}
	entry, e := shadowaead_2022.NewServiceWithPassword(selected.Method, entryPassword, 60, forward, nil)
	if e != nil {
		t.Fatal(e)
	}
	finalPassword := desktopWFPSSEntryPassword(selected.Method, 41)
	if r.Fault == "final-key" {
		finalPassword = desktopWFPSSEntryPassword(selected.Method, 42)
		p.badAuth = true
	}
	var final shadowsocks.Service
	if selected.Final == "shadowsocks" {
		final, e = shadowaead_2022.NewServiceWithPassword(selected.Method, finalPassword, 60, &desktopWFPSSEntryFinalHandler{p}, nil)
		if e != nil {
			t.Fatal(e)
		}
	}
	accept := func(l net.Listener, ss shadowsocks.Service, outer bool, wrapper *desktopWFPSSEntryForward) {
		p.workers.Add(1)
		go func() {
			defer p.workers.Done()
			for {
				c, e := l.Accept()
				if e != nil {
					return
				}
				p.mu.Lock()
				if p.closing {
					p.mu.Unlock()
					_ = c.Close()
					return
				}
				p.connections[c] = true
				p.workers.Add(1)
				p.mu.Unlock()
				go func() {
					defer p.workers.Done()
					defer func() { _ = c.Close(); p.mu.Lock(); delete(p.connections, c); p.mu.Unlock() }()
