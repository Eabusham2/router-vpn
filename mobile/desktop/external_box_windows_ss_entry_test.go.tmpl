						transport := c
						if wrapper != nil {
							wrapper.rawTCP.Add(1)
							if wrapper.wireKey != nil {
								transport = &desktopWFPSSEntryWhiteningStream{Conn: c, key: *wrapper.wireKey}
							}
						}
						err := ss.NewConnection(p.ctx, transport, M.Metadata{Source: M.SocksaddrFromNet(c.RemoteAddr())})
						if wrapper != nil && desktopWFPSSEntryAuthError(err) {
							wrapper.rejected.Add(1)
						}
						if desktopWFPSSEntryAuthError(err) {
							p.authFailures.Add(1)
						}
						p.recordFailure(err)
					} else {
						p.recordFailure(p.connect(c))
					}
				}()
			}
		}()
	}
	packets := func(pc net.PacketConn, ss shadowsocks.Service, wrapper *desktopWFPSSEntryForward) {
		if wrapper != nil && wrapper.wireKey != nil {
			pc = &desktopExternalLayerWhiteningPacket{PacketConn: pc, key: *wrapper.wireKey}
		}
		p.workers.Add(1)
		go func() {
			defer p.workers.Done()
			reader := B.NewPacketConn(pc)
			for {
				body := buf.NewPacket()
				from, e := reader.ReadPacket(body)
				if e != nil {
					body.Release()
					return
				}
				if wrapper != nil {
					wrapper.rawUDP.Add(1)
				}
				if e = ss.NewPacket(p.ctx, reader, body, M.Metadata{Source: from}); e != nil {
					if wrapper != nil && desktopWFPSSEntryAuthError(e) {
						wrapper.rejected.Add(1)
					}
					body.Release()
					if desktopWFPSSEntryAuthError(e) {
						p.authFailures.Add(1)
					}
					p.recordFailure(e)
				}
			}
		}()
	}
	if selected.Final == "hysteria2" {
		logger := log.NewNOPFactory().NewLogger("ss-entry-hysteria-final")
		tlsConfig, err := boxTLS.NewServer(p.ctx, logger, option.InboundTLSOptions{Enabled: true, Certificate: []string{string(r.ProxyCertificate)}, Key: []string{string(r.ProxyKey)}})
		if err != nil {
			t.Fatal(err)
		}
		server, err := HYQUIC.NewService[int](HYQUIC.ServiceOptions{Context: p.ctx, Logger: logger, TLSConfig: tlsConfig, UDPTimeout: 10 * time.Second, Handler: p,
			MasqueradeHandler: http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
				// The pinned service calls this only after rejecting the QUIC auth
				// request. Count the actual authenticated transport rejection.
				if req.Method == http.MethodPost && req.Host == "hysteria" && req.URL.Path == "/auth" {
					p.authFailures.Add(1)
				}
				http.NotFound(w, req)
			}),
		})
