		var udp net.PacketConn
		var tcp net.Listener
		var err error
		if role == "final" && selected.Final == "hysteria2" {
			udp, err = net.ListenPacket("udp4", net.JoinHostPort(host, port))
		} else if port == "0" {
			tcp, udp, err = desktopWFPSSEntryPortPair(netip.MustParseAddr(host), net.Listen)
		} else {
			// Fixed XOR entry port is a captured contract. Never select another port.
			udp, err = net.ListenPacket("udp4", net.JoinHostPort(host, port))
			if err == nil {
				tcp, err = net.Listen("tcp4", udp.LocalAddr().String())
				if err != nil {
					closeErr := udp.Close()
					err = errors.Join(err, closeErr)
				}
			}
		}
		if err != nil {
			t.Fatal("owned SS layer retained TCP/UDP pair", err)
		}
		w := &desktopWFPSSEntryForward{desktopExternalIntegrationPeer: p, logical: logical, target: target, final: "shadowsocks", mode: mode}
		w.udpOnly = tcp == nil
		if w.udpOnly {
			w.final = "hysteria2"
		}
		if r.Fault == role+"-layer-inner" {
			w.logical = "10.95.0.1:1"
		}
		if mode == "aes-256-gcm+xor-whitening" {
			key := sha256.Sum256([]byte("router-vpn-xor-whitening-v1\x00" + password))
			if r.Fault == role+"-whitening" {
				key[0] ^= 255
			}
			w.wireKey = &key
		}
		if r.Fault == role+"-layer-key" {
			password = desktopWFPSSEntryPassword("2022-blake3-aes-256-gcm", 99)
		}
		service, err := shadowaead_2022.NewServiceWithPassword("2022-blake3-aes-256-gcm", password, 60, w, nil)
		if err != nil {
			if tcp != nil {
				tcp.Close()
			}
			udp.Close()
			t.Fatal(err)
		}
		observedLayer := &desktopExternalWFPDatagrams{PacketConn: udp, observed: map[string]int{}}
		w.outer = observedLayer
		closeOriginal := p.closeProtocol
		p.closeProtocol = func() {
			if tcp != nil {
				tcp.Close()
			}
			udp.Close()
			closeOriginal()
		}
		if tcp != nil {
			accept(tcp, service, role == "entry", w)
		}
		packets(observedLayer, service, w)
		return w
	}
	if selected.FinalLayer != "" {
		forward.finalLayer = layer(selected.FinalLayer, desktopWFPSSEntryPassword("2022-blake3-aes-256-gcm", 61), "10.93.0.1:8388", finalTCP.Addr().String(), "127.0.0.1", "0", "final")
		forward.target = forward.finalLayer.outer.LocalAddr().String()
		if selected.FinalLayer == "aes-256-gcm+xor-whitening" {
			forward.logical = "198.51.100.240:8389"
		}
	}
	if selected.EntryLayer != "" {
		_, innerPort, err := net.SplitHostPort(listener.Addr().String())
		if err != nil {
			t.Fatal(err)
		}
		port := "0"
		if selected.EntryLayer == "aes-256-gcm+xor-whitening" {
			port = "8389"
		}
		forward.entryLayer = layer(selected.EntryLayer, desktopWFPSSEntryPassword("2022-blake3-aes-256-gcm", 51), net.JoinHostPort("10.94.0.1", innerPort), listener.Addr().String(), r.Address, port, "entry")
		forward.outer = forward.entryLayer.outer
		closeOriginal := p.closeProtocol
		p.closeProtocol = func() { observed.Close(); closeOriginal() }
		p.packet = forward.outer
	}
	accept(listener, entry, selected.EntryLayer == "", nil)
	packets(observed, entry, nil)
	return forward
}

