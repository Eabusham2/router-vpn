const desktopExternalLatencyAddress = "93.184.216.34:443"

// This peer runs behind the real encrypted/proxy native outbound and captured
// physical broker. The TLS trust root is installed only in the existing
// isolated test child; production endpoint and verifier code are unchanged.
type desktopExternalLatencyPeer struct {
	certificate                   tls.Certificate
	fault                         string
	queries, requests, handshakes atomic.Int32
	entered, release              chan struct{}
	once                          sync.Once
}

func newDesktopExternalLatencyPeer(t *testing.T, ca *desktopExternalIntegrationCA, fault string) *desktopExternalLatencyPeer {
	p := &desktopExternalLatencyPeer{certificate: ca.certificate(t, fault != "latency-tls"), fault: fault}
	if fault == "latency-held" {
		p.entered, p.release = make(chan struct{}), make(chan struct{})
	}
	return p
}

func (p *desktopExternalLatencyPeer) answer(q, answer *mDNS.Msg) {
	p.queries.Add(1)
	answer.Answer = nil
	if p.fault == "latency-dns" {
		answer.Rcode = mDNS.RcodeServerFailure
		return
	}
	if q.Question[0].Qtype == mDNS.TypeA {
		answer.Answer = []mDNS.RR{&mDNS.A{Hdr: mDNS.RR_Header{Name: q.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60}, A: net.ParseIP("93.184.216.34")}}
	}
}

func (p *desktopExternalLatencyPeer) serve(owner *desktopExternalIntegrationPeer, connection net.Conn) error {
	secure := tls.Server(connection, &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{p.certificate}, NextProtos: []string{"http/1.1"}})
	if err := secure.HandshakeContext(owner.ctx); err != nil {
		return err
	}
	p.handshakes.Add(1)
	request, err := http.ReadRequest(bufio.NewReader(secure))
	if err != nil {
		return err
	}
	defer request.Body.Close()
	nonce, err := hex.DecodeString(request.URL.Query().Get("routervpn"))
	if err != nil || len(nonce) != 16 || request.Method != http.MethodGet || request.Host != hopmeasure.PublicHost || request.URL.Path != "/__down" || request.URL.Query().Get("bytes") != "1" || len(request.URL.Query()) != 2 || !request.Close || request.Header.Get("Authorization") != "" || request.Header.Get("Proxy-Authorization") != "" || request.Header.Get("Accept-Encoding") != "identity" {
		return errors.New("native latency changed the fixed origin, exact payload or credential boundary")
	}
	p.requests.Add(1)
	if p.entered != nil {
		p.once.Do(func() { close(p.entered) })
		select {
		case <-p.release:
		case <-owner.ctx.Done():
			return owner.ctx.Err()
		}
	}
	if p.fault == "latency-partial" {
		_, err = fmt.Fprint(secure, "HTTP/1.1 206 Partial Content\r\nContent-Length: 1\r\nConnection: close\r\n\r\nx")
	} else {
		_, err = fmt.Fprint(secure, "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nConnection: close\r\n\r\nx")
	}
	return err
}

// The native worker owns RequestTimeout for all fifty samples. Completion
// publishes a result before its scope release finishes, so join the captured
// request through Drain rather than imposing a shorter polling deadline.
type desktopExternalLatencyObserver interface {
	StatusJSON() string
	Cancel(string)
	Drain(string) error
}

func desktopExternalLatencyObserve(service desktopExternalLatencyObserver, request string, deadline, tick <-chan time.Time) (hopmeasure.Status, error) {
	var status hopmeasure.Status
	var primary error
	if request == "" {
		return status, errors.New("native latency observer has no captured request")
	}
	read := func() error {
		var next hopmeasure.Status
		if err := json.Unmarshal([]byte(service.StatusJSON()), &next); err != nil {
			return err
		}
		if next.Request != request {
			return errors.New("native latency observation changed its original request")
		}
		status = next
		return nil
	}
observe:
	for {
		// An expired observation cannot adopt a concurrently published late result.
		select {
		case <-deadline:
			primary = context.DeadlineExceeded
			break observe
		default:
		}
		if primary = read(); primary != nil || status.Complete {
			break
		}
		select {
		case <-tick:
		case <-deadline:
			primary = context.DeadlineExceeded
			break observe
		}
	}
	if primary != nil {
		service.Cancel(request)
	}
	// Drain has its own unchanged five-second bound. A cancellation acknowledgement
	// or Complete bit alone never establishes retirement of the native operation.
	if err := service.Drain(request); err != nil {
		service.Cancel(request)
		return status, errors.Join(primary, err)
	}
	if primary != nil {
		return status, primary
	}
	if err := read(); err != nil {
		service.Cancel(request)
		return status, err
	}
	if !status.Complete || !status.Drained {
		service.Cancel(request)
		return status, errors.New("native latency worker did not actually drain")
	}
	return status, nil
}

func desktopExternalLatencyStatus(t *testing.T, service *hopmeasure.Service) hopmeasure.Status {
	t.Helper()
	var captured hopmeasure.Status
	if err := json.Unmarshal([]byte(service.StatusJSON()), &captured); err != nil || captured.Request == "" {
		t.Fatal("native latency lost its original request", err)
	}
	deadline := time.NewTimer(hopmeasure.RequestTimeout)
	defer deadline.Stop()
	tick := time.NewTicker(5 * time.Millisecond)
	defer tick.Stop()
	status, err := desktopExternalLatencyObserve(service, captured.Request, deadline.C, tick.C)
	if err != nil {
		t.Fatal("native latency observation or worker drain failed", status, err)
	}
	return status
}

type desktopExternalLatencyObservationFixture struct {
	read   func() string
	cancel func(string)
	drain  func(string) error
}

func (f desktopExternalLatencyObservationFixture) StatusJSON() string    { return f.read() }
func (f desktopExternalLatencyObservationFixture) Cancel(id string)      { f.cancel(id) }
func (f desktopExternalLatencyObservationFixture) Drain(id string) error { return f.drain(id) }

func TestRouterVPNDesktopExternalPhysicalBoxLatencyObservation(t *testing.T) {
	t.Run("worker-and-drain-bounds", func(t *testing.T) {
		if hopmeasure.RequestTimeout != 90*time.Second || hopmeasure.DrainTimeout != 5*time.Second {
			t.Fatal("observer changed the established worker or retirement contract")
		}
	})
	t.Run("blocked-drain-retains-observation", func(t *testing.T) {
		id := strings.Repeat("b", 32)
		status := hopmeasure.Status{Request: id, Complete: true}
		entered, release := make(chan struct{}), make(chan struct{})
		var once sync.Once
		unblock := func() { once.Do(func() { close(release) }) }
		defer unblock()
		fixture := desktopExternalLatencyObservationFixture{
			read:   func() string { raw, _ := json.Marshal(status); return string(raw) },
			cancel: func(string) { t.Error("completed worker was cancelled before its native join") },
			drain: func(request string) error {
				if request != id {
					t.Error("join adopted a foreign request")
				}
				close(entered)
				<-release
				status.Drained = true
				return nil
			},
		}
		finished := make(chan error, 1)
		go func() { _, err := desktopExternalLatencyObserve(fixture, id, nil, nil); finished <- err }()
		select {
		case <-entered:
		case <-time.After(time.Second):
			t.Fatal("observer never joined its completed worker")
		}
		select {
		case err := <-finished:
			t.Fatal("observer released a still-owned native worker", err)
		default:
		}
		unblock()
		select {
		case err := <-finished:
			if err != nil {
				t.Fatal(err)
			}
		case <-time.After(time.Second):
			t.Fatal("observer did not return after exact worker release")
		}
	})
	for _, fault := range []string{"progress-through-fifty", "complete-before-drain", "cancelled-before-drain", "deadline", "deadline-and-drain-failure", "late-result", "foreign-request", "malformed-status", "drain-failure", "unjoined", "replacement-after-drain"} {
		t.Run(fault, func(t *testing.T) {
			id := strings.Repeat("b", 32)
			status := hopmeasure.Status{Request: id, Stage: "exit: HTTPS response 34/50"}
			deadline := make(chan time.Time, 1)
			tick := make(chan time.Time, 50)
			for i := 0; i < 50; i++ {
				tick <- time.Time{}
			}
			reads, cancels, drains, samples := 0, 0, 0, 33
			failure := errors.New("original native drain failure")
			fixture := desktopExternalLatencyObservationFixture{
				read: func() string {
					reads++
					if fault == "malformed-status" {
						return "{"
					}
					if fault == "foreign-request" {
						status.Request = strings.Repeat("c", 32)
					}
					if fault == "progress-through-fifty" {
						if samples < 50 {
							samples++
						}
						status.Complete = samples == 50
					}
					raw, _ := json.Marshal(status)
					return string(raw)
				},
				cancel: func(request string) {
					cancels++
					if request != id {
						t.Error("cancel adopted replacement request")
					}
				},
				drain: func(request string) error {
					drains++
					if request != id {
						t.Error("drain adopted replacement request")
					}
					if fault == "drain-failure" || fault == "deadline-and-drain-failure" {
						return failure
					}
					if fault != "unjoined" {
						status.Drained = true
					}
					if fault == "replacement-after-drain" {
						status.Request = strings.Repeat("c", 32)
					}
					return nil
				},
			}
			switch fault {
			case "complete-before-drain", "drain-failure", "unjoined", "replacement-after-drain":
				status.Complete = true
			case "cancelled-before-drain":
				status.Complete = true
				status.Stage = "cancelled"
				status.Failure = "Measurement cancelled"
			case "deadline", "deadline-and-drain-failure":
				deadline <- time.Time{}
			case "late-result":
				status.Complete = true
				status.Drained = true
				deadline <- time.Time{}
			}
			got, err := desktopExternalLatencyObserve(fixture, id, deadline, tick)
			success := fault == "progress-through-fifty" || fault == "complete-before-drain" || fault == "cancelled-before-drain"
			if drains != 1 || (err == nil) != success || success && (!got.Complete || !got.Drained || cancels != 0) || !success && cancels == 0 {
				t.Fatal("observer lost exact completion, cancellation or single bounded join", got, err, cancels, drains)
			}
			if fault == "progress-through-fifty" && (samples != 50 || reads < 18) {
				t.Fatal("observer accepted the previous partial34/50 stage")
			}
			if fault == "cancelled-before-drain" && (got.Stage != "cancelled" || got.Failure == "") {
				t.Fatal("observer relabeled cancellation as successful measurement")
			}
			if fault == "deadline" || fault == "deadline-and-drain-failure" || fault == "late-result" {
				if !errors.Is(err, context.DeadlineExceeded) || reads != 0 {
					t.Fatal("deadline was replaced by late status or cleanup", err, reads)
				}
			}
			if fault == "drain-failure" || fault == "deadline-and-drain-failure" {
				if !errors.Is(err, failure) {
					t.Fatal("observer discarded original native retirement failure", err)
				}
			}
		})
	}
}

func desktopExternalLatencyIntegration(t *testing.T, ca *desktopExternalIntegrationCA) {
	for _, fault := range []string{"latency-ok", "latency-dns", "latency-tls", "latency-partial"} {
		t.Run("latency3/"+fault, func(t *testing.T) {
			f := newDesktopExternalIntegrationFixture(t, ca, "shadowsocks", fault)
			f.prove(t)
			service, err := f.box.RouterVPNExternalHopMeasurement(f.proof, f.originalSource, f.originalCapture, f.policy.Metadata().SessionID, f.proof.Healthy)
			if err != nil {
				t.Fatal(err)
			}
			defer service.Close()
			if err := service.StartResponse(strings.Repeat("f", 32), "selected-external-native"); err != nil {
				t.Fatal(err)
			}
			status := desktopExternalLatencyStatus(t, service)
			if len(status.Results) != 1 || !status.Complete || !status.Drained {
				t.Fatal("live response worker lost actual drain", status)
			}
			row := status.Results[0]
			if row.Benchmark != nil || row.Idle != nil || row.Download != nil || row.Upload != nil {
				t.Fatal("live response became saved50 or transfer", row)
			}
			if fault == "latency-ok" {
				if !row.Ready || row.Response == nil || row.Response.Attempts != 3 || row.Response.Distribution == nil || row.Response.Distribution.Samples != 3 || row.Response.Distribution.Median <= 0 || f.peer.latency.requests.Load() != 3 || f.peer.latency.handshakes.Load() != 3 || f.peer.latency.queries.Load() < 1 || f.peer.bypassed.Load() != 0 {
					t.Fatal("three actual encrypted HTTPS responses missing", status, f.peer.diagnostic())
				}
			} else if row.Ready || row.Response != nil || row.Failure == "" || fault != "latency-partial" && f.peer.latency.requests.Load() != 0 || fault == "latency-partial" && f.peer.latency.requests.Load() != 1 {
				t.Fatal("failed native response acquired a score", status, f.peer.diagnostic())
			}
			release, err := f.proof.activity.beginMTU()
			if err != nil {
				t.Fatal("drained live response retained MTU activity", err)
			}
			release()
		})
	}
	protocols := []string{"http-connect", "https-connect", "shadowsocks"}
	if runtime.GOOS == "darwin" {
		protocols = append(protocols, "socks5", "awg2-fast", "awg2-strong")
	}
	if runtime.GOOS == "linux" || runtime.GOOS == "windows" {
		protocols = append(protocols, "hysteria2", "hysteria2-aes", "hysteria2-aes-xor", "socks5")
	}
	if runtime.GOOS == "linux" || runtime.GOOS == "windows" {
		protocols = append(protocols, "wireguard", "awg2-fast", "awg2-strong")
	}
	for _, protocol := range protocols {
		t.Run("latency50/"+protocol, func(t *testing.T) {
			f := newDesktopExternalIntegrationFixture(t, ca, protocol, "latency-ok")
			f.prove(t)
			service, err := f.box.RouterVPNExternalHopMeasurement(f.proof, f.originalSource, f.originalCapture, f.policy.Metadata().SessionID, f.proof.Healthy)
			if err != nil {
				t.Fatal("derived physical graph lost exact original proof authority", err)
			}
			defer service.Close()
			// DNS uses the same exact source translation; its construction must
			// not grant an imported graph or another native Box ownership.
			dns, err := f.box.RouterVPNExternalDNSMeasurement(f.proof, f.originalSource, f.originalCapture, f.policy.Metadata().SessionID, f.proof.Healthy)
			if err != nil {
				t.Fatal("captured physical DNS measurement factory", err)
			}
			defer dns.Close()
			if err := service.StartLatency(strings.Repeat("b", 32), "selected-external-native"); err != nil {
				t.Fatal(err)
			}
			status := desktopExternalLatencyStatus(t, service)
			if status.Stage != "complete" || len(status.Results) != 1 || !status.Results[0].Ready || status.Results[0].Benchmark == nil {
				t.Fatal("real native50 has no score", status, f.peer.diagnostic())
			}
			b := status.Results[0].Benchmark
			if b.Attempts != 50 || b.Failed != 0 || b.Distribution == nil || b.Distribution.Samples != 50 || b.TrimmedMean <= 0 || b.Measurement != "routed-https-response-after-tls" || b.Endpoint != "https://speed.cloudflare.com/__down?bytes=1" || f.peer.latency.requests.Load() != 50 || f.peer.latency.handshakes.Load() != 50 || f.peer.latency.queries.Load() < 1 || f.peer.bypassed.Load() != 0 {
				t.Fatal("native samples did not traverse selected DNS and exact encrypted physical owner", b, f.peer.latency.requests.Load(), f.peer.latency.handshakes.Load(), f.peer.latency.queries.Load())
			}
			release, err := f.proof.activity.beginMTU()
			if err != nil {
				t.Fatal("drained native50 retained MTU activity", err)
			}
			release()
			if err := service.StartLatency(strings.Repeat("b", 32), "selected-external-native"); err == nil {
				t.Fatal("native request replay was admitted")
			}
			for _, fault := range []string{"source", "capture", "session", "current"} {
				t.Run(fault, func(t *testing.T) {
					source, capture, session, current := f.originalSource, f.originalCapture, f.policy.Metadata().SessionID, f.proof.Healthy
					switch fault {
					case "source":
						source += " "
					case "capture":
						capture += " "
					case "session":
						session = strings.Repeat("c", 32)
					case "current":
						current = func() bool { return false }
					}
					if actual, err := f.box.RouterVPNExternalHopMeasurement(f.proof, source, capture, session, current); err == nil || actual != nil {
						t.Fatal("changed native measurement source was accepted", fault)
					}
				})
			}
		})
	}
	for _, fault := range []string{"latency-dns", "latency-tls", "latency-partial"} {
		t.Run("latency50/"+fault, func(t *testing.T) {
			f := newDesktopExternalIntegrationFixture(t, ca, "shadowsocks", fault)
			f.prove(t)
			service, err := f.box.RouterVPNExternalHopMeasurement(f.proof, f.originalSource, f.originalCapture, f.policy.Metadata().SessionID, f.proof.Healthy)
			if err != nil {
				t.Fatal(err)
			}
			defer service.Close()
			if err := service.StartLatency(strings.Repeat("d", 32), "selected-external-native"); err != nil {
				t.Fatal(err)
			}
			status := desktopExternalLatencyStatus(t, service)
			if len(status.Results) != 1 || status.Results[0].Ready || status.Results[0].Benchmark != nil || status.Results[0].Failure == "" {
				t.Fatal("failed native sample acquired a score", status)
			}
			if fault != "latency-partial" && f.peer.latency.requests.Load() != 0 || fault == "latency-partial" && f.peer.latency.requests.Load() != 1 {
				t.Fatal("negative did not reach the intended real transport boundary")
			}
		})
	}
	for _, reason := range []string{"cancel", "network", "native-owner"} {
		t.Run("latency50/"+reason, func(t *testing.T) {
			f := newDesktopExternalIntegrationFixture(t, ca, "shadowsocks", "latency-held")
			f.prove(t)
			service, err := f.box.RouterVPNExternalHopMeasurement(f.proof, f.originalSource, f.originalCapture, f.policy.Metadata().SessionID, f.proof.Healthy)
			if err != nil {
				t.Fatal(err)
			}
			defer service.Close()
			defer close(f.peer.latency.release)
			request := strings.Repeat("e", 32)
			if err := service.StartLatency(request, "selected-external-native"); err != nil {
				t.Fatal(err)
			}
			select {
			case <-f.peer.latency.entered:
			case <-time.After(3 * time.Second):
				t.Fatal("real HTTPS response never entered retained peer")
			}
			if release, err := f.proof.activity.beginMTU(); err == nil {
				release()
				t.Fatal("MTU mutation crossed the actual native50 worker")
			}
			switch reason {
			case "cancel":
				service.Cancel(request)
			case "network":
				f.network.InterfaceUpdated(context.Background())
			case "native-owner":
				f.proof.Cancel()
			}
			if reason != "cancel" {
				service.Invalidate()
			}
			status := desktopExternalLatencyStatus(t, service)
			if len(status.Results) != 0 || !status.Complete || !status.Drained {
				t.Fatal("retired native path published or failed to drain", status)
			}
			if f.peer.latency.requests.Load() != 1 {
				t.Fatal("cancelled native worker continued opening requests")
			}
		})
	}
}
