package main

import (
	"context"
	"errors"
	"os"
	"os/signal"
	"runtime"
	"syscall"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
	"github.com/spf13/cobra"
)

func routerVPNNodeChainTransfer(record *mobiletor.DesktopProtectionTransferRecord) (string, error) {
	if record == nil {
		return "", routerVPNExternalFailure
	}
	return mobiletor.DesktopProtectionTransferRecordSHA256(*record)
}

func init() { mainCommand.AddCommand(routerVPNNewNodeChainCommand()) }

func routerVPNNewNodeChainCommand() *cobra.Command {
	return routerVPNNewNodeChainCommandWithRun(routerVPNRunNodeChainWithControl)
}

type routerVPNNodeChainCommandRun func(context.Context, string, string, string, string, string, int,
	routerVPNNodeJournalOptions, routerVPNNodeLinuxParentOptions, string) error

func routerVPNNewNodeChainCommandWithRun(run routerVPNNodeChainCommandRun) *cobra.Command {
	var directory, session, config, source, transfer, darwin string
	var mtu int
	var journal routerVPNNodeJournalOptions
	var linuxParent routerVPNNodeLinuxParentOptions
	command := &cobra.Command{Use: "routervpn-node-chain", Short: "Run one complete captured ordered Router path", Args: cobra.NoArgs, SilenceUsage: true,
		RunE: func(command *cobra.Command, _ []string) error {
			if run == nil {
				return routerVPNExternalFailure
			}
			if command.Flags().Changed("darwin-control") && darwin != "inherited-v1" {
				return routerVPNExternalFailure
			}
			if darwin != "" {
				for _, name := range []string{"physical-transfer-sha256", "physical-mtu", "journal-parent-handle", "journal-parent-image", "journal-pipe", "journal-capture-sha256", "linux-parent-channel", "linux-parent-directory", "linux-parent-capture"} {
					if command.Flags().Changed(name) {
						return routerVPNExternalFailure
					}
				}
			}
			ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
			defer cancel()
			return run(ctx, directory, session, config, source, transfer, mtu, journal, linuxParent, darwin)
		}}
	command.Flags().StringVar(&directory, "runtime-dir", "", "absolute private runtime directory")
	command.Flags().StringVar(&session, "session", "", "captured runtime identity")
	command.Flags().StringVar(&config, "config-sha256", "", "captured complete configuration digest")
	command.Flags().StringVar(&source, "physical-source-sha256", "", "captured ordered physical owner identity")
	command.Flags().StringVar(&transfer, "physical-transfer-sha256", "", "captured private protection predecessor record")
	command.Flags().IntVar(&mtu, "physical-mtu", 0, "captured live TUN value for sealed restoration")
	command.Flags().StringVar(&darwin, "darwin-control", "", "original inherited Darwin controller")
	command.Flags().Uint64Var(&journal.ParentHandle, "journal-parent-handle", 0, "inherited native controller capability")
	command.Flags().StringVar(&journal.ParentImage, "journal-parent-image", "", "retained native controller image")
	command.Flags().StringVar(&journal.Pipe, "journal-pipe", "", "native durable transaction rendezvous")
	command.Flags().StringVar(&journal.CaptureSHA256, "journal-capture-sha256", "", "captured journal comparison digest")
	command.Flags().IntVar(&linuxParent.ChannelFD, "linux-parent-channel", 0, "inherited original Linux parent channel")
	command.Flags().IntVar(&linuxParent.DirectoryFD, "linux-parent-directory", 0, "inherited original Linux parent task directory")
	command.Flags().StringVar(&linuxParent.CaptureSHA256, "linux-parent-capture", "", "captured Linux command identity")
	return command
}

// The typed inherited Darwin family has no Windows/Linux predecessor or MTU
// override. Its original manifest supplies the complete restoration policy.
func routerVPNRunNodeChainWithControl(parent context.Context, directory, session, config, source, transfer string,
	mtu int, windows routerVPNNodeJournalOptions, linux routerVPNNodeLinuxParentOptions, darwin string) error {
	if darwin != "" {
		if darwin != "inherited-v1" || runtime.GOOS != "darwin" || transfer != "" || mtu != 0 ||
			windows != (routerVPNNodeJournalOptions{}) || linux != (routerVPNNodeLinuxParentOptions{}) {
			return routerVPNExternalFailure
		}
		return routerVPNRunDarwinNodeChainControlled(parent, directory, session, source, config)
	}
	return routerVPNRunNodeChainWithParents(parent, directory, session, config, source, transfer, mtu, windows, linux)
}

// Dispatch does not open private input until the original platform parent has
// authenticated. Missing or mixed parents never fall back to a node or pair.
func routerVPNRunNodeChainWithParents(parent context.Context, directory, session, config, source, transfer string,
	mtu int, windows routerVPNNodeJournalOptions, linux routerVPNNodeLinuxParentOptions) (failure error) {
	if parent == nil || !routerVPNExternalSource.MatchString(source) {
		return routerVPNExternalFailure
	}
	if linux != (routerVPNNodeLinuxParentOptions{}) {
		if windows != (routerVPNNodeJournalOptions{}) {
			return routerVPNExternalFailure
		}
		return routerVPNRunLinuxNodeChainControlled(parent, directory, session, config, source, transfer, mtu, linux)
	}
	if runtime.GOOS != "windows" {
		return routerVPNExternalFailure
	}
	journal, err := routerVPNNewNodeJournal(parent, source, windows)
	if err != nil || journal == nil {
		return routerVPNExternalFailure
	}
	defer func() { failure = errors.Join(failure, journal.close()) }()
	return routerVPNRunNodeMTUAllFamiliesCaptured(parent, directory, session, config, "", "", source, transfer, mtu, journal)
}

// The staged input already contains the sealed desktop physical projection.
// Replay it once, compare every public capture and the exact graph bytes, then
// retain that concrete policy. No metadata adapter or second projection exists.
func routerVPNNodeChainCommandPhysicalTarget(files *routerVPNExternalFiles, session, config, source string,
	mtu int, target string) (*mobilemultihop.DesktopNodeChainPolicy, error) {
	if target != "linux" && target != "windows" {
		return nil, routerVPNExternalFailure
	}
	policy, err := routerVPNNodeChainCommandPhysicalCapture(files, session, config, source, target)
	if err != nil || policy == nil || policy.Metadata().RestoredMTU != mtu {
		return nil, routerVPNExternalFailure
	}
	return policy, nil
}

// Only an authenticated platform control may call this manifest replay. Darwin
// derives RestoredMTU from this validated original policy, without a new flag.
func routerVPNNodeChainCommandPhysicalCapture(files *routerVPNExternalFiles, session, config, source, target string) (*mobilemultihop.DesktopNodeChainPolicy, error) {
	if files == nil || files.root == nil || !routerVPNExternalSession.MatchString(session) ||
		!routerVPNExternalSource.MatchString(source) || !routerVPNExternalSource.MatchString(config) ||
		(target != "linux" && target != "windows" && target != "darwin") {
		return nil, routerVPNExternalFailure
	}
	raw, err := files.read("node-chain-source.json", mobilemultihop.NodeChainInputLimit)
	if err != nil {
		return nil, routerVPNExternalFailure
	}
	policy, err := mobilemultihop.ParseDesktopNodeChainLaunchInput(string(raw))
	clear(raw)
	if err != nil || policy == nil {
		return nil, routerVPNExternalFailure
	}
	staged, err := files.read("sing-box.json", 4<<20)
	defer clear(staged)
	if err != nil {
		return nil, routerVPNExternalFailure
	}
	// This newly parsed policy is private until admission returns. Validate
	// its complete derivation once, after both owned file reads, and compare
	// the graph and metadata from that same snapshot. Separate accessors each
	// replay the entire graph and cannot add a newer external owner here.
	actual, meta, _, err := policy.ReadValidated()
	if err != nil || meta.SessionID != session || meta.TargetOS != target || meta.SourceSHA256 != source ||
		meta.ConfigSHA256 != config || string(staged) != actual {
		return nil, routerVPNExternalFailure
	}
	return policy, nil
}
