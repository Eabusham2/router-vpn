type desktopMTUTUNFixture struct {
	adapter.Inbound
	index, mtu int
	name, tag  string
	guard      func() bool
}

func (*desktopMTUTUNFixture) Type() string { return "tun" }
func (t *desktopMTUTUNFixture) Tag() string {
	if t.tag != "" {
		return t.tag
	}
	return "tun-in"
}
func (t *desktopMTUTUNFixture) RouterVPNDesktopMTU(guard func() bool) (string, int, int, error) {
	if t.guard != nil || !guard() {
		return "", 0, 0, errors.New("unowned")
	}
	t.guard = guard
	return t.RouterVPNDesktopMTUInterface()
}
func (t *desktopMTUTUNFixture) RouterVPNDesktopMTUInterface() (string, int, int, error) {
	if t.guard == nil || !t.guard() {
		return "", 0, 0, errors.New("retired")
	}
	name := t.name
	if name == "" {
		name = "router-vpn"
	}
	return name, t.index, t.mtu, nil
}

type desktopMTULeaseFixture struct {
	mu        sync.Mutex
	current   *desktopMTUTUNFixture
	config    string
	closed    atomic.Bool
	proofs    atomic.Int32
	changes   []int
	blocked   chan struct{}
	blockAt   int32
	blockOnce sync.Once
}

func (l *desktopMTULeaseFixture) Healthy() bool  { return !l.closed.Load() }
func (l *desktopMTULeaseFixture) Close()         { l.closed.Store(true) }
func (l *desktopMTULeaseFixture) Config() string { return l.config }
func (*desktopMTULeaseFixture) Authority() string {
	return `{"schema":1,"id":"selected-exit","source_sha256":"` + strings.Repeat("a", 64) + `","expected_public_ip":"203.0.113.88","mtu_policy":"auto","jumbo_tun":false}`
}
func (l *desktopMTULeaseFixture) Inbound() (adapter.Inbound, error) {
	l.mu.Lock()
	defer l.mu.Unlock()
	if l.closed.Load() {
		return nil, errors.New("closed")
	}
	return l.current, nil
}
func (l *desktopMTULeaseFixture) ChangeMTU(ctx context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
	l.mu.Lock()
	defer l.mu.Unlock()
	if expected != l.current || ctx.Err() != nil || l.closed.Load() {
		return l.current, errors.New("stale")
	}
	l.current = &desktopMTUTUNFixture{index: l.current.index + 1, mtu: mtu, name: l.current.name, tag: l.current.tag, guard: l.current.guard}
	l.changes = append(l.changes, mtu)
	return l.current, nil
}
func (l *desktopMTULeaseFixture) Lifetime(ctx context.Context) (context.Context, context.CancelFunc, error) {
	if !l.Healthy() {
		return nil, nil, errors.New("closed")
	}
	c, cancel := context.WithCancel(ctx)
	return c, cancel, nil
}
func (l *desktopMTULeaseFixture) Verify(ctx context.Context, _ func(context.Context, string, string) (net.Conn, error)) error {
	if l.proofs.Add(1) == l.blockAt && l.blocked != nil {
		l.blockOnce.Do(func() { close(l.blocked) })
		<-ctx.Done()
		return ctx.Err()
	}
	return nil
}
func (*desktopMTULeaseFixture) Resolve(context.Context, string) ([]netip.Addr, error) {
	return nil, errors.New("fixture has no ambient DNS")
}

func desktopMTUNativeFixture(t *testing.T) (*routerVPNDesktopMTU, *desktopMTULeaseFixture, *atomic.Value) {
	return desktopMTUNativeFixtureAt(t, 1280)
}
func desktopMTUNativeFixtureAt(t *testing.T, mtu int) (*routerVPNDesktopMTU, *desktopMTULeaseFixture, *atomic.Value) {
	t.Helper()
	physical := &atomic.Value{}
	physical.Store(strings.Repeat("c", 64))
	config := strings.Replace(desktopExternalSource, `"mtu":1280`, fmt.Sprintf(`"mtu":%d`, mtu), 1)
	lease := &desktopMTULeaseFixture{current: &desktopMTUTUNFixture{index: 17, mtu: mtu}, config: config, blockAt: 2}
	owner, err := newRouterVPNDesktopMTUOwner(lease, desktopExternalSession, func() string { return physical.Load().(string) })
	if err != nil {
		t.Fatal(err)
	}
	cache := &routerVPNDesktopMTUCache{}
	controller, err := mobilemtu.NewExternal(owner, lease.Config(), lease.Authority(), cache)
	if err != nil {
		t.Fatal(err)
	}
	m := &routerVPNDesktopMTU{owner: owner, controller: controller, cache: cache}
	t.Cleanup(func() { lease.closed.Store(true); _ = m.close() })
	return m, lease, physical
}
func desktopMTUAwait(t *testing.T, m *routerVPNDesktopMTU, condition func(routerVPNDesktopMTURecord) bool) routerVPNDesktopMTURecord {
	t.Helper()
	deadline := time.NewTimer(3 * time.Second)
	defer deadline.Stop()
	ticker := time.NewTicker(time.Millisecond)
	defer ticker.Stop()
	for {
		result := m.record()
		if condition(result) {
			return result
		}
		select {
		case <-deadline.C:
			t.Fatal("native MTU did not drain", result)
		case <-ticker.C:
		}
	}
}

func TestRouterVPNDesktopMTUAppliedCancellationRestoresExactReader(t *testing.T) {
	m, lease, _ := desktopMTUNativeFixtureAt(t, 1400)
	lease.blocked, lease.blockAt = make(chan struct{}), 3
	request := routerVPNDesktopMTURequest{Generation: 1, Request: strings.Repeat("d", 32), Force: true}
	if err := m.start(request); err != nil {
		t.Fatal(err)
	}
	select {
	case <-lease.blocked:
	case <-time.After(3 * time.Second):
		t.Fatal("actual shared controller never applied a candidate")
	}
	if err := m.cancel(routerVPNDesktopMTUControl{Generation: 2, Request: request.Request}); err == nil {
		t.Fatal("foreign generation canceled worker")
	}
	if !m.controller.Running() {
		t.Fatal("foreign cancellation retired the active worker")
	}
	if err := m.cancel(routerVPNDesktopMTUControl{Generation: 1, Request: request.Request}); err != nil {
		t.Fatal(err)
	}
	result := desktopMTUAwait(t, m, func(r routerVPNDesktopMTURecord) bool { return r.Status.Complete })
	if !result.Status.Restored || result.Status.Measured || result.Status.EffectiveMTU != 1400 || result.Status.Source != "restored-unmeasured" {
		t.Fatal(result)
	}
	lease.mu.Lock()
	defer lease.mu.Unlock()
	if len(lease.changes) < 3 || lease.changes[1] == 1400 || lease.changes[len(lease.changes)-1] != 1400 || lease.current.mtu != 1400 {
		t.Fatal("captured original readback was not restored", lease.changes)
	}
}
func TestRouterVPNDesktopMTUChangedPhysicalPathCannotRollbackReplacement(t *testing.T) {
	m, lease, physical := desktopMTUNativeFixture(t)
	lease.blocked = make(chan struct{})
	request := routerVPNDesktopMTURequest{Generation: 1, Request: strings.Repeat("e", 32), Force: true}
	if err := m.start(request); err != nil {
		t.Fatal(err)
	}
	select {
	case <-lease.blocked:
	case <-time.After(3 * time.Second):
		t.Fatal("candidate not reached")
	}
	physical.Store(strings.Repeat("f", 64))
	_ = m.cancel(routerVPNDesktopMTUControl{Generation: 1, Request: request.Request})
	result := desktopMTUAwait(t, m, func(r routerVPNDesktopMTURecord) bool { return r.Status.Complete })
	if result.Status.Measured || result.Status.Restored {
		t.Fatal("changed path produced a current result", result)
	}
	lease.mu.Lock()
	defer lease.mu.Unlock()
	if len(lease.changes) != 1 {
		t.Fatal("stale rollback mutated a replacement path", lease.changes)
	}
}
func TestRouterVPNDesktopMTUOwnerRejectsWrongInboundAndTarget(t *testing.T) {
	m, lease, _ := desktopMTUNativeFixture(t)
	before, err := m.owner.Capture()
	if err != nil {
		t.Fatal(err)
	}
	for _, address := range []string{"127.0.0.1:443", "192.168.50.1:443", "example.com:443", "1.1.1.1:80"} {
		if _, err := m.owner.DialThroughTunnel(context.Background(), before, "tcp", address); err == nil {
			t.Fatal("unowned target accepted", address)
		}
	}
	if _, err := m.owner.DialThroughTunnel(context.Background(), before, "udp", "1.1.1.1:443"); err == nil {
		t.Fatal("unrequested transport accepted")
	}
	lease.mu.Lock()
	lease.current = &desktopMTUTUNFixture{index: 99, mtu: 1280, guard: m.owner.pathCurrent}
	lease.mu.Unlock()
	if _, err := m.owner.Capture(); err == nil {
		t.Fatal("replacement inbound adopted")
	}
	if _, err := m.owner.ChangeMTU(context.Background(), before, 1400); err == nil {
		t.Fatal("stale owner changed replacement")
	}
	if len(lease.changes) != 0 {
		t.Fatal("replacement was touched")
	}
}
func TestRouterVPNDesktopMTUCacheRequiresExactDurableCommit(t *testing.T) {
	for _, accept := range []bool{false, true} {
		t.Run(map[bool]string{false: "cancel", true: "commit"}[accept], func(t *testing.T) {
			cache := &routerVPNDesktopMTUCache{}
			valid := atomic.Bool{}
			valid.Store(true)
			done := make(chan error, 1)
			go func() { done <- cache.Save(strings.Repeat("c", 64), 1380, valid.Load) }()
			deadline := time.Now().Add(time.Second)
			for cache.prepare() == nil && time.Now().Before(deadline) {
				time.Sleep(time.Millisecond)
			}
			if cache.prepare() == nil {
				t.Fatal("winner was not held")
			}
			if err := cache.decide(strings.Repeat("d", 64), 1380, true); err == nil {
				t.Fatal("other path committed")
			}
			if err := cache.decide(strings.Repeat("c", 64), 1400, true); err == nil {
				t.Fatal("other MTU committed")
			}
			select {
			case <-done:
				t.Fatal("wrong commit released winner")
			default:
			}
			if accept {
				if err := cache.decide(strings.Repeat("c", 64), 1380, true); err != nil {
					t.Fatal(err)
				}
			} else {
				valid.Store(false)
			}
			select {
			case err := <-done:
				if (err == nil) != accept {
					t.Fatal("durable decision did not govern result", err)
				}
			case <-time.After(time.Second):
				t.Fatal("commit/cancel not drained")
			}
			value, ok := cache.Lookup(strings.Repeat("c", 64))
			if ok != accept || ok && value != 1380 {
				t.Fatal("failed value persisted", value, ok)
			}
		})
	}
}
func TestRouterVPNDesktopMTUMailboxRejectsForeignAndReplayedRequests(t *testing.T) {
	m, lease, _ := desktopMTUNativeFixture(t)
	lease.blocked = make(chan struct{})
	directory := t.TempDir()
	if err := os.Chmod(directory, 0700); err != nil {
		t.Fatal(err)
	}
	files, err := routerVPNOpenExternalFiles(directory)
	if err != nil {
		t.Fatal(err)
	}
	defer files.root.Close()
	mailbox := &routerVPNDesktopMTUFiles{files: files, owner: m, session: desktopExternalSession, source: strings.Repeat("a", 64), config: strings.Repeat("b", 64), inputs: map[string]routerVPNDesktopMTUInput{}}
	request := routerVPNDesktopMTURequest{Schema: 1, Session: desktopExternalSession, SourceSHA256: mailbox.source, ConfigSHA256: mailbox.config, Generation: 1, Request: strings.Repeat("d", 32), Force: true}
	path := filepath.Join(directory, "mtu-request.json")
	for _, mutate := range []func(*routerVPNDesktopMTURequest){func(q *routerVPNDesktopMTURequest) { q.Session = strings.Repeat("f", 32) }, func(q *routerVPNDesktopMTURequest) { q.SourceSHA256 = strings.Repeat("f", 64) }, func(q *routerVPNDesktopMTURequest) { q.Generation = 2 }} {
		bad := request
		mutate(&bad)
		raw, _ := json.Marshal(bad)
		if err := os.WriteFile(path, raw, 0600); err != nil {
			t.Fatal(err)
		}
		if err := mailbox.tick(); err != nil {
			t.Fatal(err)
		}
		if m.controller.Running() || len(mailbox.inputs) != 0 {
			t.Fatal("foreign input acquired ownership")
		}
	}
	raw, _ := json.Marshal(request)
	if err := os.WriteFile(path, raw, 0600); err != nil {
		t.Fatal(err)
	}
	if err := mailbox.tick(); err != nil {
		t.Fatal(err)
	}
	select {
	case <-lease.blocked:
	case <-time.After(time.Second):
		t.Fatal("valid request not dispatched")
	}
	if err := m.start(request); err == nil {
		t.Fatal("same generation replayed")
	}
	control := routerVPNDesktopMTUControl{Schema: 1, Session: desktopExternalSession, SourceSHA256: mailbox.source, ConfigSHA256: mailbox.config, Generation: 1, Request: request.Request}
	raw, _ = json.Marshal(control)
	if err := os.WriteFile(filepath.Join(directory, "mtu-cancel.json"), raw, 0600); err != nil {
		t.Fatal(err)
	}
	if err := mailbox.tick(); err != nil {
		t.Fatal(err)
	}
	_ = desktopMTUAwait(t, m, func(r routerVPNDesktopMTURecord) bool { return r.Status.Complete })
	if err := mailbox.tick(); err != nil {
		t.Fatal(err)
	}
	for _, name := range []string{"mtu-request.json", "mtu-cancel.json"} {
		if _, err := os.Stat(filepath.Join(directory, name)); !errors.Is(err, os.ErrNotExist) {
			t.Fatal("owned mailbox input was not consumed", name, err)
		}
	}
	if len(mailbox.inputs) != 0 {
		t.Fatal("unbounded request journal retained")
	}
}
func TestRouterVPNDesktopMTURecapturePreservesEveryTransportField(t *testing.T) {
	m, _, _ := desktopMTUNativeFixture(t)
	before, err := m.owner.Capture()
	if err != nil {
		t.Fatal(err)
	}
	if _, err := m.owner.ChangeMTU(context.Background(), before, 1400); err != nil {
		t.Fatal(err)
	}
	fresh, err := m.recapture()
	if err != nil {
		t.Fatal(err)
	}
	defer fresh.Close()
	var original, current map[string]any
	if json.Unmarshal([]byte(m.owner.lease.Config()), &original) != nil || json.Unmarshal([]byte(fresh.Config()), &current) != nil {
		t.Fatal("config unreadable")
	}
	original["inbounds"].([]any)[0].(map[string]any)["mtu"] = float64(1400)
	a, _ := json.Marshal(original)
	b, _ := json.Marshal(current)
	if string(a) != string(b) {
		t.Fatal("MTU restoration changed captured transport/DNS policy")
	}
	if fresh.Requested() != true {
		t.Fatal("restoration erased saved Auto policy")
	}
}

func TestRouterVPNDesktopMTUCapturedRestoreCancelReprovesOriginal(t *testing.T) {
	m, lease, _ := desktopMTUNativeFixtureAt(t, 1400)
	lease.blocked, lease.blockAt = make(chan struct{}), 1
	request := routerVPNDesktopMTURequest{Generation: 1, Request: strings.Repeat("e", 32), RestoreMTU: 1380, Force: true}
	if err := m.start(request); err != nil {
		t.Fatal(err)
	}
	select {
	case <-lease.blocked:
	case <-time.After(time.Second):
		t.Fatal("captured restoration never reached proof")
	}
	if err := m.cancel(routerVPNDesktopMTUControl{Generation: 1, Request: request.Request}); err != nil {
		t.Fatal(err)
	}
	result := desktopMTUAwait(t, m, func(r routerVPNDesktopMTURecord) bool { return r.Status.Complete && !r.Status.Running })
	if result.Status.Measured || !result.Status.Restored || result.Status.EffectiveMTU != 1400 || result.Status.Source != "restored-unmeasured" || result.Status.Failure == "" {
		t.Fatal("canceled restoration claimed success", result)
	}
	lease.mu.Lock()
	defer lease.mu.Unlock()
	if len(lease.changes) != 2 || lease.changes[0] != 1380 || lease.changes[1] != 1400 || lease.proofs.Load() != 2 {
		t.Fatal("canceled restoration did not re-prove exact rollback", lease.changes, lease.proofs.Load())
	}
}

func TestRouterVPNDesktopMTULateRestoreCancelRetainsPretestReadback(t *testing.T) {
	m, lease, _ := desktopMTUNativeFixtureAt(t, 1400)
	before, err := m.owner.Capture()
	if err != nil {
		t.Fatal(err)
	}
	if _, err := m.owner.ChangeMTU(context.Background(), before, 1380); err != nil {
		t.Fatal(err)
	}
	// Exercise the exact acknowledgement race after a completed restore. The
	// operation still owns its original state until the next generation starts.
	m.request = routerVPNDesktopMTURequest{Generation: 1, Request: strings.Repeat("e", 32), RestoreMTU: 1380}
	m.original = before
	m.restored = &mobilemtu.Status{Request: m.request.Request, Complete: true, Restored: true, OriginalMTU: 1400, EffectiveMTU: 1380, Source: "restored-captured-system-tun"}
	if err := m.cancel(routerVPNDesktopMTUControl{Generation: 2, Request: m.request.Request}); err == nil {
		t.Fatal("replacement generation rolled back")
	}
	if err := m.cancel(routerVPNDesktopMTUControl{Generation: 1, Request: m.request.Request}); err != nil {
		t.Fatal(err)
	}
	result := desktopMTUAwait(t, m, func(r routerVPNDesktopMTURecord) bool {
		return !r.Status.Running && r.Status.Source == "restored-unmeasured"
	})
	if result.Status.EffectiveMTU != 1400 || result.Status.Measured || !result.Status.Restored {
		t.Fatal("late cancel kept the canceled restoration", result)
	}
	lease.mu.Lock()
	defer lease.mu.Unlock()
	if len(lease.changes) != 2 || lease.changes[1] != 1400 {
		t.Fatal("late cancel did not restore captured readback", lease.changes)
	}
}

func TestRouterVPNDesktopMTUImmediateCancellationRetainsActualReadback(t *testing.T) {
	for attempt := 0; attempt < 10; attempt++ {
		m, lease, _ := desktopMTUNativeFixtureAt(t, 1400)
		lease.blocked = make(chan struct{})
		request := routerVPNDesktopMTURequest{Generation: 1, Request: strings.Repeat("f", 32), Force: true}
		if err := m.start(request); err != nil {
			t.Fatal(err)
		}
		if err := m.cancel(routerVPNDesktopMTUControl{Generation: 1, Request: request.Request}); err != nil {
			t.Fatal(err)
		}
		result := desktopMTUAwait(t, m, func(r routerVPNDesktopMTURecord) bool { return r.Status.Complete && !r.Status.Running })
		if result.Status.Measured || result.Status.EffectiveMTU != 1400 || result.Status.OriginalMTU != 1400 {
			t.Fatal("immediate cancellation lost the captured readback", result)
		}
	}
}
