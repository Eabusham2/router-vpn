// The actual shipping Linux/Windows/Darwin physical target predicate consumes
// the original sealed schema-five source, never an OpenVPN mode label alone.
func TestRouterVPNNodeChainOpenVPNPrefixPhysicalTarget(t *testing.T) {
	for _, count := range []int{1, 2, 6} {
		for _, target := range []string{"linux", "windows", "darwin"} {
			t.Run(fmt.Sprintf("%d-%s", count, target), func(t *testing.T) {
				chain := chainNativeOpenVPNPrefixSource(t, count)
				policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chain, strings.Repeat("a", 32), target, 0)
				if err != nil {
					t.Fatal(err)
				}
				if !routerVPNDesktopNodeChainPhysicalTarget(policy, target) {
					t.Fatal("original sealed OpenVPN physical target refused")
				}
				meta := policy.Metadata()
				capture, err := policy.NodeChain().OpenVPNMiddleCapture()
				if err != nil || meta.Prefixes[count].Tag != capture.Tag || len(meta.Roots) != 1 {
					t.Fatal("original middle acquired physical root", err)
				}
				if routerVPNDesktopNodeChainPhysicalTarget(policy, "foreign") {
					t.Fatal("foreign target acquired physical owner")
				}
				copy := *policy
				if routerVPNDesktopNodeChainPhysicalTarget(&copy, target) {
					t.Fatal("copied metadata acquired original policy authority")
				}
			})
		}
	}
	for _, fault := range []string{"position", "tag", "source", "mode", "layer", "kind", "node-kind", "paired-id", "prefix", "final"} {
		t.Run(fault, func(t *testing.T) {
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chainNativeOpenVPNPrefixSource(t, 6), strings.Repeat("a", 32), "linux", 0)
			if err != nil {
				t.Fatal(err)
			}
			meta := chainNativeField[mobilemultihop.DesktopNodeChainMetadata](t, policy, "metadata")
			middle := &meta.Prefixes[6]
			switch fault {
			case "position":
				middle.Position = 1
			case "tag":
				middle.Tag = meta.Prefixes[0].Tag
			case "source":
				middle.SourceSHA256 = strings.Repeat("f", 64)
			case "mode":
				middle.Mode = "shadowsocks"
			case "layer":
				middle.StartLayer = "aes-256-gcm"
			case "kind":
				middle.Kind = "private-node"
			case "node-kind":
				middle.NodeKind = "router-vpn"
			case "paired-id":
				middle.NodeID = meta.Prefixes[0].NodeID
			case "prefix":
				meta.Prefixes[3].Mode = "openvpn"
			case "final":
				meta.Prefixes[7].Mode = "wg"
			}
			if routerVPNDesktopNodeChainPhysicalTarget(policy, "linux") {
				t.Fatal("foreign OpenVPN physical metadata acquired sealed owner", fault)
			}
		})
	}
}

func chainNativeImportedSSPhysicalSource(t *testing.T) *mobilemultihop.NodeChain {
	t.Helper()
	original := chainNativeOpenVPNSource(t)
	launch, err := original.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
	var source mobilemultihop.NodeChainSource
	if json.Unmarshal([]byte(launch), &source) != nil {
		t.Fatal("original paired trio absent")
	}
	var member struct {
		Kind            string
		Schema          int
		Config, Capture string
	}
	if json.Unmarshal([]byte(source.Nodes[1]), &member) != nil {
		t.Fatal("original import absent")
	}
	var graph, capture map[string]any
	if json.Unmarshal([]byte(member.Config), &graph) != nil || json.Unmarshal([]byte(member.Capture), &capture) != nil {
		t.Fatal("original standalone source absent")
	}
	password := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{73}, 32))
	graph["endpoints"] = []any{}
	graph["outbounds"] = []any{map[string]any{"type": "shadowsocks", "tag": mobilemultihop.ExternalFinalTag, "server": "203.0.113.24", "server_port": 8388, "method": mobilemultihop.NativeStartLayerMethod, "password": password}}
	profile := capture["profile"].(map[string]any)
	profile["external"] = map[string]any{"protocol": "shadowsocks", "expected_public_ip": "203.0.113.88", "shadowsocks": map[string]any{"server": "203.0.113.24", "port": 8388, "method": mobilemultihop.NativeStartLayerMethod, "password": password}}
	profile["id"], capture["exit_id"], capture["protocol"] = "native-ss-middle", "native-ss-middle", "shadowsocks"
	source.Schema = 2
	source.Nodes[1], err = mobilemultihop.NodeChainImportedMemberInput(chainNativeJSON(t, graph), chainNativeJSON(t, capture))
	if err != nil {
		t.Fatal(err)
	}
	result, err := mobilemultihop.NewNodeChain(chainNativeJSON(t, source))
	if err != nil {
		t.Fatal(err)
	}
	return result
}

func TestRouterVPNNodeChainOriginalImportedSSPhysicalTarget(t *testing.T) {
	for _, target := range []string{"linux", "windows", "darwin"} {
		t.Run(target, func(t *testing.T) {
			chain := chainNativeImportedSSPhysicalSource(t)
			policy, err := mobilemultihop.NewDesktopNodeChainPolicy(chain, strings.Repeat("a", 32), target, 0)
			if err != nil {
				t.Fatal(err)
			}
			if !routerVPNDesktopNodeChainPhysicalTarget(policy, target) {
				t.Fatal("original sealed SS trio physical target refused")
			}
			if routerVPNDesktopNodeChainPhysicalTarget(policy, "foreign") {
				t.Fatal("SS trio borrowed target")
			}
			launch, err := chain.LaunchInput()
			if err != nil {
				t.Fatal(err)
			}
			var source mobilemultihop.NodeChainSource
			if json.Unmarshal([]byte(launch), &source) != nil {
				t.Fatal("SS trio source absent")
			}
			source.Nodes = append(source.Nodes[:1], append([]string{source.Nodes[0]}, source.Nodes[1:]...)...)
			source.IdentitySources = append(source.IdentitySources[:1], append([]string{source.IdentitySources[0]}, source.IdentitySources[1:]...)...)
			if _, err := mobilemultihop.NewNodeChain(chainNativeJSON(t, source)); err == nil {
				t.Fatal("SS trio expanded through physical admission")
			}
		})
	}
}
