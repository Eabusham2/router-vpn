// This fixture uses the actual retained TCP/UDP listener and the unmodified
// ServerEndpoint.Close call path. Its device error is an explicit test boundary;
// the encrypted provider suite separately proves the full server/data lifecycle.
type routerVPNServerCloseDevice struct {
	ovpntransport.Device
	failure error
	calls   atomic.Int32
}

func (d *routerVPNServerCloseDevice) Close() error {
	d.calls.Add(1)
	return d.failure
}

func TestRouterVPNOpenVPNServerCloseOwnedListener(t *testing.T) {
	for _, network := range []string{"tcp", "udp"} {
		for _, state := range []string{"open", "already-closed", "device-error"} {
			t.Run(network+"-"+state, func(t *testing.T) {
				ctx, cancel := context.WithCancel(context.Background())
				defer cancel()
				retained := listener.New(listener.Options{Context: ctx, Logger: logger.NOP(), Network: []string{network}})
				var raw io.Closer
				var address string
				if network == "tcp" {
					socket, err := retained.ListenTCP()
					if err != nil {
						t.Fatal(err)
					}
					raw, address = socket, socket.Addr().String()
				} else {
					socket, err := retained.ListenUDPWithConfig(net.ListenConfig{})
					if err != nil {
						t.Fatal(err)
					}
					raw, address = socket, socket.LocalAddr().String()
				}
				defer raw.Close()
				if state != "open" {
					// tlsServer.Close owns this first transport close; reproduce
					// its actual socket outcome without suppressing the later
					// endpoint's return value in the fixture.
					if err := raw.Close(); err != nil {
						t.Fatal(err)
					}
				}
				device := &routerVPNServerCloseDevice{}
				if state == "device-error" {
					device.failure = errors.New("owned device cleanup sentinel")
				}
				drained := make(chan struct{})
				close(drained)
				endpoint := &ServerEndpoint{cancelLoop: cancel, listener: retained, device: device, readLoopDone: drained}
				endpoint.started.Store(true)
				if got := endpoint.Close(); got != device.failure {
					t.Fatalf("actual server listener close lost its exact error contract: got %v, want %v", got, device.failure)
				}
				if device.calls.Load() != 1 || endpoint.started.Load() || !errors.Is(ctx.Err(), context.Canceled) {
					t.Fatal("server cleanup lost its original device/cancellation order")
				}
				// A nil result cannot conceal an open listener. Rebind the exact
				// original local address through the real OS after endpoint close.
				if network == "tcp" {
					socket, err := net.Listen(network, address)
					if err != nil {
						t.Fatal("endpoint retained TCP listener", err)
					}
					if err := socket.Close(); err != nil {
						t.Fatal(err)
					}
				} else {
					socket, err := net.ListenPacket(network, address)
					if err != nil {
						t.Fatal("endpoint retained UDP listener", err)
					}
					if err := socket.Close(); err != nil {
						t.Fatal(err)
					}
				}
			})
		}
	}
}

// The real dial/capture boundary must preserve kernel socket capabilities and
// wrap only the original userspace transport before assigning its generation.
type routerVPNOriginalTransportDialer struct{ connection net.Conn }

func (d routerVPNOriginalTransportDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
	return d.connection, nil
}
func (d routerVPNOriginalTransportDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
	return nil, errors.New("unexpected packet listener")
}
func TestRouterVPNOpenVPNOriginalTransportCapture(t *testing.T) {
	for _, network := range []string{"tcp", "udp", "userspace-tcp", "userspace-udp"} {
		t.Run(network, func(t *testing.T) {
			var original net.Conn
			transport := strings.TrimPrefix(network, "userspace-")
			if strings.HasPrefix(network, "userspace-") {
				original = &routerVPNOpenVPNOriginalTransportFixture{}
			} else if network == "udp" {
				c, e := net.Dial("udp4", "127.0.0.1:9")
				if e != nil {
					t.Fatal(e)
				}
				original = c
			} else {
				l, e := net.Listen("tcp4", "127.0.0.1:0")
				if e != nil {
					t.Fatal(e)
				}
				defer l.Close()
				joined := make(chan net.Conn, 1)
				go func() { c, _ := l.Accept(); joined <- c }()
				c, e := net.Dial("tcp4", l.Addr().String())
				if e != nil {
					_ = l.Close() // Join the original Accept even when the dial fails.
				}
				peer := <-joined
				if peer != nil {
					defer peer.Close()
				}
				if e != nil {
					t.Fatal(e)
				}
				original = c
			}
			defer original.Close()
			c := &ClientEndpoint{loopContext: context.Background(), outboundDialer: routerVPNOriginalTransportDialer{original}, statusUpdated: make(chan struct{})}
			c.state.Store(&clientState{})
			captured, e := c.transportDialContextWithAddressIndex(context.Background(), transport, "198.51.100.240:8388", 0)
			if e != nil {
				t.Fatal(e)
			}
			if strings.HasPrefix(network, "userspace-") {
				wrapped, ok := captured.(*routerVPNOpenVPNOriginalTransport)
				if !ok || wrapped.Conn != original {
					t.Fatal("userspace transport did not retain original connection")
				}
			} else if captured != original {
				t.Fatal("original kernel socket capabilities/type changed")
			}
			if c.routerVPNTransportGenerationFor(captured) != 1 || c.state.Load().routerVPNTransport != captured {
				t.Fatal("capture did not retain exact returned transport")
			}
			foreign := &routerVPNOpenVPNOriginalTransport{Conn: original}
			if c.routerVPNTransportGenerationFor(foreign) != 0 {
				t.Fatal("foreign wrapper inherited original generation")
			}
		})
	}
}
