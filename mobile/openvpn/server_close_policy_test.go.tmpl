package openvpn

import (
	"context"
	"errors"
	"io"
	"net"
	"sync/atomic"
	"testing"

	"github.com/sagernet/sing-box/common/listener"
	ovpntransport "github.com/sagernet/sing-box/transport/openvpn"
	"github.com/sagernet/sing/common/logger"
)

// This fixture uses the actual retained TCP/UDP listener and the unmodified
// ServerEndpoint.Close call path. Its device error is an explicit test boundary;
// the encrypted provider suite separately proves the full server/data lifecycle.
type routerVPNServerCloseDevice struct {
	ovpntransport.Device
	failure error
	calls   atomic.Int32
}

func (d *routerVPNServerCloseDevice) Close() error {
	d.calls.Add(1)
	return d.failure
}

func TestRouterVPNOpenVPNServerCloseOwnedListener(t *testing.T) {
	for _, network := range []string{"tcp", "udp"} {
		for _, state := range []string{"open", "already-closed", "device-error"} {
			t.Run(network+"-"+state, func(t *testing.T) {
				ctx, cancel := context.WithCancel(context.Background())
				defer cancel()
				retained := listener.New(listener.Options{Context: ctx, Logger: logger.NOP(), Network: []string{network}})
				var raw io.Closer
				var address string
				if network == "tcp" {
					socket, err := retained.ListenTCP()
					if err != nil {
						t.Fatal(err)
					}
					raw, address = socket, socket.Addr().String()
				} else {
					socket, err := retained.ListenUDPWithConfig(net.ListenConfig{})
					if err != nil {
						t.Fatal(err)
					}
					raw, address = socket, socket.LocalAddr().String()
				}
				defer raw.Close()
				if state != "open" {
					// tlsServer.Close owns this first transport close; reproduce
					// its actual socket outcome without suppressing the later
					// endpoint's return value in the fixture.
					if err := raw.Close(); err != nil {
						t.Fatal(err)
					}
				}
				device := &routerVPNServerCloseDevice{}
				if state == "device-error" {
					device.failure = errors.New("owned device cleanup sentinel")
				}
				drained := make(chan struct{})
				close(drained)
				endpoint := &ServerEndpoint{cancelLoop: cancel, listener: retained, device: device, readLoopDone: drained}
				endpoint.started.Store(true)
				if got := endpoint.Close(); got != device.failure {
					t.Fatalf("actual server listener close lost its exact error contract: got %v, want %v", got, device.failure)
				}
				if device.calls.Load() != 1 || endpoint.started.Load() || !errors.Is(ctx.Err(), context.Canceled) {
					t.Fatal("server cleanup lost its original device/cancellation order")
				}
				// A nil result cannot conceal an open listener. Rebind the exact
				// original local address through the real OS after endpoint close.
				if network == "tcp" {
					socket, err := net.Listen(network, address)
					if err != nil {
						t.Fatal("endpoint retained TCP listener", err)
					}
					if err := socket.Close(); err != nil {
						t.Fatal(err)
					}
				} else {
					socket, err := net.ListenPacket(network, address)
					if err != nil {
						t.Fatal("endpoint retained UDP listener", err)
					}
					if err := socket.Close(); err != nil {
						t.Fatal(err)
					}
				}
			})
		}
	}
}
