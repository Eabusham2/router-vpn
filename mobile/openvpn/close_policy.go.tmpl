package openvpn

import (
	"net"
	"sync"
	"sync/atomic"
)

// The pinned OpenVPN session interrupts its packet transport before closing
// TLS. A closeNotify write can therefore report net.ErrClosed after shutdown
// has completed. Preserve any other failure, including one joined with that
// expected condition; the endpoint must still close its device and join its
// reader and challenge workers before returning.
func routerVPNOpenVPNCloseError(err error) error {
	if routerVPNOpenVPNOnlyClosed(err, 0) {
		return nil
	}
	return err
}

func routerVPNOpenVPNOnlyClosed(err error, depth int) bool {
	if err == nil {
		return true
	}
	if depth >= 32 {
		return false
	}
	switch value := err.(type) {
	case interface{ Unwrap() []error }:
		children := value.Unwrap()
		if len(children) == 0 {
			return false
		}
		for _, child := range children {
			if !routerVPNOpenVPNOnlyClosed(child, depth+1) {
				return false
			}
		}
		return true
	case interface{ Unwrap() error }:
		child := value.Unwrap()
		return child != nil && routerVPNOpenVPNOnlyClosed(child, depth+1)
	default:
		return err == net.ErrClosed
	}
}

// A userspace connected transport need not return net.ErrClosed after its own successful
// Close (gVisor can return EPIPE or EINVAL). Keep the exact original local close milestone
// so the library's later TLS closeNotify never writes to a retired transport. This
// does not classify remote errors, failed closes or in-flight writes as success.
type routerVPNOpenVPNOriginalTransport struct {
	net.Conn
	closeOnce sync.Once
	closed    atomic.Bool
	closeErr  error
}

func (c *routerVPNOpenVPNOriginalTransport) Read(p []byte) (int, error) {
	if c.closed.Load() {
		return 0, net.ErrClosed
	}
	return c.Conn.Read(p)
}
func (c *routerVPNOpenVPNOriginalTransport) Write(p []byte) (int, error) {
	if c.closed.Load() {
		return 0, net.ErrClosed
	}
	return c.Conn.Write(p)
}
func (c *routerVPNOpenVPNOriginalTransport) Close() error {
	c.closeOnce.Do(func() {
		c.closeErr = c.Conn.Close()
		if c.closeErr == nil {
			c.closed.Store(true)
		}
	})
	return c.closeErr
}
