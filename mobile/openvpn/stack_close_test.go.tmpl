type routerVPNPausedStackDelivery struct {
	stack.NetworkDispatcher
	stack   *stack.Stack
	entered chan struct{}
	release chan struct{}
	abort   chan struct{}
	calls   atomic.Int32
}

func (d *routerVPNPausedStackDelivery) DeliverNetworkPacket(protocol tcpip.NetworkProtocolNumber, packet *stack.PacketBuffer) {
	if d.calls.Add(1) != 1 {
		return
	}
	close(d.entered)
	<-d.release
	select {
	case <-d.abort: // Only failure cleanup may abandon this test callback.
		return
	default:
	}
	// The real IPv4 handler takes this same stack read lock. Keeping a delivery
	// paused makes the old Stack.Wait -> Attach(nil) lock cycle deterministic.
	d.stack.FindNICNameFromID(1)
	d.NetworkDispatcher.DeliverNetworkPacket(protocol, packet)
}

func TestRouterVPNOpenVPNStackCloseDrainsDeliveryBeforeStackLock(t *testing.T) {
	device, err := newStackDevice(DeviceOptions{Context: context.Background(), MTU: 1400})
	if err != nil {
		t.Fatal(err)
	}
	endpoint := device.endpoint
	paused := &routerVPNPausedStackDelivery{NetworkDispatcher: endpoint.dispatcher, stack: device.stack,
		entered: make(chan struct{}), release: make(chan struct{}), abort: make(chan struct{})}
	endpoint.Attach(paused)
	packet := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(make([]byte, 20))})
	delivered := make(chan struct{})
	closed := make(chan error, 1)
	lookedUp := make(chan struct{})
	var release sync.Once
	defer func() {
		close(paused.abort)
		release.Do(func() { close(paused.release) })
		select {
		case <-delivered:
			packet.DecRef()
		case <-time.After(time.Second):
			t.Error("captured packet callback did not drain during fixture cleanup")
		}
		select {
		case <-closed:
		case <-time.After(time.Second):
			t.Error("captured stack did not drain during fixture cleanup")
		}
	}()
	go func() {
		endpoint.deliverNetworkPackets([]tcpip.NetworkProtocolNumber{ipv4.ProtocolNumber}, []*stack.PacketBuffer{packet})
		close(delivered)
	}()
	select {
	case <-paused.entered:
	case <-time.After(time.Second):
		t.Fatal("real link delivery did not enter")
	}
	go func() { closed <- device.Close() }()
	// There is exactly one writer: this owner's Close detaching the endpoint.
	// A pending writer makes TryRLock fail while our paused delivery owns RLock.
	deadline := time.NewTimer(time.Second)
	defer deadline.Stop()
	for endpoint.dispatcherAccess.TryRLock() {
		endpoint.dispatcherAccess.RUnlock()
		select {
		case <-deadline.C:
			t.Fatal("native close did not begin captured link detachment")
		case <-time.After(time.Millisecond):
		}
	}
	go func() { device.stack.FindNICNameFromID(1); close(lookedUp) }()
	select {
	case <-lookedUp:
	case <-time.After(time.Second):
		t.Fatal("native close held the gVisor stack lock while waiting for captured packet delivery")
	}
	release.Do(func() { close(paused.release) })
	select {
	case err := <-closed:
		closed <- err
		if err != nil {
			t.Fatal(err)
		}
	case <-time.After(time.Second):
		t.Fatal("native close did not drain after its packet completed")
	}
	endpoint.deliverNetworkPackets([]tcpip.NetworkProtocolNumber{ipv4.ProtocolNumber}, []*stack.PacketBuffer{packet})
	if endpoint.IsAttached() || paused.calls.Load() != 1 {
		t.Fatal("closed native link delivered another packet")
	}
}

func TestRouterVPNOpenVPNStackLiveCapacityObservation(t *testing.T) {
	device, err := newStackDevice(DeviceOptions{Context: context.Background(), MTU: 1500})
	if err != nil {
		t.Fatal(err)
	}
	defer device.Close()
	for _, mtu := range []uint32{1500, 1600, 1400} {
		if err := device.UpdateConfiguration(Configuration{MTU: mtu}); err != nil {
			t.Fatal(err)
		}
		actual, err := device.RouterVPNPortMTUContext(context.Background())
		if err != nil || actual != mtu || actual != device.PortMTU() {
			t.Fatal("bounded capacity differs from actual packet port", actual, err)
		}
	}
	device.stateAccess.Lock()
	ctx, cancel := context.WithCancel(context.Background())
	entered, done := make(chan struct{}), make(chan error, 1)
	go func() { close(entered); _, err := device.RouterVPNPortMTUContext(ctx); done <- err }()
	<-entered
	cancel()
	// The writer remains held until the actual reader has returned cancellation.
	select {
	case err := <-done:
		if err != context.Canceled {
			device.stateAccess.Unlock()
			t.Fatal("wrong cancelled reader", err)
		}
	case <-time.After(time.Second):
		device.stateAccess.Unlock()
		t.Fatal("capacity read escaped caller-owned cancellation")
	}
	device.stateAccess.Unlock()
	if err := device.Close(); err != nil {
		t.Fatal(err)
	}
	if _, err := device.RouterVPNPortMTUContext(context.Background()); err == nil {
		t.Fatal("closed packet device retained capacity authority")
	}
}

// The pinned gonet functions return concrete pointer types. Real failed binds
// and cancellation must not box those nil pointers into public interfaces: the
// retained external engine legitimately closes any non-nil returned carrier.
func TestRouterVPNOpenVPNStackFailedDialReturnsNilInterface(t *testing.T) {
	for _, mode := range []string{"tcp-cancel", "tcp-bind", "udp-bind", "packet-bind", "udp-success"} {
		t.Run(mode, func(t *testing.T) {
			address := netip.MustParsePrefix("10.89.0.2/24")
			device, err := newStackDevice(DeviceOptions{Context: context.Background(), MTU: 1400,
				Configuration: Configuration{Address: []netip.Prefix{address}}})
			if err != nil {
				t.Fatal(err)
			}
			defer device.Close()
			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
			defer cancel()
			destination := M.ParseSocksaddr("10.89.0.1:443")
			if mode == "tcp-cancel" {
				cancel()
			}
			if mode == "tcp-bind" || mode == "udp-bind" || mode == "packet-bind" {
				// Keep the captured configured source but make the actual stack
				// refuse its NIC bind, as an unavailable native source must do.
				if err := device.stack.RemoveNIC(tun.DefaultNIC); err != nil {
					t.Fatal(err)
				}
			}
			if mode == "packet-bind" {
				connection, err := device.ListenPacket(ctx, destination)
				if err == nil || connection != nil {
					t.Fatalf("failed packet bind returned carrier %T or lost error: %v", connection, err)
				}
				return
			}
			network := "tcp"
			if mode == "udp-bind" || mode == "udp-success" {
				network = "udp"
			}
			connection, err := device.DialContext(ctx, network, destination)
			if mode == "udp-success" {
				if err != nil || connection == nil {
					t.Fatalf("live UDP carrier lost: %v", err)
				}
				if err := connection.Close(); err != nil {
					t.Fatal(err)
				}
				return
			}
			if err == nil || connection != nil {
				t.Fatalf("failed dial returned carrier %T or lost error: %v", connection, err)
			}
			if mode == "tcp-cancel" && !errors.Is(err, context.Canceled) {
				t.Fatalf("caller cancellation replaced: %v", err)
			}
		})
	}
}
