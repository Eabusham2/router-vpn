//go:build routervpn_execution_latency_component

package mobilemultihop

// BEGIN EXPORTED COMPONENT FIXTURE

// RouterVPNDesktopLatencyTestFixture exposes a real shared controller with
// explicit native transport/worker/TUN doubles only to the tagged component.
type RouterVPNDesktopLatencyTestFixture struct {
	*desktopLatencyOriginalNodeChainExecutionRuntimeEngine
	original   *desktopLatencyOriginalNodeChainExecutionRuntimeFixture
	Runtime    *NodeChainExecutionRuntime
	Projection *NodeChainExecutionProjection
	Readback   NodeChainExecutionTUNReadback
	Host       func(context.Context) error
	Samples    *atomic.Int32
	Node       NodeChainProof
}

func NewRouterVPNDesktopLatencyTestFixture(t *testing.T, prep *NodeChainExecutionPreparation, projection *NodeChainExecutionProjection, session string, localWinner bool) *RouterVPNDesktopLatencyTestFixture {
	t.Helper()
	if prep == nil || projection == nil || projection.preparation != prep || projection.validateCapture() != nil || prep.desktop == nil {
		t.Fatal("component requires original physical preparation/projection")
	}
	original := desktopLatencyNewFixture(t, projection)
	original.engine.identity.SessionID = session
	if localWinner {
		original.engine.localDelay, original.engine.serverDelay = time.Millisecond, 200*time.Millisecond
	} else {
		original.engine.localDelay, original.engine.serverDelay = 200*time.Millisecond, time.Millisecond
	}
	plan, err := projection.MTUPlan()
	if err != nil {
		t.Fatal(err)
	}
	f := &RouterVPNDesktopLatencyTestFixture{desktopLatencyOriginalNodeChainExecutionRuntimeEngine: original.engine, original: original, Runtime: original.runtime, Projection: projection}
	f.Readback = NodeChainExecutionTUNReadback{Identity: original.engine.identity, TargetOS: "linux", TUNTag: plan.TUNTag, ReaderNonce: strings.Repeat("e", 64), ReaderGeneration: 1, InterfaceName: "router-vpn", InterfaceIndex: 17, MTU: 1420}
	// The shared runtime uses this same concrete component engine retained by
	// the desktop child. Neither the controller nor its selected trial is fake.
	f.Runtime.engine = f
	proofCtx, stop := context.WithCancel(t.Context())
	joined := make(chan struct{})
	go func() {
		defer close(joined)
		ticker := time.NewTicker(5 * time.Second)
		defer ticker.Stop()
		for {
			select {
			case <-proofCtx.Done():
				return
			case <-ticker.C:
				original.runner.mu.Lock()
				workers := append([]*desktopLatencyOriginalNodeChainExecutionRuntimeWorker(nil), original.runner.workers...)
				original.runner.mu.Unlock()
				for _, worker := range workers {
					if worker.alive.Load() && worker.ready.Load() {
						if worker.Bootstrap(proofCtx) != nil {
							return
						}
					}
				}
			}
		}
	}()
	t.Cleanup(func() { stop(); <-joined })
	return f
}

func (f *RouterVPNDesktopLatencyTestFixture) ObserveChainContext(ctx context.Context) (NodeChainIdentity, error) {
	if f.Host != nil {
		if err := f.Host(ctx); err != nil {
			return NodeChainIdentity{}, err
		}
	}
	return f.desktopLatencyOriginalNodeChainExecutionRuntimeEngine.ObserveChainContext(ctx)
}

func (f *RouterVPNDesktopLatencyTestFixture) DiscoverContext(ctx context.Context) (NodeChainExecutionDiscovery, error) {
	peer := netip.MustParseAddr(f.Projection.policy.source.Request.Peer)
	challenge, sources, err := f.original.manager.ChainAvailable(peer)
	if err != nil {
		return NodeChainExecutionDiscovery{}, err
	}
	first, last, err := f.original.manager.ChainPortRange(peer)
	return NodeChainExecutionDiscovery{NodeID: f.Projection.policy.Descriptor().EntryNodeID, Challenge: challenge, Sources: sources, FirstPort: first, LastPort: last}, errors.Join(err, ctx.Err())
}

func (f *RouterVPNDesktopLatencyTestFixture) AdoptContext(ctx context.Context, source string, port int) (*NodeChainExecutionProjection, error) {
	if source != "" || port != f.Projection.policy.source.Request.Port {
		return nil, nodeChainExecutionError
	}
	return f.Projection, ctx.Err()
}

func (f *RouterVPNDesktopLatencyTestFixture) CaptureExecutionTUNReadbackContext(ctx context.Context, identity NodeChainIdentity) (NodeChainExecutionTUNReadback, error) {
	if identity != f.Readback.Identity {
		return NodeChainExecutionTUNReadback{}, nodeChainExecutionError
	}
	if _, err := f.ObserveChainContext(ctx); err != nil {
		return NodeChainExecutionTUNReadback{}, err
	}
	return f.Readback, ctx.Err()
}

func (*RouterVPNDesktopLatencyTestFixture) ExecutionTUNReadbackRetiredContext(context.Context, NodeChainExecutionTUNReadback) error {
	// This component has no native reader retirement receipt and must not
	// authorize an opaque restore by borrowing its simulated live readback.
	return errors.New("selected latency component cannot grant native TUN retirement")
}

func (f *RouterVPNDesktopLatencyTestFixture) RetireContext(ctx context.Context) error {
	f.mu.Lock()
	defer f.mu.Unlock()
	if f.open {
		return nodeChainExecutionError
	}
	f.alive = false
	return ctx.Err()
}

func (f *RouterVPNDesktopLatencyTestFixture) StartHTTP50(t *testing.T) {
	t.Helper()
	f.Node, f.Samples = desktopLatencyOriginalExecutionFiftyHTTP(t, f.original)
	// The replacement peer must outlive the joined original DELETE.
	t.Cleanup(func() {
		ctx, done := context.WithTimeout(context.Background(), 3*time.Second)
		defer done()
		if err := f.Runtime.CloseContext(ctx); err != nil {
			t.Error(err)
		}
	})
}

func (f *RouterVPNDesktopLatencyTestFixture) SelectionCount() int {
	f.mu.Lock()
	defer f.mu.Unlock()
	return len(f.selections)
}

func (f *RouterVPNDesktopLatencyTestFixture) ChangeEpoch() { f.mu.Lock(); f.epoch++; f.mu.Unlock() }

func (f *RouterVPNDesktopLatencyTestFixture) SetStopFailure(value bool) {
	f.original.runner.failStop.Store(value)
}
