// Only the transport and remote peer are controlled. The desktop child owns
// the real shared runtime, selected trial, IPC, grants and fifty-target service.
type RouterVPNDesktopCandidateTestPeer struct {
	f                                                              *desktopLatencyOriginalNodeChainExecutionRuntimeFixture
	mu                                                             sync.Mutex
	capture                                                        multihoprelay.NodeChainCandidateCapture
	admission                                                      *multihoprelay.NodeChainCandidateAdmission
	put, post, deleted                                             int
	events                                                         []string
	badACK, losePUT, badReceipt                                    bool
	beforeGrant                                                    func()
	frontDelay                                                     time.Duration
	payload                                                        atomic.Int32
	destination                                                    net.Listener
	accepts                                                        atomic.Int32
	destinationAddr, frontAddr, entryTag, localTag, api, proxyAddr string
}

func (p *RouterVPNDesktopCandidateTestPeer) Counts() (int, int, int) {
	p.mu.Lock()
	defer p.mu.Unlock()
	return int(p.accepts.Load()), p.put, p.deleted
}
func (p *RouterVPNDesktopCandidateTestPeer) BadStop(value bool) {
	p.mu.Lock()
	p.badACK = value
	p.mu.Unlock()
}

func (f *RouterVPNDesktopLatencyTestFixture) SetupCandidate(t *testing.T, position int, address string) *RouterVPNDesktopCandidateTestPeer {
	t.Helper()
	p := &RouterVPNDesktopCandidateTestPeer{f: f.original, destinationAddr: address}
	local := f.Projection.policy.local
	p.localTag = local.proofs[position].Tag
	p.entryTag = local.proofs[0].Tag
	api, err := privateAPI(predecessorText(local.nodes[0].profile, "router_api"))
	if err != nil {
		t.Fatal(err)
	}
	p.api = api.Host
	token := predecessorText(local.nodes[0].profile, "api_token")
	f.mu.Lock()
	old := f.peers[p.entryTag+"/"+p.api]
	f.mu.Unlock()
	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
		return (&net.Dialer{}).DialContext(ctx, "tcp", old)
	}}
	t.Cleanup(transport.CloseIdleConnections)
	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Host != p.api || r.Header.Get("Authorization") != "Bearer "+token {
			http.Error(w, "foreign", 403)
			return
		}
		if r.URL.Path == nodeChainExecutionCandidatePath {
			p.serveCandidate(w, r)
			return
		}
		q := r.Clone(r.Context())
		q.RequestURI = ""
		q.URL.Scheme = "http"
		q.URL.Host = p.api
		reply, e := transport.RoundTrip(q)
		if e != nil {
			http.Error(w, "unavailable", 502)
			return
		}
		defer reply.Body.Close()
		for k, v := range reply.Header {
			w.Header()[k] = v
		}
		w.WriteHeader(reply.StatusCode)
		_, _ = io.Copy(w, reply.Body)
	}))
	t.Cleanup(proxy.Close)
	p.proxyAddr = proxy.Listener.Addr().String()
	p.frontAddr = net.JoinHostPort(f.Projection.policy.front.Host, strconv.Itoa(f.Projection.policy.front.Port))
	p.destination, err = net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	done := make(chan struct{})
	go func() {
		defer close(done)
		for {
			c, e := p.destination.Accept()
			if e != nil {
				return
			}
			p.accepts.Add(1)
			c.Close()
		}
	}()
	t.Cleanup(func() { p.destination.Close(); <-done })
	if !f.candidate.CompareAndSwap(nil, p) {
		t.Fatal("original candidate fixture already owned")
	}
	t.Cleanup(func() {
		p.BadStop(false)
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		if err := f.Runtime.CloseContext(ctx); err != nil {
			t.Error(err)
		}
	})
	return p
}

func (p *RouterVPNDesktopCandidateTestPeer) dial(ctx context.Context, tag, address string) (net.Conn, error, bool) {
	if tag == p.entryTag && address == p.api {
		c, e := (&net.Dialer{}).DialContext(ctx, "tcp", p.proxyAddr)
		return c, e, true
	}
	if tag == p.localTag && address == p.destinationAddr {
		c, e := (&net.Dialer{}).DialContext(ctx, "tcp", p.destination.Addr().String())
		return c, e, true
	}
	// Remote execution opens the exact paired front. Its ordinary periodic
	// proofs continue on their original peer bindings outside candidate TCP.
	if tag == p.entryTag && address == p.frontAddr {
		client, server := net.Pipe()
		go p.front(server)
		return client, nil, true
	}
	return nil, nil, false
}
