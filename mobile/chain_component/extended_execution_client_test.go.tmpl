// The fixture's pinned userspace peers drain one UDP datagram at a time.
// Buffer a bounded burst on each original loopback socket so a busy test
// process does not introduce physical packet loss into the encrypted path.
func extendedWGSockets(conn *net.UDPConn, report func(int, int)) error {
	if err := errors.Join(conn.SetReadBuffer(4<<20), conn.SetWriteBuffer(4<<20)); err != nil {
		return err
	}
	raw, err := conn.SyscallConn()
	if err != nil {
		return err
	}
	var received, sent int
	var readErr, writeErr error
	err = raw.Control(func(fd uintptr) {
		received, readErr = unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_RCVBUF)
		sent, writeErr = unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_SNDBUF)
	})
	if err = errors.Join(err, readErr, writeErr); err != nil {
		return err
	}
	report(received, sent)
	return nil
}

type extendedWGLower struct {
	*desktopSSReferenceLower
	report func(int, int)
}

func (s *extendedWGLower) DialContext(ctx context.Context, network string, dest M.Socksaddr) (net.Conn, error) {
	c, err := s.desktopSSReferenceLower.DialContext(ctx, network, dest)
	if err != nil {
		return nil, err
	}
	u, ok := c.(*net.UDPConn)
	if !ok {
		return nil, errors.Join(errors.New("lost physical UDP socket"), c.Close())
	}
	if err = extendedWGSockets(u, s.report); err != nil {
		return nil, errors.Join(err, c.Close())
	}
	return u, nil
}

type extendedSelectedMeasurement struct {
	runtime *mobilemultihop.NodeChainExecutionRuntime
	active  atomic.Bool
}

func (o *extendedSelectedMeasurement) MeasurementExecutionContext(ctx context.Context) (*mobilemultihop.NodeChainExecutionRuntime, error) {
	if ctx.Err() != nil {
		return nil, ctx.Err()
	}
	return o.runtime, nil
}
func (o *extendedSelectedMeasurement) BeginMeasurementContext(ctx context.Context) (func(), error) {
	if ctx.Err() != nil || !o.active.CompareAndSwap(false, true) {
		return nil, errors.New("original selection activity unavailable")
	}
	return func() { o.active.Store(false) }, nil
}

// Read the actual client device while it still owns the selected TUN. The
// independent packet peer already checked its device against the source map.
func verifyExtendedClientAWG(t *testing.T, native *box.Box, tag, entry, expected string) {
	t.Helper()
	current, found := native.Endpoint().Get(tag)
	bound, ok := current.(*multipleImportedPhysical)
	if !found || !ok {
		t.Fatal("selected Box lost its original physical endpoint")
	}
	client, ok := bound.Endpoint.(*Endpoint)
	if !ok || (entry != "awg2-fast" && entry != "awg2-strong") || len(expected) != 64 {
		t.Fatal("selected client lost its original AWG endpoint")
	}
	client.life.Lock()
	defer client.life.Unlock()
	if client.closed || !client.started.Load() || client.device == nil {
		t.Fatal("selected AWG client device is no longer live")
	}
	if actual, err := desktopNodeAWGParameterReadback(client.device, expected); err != nil || actual != expected {
		t.Fatal("live AWG client changed the original peer parameters")
	}
	// The fixture's Fast and Strong entries set distinct native junk parameters.
	// Reuse that independently known alternate set as a negative readback.
	alternate := parameters()
	if entry == "awg2-fast" {
		alternate["jc"], alternate["jmax"] = "8", "1200"
	}
	other, err := desktopNodeAWGParameterDigest(alternate)
	if err != nil || other == expected {
		t.Fatal("alternate AWG parameters do not distinguish the selected source")
	}
	if _, err := desktopNodeAWGParameterReadback(client.device, other); err == nil {
		t.Fatal("selected client accepted another AWG mode's parameters")
	}
	t.Logf("QUALIFIED_SELECTED_CLIENT_AWG entry=%s parameters_current=true other_mode_refused=true", entry)
}

func runExtendedSelectedClient(t *testing.T, f *multipleImportedFixture, prep *mobilemultihop.NodeChainExecutionPreparation, policy *mobilemultihop.NodeChainServerPolicy, front *extendedWGFront, mode, winner, measure string, first, last, privatePosition int, response *selectedResponseNativeCase) {
	t.Helper()
	if f.native != nil {
		if err := f.native.Close(); err != nil {
			t.Fatal(err)
		}
		f.native = nil
	}
	capture, err := prep.Discovery()
	if err != nil {
		t.Fatal(err)
	}
	egress, err := f.chain.PhysicalEgress()
	if err != nil || len(egress) != 1 {
		t.Fatal(err)
	}
	bind := f.members[0].prefix.bind
	bind.mu.Lock()
	err = extendedWGSockets(bind.connection, func(rx, tx int) { t.Logf("WG peer socket receive=%d send=%d", rx, tx) })
	bind.mu.Unlock()
	if err != nil {
		t.Fatal(err)
	}
	lower := &extendedWGLower{&desktopSSReferenceLower{virtual: net.JoinHostPort(egress[0].Host, strconv.Itoa(egress[0].Port)), original: f.members[0].physical}, func(rx, tx int) { t.Logf("WG original client socket receive=%d send=%d", rx, tx) }}
	ins, outs, ends := inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry()
	group.RegisterSelector(outs)
	gate.RegisterOutbound(outs)
	ss.RegisterOutbound(outs)
	socks.RegisterOutbound(outs)
	inbound.Register[option.TunInboundOptions](ins, "tun", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
		return &multipleImportedTUN{inbound.NewAdapter("tun", tag)}, nil
	})
	endpoint.Register[option.WireGuardEndpointOptions](ends, "wireguard", func(c context.Context, router adapter.Router, l log.ContextLogger, tag string, opt option.WireGuardEndpointOptions) (adapter.Endpoint, error) {
		if tag != capture.Entry.Tag || opt.Detour != "" {
			return nil, errors.New("foreign original entry")
		}
		c = service.ExtendContext(c)
		c = service.ContextWith[adapter.OutboundManager](c, &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}})
		c = service.ContextWith[adapter.NetworkManager](c, &desktopImportedPacketNetwork{})
		opt.Detour = "captured-physical"
		actual, err := wg.NewEndpoint(c, router, l, tag, opt)
		if err != nil {
			return nil, err
		}
		return &multipleImportedPhysical{actual}, nil
	})
	awgEntry := capture.Entry.Mode == "awg2-fast" || capture.Entry.Mode == "awg2-strong"
	if awgEntry {
		endpoint.Register[Options](ends, mobilemultihop.AmneziaType, func(c context.Context, router adapter.Router, l log.ContextLogger, tag string, opt Options) (adapter.Endpoint, error) {
			if tag != capture.Entry.Tag || opt.Detour != "" {
				return nil, errors.New("foreign original AWG entry")
			}
			c = service.ExtendContext(c)
			c = service.ContextWith[adapter.OutboundManager](c, &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}})
			c = service.ContextWith[adapter.NetworkManager](c, &desktopImportedPacketNetwork{})
			opt.Detour = "captured-physical"
			actual, err := NewEndpoint(c, router, l, tag, opt)
			if err != nil {
				return nil, err
			}
			return &multipleImportedPhysical{actual}, nil
		})
	}
	transports := bd.NewTransportRegistry()
	dt.RegisterTCP(transports)
	dt.RegisterUDP(transports)
	ctx := service.ContextWithRegistry(f.ctx, service.NewRegistry())
	ctx = service.ContextWith[adapter.PlatformInterface](ctx, &multipleImportedPlatform{})
	ctx = box.Context(ctx, ins, outs, ends, transports, bs.NewRegistry(), certificate.NewRegistry())
	if f.source.Schema != 2 {
		ctx, err = box.RouterVPNNodeMultipleImportedExecutionContext(ctx, prep)
		if err != nil {
			t.Fatal("verified original native construction context", err)
		}
	}
	opts, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(prep.Config()))
	if err != nil {
		t.Fatal(err)
	}
	native, err := box.New(box.Options{Context: ctx, Options: opts})
	if err != nil {
		t.Fatal("client Box", err)
	}
	defer func() {
		if err := native.Close(); err != nil {
			t.Error(err)
		}
	}()
	if err = native.Start(); err != nil {
		t.Fatal(err)
	}
	engine, err := native.RouterVPNNewNodeChainExecutionEngine(ctx, prep, strings.Repeat("6", 32), func(c context.Context) error { return c.Err() })
	if err != nil {
		t.Fatal("original selection engine", err)
	}
	defer func() {
		cl, cancel := context.WithTimeout(context.Background(), 8*time.Second)
		defer cancel()
		if err := engine.RetireContext(cl); err != nil {
			t.Error("client retirement", err)
		}
	}()
	advertised, err := engine.DiscoverContext(ctx)
	if err != nil || len(advertised.Sources) != 1 || advertised.Sources[0].SourceSHA256 != policy.SourceSHA256() {
		t.Fatal("genuine private discovery", err)
	}
	projection, err := engine.AdoptContext(ctx, policy.SourceSHA256(), int(front.address.Port()))
	if err != nil {
		t.Fatal("genuine discovery adoption", err)
	}
	runtime, err := mobilemultihop.NewNodeChainExecutionRuntime(projection, engine)
	if err != nil {
		t.Fatal("genuine client runtime", err)
	}
	defer func() {
		cl, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		if err := runtime.CloseContext(cl); err != nil {
			t.Error("stop + joined DELETE", err)
		}
	}()
	err = runtime.Run(ctx)
	if privatePosition > 0 && strings.HasPrefix(measure, "wrong-") {
		if err == nil || runtime.Progress().Ready {
			t.Fatal("invalid private stream acquired a ready result")
		}
		return
	}
	if err != nil {
		t.Fatal("native selection under original deadlines", err, runtime.Progress())
	}
	frozen := runtime.Progress()
	if !frozen.Ready || len(frozen.Prefixes) != len(f.members) || frozen.Execution != "local" && frozen.Execution != "server" || mode == "server" && frozen.Execution != "server" {
		t.Fatal("unverified selected result", frozen)
	}
	if awgEntry {
		expected, err := f.members[0].prefix.readback()
		if err != nil {
			t.Fatal("original peer parameter readback", err)
		}
		verifyExtendedClientAWG(t, native, capture.Entry.Tag, capture.Entry.Mode, expected)
	}
	if mode == "auto" {
		if len(frozen.Comparison.Measurements) != 2 || !frozen.Comparison.Measurements[0].Eligible || !frozen.Comparison.Measurements[1].Eligible || winner != "" && frozen.Execution != winner {
			t.Fatal("actual relative latency failed", frozen.Comparison.Measurements, frozen.Execution)
		}
	}
	t.Log("native selected", frozen.Execution, "original nodes", len(f.members))
	if privatePosition > 0 && measure == "response" {
		var candidateReplies atomic.Int32
		input, _, provider := newRoutedPrivateResponsePeer(t, "", func() { candidateReplies.Add(1) })
		defer provider.close()
		inventory := desktopNodeChainJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-private-stream", Inputs: []string{input}})
		packet, err := runtime.NewEntryCandidatePlanContext(ctx, 0, inventory)
		if err != nil || packet.CaptureSHA256() == "" {
			t.Fatal("original packet entry lost its valid candidate inventory", err)
		}
		if remote, err := runtime.NewRemoteCandidatePlanContext(ctx, privatePosition, inventory); err == nil || remote != nil {
			t.Fatal("private stream acquired remote packet candidate authority")
		}
		local, err := runtime.NewLocalCandidatePlanContext(ctx, privatePosition, inventory)
		if mode == "auto" && frozen.Execution == "local" && privatePosition == len(f.members)-2 {
			if err != nil || local == nil || local.CaptureSHA256() == "" {
				t.Fatal("selected private penultimate hop lost its private response plan", err)
			}
		} else if err == nil || local != nil {
			t.Fatal("stream outside the selected private replacement scope acquired a candidate plan")
		}
		if candidateReplies.Load() != 0 {
			t.Fatal("source-only candidate checks opened a private candidate socket")
		}
	}
	var exported *os.Root
	if directory := os.Getenv("ROUTERVPN_EXTENDED_SELECTED_EXPORT"); directory != "" {
		root, err := os.OpenRoot(directory)
		if err != nil {
			t.Fatal(err)
		}
		defer root.Close()
		info, err := root.Stat(".")
		if err != nil || info.Mode().Perm()&0077 != 0 {
			t.Fatal("selected original export requires a private directory")
		}
		name := fmt.Sprintf("%d-%s-%s-%s", len(f.members), mode, winner, measure)
		if measure == "latency" && (first != 1 || last != len(f.members)) {
			name += fmt.Sprintf("-%d-%d", first, last)
		}
		if err := root.Mkdir(name, 0700); err != nil {
			t.Fatal("selected original export requires an unused generation directory", err)
		}
		exported, err = root.OpenRoot(name)
		if err != nil {
			t.Fatal(err)
		}
		defer exported.Close()
	}
	export := func(name, value string) {
		if exported == nil {
			return
		}
		file, err := exported.OpenFile(name, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
		if err != nil {
			t.Fatal(err)
		}
		_, err = file.WriteString(value)
		if err = errors.Join(err, file.Close()); err != nil {
			t.Fatal(err)
		}
	}
	if exported != nil {
		launch, err := f.chain.LaunchInput()
		if err != nil {
			t.Fatal(err)
		}
		export("local-launch.json", launch)
		export("preparation.json", prep.Source())
		export("local-source.json", desktopNodeChainJSON(t, f.source))
	}
	if measure == "reloaded-private-final" || measure == "reloaded-private-intermediate" {
		if mode != "auto" || frozen.Execution != "local" || response == nil {
			t.Fatal("loaded profile lost original requested execution")
		}
		response.proveLoadedApplication(t, ctx, native, runtime, f)
		return
	}
	if response != nil {
		response.run(t, ctx, f, engine, runtime)
		return
	}
	if measure == "" || measure == "drain" {
		if err = runtime.HealthyContext(ctx); err != nil || !reflect.DeepEqual(frozen.Comparison, runtime.Progress().Comparison) {
			t.Fatal("frozen winner changed", err)
		}
		return
	}
	if measure == "mtu" {
		original, err := f.chain.MTUPlan()
		if err != nil {
			t.Fatal(err)
		}
		bound, err := projection.MTUPlan()
		if err != nil || !reflect.DeepEqual(bound, original) || len(bound.Prefixes) != len(f.members) {
			t.Fatal("selected projection changed an original MTU prefix", err)
		}
		if plan, err := projection.PlanForMTU(projection.Config(), bound.Original); err != nil || plan == nil {
			t.Fatal("selected admission lost the original TUN plan", err)
		}
		if plan, err := projection.PlanForMTU(projection.Config(), bound.Ceiling+1); err == nil || plan != nil {
			t.Fatal("foreign TUN limit authorized an extended selected route")
		}
		pause, err := runtime.PauseMTUContext(ctx)
		if err != nil || !pause.OwnsEngine(engine) || pause.ValidateClosedContext(ctx) != nil {
			t.Fatal("selected lease did not join under the original TUN pause", err)
		}
		after, err := pause.MTUPlan()
		if err != nil || !reflect.DeepEqual(after, bound) || pause.TUNTag() != bound.TUNTag || pause.SelectionEpoch() == 0 {
			t.Fatal("original selected MTU plan lost its reader identity", err)
		}
		if other, err := mobilemultihop.NewNodeChainExecutionMTUResumeRuntime(ctx, pause); err == nil || other != nil {
			t.Fatal("an absent native replacement reader acquired MTU resume")
		}
		marker := "FAST_SELECTED_MTU"
		if capture.Entry.Mode == "awg2-strong" {
			marker = "STRONG_SELECTED_MTU"
		}
		t.Logf("%s nodes=%d configured=%d ceiling=%d lease_paused=true missing_reader_refused=true", marker, len(bound.Prefixes), bound.Original, bound.Ceiling)
		return
	}
	owner := &extendedSelectedMeasurement{runtime: runtime}
	m, err := runtime.NewHopMeasurementContext(ctx, owner)
	if err != nil {
		t.Fatal("selected measurement", err)
	}
	defer func() {
		if err := m.Close(); err != nil {
			t.Error(err)
		}
	}()
	binding, err := m.SelectedCaptureContext(ctx)
	if err != nil || f.chain.ValidateMultipleImportedLatencyCapture(binding) != nil {
		t.Fatal("selected original capture", err)
	}
	export("selected.json", binding)
	if measure == "response" {
		checkOriginalOrderedResponse(t, ctx, f, m, binding, frozen.Execution)
	} else if measure == "latency" {
		latency, err := m.NewLatencyBenchmarkContext(ctx, func(c context.Context) error { return c.Err() })
		if err != nil {
			t.Fatal(err)
		}
		defer func() {
			if err := latency.Close(); err != nil {
				t.Error(err)
			}
		}()
		if first < 1 || last > len(f.members) || first > last {
			t.Fatal("invalid original measurement positions")
		}
		for i := first - 1; i < last; i++ {
			proof := frozen.Prefixes[i]
			id := fmt.Sprintf("%032x", i+1)
			before := f.members[i].benchmark.Load()
			if err = latency.StartContext(ctx, id, proof.ProfileID); err != nil {
				t.Fatal(err)
			}
			// The command facade polls the running request before issuing its
			// separate five-second drain. The request retains its own deadline.
			for {
				var observed hopmeasure.Status
				if err := json.Unmarshal([]byte(m.StatusContextJSON(ctx)), &observed); err != nil || ctx.Err() != nil {
					t.Fatal("bounded original fifty-response worker", err, ctx.Err())
				}
				if observed.Request == id && observed.Complete {
					break
				}
				select {
				case <-ctx.Done():
					t.Fatal("bounded original latency", i+1, ctx.Err())
				case <-time.After(250 * time.Millisecond):
				}
			}
			if err = latency.Drain(id); err != nil {
				t.Fatal(err)
			}
			var result hopmeasure.Status
			if json.Unmarshal([]byte(latency.StatusJSON()), &result) != nil || !result.Complete || !result.Drained || len(result.Results) != 1 || !result.Results[0].Ready || f.members[i].benchmark.Load() != before+50 {
				t.Fatal("routed 50 samples", i)
			}
			saved := latency.SavedJSON(proof.ProfileID)
			if saved == "" || saved == "{}" {
				t.Fatal("missing joined fifty-response record", i)
			}
			export(fmt.Sprintf("saved-%d.json", i), saved)
			export(fmt.Sprintf("status-%d.json", i), latency.StatusJSON())
		}
	} else {
		id := strings.Repeat("7", 32)
		if err = m.StartContext(ctx, id, 8<<20); err != nil {
			t.Fatal(err)
		}
		for {
			var state hopmeasure.Status
			if json.Unmarshal([]byte(m.StatusContextJSON(ctx)), &state) != nil || ctx.Err() != nil {
				t.Fatal("bounded measurement", ctx.Err())
			}
			if state.Complete {
				break
			}
			time.Sleep(30 * time.Millisecond)
		}
		if err = m.Drain(id); err != nil {
			t.Fatal(err)
		}
		final, err := m.CompletedThroughputContext(ctx, id, binding, 8<<20)
		if err != nil || len(final.Results) != len(f.members) {
			t.Fatal("selected completed throughput", err, "stage", final.Stage, "rows", len(final.Results))
		}
		export("throughput.json", m.StatusContextJSON(ctx))
		for i, row := range final.Results {
			if !row.Ready || row.Download == nil || row.Upload == nil || row.Download.Bytes != 8<<20 || row.Upload.Bytes != 8<<20 || f.members[i].downBytes.Load() != 8<<20 || f.members[i].upBytes.Load() != 8<<20 {
				t.Fatal("original provider bytes", i)
			}
		}
	}
	after := runtime.Progress()
	if !after.Ready || after.Execution != frozen.Execution || !reflect.DeepEqual(after.Comparison, frozen.Comparison) {
		t.Fatal("frozen winner changed")
	}
}

func checkOriginalOrderedResponse(t *testing.T, ctx context.Context, f *multipleImportedFixture, m *mobilemultihop.NodeChainExecutionMeasurement, original, winner string) {
	t.Helper()
	const samples = 3
	request := strings.Repeat("8", 32)
	before := make([]int64, len(f.members))
	for i, member := range f.members {
		before[i] = int64(member.benchmark.Load())
	}
	if err := m.StartOrderedResponseContext(ctx, request, samples); err != nil {
		t.Fatal("original ordered response start", err)
	}
	joined := false
	defer func() {
		if !joined {
			m.Cancel(request)
			_ = m.Drain(request)
		}
	}()
	deadline := time.NewTimer(hopmeasure.PathResponseTimeout + 2*time.Second)
	defer deadline.Stop()
	for {
		var progress hopmeasure.Status
		if err := json.Unmarshal([]byte(m.StatusContextJSON(ctx)), &progress); err != nil {
			t.Fatal(err)
		}
		if progress.Complete {
			break
		}
		select {
		case <-ctx.Done():
			t.Fatal("native response parent context", ctx.Err())
		case <-deadline.C:
			t.Fatal("original private response worker did not complete")
		case <-time.After(10 * time.Millisecond):
		}
	}
	if err := m.Drain(request); err != nil {
		t.Fatal("original response drain", err)
	}
	joined = true
	final, err := m.CompletedOrderedResponseContext(ctx, request, original, samples)
	if err != nil {
		t.Fatal("original joined response", err)
	}
	for _, changed := range []struct {
		request, capture string
		count            int
	}{
		{strings.Repeat("7", 32), original, samples}, {request, original + " ", samples}, {request, original, samples + 1},
	} {
		if _, err := m.CompletedOrderedResponseContext(ctx, changed.request, changed.capture, changed.count); err == nil {
			t.Fatal("changed request, source or count inherited joined response")
		}
	}
	proofs := f.chain.ProofInventory()
	var endpoints [2]hopmeasure.Hop
	for i, p := range []int{0, len(proofs) - 1} {
		endpoints[i] = hopmeasure.Hop{ID: proofs[p].ProfileID, Kind: "private-node", Label: fmt.Sprintf("Cumulative %s path through node %d of %d", winner, p+1, len(proofs))}
	}
	_, err = hopmeasure.OrderedResponseLatencies(final, request, samples, endpoints)
	if err != nil {
		t.Fatal("original response receipt failed", final.Stage, final.Failure, len(final.Results), err)
	}
	for i, member := range f.members {
		want := before[i]
		if i == 0 || i == len(f.members)-1 {
			want += samples
		}
		if got := int64(member.benchmark.Load()); got != want {
			t.Fatalf("original peer %d response delta %d; want %d", i, got-before[i], want-before[i])
		}
	}
	current, err := m.SelectedCaptureContext(ctx)
	if err != nil || current != original {
		t.Fatal("private response changed captured original generation", err)
	}
	endpoints[1].ID = proofs[1].ProfileID
	if _, err = hopmeasure.OrderedResponseLatencies(final, request, samples, endpoints); err == nil {
		t.Fatal("foreign final hop inherited original responses")
	}
	t.Logf("two retained private endpoints returned %d authenticated original /health responses through %d members; all %d interior counters unchanged", 2*samples, len(f.members), len(f.members)-2)
}

// The challenge server rejects nonce reuse and authenticates the exact
// private NodeID. All candidate sockets use the existing selected Box.
type selectedResponseNativeCase struct {
	fault, input   string
	pairedPosition int
	insertAfter    int
	original       *multipleImportedFixture
	inserted       *multipleImportedMember
	final          routedPrivateResponseFinal
	replacement    *multipleImportedFixture
	app            atomic.Int32
	provider       desktopExternalInstalledSSPeer
	accepted       atomic.Int32
	changed        atomic.Bool
	service        atomic.Pointer[mobilemultihop.NodeChainExecutionCandidateMeasurement]
}

const selectedResponseRequestID = "b923fa87fc1252d3f0c520aeb3786fe8"

func (c *selectedResponseNativeCase) accept() {
	if c.accepted.Add(1) == 50 {
		switch c.fault {
		case "changed-original-suffix":
			last := c.original.members[len(c.original.members)-1]
			last.wrongPrivateID.Store(true)
		case "late-catalog":
			c.changed.Store(true)
		case "late-cancel":
			c.service.Load().Cancel(selectedResponseRequestID)
		}
	}
}

type selectedResponseNativeOwner struct {
	*extendedSelectedMeasurement
	capture string
	fixture *selectedResponseNativeCase
}

func (o *selectedResponseNativeOwner) CandidateInventoryCurrentContext(ctx context.Context, capture string) error {
	if o.capture != capture || o.fixture.changed.Load() {
		return hopmeasure.ErrStale
	}
	if o.fixture.fault == "changed-original-suffix" && o.fixture.accepted.Load() == 50 {
		// Return the genuine challenge within its own probe budget. Hold the
		// unchanged catalog observation while the retained owner's watchdog
		// reads the old exit's foreign identity and revokes the selected path.
		last := o.fixture.original.members[len(o.fixture.original.members)-1]
		tick := time.NewTicker(10 * time.Millisecond)
		defer tick.Stop()
		for !last.sentWrongID.Load() || o.runtime.Progress().Ready {
			select {
			case <-ctx.Done():
				return ctx.Err()
			case <-tick.C:
			}
		}
	}
	return ctx.Err()
}

const selectedPrivateApplication = "203.0.113.197:8181"

func (c *selectedResponseNativeCase) proveLoadedApplication(t *testing.T, ctx context.Context, native *box.Box, runtime *mobilemultihop.NodeChainExecutionRuntime, f *multipleImportedFixture) {
	t.Helper()
	final := f.members[len(f.members)-1]
	dnsOwner := f
	wantBody := "independent measured final"
	if c.insertAfter > 0 {
		dnsOwner = c.original
		wantBody = "retained original final"
		if final != dnsOwner.members[len(dnsOwner.members)-1] || c.inserted.private.Load() == 0 {
			t.Fatal("loaded insertion lost original final or paired hop")
		}
	}
	if f != c.replacement || final.private.Load() == 0 || final.public.Load() == 0 || dnsOwner.dns.Load() == 0 || dnsOwner.invalidDNS.Load() || c.app.Load() != 0 || c.accepted.Load() != 50 {
		t.Fatal("replacement did not prove its own selected identity, DNS and public path")
	}
	gate, found := native.Outbound().Outbound(mobilemultihop.NodeChainExecutionGateTag)
	if !found || gate == nil {
		t.Fatal("missing actual selected application gate")
	}
	transport := &http.Transport{DisableKeepAlives: true, DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
		if network != "tcp" || address != selectedPrivateApplication {
			return nil, errors.New("unexpected application destination")
		}
		return gate.DialContext(ctx, network, M.ParseSocksaddr(address))
	}}
	defer transport.CloseIdleConnections()
	var before []int64
	var finalStreams int64
	if c.insertAfter > 0 {
		before = responsePrefixConnections(f)
		finalStreams = final.provider.stats().Streams
	}
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://"+selectedPrivateApplication+"/adopted", nil)
	if err != nil {
		t.Fatal(err)
	}
	reply, err := (&http.Client{Transport: transport, Timeout: 5 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("unowned application redirect") }}).Do(req)
	if err != nil {
		t.Fatal("application via loaded selected gate", err)
	}
	body, err := io.ReadAll(io.LimitReader(reply.Body, 128))
	err = errors.Join(err, reply.Body.Close())
	if err != nil || reply.StatusCode != 200 || string(body) != wantBody || c.app.Load() != 1 {
		t.Fatal("application did not traverse the selected replacement final", err)
	}
	if c.insertAfter > 0 {
		for i, after := range responsePrefixConnections(f) {
			if after <= before[i] {
				t.Fatal("original application skipped an encrypted prefix, inserted peer or suffix", i)
			}
		}
		if final.provider.stats().Streams <= finalStreams {
			t.Fatal("original application skipped the retained encrypted final")
		}
	}
	if err = runtime.HealthyContext(ctx); err != nil {
		t.Fatal("loaded selected path lost original health", err)
	}
}

// Count original connections at the encrypted entry and each retained SS2022 peer.
func responsePrefixConnections(f *multipleImportedFixture) []int64 {
	counts := make([]int64, len(f.members)-1)
	counts[0] = f.members[0].prefix.handler.tcp.Load()
	for i := 1; i < len(counts); i++ {
		counts[i] = f.members[i].provider.stats().Streams
	}
	return counts
}

func (c *selectedResponseNativeCase) run(t *testing.T, ctx context.Context, f *multipleImportedFixture, engine *box.RouterVPNNodeChainExecutionEngine, runtime *mobilemultihop.NodeChainExecutionRuntime) {
	t.Helper()
	original := runtime.Progress()
	epoch, err := engine.SelectionEpochContext(ctx)
	if err != nil || epoch == 0 || f.dns.Load() == 0 || len(original.Prefixes) != len(f.members) {
		t.Fatal("original selected path lost its DNS, comparison or epoch", err)
	}
	inventory := desktopNodeChainJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-selected-local-private-response", Inputs: []string{c.input}})
	position := len(f.members) - 2
	if c.insertAfter > 0 {
		position = c.insertAfter
	}
	paired := "none"
	proofs := f.chain.ProofInventory()
	if len(proofs) != len(f.members) || len(f.source.IdentitySources) != len(proofs) || proofs[0].Mode != "wg" || proofs[0].NodeID == "" || proofs[len(proofs)-1].Mode != "shadowsocks" || proofs[len(proofs)-1].NodeID == "" {
		t.Fatal("selected response lost the original paired entry or final")
	}
	for i, proof := range proofs {
		if proof.Position != i || proof.StartLayer != "off" {
			t.Fatal("selected response changed an original position or Start Layer", i)
		}
	}
	for i := 1; i < len(f.members)-1; i++ {
		member := f.members[i]
		private := i == c.pairedPosition
		if proofs[i].Mode != "shadowsocks" || member.imported == private || (f.source.IdentitySources[i] != "") != private {
			t.Fatal("selected response changed an original imported or paired stream", i)
		}
		if private {
			if proofs[i].NodeID == "" || proofs[i].Kind != "" || proofs[i].NodeKind != "" || member.private.Load() == 0 {
				t.Fatal("selected route did not prove its original private stream", i)
			}
			paired = strconv.Itoa(i)
		} else if proofs[i].NodeID != "" || proofs[i].Kind != "public-path" || proofs[i].NodeKind != "external" || member.public.Load() == 0 {
			t.Fatal("selected route did not prove its original public prefix", i)
		}
	}
	role := "imported"
	if !f.members[position].imported {
		role = "paired"
	}
	t.Logf("PRIVATE_RESPONSE_SOURCE nodes=%d schema=%d position=%d role=%s paired=%s", len(f.members), f.source.Schema, position, role, paired)
	if grant, err := runtime.NewRemoteCandidatePlanContext(ctx, position, inventory); grant != nil || err == nil {
		t.Fatal("remote connect-only grant accepted a selected stream")
	}
	if c.fault == "suffix-alias" {
		var launch struct {
			Mode, Files, Start string
			Profile            string `json:"profile_json"`
			DNSBootstrap       string `json:"dns_bootstrap"`
		}
		if err := json.Unmarshal([]byte(c.input), &launch); err != nil {
			t.Fatal(err)
		}
		var profile map[string]any
		if err := json.Unmarshal([]byte(launch.Profile), &profile); err != nil {
			t.Fatal(err)
		}
		suffix := proofs[position+1]
		privateID, ok := profile["node_proof_id"].(string)
		if !ok || len(privateID) != 64 || profile["id"] != privateResponsePeerID || suffix.Kind != "public-path" || suffix.ProfileID == "" || suffix.ProfileID == privateResponsePeerID {
			t.Fatal("missing distinct candidate and original suffix")
		}
		for _, proof := range proofs {
			if proof.NodeID == privateID {
				t.Fatal("candidate reused an original private identity", proof.Position)
			}
		}
		profile["id"] = suffix.ProfileID
		alias, err := mobilemultihop.NewNodeProfile(launch.Mode, launch.Files, desktopNodeChainJSON(t, profile), launch.Start, launch.DNSBootstrap)
		if err != nil {
			t.Fatal(err)
		}
		input, err := alias.LaunchInput()
		if err != nil {
			t.Fatal(err)
		}
		aliased := desktopNodeChainJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "untouched-original-suffix", Inputs: []string{input}})
		if original.Execution != "local" {
			t.Fatal("untouched suffix alias lacks real selected Local owner")
		}
		if plan, err := runtime.NewLocalCandidatePlanContext(ctx, position, inventory); err != nil || plan == nil {
			t.Fatal("distinct source candidate failed before suffix alias control", err)
		}
		if plan, err := runtime.NewLocalCandidatePlanContext(ctx, position, aliased); err == nil || plan != nil || c.provider.stats().PhysicalTCP != 0 {
			t.Fatal("unused original suffix ID admitted a private candidate")
		}
		t.Logf("PRIVATE_RESPONSE_SUFFIX_ALIAS position=%d alias=%d distinct_private=true refused=true", position, position+1)
		t.Log("SELECTED_PRIVATE_RESPONSE fault=suffix-alias samples=0 joined=true")
		return
	}
	plan, err := runtime.NewLocalCandidatePlanContext(ctx, position, inventory)
	if c.fault == "server-winner" {
		if original.Execution != "server" || plan != nil || err == nil || c.provider.stats().PhysicalTCP != 0 {
			t.Fatal("Server winner initiated Local private measurement")
		}
		t.Log("SELECTED_PRIVATE_RESPONSE fault=server-winner samples=0 joined=true")
		return
	}
	if original.Execution != "local" || err != nil || plan == nil {
		t.Fatal("original Local winner refused authenticated response", err)
	}
	for i, input := range f.source.Nodes {
		originalInventory := desktopNodeChainJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "existing-member", Inputs: []string{input}})
		if duplicate, err := runtime.NewLocalCandidatePlanContext(ctx, position, originalInventory); err == nil || duplicate != nil {
			t.Fatal("original member admitted as a replacement", i)
		}
	}
	owner := &selectedResponseNativeOwner{&extendedSelectedMeasurement{runtime: runtime}, plan.CaptureSHA256(), c}
	s, err := plan.NewMeasurementContext(ctx, owner)
	if err != nil {
		t.Fatal(err)
	}
	c.service.Store(s)
	defer s.Close()
	before := responsePrefixConnections(f)[:position+1]
	if err = s.StartContext(ctx, selectedResponseRequestID, privateResponsePeerID); err != nil {
		t.Fatal(err)
	}
	var status hopmeasure.CandidateStatus
	for {
		if err := json.Unmarshal([]byte(s.StatusContextJSON(ctx)), &status); err != nil || ctx.Err() != nil {
			t.Fatal("candidate status", err, ctx.Err())
		}
		if status.Complete || status.Stage == "draining" {
			break
		}
		select {
		case <-ctx.Done():
			t.Fatal(ctx.Err())
		case <-time.After(25 * time.Millisecond):
		}
	}
	if err = s.Drain(selectedResponseRequestID); err != nil {
		t.Fatal("original socket join", err)
	}
	if err = json.Unmarshal([]byte(s.StatusContextJSON(ctx)), &status); err != nil || !status.Drained || owner.active.Load() {
		t.Fatal("candidate did not join", err, status)
	}
	samples := 0
	if c.fault == "original" {
		if !status.Complete || status.Failure != "" || len(status.Results) != 1 {
			t.Fatal("missing private response receipt", status)
		}
		row := status.Results[0]
		if !row.Ready || row.Kind != "private-agent-response" || row.Benchmark == nil || row.Benchmark.Measurement != hopmeasure.CandidatePrivateResponseMeasurement || row.Benchmark.Attempts != 50 || row.Benchmark.Failed != 0 || row.Benchmark.Distribution == nil || row.Benchmark.Distribution.Samples != 50 || c.accepted.Load() != 50 || c.provider.stats().Streams != 50 {
			t.Fatal("fresh responses did not traverse both exact ciphers", status, c.accepted.Load())
		}
		for i, after := range responsePrefixConnections(f)[:position+1] {
			if after-before[i] < 50 {
				t.Fatal("private responses skipped an original encrypted prefix", i, after-before[i])
			}
		}
		t.Logf("PRIVATE_RESPONSE_PREFIX nodes=%d position=%d prefixes=%d authenticated=50", len(f.members), position, len(before))
		samples = 50
	} else {
		for _, row := range status.Results {
			if row.Ready || row.Benchmark != nil {
				t.Fatal("revoked or invalid response scored", status)
			}
		}
		peer := c.provider.stats()
		switch c.fault {
		case "wrong-candidate-key":
			if peer.AuthTCP == 0 || peer.Streams != 0 || c.accepted.Load() != 0 {
				t.Fatal("wrong cipher did not reach its original verifier", peer)
			}
		case "forged-response", "wrong-private-id":
			if c.accepted.Load() == 0 || peer.Streams == 0 {
				t.Fatal("forged response did not reach the authenticated private peer")
			}
		case "changed-original-suffix":
			if c.accepted.Load() != 50 || !f.members[len(f.members)-1].sentWrongID.Load() || runtime.Progress().Ready || len(status.Results) != 0 {
				t.Fatal("response survived changed retained suffix", status)
			}
			t.Logf("PRIVATE_RESPONSE_CHANGED_SUFFIX position=%d final=%d accepted=50 ready=false joined=true", position, len(f.members)-1)
		case "late-catalog", "late-cancel":
			if c.accepted.Load() != 50 || len(status.Results) != 0 {
				t.Fatal("revoked final sample survived", status, c.accepted.Load())
			}
		default:
			t.Fatal("unknown response refusal", c.fault)
		}
	}
	after, err := engine.SelectionEpochContext(ctx)
	if c.fault != "changed-original-suffix" && (err != nil || after != epoch || runtime.Progress().Execution != original.Execution || !reflect.DeepEqual(runtime.Progress().Comparison, original.Comparison)) {
		t.Fatal("original selection changed", err)
	}
	if err := s.CloseContext(ctx); err != nil {
		t.Fatal("incomplete measurement retirement", err)
	}
	t.Logf("SELECTED_PRIVATE_RESPONSE fault=%s samples=%d joined=true", c.fault, samples)
}
