func (f *multipleImportedFixture) close() error {
	if f.closed {
		return nil
	}
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	var err error
	if f.chain != nil {
		err = f.chain.CloseContext(ctx)
	}
	f.retired.Store(true)
	if f.native != nil {
		err = errors.Join(err, f.native.Close())
	}
	f.cancel()
	for _, member := range f.members {
		if member != nil && member.close != nil {
			member.close()
		}
	}
	f.closed = true
	return err
}

// Each independent TCP peer counts the exact bytes it served or received.
// Wire names, credentials and nonce shape must match that peer's original role.
func (m *multipleImportedMember) serveThroughput(w http.ResponseWriter, r *http.Request, host, token string) bool {
	const size = 8 << 20
	if r.Host != host || r.Header.Get("Cache-Control") != "no-store, no-transform" || r.Header.Get("Accept-Encoding") != "identity" {
		return false
	}
	downPath, upPath := "/api/benchmark/download", "/api/benchmark/upload"
	query := r.URL.Query()
	if token == "" {
		if !m.imported || r.Header.Get("Authorization") != "" || len(query.Get("routervpn")) != 32 {
			return false
		}
		if _, err := hex.DecodeString(query.Get("routervpn")); err != nil {
			return false
		}
		query.Del("routervpn")
		downPath, upPath = "/__down", "/__up"
	} else if m.imported || r.Header.Get("Authorization") != "Bearer "+token {
		return false
	}
	download := r.Method == http.MethodGet && r.URL.Path == downPath && len(query) == 1 && query.Get("bytes") == strconv.Itoa(size) && r.ContentLength == 0
	upload := r.Method == http.MethodPost && r.URL.Path == upPath && len(query) == 0 && r.ContentLength == size
	if !download && !upload {
		return false
	}
	// The shared proof server limits tiny HTTP exchanges to three seconds.
	// For validated benchmark requests, match hopmeasure's per-transfer budget.
	budget := 20 * time.Second
	if m.imported {
		budget = 30 * time.Second
	}
	deadline := time.Now().Add(budget)
	controller := http.NewResponseController(w)
	if controller.SetReadDeadline(deadline) != nil || controller.SetWriteDeadline(deadline) != nil {
		http.Error(w, "benchmark deadline unavailable", http.StatusInternalServerError)
		return true
	}
	if download {
		w.Header().Set("Content-Length", strconv.Itoa(size))
		w.Header().Set("Content-Type", "application/octet-stream")
		if token != "" {
			w.Header().Set("X-Routervpn-Benchmark", "download-v1")
			w.Header().Set("X-Routervpn-Benchmark-Bytes", strconv.Itoa(size))
		}
		n, _ := io.CopyN(w, rand.Reader, size)
		m.downBytes.Add(n)
	} else {
		n, err := io.Copy(io.Discard, io.LimitReader(r.Body, size+1))
		m.upBytes.Add(n)
		if err != nil || n != size {
			http.Error(w, "incomplete original upload", http.StatusBadRequest)
		} else if token != "" {
			_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "direction": "upload", "bytes": n, "peer": "captured",
				"server_receive_ms": 1, "proof": "authenticated tunnel-peer private throughput sink"})
		} else {
			w.Header().Set("Content-Length", "0")
		}
	}
	return true
}

func (f *multipleImportedFixture) publicServer(t *testing.T, member *multipleImportedMember, certificate *tls.Certificate) string {
	t.Helper()
	return desktopImportedWGSSHTTP(t, certificate, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if member.serveThroughput(w, r, hopmeasure.PublicHost, "") {
			return
		}
		if r.Method != http.MethodGet || r.Header.Get("Authorization") != "" || r.ContentLength > 0 || len(r.TransferEncoding) != 0 {
			http.Error(w, "unowned public request", 403)
			return
		}
		if (r.Host == "1.1.1.1" || r.Host == "1.0.0.1" && member.position == len(f.members)-1) && r.URL.Path == "/cdn-cgi/trace" && len(r.URL.Query()) == 1 && len(r.URL.Query().Get("routervpn_proof")) == 32 {
			member.public.Add(1)
			if member.held.Load() {
				select {
				case member.entered <- struct{}{}:
				default:
				}
				<-r.Context().Done()
				return
			}
			address := member.publicIP
			if member.wrong.Load() {
				address = "203.0.113.250"
			}
			if member.invalidTrace.Load() {
				address = "127.0.0.1"
			}
			fmt.Fprintf(w, "ip=%s\n", address)
			return
		}
		if member.imported && r.Host == hopmeasure.PublicHost && r.URL.Path == "/__down" && len(r.URL.Query()) == 2 && r.URL.Query().Get("bytes") == "1" && len(r.URL.Query().Get("routervpn")) == 32 && r.Header.Get("Cache-Control") == "no-store, no-transform" {
			member.benchmark.Add(1)
			w.Header().Set("Content-Length", "1")
			w.Header().Set("Content-Type", "application/octet-stream")
			_, _ = w.Write([]byte{'x'})
			return
		}
		if member.imported && r.Host == hopmeasure.PublicHost && r.URL.Path == "/original-position" && r.URL.RawQuery == "" {
			member.benchmark.Add(1)
			fmt.Fprintf(w, "position=%d\n", member.position)
			return
		}
		http.NotFound(w, r)
	}))
}

func (f *multipleImportedFixture) privateServer(t *testing.T, member *multipleImportedMember, host, token, nodeID string) string {
	t.Helper()
	return desktopImportedWGSSHTTP(t, nil, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if member.serveThroughput(w, r, host, token) {
			return
		}
		if r.Method != http.MethodGet || r.Host != host || r.URL.Path != "/health" || r.URL.RawQuery != "" || r.Header.Get("Authorization") != "Bearer "+token || r.ContentLength > 0 || len(r.TransferEncoding) != 0 {
			http.Error(w, "unowned private request", 403)
			return
		}
		member.private.Add(1)
		if r.Header.Get("Cache-Control") == "no-store, no-transform" && r.Header.Get("Accept-Encoding") == "identity" {
			member.benchmark.Add(1)
		}
		actualID := nodeID
		if member.wrong.Load() {
			actualID = strings.Repeat("f", 64)
		}
		_ = json.NewEncoder(w).Encode(desktopImportedWGSSHealthReply{true, actualID, "router-vpn-private-agent-v1"})
	}))
}

func (f *multipleImportedFixture) dnsServer(t *testing.T) string {
	t.Helper()
	packet, err := net.ListenPacket("udp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	started, joined := make(chan struct{}), make(chan error, 1)
	server := &dns.Server{PacketConn: packet, NotifyStartedFunc: func() { close(started) }, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
		f.dns.Add(1)
		answer := new(dns.Msg).SetReply(q)
		valid := !q.Response && q.Opcode == dns.OpcodeQuery && len(q.Question) == 1 && len(q.Answer) == 0 && len(q.Ns) == 0
		if len(q.Extra) > 1 || len(q.Extra) == 1 && q.Extra[0].Header().Rrtype != dns.TypeOPT {
			valid = false
		}
		if valid {
			question := q.Question[0]
			valid = question.Qclass == dns.ClassINET && (question.Name == "example.com." || question.Name == hopmeasure.PublicHost+".") && (question.Qtype == dns.TypeA || question.Qtype == dns.TypeAAAA)
		}
		if !valid {
			f.invalidDNS.Store(true)
			answer.Rcode = dns.RcodeRefused
		} else {
			question := q.Question[0]
			if question.Name == hopmeasure.PublicHost+"." {
				f.publicDNS.Add(1)
			}
			if f.badDNS.Load() {
				answer.Rcode = dns.RcodeNameError
			} else if question.Qtype == dns.TypeA {
				answer.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: question.Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 0}, A: net.ParseIP("93.184.216.34")}}
			}
		}
		if err := w.WriteMsg(answer); err != nil {
			f.invalidDNS.Store(true)
		}
	})}
	go func() { joined <- server.ActivateAndServe() }()
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
		defer cancel()
		err := server.ShutdownContext(ctx)
		_ = packet.Close()
		select {
		case runErr := <-joined:
			if err != nil || runErr != nil {
				t.Error("selected DNS did not join", err, runErr)
			}
		case <-ctx.Done():
			t.Error("selected DNS join", ctx.Err())
		}
	})
	select {
	case <-started:
	case <-time.After(2 * time.Second):
		t.Fatal("selected DNS did not start")
	}
	return packet.LocalAddr().String()
}

const mixedLocalHostname = "Mixed.ordered-routervpn.test"

type multipleImportedHostname struct {
	cached   bool
	aQueries atomic.Int32
	position int
	queries  atomic.Int32
	collide  atomic.Bool
	nxdomain bool
}

func (h *multipleImportedHostname) start(t *testing.T) string {
	t.Helper()
	l, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	started := make(chan struct{})
	s := &dns.Server{Listener: l, NotifyStartedFunc: func() { close(started) }, Handler: dns.HandlerFunc(func(w dns.ResponseWriter, q *dns.Msg) {
		if len(q.Question) != 1 || !strings.EqualFold(q.Question[0].Name, mixedLocalHostname+".") {
			t.Error("unowned transport lookup")
			return
		}
		h.queries.Add(1)
		answer := new(dns.Msg).SetReply(q)
		name := "answer.ordered-routervpn.test."
		if h.nxdomain {
			answer.Rcode = dns.RcodeNameError
		} else if q.Question[0].Qtype == dns.TypeA {
			h.aQueries.Add(1)
			var ttl uint32
			if h.cached {
				ttl = 300
			}
			answer.Answer = []dns.RR{
				&dns.CNAME{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeCNAME, Class: dns.ClassINET, Ttl: ttl}, Target: name},
				&dns.A{Hdr: dns.RR_Header{Name: name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: ttl}, A: net.ParseIP(fmt.Sprintf("198.51.100.%d", 150+h.position))},
			}
			if h.collide.Load() {
				answer.Answer = append(answer.Answer, &dns.A{Hdr: dns.RR_Header{Name: name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 0}, A: net.ParseIP("10.77.0.1")})
			}
		}
		_ = w.WriteMsg(answer)
	})}
	done := make(chan error, 1)
	go func() { done <- s.ActivateAndServe() }()
	t.Cleanup(func() {
		_ = s.Shutdown()
		if err := <-done; err != nil {
			t.Error(err)
		}
	})
	select {
	case <-started:
	case <-time.After(2 * time.Second):
		t.Fatal("saved transport DNS did not start")
	}
	return l.Addr().String()
}

func multipleImportedInput(t *testing.T, member *multipleImportedMember, password string, hostname ...string) string {
	t.Helper()
	socket := netip.MustParseAddrPort(member.virtual)
	host, port := socket.Addr().String(), int(socket.Port())
	if len(hostname) == 1 {
		host = hostname[0]
	}
	id := fmt.Sprintf("native-independent-import-%d", member.position)
	method := mobilemultihop.NativeStartLayerMethod
	graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "interface_name": "router-vpn", "address": []string{"172.29.91.1/30", "fd29:91::1/126"}, "mtu": 1280, "auto_route": true, "strict_route": true, "stack": "system"}}, "endpoints": []any{}, "outbounds": []any{map[string]any{"type": "shadowsocks", "tag": mobilemultihop.ExternalFinalTag, "server": host, "server_port": port, "method": method, "password": password}}, "route": map[string]any{"final": mobilemultihop.ExternalFinalTag, "rules": []any{}, "auto_detect_interface": true}}
	profile := map[string]any{"id": id, "node_kind": "external", "endpoint": host, "external": map[string]any{"protocol": "shadowsocks", "expected_public_ip": member.publicIP, "shadowsocks": map[string]any{"server": host, "port": port, "method": method, "password": password}}, "dns_mode": "home", "start_layer": "off", "mtu_policy": "auto", "ipv6_mode": "on", "home_lan_access": false, "kill_switch_policy": "on-connect"}
	if len(hostname) == 1 {
		profile["dns_mode"], profile["dns_protocol"], profile["dns_host"], profile["dns_port"] = "custom", "tcp", "10.78.0.53", 5353
	}
	capture := map[string]any{"schema": 1, "exit_id": id, "protocol": "shadowsocks", "expected_public_ip": member.publicIP, "profile": profile}
