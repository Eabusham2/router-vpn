			}
			routes = append(routes, desktopNodeLayerRoute{"udp", next.virtual, next.physical})
		}
		if member.imported || privateStreams[position] || position == layout.count-1 {
			public := f.publicServer(t, member, &certificate)
			routes = append(routes, desktopNodeLayerRoute{"tcp", "1.1.1.1:443", public})
			if position == layout.count-1 && wrap != nil {
				routes = append(routes, desktopNodeLayerRoute{"tcp", "1.0.0.1:443", public})
			}
			if member.imported {
				routes = append(routes, desktopNodeLayerRoute{"tcp", "93.184.216.34:443", public})
			}
			if privateStreams[position] {
				identity := request.Prefixes[position]
				inner, _ := desktopNodeChainInner(position, len(request.Prefixes))
				target := net.JoinHostPort(inner, "8787")
				private := f.privateServer(t, member, target, identity.APIToken, identity.NodeProofID)
				routes = append(routes, desktopNodeLayerRoute{"tcp", target, private})
			}
			if position == layout.count-1 {
				private := f.privateServer(t, member, desktopNodeRouterHealthTarget, request.FinalAPIToken, request.FinalNodeProofID)
				routes = append(routes, desktopNodeLayerRoute{"tcp", desktopNodeRouterHealthTarget, private}, desktopNodeLayerRoute{"udp", "192.168.50.133:53", dnsAddress})
			}
			owned, finish := context.WithCancel(ctx)
			member.layer = &desktopNodeLayerServer{ctx: owned, cancel: finish, routes: routes, connections: map[io.Closer]bool{}}
			if position == layout.count-1 && finalLayer != "off" {
				kind := "shadowsocks"
				if finalLayer == "aes-256-gcm+xor-whitening" {
					kind = "routervpn-aes-xor"
				}
				member.provider = desktopImportedSOCKSLayerProvider(t, member.layer, map[string]any{"type": kind, "password": member.key}, fault)
			} else {
				address := loopback
				if layout.name == "selected-private-stream" && position == 1 {
					address = netip.MustParseAddr("198.51.100.151")
				}
				member.provider = desktopStartSSProvider(t, member.layer, mobilemultihop.NativeStartLayerMethod, member.key, address)
				if address != loopback {
					member.virtual = member.provider.address
				}
			}
			member.physical, member.close = member.provider.address, member.provider.close
			continue
		}
		identity := request.Prefixes[position]
		inner, _ := desktopNodeChainInner(position, len(request.Prefixes))
		target := net.JoinHostPort(inner, "8787")
		private := f.privateServer(t, member, target, identity.APIToken, identity.NodeProofID)
		rules := map[string]desktopReferenceRule{"tcp/" + target: {Network: "tcp", Address: inner, Port: 8787, Target: private}}
		for _, route := range routes {
			socket := netip.MustParseAddrPort(route.Destination)
			rules[route.Network+"/"+route.Destination] = desktopReferenceRule{Network: route.Network, Address: socket.Addr().String(), Port: int(socket.Port()), Target: route.Physical}
		}
		owned, finish := context.WithCancel(ctx)
		prefix := &desktopNodeChainPrefixPeer{handler: &desktopNodeWGHandler{desktopReferenceHandler: &desktopReferenceHandler{ctx: owned, cancel: finish, rules: rules, owned: map[io.Closer]bool{}}}, bind: &desktopNodeWGBind{local: loopback, remote: loopback}}
		member.prefix = prefix
		var handler tun.Handler = prefix.handler
		if position == 0 && wrap != nil {
			handler = wrap(handler)
		}
		stack, err := wg.NewDevice(wg.DeviceOptions{Context: owned, Logger: log.NewNOPFactory().Logger(), Handler: handler, UDPTimeout: 5 * time.Second, ICMPTimeout: time.Second, MTU: 2000, Address: []netip.Prefix{netip.MustParsePrefix(inner + "/32"), netip.MustParsePrefix("fd78:78::1/128")}})
		if err != nil {
			prefix.handler.close()
			t.Fatal(err)
		}
		device, err := desktopNodeChainPrefixFactory(t, identity, prefix)(owned, stack, prefix.bind, ipcs[position])
		ipcs[position] = ""
		if err != nil {
			prefix.handler.close()
			t.Fatal(err)
		}
		member.physical = prefix.bind.address()
		member.close = func() { prefix.handler.close(); device.close() }
	}
	first := netip.MustParseAddrPort(f.members[0].physical)
	physical := net.JoinHostPort(request.Address, strconv.Itoa(int(first.Port())))
	f.source = desktopNodeChainPeerSourceInput(t, request, clients, physical)
	f.source.Schema = 6
	if imported[0] {
		f.source.Schema = 7
		physical = f.members[0].virtual
	}
	f.source.IdentitySources = make([]string, layout.count)
	for position := 0; position < layout.count-1; position++ {
		member := f.members[position]
		if member.imported {
			password := member.key
			if fault == fmt.Sprintf("wrong-key-%d", position) {
				password = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{251}, 32))
			}
			if host != nil && host.position == position {
				f.source.Nodes[position] = multipleImportedInput(t, member, password, mixedLocalHostname)
			} else {
				f.source.Nodes[position] = multipleImportedInput(t, member, password)
			}
		} else {
			prefix := request.Prefixes[position]
			raw, _ := base64.StdEncoding.DecodeString(prefix.PrivateKey)
			server, e := ecdh.X25519().NewPrivateKey(raw)
			clear(raw)
			if e != nil {
				t.Fatal(e)
			}
			_, client := desktopNodeChainInner(position, len(request.Prefixes))
			target := member.virtual
			if position == 0 {
				target = physical
			}
			text := fmt.Sprintf("[Interface]\nAddress=%s/32,fd78:78::2/128\nPrivateKey=%s\nDNS=192.168.50.133\nMTU=2000\n[Peer]\nPublicKey=%s\nPresharedKey=%s\nEndpoint=%s\nAllowedIPs=0.0.0.0/0,::/0\nPersistentKeepalive=25\n", client, clients[position], base64.StdEncoding.EncodeToString(server.PublicKey().Bytes()), prefix.PreSharedKey, target)
			f.source.IdentitySources[position] = desktopNodeChainJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(text))})
			if privateStreams[position] {
				// Keep the paired identity and API, changing only its transport
				// to its own literal SS2022 peer and independently captured key.
				var launch struct {
					Profile string `json:"profile_json"`
				}
				var profile map[string]any
				if json.Unmarshal([]byte(f.source.Nodes[position]), &launch) != nil || json.Unmarshal([]byte(launch.Profile), &profile) != nil {
					t.Fatal("original paired intermediate profile missing")
				}
				socket := netip.MustParseAddrPort(member.virtual)
				profile["endpoint"] = socket.Addr().String()
				key := member.key
				if fault == "wrong-interior-key" || fault == fmt.Sprintf("wrong-paired-%d", position) {
					key = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{241}, 32))
				}
				graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "auto_route": true, "strict_route": true}}, "outbounds": []any{map[string]any{"type": "shadowsocks", "tag": "proxy", "server": socket.Addr().String(), "server_port": socket.Port(), "method": mobilemultihop.NativeStartLayerMethod, "password": key}}, "route": map[string]any{"final": "proxy", "rules": []any{}}}
				files := map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString([]byte(desktopNodeChainJSON(t, graph)))}
				n, err := mobilemultihop.NewNodeProfile("shadowsocks", desktopNodeChainJSON(t, files), desktopNodeChainJSON(t, profile), "", "")
				if err != nil {
					t.Fatal("paired intermediate source", err)
				}
				f.source.Nodes[position], err = n.LaunchInput()
				if err != nil {
					t.Fatal(err)
				}
			}
		}
	}
	f.source.IdentitySources[layout.count-1] = finalIdentity
	if finalLayer != "off" {
		if finalLayer != "aes-256-gcm" && finalLayer != "aes-256-gcm+xor-whitening" {
			t.Fatal("unowned final Start Layer")
		}
		var input, profile map[string]any
		if json.Unmarshal([]byte(f.source.Nodes[layout.count-1]), &input) != nil || json.Unmarshal([]byte(input["profile_json"].(string)), &profile) != nil {
			t.Fatal("original final profile missing")
		}
		profile["start_layer"] = finalLayer
		final, err := mobilemultihop.NewNodeProfile(input["mode"].(string), input["files"].(string), desktopNodeChainJSON(t, profile), input["start"].(string), input["dns_bootstrap"].(string))
		if err != nil {
			t.Fatal("original independent final Start Layer", err)
		}
		f.source.Nodes[layout.count-1], err = final.LaunchInput()
		if err != nil {
			t.Fatal(err)
		}
	}
	f.chain, err = mobilemultihop.NewNodeChain(desktopNodeChainJSON(t, f.source))
	if err != nil {
		t.Fatal("complete original multiple-import source", err)
	}
	field := reflect.ValueOf(f.chain).Elem().FieldByName("runtime").FieldByName("testTLS")
	*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.tls.Clone()
	for _, position := range layout.imports {
		if fault == fmt.Sprintf("wrong-public-%d", position) {
			f.members[position].wrong.Store(true)
		}
	}
	if fault == "wrong-final" {
		f.members[layout.count-1].wrong.Store(true)
	}
	if fault == "selected-dns" {
		f.badDNS.Store(true)
	}
	f.physical = physical
	if len(candidate) == 0 || !candidate[0].closed {
		f.startBox(t, physical)
	}
	// Register after all provider/server cleanup hooks so proof and client Box
	// retirement always joins before the reference transports are dismantled.
	t.Cleanup(func() {
		if err := f.close(); err != nil {
			t.Error("complete original native path did not join", err)
		}
	})
	return f
}

func (f *multipleImportedFixture) startBox(t *testing.T, physical string, closed ...*mobilemultihop.NodeChainCandidatePreparation) {
	t.Helper()
	ins, outs, ends := inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry()
	WHT.RegisterOutbound(outs)
	config := f.chain.Config()
	if len(closed) == 1 {
		config = closed[0].Config()
		G.RegisterOutbound(outs)
	}
	group.RegisterSelector(outs)
	inbound.Register[option.TunInboundOptions](ins, "tun", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
		return &multipleImportedTUN{inbound.NewAdapter("tun", tag)}, nil
	})
	firstTag := f.chain.PrefixTags()[0]
	physicalContext := func(ctx context.Context, tag, detour string) (context.Context, bool, error) {
		if tag != firstTag {
			if detour == "" {
				return nil, false, errors.New("later native member escaped its predecessor")
			}
			return ctx, false, nil
		}
		if detour != "" {
			return nil, false, errors.New("first physical member has an unowned detour")
		}
		ctx = service.ExtendContext(ctx)
		lower := &desktopSSReferenceLower{virtual: physical, original: f.members[0].physical}
		ctx = service.ContextWith[adapter.OutboundManager](ctx, &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}})
		ctx = service.ContextWith[adapter.NetworkManager](ctx, &desktopImportedPacketNetwork{})
		return ctx, true, nil
	}
	if f.members[0].imported {
		outbound.Register[option.ShadowsocksOutboundOptions](outs, "shadowsocks", func(ctx context.Context, r adapter.Router, l log.ContextLogger, tag string, o option.ShadowsocksOutboundOptions) (adapter.Outbound, error) {
			owned, first, err := physicalContext(ctx, tag, o.Detour)
			if err != nil {
				return nil, err
			}
			if first {
				o.Detour = "captured-physical"
			}
			actual, err := SS.NewOutbound(owned, r, l, tag, o)
			if err != nil || !first {
				return actual, err
			}
			return &multipleImportedPhysicalSS{actual.(*SS.Outbound)}, nil
		})
	} else {
		SS.RegisterOutbound(outs)
	}
	endpoint.Register[option.WireGuardEndpointOptions](ends, "wireguard", func(ctx context.Context, r adapter.Router, l log.ContextLogger, tag string, o option.WireGuardEndpointOptions) (adapter.Endpoint, error) {
		owned, first, err := physicalContext(ctx, tag, o.Detour)
		if err != nil {
			return nil, err
		}
		if first {
			o.Detour = "captured-physical"
		}
		actual, err := WG.NewEndpoint(owned, r, l, tag, o)
		if err != nil {
			return nil, err
		}
		if first {
			return &multipleImportedPhysical{actual}, nil
		}
		return actual, nil
	})
	endpoint.Register[Options](ends, mobilemultihop.AmneziaType, func(ctx context.Context, r adapter.Router, l log.ContextLogger, tag string, o Options) (adapter.Endpoint, error) {
		owned, first, err := physicalContext(ctx, tag, o.Detour)
		if err != nil {
			return nil, err
		}
		if first {
			o.Detour = "captured-physical"
		}
		actual, err := NewEndpoint(owned, r, l, tag, o)
		if err != nil {
			return nil, err
		}
		if first {
			return &multipleImportedPhysical{actual}, nil
		}
		return actual, nil
	})
	transports := BDNS.NewTransportRegistry()
	DNST.RegisterUDP(transports)
	DNST.RegisterTCP(transports)
	ctx := service.ContextWith[adapter.PlatformInterface](f.ctx, &multipleImportedPlatform{})
	ctx = box.Context(ctx, ins, outs, ends, transports, boxService.NewRegistry(), certificate.NewRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(config))
	if err != nil {
		t.Fatal(err)
	}
	f.native, err = box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal("actual ordinary Box", err)
	}
	if err = f.native.Start(); err != nil {
		t.Fatal("actual ordinary Box start", err)
	}
	if len(closed) == 1 {
		return
	}
	f.engine, err = f.native.RouterVPNNewNodeChainEngine(f.ctx, f.chain, strings.Repeat("a", 32), func(ctx context.Context) error {
		if f.retired.Load() {
			return errors.New("original outer owner retired")
		}
		return ctx.Err()
	})
	if err != nil {
		t.Fatal("actual original Box engine", err)
	}
}

func (f *multipleImportedFixture) prove(t *testing.T) {
	t.Helper()
	if f.chain.Progress().Ready {
		t.Fatal("source invented readiness")
	}
	if err := f.chain.Run(f.ctx, f.engine); err != nil {
		t.Fatal("complete original encrypted path", err)
	}
	progress := f.chain.Progress()
	if !progress.Ready || !progress.DNSProven || !progress.PublicProven || len(progress.Prefixes) != len(f.members) || f.dns.Load() == 0 || f.invalidDNS.Load() {
		t.Fatal("complete original proof inventory missing", progress)
	}
	for position, member := range f.members {
		if progress.Prefixes[position].Position != position {
			t.Fatal("original proof position changed")
		}
		if member.imported {
			if member.public.Load() == 0 || member.private.Load() != 0 || member.layer.rawTCP.Load() == 0 || progress.Prefixes[position].Kind != "public-path" {
				t.Fatal("import did not prove its own encrypted public identity", position)
			}
		} else if member.private.Load() == 0 {
			t.Fatal("paired position skipped original private proof", position)
		}
	}
	if err := f.chain.HealthyContext(f.ctx); err != nil {
		t.Fatal("original native Healthy", err)
	}
}

func (f *multipleImportedFixture) publicRoute(t *testing.T, position int) {
	t.Helper()
	before := make([]uint64, len(f.members))
	for i, m := range f.members {
		before[i] = m.benchmark.Load()
	}
	beforeDNS := f.publicDNS.Load()
	tag := f.chain.PrefixTags()[position]
	transport := &http.Transport{Proxy: nil, ForceAttemptHTTP2: false, DisableKeepAlives: true, TLSClientConfig: f.tls.Clone(), DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
		if network != "tcp" || address != hopmeasure.PublicAddress {
			return nil, errors.New("foreign public measurement tuple")
		}
		return f.engine.Dial(ctx, tag, address)
	}}
	defer transport.CloseIdleConnections()
	request, err := http.NewRequestWithContext(f.ctx, http.MethodGet, "https://"+hopmeasure.PublicHost+"/original-position", nil)
	if err != nil {
		t.Fatal(err)
	}
	response, err := (&http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("unowned redirect") }}).Do(request)
	if err != nil {
		t.Fatal("original imported public route", position, err)
	}
	body, readErr := io.ReadAll(io.LimitReader(response.Body, 128))
	closeErr := response.Body.Close()
	if readErr != nil || closeErr != nil || response.StatusCode != 200 || string(body) != fmt.Sprintf("position=%d\n", position) || f.publicDNS.Load() <= beforeDNS {
		t.Fatal("public route substituted original source or selected DNS", position, readErr, closeErr, string(body))
	}
	for i, m := range f.members {
		want := before[i]
		if i == position {
			want++
		}
		if m.benchmark.Load() != want {
			t.Fatal("one imported source borrowed another public response", position, i)
		}
	}
}

func TestRouterVPNMultipleImportedEncryptedLocal(t *testing.T) {
	for _, layer := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
		t.Run("custom-entry_"+layer, func(t *testing.T) {
			f := newMultipleImportedFixture(t, multipleImportedLayout{"custom-entry", 3, []int{0, 1}}, "wg", layer, "")
			f.prove(t)
			for _, position := range []int{0, 1} {
				f.publicRoute(t, position)
				stats := f.members[position].provider.stats()
				if stats.PhysicalTCP == 0 || stats.PhysicalUDP == 0 {
					t.Fatal("actual original SS2022 provider omitted TCP or selected DNS datagrams", position)
				}
			}
			if _, err := f.engine.Dial(f.ctx, f.chain.FinalTag(), hopmeasure.PublicAddress); err == nil {
				t.Fatal("paired final borrowed a custom public benchmark route")
			}
			if err := f.close(); err != nil {
				t.Fatal("custom-entry native retirement did not join", err)
			}
			if c, err := f.engine.Dial(context.Background(), f.chain.PrefixTags()[0], hopmeasure.PublicAddress); err == nil || c != nil {
				t.Fatal("retired first custom route retained public proof authority")
			}
		})
	}
	for _, mode := range []string{"wg", "awg2-fast", "awg2-strong"} {
		for _, layout := range multipleImportedLayouts {
			if layout.count > 8 && mode != "wg" {
				continue
			}
			layers := []string{"off"}
			if layout.name == "adjacent" || layout.name == "maximum-sparse" {
				layers = append(layers, "aes-256-gcm", "aes-256-gcm+xor-whitening")
			}
			for _, layer := range layers {
				t.Run(mode+"_"+layout.name+"_"+layer, func(t *testing.T) {
					f := newMultipleImportedFixture(t, layout, mode, layer, "")
					f.prove(t)
					captured, _, err := f.chain.PublicMeasurementCaptures()
					if err != nil || len(captured) != len(layout.imports) {
						t.Fatal("complete plural native capture", err)
					}
					for i, position := range layout.imports {
						if captured[i].Position != position || captured[i].Tag != f.chain.PrefixTags()[position] {
							t.Fatal("original imported position changed")
						}
						f.publicRoute(t, position)
					}
					if layout.count > 8 {
						f.verifyOrderedLatencyHistory(t)
					}
					if _, err := f.engine.Dial(f.ctx, f.chain.PrefixTags()[0], hopmeasure.PublicAddress); err == nil {
						t.Fatal("paired prefix borrowed imported public authority")
					}
					if err := f.close(); err != nil {
						t.Fatal("joined original native retirement", err)
					}
					if _, err := f.engine.Dial(context.Background(), captured[0].Tag, hopmeasure.PublicAddress); err == nil {
						t.Fatal("retired native path regained public authority")
					}
					t.Logf("MULTIPLE_IMPORTED_NATIVE count=%d imports=%v ready=true dns=%d public_dns=%d joined=true", layout.count, layout.imports, f.dns.Load(), f.publicDNS.Load())
				})
			}
		}
	}
}

func TestRouterVPNMultipleImportedEncryptedRefusals(t *testing.T) {
	extendedImportedLateKeys(t)
	for _, fault := range []string{"wrong-key-0", "wrong-public-0", "wrong-key-1", "wrong-public-1", "wrong-final", "selected-dns"} {
		t.Run("custom-entry_"+fault, func(t *testing.T) {
			f := newMultipleImportedFixture(t, multipleImportedLayout{"custom-entry", 3, []int{0, 1}}, "wg", "off", fault)
			if err := f.chain.Run(f.ctx, f.engine); err == nil || f.chain.Progress().Ready {
				t.Fatal("changed original custom-entry proof reached Ready", fault)
			}
			position := 0
			switch fault {
			case "wrong-key-1", "wrong-public-1":
				position = 1
			case "wrong-final", "selected-dns":
				position = 2
			}
			for i := 0; i < position; i++ {
				if f.members[i].public.Load() == 0 {
					t.Fatal("negative failed before earlier original path", fault, i)
				}
			}
			if strings.Contains(fault, "wrong-key") && f.members[position].provider.stats().AuthTCP == 0 {
				t.Fatal("wrong key never reached original SS provider", fault)
			}
			if strings.Contains(fault, "wrong-public") && f.members[position].public.Load() == 0 {
				t.Fatal("wrong public identity never reached original provider", fault)
			}
			if fault == "wrong-final" && f.members[2].private.Load() == 0 || fault == "selected-dns" && f.dns.Load() == 0 {
				t.Fatal("negative never reached original final proof", fault)
			}
			if err := f.close(); err != nil {
				t.Fatal("failed custom-entry proof did not join", err)
			}
		})
	}
	for _, fault := range []string{"wrong-key-1", "wrong-key-3", "wrong-public-1", "wrong-public-3", "wrong-final", "selected-dns", "cancel-second-public", "retired-outer", "native-closed", "foreign-source", "public-dns-drift", "final-layer-key", "final-whitening"} {
		t.Run(fault, func(t *testing.T) {
			layout := multipleImportedLayouts[1]
			layer := "off"
			if fault == "final-layer-key" {
				layout = multipleImportedLayouts[0]
				layer = "aes-256-gcm"
			}
			if fault == "final-whitening" {
				layout = multipleImportedLayouts[0]
				layer = "aes-256-gcm+xor-whitening"
			}
			f := newMultipleImportedFixture(t, layout, "wg", layer, fault)
			if fault == "retired-outer" || fault == "native-closed" || fault == "foreign-source" || fault == "public-dns-drift" {
				f.prove(t)
				if fault == "public-dns-drift" {
					before := f.publicDNS.Load()
					f.badDNS.Store(true)
					conn, err := f.engine.Dial(f.ctx, f.chain.PrefixTags()[1], hopmeasure.PublicAddress)
					if err == nil || conn != nil || f.publicDNS.Load() <= before || f.members[1].benchmark.Load() != 0 {
						t.Fatal("public route skipped fresh selected DNS", err)
					}
				} else if fault == "foreign-source" {
					copy := *f.chain
					if engine, err := f.native.RouterVPNNewNodeChainEngine(f.ctx, &copy, strings.Repeat("a", 32), func(ctx context.Context) error { return ctx.Err() }); err == nil || engine != nil {
						t.Fatal("copied source acquired actual native engine")
					}
				} else {
					if fault == "retired-outer" {
						f.retired.Store(true)
					} else if err := f.native.Close(); err != nil {
						t.Fatal(err)
					} else {
						f.native = nil
					}
					if conn, err := f.engine.Dial(f.ctx, f.chain.PrefixTags()[1], hopmeasure.PublicAddress); err == nil || conn != nil {
						t.Fatal("retired original native path retained public route")
					}
				}
				return
			}
			if fault == "cancel-second-public" {
				member := f.members[3]
				member.held.Store(true)
				ctx, cancel := context.WithCancel(f.ctx)
				defer cancel()
				done := make(chan error, 1)
				go func() { done <- f.chain.Run(ctx, f.engine) }()
				select {
				case <-member.entered:
				case <-time.After(10 * time.Second):
					t.Fatal("actual second encrypted public proof did not enter")
				}
				if f.members[1].public.Load() == 0 || f.members[2].private.Load() == 0 {
					t.Fatal("held second public proof lacked earlier original proofs")
				}
				cancel()
				select {
				case err := <-done:
					if err == nil {
						t.Fatal("cancelled original proof succeeded")
					}
				case <-time.After(3 * time.Second):
					t.Fatal("cancelled original proof did not join")
				}
				if f.chain.Progress().Ready || f.members[4].private.Load() != 0 || f.dns.Load() != 0 {
					t.Fatal("cancelled public proof admitted a later phase")
				}
				return
			}
			err := f.chain.Run(f.ctx, f.engine)
			if err == nil || f.chain.Progress().Ready {
				t.Fatal("wrong original source or selected DNS reached Ready", fault)
			}
			if f.members[0].private.Load() == 0 {
				t.Fatal("negative failed before original private entry", fault, err)
			}
			stop := 1
			if strings.HasSuffix(fault, "-3") {
				stop = 3
			}
			if fault == "wrong-final" || fault == "selected-dns" || fault == "final-layer-key" || fault == "final-whitening" {
				stop = len(f.members) - 1
			}
			for position := 1; position < stop; position++ {
				member := f.members[position]
				if member.imported && member.public.Load() == 0 || !member.imported && member.private.Load() == 0 {
					t.Fatal("negative lacked earlier original proofs", fault, position, err)
				}
			}
			if fault == "final-layer-key" || fault == "final-whitening" {
				final := f.members[len(f.members)-1]
				stats := final.provider.stats()
				if stats.PhysicalTCP == 0 || final.private.Load() != 0 || final.public.Load() != 0 || fault == "final-layer-key" && stats.AuthTCP == 0 {
					t.Fatal("wrong original final layer lacked actual encrypted refusal", fault, stats, err)
				}
			}
			if strings.HasPrefix(fault, "wrong-key-") {
				member := f.members[stop]
				stats := member.provider.stats()
				if stats.PhysicalTCP == 0 || stats.AuthTCP == 0 || member.public.Load() != 0 {
					t.Fatal("wrong independent key lacked actual authentication refusal", fault, stats, err)
				}
			}
			if strings.HasPrefix(fault, "wrong-public-") && f.members[stop].public.Load() == 0 {
				t.Fatal("wrong public identity lacked actual encrypted response", fault, err)
			}
			for position := stop + 1; position < len(f.members); position++ {
				if f.members[position].public.Load() != 0 || f.members[position].private.Load() != 0 {
					t.Fatal("failed original position admitted a later proof", fault, position)
				}
			}
			if fault == "selected-dns" {
				if f.dns.Load() == 0 || f.members[4].private.Load() == 0 || f.members[4].public.Load() != 0 {
					t.Fatal("DNS refusal lacked original final private proof and selected attempt", err)
				}
			} else if f.dns.Load() != 0 {
				t.Fatal("earlier proof failure reached selected DNS", fault)
			}
			if err := f.close(); err != nil {
				t.Fatal("failed original path did not join", fault, err)
			}
		})
	}
}

func extendedImportedLateKeys(t *testing.T) {
	for _, layout := range multipleImportedLayouts {
		if layout.name != "extended-nine" && layout.name != "extended-sixteen" {
			continue
		}
		t.Run("late-key-"+layout.name, func(t *testing.T) {
			lastImport := layout.count - 2
			f := newMultipleImportedFixture(t, layout, "wg", "off", fmt.Sprintf("wrong-key-%d", lastImport))
			if err := f.chain.Run(f.ctx, f.engine); err == nil || f.chain.Progress().Ready {
				t.Fatal("wrong original late key authorized the complete extended route")
			}
			if f.members[0].private.Load() == 0 {
				t.Fatal("original packet entry never proved")
			}
			for i := 1; i < lastImport; i++ {
				if f.members[i].public.Load() == 0 {
					t.Fatal("failure before original encrypted prefix", i)
				}
			}
			last := f.members[lastImport]
			if last.provider.stats().AuthTCP == 0 || last.public.Load() != 0 || f.members[layout.count-1].private.Load() != 0 || f.dns.Load() != 0 {
				t.Fatal("late key drift was not rejected at the original provider", lastImport)
			}
			if err := f.close(); err != nil {
				t.Fatal("extended route failed to join", err)
			}
		})
	}
}

type multipleImportedMeasurementOwner struct {
	f     *multipleImportedFixture
	inUse atomic.Bool
}

func (o *multipleImportedMeasurementOwner) MeasurementChainContext(ctx context.Context) (*mobilemultihop.NodeChain, error) {
	if ctx == nil || ctx.Err() != nil || o.f.retired.Load() || o.f.ctx.Err() != nil {
		return nil, errors.New("original retired")
	}
	return o.f.chain, nil
}
func (o *multipleImportedMeasurementOwner) BeginMeasurementContext(ctx context.Context) (func(), error) {
	if _, err := o.MeasurementChainContext(ctx); err != nil {
		return nil, err
	}
	if !o.inUse.CompareAndSwap(false, true) {
		return nil, errors.New("original activity borrowed")
	}
	return func() { o.inUse.CompareAndSwap(true, false) }, nil
}
func (f *multipleImportedFixture) exportOriginal(t *testing.T, env string) {
	t.Helper()
	// An integration caller can retain these independently generated test-only
	// credentials in its own private temporary directory for host replay.
	// Normal CI emits only public results.
	if directory := os.Getenv(env); directory != "" {
		root, err := os.OpenRoot(directory)
		if err != nil {
			t.Fatal(err)
		}
		defer root.Close()
		info, err := root.Stat(".")
		if err != nil || info.Mode().Perm()&0077 != 0 {
			t.Fatal("peer export requires a private directory")
		}
		out, err := root.OpenFile(fmt.Sprintf("original-%d.json", len(f.members)), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
		if err != nil {
			t.Fatal(err)
		}
		launch, captureErr := f.chain.LaunchInput()
		var writeErr error
		if captureErr == nil {
			_, writeErr = io.WriteString(out, launch)
		}
		if err := errors.Join(captureErr, writeErr, out.Close()); err != nil {
			t.Fatal(err)
		}
	}
}

func (f *multipleImportedFixture) verifyOrderedLatencyHistory(t *testing.T) {
	t.Helper()
	o := &multipleImportedMeasurementOwner{f: f}
	if f.chain.ExtendedLocalNodeCount() != len(f.members) {
		t.Fatal("not original qualified source")
	}
	f.exportOriginal(t, "ROUTERVPN_TEST_EXTENDED_LATENCY_ORIGINALS")
	bound := f.chain.ExtendedLocalStatusLimit()
	s, err := f.chain.NewHopMeasurementContext(f.ctx, o)
	if err != nil {
		t.Fatal("original measurement", err)
	}
	defer func() {
		if err := s.Close(); err != nil {
			t.Error("original measurement failed to join", err)
		}
	}()
	field := reflect.ValueOf(s).Elem().FieldByName("publicTLS")
	*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.tls.Clone()
	facade, err := hopmeasure.NewOrderedLatencyValidatedContext(f.ctx, s, f.chain.SourceSHA256(), f.chain.ConfigSHA256(), f.chain.HealthyContext)
	if err != nil {
		t.Fatal("original ordered latency", err)
	}
	defer func() {
		if err := facade.Close(); err != nil {
			t.Error("original latency failed to join", err)
		}
	}()
	proofs := f.chain.ProofInventory()
	encoded, err := json.Marshal(proofs)
	if err != nil {
		t.Fatal(err)
	}
	t.Logf("QUALIFIED_ORIGINAL_NODES %d %s", len(f.members), encoded)
	var generation string
	for i, proof := range proofs {
		request := fmt.Sprintf("%032x", i+1)
		before := make([]uint64, len(f.members))
		for j, m := range f.members {
			before[j] = m.benchmark.Load()
		}
		if err := facade.StartContext(f.ctx, request, proof.ProfileID); err != nil {
			t.Fatalf("position %d start: %v", i, err)
		}
		if err := facade.DrainContext(f.ctx, request); err != nil {
			t.Fatalf("position %d drain: %v", i, err)
		}
		raw := facade.StatusJSON()
		saved := facade.SavedJSON(proof.ProfileID)
		var status hopmeasure.Status
		var rec hopmeasure.OrderedLatencyReceipt
		if len(raw) > bound || json.Unmarshal([]byte(raw), &status) != nil || !status.Complete || !status.Drained || status.Failure != "" || len(status.Results) != 1 || !status.Results[0].Ready {
			t.Fatalf("position %d no complete response: raw=%s peer_count=%d err=%v", i, raw, f.members[i].benchmark.Load()-before[i], f.chain.HealthyContext(f.ctx))
		}
		if json.Unmarshal([]byte(saved), &rec) != nil || rec.Position != i || rec.NodeID != proof.ProfileID || rec.SourceSHA256 != f.chain.SourceSHA256() || rec.ConfigSHA256 != f.chain.ConfigSHA256() || rec.Request != request || len(rec.GenerationSHA256) != 64 || rec.Result.Benchmark == nil || rec.Result.Benchmark.Distribution == nil || rec.Result.Benchmark.Distribution.Samples != 50 || rec.Result.Benchmark.Attempts != 50 || rec.Result.Benchmark.Failed != 0 || rec.Result.Benchmark.TrimmedMean <= 0 {
			t.Fatalf("invalid per-member receipt at %d", i)
		}
		if i == 0 {
			generation = rec.GenerationSHA256
		}
		if rec.GenerationSHA256 != generation {
			t.Fatal("generation changed")
		}
		for j, m := range f.members {
			want := uint64(0)
			if i == j {
				want = 50
			}
			if m.benchmark.Load()-before[j] != want {
				t.Fatalf("position %d borrowed peer %d: observed=%d", i, j, m.benchmark.Load()-before[j])
			}
		}
		t.Logf("QUALIFIED_ORIGINAL_STATUS %d %s", len(f.members), raw)
		t.Logf("QUALIFIED_ORIGINAL_RECEIPT %d %s", len(f.members), saved)
	}
	for _, proof := range proofs {
		if facade.SavedJSON(proof.ProfileID) == "" {
			t.Fatal("original history not retained")
		}
	}
	t.Logf("QUALIFIED_LATENCY_HISTORY nodes=%d receipts=%d samples=%d", len(f.members), len(proofs), len(proofs)*hopmeasure.LatencyBenchmarkSamples)
}

func TestRouterVPNMultipleImportedExtendedThroughput(t *testing.T) {
	for _, layout := range multipleImportedLayouts {
		if layout.count <= 8 {
			continue
		}
		t.Run(layout.name, func(t *testing.T) {
			f := newMultipleImportedFixture(t, layout, "wg", "off", "")
			f.prove(t)
			f.exportOriginal(t, "ROUTERVPN_TEST_EXTENDED_THROUGHPUT_ORIGINALS")
			o := &multipleImportedMeasurementOwner{f: f}
			service, err := f.chain.NewHopMeasurementContext(f.ctx, o)
			if err != nil {
				t.Fatal(err)
			}
			defer func() {
				if err := service.Close(); err != nil {
					t.Error("throughput worker did not retire", err)
				}
			}()
			// Trust just the original test peer's certificate in the real TLS client.
			field := reflect.ValueOf(service).Elem().FieldByName("publicTLS")
			*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.tls.Clone()
			const size = 8 << 20
			request := strings.Repeat("b", 32)
			if err := service.StartContext(f.ctx, request, size); err != nil {
				t.Fatal("original full-route transfer refused", err)
			}
			var status hopmeasure.Status
			var raw string
			for {
				raw = service.StatusContextJSON(f.ctx)
				if err := json.Unmarshal([]byte(raw), &status); err != nil {
					t.Fatal(err)
				}
				if status.Drained && status.Complete || f.ctx.Err() != nil {
					break
				}
				time.Sleep(100 * time.Millisecond)
			}
			proofs := f.chain.ProofInventory()
			if err := service.Drain(request); err != nil || f.ctx.Err() != nil || status.Stage != "complete" ||
				!status.Drained || status.Failure != "" || status.Request != request || len(status.Results) != len(proofs) ||
				len(raw) > f.chain.ExtendedLocalStatusLimit() {
				t.Fatal("complete original throughput result", status.Stage, len(status.Results), status.Failure, f.ctx.Err(), err)
			}
			for i, member := range f.members {
				row := status.Results[i]
				if !row.Ready || row.Failure != "" || row.ID != proofs[i].ProfileID || row.Download == nil || row.Upload == nil ||
					row.Download.Bytes != size || row.Upload.Bytes != size || member.downBytes.Load() != size || member.upBytes.Load() != size {
					t.Fatalf("position %d transfer or original peer identity changed (download %d, upload %d, failure %q)", i, member.downBytes.Load(), member.upBytes.Load(), row.Failure)
				}
			}
			t.Logf("QUALIFIED_ORIGINAL_THROUGHPUT_SOURCE %d %s %s", len(proofs), f.chain.SourceSHA256(), f.chain.ConfigSHA256())
			t.Logf("QUALIFIED_ORIGINAL_THROUGHPUT nodes=%d bytes_per_direction=%d bytes_total=%d", len(proofs), size, len(proofs)*size*2)
			t.Logf("QUALIFIED_ORIGINAL_THROUGHPUT_STATUS %d %s", len(proofs), raw)
		})
	}
}
