func newMultipleImportedFixture(t *testing.T, layout multipleImportedLayout, mode, finalLayer, fault string) *multipleImportedFixture {
	return newMultipleImportedFixtureWithEntry(t, layout, mode, finalLayer, fault, nil)
}
func newMultipleImportedFixtureWithEntry(t *testing.T, layout multipleImportedLayout, mode, finalLayer, fault string, wrap func(tun.Handler) tun.Handler, candidate ...multipleImportedCandidateSetup) *multipleImportedFixture {
	t.Helper()
	return newMultipleImportedFixtureWithStream(t, layout, mode, finalLayer, fault, wrap, -1, candidate...)
}
func newMultipleImportedFixtureWithStream(t *testing.T, layout multipleImportedLayout, mode, finalLayer, fault string, wrap func(tun.Handler) tun.Handler, pairedStream int, candidate ...multipleImportedCandidateSetup) *multipleImportedFixture {
	var streams []int
	if pairedStream >= 0 {
		streams = []int{pairedStream}
	}
	return newMultipleImportedFixtureWithStreams(t, layout, mode, finalLayer, fault, wrap, streams, candidate...)
}
func newMultipleImportedFixtureWithStreams(t *testing.T, layout multipleImportedLayout, mode, finalLayer, fault string, wrap func(tun.Handler) tun.Handler, streams []int, candidate ...multipleImportedCandidateSetup) *multipleImportedFixture {
	return newMultipleImportedHostnameFixture(t, layout, mode, finalLayer, fault, wrap, streams, nil, candidate...)
}

func newMultipleImportedHostnameFixture(t *testing.T, layout multipleImportedLayout, mode, finalLayer, fault string, wrap func(tun.Handler) tun.Handler, streams []int, host *multipleImportedHostname, candidate ...multipleImportedCandidateSetup) *multipleImportedFixture {
	privateStreams := make(map[int]bool, len(streams))
	for _, i := range streams {
		privateStreams[i] = true
	}
	t.Helper()
	ctx, cancel := context.WithTimeout(pause.WithDefaultManager(context.Background()), 85*time.Second)
	f := &multipleImportedFixture{ctx: ctx, cancel: cancel, members: make([]*multipleImportedMember, layout.count)}
	t.Cleanup(func() {
		if err := f.close(); err != nil {
			t.Error("complete original native path did not join", err)
		}
	})
	var resolver string
	if host != nil {
		resolver = host.start(t)
	}
	request, clients := desktopNodeChainPeerFixture(t, layout.count-1)
	modes := make([]string, len(request.Prefixes))
	for i := range modes {
		modes[i] = mode
	}
	desktopNodeChainSetModes(t, &request, modes)
	final, err := ecdh.X25519().GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	finalPublic := base64.StdEncoding.EncodeToString(final.PublicKey().Bytes())
	finalID := sha256.Sum256([]byte("router-vpn-node-proof-v1\n" + finalPublic))
	request.FinalNodeProofID = hex.EncodeToString(finalID[:])
	finalWG := fmt.Sprintf("[Interface]\nAddress=10.77.0.2/32\nPrivateKey=%s\nMTU=1420\n[Peer]\nPublicKey=%s\nEndpoint=10.77.0.1:51820\nAllowedIPs=0.0.0.0/0,::/0\n", clients[0], finalPublic)
	finalIdentity := desktopNodeChainJSON(t, map[string]string{"wg.conf": base64.StdEncoding.EncodeToString([]byte(finalWG))})
	ipcs, err := desktopNodeChainPeerIdentityBounds(request, 1, layout.count-1)
	if err != nil {
		t.Fatal(err)
	}
	defer clear(ipcs)
	imported := map[int]bool{}
	for _, position := range layout.imports {
		if position < 0 || position == 0 && (layout.name != "custom-entry" || layout.count != 3) || position >= layout.count-1 || imported[position] {
			t.Fatal("invalid imported layout")
		}
		imported[position] = true
	}
	var additionalIPs []net.IP
	if wrap != nil {
		additionalIPs = []net.IP{net.ParseIP("1.0.0.1")}
	}
	certificate, ca := desktopNodeChainImportedCertificate(t, additionalIPs...)
	roots := x509.NewCertPool()
	if !roots.AppendCertsFromPEM([]byte(ca)) {
		t.Fatal("private TLS trust missing")
	}
	f.ca = ca
	f.tls = &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}
	dnsAddress := f.dnsServer(t)
	loopback := netip.MustParseAddr("127.0.0.1")
	// Build every provider before any client Box exists. Routes are then frozen:
	// a provider forwards only to its actual next member, never a later one.
	for position := layout.count - 1; position >= 0; position-- {
		member := &multipleImportedMember{position: position, imported: imported[position], publicIP: fmt.Sprintf("203.0.113.%d", 100+position), entered: make(chan struct{}, 1)}
		f.members[position] = member
		if position == layout.count-1 {
			member.virtual = "10.77.0.1:8388"
			if finalLayer == "aes-256-gcm+xor-whitening" {
				member.virtual = "10.77.0.1:8389"
			}
			member.key = request.FinalPassword
		} else if member.imported || privateStreams[position] {
			member.virtual = fmt.Sprintf("198.51.100.%d:%d", 150+position, 21000+position)
			member.key = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(90 + position)}, 32))
		} else {
			member.virtual = desktopNodeChainNext(position)
		}
		if host != nil && position == host.position {
			member.virtual = fmt.Sprintf("198.51.100.%d:8388", 150+position)
		}
		routes := []desktopNodeLayerRoute{}
		if host != nil && position == host.position-1 {
			routes = append(routes, desktopNodeLayerRoute{"tcp", "10.78.0.53:5353", resolver})
		}
		if len(candidate) == 1 && candidate[0].position == position {
			routes = append(routes, candidate[0].route)
		}
		if position < layout.count-1 {
			next := f.members[position+1]
