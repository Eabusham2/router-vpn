func TestRouterVPNOrderedExternalFinalEncrypted(t *testing.T) {
	cases := []struct {
		name                    string
		count                   int
		dns, fault, mode, layer string
	}{
		{"three-home", 3, "home", "", "wg", ""}, {"four-custom", 4, "custom", "", "wg", ""}, {"nine-custom-fifty", 9, "custom", "", "wg", ""},
		{"wrong-exit-key", 4, "custom", "wrong-exit-key", "wg", ""}, {"wrong-public-exit", 3, "home", "wrong-final", "wg", ""}, {"failed-selected-dns", 4, "custom", "selected-dns", "wg", ""},
		{"fast-home", 3, "home", "", "awg2-fast", ""}, {"strong-custom-fifty", 9, "custom", "", "awg2-strong", ""},
		{"fast-wrong-entry", 3, "home", "wrong-awg-entry", "awg2-fast", ""}, {"strong-wrong-entry", 3, "custom", "wrong-awg-entry", "awg2-strong", ""},
		{"wg-aes-home", 3, "home", "", "wg", "aes-256-gcm"},
		{"wg-xor-custom", 4, "custom", "", "wg", "aes-256-gcm+xor-whitening"},
		{"fast-aes-custom", 4, "custom", "", "awg2-fast", "aes-256-gcm"},
		{"fast-xor-home", 3, "home", "", "awg2-fast", "aes-256-gcm+xor-whitening"},
		{"strong-aes-home", 3, "home", "", "awg2-strong", "aes-256-gcm"},
		{"strong-xor-custom-fifty", 9, "custom", "", "awg2-strong", "aes-256-gcm+xor-whitening"},
		{"wg-wrong-layer-key", 3, "home", "entry-layer-key", "wg", "aes-256-gcm"},
		{"strong-wrong-whitening", 3, "custom", "entry-layer-whitening", "awg2-strong", "aes-256-gcm+xor-whitening"},
		{"fast-wrong-layer-target", 3, "home", "entry-layer-target", "awg2-fast", "aes-256-gcm"},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			imports := make([]int, tc.count-2)
			for i := range imports {
				imports[i] = i + 1
			}
			f := newMultipleImportedFixtureWithLayerRoutes(t, multipleImportedLayout{"external-final-" + tc.dns, tc.count, imports}, tc.mode, "off", tc.fault, nil, nil, nil, nil, tc.layer)
			last := f.members[tc.count-1]
			if !f.chain.HasExternalFinal() || !last.imported {
				t.Fatal("public exit did not retain its own independent source")
			}
			if tc.mode != "wg" {
				f.checkExternalAWGEntry(t, tc.mode, tc.fault == "wrong-awg-entry")
			}
			entryRefused := tc.fault == "wrong-awg-entry" || strings.HasPrefix(tc.fault, "entry-layer-")
			if entryRefused {
				ctx, cancel := context.WithTimeout(f.ctx, 10*time.Second)
				err := f.chain.Run(ctx, f.engine)
				cancel()
				if err == nil || f.chain.Progress().Ready || f.dns.Load() != 0 {
					t.Fatal("substituted entry acquired route or DNS readiness", err)
				}
				for _, m := range f.members {
					if m.private.Load() != 0 || m.public.Load() != 0 {
						t.Fatal("substituted entry reached a private or public proof")
					}
				}
			} else if tc.fault != "" {
				ctx, cancel := context.WithTimeout(f.ctx, 10*time.Second)
				err := f.chain.Run(ctx, f.engine)
				cancel()
				if err == nil || f.chain.Progress().Ready || last.private.Load() != 0 || f.members[0].private.Load() == 0 {
					t.Fatal("incorrect public exit was published or failed before original entry proof", err)
				}
				if tc.fault == "wrong-final" && (last.public.Load() == 0 || f.dns.Load() != 0) || tc.fault == "wrong-exit-key" && (last.public.Load() != 0 || f.dns.Load() != 0) || tc.fault == "selected-dns" && (last.public.Load() == 0 || f.dns.Load() == 0) {
					t.Fatal("negative did not reach its original failure boundary")
				}
			} else {
				f.prove(t)
				f.publicRoute(t, tc.count-1)
				if tc.count == 9 {
					f.verifyOrderedLatencyHistory(t)
				}
				if last.benchmark.Load() == 0 || last.private.Load() != 0 {
					t.Fatal("public exit borrowed a private API or missed tagged HTTPS")
				}
			}
			for _, m := range f.members[1 : tc.count-1] {
				if !entryRefused && (m.public.Load() == 0 || m.layer.rawTCP.Load() == 0) {
					t.Fatal("an original encrypted interior was bypassed", m.position)
				}
			}
			if tc.layer != "" {
				f.checkExternalEntryLayer(t, tc.layer, tc.fault)
			}
			if err := f.close(); err != nil {
				t.Fatal(err)
			}
			if c, err := f.engine.Dial(context.Background(), f.chain.FinalTag(), hopmeasure.PublicAddress); err == nil || c != nil {
				t.Fatal("retired external exit still authorized traffic")
			}
			if tc.mode != "wg" {
				t.Logf("AWG_EXTERNAL_ENTRY case=%s mode=%s mismatch=%t readback=true", tc.name, tc.mode, tc.fault == "wrong-awg-entry")
			}
			t.Logf("QUALIFIED_EXTERNAL_FINAL case=%s nodes=%d dns=%s owner_joined=true private_exit_calls=0", tc.name, tc.count, tc.dns)
		})
	}
}

// Feed only the paired node's original private UDP service to its own packet
// peer. There is no route from a physical client straight to that packet peer.
func (f *multipleImportedFixture) installExternalEntryLayer(t *testing.T, layer, fault string) {
	t.Helper()
	var input struct {
		Mode         string
		Files        string
		Profile      string `json:"profile_json"`
		DNSBootstrap string `json:"dns_bootstrap"`
	}
	if err := json.Unmarshal([]byte(f.source.Nodes[0]), &input); err != nil {
		t.Fatal(err)
	}
	var profile map[string]any
	if err := json.Unmarshal([]byte(input.Profile), &profile); err != nil {
		t.Fatal(err)
	}
	profile["start_layer"] = layer
	host := profile["endpoint"].(string)
	private, _, err := net.SplitHostPort(strings.TrimPrefix(profile["router_api"].(string), "http://"))
	if err != nil {
		t.Fatal(err)
	}
	physical := netip.MustParseAddrPort(f.members[0].physical)
	inner := net.JoinHostPort(private, strconv.Itoa(int(physical.Port())))
	if fault == "entry-layer-target" {
		inner = net.JoinHostPort("10.255.255.251", strconv.Itoa(int(physical.Port())))
	}
	key := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{211}, 32))
	kind := "shadowsocks"
	if layer == "aes-256-gcm+xor-whitening" {
		kind = "routervpn-aes-xor"
	} else if layer != "aes-256-gcm" {
		t.Fatal("unowned entry layer")
	}
	ctx, cancel := context.WithCancel(f.ctx)
	srv := &desktopNodeLayerServer{ctx: ctx, cancel: cancel, routes: []desktopNodeLayerRoute{{"udp", inner, physical.String()}}, connections: map[io.Closer]bool{}}
	provider := desktopImportedSOCKSLayerProvider(t, srv, map[string]any{"type": kind, "password": key}, fault)
	outerPort := netip.MustParseAddrPort(provider.address).Port()
	graph := map[string]any{"inbounds": []any{map[string]any{"type": "tun", "tag": "tun-in", "auto_route": true, "strict_route": true}}, "outbounds": []any{map[string]any{"type": "shadowsocks", "tag": "proxy", "server": host, "server_port": outerPort, "method": mobilemultihop.NativeStartLayerMethod, "password": key}}, "route": map[string]any{"final": "proxy", "rules": []any{}}}
	files := map[string]string{"sing-box.json": base64.StdEncoding.EncodeToString([]byte(desktopNodeChainJSON(t, graph)))}
	// The standard generated asset owns the AES service port. The paired
	// whitening service has its own fixed public port and never aliases AES.
	expectedPort := outerPort
	if layer == "aes-256-gcm+xor-whitening" {
		expectedPort = 8389
	}
	f.entryLayer = &multipleImportedEntryLayer{mode: layer, virtual: net.JoinHostPort(host, strconv.Itoa(int(expectedPort))), provider: provider, server: srv}
	node, err := mobilemultihop.NewNodeProfile(input.Mode, input.Files, desktopNodeChainJSON(t, profile), desktopNodeChainJSON(t, files), input.DNSBootstrap)
	if err != nil {
		t.Fatal("original layered paired launch", err)
	}
	f.source.Nodes[0], err = node.LaunchInput()
	if err != nil {
		t.Fatal(err)
	}
}

func (f *multipleImportedFixture) checkExternalEntryLayer(t *testing.T, layer, fault string) {
	t.Helper()
	p := f.entryLayer
	if p == nil || p.mode != layer || p.tag == "" || f.chain.ProofInventory()[0].StartLayer != layer {
		t.Fatal("lost original entry layer")
	}
	stats := p.provider.stats()
	if stats.PhysicalUDP <= 0 || stats.PhysicalTCP != 0 {
		t.Fatal("packet entry did not use its own physical UDP layer", stats)
	}
	if fault == "" {
		if stats.Packets <= 0 || stats.AuthUDP != 0 || !f.chain.Progress().Ready {
			t.Fatal("original encrypted outer packet transport", stats)
		}
	} else if f.chain.Progress().Ready || f.members[0].private.Load() != 0 || f.dns.Load() != 0 {
		t.Fatal("wrong outer layer reached readiness")
	}
	if fault == "entry-layer-key" || fault == "entry-layer-whitening" {
		if stats.AuthUDP == 0 || stats.Packets != 0 {
			t.Fatal("wrong outer layer authenticated", stats)
		}
	}
	observed := fault
	if observed == "" {
		observed = "original"
	}
	t.Logf("EXTERNAL_PACKET_LAYER mode=%s layer=%s fault=%s udp_on_original=true complete=%t", f.chain.ProofInventory()[0].Mode, layer, observed, fault == "")
}
