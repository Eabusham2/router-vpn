type externalCandidatePeer struct {
	*multipleImportedMember
	input, id     string
	mutex         sync.Mutex
	nonces        map[string]bool
	afterResponse func(int)
}

func newExternalCandidatePeer(t *testing.T, f *multipleImportedFixture, cert *tls.Certificate, index int, fault string, next ...desktopNodeLayerRoute) *externalCandidatePeer {
	t.Helper()
	m := &multipleImportedMember{position: index, imported: true, virtual: fmt.Sprintf("198.51.100.%d:%d", index, 23000+index), publicIP: fmt.Sprintf("203.0.113.%d", index), key: base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{byte(index)}, 32))}
	peer := &externalCandidatePeer{multipleImportedMember: m, id: fmt.Sprintf("native-independent-import-%d", index), nonces: map[string]bool{}}
	m.candidateTrace = func(w http.ResponseWriter, r *http.Request) {
		nonce := r.URL.Query().Get("routervpn_candidate")
		decoded, err := hex.DecodeString(nonce)
		peer.mutex.Lock()
		defer peer.mutex.Unlock()
		if err != nil || len(decoded) != 16 || hex.EncodeToString(decoded) != nonce || peer.nonces[nonce] || r.TLS == nil || r.Host != "1.1.1.1" || r.URL.Path != "/cdn-cgi/trace" || r.URL.RawQuery != "routervpn_candidate="+nonce || r.Header.Get("Cache-Control") != "no-store" {
			t.Error("the original encrypted candidate did not receive a fresh fixed HTTPS trace")
			http.Error(w, "invalid trace", 403)
			return
		}
		peer.nonces[nonce] = true
		if peer.afterResponse != nil {
			peer.afterResponse(len(peer.nonces))
		}
		ip := m.publicIP
		if fault == "wrong-exit" {
			ip = "203.0.113.239"
		}
		fmt.Fprintln(w, "ip="+ip)
	}
	routes := append([]desktopNodeLayerRoute{{"tcp", "1.1.1.1:443", f.publicServer(t, m, cert)}}, next...)
	ctx, cancel := context.WithCancel(f.ctx)
	m.layer = &desktopNodeLayerServer{ctx: ctx, cancel: cancel, routes: routes, connections: map[io.Closer]bool{}}
	m.provider = desktopStartSSProvider(t, m.layer, mobilemultihop.NativeStartLayerMethod, m.key, netip.MustParseAddr("127.0.0.1"))
	m.physical, m.close = m.provider.address, m.provider.close
	key := m.key
	if fault == "wrong-key" {
		key = base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{231}, 32))
	}
	peer.input = multipleImportedInput(t, m, key)
	return peer
}
func (p *externalCandidatePeer) route() desktopNodeLayerRoute {
	return desktopNodeLayerRoute{"tcp", p.virtual, p.physical}
}
func (p *externalCandidatePeer) replies() int {
	p.mutex.Lock()
	defer p.mutex.Unlock()
	return len(p.nonces)
}

func externalCandidateTrust(runtime any, tlsConfig *tls.Config) {
	field := reflect.ValueOf(runtime).Elem().FieldByName("testTLS")
	*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = tlsConfig.Clone()
}

func measureExternalCandidate(t *testing.T, f *multipleImportedFixture, position int, p *externalCandidatePeer, closed bool, fault string) {
	t.Helper()
	inventory := desktopNodeChainJSON(t, mobilemultihop.NodeChainCandidateInventory{Schema: 1, Revision: "original-public-candidate-catalog", Inputs: []string{p.input}})
	plan, err := f.chain.NewCandidatePlan(position, inventory)
	if err != nil {
		t.Fatal("original public candidate", err)
	}
	owner := &mixedCandidateCatalog{multipleImportedMeasurementOwner: &multipleImportedMeasurementOwner{f: f}, capture: plan.CaptureSHA256()}
	sockets := &connectedImportedCandidateEngine{}
	var s *hopmeasure.CandidateService
	if closed {
		prep, err := mobilemultihop.NewNodeChainCandidatePreparation(desktopNodeChainJSON(t, f.source), position, inventory)
		if err != nil || prep.ExtendedCandidateDepth() != len(f.members) {
			t.Fatal("original public preparation depth", err)
		}
		owner.capture = prep.CaptureSHA256()
		f.startBox(t, f.physical, prep)
		engine, err := f.native.RouterVPNNewNodeChainCandidatePreparationEngine(f.ctx, prep, strings.Repeat("c", 32), func(ctx context.Context) error { _, err := owner.MeasurementChainContext(ctx); return err })
		if err != nil {
			t.Fatal(err)
		}
		defer func() {
			if err := engine.RetireContext(f.ctx); err != nil {
				t.Error(err)
			}
		}()
		runtime, err := mobilemultihop.NewNodeChainCandidatePreparationRuntime(prep, &mixedClosedCandidateOwner{engine, owner, p.virtual, sockets})
		if err != nil {
			t.Fatal(err)
		}
		externalCandidateTrust(runtime, f.tls)
		if err := runtime.StartContext(f.ctx); err != nil {
			t.Fatal(err)
		}
		defer func() {
			if err := runtime.CloseContext(f.ctx); err != nil {
				t.Error(err)
			}
		}()
		if f.chain.Progress().Ready || f.dns.Load() != 0 || f.members[position+1].public.Load() != 0 {
			t.Fatal("detached candidate opened application, suffix or DNS")
		}
		s, err = runtime.NewMeasurementContext(f.ctx)
		if err != nil {
			t.Fatal(err)
		}
	} else {
		f.prove(t)
		s, err = plan.NewMeasurementContext(f.ctx, owner)
		if err != nil {
			t.Fatal(err)
		}
	}
	defer s.Close()
	if fault == "late-catalog" {
		p.mutex.Lock()
		p.afterResponse = func(n int) {
			if n == 50 {
				owner.changed.Store(true)
			}
		}
		p.mutex.Unlock()
	}
	if fault == "cancel-close" {
		sockets.closeEntered, sockets.closeRelease = make(chan struct{}), make(chan struct{})
	}
	before := make([]int64, position+1)
	for i := 1; i <= position; i++ {
		before[i] = int64(f.members[i].provider.stats().Streams)
	}
	request := strings.Repeat("7", 32)
	if err := s.StartContext(f.ctx, request, p.id); err != nil {
		t.Fatal(err)
	}
	if fault == "cancel-close" {
		select {
		case <-sockets.closeEntered:
		case <-f.ctx.Done():
			t.Fatal("original target close was never reached")
		}
		s.Cancel(request)
		held, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
		join := s.CloseContext(held)
		cancel()
		active := owner.inUse.Load()
		close(sockets.closeRelease)
		if join == nil || !active {
			t.Fatal("original activity released before its native socket joined")
		}
	}
	if err := desktopCandidateNativeDrain(f.ctx, s, request); err != nil {
		t.Fatal(err)
	}
	status := desktopCandidateNativeStatus(t, s)
	if !status.Drained || !status.Complete || owner.inUse.Load() || status.Measurement != hopmeasure.CandidatePublicResponseMeasurement || status.PrefixPosition != position || status.PrefixID != f.chain.ProofInventory()[position].ProfileID || status.CaptureSHA256 != owner.capture || closed && sockets.dials.Load() != sockets.closed.Load() {
		t.Fatal("lost original public prefix/owner", status)
	}
	replies := p.replies()
	if fault == "original" {
		sum := sha256.Sum256([]byte(desktopNodeChainJSON(t, []string{"routervpn-node-chain-imported-member-v1", p.input})))
		if len(status.Results) != 1 || status.CandidateID != p.id || status.CandidateSourceSHA256 != hex.EncodeToString(sum[:]) || replies != 50 || p.provider.stats().Streams != 50 || p.provider.stats().PhysicalTCP != 50 {
			t.Fatal("missing independently encrypted public responses", status, p.provider.stats(), replies)
		}
		row := status.Results[0]
		if !row.Ready || row.Role != "candidate" || row.ID != p.id || row.Kind != "public-exit-response" || row.Benchmark == nil || row.Benchmark.Measurement != status.Measurement || row.Benchmark.Endpoint != hopmeasure.CandidatePublicResponseEndpoint || row.Benchmark.Attempts != 50 || row.Benchmark.Distribution.Samples != 50 || row.Benchmark.TrimmedMean <= 0 {
			t.Fatal("public benchmark lost validated trace", row)
		}
		for i := 1; i <= position; i++ {
			if int64(f.members[i].provider.stats().Streams)-before[i] < 50 {
				t.Fatal("public candidate skipped an original encrypted prefix", i)
			}
		}
	} else {
		for _, row := range status.Results {
			if row.Ready || row.Benchmark != nil || row.CandidateDisposition != "" {
				t.Fatal("failed public candidate acquired a benchmark", row)
			}
		}
		switch fault {
		case "wrong-key":
			if p.provider.stats().AuthTCP == 0 || replies != 0 {
				t.Fatal("original SS cipher did not reject substituted key")
			}
		case "wrong-exit":
			if replies != 1 || len(status.Results) != 1 || status.Results[0].Failure == "" {
				t.Fatal("wrong public IP did not fail at first verified trace")
			}
		case "late-catalog":
			if replies != 50 || len(status.Results) != 0 || !owner.changed.Load() {
				t.Fatal("lost last-response catalog revocation")
			}
		case "cancel-close":
			if replies != 1 || len(status.Results) != 0 {
				t.Fatal("held candidate socket published late score")
			}
		default:
			t.Fatal("unrecognized refusal")
		}
	}
	if p.private.Load() != 0 {
		t.Fatal("public candidate borrowed private agent")
	}
	if err := s.Close(); err != nil {
		t.Fatal(err)
	}
}

func TestRouterVPNExternalFinalPublicCandidates(t *testing.T) {
	for _, spec := range []struct {
		name            string
		count, position int
		dns             string
		closed          bool
		fault           string
	}{
		{"home-retained-suffix", 4, 1, "home", true, "original"}, {"custom-retained-final", 3, 1, "custom", false, "original"},
		{"nine-late-import", 9, 7, "custom", true, "original"}, {"wrong-key", 4, 1, "home", false, "wrong-key"},
		{"wrong-exit", 4, 2, "custom", true, "wrong-exit"}, {"late-catalog", 4, 1, "home", false, "late-catalog"}, {"cancel-close", 4, 2, "home", true, "cancel-close"},
	} {
		t.Run(spec.name, func(t *testing.T) {
			var first, second *externalCandidatePeer
			inputs := make([]int, spec.count-2)
			for i := range inputs {
				inputs[i] = i + 1
			}
			makeRoutes := func(t *testing.T, f *multipleImportedFixture, position int, cert *tls.Certificate) []desktopNodeLayerRoute {
				if position != spec.position {
					return nil
				}
				next := f.members[position+1]
				second = newExternalCandidatePeer(t, f, cert, 43, "original")
				first = newExternalCandidatePeer(t, f, cert, 42, spec.fault, desktopNodeLayerRoute{"tcp", next.virtual, next.physical}, desktopNodeLayerRoute{"udp", next.virtual, next.physical}, second.route())
				return []desktopNodeLayerRoute{first.route()}
			}
			marker := multipleImportedCandidateSetup{position: -1, closed: spec.closed}
			f := newMultipleImportedFixtureWithRoutes(t, multipleImportedLayout{"external-final-" + spec.dns, spec.count, inputs}, "wg", "off", "", nil, nil, nil, makeRoutes, marker)
			measureExternalCandidate(t, f, spec.position, first, spec.closed, spec.fault)
			rounds := 0
			if spec.fault == "original" {
				// Close the exact first native instance and reuse its independently running peers.
				// This permits only the inserted peer to reach the second candidate.
				if err := f.chain.CloseContext(f.ctx); err != nil {
					t.Fatal(err)
				}
				if err := f.native.Close(); err != nil {
					t.Fatal(err)
				}
				f.native = nil
				f.engine = nil
				pos := spec.position + 1
				previous := slices.Clone(f.source.Nodes)
				f.source.Nodes = slices.Insert(f.source.Nodes, pos, first.input)
				f.source.IdentitySources = slices.Insert(f.source.IdentitySources, pos, "")
				f.members = slices.Insert(f.members, pos, first.multipleImportedMember)
				if !slices.Equal(previous[:pos], f.source.Nodes[:pos]) || !slices.Equal(previous[pos:], f.source.Nodes[pos+1:]) || f.members[len(f.members)-1].private.Load() != 0 {
					t.Fatal("recapture changed original suffix or final")
				}
				var err error
				f.chain, err = mobilemultihop.NewNodeChain(desktopNodeChainJSON(t, f.source))
				if err != nil || !f.chain.HasExternalFinal() {
					t.Fatal("recompile original source with chosen imported intermediate", err)
				}
				runtime := reflect.ValueOf(f.chain).Elem().FieldByName("runtime")
				field := runtime.FieldByName("testTLS")
				*(**tls.Config)(unsafe.Pointer(field.UnsafeAddr())) = f.tls.Clone()
				f.startBox(t, f.physical)
				measureExternalCandidate(t, f, pos, second, false, "original")
				rounds = 2
			}
			if err := f.close(); err != nil {
				t.Fatal(err)
			}
			for _, candidate := range []*externalCandidatePeer{first, second} {
				candidate.close()
				candidate.layer.mu.Lock()
				joined := candidate.layer.closing && len(candidate.layer.connections) == 0 && candidate.layer.ctx.Err() != nil
				candidate.layer.mu.Unlock()
				if !joined {
					t.Fatal("independent candidate peer retained native work after Close")
				}
			}
			t.Logf("PUBLIC_CANDIDATE case=%s nodes=%d position=%d rounds=%d samples=%d retained=true joined=true", spec.name, spec.count, spec.position, rounds, rounds*50)
		})
	}
}
