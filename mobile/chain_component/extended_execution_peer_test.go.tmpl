// The transparent WG device exposes real original TCP endpoints to the
// ordinary HTTP and authenticated Server listeners inside this component.
// Only the selected private WG port is eligible for a new lease generation.
type extendedWGFront struct {
	tun.Handler
	address              netip.AddrPort
	accepted             chan net.Conn
	closed               chan struct{}
	once                 sync.Once
	count                atomic.Uint64
	physicalNext, faster string
	generation           atomic.Pointer[extendedWGFront]
}

func (s *extendedWGFront) Addr() net.Addr { return net.TCPAddrFromAddrPort(s.address) }
func (s *extendedWGFront) Close() error   { s.once.Do(func() { close(s.closed) }); return nil }
func (s *extendedWGFront) Accept() (net.Conn, error) {
	select {
	case c := <-s.accepted:
		return c, nil
	case <-s.closed:
		return nil, net.ErrClosed
	}
}
func (s *extendedWGFront) JudgeFlow(protocol uint8, source, destination netip.AddrPort, z []byte) tun.FlowVerdict {
	if protocol == 6 && destination == s.address {
		return tun.FlowVerdict{Action: tun.ActionAccept}
	}
	return s.Handler.JudgeFlow(protocol, source, destination, z)
}

// The transparent gVisor endpoint exposes the packet source as LocalAddr.
// Present the socket to its listening server with the accepted orientation.
type extendedWGAccepted struct{ net.Conn }

func (c extendedWGAccepted) LocalAddr() net.Addr  { return c.Conn.RemoteAddr() }
func (c extendedWGAccepted) RemoteAddr() net.Addr { return c.Conn.LocalAddr() }

// Compare measures both real routes. Give the slower fixture link enough
// independent latency to separate it from normal scheduling jitter in a
// sixteen-peer race-instrumented graph. Native operation deadlines stay fixed.
const extendedSlowLinkDelay = 150 * time.Millisecond

func (s *extendedWGFront) NewConnectionEx(ctx context.Context, c net.Conn, src, dst M.Socksaddr, done N.CloseHandlerFunc) {
	if dst.AddrPort() != s.address {
		if s.faster == "server" && dst.String() == s.physicalNext {
			time.Sleep(extendedSlowLinkDelay)
		}
		s.Handler.NewConnectionEx(ctx, c, src, dst, done)
		return
	}
	if generation := s.generation.Load(); generation != nil {
		s = generation
	} else if s.physicalNext != "" {
		_ = c.Close()
		return
	}
	if s.faster == "local" {
		time.Sleep(extendedSlowLinkDelay)
	}
	if src.Addr != netip.MustParseAddr("10.80.0.2") || M.SocksaddrFromNet(c.LocalAddr()) != src || M.SocksaddrFromNet(c.RemoteAddr()) != dst || done != nil {
		_ = c.Close()
		if done != nil {
			done(net.ErrClosed)
		}
		return
	}
	select {
	case <-s.closed:
		_ = c.Close()
	case <-ctx.Done():
		_ = c.Close()
	case s.accepted <- extendedWGAccepted{c}:
		s.count.Add(1)
	}
}
func (s *extendedWGFront) listen() net.Listener {
	next := &extendedWGFront{address: s.address, accepted: make(chan net.Conn), closed: make(chan struct{}), faster: s.faster}
	s.generation.Store(next)
	return next
}

type ExtendedWorkerFactory func(context.Context, context.Context, string, multihoprelay.NodeChainCapture, net.Listener) (multihoprelay.NodeChainProcess, error)
type extendedRuntimeWorker struct {
	start    ExtendedWorkerFactory
	base     context.Context
	listener net.Listener
	source   string
}

func (r *extendedRuntimeWorker) Start(context.Context, []byte, multihoprelay.Lease) (multihoprelay.Process, error) {
	return nil, errors.New("foreign relay owner")
}
func (r *extendedRuntimeWorker) StartChain(ctx context.Context, c multihoprelay.NodeChainCapture) (multihoprelay.NodeChainProcess, error) {
	return r.start(ctx, r.base, r.source, c, r.listener.(*extendedWGFront).listen())
}
func RunExtendedOriginalWorker(t *testing.T, count int, entryMode, mode, winner, measure string, first, last int, start ExtendedWorkerFactory) {
	t.Helper()
	var layout multipleImportedLayout
	for _, v := range multipleImportedLayouts {
		if v.count == count {
			layout = v
		}
	}
	var measured *selectedResponseNativeCase
	var candidateRoute []multipleImportedCandidateSetup
	if count == 3 && entryMode == "wg" && strings.HasPrefix(measure, "private-response/") {
		layout = multipleImportedLayout{"selected-private-response", 3, []int{1}}
		measured = &selectedResponseNativeCase{fault: strings.TrimPrefix(measure, "private-response/")}
		var final *routedPrivateResponseFinal
		if measured.fault == "original" {
			measured.createReplacementPeer(t)
			final = &measured.final
		}
		input, route, provider := newRoutedPrivateResponseFinal(t, measured.fault, measured.accept, final)
		measured.input, measured.provider = input, provider
		candidateRoute = []multipleImportedCandidateSetup{{1, route, false}}
	} else if layout.count <= 8 {
		t.Fatal("missing longer original fixture")
	}
	socket := func(addr string) *extendedWGFront {
		return &extendedWGFront{address: netip.MustParseAddrPort(addr), accepted: make(chan net.Conn), closed: make(chan struct{})}
	}
	api, front := socket("10.80.0.1:8787"), socket("10.80.0.1:32000")
	var health string
	f := newMultipleImportedFixtureWithEntry(t, layout, entryMode, "off", "", func(h tun.Handler) tun.Handler {
		health = h.(*desktopNodeWGHandler).rules["tcp/"+api.Addr().String()].Target
		api.Handler = h
		front.Handler = api
		for key, rule := range h.(*desktopNodeWGHandler).rules {
			if rule.Network == "tcp" && key != "tcp/"+api.Addr().String() {
				if front.physicalNext != "" {
					t.Fatal("ambiguous original next encrypted route")
				}
				front.physicalNext = net.JoinHostPort(rule.Address, strconv.Itoa(rule.Port))
			}
		}
		front.faster = winner
		return front
	}, candidateRoute...)
	if entryMode != f.chain.ProofInventory()[0].Mode || f.members[0].prefix.mode != entryMode {
		t.Fatal("original packet peer and client identity disagree")
	}
	var originalPacketParameters string
	if entryMode == "awg2-fast" {
		readback := f.members[0].prefix.readback
		if readback == nil {
			t.Fatal("original AWG peer has no parameter readback")
		}
		digest, err := readback()
		if err != nil || len(digest) != 64 {
			t.Fatal("original AWG parameters", err)
		}
		originalPacketParameters = digest
	}
	pem := filepath.Join(t.TempDir(), "original-ca.pem")
	trust := f.ca
	if measured != nil && measured.replacement != nil {
		trust += "\n" + measured.replacement.ca
	}
	if err := os.WriteFile(pem, []byte(trust), 0600); err != nil {
		t.Fatal(err)
	}
	t.Setenv("SSL_CERT_FILE", pem)
	t.Setenv("SSL_CERT_DIR", filepath.Dir(pem))
	runOriginalSelectedOwner(t, f, api, front, health, mode, winner, measure, first, last, measured, start)
	if measured != nil && measured.replacement != nil {
		next := measured.replacement
		next.ctx = f.ctx
		next.physical = f.physical
		copy(next.members[:2], f.members[:2])
		next.source = f.source
		next.source.Nodes = append([]string(nil), f.source.Nodes...)
		next.source.IdentitySources = append([]string(nil), f.source.IdentitySources...)
		next.source.Nodes[2], next.source.IdentitySources[2] = measured.input, measured.final.identity
		var err error
		next.chain, err = mobilemultihop.NewNodeChain(desktopNodeChainJSON(t, next.source))
		if err != nil {
			t.Fatal("named replacement must compile the same measured final and original prefix", err)
		}
		t.Cleanup(func() {
			ctx, stop := context.WithTimeout(context.Background(), 3*time.Second)
			defer stop()
			if err := next.chain.CloseContext(ctx); err != nil {
				t.Error(err)
			}
		})
		oldPrivate := f.members[2].private.Load()
		beforeMiddle := f.members[1].provider.stats().Streams
		runOriginalSelectedOwner(t, next, api, front, health, mode, winner, "reloaded-private-final", 0, 0, measured, start)
		if f.members[2].private.Load() != oldPrivate || f.members[1].provider.stats().Streams <= beforeMiddle {
			t.Fatal("replacement touched the former final or skipped the retained imported member")
		}
		t.Log("RELOADED_PRIVATE_FINAL requested=auto winner=local original_prefix=true private=true dns=true application=true joined=true")
	}
	samples, transferred, responseSamples := 0, 0, 0
	if measure == "latency" {
		samples = (last - first + 1) * 50
	} else if measure == "throughput" {
		transferred = count * (16 << 20)
	} else if measure == "response" {
		responseSamples = 6
	}
	if entryMode == "awg2-fast" {
		current, err := f.members[0].prefix.readback()
		if err != nil || current != originalPacketParameters {
			t.Fatal("selected execution replaced original AWG parameters", err)
		}
		t.Logf("QUALIFIED_SELECTED_NATIVE nodes=%d execution=%s winner=%s samples=%d bytes=%d first=%d last=%d response_samples=%d entry_mode=awg2-fast parameters_current=true", count, mode, winner, samples, transferred, first, last, responseSamples)
	} else {
		t.Logf("QUALIFIED_SELECTED_NATIVE nodes=%d execution=%s winner=%s samples=%d bytes=%d first=%d last=%d response_samples=%d", count, mode, winner, samples, transferred, first, last, responseSamples)
	}
}

// A second named profile receives its own private manager, listener generation,
// selected Box and lease. All of the preceding owners must join before it starts.
func runOriginalSelectedOwner(t *testing.T, f *multipleImportedFixture, api, front *extendedWGFront, health, mode, winner, measure string, first, last int, measured *selectedResponseNativeCase, start ExtendedWorkerFactory) {
	t.Helper()
	policy := originalServerPolicy(t, f)
	var prep *mobilemultihop.NodeChainExecutionPreparation
	var err error
	if f.source.Schema == 2 {
		prep, err = mobilemultihop.NewNodeChainExecutionPreparation(desktopNodeChainJSON(t, f.source), mode)
	} else {
		prep, err = mobilemultihop.NewNodeChainMultipleImportedExecutionPreparation(f.chain, mode)
	}
	if err != nil {
		t.Fatal(err)
	}
	disc, err := prep.Discovery()
	if err != nil {
		t.Fatal(err)
	}
	mgr, err := multihoprelay.New(multihoprelay.Config{ListenIP: front.address.Addr().String(), FirstPort: 32000, LastPort: 32007, TTLSeconds: 90, NodeChains: []multihoprelay.NodeChainDescriptor{policy.Descriptor()}}, disc.Entry.NodeID, &extendedRuntimeWorker{start: start, base: originalServerBase(f, policy), source: policy.Source(), listener: front})
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
		defer cancel()
		if err := mgr.Close(ctx); err != nil {
			t.Error(err)
		}
	}()
	admin := &nativeImportedAdmin{relay: mgr, token: disc.Token, api: api.address.Addr(), peer: netip.MustParseAddr("10.80.0.2")}
	admin.cfg.NodeID = disc.Entry.NodeID
	healthTarget, err := url.Parse("http://" + health)
	if err != nil {
		t.Fatal(err)
	}
	var get, put, post, remove atomic.Int64
	handler := http.NewServeMux()
	handler.HandleFunc(nativeImportedLeasePath, func(w http.ResponseWriter, r *http.Request) {
		switch r.Method {
		case http.MethodGet:
			get.Add(1)
		case http.MethodPut:
			put.Add(1)
		case http.MethodPost:
			post.Add(1)
		case http.MethodDelete:
			remove.Add(1)
		}
		admin.multihopNodeChainLease(w, r)
	})
	handler.Handle("/", httputil.NewSingleHostReverseProxy(healthTarget))
	server := &http.Server{Handler: handler, ReadHeaderTimeout: 2 * time.Second}
	joined := make(chan error, 1)
	var listener net.Listener = api
	if measured != nil {
		listener = api.listen()
	}
	go func() { joined <- server.Serve(listener) }()
	defer func() {
		_ = server.Close()
		if err := <-joined; !errors.Is(err, http.ErrServerClosed) {
			t.Error(err)
		}
	}()
	runExtendedSelectedClient(t, f, prep, policy, front, mode, winner, measure, first, last, measured)
	if get.Load() == 0 || put.Load() == 0 || post.Load() == 0 || remove.Load() == 0 {
		t.Fatal("incomplete original private lease lifecycle")
	}
	if generation := front.generation.Load(); generation == nil || generation.count.Load() == 0 {
		t.Fatal("missing actual WG connection to the authenticated front")
	} else {
		select {
		case <-generation.closed:
		default:
			t.Fatal("native worker stopped without joining its original private listener")
		}
	}
}

// The candidate provider freezes its own listener, independent DNS responder,
// private identity, public TLS target and application endpoint before either client starts.
func (c *selectedResponseNativeCase) createReplacementPeer(t *testing.T) {
	t.Helper()
	final := &multipleImportedMember{position: 2, publicIP: "203.0.113.198", entered: make(chan struct{}, 1)}
	next := &multipleImportedFixture{members: []*multipleImportedMember{nil, nil, final}}
	cert, trust := desktopNodeChainImportedCertificate(t, net.ParseIP("1.0.0.1"))
	roots := x509.NewCertPool()
	if !roots.AppendCertsFromPEM([]byte(trust)) {
		t.Fatal("missing replacement TLS trust")
	}
	next.ca, next.tls = trust, &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}
	public := next.publicServer(t, final, &cert)
	app := desktopImportedWGSSHTTP(t, nil, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodGet || r.Host != selectedPrivateApplication || r.URL.RequestURI() != "/adopted" || r.Header.Get("Authorization") != "" {
			http.Error(w, "foreign request", 403)
			return
		}
		c.app.Add(1)
		_, _ = w.Write([]byte("independent measured final"))
	}))
	c.final.health = func() { final.private.Add(1) }
	c.final.routes = []desktopNodeLayerRoute{{"tcp", "1.1.1.1:443", public}, {"tcp", "1.0.0.1:443", public}, {"udp", "192.168.50.133:53", next.dnsServer(t)}, {"tcp", selectedPrivateApplication, app}}
	c.replacement = next
}

func originalServerPolicy(t *testing.T, f *multipleImportedFixture) *mobilemultihop.NodeChainServerPolicy {
	entry := f.chain.ProofInventory()[0]
	source := mobilemultihop.NodeChainServerSource{Schema: f.source.Schema, EntryID: entry.ProfileID, EntryNodeID: entry.NodeID, EntryMode: entry.Mode, Nodes: append([]string(nil), f.source.Nodes[1:]...), IdentitySources: append([]string(nil), f.source.IdentitySources[1:]...)}
	// The real Server final uses its own private identity, while retaining the
	// same peer public key, original SS endpoint and authenticated final node.
	last := len(source.Nodes) - 1
	var finalIdentity map[string]string
	if json.Unmarshal([]byte(source.IdentitySources[last]), &finalIdentity) != nil {
		t.Fatal("missing final companion")
	}
	key := sha256.Sum256([]byte("independent encrypted suffix fixture final identity"))
	wg, e := base64.StdEncoding.DecodeString(finalIdentity["wg.conf"])
	if e != nil {
		t.Fatal(e)
	}
	lines := strings.Split(string(wg), "\n")
	changed := 0
	for i, line := range lines {
		if strings.HasPrefix(strings.TrimSpace(strings.ToLower(line)), "privatekey") {
			lines[i] = "PrivateKey=" + base64.StdEncoding.EncodeToString(key[:])
			changed++
		}
	}
	if changed != 1 {
		t.Fatal("ambiguous final key")
	}
	finalIdentity["wg.conf"] = base64.StdEncoding.EncodeToString([]byte(strings.Join(lines, "\n")))
	source.IdentitySources[last] = desktopNodeChainJSON(t, finalIdentity)
	compile := mobilemultihop.NewNodeChainMultipleImportedServerPolicy
	if source.Schema == 2 {
		compile = mobilemultihop.NewNodeChainServerPolicy
	}
	policy, e := compile(desktopNodeChainJSON(t, source))
	if e != nil {
		t.Fatal("compiled operator suffix", e)
	}
	return policy
}
func originalServerBase(f *multipleImportedFixture, policy *mobilemultihop.NodeChainServerPolicy) context.Context {
	ins, outs, ends := inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry()
	outbound.Register[option.ShadowsocksOutboundOptions](outs, "shadowsocks", func(ctx context.Context, r adapter.Router, l log.ContextLogger, tag string, o option.ShadowsocksOutboundOptions) (adapter.Outbound, error) {
		if tag != policy.ProofInventory()[0].Tag {
			if o.Detour == "" {
				return nil, errors.New("later suffix skipped its predecessor")
			}
			return SS.NewOutbound(ctx, r, l, tag, o)
		}
		if o.Detour != "" {
			return nil, errors.New("unexpected physical detour")
		}
		ctx = service.ExtendContext(ctx)
		lower := &desktopSSReferenceLower{virtual: f.members[1].virtual, original: f.members[1].physical}
		ctx = service.ContextWith[adapter.OutboundManager](ctx, &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}})
		ctx = service.ContextWith[adapter.NetworkManager](ctx, &desktopImportedPacketNetwork{})
		o.Detour = "captured-physical"
		actual, e := SS.NewOutbound(ctx, r, l, tag, o)
		if e != nil {
			return nil, e
		}
		return &multipleImportedPhysicalSS{actual.(*SS.Outbound)}, nil
	})
	transports := BDNS.NewTransportRegistry()
	DNST.RegisterUDP(transports)
	DNST.RegisterTCP(transports)
	ctx := service.ContextWithRegistry(f.ctx, service.NewRegistry())
	ctx = service.ContextWith[adapter.PlatformInterface](ctx, &multipleImportedPlatform{})
	ctx = box.Context(ctx, ins, outs, ends, transports, boxservice.NewRegistry(), certificate.NewRegistry())
	return ctx
}
