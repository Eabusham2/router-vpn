// The transparent WG device exposes real original TCP endpoints to the
// ordinary HTTP and authenticated Server listeners inside this component.
// Only the selected private WG port is eligible for a new lease generation.
type extendedWGFront struct {
	tun.Handler
	address              netip.AddrPort
	accepted             chan net.Conn
	closed               chan struct{}
	once                 sync.Once
	count                atomic.Uint64
	physicalNext, faster string
	generation           atomic.Pointer[extendedWGFront]
}

func (s *extendedWGFront) Addr() net.Addr { return net.TCPAddrFromAddrPort(s.address) }
func (s *extendedWGFront) Close() error   { s.once.Do(func() { close(s.closed) }); return nil }
func (s *extendedWGFront) Accept() (net.Conn, error) {
	select {
	case c := <-s.accepted:
		return c, nil
	case <-s.closed:
		return nil, net.ErrClosed
	}
}
func (s *extendedWGFront) JudgeFlow(protocol uint8, source, destination netip.AddrPort, z []byte) tun.FlowVerdict {
	if protocol == 6 && destination == s.address {
		return tun.FlowVerdict{Action: tun.ActionAccept}
	}
	return s.Handler.JudgeFlow(protocol, source, destination, z)
}

// The transparent gVisor endpoint exposes the packet source as LocalAddr.
// Present the socket to its listening server with the accepted orientation.
type extendedWGAccepted struct{ net.Conn }

func (c extendedWGAccepted) LocalAddr() net.Addr  { return c.Conn.RemoteAddr() }
func (c extendedWGAccepted) RemoteAddr() net.Addr { return c.Conn.LocalAddr() }

// Compare measures both real routes. Give the slower fixture link enough
// independent latency to separate it from normal scheduling jitter in a
// sixteen-peer race-instrumented graph. Native operation deadlines stay fixed.
const extendedSlowLinkDelay = 150 * time.Millisecond

func (s *extendedWGFront) NewConnectionEx(ctx context.Context, c net.Conn, src, dst M.Socksaddr, done N.CloseHandlerFunc) {
	if dst.AddrPort() != s.address {
		if s.faster == "server" && dst.String() == s.physicalNext {
			time.Sleep(extendedSlowLinkDelay)
		}
		s.Handler.NewConnectionEx(ctx, c, src, dst, done)
		return
	}
	if generation := s.generation.Load(); generation != nil {
		s = generation
	} else if s.physicalNext != "" {
		_ = c.Close()
		return
	}
	if s.faster == "local" {
		time.Sleep(extendedSlowLinkDelay)
	}
	if src.Addr != netip.MustParseAddr("10.80.0.2") || M.SocksaddrFromNet(c.LocalAddr()) != src || M.SocksaddrFromNet(c.RemoteAddr()) != dst || done != nil {
		_ = c.Close()
		if done != nil {
			done(net.ErrClosed)
		}
		return
	}
	select {
	case <-s.closed:
		_ = c.Close()
	case <-ctx.Done():
		_ = c.Close()
	case s.accepted <- extendedWGAccepted{c}:
		s.count.Add(1)
	}
}
func (s *extendedWGFront) listen() net.Listener {
	next := &extendedWGFront{address: s.address, accepted: make(chan net.Conn), closed: make(chan struct{}), faster: s.faster}
	s.generation.Store(next)
	return next
}

type ExtendedWorkerFactory func(context.Context, context.Context, string, multihoprelay.NodeChainCapture, net.Listener) (multihoprelay.NodeChainProcess, error)
type extendedOwnedWorker struct {
	checked atomic.Bool
	capture multihoprelay.NodeChainCapture
	process multihoprelay.NodeChainProcess
}
type extendedRuntimeWorker struct {
	observed atomic.Pointer[extendedOwnedWorker]
	start    ExtendedWorkerFactory
	base     context.Context
	listener net.Listener
	source   string
}

func (r *extendedRuntimeWorker) Start(context.Context, []byte, multihoprelay.Lease) (multihoprelay.Process, error) {
	return nil, errors.New("foreign relay owner")
}
func (r *extendedRuntimeWorker) StartChain(ctx context.Context, c multihoprelay.NodeChainCapture) (multihoprelay.NodeChainProcess, error) {
	proc, err := r.start(ctx, r.base, r.source, c, r.listener.(*extendedWGFront).listen())
	if err == nil {
		r.observed.Store(&extendedOwnedWorker{capture: c, process: proc})
	}
	return proc, err
}
func RunExtendedOriginalWorker(t *testing.T, count int, entryMode, mode, winner, measure string, first, last, privatePosition int, start ExtendedWorkerFactory) {
	t.Helper()
	var layout multipleImportedLayout
	for _, v := range multipleImportedLayouts {
		if v.count == count {
			layout = v
		}
	}
	privateStream := privatePosition > 0
	negative := privateStream && strings.HasPrefix(measure, "wrong-")
	if privateStream {
		if privatePosition < 2 || privatePosition >= count-1 || entryMode != "wg" {
			t.Fatal("invalid original selected private stream")
		}
		var imports []int
		for i := 1; i < count-1; i++ {
			if i != privatePosition {
				imports = append(imports, i)
			}
		}
		layout = multipleImportedLayout{"selected-private-stream", count, imports}
	}
	if layout.count <= 8 && !privateStream {
		t.Fatal("missing longer original fixture")
	}
	socket := func(addr string) *extendedWGFront {
		return &extendedWGFront{address: netip.MustParseAddrPort(addr), accepted: make(chan net.Conn), closed: make(chan struct{})}
	}
	api, front := socket("10.80.0.1:8787"), socket("10.80.0.1:32000")
	var health string
	var privatePositions []int
	fault := ""
	if privateStream {
		privatePositions = []int{privatePosition}
	}
	if measure == "wrong-key" {
		fault = "wrong-interior-key"
	}
	f := newMultipleImportedHostnameFixture(t, layout, entryMode, "off", fault, func(h tun.Handler) tun.Handler {
		health = h.(*desktopNodeWGHandler).rules["tcp/"+api.Addr().String()].Target
		api.Handler = h
		front.Handler = api
		for key, rule := range h.(*desktopNodeWGHandler).rules {
			if rule.Network == "tcp" && key != "tcp/"+api.Addr().String() {
				if front.physicalNext != "" {
					t.Fatal("ambiguous original next encrypted route")
				}
				front.physicalNext = net.JoinHostPort(rule.Address, strconv.Itoa(rule.Port))
			}
		}
		front.faster = winner
		return front
	}, privatePositions, nil)
	if privateStream {
		if measure == "wrong-public" {
			f.members[1].wrong.Store(true)
		}
		if measure == "wrong-exit" {
			f.members[count-1].invalidTrace.Store(true)
		}
		if measure == "wrong-identity" {
			f.members[privatePosition].wrong.Store(true)
		}
		if measure == "wrong-dns" {
			f.badDNS.Store(true)
		}
	}
	if entryMode != f.chain.ProofInventory()[0].Mode || f.members[0].prefix.mode != entryMode {
		t.Fatal("original packet peer and client identity disagree")
	}
	var originalPacketParameters string
	if entryMode == "awg2-fast" || entryMode == "awg2-strong" {
		readback := f.members[0].prefix.readback
		if readback == nil {
			t.Fatal("original AWG peer has no parameter readback")
		}
		digest, err := readback()
		if err != nil || len(digest) != 64 {
			t.Fatal("original AWG parameters", err)
		}
		originalPacketParameters = digest
	}
	policy := originalServerPolicy(t, f)
	prep, err := mobilemultihop.NewNodeChainMultipleImportedExecutionPreparation(f.chain, mode)
	if err != nil {
		t.Fatal(err)
	}
	disc, err := prep.Discovery()
	if err != nil {
		t.Fatal(err)
	}
	pem := filepath.Join(t.TempDir(), "original-ca.pem")
	if err = os.WriteFile(pem, []byte(f.ca), 0600); err != nil {
		t.Fatal(err)
	}
	t.Setenv("SSL_CERT_FILE", pem)
	t.Setenv("SSL_CERT_DIR", filepath.Dir(pem))
	worker := &extendedRuntimeWorker{start: start, base: originalServerBase(f, policy), source: policy.Source(), listener: front}
	mgr, err := multihoprelay.New(multihoprelay.Config{ListenIP: front.address.Addr().String(), FirstPort: 32000, LastPort: 32007, TTLSeconds: 90, NodeChains: []multihoprelay.NodeChainDescriptor{policy.Descriptor()}}, disc.Entry.NodeID, worker)
	if err != nil {
		t.Fatal(err)
	}
	defer func() {
		ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
		defer cancel()
		if err := mgr.Close(ctx); err != nil {
			t.Error(err)
		}
	}()
	admin := &nativeImportedAdmin{relay: mgr, token: disc.Token, api: api.address.Addr(), peer: netip.MustParseAddr("10.80.0.2")}
	admin.cfg.NodeID = disc.Entry.NodeID
	healthTarget, err := url.Parse("http://" + health)
	if err != nil {
		t.Fatal(err)
	}
	var get, put, post, remove atomic.Int64
	var testedOwners atomic.Int64
	var drainChecked atomic.Bool
	handler := http.NewServeMux()
	handler.HandleFunc(nativeImportedLeasePath, func(w http.ResponseWriter, r *http.Request) {
		switch r.Method {
		case http.MethodGet:
			get.Add(1)
		case http.MethodPut:
			put.Add(1)
		case http.MethodPost:
			post.Add(1)
			if privateStream && !negative {
				if current := worker.observed.Load(); current != nil && current.checked.CompareAndSwap(false, true) {
					if err := provePrivateStreamOwner(r.Context(), mgr, current); err != nil {
						t.Error(err)
						http.Error(w, "lease ownership check failed", http.StatusConflict)
						return
					}
					testedOwners.Add(1)
				}
			}
		case http.MethodDelete:
			remove.Add(1)
			if privateStream && measure == "drain" && drainChecked.CompareAndSwap(false, true) {
				if err := holdPrivateStreamRetirement(r.Context(), mgr, worker.observed.Load()); err != nil {
					t.Error(err)
					http.Error(w, "held child teardown failed", http.StatusConflict)
					return
				}
			}
		}
		admin.multihopNodeChainLease(w, r)
	})
	handler.Handle("/", httputil.NewSingleHostReverseProxy(healthTarget))
	server := &http.Server{Handler: handler, ReadHeaderTimeout: 2 * time.Second}
	joined := make(chan error, 1)
	go func() { joined <- server.Serve(api) }()
	defer func() {
		_ = server.Close()
		if err := <-joined; !errors.Is(err, http.ErrServerClosed) {
			t.Error(err)
		}
	}()
	runExtendedSelectedClient(t, f, prep, policy, front, mode, winner, measure, first, last, privatePosition)
	if privateStream {
		if get.Load() == 0 || put.Load() == 0 {
			t.Fatal("no real lease discovery and acquisition")
		}
		wantOwners := int64(1)
		if mode == "auto" && winner == "server" {
			wantOwners = 2
		}
		if negative {
			if measure == "wrong-key" && f.members[privatePosition].provider.stats().AuthTCP == 0 || measure == "wrong-identity" && f.members[privatePosition].private.Load() == 0 || measure == "wrong-dns" && f.dns.Load() == 0 {
				t.Fatal("invalid original private stream or DNS never exercised its actual peer")
			}
			if measure == "wrong-public" && (f.members[1].public.Load() == 0 || f.members[privatePosition].private.Load() != 0) || measure == "wrong-exit" && (f.members[count-1].public.Load() == 0 || f.dns.Load() == 0) || measure == "wrong-dns" && f.members[count-1].public.Load() != 0 {
				t.Fatal("public-prefix or final DNS/exit refusal escaped its original position")
			}
			if measure != "wrong-dns" && measure != "wrong-exit" && (f.members[count-1].private.Load() != 0 || f.dns.Load() != 0) {
				t.Fatal("wrong intermediate reached the final")
			}
		} else if testedOwners.Load() != wantOwners || measure == "drain" && !drainChecked.Load() || post.Load() == 0 || remove.Load() == 0 || f.members[1].public.Load() == 0 || f.members[privatePosition].private.Load() == 0 || f.members[count-1].private.Load() == 0 || f.dns.Load() == 0 {
			t.Fatal("private stream lost a route, proof, lease or joined deletion")
		}
		generation := front.generation.Load()
		if generation == nil || !negative && generation.count.Load() == 0 {
			t.Fatal("missing original WireGuard listener or authenticated front connection")
		}
		select {
		case <-generation.closed:
		default:
			t.Fatal("child retained its original WireGuard front after teardown")
		}
		samples, transferred := 0, 0
		switch measure {
		case "response":
			samples = 6
		case "latency":
			samples = (last - first + 1) * 50
		case "throughput":
			transferred = count * (16 << 20)
		}
		if !negative {
			for i := 1; i < count-1; i++ {
				if i != privatePosition && (!f.members[i].imported || f.members[i].public.Load() == 0) {
					t.Fatal("missing original public prefix", i)
				}
			}
			if f.members[count-1].public.Load() == 0 {
				t.Fatal("missing original public exit proof")
			}
		}
		t.Logf("SELECTED_PRIVATE_STREAM_NATIVE nodes=%d private=%d mode=%s winner=%s operation=%s rejected=%t samples=%d bytes=%d first=%d last=%d", count, privatePosition, mode, winner, measure, negative, samples, transferred, first, last)
		if !negative {
			t.Log("PRIVATE_STREAM_OWNER foreign_peer_session_epoch_refused=true")
		}
		if measure == "drain" {
			t.Log("PRIVATE_STREAM_DRAIN cancelled_delete_retained=true replacement_refused=true original_joined=true")
		}
		return
	}
	if get.Load() == 0 || put.Load() == 0 || post.Load() == 0 || remove.Load() == 0 {
		t.Fatal("incomplete original private lease lifecycle")
	}
	if generation := front.generation.Load(); generation == nil || generation.count.Load() == 0 {
		t.Fatal("missing actual WG connection to the authenticated front")
	} else {
		select {
		case <-generation.closed:
		default:
			t.Fatal("native worker stopped without joining its original private listener")
		}
	}
	samples, transferred, responseSamples := 0, 0, 0
	if measure == "latency" {
		samples = (last - first + 1) * 50
	} else if measure == "throughput" {
		transferred = count * (16 << 20)
	} else if measure == "response" {
		responseSamples = 6
	}
	if entryMode == "awg2-fast" || entryMode == "awg2-strong" {
		current, err := f.members[0].prefix.readback()
		if err != nil || current != originalPacketParameters {
			t.Fatal("selected execution replaced original AWG parameters", err)
		}
		t.Logf("QUALIFIED_SELECTED_NATIVE nodes=%d execution=%s winner=%s samples=%d bytes=%d first=%d last=%d response_samples=%d entry_mode=%s parameters_current=true", count, mode, winner, samples, transferred, first, last, responseSamples, entryMode)
	} else {
		t.Logf("QUALIFIED_SELECTED_NATIVE nodes=%d execution=%s winner=%s samples=%d bytes=%d first=%d last=%d response_samples=%d", count, mode, winner, samples, transferred, first, last, responseSamples)
	}
}

// Check the live manager before the valid request can renew the same worker.
func provePrivateStreamOwner(ctx context.Context, mgr *multihoprelay.Manager, owner *extendedOwnedWorker) error {
	peer := netip.MustParseAddr(owner.capture.Peer)
	session, epoch := owner.capture.Request.Clone(), owner.capture.Request.Clone()
	session.SessionID = strings.Repeat("e", len(session.SessionID))
	epoch.Epoch = strings.Repeat("e", len(epoch.Epoch))
	if session.SessionID == owner.capture.Request.SessionID || epoch.Epoch == owner.capture.Request.Epoch {
		return errors.New("foreign ownership control reused its original")
	}
	for _, input := range []struct {
		peer netip.Addr
		q    multihoprelay.NodeChainRequest
	}{
		{peer, session}, {peer, epoch}, {netip.MustParseAddr("10.80.0.3"), owner.capture.Request},
	} {
		_, status := mgr.ChainStatus(ctx, input.peer, input.q, strings.Repeat("a", 64))
		remove := mgr.DeleteChain(ctx, input.peer, input.q)
		if !errors.Is(status, multihoprelay.ErrOwnership) || !errors.Is(remove, multihoprelay.ErrOwnership) || !owner.process.Alive() {
			return errors.New("stale session, changed epoch or foreign peer inherited a live child")
		}
	}
	return nil
}

func holdPrivateStreamRetirement(ctx context.Context, mgr *multihoprelay.Manager, owner *extendedOwnedWorker) error {
	if owner == nil {
		return errors.New("missing genuine remote process")
	}
	child, ok := owner.process.(interface {
		HoldStop() (<-chan struct{}, func())
	})
	if !ok {
		return errors.New("native child lacks held-stop control")
	}
	entered, release := child.HoldStop()
	defer release()
	peer := netip.MustParseAddr(owner.capture.Peer)
	wait, cancel := context.WithCancel(ctx)
	result := make(chan error, 1)
	go func() { result <- mgr.DeleteChain(wait, peer, owner.capture.Request) }()
	select {
	case <-entered:
	case <-ctx.Done():
		cancel()
		<-result
		return ctx.Err()
	}
	cancel()
	if err := <-result; err == nil || !owner.process.Alive() {
		return errors.New("cancelled deletion lost its live native child")
	}
	fresh := owner.capture.Request.Clone()
	fresh.SessionID = strings.Repeat("f", len(fresh.SessionID))
	fresh.AcquireExpiresAt = time.Now().Add(3 * time.Second).Unix()
	if fresh.SessionID == owner.capture.Request.SessionID {
		return errors.New("replacement reused the old session")
	}
	bounded, done := context.WithTimeout(ctx, 150*time.Millisecond)
	defer done()
	_, err := mgr.CreateChain(bounded, peer, fresh)
	if err == nil || (!errors.Is(err, multihoprelay.ErrBusy) && !strings.Contains(err.Error(), "teardown unverified")) || !owner.process.Alive() {
		return errors.New("replacement escaped an unjoined original process")
	}
	return nil
}

func originalServerPolicy(t *testing.T, f *multipleImportedFixture) *mobilemultihop.NodeChainServerPolicy {
	entry := f.chain.ProofInventory()[0]
	source := mobilemultihop.NodeChainServerSource{Schema: 6, EntryID: entry.ProfileID, EntryNodeID: entry.NodeID, EntryMode: entry.Mode, Nodes: append([]string(nil), f.source.Nodes[1:]...), IdentitySources: append([]string(nil), f.source.IdentitySources[1:]...)}
	// The real Server final uses its own private identity, while retaining the
	// same peer public key, original SS endpoint and authenticated final node.
	last := len(source.Nodes) - 1
	positions := []int{last}
	for i, proof := range f.chain.ProofInventory() {
		if i > 0 && i < len(f.members)-1 && !f.members[i].imported && proof.Mode == "shadowsocks" {
			positions = append(positions, i-1)
		}
	}
	for _, pos := range positions {
		var finalIdentity map[string]string
		if json.Unmarshal([]byte(source.IdentitySources[pos]), &finalIdentity) != nil {
			t.Fatal("missing final companion")
		}
		seed := "independent encrypted suffix fixture final identity"
		if pos != last {
			seed = "independent encrypted private stream identity"
		}
		key := sha256.Sum256([]byte(seed))
		wg, e := base64.StdEncoding.DecodeString(finalIdentity["wg.conf"])
		if e != nil {
			t.Fatal(e)
		}
		lines := strings.Split(string(wg), "\n")
		changed := 0
		for i, line := range lines {
			if strings.HasPrefix(strings.TrimSpace(strings.ToLower(line)), "privatekey") {
				lines[i] = "PrivateKey=" + base64.StdEncoding.EncodeToString(key[:])
				changed++
			}
		}
		if changed != 1 {
			t.Fatal("ambiguous final key")
		}
		finalIdentity["wg.conf"] = base64.StdEncoding.EncodeToString([]byte(strings.Join(lines, "\n")))
		source.IdentitySources[pos] = desktopNodeChainJSON(t, finalIdentity)
	}
	policy, e := mobilemultihop.NewNodeChainMultipleImportedServerPolicy(desktopNodeChainJSON(t, source))
	if e != nil {
		t.Fatal("compiled operator suffix", e)
	}
	return policy
}
func originalServerBase(f *multipleImportedFixture, policy *mobilemultihop.NodeChainServerPolicy) context.Context {
	ins, outs, ends := inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry()
	outbound.Register[option.ShadowsocksOutboundOptions](outs, "shadowsocks", func(ctx context.Context, r adapter.Router, l log.ContextLogger, tag string, o option.ShadowsocksOutboundOptions) (adapter.Outbound, error) {
		if tag != policy.ProofInventory()[0].Tag {
			if o.Detour == "" {
				return nil, errors.New("later suffix skipped its predecessor")
			}
			return SS.NewOutbound(ctx, r, l, tag, o)
		}
		if o.Detour != "" {
			return nil, errors.New("unexpected physical detour")
		}
		ctx = service.ExtendContext(ctx)
		lower := &desktopSSReferenceLower{virtual: f.members[1].virtual, original: f.members[1].physical}
		ctx = service.ContextWith[adapter.OutboundManager](ctx, &desktopSSReferenceManager{owners: map[string]adapter.Outbound{"captured-physical": lower}})
		ctx = service.ContextWith[adapter.NetworkManager](ctx, &desktopImportedPacketNetwork{})
		o.Detour = "captured-physical"
		actual, e := SS.NewOutbound(ctx, r, l, tag, o)
		if e != nil {
			return nil, e
		}
		return &multipleImportedPhysicalSS{actual.(*SS.Outbound)}, nil
	})
	transports := BDNS.NewTransportRegistry()
	DNST.RegisterUDP(transports)
	DNST.RegisterTCP(transports)
	ctx := service.ContextWithRegistry(f.ctx, service.NewRegistry())
	ctx = service.ContextWith[adapter.PlatformInterface](ctx, &multipleImportedPlatform{})
	ctx = box.Context(ctx, ins, outs, ends, transports, boxservice.NewRegistry(), certificate.NewRegistry())
	return ctx
}
