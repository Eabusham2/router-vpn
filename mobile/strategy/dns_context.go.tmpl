package dns

import (
	"context"
	"github.com/sagernet/sing-box/adapter"
)

func (m *TransportManager) RouterVPNTransportContext(ctx context.Context, tag string) (adapter.DNSTransport, bool, error) {
	if err := adapter.RouterVPNRLockContext(ctx, &m.access); err != nil {
		return nil, false, err
	}
	value, found := m.transportByTag[tag]
	m.access.RUnlock()
	if err := ctx.Err(); err != nil {
		return nil, false, err
	}
	return value, found, nil
}
