package libbox

import (
	"context"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing/common/control"
)

func (m *platformDefaultInterfaceMonitor) RouterVPNDefaultInterfaceContext(ctx context.Context) (*control.Interface, error) {
	if err := adapter.RouterVPNLockContext(ctx, &m.defaultInterfaceAccess); err != nil {
		return nil, err
	}
	defer m.defaultInterfaceAccess.Unlock()
	return m.defaultInterface, ctx.Err()
}
