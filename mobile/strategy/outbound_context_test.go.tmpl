package outbound

import (
	"context"
	"errors"
	"github.com/sagernet/sing-box/adapter"
	"sync"
	"testing"
	"time"
)

// The first Err call captures nil before signaling. Cancellation therefore
// happens after admission begins, even when the implementation is changed to
// an incorrect precheck followed by a blocking mutex acquisition.
type routerVPNEnteredObservationContext struct {
	context.Context
	once    sync.Once
	entered chan struct{}
}

func (c *routerVPNEnteredObservationContext) Err() error {
	err := c.Context.Err()
	c.once.Do(func() { close(c.entered) })
	return err
}

func TestRouterVPNManagerObservationRetainsCaller(t *testing.T) {
	m := &Manager{outboundByTag: map[string]adapter.Outbound{"captured": nil}}
	m.access.Lock()
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	entered := make(chan struct{})
	ctx = &routerVPNEnteredObservationContext{Context: ctx, entered: entered}
	done := make(chan error, 1)
	go func() { _, _, err := m.RouterVPNOutboundContext(ctx, "captured"); done <- err }()
	select {
	case <-entered:
	case <-time.After(time.Second):
		m.access.Unlock()
		cancel()
		<-done
		t.Fatal("native observation did not enter the original caller context")
	}
	cancel()
	select {
	case err := <-done:
		m.access.Unlock()
		if !errors.Is(err, context.Canceled) {
			t.Fatal("original observation cancellation lost", err)
		}
	case <-time.After(time.Second):
		m.access.Unlock()
		<-done
		t.Fatal("cancelled native observation waited on manager lock")
	}
	if _, found, err := m.RouterVPNOutboundContext(context.Background(), "captured"); err != nil || !found {
		t.Fatal("expired observer changed captured manager state", found, err)
	}
	expired, stop := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
	defer stop()
	if _, _, err := m.RouterVPNOutboundContext(expired, "captured"); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatal("expired caller deadline renewed", err)
	}
}
