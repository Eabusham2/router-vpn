package adapter

import (
	"context"
	"errors"
	"sync"
	"time"
)

// RouterVPNLockContext retains the caller's deadline while observing a manager.
// A timed-out observer never owns a detached waiter or unlocks another caller.
func RouterVPNLockContext(ctx context.Context, mu *sync.Mutex) error {
	return routerVPNObserveLock(ctx, mu.TryLock, mu.Unlock)
}
func RouterVPNWriteLockContext(ctx context.Context, mu *sync.RWMutex) error {
	return routerVPNObserveLock(ctx, mu.TryLock, mu.Unlock)
}
func RouterVPNRLockContext(ctx context.Context, mu *sync.RWMutex) error {
	return routerVPNObserveLock(ctx, mu.TryRLock, mu.RUnlock)
}
func routerVPNObserveLock(ctx context.Context, acquire func() bool, release func()) error {
	if ctx == nil {
		return errors.New("native observation has no caller context")
	}
	for {
		if err := ctx.Err(); err != nil {
			return err
		}
		if acquire() {
			if err := ctx.Err(); err != nil {
				release()
				return err
			}
			return nil
		}
		timer := time.NewTimer(time.Millisecond)
		select {
		case <-ctx.Done():
			timer.Stop()
			return ctx.Err()
		case <-timer.C:
		}
	}
}

func RouterVPNInboundContext(ctx context.Context, manager InboundManager, tag string) (Inbound, bool, error) {
	if ctx == nil {
		return nil, false, errors.New("native inbound observation has no caller")
	}
	if err := ctx.Err(); err != nil {
		return nil, false, err
	}
	reader, ok := manager.(interface {
		RouterVPNGetContext(context.Context, string) (Inbound, bool, error)
	})
	if !ok {
		return nil, false, errors.New("native inbound manager has no bounded observation")
	}
	result, found, err := reader.RouterVPNGetContext(ctx, tag)
	if err != nil {
		return nil, false, err
	}
	if err := ctx.Err(); err != nil {
		return nil, false, err
	}
	return result, found, nil
}

