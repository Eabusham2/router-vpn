	routerImportedCONNECTLayerSources(t, "ROUTERVPN_CONNECT_LAYER_FIXTURES", false)
}
func TestRouterImportedCONNECTAndroidLayerGraphs(t *testing.T) {
	routerImportedCONNECTLayerSources(t, "ROUTERVPN_ANDROID_CONNECT_LAYER_FIXTURES", true)
