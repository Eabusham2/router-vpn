	root := os.Getenv("ROUTERVPN_APPLE_CONNECT_LAYER_FIXTURES")
	if root == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IOS_IMPORTED_ROUTER_GRAPHS") == "1" {
