func routerImportedOpenVPNNames() map[string]bool {
	expected := map[string]bool{}
	for _, network := range []string{"tcp", "udp"} {
		for _, mode := range []string{"shadowsocks", "hysteria2", "wg", "awg2-fast", "awg2-strong"} {
			for _, a := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				for _, b := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
					expected["openvpn--"+network+"--final-"+mode+"--"+a+"--"+b+".json"] = true
				}
			}
		}
	}
	return expected
}

// This gate parses configured UoT graphs; it never starts an encrypted peer or
// upgrades configured receiver authority into live connection evidence.
func TestRouterImportedCONNECTConfiguredServiceGraphs(t *testing.T) {
	root := os.Getenv("ROUTERVPN_CONNECT_SERVICE_FIXTURES")
	if root == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_ENTRY_FIXTURES") == "1" {
			t.Fatal("configured CONNECT service sources absent")
		}
		t.Skip("configured service compiler fixtures supplied by parser gate")
	}
	expected := map[string]bool{}
	for _, entry := range []string{"http-connect", "https-connect"} {
		for _, layer := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, mode := range []string{"home", "custom"} {
				for _, transport := range []string{"udp", "tcp"} {
					expected[entry+"--"+layer+"--"+mode+"--"+transport+".json"] = true
				}
			}
		}
	}
	entries, err := os.ReadDir(root)
	if err != nil || len(entries) != len(expected) {
		t.Fatal("incomplete configured CONNECT source matrix", err)
	}
	for _, entry := range entries {
		t.Run(entry.Name(), func(t *testing.T) {
			if !expected[entry.Name()] || entry.Type()&os.ModeSymlink != 0 || entry.IsDir() {
				t.Fatal("foreign configured source")
			}
			raw, err := os.ReadFile(filepath.Join(root, entry.Name()))
			if err != nil {
				t.Fatal(err)
			}
			var source []string
			if json.Unmarshal(raw, &source) != nil || len(source) != 9 {
				t.Fatal("invalid configured source capture")
			}
			plan, err := NewRouterImportedEntryMultihop(source[0], source[1], source[2], source[3], source[4], source[5], source[6])
			if err != nil {
				t.Fatal(err)
			}
			defer plan.Close()
			if plan.SourceSHA256() != source[7] || plan.Config() != source[8] {
				t.Fatal("configured parser changed original source or graph")
			}
			var metadata map[string]string
			if json.Unmarshal([]byte(plan.Metadata()), &metadata) != nil || metadata["transport_capability"] != "uot-v2" || metadata["entry_kind"] != "external" || metadata["execution"] != "local" {
				t.Fatal("configured authority changed meaning")
			}
			axes := strings.Split(strings.TrimSuffix(entry.Name(), ".json"), "--")
			normalize := func(layer string) string {
				if layer == "" {
					return "off"
				}
				return layer
			}
			var captured, graph map[string]any
			if len(axes) != 4 || json.Unmarshal([]byte(source[4]), &captured) != nil || json.Unmarshal([]byte(plan.Config()), &graph) != nil ||
				metadata["entry_mode"] != axes[0] || normalize(metadata["entry_start_layer"]) != "off" || metadata["exit_mode"] != "shadowsocks" ||
				normalize(metadata["exit_start_layer"]) != axes[1] || captured["dns_mode"] != axes[2] || captured["dns_protocol"] != axes[3] {
				t.Fatal("configured source label changed its captured transport, layer or DNS policy")
			}
			dns, ok := graph["dns"].(map[string]any)
			if !ok {
				t.Fatal("configured source lost DNS graph")
			}
			servers, ok := dns["servers"].([]any)
			if !ok || len(servers) != 1 {
				t.Fatal("configured source lost selected resolver")
			}
			resolver, ok := servers[0].(map[string]any)
			if !ok || resolver["type"] != axes[3] || resolver["server"] != captured["dns_host"] || resolver["server_port"] != captured["dns_port"] || resolver["detour"] != "proxy" {
				t.Fatal("configured parser changed the original selected DNS tuple")
			}
			if err := CheckConfig(plan.Config()); err != nil {
				t.Fatal("pinned runtime rejected configured UoT graph", err)
			}
			if _, err := mobilemtu.ReadProfile(plan.MTUProfile()); err != nil {
				t.Fatal("configured UoT lost captured MTU profile", err)
			}
			if _, err := mobilemtu.NewPlan(plan.Config(), 1280); err != nil {
				t.Fatal("configured UoT lost original MTU graph", err)
			}
			if plan.Healthy() {
				t.Fatal("configured service declaration manufactured readiness")
			}
			if _, err := plan.NewHopMeasurement(nil); err == nil {
				t.Fatal("configured service declaration manufactured measurement authority")
			}
			if _, err := plan.NewMTU(nil, nil); err == nil {
				t.Fatal("configured service declaration manufactured MTU authority")
			}

		})
	}
}

func TestRouterImportedCONNECTSelectedDNSGraphs(t *testing.T) {
	root := os.Getenv("ROUTERVPN_CONNECT_DNS_FIXTURES")
	if root == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_ENTRY_FIXTURES") == "1" {
			t.Fatal("selected CONNECT DNS fixtures absent")
		}
		t.Skip("selected DNS fixtures supplied by parser gate")
	}
	expected := map[string]bool{}
	for _, entry := range []string{"http-connect", "https-connect"} {
		for _, carrier := range []string{"plain", "off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, protocol := range []string{"tls", "https", "h3"} {
				for _, address := range []string{"literal", "hostname"} {
					if carrier != "plain" || protocol != "h3" {
						expected[entry+"--"+carrier+"--"+protocol+"--"+address+".json"] = true
					}
				}
			}
		}
	}
	entries, err := os.ReadDir(root)
	if err != nil || len(entries) != len(expected) {
		t.Fatal("incomplete selected DNS matrix", err)
	}
	for _, entry := range entries {
		t.Run(entry.Name(), func(t *testing.T) {
			if !expected[entry.Name()] || entry.Type()&os.ModeSymlink != 0 || entry.IsDir() {
				t.Fatal("foreign selected DNS fixture")
			}
			raw, err := os.ReadFile(filepath.Join(root, entry.Name()))
			if err != nil {
				t.Fatal(err)
			}
			var source []string
			if json.Unmarshal(raw, &source) != nil || len(source) != 9 {
				t.Fatal("invalid selected DNS capture")
			}
			plan, err := NewRouterImportedEntryMultihop(source[0], source[1], source[2], source[3], source[4], source[5], source[6])
			if err != nil {
				t.Fatal(err)
			}
			defer plan.Close()
			if plan.Config() != source[8] || plan.SourceSHA256() != source[7] {
				t.Fatal("selected DNS parser changed captured source or graph")
			}
			axes := strings.Split(strings.TrimSuffix(entry.Name(), ".json"), "--")
			var metadata map[string]string
			var profile, graph map[string]any
			if json.Unmarshal([]byte(plan.Metadata()), &metadata) != nil || json.Unmarshal([]byte(source[4]), &profile) != nil || json.Unmarshal([]byte(plan.Config()), &graph) != nil {
				t.Fatal("invalid selected DNS graph")
			}
			capability, layer := "uot-v2", axes[1]
			if layer == "plain" {
				capability, layer = "tcp-only", "off"
			}
			normalized := metadata["exit_start_layer"]
			if normalized == "" {
				normalized = "off"
			}
			if metadata["entry_mode"] != axes[0] || metadata["execution"] != "local" || metadata["entry_kind"] != "external" || metadata["exit_mode"] != "shadowsocks" || normalized != layer || metadata["transport_capability"] != capability || profile["dns_protocol"] != axes[2] {
				t.Fatal("selected DNS filename lost captured axes")
			}
			dns := graph["dns"].(map[string]any)
			servers := dns["servers"].([]any)
			primary := servers[0].(map[string]any)
			if dns["final"] != primary["tag"] || primary["type"] != axes[2] || primary["server"] != profile["dns_host"] || primary["server_port"] != profile["dns_port"] || primary["detour"] != "proxy" || primary["tls"].(map[string]any)["server_name"] != profile["dns_server_name"] {
				t.Fatal("selected encrypted resolver changed")
			}
			if axes[2] != "tls" && primary["path"] != profile["dns_path"] {
				t.Fatal("selected DNS path changed")
			}
			if axes[3] == "literal" {
				if len(servers) != 1 || source[6] != "" || profile["dns_host"] != "203.0.113.53" || profile["dns_mode"] != "custom" {
					t.Fatal("literal DNS acquired bootstrap")
				}
			} else {
				var captured map[string]any
				if len(servers) != 2 || json.Unmarshal([]byte(source[6]), &captured) != nil || profile["dns_host"] != "resolver.example.net" || profile["dns_mode"] != map[string]string{"tls": "dot", "https": "doh", "h3": "doh3"}[axes[2]] {
					t.Fatal("hostname DNS lost explicit capture")
				}
				same := func(a, b any) bool { x, _ := json.Marshal(a); y, _ := json.Marshal(b); return string(x) == string(y) }
				if !same(primary["domain_resolver"], captured["query"]) || !same(servers[1], captured["server"]) {
					t.Fatal("bootstrap transport or query changed")
				}
			}
			if err := CheckConfig(plan.Config()); err != nil {
				t.Fatal("pinned runtime rejected selected encrypted DNS", err)
			}
			if plan.Healthy() {
				t.Fatal("configured DNS manufactured live proof")
			}
		})
	}
}

// The focused reference gate supplies only this newly captured graph. The
// existing complete 346-source constructor/parser inventory remains mandatory
// in its original gate and is not reduced by this scoped entry point.
func TestRouterImportedSOCKSRealityVisionNativeGraph(t *testing.T) {
	root := os.Getenv("ROUTERVPN_IMPORTED_ENTRY_FIXTURES")
	if root == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_ENTRY_FIXTURES") == "1" {
			t.Fatal("required original SOCKS REALITY source absent")
		}
		t.Skip("exact compiler source supplied by scoped native gate")
	}
	path := filepath.Join(root, "socks5--final-reality-vision.json")
	info, err := os.Lstat(path)
	if err != nil || !info.Mode().IsRegular() {
		t.Fatal("original SOCKS REALITY source is not a retained file", err)
	}
	raw, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	var source []string
	if json.Unmarshal(raw, &source) != nil || len(source) != 9 {
		t.Fatal("original SOCKS REALITY source capture missing")
	}
	plan, err := NewRouterImportedEntryMultihop(source[0], source[1], source[2], source[3], source[4], source[5], source[6])
	if err != nil {
		t.Fatal("actual native constructor rejected original SOCKS REALITY sources", err)
	}
	var metadata map[string]string
	if json.Unmarshal([]byte(plan.Metadata()), &metadata) != nil ||
		metadata["entry_kind"] != "external" || metadata["entry_mode"] != "socks5" || metadata["exit_mode"] != "reality-vision" ||
		metadata["entry_api"] != "" || metadata["entry_node_id"] != "" || metadata["entry_token"] != "" ||
		(metadata["entry_start_layer"] != "" && metadata["entry_start_layer"] != "off") ||
		(metadata["exit_start_layer"] != "" && metadata["exit_start_layer"] != "off") {
		t.Fatal("native SOCKS REALITY constructor changed captured identity or layer scope")
	}
	if plan.SourceSHA256() != source[7] || plan.Config() != source[8] {
		t.Fatal("native SOCKS REALITY constructor changed exact original source bytes")
	}
	if err := CheckConfig(plan.Config()); err != nil {
		t.Fatal("actual pinned parser rejected complete SOCKS REALITY graph", err)
	}
	if _, err := mobilemtu.ReadProfile(plan.MTUProfile()); err != nil {
		t.Fatal("native SOCKS REALITY lost final private MTU proof authority", err)
	}
	if _, err := mobilemtu.NewPlan(plan.Config(), 1280); err != nil {
		t.Fatal("native SOCKS REALITY lost retained MTU plan", err)
	}
	if plan.Healthy() {
		t.Fatal("native SOCKS REALITY compilation manufactured readiness")
	}
	if _, err := plan.NewHopMeasurement(nil); err == nil {
		t.Fatal("unstarted SOCKS REALITY graph gained measurement authority")
	}
	if _, err := plan.NewMTU(nil, nil); err == nil {
		t.Fatal("unstarted SOCKS REALITY graph gained MTU authority")
	}
}

func routerImportedCONNECTLayerNames() map[string]bool {
	expected := map[string]bool{}
	for _, protocol := range []string{"http-connect", "https-connect"} {
		for _, entry := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, final := range []string{"plain", "off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				for _, policy := range []string{"home", "custom"} {
					expected[protocol+"--"+entry+"--"+final+"--"+policy+".json"] = true
				}
			}
		}
	}
	return expected
}

