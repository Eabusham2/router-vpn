func routerImportedCONNECTLayerSources(t *testing.T, environment string, android bool) {
	root := os.Getenv(environment)
	if root == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_ENTRY_FIXTURES") == "1" {
			t.Fatal("required independent CONNECT layer captures absent")
		}
		t.Skip("original host/compiler layer captures supplied by native gate")
	}
	expected := routerImportedCONNECTLayerNames()
	entries, err := os.ReadDir(root)
	if err != nil || len(entries) != len(expected) {
		t.Fatal("incomplete independent CONNECT layer matrix", err)
	}
	for _, entry := range entries {
		t.Run(entry.Name(), func(t *testing.T) {
			name := entry.Name()
			if android {
				if !strings.HasPrefix(name, "android-") {
					t.Fatal("foreign Android CONNECT capture")
				}
				name = strings.TrimPrefix(name, "android-")
			}
			info, err := entry.Info()
			if err != nil || !expected[name] || !info.Mode().IsRegular() || entry.Type()&os.ModeSymlink != 0 || info.Size() <= 0 || info.Size() > 8<<20 {
				t.Fatal("unowned independent CONNECT capture", err)
			}
			raw, err := os.ReadFile(filepath.Join(root, entry.Name()))
			var source []string
			if err != nil || len(raw) > 8<<20 || json.Unmarshal(raw, &source) != nil || len(source) != 9 {
				t.Fatal("invalid independent CONNECT source receipt", err)
			}
			plan, err := NewRouterImportedEntryMultihop(source[0], source[1], source[2], source[3], source[4], source[5], source[6])
			if err != nil {
				t.Fatal("native constructor rejected original CONNECT layers", err)
			}
			defer plan.Close()
			if plan.SourceSHA256() != source[7] || plan.Config() != source[8] {
				t.Fatal("CONNECT layer constructor changed exact source authority")
			}
			axes := strings.Split(strings.TrimSuffix(name, ".json"), "--")
			var meta map[string]string
			var final map[string]any
			if json.Unmarshal([]byte(plan.Metadata()), &meta) != nil || json.Unmarshal([]byte(source[4]), &final) != nil || len(axes) != 4 {
				t.Fatal("missing CONNECT layer identities")
			}
			layer, capability := axes[2], "uot-v2"
			if layer == "plain" {
				layer = ""
				capability = "tcp-only"
			}
			if meta["entry_kind"] != "external" || meta["entry_mode"] != axes[0] || meta["exit_mode"] != "shadowsocks" || meta["entry_start_layer"] != axes[1] || meta["exit_start_layer"] != layer || meta["transport_capability"] != capability || meta["execution"] != "local" || meta["entry_api"] != "" || meta["entry_token"] != "" || meta["entry_node_id"] != "" || final["dns_mode"] != axes[3] {
				t.Fatal("CONNECT layer capture substituted selected roles or service authority")
			}
			routerImportedCONNECTLayerGraph(t, plan.Config(), axes)
			if _, err := mobilemtu.ReadProfile(plan.MTUProfile()); err != nil {
				t.Fatal("CONNECT layers lost captured MTU authority", err)
			}
			if _, err := mobilemtu.NewPlan(plan.Config(), 1280); err != nil {
				t.Fatal("CONNECT layers lost original MTU graph", err)
			}
			if plan.Healthy() {
				t.Fatal("unstarted CONNECT layers manufactured proof")
			}
			if _, err := plan.NewHopMeasurement(nil); err == nil {
				t.Fatal("unproved CONNECT layers gained measurement authority")
			}
			if _, err := plan.NewMTU(nil, nil); err == nil {
				t.Fatal("unproved CONNECT layers gained MTU authority")
			}
		})
	}
}

