func routerImportedCONNECTLayerGraph(t *testing.T, raw string, axes []string) {
	t.Helper()
	var graph map[string]any
	if len(axes) != 4 || json.Unmarshal([]byte(raw), &graph) != nil {
		t.Fatal("missing independent CONNECT layer graph")
	}
	rows, ok := graph["outbounds"].([]any)
	if !ok || len(rows) != 4 {
		t.Fatal("CONNECT layer graph lost its exact transport closure")
	}
	byTag := map[string]map[string]any{}
	for _, value := range rows {
		node, ok := value.(map[string]any)
		if !ok {
			t.Fatal("malformed CONNECT outbound")
		}
		tag, ok := node["tag"].(string)
		if !ok || byTag[tag] != nil {
			t.Fatal("duplicate CONNECT transport owner")
		}
		byTag[tag] = node
	}
	first, last := byTag["entry-wg"], byTag["routervpn-execution-local"]
	if first == nil || last == nil || first["type"] != "http" || last["detour"] != "entry-wg" {
		t.Fatal("CONNECT layers lost final-to-entry ownership")
	}
	tag, _ := first["detour"].(string)
	outer := byTag[tag]
	expected := "shadowsocks"
	if axes[1] == "aes-256-gcm+xor-whitening" {
		expected = "routervpn-aes-xor"
	}
	if outer == nil || outer["type"] != expected || outer["detour"] != nil || outer["password"] == last["password"] {
		t.Fatal("CONNECT layers borrowed the final provision")
	}
	expected = "shadowsocks"
	if axes[2] == "aes-256-gcm+xor-whitening" {
		expected = "routervpn-aes-xor"
	}
	if last["type"] != expected {
		t.Fatal("CONNECT final layer label changed")
	}
	if axes[2] == "plain" {
		if last["network"] != "tcp" || last["udp_over_tcp"] != nil {
			t.Fatal("CONNECT entry layer invented final datagram authority")
		}
	} else {
		uot, ok := last["udp_over_tcp"].(map[string]any)
		if !ok || len(uot) != 2 || uot["enabled"] != true || uot["version"] != float64(2) || last["network"] != nil {
			t.Fatal("CONNECT final lost configured UoT-v2 authority")
		}
	}
	dns := graph["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)
	transport := "tcp"
	if axes[2] != "plain" && axes[3] == "home" {
		transport = "udp"
	}
	if dns["type"] != transport || dns["detour"] != "proxy" {
		t.Fatal("CONNECT layers changed selected DNS transport or owner")
	}
	if err := CheckConfig(raw); err != nil {
		t.Fatal("pinned native parser rejected CONNECT layers", err)
	}
}
