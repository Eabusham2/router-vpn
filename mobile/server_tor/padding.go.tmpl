package main

import (
	"context"
	"errors"
	"time"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/multihoprelay"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

func (n *routerVPNServerTor) paddingCurrent() bool {
	if !n.current() || !n.child.Session().Current() {
		return false
	}
	raw, err := routerVPNServerTorRead(n.root, "tor-source.json", 64<<10)
	return err == nil && string(raw) == n.policy.Source()
}

func (n *routerVPNServerTor) paddingProofUntil() time.Time {
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.closing || !n.proof.IsTor || !n.proof.DNSProven || n.proof.SessionID != n.capture.Request.SessionID {
		return time.Time{}
	}
	return n.paddingUntil
}

func (n *routerVPNServerTor) startPadding(ctx context.Context) error {
	policy := n.policy.Padding()
	if !policy.Enabled {
		return nil
	}
	lease, err := n.child.Session().PaddingLease(n.ctx, mobiletor.PaddingLeaseOptions{
		SessionSHA256: n.capture.OwnerID, SourceSHA256: n.policy.SourceSHA256(), RateKbps: policy.RateKbps,
		Username: n.socksUsername, Password: n.socksPassword,
		Current: n.paddingCurrent, ProofValidUntil: n.paddingProofUntil,
		Retire: func(error) {
			n.cancel()
			// The helper has already joined its monitor before this callback.
			// Keep the exact child/front/PT owner reachable while shutdown runs.
			go func() { _ = n.Close(context.Background()) }()
		},
	})
	if err != nil {
		return err
	}
	n.mu.Lock()
	if n.closing || n.padding != nil || n.ctx.Err() != nil {
		n.mu.Unlock()
		lease.Cancel()
		return errors.New("server Tor padding owner retired during capture")
	}
	n.padding = lease
	n.mu.Unlock()
	if err := lease.Start(ctx); err != nil {
		return err
	}
	if _, valid := lease.NativeReceipt(); !valid || !n.paddingCurrent() {
		return errors.New("server Tor padding did not prove its captured channel owner")
	}
	return nil
}

func (n *routerVPNServerTor) paddingHealthy() bool {
	if !n.policy.Padding().Enabled {
		return true
	}
	n.mu.Lock()
	lease := n.padding
	n.mu.Unlock()
	_, valid := lease.NativeReceipt()
	return valid
}

func (n *routerVPNServerTor) paddingReceipt() (*multihoprelay.TorPaddingReceipt, error) {
	if !n.policy.Padding().Enabled {
		return nil, nil
	}
	n.mu.Lock()
	lease := n.padding
	n.mu.Unlock()
	receipt, valid := lease.NativeReceipt()
	if !valid || receipt.SessionSHA256 != n.capture.OwnerID || receipt.SourceSHA256 != n.policy.SourceSHA256() || receipt.RateKbps != n.policy.Padding().RateKbps {
		return nil, errors.New("server Tor padding receipt lost its exact native owner")
	}
	return &multihoprelay.TorPaddingReceipt{Direction: receipt.Direction, Accounting: receipt.Accounting, Generation: receipt.Generation,
		RateKbps: receipt.RateKbps, ChannelCells: receipt.ChannelCells, ChannelBytes: receipt.ChannelBytes,
		ObservedAt: receipt.ObservedAt, ExpiresAt: receipt.ExpiresAt}, nil
}
