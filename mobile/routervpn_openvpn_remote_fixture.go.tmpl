//go:build with_openvpn && routervpn_openvpn_remote_test

package openvpn

import (
	"context"

	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/log"
	"github.com/sagernet/sing-box/option"
	N "github.com/sagernet/sing/common/network"
)

// Test builds keep the original provider transport/TLS settings and the real
// constructor, while mapping only the final physical socket to an owned
// loopback provider. This symbol is absent from normal production builds.
func RouterVPNTestPhysicalClientEndpoint(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.OpenVPNClientEndpointOptions, physical N.Dialer) (adapter.Endpoint, error) {
	owner, err := NewClientEndpoint(ctx, router, logger, tag, options)
	if err != nil {
		return nil, err
	}
	owner.(*ClientEndpoint).outboundDialer = physical
	return owner, nil
}

func (c *ClientEndpoint) RouterVPNTestConfigurationDispatch(dispatch func(uint64, func() error) error) {
	c.client.RouterVPNTestConfigurationDispatch(dispatch)
}

func (c *ClientEndpoint) RouterVPNTestRestart() { c.client.RestartSession() }

func (c *ClientEndpoint) RouterVPNTestTransportGeneration() uint64 {
	return c.state.Load().routerVPNTransportGeneration
}
