func NewRouterImportedEntryMultihop(entryConfig, entryCapture, exitMode, exitFiles, exitProfile, exitStart, dnsBootstrap string) (*RouterMultihop, error) {
	controller, err := mobilemultihop.NewImportedEntry(entryConfig, entryCapture, exitMode, exitFiles, exitProfile, exitStart, dnsBootstrap)
	if err != nil {
		return nil, err
	}
	return &RouterMultihop{controller: controller}, nil
}
func RouterCompileImportedEntryMultihop(entryConfig, entryCapture, exitMode, exitFiles, exitProfile, exitStart, dnsBootstrap string) (string, error) {
	plan, err := NewRouterImportedEntryMultihop(entryConfig, entryCapture, exitMode, exitFiles, exitProfile, exitStart, dnsBootstrap)
	if err != nil {
		return "", err
	}
	return plan.Config(), nil
}
func (m *RouterMultihop) Metadata() string     { return m.controller.Metadata() }
func (m *RouterMultihop) SourceSHA256() string { return m.controller.SourceSHA256() }
func (m *RouterMultihop) MTUProfile() string   { return m.controller.MTUProfile() }
func (m *RouterMultihop) NewHopMeasurement(server *CommandServer) (*RouterHopMeasurement, error) {
	if m == nil || !m.Healthy() {
		return nil, errors.New("imported hop measurement has no successful original native owner")
	}
	ctx, cancel := context.WithTimeout(context.Background(), routerMultihopObservationTimeout)
	defer cancel()
	core, err := routerCapturedMultihopEngine(ctx, server)
	if err != nil {
		return nil, err
	}
	engine := &routerHopMeasurementEngine{core: core}
	service, err := m.controller.NewImportedHopMeasurement(engine)
	if err != nil {
		return nil, err
	}
	return &RouterHopMeasurement{service: service}, nil
}
func (m *RouterMultihop) NewMTU(server *CommandServer, platform RouterMTUPlatform) (*RouterMTU, error) {
	if m == nil || !m.Healthy() || m.SourceSHA256() == "" {
		return nil, errors.New("imported MTU requires its proved captured graph")
	}
	ctx, cancel := context.WithTimeout(context.Background(), routerMultihopObservationTimeout)
	defer cancel()
	engine, err := routerCapturedMultihopEngine(ctx, server)
	if err != nil {
		return nil, err
	}
	if !m.controller.MatchesEngine(engine) {
		return nil, errors.New("imported MTU belongs to another native instance")
	}
	mtu, err := NewRouterMTU(server, platform, m.Config(), m.MTUProfile())
	if err != nil {
		return nil, err
	}
	mtu.owner.proofCurrent = m.Healthy
	mtu.owner.proofCurrentContext = m.controller.HealthyContext
	if !m.Healthy() {
		_ = mtu.Close()
		return nil, errors.New("imported MTU owner retired")
	}
	return mtu, nil
}
func (e *routerMultihopEngine) DNSProof(ctx context.Context) error {
	if _, err := e.IdentityContext(ctx); err != nil {
		return err
	}
	if err := e.instance.RouterVPNStrategyDNSProofContext(ctx); err != nil {
		return err
	}
	if _, err := e.IdentityContext(ctx); err != nil {
		return err
	}
	return ctx.Err()
}

func RouterImportedEntryNewHopMeasurement(plan *RouterMultihop, server *CommandServer) (*RouterHopMeasurement, error) {
	if plan == nil {
		return nil, errors.New("missing imported plan")
	}
	return plan.NewHopMeasurement(server)
}
func RouterImportedEntryNewMTU(plan *RouterMultihop, server *CommandServer, platform RouterMTUPlatform) (*RouterMTU, error) {
	if plan == nil {
		return nil, errors.New("missing imported plan")
	}
	return plan.NewMTU(server, platform)
}

func RouterImportedEntryMTUProfile(plan *RouterMultihop) string {
	if plan == nil {
		return ""
	}
	return plan.MTUProfile()
}

// ImportedOpenVPNStateContext reads only the original entry endpoint of this
// retained Box. The final selector cannot substitute its own capacity/receipt.
func (e *routerMultihopEngine) ImportedOpenVPNStateContext(ctx context.Context, tag string) (mobilemultihop.ImportedOpenVPNState, error) {
	empty := mobilemultihop.ImportedOpenVPNState{}
	if ctx == nil {
		return empty, errors.New("imported OpenVPN observation has no caller")
	}
	if err := ctx.Err(); err != nil {
		return empty, err
	}
	if _, err := e.IdentityContext(ctx); err != nil {
		return empty, err
	}
	if tag != "entry-wg" {
		return empty, errors.New("imported OpenVPN owner is unavailable")
	}
	owner, found, err := adapter.RouterVPNOutboundContext(ctx, e.instance.Outbound(), tag)
	if err != nil {
		return empty, err
	}
	endpoint, ok := owner.(interface {
		RouterVPNConnectedCapacityContext(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error)
	})
	if !found || !ok {
		return empty, errors.New("imported OpenVPN owner has no bounded connected capacity")
	}
	receipt, mtu, err := endpoint.RouterVPNConnectedCapacityContext(ctx)
	if err != nil {
		return empty, err
	}
	current, found, err := adapter.RouterVPNOutboundContext(ctx, e.instance.Outbound(), tag)
	if err != nil {
		return empty, err
	}
	if _, err := e.IdentityContext(ctx); err != nil {
		return empty, err
	}
	if !found || current != owner {
		return empty, errors.New("imported OpenVPN observation owner changed")
	}
	if err := ctx.Err(); err != nil {
		return empty, err
	}
	return mobilemultihop.ImportedOpenVPNState{Remote: receipt, MTU: mtu}, nil
}

func (e *routerMultihopEngine) IdentityContext(ctx context.Context) (string, error) {
	if ctx == nil {
		return "", errors.New("native multihop observation has no caller")
	}
	if err := ctx.Err(); err != nil {
		return "", err
	}
	if e == nil || e.server == nil || e.server.StartedService == nil || e.instance == nil {
		return "", errors.New("native multihop owner is unavailable")
	}
	current, err := e.server.StartedService.RouterVPNInstanceContext(ctx)
	if err != nil {
		return "", err
	}
	if current == nil || current.Box() != e.instance {
		return "", errors.New("native multihop instance changed")
	}
	return fmt.Sprintf("%p", e.instance), nil
}
func (e *routerMultihopEngine) SelectedContext(ctx context.Context) (string, error) {
	if _, err := e.IdentityContext(ctx); err != nil {
		return "", err
	}
	owner, found, err := adapter.RouterVPNOutboundContext(ctx, e.instance.Outbound(), mobilemultihop.SelectorTag)
	if err != nil {
		return "", err
	}
	selector, ok := owner.(*group.Selector)
	if !found || !ok {
		return "", errors.New("native multihop selector missing")
	}
	selected := selector.Now()
	if _, err := e.IdentityContext(ctx); err != nil {
		return "", err
	}
	current, present, err := adapter.RouterVPNOutboundContext(ctx, e.instance.Outbound(), mobilemultihop.SelectorTag)
	if err != nil {
		return "", err
	}
	if !present || current != owner || selector.Now() != selected {
		return "", errors.New("native selector changed during observation")
	}
	return selected, ctx.Err()
}
