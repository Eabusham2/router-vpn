package main

import (
	"context"
	"errors"
	"testing"
	"time"

	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemultihop"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/nativeopenvpn"
)

// This is the immutable-receipt boundary, not a native connection fixture.
// The encrypted Server gate must separately obtain each value from the exact
// original OpenVPN ClientEndpoint through observe, never from this test table.
func TestServerChainOpenVPNOriginalPacketReceipt(t *testing.T) {
	for _, name := range []string{"original", "no-initial", "nil-context", "cancelled", "expired", "held-lock", "pending-generation", "pending-time", "wrong-remote", "wrong-network", "under-capacity", "reconnect", "changed-time", "capacity-up", "capacity-down", "remote-changed", "caller-copy"} {
		t.Run(name, func(t *testing.T) {
			remote := nativeopenvpn.Remote{Host: "203.0.113.24", Port: 1194, Network: "udp"}
			owner := &routerVPNServerChainOpenVPN{capture: mobilemultihop.NodeChainOpenVPNServerCapture{Middle: mobilemultihop.NodeChainOpenVPNCapture{Remote: remote, ConfiguredMTU: 1400}}}
			state := nativeopenvpn.PacketObservation{Remote: nativeopenvpn.RemoteReceipt{Remote: remote, Generation: 7, ConnectedAt: 1700000000000}, MTU: 1500}
			ctx := t.Context()
			if name == "no-initial" {
				if owner.pin(ctx, state, false) == nil || owner.state != nil {
					t.Fatal("unobserved native generation acquired authority")
				}
				return
			}
			if name == "nil-context" {
				if owner.pin(nil, state, true) == nil || owner.state != nil {
					t.Fatal("missing caller acquired native receipt")
				}
				return
			}
			if name == "cancelled" || name == "expired" || name == "held-lock" {
				var stop context.CancelFunc
				if name == "cancelled" {
					ctx, stop = context.WithCancel(ctx)
					stop()
				} else {
					limit := -time.Millisecond
					if name == "held-lock" {
						limit = 10 * time.Millisecond
						owner.mu.Lock()
						defer owner.mu.Unlock()
					}
					ctx, stop = context.WithTimeout(ctx, limit)
					defer stop()
				}
				err := owner.pin(ctx, state, true)
				if !errors.Is(err, ctx.Err()) || ctx.Err() == nil || owner.state != nil {
					t.Fatal("original caller bound failed to retain empty receipt", err)
				}
				return
			}
			switch name {
			case "pending-generation":
				state.Remote.Generation = 0
			case "pending-time":
				state.Remote.ConnectedAt = 0
			case "wrong-remote":
				state.Remote.Remote.Port++
			case "wrong-network":
				state.Remote.Remote.Network = "tcp"
			case "under-capacity":
				state.MTU = 1399
			}
			if name == "pending-generation" || name == "pending-time" || name == "wrong-remote" || name == "wrong-network" || name == "under-capacity" {
				if owner.pin(ctx, state, true) == nil || owner.state != nil {
					t.Fatal("foreign configured packet receipt acquired authority")
				}
				return
			}
			if err := owner.pin(ctx, state, true); err != nil {
				t.Fatal("original receipt refused", err)
			}
			original := owner.state
			before := *original
			switch name {
			case "reconnect":
				state.Remote.Generation++
			case "changed-time":
				state.Remote.ConnectedAt++
			case "capacity-up":
				state.MTU++
			case "capacity-down":
				state.MTU--
			case "remote-changed":
				state.Remote.Remote.Port++
			case "caller-copy":
				state.MTU++
				if *original != before {
					t.Fatal("caller mutated original native receipt")
				}
				state = before
			}
			err := owner.pin(ctx, state, false)
			positive := name == "original" || name == "caller-copy"
			if positive && err != nil || !positive && err == nil || owner.state != original || *original != before {
				t.Fatal("fresh proof replaced original native packet receipt", err)
			}
			if !positive && owner.pin(ctx, state, true) == nil {
				t.Fatal("initial flag replaced original native packet receipt")
			}
		})
	}
}
