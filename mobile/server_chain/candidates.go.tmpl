// A response grant retains the identity and bytes of the same opened private
// file. A replacement or in-place rewrite invalidates existing operations.
type routerVPNServerChainCandidateFile struct {
	info   os.FileInfo
	digest [sha256.Size]byte
}

func routerVPNReadCandidateSource(root *os.Root, name string, limit int64) ([]byte, routerVPNServerChainCandidateFile, error) {
	raw, info, err := routerVPNServerChainReadOriginal(root, name, limit, nil)
	if err != nil {
		return nil, routerVPNServerChainCandidateFile{}, err
	}
	return raw, routerVPNServerChainCandidateFile{info, sha256.Sum256(raw)}, nil
}

func (source routerVPNServerChainCandidateFile) current(root *os.Root, name string) bool {
	if root == nil || source.info == nil {
		return false
	}
	raw, now, err := routerVPNServerChainReadOriginal(root, name, source.info.Size(), source.info)
	if err != nil {
		return false
	}
	digest := sha256.Sum256(raw)
	clear(raw)
	return digest == source.digest && now.Size() == source.info.Size() && now.ModTime().Equal(source.info.ModTime())
}

// The original operation grants one TCP handshake. A response grant instead
// sends one worker-constructed challenge to the registered private agent. Both
// use the captured prefix and close each sample without forwarding user traffic.
type routerVPNServerChainCandidateResponder interface {
	Reply(context.Context, multihoprelay.NodeChainCandidateCapture, net.Conn, string, string, func(context.Context, net.Conn, string, string, string) (net.Conn, error)) (string, error)
}

type routerVPNServerChainCandidate struct {
	prepareDone                           chan struct{}
	response                              routerVPNServerChainCandidateResponder
	packetResponse                        *mobilemultihop.NodeChainServerPacketCandidateResponder
	packetRequest                         *mobilemultihop.NodeChainServerCandidatePacketRequest
	packetEndpoint                        mobilemultihop.NodeChainCandidateEndpoint
	packetClose                           *routerVPNServerChainClose
	firstDialer                           N.Dialer
	responseFile                          routerVPNServerChainCandidateFile
	nonces                                map[string]bool
	reads                                 int
	readDone                              chan struct{}
	self                                  *routerVPNServerChainCandidate
	owner                                 *routerVPNServerChain
	front                                 *routerVPNServerChainFront
	policy                                *mobilemultihop.NodeChainServerPolicy
	target                                *mobilemultihop.NodeChainServerCandidateTarget
	outbound                              adapter.Outbound
	capture                               multihoprelay.NodeChainCandidateCapture
	tag, address                          string
	ctx                                   context.Context
	cancel                                context.CancelFunc
	quota                                 *multihoprelay.NodeChainCandidateAdmission
	mu                                    sync.Mutex
	attempted, prepared, retired, drained bool
	workDone                              chan struct{}
	release                               func()
	resources                             map[net.Conn]*routerVPNServerChainClose
	closeGate                             chan struct{}
	expiryDone                            chan struct{}
}

func (n *routerVPNServerChain) NewCandidateOperation(ctx context.Context, c multihoprelay.NodeChainCandidateCapture) (multihoprelay.NodeChainCandidateOperation, error) {
	if n == nil || n.candidateOwnerSelf != n || ctx == nil || ctx.Err() != nil || c.Validate() != nil || n.policy == nil || n.front == nil {
		return nil, errServerChainFront
	}
	digest, err := n.capture.Digest()
	requested, other := c.Lease.Digest()
	if err != nil || other != nil || digest != requested {
		return nil, errServerChainFront
	}
	var responder routerVPNServerChainCandidateResponder
	var public *mobilemultihop.NodeChainServerPublicCandidateResponder
	var packet *mobilemultihop.NodeChainServerPacketCandidateResponder
	var responseFile routerVPNServerChainCandidateFile
	if c.Request.Schema == 2 || c.Request.Schema == 3 || c.Request.IsPacketResponse() {
		if n.root == nil {
			return nil, errServerChainFront
		}
		name := c.ResponseSourceFile()
		var input []byte
		input, responseFile, err = routerVPNReadCandidateSource(n.root, name, mobilemultihop.NodeChainInputLimit)
		if err != nil {
			return nil, errServerChainFront
		}
		if c.Request.IsPacketResponse() {
			packet, err = mobilemultihop.NewNodeChainServerPacketCandidateResponder(c, string(input))
		} else if c.Request.Schema == 3 {
			public, err = mobilemultihop.NewNodeChainServerPublicCandidateResponder(c, string(input))
			responder = public
		} else {
			responder, err = mobilemultihop.NewNodeChainServerCandidateResponder(c, string(input))
		}
		clear(input)
		if err != nil {
			return nil, errServerChainFront
		}
	}
	var target *mobilemultihop.NodeChainServerCandidateTarget
	switch c.Request.Schema {
	case 5:
		target, err = n.policy.FirstPacketResponseCandidateTarget(c)
	case 4:
		target, err = n.policy.PacketResponseCandidateTarget(c)
	case 3:
		target, err = n.policy.PublicResponseCandidateTarget(c, public)
	case 2:
		target, err = n.policy.ResponseCandidateTarget(c)
	default:
		target, err = n.policy.CandidateTarget(c)
	}
	if err != nil {
		return nil, err
	}
	tag, address, err := target.Read(n.policy, c)
	if err != nil || c.Request.Schema != 5 && n.outputs[tag] == nil || c.Request.Schema == 5 && tag != "" {
		return nil, errServerChainFront
	}
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.closing || n.closed || n.ctx.Err() != nil || n.candidate != nil {
		return nil, errServerChainFront
	}
	if n.candidateAttempts == nil {
		n.candidateAttempts = make(map[string]multihoprelay.NodeChainCandidateCapture)
	}
	if _, seen := n.candidateAttempts[c.Request.Operation]; seen || len(n.candidateAttempts) >= 1024 {
		return nil, errServerChainFront
	}
	owned, cancel := context.WithDeadline(n.ctx, time.UnixMilli(c.Request.DeadlineAt))
	quota, err := multihoprelay.NewNodeChainCandidateAdmission(owned, c)
	if err != nil {
		cancel()
		return nil, err
	}
	op := &routerVPNServerChainCandidate{owner: n, front: n.front, policy: n.policy, target: target, outbound: n.outputs[tag], capture: c.Clone(), tag: tag, address: address, ctx: owned, cancel: cancel, quota: quota, resources: make(map[net.Conn]*routerVPNServerChainClose), closeGate: make(chan struct{}, 1), expiryDone: make(chan struct{})}
	op.self = op
	op.response, op.responseFile, op.packetResponse = responder, responseFile, packet
	if responder != nil || packet != nil {
		op.nonces = make(map[string]bool)
	}
	n.candidateAttempts[c.Request.Operation] = c.Clone()
	n.candidate = op
	go op.expire()
	if packet != nil && c.Request.Schema == 4 {
		op.packetRequest, err = packet.NewPacketRequest(ctx, n.policy, c, op)
		if err != nil {
			return op, err
		}
	}
	return op, nil
}
func (op *routerVPNServerChainCandidate) original() bool {
	if op == nil || op.self != op || op.owner == nil || op.owner.candidateOwnerSelf != op.owner || op.policy != op.owner.policy || op.front != op.owner.front {
		return false
	}
	op.owner.mu.Lock()
	same := op.owner.candidate == op
	op.owner.mu.Unlock()
	if op.capture.Request.Schema == 5 {
		return same && op.tag == "" && op.outbound == nil && op.target != nil && op.packetResponse != nil
	}
	return same && op.outbound != nil && op.owner.outputs[op.tag] == op.outbound
}
func (op *routerVPNServerChainCandidate) current(ctx context.Context) bool {
	if ctx == nil || ctx.Err() != nil || !op.original() || op.ctx.Err() != nil || !time.Now().Before(time.UnixMilli(op.capture.Request.DeadlineAt)) {
		return false
	}
	op.mu.Lock()
	active := op.prepared && !op.retired
	op.mu.Unlock()
	if !active {
		return false
	}
	if op.capture.Request.Schema == 2 || op.capture.Request.Schema == 3 || op.capture.Request.IsPacketResponse() {
		if !op.responseFile.current(op.owner.root, op.capture.ResponseSourceFile()) {
			return false
		}
		if op.capture.Request.IsPacketResponse() {
			if op.packetResponse == nil || op.packetRequest == nil || op.packetResponse.PairingSHA256() == "" {
				return false
			}
		} else if op.response == nil {
			return false
		}
	}
	if op.capture.Request.Schema == 5 && op.packetRequest.FirstCarrierAdmitContext(ctx) != nil {
		return false
	}
	tag, address, err := op.target.Read(op.policy, op.capture)
	if err != nil || tag != op.tag || address != op.address || !op.owner.trafficCurrent() || !op.owner.nativeCurrent(ctx) {
		return false
	}
	op.mu.Lock()
	ok := op.prepared && !op.retired
	op.mu.Unlock()
	op.front.mu.Lock()
	same := op.front.candidate == op
	op.front.mu.Unlock()
	return ok && same
}
func (op *routerVPNServerChainCandidate) Prepare(ctx context.Context) (multihoprelay.NodeChainCandidateReceipt, error) {
	if ctx == nil || ctx.Err() != nil || !op.original() {
		return multihoprelay.NodeChainCandidateReceipt{}, errServerChainFront
	}
	op.mu.Lock()
	if op.attempted || op.retired || op.ctx.Err() != nil {
		op.mu.Unlock()
		return multihoprelay.NodeChainCandidateReceipt{}, errServerChainFront
	}
	op.attempted = true
	op.prepareDone = make(chan struct{})
	done := op.prepareDone
	op.mu.Unlock()
	defer close(done)
	bounded, cancel := context.WithCancel(ctx)
	stop := context.AfterFunc(op.ctx, cancel)
	defer func() { stop(); cancel() }()
	ctx = bounded
	if !op.owner.trafficCurrent() || !op.owner.nativeCurrent(ctx) {
		return multihoprelay.NodeChainCandidateReceipt{}, errServerChainFront
	}
	if op.capture.Request.Schema == 5 {
		request, err := op.packetResponse.NewFirstPacketRequestContext(ctx, op.ctx, op.policy, op.capture, op)
		op.mu.Lock()
		op.packetRequest = request
		op.mu.Unlock()
		if err != nil || request == nil || ctx.Err() != nil {
			return multihoprelay.NodeChainCandidateReceipt{}, errors.Join(err, ctx.Err(), errServerChainFront)
		}
	}
	op.front.mu.Lock()
	op.mu.Lock()
	if op.front.candidate != nil || op.front.retiring || op.retired || op.ctx.Err() != nil {
		op.mu.Unlock()
		op.front.mu.Unlock()
		return multihoprelay.NodeChainCandidateReceipt{}, errServerChainFront
	}
	op.prepared = true
	op.front.candidate = op
	op.mu.Unlock()
	op.front.mu.Unlock()
	return op.Snapshot(ctx)
}
func (op *routerVPNServerChainCandidate) Snapshot(ctx context.Context) (multihoprelay.NodeChainCandidateReceipt, error) {
	if op == nil || op.self != op || ctx == nil {
		return multihoprelay.NodeChainCandidateReceipt{}, errServerChainFront
	}
	bounded, cancel := context.WithCancel(ctx)
	stop := context.AfterFunc(op.ctx, cancel)
	defer func() { stop(); cancel() }()
	ctx = bounded
	op.mu.Lock()
	if op.retired {
		op.mu.Unlock()
		return multihoprelay.NodeChainCandidateReceipt{}, errServerChainFront
	}
	if op.reads == 0 {
		op.readDone = make(chan struct{})
	}
	op.reads++
	op.mu.Unlock()
	defer func() {
		op.mu.Lock()
		op.reads--
		if op.reads == 0 {
			close(op.readDone)
			op.readDone = nil
		}
		op.mu.Unlock()
	}()

	if !op.current(ctx) {
		return multihoprelay.NodeChainCandidateReceipt{}, errServerChainFront
	}
	if op.capture.Request.Schema == 5 {
		if err := op.packetRequest.FirstCarrierObserveContext(ctx, op, op.policy, op.capture); err != nil {
			return multihoprelay.NodeChainCandidateReceipt{}, err
		}
	}
	usage := op.quota.Snapshot()
	digest, err := op.capture.Digest()
	if err != nil {
		return multihoprelay.NodeChainCandidateReceipt{}, err
	}
	pairing := ""
	if op.packetResponse != nil {
		pairing = op.packetResponse.PairingSHA256()
	}
	return multihoprelay.NodeChainCandidateReceipt{Schema: 1, Operation: op.capture.Request.Operation, OperationOwnerID: op.capture.OperationOwnerID, CaptureSHA256: digest, DeadlineAt: op.capture.Request.DeadlineAt, Prepared: true, Retired: usage.Retired, Drained: usage.Drained, Accepted: usage.Accepted, InFlight: usage.InFlight, PairingSHA256: pairing}, nil
}
func (op *routerVPNServerChainCandidate) expire() {
	defer close(op.expiryDone)
	<-op.ctx.Done()
	drain, cancel := context.WithTimeout(context.Background(), routerVPNServerChainDrainBudget)
	defer cancel()
	_ = op.drain(drain)
}
func (op *routerVPNServerChainCandidate) Close(ctx context.Context) error {
	if op == nil || op.self != op || ctx == nil {
		return errServerChainFront
	}
	op.mu.Lock()
	if op.drained {
		op.mu.Unlock()
		return nil
	}
	op.retired = true
	op.cancel()
	op.mu.Unlock()
	select {
	case <-op.expiryDone:
	case <-ctx.Done():
		return ctx.Err()
	}
	return op.drain(ctx)
}
func (op *routerVPNServerChainCandidate) closeResources(ctx context.Context) error {
	op.mu.Lock()
	resources := make(map[net.Conn]*routerVPNServerChainClose, len(op.resources))
	for conn, owner := range op.resources {
		resources[conn] = owner
	}
	op.mu.Unlock()
	var result error
	for conn, owner := range resources {
		_ = conn.SetDeadline(time.Now())
		if err := owner.CloseContext(ctx); err != nil {
			result = errors.Join(result, err)
			continue
		}
		op.mu.Lock()
		if op.resources[conn] == owner {
			delete(op.resources, conn)
		}
		op.mu.Unlock()
	}
	return result
}
func (op *routerVPNServerChainCandidate) drain(ctx context.Context) error {
	if op == nil || op.self != op || ctx == nil {
		return errServerChainFront
	}
	op.mu.Lock()
	if op.drained {
		op.mu.Unlock()
		return nil
	}
	op.retired = true
	op.cancel()
	done, prepare, reads := op.workDone, op.prepareDone, op.readDone
	op.mu.Unlock()
	select {
	case op.closeGate <- struct{}{}:
		defer func() { <-op.closeGate }()
	case <-ctx.Done():
		return ctx.Err()
	}
	// Interrupt the exact accepted handshake/returned socket before waiting for
	// its original dial callback. A late native return is retained by that worker.
	_ = op.closeResources(ctx)
	for _, joined := range []chan struct{}{prepare, reads} {
		if joined != nil {
			select {
			case <-joined:
			case <-ctx.Done():
				return ctx.Err()
			}
		}
	}
	if done != nil {
		select {
		case <-done:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	if err := op.closeResources(ctx); err != nil {
		return err
	}
	// Only after the original sample/open worker joined can its endpoint ledger be final.
	if err := op.closePacketEndpoint(ctx); err != nil {
		return err
	}
	if op.capture.Request.Schema == 5 && op.packetRequest != nil {
		if err := op.packetRequest.CloseFirstCarrierContext(ctx); err != nil {
			return err
		}
	}
	op.mu.Lock()
	if len(op.resources) != 0 {
		op.mu.Unlock()
		return errServerChainFront
	}
	release := op.release
	op.release = nil
	op.mu.Unlock()
	if release != nil {
		release()
	}
	if err := op.quota.CloseContext(ctx); err != nil {
		return err
	}
	if !op.original() {
		return errServerChainFront
	}
	op.front.mu.Lock()
	if op.front.candidate == op {
		op.front.candidate = nil
	}
	op.front.mu.Unlock()
	op.owner.mu.Lock()
	defer op.owner.mu.Unlock()
	if op.owner.candidate != op {
		return errServerChainFront
	}
	op.owner.candidate = nil
	op.mu.Lock()
	op.drained = true
	op.mu.Unlock()
	return nil
}
func (op *routerVPNServerChainCandidate) retain(conn net.Conn) {
	if conn == nil {
		return
	}
	op.mu.Lock()
	if op.resources[conn] == nil {
		op.resources[conn] = &routerVPNServerChainClose{original: conn}
	}
	op.mu.Unlock()
}
func (op *routerVPNServerChainCandidate) connect(ctx context.Context, conn net.Conn, source, destination M.Socksaddr, deadline time.Time) error {
	if op == nil || op.self != op || ctx == nil || ctx.Err() != nil || conn == nil || op.front == nil || op.ctx == nil {
		return errServerChainFront
	}
	bounded, cancel := context.WithDeadline(op.ctx, deadline)
	defer cancel()
	stop := context.AfterFunc(ctx, cancel)
	defer stop()
	if source.Addr != op.front.peer || destination.Fqdn != "" || destination.String() != op.address {
		return errServerChainFront
	}
	op.mu.Lock()
	if op.retired || !op.prepared || op.workDone != nil {
		op.mu.Unlock()
		return errServerChainFront
	}
	release, err := op.quota.Begin(bounded, op.capture.Username(), op.capture.Request.Password, "tcp", destination.String())
	if err != nil {
		op.mu.Unlock()
		return err
	}
	op.release = release
	op.workDone = make(chan struct{})
	done := op.workDone
	// Publish the original accepted socket and callback before any observation
	// that can enter a native owner, DNS transport or packet-carrier callback.
	op.resources[conn] = &routerVPNServerChainClose{original: conn}
	op.mu.Unlock()
	defer func() {
		// Only successful exact close releases this connection's quota. Failed close
		// remains in resources for Close/expiry; no subsequent admission can bypass.
		cleanup, cancel := context.WithTimeout(context.Background(), routerVPNServerChainDrainBudget)
		defer cancel()
		_ = op.closeResources(cleanup)
		op.mu.Lock()
		op.workDone = nil
		close(done)
		if len(op.resources) == 0 {
			release := op.release
			op.release = nil
			op.mu.Unlock()
			if release != nil {
				release()
			}
		} else {
			op.mu.Unlock()
		}
	}()
	if !op.current(bounded) {
		return errServerChainFront
	}
	var remote net.Conn
	if op.packetResponse != nil {
		// This acknowledges only the authenticated control connection. The
		// native packet endpoint is separately constructed from the sealed pair.
		if err := N.ReportConnHandshakeSuccess(conn, conn); err != nil {
			return err
		}
	} else {
		remote, err = op.dialOriginal(bounded, destination)
		if remote != nil {
			op.retain(remote)
		}
		if err != nil || remote == nil || !op.current(bounded) {
			return errServerChainFront
		}
		if err := N.ReportConnHandshakeSuccess(conn, remote); err != nil {
			return err
		}
		if op.response == nil {
			return nil
		}
	}
	// Each response grant receives one fixed 96-byte challenge. The private reply
	// is a 64-byte MAC. The public reply also binds its measured HTTPS interval.
	// Neither client bytes nor a client-provided destination enter the inner HTTP request.
	if err := conn.SetDeadline(deadline); err != nil {
		return err
	}
	var frame [96]byte
	if _, err := io.ReadFull(conn, frame[:]); err != nil {
		return err
	}
	nonce := string(frame[:32])
	op.mu.Lock()
	replayed := op.nonces[nonce]
	if !replayed {
		op.nonces[nonce] = true
	}
	op.mu.Unlock()
	if replayed || !hopmeasure.ValidCandidateNonce(nonce) || !op.current(bounded) {
		return errServerChainFront
	}
	wrap := func(call context.Context, raw net.Conn, method, password, address string) (net.Conn, error) {
		cipher, err := ssclient.CreateMethod(call, method, ssclient.MethodOptions{Password: password})
		if err != nil {
			return nil, err
		}
		return cipher.DialConn(raw, M.ParseSocksaddr(address))
	}
	var reply string
	if op.packetResponse != nil {
		challenge := string(frame[32:])
		if !op.packetResponse.ValidChallenge(op.capture, nonce, challenge) {
			return errServerChainFront
		}
		endpoint, openErr := op.openPacketEndpoint(bounded)
		if openErr != nil {
			return openErr
		}
		reply, err = op.packetResponse.ReplyPacket(bounded, op.capture, endpoint, nonce, challenge)
	} else {
		reply, err = op.response.Reply(bounded, op.capture, remote, nonce, string(frame[32:]), wrap)
	}
	replyBytes := 64
	if op.capture.Request.Schema == 3 {
		replyBytes = 80
	}
	if err != nil || len(reply) != replyBytes || !op.current(bounded) {
		return errServerChainFront
	}
	if n, err := io.WriteString(conn, reply); err != nil || n != len(reply) {
		return errors.Join(err, io.ErrShortWrite)
	}
	return nil
}

// Return every acquired socket even when the outbound reports an error or the
// original owner changes after Dial. The operation, not an unrelated global
// cleanup pass, must join that exact allocation before its slot can be reused.
func (op *routerVPNServerChainCandidate) dialOriginal(ctx context.Context, destination M.Socksaddr) (net.Conn, error) {
	if !op.current(ctx) || op.owner.outputs[op.tag] != op.outbound {
		return nil, errServerChainFront
	}
	ctx = adapter.WithContext(ctx, &adapter.InboundContext{Inbound: "routervpn-server-chain-candidate", InboundType: "socks", Network: "tcp", Destination: destination})
	original, err := op.outbound.DialContext(ctx, "tcp", destination)
	conn := op.owner.trackConnection(original)
	if conn == nil {
		return nil, errServerChainFront
	}
	if err != nil || !op.current(ctx) {
		return conn, errServerChainFront
	}
	return conn, nil
}

// One handshake captures its candidate pointer before authentication. Retired
// credentials/handlers never relookup a replacement, even with equal passwords.
type routerVPNServerChainCandidateHandshake struct {
	front     *routerVPNServerChainFront
	candidate *routerVPNServerChainCandidate
	deadline  time.Time
}

func (f *routerVPNServerChainFront) candidateHandshake(deadline time.Time) (*auth.Authenticator, *routerVPNServerChainCandidateHandshake) {
	f.mu.Lock()
	candidate := f.candidate
	f.mu.Unlock()
	if candidate == nil {
		return f.authenticator, &routerVPNServerChainCandidateHandshake{front: f, deadline: deadline}
	}
	users := make([]auth.User, 0, len(f.routes)+1)
	for _, route := range f.routes {
		users = append(users, auth.User{Username: route.Username, Password: route.Password})
	}
	users = append(users, auth.User{Username: candidate.capture.Username(), Password: candidate.capture.Request.Password})
	return auth.NewAuthenticator(users), &routerVPNServerChainCandidateHandshake{front: f, candidate: candidate, deadline: deadline}
}
func (h *routerVPNServerChainCandidateHandshake) NewConnectionEx(ctx context.Context, conn net.Conn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
	username, ok := auth.UserFromContext[string](ctx)
	if ok && h.candidate != nil && username == h.candidate.capture.Username() {
		err := h.candidate.connect(ctx, conn, source, destination, h.deadline)
		if onClose != nil {
			onClose(err)
		}
		return
	}
	h.front.NewConnectionEx(ctx, conn, source, destination, onClose)
}
func (h *routerVPNServerChainCandidateHandshake) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
	h.front.NewPacketConnectionEx(ctx, conn, source, destination, onClose)
}

// CandidateCommand is reached only through the inherited authenticated pipe.
// It never forwards an unknown operation into the original proof commands.
func (n *routerVPNServerChain) CandidateCommand(ctx context.Context, q multihoprelay.NodeChainCandidateIPCRequest) (*multihoprelay.NodeChainCandidateReceipt, error) {
	if n == nil || n.candidateOwnerSelf != n || ctx == nil || q.Validate() != nil {
		return nil, errServerChainFront
	}
	c := q.Capture
	lease, err := c.Lease.Digest()
	original, other := n.capture.Digest()
	if err != nil || other != nil || lease != original {
		return nil, errServerChainFront
	}
	digest, err := c.Digest()
	if err != nil {
		return nil, err
	}
	n.mu.Lock()
	if n.candidateAttempts == nil {
		n.candidateAttempts = make(map[string]multihoprelay.NodeChainCandidateCapture)
	}
	for id, old := range n.candidateAttempts {
		if old.Request.DeadlineAt <= time.Now().UnixMilli() && (n.candidate == nil || n.candidate.capture.Request.Operation != id) {
			delete(n.candidateAttempts, id)
		}
	}
	old, seen := n.candidateAttempts[c.Request.Operation]
	if seen {
		previous, _ := old.Digest()
		if previous != digest {
			n.mu.Unlock()
			return nil, errServerChainFront
		}
	}
	op := n.candidate
	if op != nil && op.capture.Request.Operation == c.Request.Operation {
		actual, _ := op.capture.Digest()
		if actual != digest {
			n.mu.Unlock()
			return nil, errServerChainFront
		}
	}
	switch q.Operation {
	case "candidate-close":
		if !seen && c.Request.DeadlineAt > time.Now().UnixMilli() {
			if len(n.candidateAttempts) >= 1024 {
				n.mu.Unlock()
				return nil, errServerChainFront
			}
			n.candidateAttempts[c.Request.Operation] = c.Clone()
		}
		if op == nil || op.capture.Request.Operation != c.Request.Operation {
			n.mu.Unlock()
			return nil, nil
		}
		n.mu.Unlock()
		return nil, op.Close(ctx)
	case "candidate-status":
		if !seen || op == nil || op.capture.Request.Operation != c.Request.Operation {
			n.mu.Unlock()
			return nil, errServerChainFront
		}
		n.mu.Unlock()
		r, err := op.Snapshot(ctx)
		return &r, err
	case "candidate-prepare":
		if seen {
			if op == nil || op.capture.Request.Operation != c.Request.Operation {
				n.mu.Unlock()
				return nil, errServerChainFront
			}
			n.mu.Unlock()
			r, err := op.Snapshot(ctx)
			return &r, err
		}
		if op != nil || n.closing || n.ctx.Err() != nil || len(n.candidateAttempts) >= 1024 {
			n.mu.Unlock()
			return nil, errServerChainFront
		}
		n.mu.Unlock()
		handle, err := n.NewCandidateOperation(ctx, c)
		if err != nil {
			return nil, err
		}
		r, err := handle.Prepare(ctx)
		return &r, err
	default:
		n.mu.Unlock()
		return nil, errServerChainFront
	}
}

// The Server endpoint belongs to this original operation across its bounded
// samples. No accepted client socket can select another UDP target or reader.
func (op *routerVPNServerChainCandidate) ServerCandidateCurrentContext(ctx context.Context, request *mobilemultihop.NodeChainServerCandidatePacketRequest) error {
	if op == nil || request == nil || request != op.packetRequest || op.packetResponse == nil || !op.current(ctx) {
		return errServerChainFront
	}
	return nil
}
func (op *routerVPNServerChainCandidate) DialServerCandidatePacketContext(ctx context.Context, request *mobilemultihop.NodeChainServerCandidatePacketRequest) (net.Conn, error) {
	if op == nil || request == nil || request != op.packetRequest {
		return nil, errServerChainFront
	}
	tag, address, err := request.ReadServer(ctx, op, op.policy, op.capture)
	if err != nil || tag != op.tag || address != op.address {
		return nil, errServerChainFront
	}
	destination := M.ParseSocksaddr(address)
	if !destination.IsIP() || destination.Port == 0 {
		return nil, errServerChainFront
	}
	call := adapter.WithContext(ctx, &adapter.InboundContext{Inbound: "routervpn-server-packet-candidate", InboundType: "socks", Network: "udp", Destination: destination})
	var original net.Conn
	if op.capture.Request.Schema == 5 {
		if tag != "" || op.outbound != nil || op.firstDialer == nil {
			return nil, errServerChainFront
		}
		original, err = op.firstDialer.DialContext(call, "udp", destination)
	} else {
		if op.outbound == nil || op.owner.outputs[tag] != op.outbound {
			return nil, errServerChainFront
		}
		original, err = op.outbound.DialContext(call, "udp", destination)
	}
	conn := op.owner.trackConnection(original)
	if conn == nil {
		return nil, errors.Join(err, errServerChainFront)
	}
	_, _, after := request.ReadServer(ctx, op, op.policy, op.capture)
	// The sealed packet dialer retains every returned socket before error checks.
	return conn, errors.Join(err, after, ctx.Err())
}
func (op *routerVPNServerChainCandidate) openPacketEndpoint(ctx context.Context) (mobilemultihop.NodeChainCandidateEndpoint, error) {
	if !op.current(ctx) || op.packetRequest == nil {
		return nil, errServerChainFront
	}
	op.mu.Lock()
	endpoint := op.packetEndpoint
	op.mu.Unlock()
	if endpoint != nil {
		return endpoint, nil
	}
	if op.capture.Request.Schema == 5 {
		raw, err := op.packetRequest.FirstCarrierOptions(ctx, op, op.policy, op.capture)
		if err != nil {
			return nil, err
		}
		var options option.DialerOptions
		if json.Unmarshal([]byte(raw), &options) != nil || options.BindInterface == "" || options.Detour != "" || (options.Inet4BindAddress == nil) == (options.Inet6BindAddress == nil) {
			return nil, errServerChainFront
		}
		bound, err := dialer.New(op.owner.ctx, options, false)
		if err != nil || bound == nil {
			return nil, errors.Join(err, errServerChainFront)
		}
		op.firstDialer = bound
	}
	// Sample cancellation retires the operation; a successful open retains only
	// the operation deadline, not the lifetime of its first challenge.
	stop := context.AfterFunc(ctx, op.cancel)
	endpoint, err := op.packetRequest.OpenServerNativeEndpoint(op.ctx, op, op.policy, op.capture,
		func(call context.Context, options mobilemultihop.AmneziaEndpointConfig, carrier N.Dialer) (mobilemultihop.NativeCandidateDevice, error) {
			device, openErr := routervpnamnezia.NewCandidateEndpoint(call, routervpnamnezia.Options(options), carrier)
			if device == nil {
				return nil, openErr
			}
			return device, openErr
		})
	stop()
	if endpoint != nil {
		op.mu.Lock()
		op.packetEndpoint = endpoint
		op.packetClose = &routerVPNServerChainClose{original: endpoint, failed: op.cancel}
		op.mu.Unlock()
	}
	if err != nil || endpoint == nil || ctx.Err() != nil || !op.current(ctx) {
		op.cancel()
		return nil, errors.Join(err, ctx.Err(), errServerChainFront)
	}
	return endpoint, nil
}
func (op *routerVPNServerChainCandidate) closePacketEndpoint(ctx context.Context) error {
	op.mu.Lock()
	endpoint, owner := op.packetEndpoint, op.packetClose
	op.mu.Unlock()
	if endpoint == nil && owner == nil {
		return nil
	}
	if endpoint == nil || owner == nil || owner.original != endpoint {
		return errServerChainFront
	}
	if err := owner.CloseContext(ctx); err != nil {
		return err
	}
	op.mu.Lock()
	defer op.mu.Unlock()
	if op.packetEndpoint != endpoint || op.packetClose != owner {
		return errServerChainFront
	}
	op.packetEndpoint, op.packetClose = nil, nil
	return nil
}

var _ mobilemultihop.NodeChainServerPacketEngine = (*routerVPNServerChainCandidate)(nil)
