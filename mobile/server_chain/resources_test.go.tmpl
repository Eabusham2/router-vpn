type serverChainHeldClose struct {
	entered, release chan struct{}
	attempts         atomic.Int64
	fail             atomic.Bool
}

func (c *serverChainHeldClose) Close() error {
	if c.attempts.Add(1) == 1 {
		close(c.entered)
		<-c.release
	}
	if c.fail.Load() {
		return errors.New("original close remains pending")
	}
	return nil
}
func TestServerChainNativeCloseDeadlineRetainsOriginalAttempt(t *testing.T) {
	n := &routerVPNServerChain{}
	original := &serverChainHeldClose{entered: make(chan struct{}), release: make(chan struct{})}
	owner := n.trackClose(original)
	ctx, cancel := context.WithCancel(t.Context())
	first := make(chan error, 1)
	go func() { first <- owner.CloseContext(ctx) }()
	<-original.entered
	cancel()
	if err := <-first; !errors.Is(err, context.Canceled) {
		t.Fatal("caller expiry did not bound original close", err)
	}
	n.connectionsMu.Lock()
	retained := n.connections[owner]
	n.connectionsMu.Unlock()
	if !retained || original.attempts.Load() != 1 {
		t.Fatal("expired close discarded or replaced original callback")
	}
	secondCtx, stop := context.WithTimeout(t.Context(), 2*time.Second)
	defer stop()
	second := make(chan error, 1)
	go func() { second <- n.drainConnections(secondCtx) }()
	close(original.release)
	if err := <-second; err != nil {
		t.Fatal(err)
	}
	if original.attempts.Load() != 1 {
		t.Fatal("concurrent retry issued a second native Close")
	}
	if err := owner.CloseContext(secondCtx); err != nil || original.attempts.Load() != 1 {
		t.Fatal("completed original close was not memoized", err)
	}
}
func TestServerChainNativeCloseErrorRetriesSameObject(t *testing.T) {
	// The protocol suite supplies the actual sealed original-owner callback.
	// This ledger control isolates when that callback may be consumed.
	left, right := net.Pipe()
	defer left.Close()
	defer right.Close()
	failure := errors.New("original trial close failure")
	originalReceipt := &serverChainRetirementConn{Conn: left, failure: failure}
	ledger := &routerVPNServerChain{}
	receipt := ledger.trackClose(originalReceipt)
	var acknowledgements atomic.Int32
	receipt.retire = func(ctx context.Context, actual net.Conn, err error) error {
		acknowledgements.Add(1)
		if actual != originalReceipt || err != failure {
			return errors.New("foreign retirement")
		}
		return ctx.Err()
	}
	if receipt.CloseContext(t.Context()) != failure || acknowledgements.Load() != 0 {
		t.Fatal("trial Close consumed final retirement authority")
	}
	if err := ledger.drainConnections(t.Context()); err != nil || acknowledgements.Load() != 1 {
		t.Fatal("final drain did not consume original joined receipt", err)
	}
	ledger.connectionsMu.Lock()
	remaining := len(ledger.connections)
	ledger.connectionsMu.Unlock()
	if remaining != 0 {
		t.Fatal("acknowledged original remained in ledger")
	}

	owned, retire := context.WithCancel(t.Context())
	defer retire()
	n := &routerVPNServerChain{ctx: owned, cancel: retire}
	original := &serverChainHeldClose{entered: make(chan struct{}), release: make(chan struct{})}
	original.fail.Store(true)
	close(original.release)
	owner := n.trackClose(original)
	ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
	defer cancel()
	if err := owner.CloseContext(ctx); err == nil {
		t.Fatal("failed original close was accepted")
	}
	n.connectionsMu.Lock()
	retained := n.connections[owner]
	n.connectionsMu.Unlock()
	if !retained {
		t.Fatal("failed original native resource was discarded")
	}
	if owned.Err() == nil {
		t.Fatal("failed native Close did not retire traffic")
	}
	original.fail.Store(false)
	if err := n.drainConnections(ctx); err != nil {
		t.Fatal("same original failed close could not retry", err)
	}
	if original.attempts.Load() != 2 {
		t.Fatal("native retry substituted original object")
	}
}
func TestServerChainNativeUnreturnedTCPAndPacketRemainOwned(t *testing.T) {
	n := &routerVPNServerChain{}
	left, right := net.Pipe()
	defer right.Close()
	conn := n.trackConnection(left)
	packet, err := net.ListenPacket("udp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	udp := n.trackPacketConnection(packet)
	cancelled, cancel := context.WithCancel(t.Context())
	cancel()
	_ = conn.CloseContext(cancelled)
	_ = udp.CloseContext(cancelled)
	// The actual sockets were captured before the late cancellation check. A
	// cancelled immediate close may finish asynchronously; drain joins it either
	// way, without inventing a successful result or reconstructing the socket.
	ctx, stop := context.WithTimeout(t.Context(), 2*time.Second)
	defer stop()
	if err := n.drainConnections(ctx); err != nil {
		t.Fatal("original late-return resources did not drain", err)
	}
	if _, err := conn.Write([]byte("retired")); err == nil {
		t.Fatal("retired original stream remained writable")
	}
	if _, err := udp.WriteTo([]byte("retired"), udp.LocalAddr()); err == nil {
		t.Fatal("retired original packet socket remained writable")
	}
}

type serverChainRetirementConn struct {
	net.Conn
	failure error
}

func (c *serverChainRetirementConn) Close() error { return c.failure }

// This component exercises the actual front and native worker shutdown order
// with a controlled final-retirement receipt. The CONNECT protocol suite owns
// the sealed receipt proof; encrypted packet-prefix acceptance remains a
// separate mandatory namespace gate.
type serverChainFrontRetirementConn struct {
	net.Conn
	failure error
	closed  atomic.Bool
	allow   atomic.Bool
}

func (c *serverChainFrontRetirementConn) Close() error {
	if err := c.Conn.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
		return err
	}
	c.closed.Store(true)
	if c.allow.Load() {
		return nil
	}
	return c.failure
}

func TestServerChainFrontRetirementJoinsBeforeFinalAcknowledgement(t *testing.T) {
	for _, name := range []string{"joined", "late-front", "front-worker-pending", "proof-worker-pending", "missing-receipt", "foreign-original", "foreign-error", "unjoined-receipt", "foreign-front"} {
		t.Run(name, func(t *testing.T) {
			f := newServerChainFrontFixture(t)
			ctx, cancel := context.WithCancel(t.Context())
			defer cancel()
			n := &routerVPNServerChain{ctx: ctx, cancel: cancel, front: f.front, begun: true,
				closeGate: make(chan struct{}, 1), proofDone: make(chan struct{}), expiryJoined: make(chan struct{})}
			left, right := net.Pipe()
			defer right.Close()
			failure := errors.New("original front trial Close failed")
			original := &serverChainFrontRetirementConn{Conn: left, failure: failure}
			remote := n.trackConnection(original)
			var acknowledgements atomic.Int32
			var repaired atomic.Bool
			foreignError := errors.New("another operation Close failed")
			foreignOriginal := &serverChainFrontRetirementConn{Conn: left, failure: failure}
			retire := func(ctx context.Context, actual net.Conn, cause error) error {
				select {
				case <-f.front.joined:
				default:
					t.Error("retirement preceded original front join")
					return failure
				}
				select {
				case <-n.proofDone:
				default:
					t.Error("retirement preceded original proof join")
					return failure
				}
				expectedOriginal, expectedError, receiptJoined := original, failure, original.closed.Load()
				if !repaired.Load() {
					switch name {
					case "foreign-original":
						expectedOriginal = foreignOriginal
					case "foreign-error":
						expectedError = foreignError
					case "unjoined-receipt":
						receiptJoined = false
					}
				}
				if ctx.Err() != nil || actual != expectedOriginal || cause != expectedError || !receiptJoined {
					return failure
				}
				acknowledgements.Add(1)
				return nil
			}
			if name != "missing-receipt" {
				remote.closeOwner.retire = retire
			}
			proofPending := name == "proof-worker-pending"
			if !proofPending {
				close(n.proofDone)
			}
			workerRelease := make(chan struct{})
			if name == "front-worker-pending" || name == "late-front" {
				f.front.workers.Add(1)
				go func() {
					defer f.front.workers.Done()
					<-f.front.ctx.Done()
					if name == "front-worker-pending" {
						<-workerRelease
					} else {
						f.front.retain(remote)
					}
				}()
			}
			if name != "late-front" && !f.front.retain(remote) {
				t.Fatal("original front receipt was not retained")
			}
			var foreign *serverChainFrontRetirementConn
			if name == "foreign-front" {
				foreignLeft, foreignRight := net.Pipe()
				defer foreignRight.Close()
				foreign = &serverChainFrontRetirementConn{Conn: foreignLeft, failure: failure}
				if !f.front.retain(foreign) {
					t.Fatal("foreign fixture close was not retained")
				}
			}
			closeCtx, finish := context.WithTimeout(t.Context(), 2*time.Second)
			defer finish()
			attemptCtx := closeCtx
			if name == "front-worker-pending" || proofPending {
				var stop context.CancelFunc
				attemptCtx, stop = context.WithTimeout(closeCtx, 25*time.Millisecond)
				defer stop()
			}
			failureResult := n.Close(attemptCtx)
			positive := name == "joined" || name == "late-front"
			if positive && failureResult != nil {
				t.Fatal("joined original front prevented final retirement", failureResult)
			}
			if !positive {
				if failureResult == nil || n.closed {
					t.Fatal("unproven front retirement was acknowledged", name)
				}
				if name != "foreign-front" && acknowledgements.Load() != 0 {
					t.Fatal("unjoined or foreign receipt consumed retirement authority", name)
				}
				f.front.mu.Lock()
				retained := f.front.originals[remote]
				if foreign != nil {
					retained = f.front.originals[foreign]
				}
				f.front.mu.Unlock()
				if !retained {
					t.Fatal("failed front owner was discarded", name)
				}
				if name == "front-worker-pending" {
					close(workerRelease)
				}
				if proofPending {
					close(n.proofDone)
				}
				repaired.Store(true)
				remote.closeOwner.retire = retire
				if foreign != nil {
					foreign.allow.Store(true)
				}
				if err := n.Close(closeCtx); err != nil {
					t.Fatal("same original front retirement could not retry", err)
				}
			}
			if acknowledgements.Load() != 1 || !n.closed {
				t.Fatal("original final retirement was omitted or replayed")
			}
			if original.Close() != failure {
				t.Fatal("final retirement erased original trial Close failure")
			}
			if err := n.Close(closeCtx); err != nil || acknowledgements.Load() != 1 {
				t.Fatal("completed native retirement changed on retry", err)
			}
		})
	}
}

// This component retains real socket/registry objects and executes the actual
// worker cancellation and Close order. The held callback models a native drain
// boundary; packet FIN/EOF is independently exercised by the protocol test.
var errServerChainTransportPending = errors.New("original protocol drain remains pending")

type serverChainTransportClose struct {
	net.Conn
	work, transport  context.Context
	attempts         atomic.Int32
	failure          atomic.Bool
	entered, release chan struct{}
}

func (c *serverChainTransportClose) Close() error {
	first := c.attempts.Add(1) == 1
	if c.work.Err() == nil {
		return errors.New("admission remained live during original drain")
	}
	if c.transport.Err() != nil {
		return errors.New("original packet transport cancelled before drain")
	}
	if first && c.entered != nil {
		close(c.entered)
		<-c.release
	}
	if c.failure.Load() {
		return errServerChainTransportPending
	}
	return c.Conn.Close()
}

type serverChainTransportRegistryOwner struct{ original bool }

func TestServerChainTransportLifetimeJoinsOriginalDrain(t *testing.T) {
	for _, name := range []string{"explicit-stop", "parent-cancel", "lease-expiry", "partial-construction", "failed-close-retry", "deadline-retains-original", "bounded-cancel"} {
		t.Run(name, func(t *testing.T) {
			parent, cancelParent := context.WithCancel(t.Context())
			defer cancelParent()
			n := &routerVPNServerChain{closeGate: make(chan struct{}, 1), expiryJoined: make(chan struct{})}
			transport := n.initializeLifetime(parent, service.ContextWithDefaultRegistry(context.Background()))
			defer n.transportCancel()
			originalDone, watcherDone := transport.Done(), n.transportWatchDone
			// Registration occurs after the split in the actual constructor too. Both
			// contexts must retain the same service registry, not separate cloned maps.
			registryOwner := &serverChainTransportRegistryOwner{original: true}
			service.MustRegister(transport, registryOwner)
			if service.FromContext[*serverChainTransportRegistryOwner](n.ctx) != registryOwner {
				t.Fatal("logical work lost original native registry")
			}
			admission := &routerVPNServerChainFront{ctx: n.ctx, enabled: true, originals: make(map[io.Closer]bool)}
			if !admission.TrafficAllowed() {
				t.Fatal("original live admission unavailable")
			}
			left, right := net.Pipe()
			defer right.Close()
			defer left.Close()
			original := &serverChainTransportClose{Conn: left, work: n.ctx, transport: transport}
			var owner *routerVPNServerChainClose
			if name != "partial-construction" {
				owner = n.trackClose(original)
			}
			if name == "parent-cancel" {
				cancelParent()
			} else if name == "lease-expiry" {
				// The existing generation-checked expiry callback retires n.ctx through
				// this original cancellation handle; no synthetic lease success is used.
				n.expiryWorkers.Add(1)
				n.expiry = time.AfterFunc(0, func() { defer n.expiryWorkers.Done(); n.cancel() })
			} else if name == "bounded-cancel" {
				cancelParent()
			}
			if name == "parent-cancel" || name == "lease-expiry" || name == "bounded-cancel" {
				select {
				case <-n.ctx.Done():
				case <-time.After(time.Second):
					t.Fatal("original logical cancellation did not arrive")
				}
			}
			ctx, finish := context.WithTimeout(t.Context(), 2*time.Second)
			defer finish()
			if name == "failed-close-retry" || name == "bounded-cancel" {
				original.failure.Store(true)
			}
			if name == "deadline-retains-original" {
				original.entered = make(chan struct{})
				original.release = make(chan struct{})
			}
			if name == "deadline-retains-original" {
				expired, expire := context.WithCancel(ctx)
				result := make(chan error, 1)
				go func() { result <- n.Close(expired) }()
				select {
				case <-original.entered:
				case <-ctx.Done():
					t.Fatal("original close did not enter")
				}
				expire()
				if err := <-result; !errors.Is(err, context.Canceled) {
					t.Fatal("caller cancellation failed to retain original close", err)
				}
			} else {
				err := n.Close(ctx)
				if name == "failed-close-retry" || name == "bounded-cancel" {
					if !errors.Is(err, errServerChainTransportPending) {
						t.Fatal("original packet transport cancelled before drain", err)
					}
				} else if err != nil {
					t.Fatal("original packet transport cancelled before drain", err)
				}
			}
			if admission.TrafficAllowed() || admission.retain(original) {
				t.Fatal("retired logical owner admitted new traffic")
			}
			if n.ctx.Err() != context.Canceled || service.FromContext[*serverChainTransportRegistryOwner](n.ctx) != registryOwner {
				t.Fatal("logical cancellation replaced original registry")
			}
			pending := name == "failed-close-retry" || name == "deadline-retains-original" || name == "bounded-cancel"
			if pending {
				n.connectionsMu.Lock()
				retained := n.connections[owner]
				n.connectionsMu.Unlock()
				if n.closed || !retained || owner.original != original || transport.Err() != nil || transport.Done() != originalDone || n.transportWatchDone != watcherDone {
					t.Fatal("failed drain discarded or replaced original transport owner")
				}
				if name == "bounded-cancel" {
					// Repeated logical cancellation and failed drain cannot renew the one
					// original eight-second transport cap. No smaller production cap is used.
					n.cancel()
					select {
					case <-transport.Done():
						t.Fatal("original transport cap expired before bounded drain")
					case <-time.After(25 * time.Millisecond):
					}
					limit, stop := context.WithTimeout(t.Context(), routerVPNServerChainDrainBudget+time.Second)
					defer stop()
					select {
					case <-transport.Done():
					case <-limit.Done():
						t.Fatal("original transport cancellation was unbounded")
					}
					select {
					case <-watcherDone:
					case <-limit.Done():
						t.Fatal("original transport cap worker did not join")
					}
					if n.closed || transport.Done() != originalDone || n.transportWatchDone != watcherDone {
						t.Fatal("force cap replaced or acknowledged failed owner")
					}
					// The protocol failed: retain its error and original for caller retry.
					if err := n.Close(limit); err == nil {
						t.Fatal("forced transport acknowledged unjoined protocol owner")
					}
					return
				}
				original.failure.Store(false)
				if original.release != nil {
					close(original.release)
				}
				if err := n.Close(ctx); err != nil {
					t.Fatal("same original transport drain did not retry", err)
				}
				expected := int32(2)
				if original.release != nil {
					expected = 1
				}
				if original.attempts.Load() != expected {
					t.Fatal("retry replaced or duplicated original drain")
				}
			}
			if name == "partial-construction" && original.attempts.Load() != 0 {
				t.Fatal("partial construction invented acquired socket")
			}
			if !n.closed || transport.Err() != context.Canceled {
				t.Fatal("joined native transport was not retired")
			}
			select {
			case <-watcherDone:
			default:
				t.Fatal("original transport watcher was not joined")
			}
			if err := n.Close(ctx); err != nil || transport.Done() != originalDone || n.transportWatchDone != watcherDone {
				t.Fatal("completed retirement replaced original owner", err)
			}
		})
	}
}
