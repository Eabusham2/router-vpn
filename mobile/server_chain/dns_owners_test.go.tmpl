// These component cases use the pinned native manager and its real bounded
// lookup. The registered transports model object identity; they do not claim
// encrypted DNS exchanges or a private deployment.
type serverChainDNSTestTransport struct {
	adapter.DNSTransport
	tag string
}

func (t *serverChainDNSTestTransport) Tag() string            { return t.tag }
func (t *serverChainDNSTestTransport) Type() string           { return "test-owned" }
func (t *serverChainDNSTestTransport) Dependencies() []string { return nil }

type serverChainDNSTestManager struct {
	*dns.TransportManager
	after func(string)
}

func (m *serverChainDNSTestManager) RouterVPNTransportContext(ctx context.Context, tag string) (adapter.DNSTransport, bool, error) {
	value, found, err := m.TransportManager.RouterVPNTransportContext(ctx, tag)
	if m.after != nil {
		m.after(tag)
	}
	return value, found, err
}

func serverChainDNSOwnersFixture(t *testing.T) (*routerVPNServerChain, *serverChainDNSTestManager, *option.DNSOptions) {
	t.Helper()
	registry := dns.NewTransportRegistry()
	dns.RegisterTransport[struct{}](registry, "test-owned", func(_ context.Context, _ log.ContextLogger, tag string, _ struct{}) (adapter.DNSTransport, error) {
		return &serverChainDNSTestTransport{tag: tag}, nil
	})
	manager := &serverChainDNSTestManager{TransportManager: dns.NewTransportManager(nil, registry, nil, "selected")}
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	n := &routerVPNServerChain{ctx: ctx, cancel: cancel, dnsManager: manager,
		binding: mobilemultihop.NodeChainServerBinding{SourceSHA256: "source", CaptureSHA256: "capture", ConfigSHA256: "config"}}
	n.dnsCapture = mobilemultihop.NodeChainServerDNSCapture{Binding: n.binding, ResolverTag: "selected", RouterJSON: "original-router",
		PolicyJSON: "original-policy", Destinations: []mobilemultihop.NodeChainServerDestination{{Network: "tcp", Address: "192.0.2.10:53"}}}
	options := &option.DNSOptions{RawDNSOptions: option.RawDNSOptions{Final: "selected"}}
	for _, tag := range []string{"selected", "bootstrap", "prefix-bootstrap"} {
		if err := manager.Create(ctx, nil, tag, "test-owned", nil); err != nil {
			t.Fatal(err)
		}
		options.Servers = append(options.Servers, option.DNSServerOptions{Type: "test-owned", Tag: tag})
	}
	var err error
	n.dnsOwner, _, err = manager.RouterVPNTransportContext(ctx, "selected")
	if err == nil {
		n.dnsOwners, err = newRouterVPNServerChainDNSOwners(ctx, n, options)
	}
	if err != nil || n.dnsOwners.current(ctx, n) != nil {
		t.Fatal("original complete native DNS inventory refused", err)
	}
	return n, manager, options
}

func TestServerChainDNSOwnersRetainEveryNativeTransport(t *testing.T) {
	for _, tag := range []string{"selected", "bootstrap", "prefix-bootstrap"} {
		t.Run("replace-"+tag, func(t *testing.T) {
			n, manager, _ := serverChainDNSOwnersFixture(t)
			if err := manager.Create(n.ctx, nil, tag, "test-owned", nil); err != nil {
				t.Fatal(err)
			}
			if n.dnsOwners.current(n.ctx, n) == nil {
				t.Fatal("replaced configured DNS transport retained authority")
			}
		})
	}
	for _, tag := range []string{"bootstrap", "prefix-bootstrap"} {
		t.Run("remove-"+tag, func(t *testing.T) {
			n, manager, _ := serverChainDNSOwnersFixture(t)
			if err := manager.Remove(tag); err != nil {
				t.Fatal(err)
			}
			if n.dnsOwners.current(n.ctx, n) == nil {
				t.Fatal("removed configured DNS transport retained authority")
			}
		})
	}
}

func TestServerChainDNSOwnersRejectForeignCapture(t *testing.T) {
	changes := map[string]func(*routerVPNServerChain){
		"missing-owner":      func(n *routerVPNServerChain) { n.dnsOwners = nil },
		"copied-owner":       func(n *routerVPNServerChain) { copied := *n.dnsOwners; n.dnsOwners = &copied },
		"foreign-manager":    func(n *routerVPNServerChain) { n.dnsManager = &serverChainDNSTestManager{} },
		"selected-owner":     func(n *routerVPNServerChain) { n.dnsOwner = &serverChainDNSTestTransport{tag: "selected"} },
		"selected-tag":       func(n *routerVPNServerChain) { n.dnsCapture.ResolverTag = "bootstrap" },
		"router-policy":      func(n *routerVPNServerChain) { n.dnsCapture.RouterJSON += " " },
		"device-policy":      func(n *routerVPNServerChain) { n.dnsCapture.PolicyJSON += " " },
		"binding":            func(n *routerVPNServerChain) { n.binding.SourceSHA256 = "replacement" },
		"destination":        func(n *routerVPNServerChain) { n.dnsCapture.Destinations[0].Address = "192.0.2.11:53" },
		"missing-dependency": func(n *routerVPNServerChain) { delete(n.dnsOwners.retained, "bootstrap") },
		"nil-dependency":     func(n *routerVPNServerChain) { n.dnsOwners.retained["bootstrap"] = nil },
		"extra-dependency":   func(n *routerVPNServerChain) { n.dnsOwners.retained["foreign"] = n.dnsOwner },
		"retired-server":     func(n *routerVPNServerChain) { n.cancel() },
	}
	for name, change := range changes {
		t.Run(name, func(t *testing.T) {
			n, _, _ := serverChainDNSOwnersFixture(t)
			change(n)
			if n.dnsOwners.current(context.Background(), n) == nil {
				t.Fatal("foreign DNS inventory or captured server retained authority")
			}
		})
	}
	t.Run("copied-server", func(t *testing.T) {
		n, _, _ := serverChainDNSOwnersFixture(t)
		// Only the fields consumed by this component are copied; never copy a
		// live worker's mutex or native resources for a test.
		other := &routerVPNServerChain{ctx: n.ctx, dnsManager: n.dnsManager, dnsOwner: n.dnsOwner,
			dnsOwners: n.dnsOwners, dnsCapture: n.dnsCapture, binding: n.binding}
		if other.dnsOwners.current(n.ctx, other) == nil {
			t.Fatal("foreign DNS inventory or captured server retained authority")
		}
	})
}

func TestServerChainDNSOwnersRequireCompleteConfiguration(t *testing.T) {
	for _, name := range []string{"missing", "empty", "empty-tag", "duplicate-tag", "missing-selected", "missing-dependency", "wrong-final", "wrong-selected-owner", "changed-binding"} {
		t.Run(name, func(t *testing.T) {
			n, _, options := serverChainDNSOwnersFixture(t)
			switch name {
			case "missing":
				options = nil
			case "empty":
				options.Servers = nil
			case "empty-tag":
				options.Servers[1].Tag = ""
			case "duplicate-tag":
				options.Servers[1].Tag = "selected"
			case "missing-selected":
				options.Servers = options.Servers[1:]
			case "missing-dependency":
				options.Servers[1].Tag = "foreign"
			case "wrong-final":
				options.Final = "bootstrap"
			case "wrong-selected-owner":
				n.dnsOwner = &serverChainDNSTestTransport{tag: "selected"}
			case "changed-binding":
				n.binding.ConfigSHA256 = "replacement"
			}
			if _, err := newRouterVPNServerChainDNSOwners(n.ctx, n, options); err == nil {
				t.Fatal("incomplete configured DNS inventory gained authority")
			}
		})
	}
}

func TestServerChainDNSOwnersKeepCallerCancellation(t *testing.T) {
	for _, name := range []string{"cancelled", "expired", "during-dependency", "during-capture"} {
		t.Run(name, func(t *testing.T) {
			n, manager, options := serverChainDNSOwnersFixture(t)
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			if name == "expired" {
				var finish context.CancelFunc
				ctx, finish = context.WithDeadline(ctx, time.Now().Add(-time.Second))
				defer finish()
			} else if name == "cancelled" {
				cancel()
			} else {
				manager.after = func(tag string) {
					if tag == "bootstrap" {
						cancel()
					}
				}
			}
			var err error
			if name == "during-capture" {
				_, err = newRouterVPNServerChainDNSOwners(ctx, n, options)
			} else {
				err = n.dnsOwners.current(ctx, n)
			}
			if err == nil || !errors.Is(ctx.Err(), context.Canceled) && !errors.Is(ctx.Err(), context.DeadlineExceeded) {
				t.Fatal("cancelled DNS observer regained authority", err, ctx.Err())
			}
			manager.after = nil
			if n.dnsOwners.current(n.ctx, n) != nil {
				t.Fatal("cancelled observer retired the independent original server")
			}
		})
	}
}
