//go:build !with_openvpn

package main

import (
	"context"
	"github.com/sagernet/sing-box/adapter"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/nativeopenvpn"
	"testing"
)

type serverOpenVPNWithoutNativeLookalike struct{ adapter.Outbound }

func (*serverOpenVPNWithoutNativeLookalike) InterfaceUpdated(context.Context) {
	panic("uncompiled OpenVPN endpoint was restarted")
}

func (*serverOpenVPNWithoutNativeLookalike) RouterVPNConnectedCapacityContext(context.Context) (nativeopenvpn.RemoteReceipt, uint32, error) {
	panic("uncompiled OpenVPN capability was observed")
}

func TestServerOpenVPNWithoutNative(t *testing.T) {
	for _, actual := range []adapter.Outbound{nil, &serverOpenVPNWithoutNativeLookalike{}} {
		if endpoint, ok := routerVPNServerOriginalOpenVPNEndpoint(actual); ok || endpoint != nil {
			t.Fatal("absent native OpenVPN implementation admitted endpoint authority")
		}
	}
}
