	mu                     sync.Mutex
	begun, closing, closed bool
	proof                  mobilemultihop.NodeChainServerProofResult
	sequence               uint64
	generation             uint64
	expiry                 *time.Timer
	expiryWorkers          sync.WaitGroup
	expiryJoinOnce         sync.Once
	expiryJoined           chan struct{}
