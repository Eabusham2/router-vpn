// Admission/proof cancellation must not destroy the packet lower while an
// original CONNECT stream is still sending FIN and joining peer EOF. Native
// transport is retained only by this worker and is force-cancelled at the
// unchanged command drain budget after the first logical retirement. Retries
// cannot restart that budget or replace any pending native object.
func (n *routerVPNServerChain) initializeLifetime(parent, base context.Context) context.Context {
	transport, cancelTransport := context.WithCancel(base)
	work, cancelWork := context.WithCancel(transport)
	n.ctx, n.cancel, n.transportCancel = work, cancelWork, cancelTransport
	n.parentDone, n.transportWatchDone = make(chan struct{}), make(chan struct{})
	n.stopParent = context.AfterFunc(parent, func() { defer close(n.parentDone); cancelWork() })
	n.stopTransportWatch = context.AfterFunc(work, func() {
		defer close(n.transportWatchDone)
		timer := time.NewTimer(routerVPNServerChainDrainBudget)
		defer timer.Stop()
		select {
		case <-transport.Done():
		case <-timer.C:
			cancelTransport()
		}
	})
	return transport
}

func (n *routerVPNServerChain) closeTransportContext(ctx context.Context) error {
	if n.transportCancel == nil { // Existing zero-acquisition component owners.
		return nil
	}
	n.transportCancel()
	if n.stopTransportWatch != nil && !n.stopTransportWatch() {
		select {
		case <-n.transportWatchDone:
			return nil
		default:
		}
		select {
		case <-n.transportWatchDone:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return nil
}

// A compact capture names its immutable registration. Reopen the separate
// private source and compile its descriptor before accepting any worker input.
func routerVPNReadInitialNodeChainCapture(root *os.Root, raw []byte) (multihoprelay.NodeChainCapture, error) {
	c, err := multihoprelay.DecodeNodeChainCapture(raw)
	if err == nil || !multihoprelay.NodeChainUsesRegisteredCapture(raw) {
		return c, err
	}
	private, err := routerVPNServerChainRead(root, "node-chain-source.json", mobilemultihop.NodeChainInputLimit)
	if err != nil {
		return multihoprelay.NodeChainCapture{}, err
	}
	defer clear(private)
	var policy *mobilemultihop.NodeChainServerPolicy
	if multihoprelay.NodeChainRegisteredCaptureSchema(raw) == 6 {
		policy, err = mobilemultihop.NewNodeChainMultipleImportedServerPolicy(string(private))
	} else {
		policy, err = mobilemultihop.NewNodeChainExternalFinalServerPolicy(string(private))
	}
	if err != nil {
		return multihoprelay.NodeChainCapture{}, err
	}
	return multihoprelay.DecodeNodeChainRegisteredCapture(raw, policy.Descriptor())
}

// Registration checks construct and close an unstarted Box. The Home resolver
// receives its source-bound transport options, with no live network or lease
// owner. Only the runtime constructor can give that transport a socket.
func routerVPNCheckExternalFinalSource(parent, base context.Context, directory string) error {
	bad := errors.New("registered public-exit configuration failed native validation")
	if parent == nil || parent.Err() != nil || base == nil || !filepath.IsAbs(directory) || filepath.Clean(directory) != directory {
		return bad
	}
	info, err := os.Lstat(directory)
	if err != nil || !info.IsDir() || info.Mode().Perm() != 0700 {
		return bad
	}
	root, err := os.OpenRoot(directory)
	if err != nil {
		return bad
	}
	defer root.Close()
	actual, err := root.Stat(".")
	if err != nil || !os.SameFile(info, actual) {
		return bad
	}
	n := &routerVPNServerChain{root: root, directory: directory, directoryInfo: info, files: make(map[string]routerVPNServerChainFile)}
	n.candidateOwnerSelf = n
	raw, err := n.captureFile("node-chain-capture.json", multihoprelay.NodeChainCaptureMaximumBytes)
	if err != nil {
		return bad
	}
	defer clear(raw)
	private, err := n.captureFile("node-chain-source.json", mobilemultihop.NodeChainInputLimit)
	if err != nil {
		return bad
	}
	policy, err := mobilemultihop.NewNodeChainExternalFinalServerPolicy(string(private))
	clear(private)
	if err != nil {
		return bad
	}
	var capture multihoprelay.NodeChainCapture
	if multihoprelay.NodeChainUsesRegisteredCapture(raw) {
		capture, err = multihoprelay.DecodeNodeChainRegisteredCapture(raw, policy.Descriptor())
	} else {
		capture, err = multihoprelay.DecodeNodeChainCapture(raw)
	}
	if err != nil || capture.Source.Schema != 8 || capture.Source.ExternalFinal == nil {
		return bad
	}
	config, err := policy.NativeConfig(capture)
	if err != nil {
		return bad
	}
	selected, err := policy.DNSCapture(capture)
	if err != nil || selected.Binding.SourceSHA256 != capture.Source.SourceSHA256 {
		return bad
	}
	owned, cancel := context.WithCancel(service.ContextWithDefaultRegistry(service.ExtendContext(base)))
	defer cancel()
	stop := context.AfterFunc(parent, cancel)
	defer stop()
	if selected.EntryHome != nil {
		registry := include.OutboundRegistry()
		registerRouterVPNServerHomeOptions(registry, *selected.EntryHome, nil, routerVPNServerHomeRoute{})
		owned = service.ContextWith[option.OutboundOptionsRegistry](owned, registry)
		owned = service.ContextWith[adapter.OutboundRegistry](owned, registry)
	}
	options, err := SJ.UnmarshalExtendedContext[option.Options](owned, []byte(config))
	if err != nil || len(options.Inbounds) != 0 || !n.sourceCurrent(true) || parent.Err() != nil {
		return bad
	}
	instance, err := box.New(box.Options{Context: owned, Options: options})
	if err != nil {
		return bad
	}
	closeErr := instance.Close()
	if closeErr != nil || !n.sourceCurrent(true) || parent.Err() != nil {
		return bad
	}
	return nil
}

func routerVPNNewServerChain(parent context.Context, root *os.Root, directory string, capture multihoprelay.NodeChainCapture) (result routerVPNNodeChainRelayOwner, failure error) {
	return routerVPNNewServerChainWithListener(parent, globalCtx, root, directory, capture, (&net.ListenConfig{}).Listen)
}
func routerVPNNewServerChainWithListener(parent, base context.Context, root *os.Root, directory string, capture multihoprelay.NodeChainCapture, listen func(context.Context, string, string) (net.Listener, error)) (result routerVPNNodeChainRelayOwner, failure error) {
	bad := errors.New("original ordered server construction failed")
	stage := "capture"
	defer func() {
		if failure != nil {
			failure = routerVPNServerChainAtStage(stage, failure)
		}
	}()
	if parent == nil || base == nil || root == nil || capture.Validate() != nil {
		return nil, bad
	}
	n := &routerVPNServerChain{root: root, directory: directory, capture: capture.Clone(), files: make(map[string]routerVPNServerChainFile), outputs: make(map[string]adapter.Outbound), proofDone: make(chan struct{}), closeGate: make(chan struct{}, 1), boxDone: make(chan struct{}), expiryJoined: make(chan struct{})}
	n.candidateOwnerSelf = n
	result = n
	owned := n.initializeLifetime(parent, service.ContextWithDefaultRegistry(service.ExtendContext(base)))
	if parent.Err() != nil || base == nil || !time.Now().Before(capture.BootstrapDeadline) {
		return result, bad
	}
	info, err := root.Stat(".")
	if err != nil {
		return result, bad
	}
	n.directoryInfo = info
	raw, err := n.captureFile("node-chain-capture.json", multihoprelay.NodeChainCaptureMaximumBytes)
	if err != nil {
		return result, bad
	}
	var actual multihoprelay.NodeChainCapture
	if capture.Request.HasRegisteredFronts() {
		actual, err = multihoprelay.DecodeNodeChainRegisteredCapture(raw, capture.Source)
	} else {
		actual, err = multihoprelay.DecodeNodeChainCapture(raw)
	}
	clear(raw)
	actualDigest, _ := actual.Digest()
	captureDigest, _ := capture.Digest()
	if err != nil || actualDigest != captureDigest {
		return result, bad
	}
	stage = "source"
	raw, err = n.captureFile("node-chain-source.json", mobilemultihop.NodeChainInputLimit)
	if err != nil {
		return result, bad
	}
	if capture.Source.Schema == 8 {
		n.policy, err = mobilemultihop.NewNodeChainExternalFinalServerPolicy(string(raw))
	} else if capture.Source.Schema == 6 {
		n.policy, err = mobilemultihop.NewNodeChainMultipleImportedServerPolicy(string(raw))
	} else if capture.Source.Schema == 5 {
		n.policy, err = mobilemultihop.NewNodeChainOpenVPNServerPolicy(string(raw))
	} else if capture.Source.Schema == 3 {
		n.policy, err = mobilemultihop.NewNodeChainSOCKSServerPolicy(string(raw))
	} else if capture.Source.Schema == 4 {
		n.policy, err = mobilemultihop.NewNodeChainCONNECTServerPolicy(string(raw))
	} else {
		n.policy, err = mobilemultihop.NewNodeChainServerPolicy(string(raw))
	}
	carrierAdmission := false
	if err == nil && n.policy.NativeCarrierRequired() {
		stage = "carrier"
		carrierAdmission = true
		construction, finish := context.WithDeadline(n.ctx, capture.BootstrapDeadline)
		if capture.Source.Schema == 6 {
			n.carrier, err = mobilemultihop.NewNodeChainMultipleImportedServerCarrierContext(construction, owned, string(raw))
		} else if capture.Source.Schema == 5 {
			n.carrier, err = mobilemultihop.NewNodeChainOpenVPNServerCarrierContext(construction, owned, string(raw))
		} else if capture.Source.Schema == 4 {
			n.carrier, err = mobilemultihop.NewNodeChainCONNECTServerCarrierContext(construction, owned, string(raw))
		} else if capture.Source.Schema == 3 {
			n.carrier, err = mobilemultihop.NewNodeChainSOCKSServerCarrierContext(construction, owned, string(raw))
		} else {
			n.carrier, err = mobilemultihop.NewNodeChainServerCarrierContext(construction, owned, string(raw))
		}
		if err == nil {
			n.policy, err = n.carrier.ProjectContext(construction)
		}
		finish()
		if err == nil {
			n.carrierJoined = make(chan struct{})
			// Typed registry contexts are installed below. Retain the original
			// cancellation channels before publishing the carrier watcher.
			carrierDone, ownerDone := n.carrier.Done(), owned.Done()
			go func() {
				defer close(n.carrierJoined)
				select {
				case <-carrierDone:
					n.cancel()
				case <-ownerDone:
				}
			}()
		}
	}
	clear(raw)
	if err != nil {
		if carrierAdmission {
			return result, errors.Join(errors.New("original Server first-carrier admission failed"), err)
		}
		return result, bad
	}
	stage = "configuration"
	config, err := n.policy.NativeConfig(capture)
	if err != nil {
		return result, bad
	}
	stage = "binding"
	configSHA, err := n.policy.ConfigSHA256(capture)
	if err != nil {
		return result, bad
	}
	n.binding = mobilemultihop.NodeChainServerBinding{SourceSHA256: n.policy.SourceSHA256(), CaptureSHA256: captureDigest, ConfigSHA256: configSHA}
	stage = "dns-capture"
	n.dnsCapture, err = n.policy.DNSCapture(capture)
	if err != nil || n.dnsCapture.Binding != n.binding {
		return result, bad
	}

	if n.dnsCapture.EntryHome != nil {
		stage = "paired-home-owner"
		registry := include.OutboundRegistry()
		owned, err = registerRouterVPNServerHomeDNS(owned, n, registry)
		if err != nil {
			return result, err
		}
		owned = service.ContextWith[option.OutboundOptionsRegistry](owned, registry)
		owned = service.ContextWith[adapter.OutboundRegistry](owned, registry)
	}
	if capture.Source.Schema == 3 {
		stage = "socks-owner"
		n.socks, err = ownedSOCKS.NewServerCapture(owned, n.policy, capture)
		if err != nil {
			return result, err
		}
		registry := include.OutboundRegistry()
		if err = n.socks.Register(registry); err != nil {
			return result, err
		}
		owned = n.socks.Context()
		owned = service.ContextWith[option.OutboundOptionsRegistry](owned, registry)
		owned = service.ContextWith[adapter.OutboundRegistry](owned, registry)
	}
	if capture.Source.Schema == 4 {
		stage = "connect-owner"
		n.connect, err = ownedCONNECT.NewServerCapture(owned, n.policy, capture)
		if err != nil {
			return result, err
		}
		registry := include.OutboundRegistry()
		if err = n.connect.Register(registry); err != nil {
			return result, err
		}
		owned = n.connect.Context()
		owned = service.ContextWith[option.OutboundOptionsRegistry](owned, registry)
		owned = service.ContextWith[adapter.OutboundRegistry](owned, registry)
	}
	stage = "options"
	options, err := SJ.UnmarshalExtendedContext[option.Options](owned, []byte(config))
	if err != nil || len(options.Inbounds) != 0 {
		return result, bad
	}
	stage = "box-create"
	n.box, err = box.New(box.Options{Context: owned, Options: options})
	if err != nil {
		return result, bad
	}
	stage = "box-start"
	if err = n.box.RouterVPNStrategyStart(); err != nil {
		return result, bad
	}
	initialize, finish := context.WithDeadline(n.ctx, capture.BootstrapDeadline)
	defer finish()
	stage = "outbounds"
	for _, proof := range n.policy.ProofInventory() {
		outbound, found, err := adapter.RouterVPNOutboundContext(initialize, n.box.Outbound(), proof.Tag)
		if err != nil || !found || outbound == nil || n.outputs[proof.Tag] != nil {
			return result, bad
		}
		n.outputs[proof.Tag] = outbound
	}
	if n.dnsCapture.EntryHome != nil {
		actual, found, readErr := adapter.RouterVPNOutboundContext(initialize, n.box.Outbound(), mobilemultihop.NodeChainServerEntryHomeTag)
		home, ok := actual.(*routerVPNServerHomeDNSOutbound)
		if readErr != nil || !found || !ok || home == nil || home.owner != n || !home.valid(initialize) {
			return result, errServerChainFront
		}
		n.home = home
	}
	if capture.Source.Schema == 5 {
		stage = "openvpn-owner"
		n.openVPN, err = newRouterVPNServerChainOpenVPN(initialize, n, config)
		if err != nil {
			return result, err
		}
		if err = n.openVPN.await(initialize, n); err != nil {
			return result, err
		}
	}
	stage = "dns-owner"
	n.dns = service.FromContext[adapter.DNSRouter](owned)
	n.dnsManager = service.FromContext[adapter.DNSTransportManager](owned)
	if n.dns == nil || n.dnsManager == nil {
		return result, bad
	}
	var dnsFound bool
	n.dnsOwner, dnsFound, err = adapter.RouterVPNTransportContext(initialize, n.dnsManager, n.dnsCapture.ResolverTag)
	if err != nil || !dnsFound || n.dnsOwner == nil {
		return result, bad
	}
	n.dnsOwners, err = newRouterVPNServerChainDNSOwners(initialize, n, options.DNS)
	if err != nil {
		return result, bad
	}
	stage = "front-routes"
	routes, err := n.policy.FrontRoutes(capture)
	if err != nil {
		return result, bad
	}
	stage = "front-create"
	n.front, err = newRouterVPNServerChainFrontWithListener(n.ctx, capture, routes, n.trafficCurrent, n.resolve, n.dialApplication, n.packetApplication, listen)
	if err != nil {
		return result, bad
	}
	stage = "initial-observation"
	if _, err = n.ObserveServerContext(initialize); err != nil {
		return result, err
	}
	return result, nil
}
func (n *routerVPNServerChain) captureFile(name string, limit int64) ([]byte, error) {
	raw, info, err := routerVPNServerChainReadOriginal(n.root, name, limit, nil)
	if err != nil {
		return nil, err
	}
	hash := sha256.Sum256(raw)
	n.files[name] = routerVPNServerChainFile{info, hex.EncodeToString(hash[:]), limit}
	return raw, nil
}
func (n *routerVPNServerChain) sourceCurrent(full bool) bool {
	if n == nil || n.root == nil || n.directoryInfo == nil {
		return false
	}
	path, err := os.Lstat(n.directory)
	actual, rootErr := n.root.Stat(".")
	if err != nil || rootErr != nil || !os.SameFile(path, n.directoryInfo) || !os.SameFile(actual, n.directoryInfo) || path.Mode().Perm() != 0700 {
		return false
	}
	for name, captured := range n.files {
		info, err := n.root.Lstat(name)
		if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || !os.SameFile(info, captured.info) || info.Size() != captured.info.Size() || !info.ModTime().Equal(captured.info.ModTime()) {
			return false
		}
		if full {
			raw, _, err := routerVPNServerChainReadOriginal(n.root, name, captured.limit, captured.info)
			if err != nil {
				return false
			}
			hash := sha256.Sum256(raw)
			clear(raw)
			if hex.EncodeToString(hash[:]) != captured.digest {
				return false
			}
		}
	}
	return len(n.files) == 2
}
func (n *routerVPNServerChain) nativeCurrent(ctx context.Context) bool {
	if n == nil || ctx == nil || ctx.Err() != nil || n.ctx.Err() != nil || n.box == nil || n.dnsOwner == nil || n.dns == nil || !n.sourceCurrent(false) {
		return false
	}
	if n.carrier != nil && n.carrier.AdmitContext(ctx) != nil || n.carrier == nil && n.policy != nil && n.policy.NativeCarrierRequired() {
		n.cancel()
		return false
	}

	if n.capture.Source.Schema == 5 {
		if n.openVPN == nil {
			n.cancel()
			return false
		}
		if _, err := n.openVPN.observe(ctx, n, false); err != nil {
			n.cancel()
			return false
		}
	} else if n.openVPN != nil {
		n.cancel()
		return false
	}
	if n.capture.Source.Schema == 3 {
		if n.socks == nil || n.socks.ObserveServerContext(ctx, n.policy, n.capture) != nil {
			n.cancel()
			return false
		}
	} else if n.socks != nil {
		n.cancel()
		return false
	}
	if n.capture.Source.Schema == 4 {
		if n.connect == nil || n.connect.ObserveServerContext(ctx, n.policy, n.capture) != nil {
			n.cancel()
			return false
		}
	} else if n.connect != nil {
		n.cancel()
		return false
	}
	if n.dnsCapture.EntryHome != nil {
		home, found, err := adapter.RouterVPNOutboundContext(ctx, n.box.Outbound(), mobilemultihop.NodeChainServerEntryHomeTag)
		if err != nil || !found || n.home == nil || n.home != home || !n.home.valid(ctx) {
			n.cancel()
			return false
		}
	} else if n.home != nil {
		n.cancel()
		return false
	}
	inbounds, err := adapter.RouterVPNInboundsContext(ctx, n.box.Inbound())
	if err != nil || len(inbounds) != 0 {
		return false
	}
	if service.FromContext[adapter.DNSRouter](n.ctx) != n.dns || service.FromContext[adapter.DNSTransportManager](n.ctx) != n.dnsManager {
		return false
	}
	resolver, found, err := adapter.RouterVPNTransportContext(ctx, n.dnsManager, n.dnsCapture.ResolverTag)
	if err != nil || !found || resolver != n.dnsOwner {
		return false
	}
	if n.dnsOwners.current(ctx, n) != nil {
		return false
	}
	for tag, original := range n.outputs {
		outbound, found, err := adapter.RouterVPNOutboundContext(ctx, n.box.Outbound(), tag)
		if err != nil || !found || outbound != original {
			return false
		}
	}
	return len(n.outputs) == len(n.capture.Source.Members) && ctx.Err() == nil
}
func (n *routerVPNServerChain) ObserveServerContext(ctx context.Context) (mobilemultihop.NodeChainServerBinding, error) {
	if !n.nativeCurrent(ctx) {
		failure := errServerChainFront
		if ctx != nil {
			failure = errors.Join(failure, ctx.Err())
		}
		if n != nil && n.ctx != nil {
			failure = errors.Join(failure, n.ctx.Err())
		}
		return mobilemultihop.NodeChainServerBinding{}, routerVPNServerChainAtStage("native-admission", failure)
	}
	if n.home != nil {
		if err := n.home.currentRoute(ctx); err != nil {
			return mobilemultihop.NodeChainServerBinding{}, routerVPNServerChainAtStage("entry-home-route", err)
		}
	}
	if n.carrier != nil {
		if err := n.carrier.CurrentContext(ctx); err != nil {
			return mobilemultihop.NodeChainServerBinding{}, routerVPNServerChainAtStage("carrier-observation", err)
		}
	}
	if !n.sourceCurrent(true) {
		return mobilemultihop.NodeChainServerBinding{}, routerVPNServerChainAtStage("source-identity", errServerChainFront)
	}
	if ctx.Err() != nil {
		return mobilemultihop.NodeChainServerBinding{}, routerVPNServerChainAtStage("observation-context", ctx.Err())
	}
	return n.binding, nil
}
func (n *routerVPNServerChain) DialServerContext(ctx context.Context, tag, network, address string) (net.Conn, error) {
	if network != "tcp" || !n.nativeCurrent(ctx) {
		return nil, errServerChainFront
	}
	allowed := tag == n.dnsCapture.FinalTag && address == "1.1.1.1:443"
	targets, err := n.policy.ProofTargets(n.capture)
	if err != nil {
		return nil, errServerChainFront
	}
	for _, target := range targets {
		allowed = allowed || target.Proof.Tag == tag && target.Network == network && target.Address == address
	}
	if !allowed {
		return nil, errServerChainFront
	}
	return n.dialOriginal(ctx, tag, network, M.ParseSocksaddr(address))
}
func (n *routerVPNServerChain) ProveServerDNSContext(ctx context.Context, dns mobilemultihop.NodeChainServerDNSCapture) error {
	if !reflect.DeepEqual(dns, n.dnsCapture) || !n.nativeCurrent(ctx) {
		return errServerChainFront
	}
	if n.home != nil {
		if err := n.home.currentRoute(ctx); err != nil {
			return err
		}
	}
	if err := n.box.RouterVPNServerChainDNSProof(ctx, n.dnsOwner); err != nil {
		return err
	}
	if !n.nativeCurrent(ctx) {
		return errServerChainFront
	}
	if n.home != nil {
		return n.home.currentRoute(ctx)
	}
	return nil
}
func (n *routerVPNServerChain) dialOriginal(ctx context.Context, tag, network string, destination M.Socksaddr) (net.Conn, error) {
	outbound := n.outputs[tag]
	if outbound == nil || !n.nativeCurrent(ctx) {
		return nil, errServerChainFront
	}
	ctx = adapter.WithContext(ctx, &adapter.InboundContext{Inbound: "routervpn-server-chain-front", InboundType: "socks", Network: network, Destination: destination})
	original, err := outbound.DialContext(ctx, network, destination)
	conn := n.trackConnection(original)
	if err != nil || conn == nil || !n.nativeCurrent(ctx) {
		if conn != nil {
			_ = conn.CloseContext(ctx)
		}
		return nil, errServerChainFront
	}
	return conn, nil
}
func (n *routerVPNServerChain) trafficCurrent() bool {
	n.mu.Lock()
	ok := !n.closing && !n.closed && n.proof.DNSProven && n.proof.PublicProven && time.Now().Before(n.proof.ProvenAt.Add(n.proofLifetime()))
	n.mu.Unlock()
	if !ok {
		return false
	}
	ctx, cancel := context.WithTimeout(n.ctx, time.Second)
	defer cancel()
	return n.nativeCurrent(ctx)
}
func (n *routerVPNServerChain) resolve(ctx context.Context, route mobilemultihop.NodeChainServerFrontRoute, network string, destination M.Socksaddr) (M.Socksaddr, error) {
	if !n.trafficCurrent() || route.Binding != n.binding || destination.Port == 0 {
		return M.Socksaddr{}, errServerChainFront
	}
	original := destination
	if destination.Fqdn != "" {
		if !route.Final && (!route.PublicPathBenchmark || !route.AllowsDestination(network, destination.String())) {
			return M.Socksaddr{}, errServerChainFront
		}
		bounded, cancel := context.WithTimeout(ctx, 5*time.Second)
		defer cancel()
		lookup := adapter.WithContext(bounded, &adapter.InboundContext{Inbound: "routervpn-server-chain-front", InboundType: "socks", Network: network, Destination: destination, Protocol: "dns"})
		answers, err := n.dns.Lookup(lookup, destination.Fqdn, adapter.DNSQueryOptions{Transport: n.dnsOwner, DisableCache: true, DisableOptimisticCache: true, Timeout: 5 * time.Second})
		if err != nil || len(answers) == 0 || len(answers) > 128 || !n.nativeCurrent(bounded) {
			return M.Socksaddr{}, errServerChainFront
		}
		destination, err = routerVPNServerChainResolved(route, network, destination, answers)
		if err != nil {
			return M.Socksaddr{}, err
		}
	}
	if !destination.Addr.IsValid() || !route.AllowsResolvedDestination(network, original.String(), destination.String()) || !n.trafficCurrent() {
		return M.Socksaddr{}, errServerChainFront
	}
	return destination, nil
}

// Every selected-resolver answer must obey the original final policy. A good
// first record cannot conceal a private, mapped or disabled-family alternate.
func routerVPNServerChainResolved(route mobilemultihop.NodeChainServerFrontRoute, network string, original M.Socksaddr, answers []netip.Addr) (M.Socksaddr, error) {
	if !route.Final && !route.PublicPathBenchmark || original.Fqdn == "" || original.Port == 0 || len(answers) == 0 || len(answers) > 128 {
		return M.Socksaddr{}, errServerChainFront
	}
	for _, address := range answers {
		literal := M.Socksaddr{Addr: address, Port: original.Port}
		if !address.IsValid() || address.Zone() != "" || address.Is4In6() || !route.AllowsResolvedDestination(network, original.String(), literal.String()) {
			return M.Socksaddr{}, errServerChainFront
		}
	}
	return M.Socksaddr{Addr: answers[0], Port: original.Port}, nil
}
func (n *routerVPNServerChain) dialApplication(ctx context.Context, tag, network string, destination M.Socksaddr) (net.Conn, error) {
	if !n.trafficCurrent() {
		return nil, errServerChainFront
	}
	return n.dialOriginal(ctx, tag, network, destination)
}
func (n *routerVPNServerChain) packetApplication(ctx context.Context, tag string, destination M.Socksaddr) (net.PacketConn, error) {
	if tag != n.dnsCapture.FinalTag || !n.trafficCurrent() {
		return nil, errServerChainFront
	}
	outbound := n.outputs[tag]
	if outbound == nil {
		return nil, errServerChainFront
	}
	ctx = adapter.WithContext(ctx, &adapter.InboundContext{Inbound: "routervpn-server-chain-front", InboundType: "socks", Network: "udp", Destination: destination})
	original, err := outbound.ListenPacket(ctx, destination)
	conn := n.trackPacketConnection(original)
	if err != nil || conn == nil || !n.trafficCurrent() {
		if conn != nil {
			_ = conn.CloseContext(ctx)
		}
		return nil, errServerChainFront
	}
	return conn, nil
}
func (n *routerVPNServerChain) proofLifetime() time.Duration {
	return time.Duration(15+5*min(len(n.capture.Source.Members), multihoprelay.NodeChainMaximumMembers)) * time.Second
}
func (n *routerVPNServerChain) Begin() error {
	n.mu.Lock()
	defer n.mu.Unlock()
	if n.begun || n.closing || n.ctx.Err() != nil || n.front == nil || !n.front.Current() || !time.Now().Before(n.capture.BootstrapDeadline) {
		return errServerChainFront
	}
	n.begun = true
	go n.run()
	return nil
}
func (n *routerVPNServerChain) run() {
	defer close(n.proofDone)
	defer n.cancel()
	deadline := n.capture.BootstrapDeadline
	first := true
	for {
		ctx, cancel := context.WithDeadline(n.ctx, deadline)
		proof, err := n.policy.Prove(ctx, n.capture, n)
		cancel()
		if err != nil || proof.Binding != n.binding || !proof.DNSProven || !proof.PublicProven || len(proof.Prefixes) != len(n.capture.Source.Members) || proof.ProvenAt.IsZero() {
			return
		}
		n.mu.Lock()
		if n.closing || n.ctx.Err() != nil {
			n.mu.Unlock()
			return
		}
		n.proof = proof
		n.generation++
		generation := n.generation
		if n.expiry != nil {
			if n.expiry.Stop() {
				n.expiryWorkers.Done()
			}
		}
		deadline = proof.ProvenAt.Add(n.proofLifetime())
		n.expiryWorkers.Add(1)
		n.expiry = time.AfterFunc(time.Until(deadline), func() {
			defer n.expiryWorkers.Done()
			n.mu.Lock()
			expired := n.generation == generation && !time.Now().Before(n.proof.ProvenAt.Add(n.proofLifetime()))
			n.mu.Unlock()
			if expired {
				n.cancel()
			}
		})
		n.mu.Unlock()
		if first {
			if n.front.Enable() != nil {
				return
			}
			first = false
		}
		timer := time.NewTimer(5 * time.Second)
		select {
		case <-n.ctx.Done():
			timer.Stop()
			return
		case <-timer.C:
		}
	}
}
func (n *routerVPNServerChain) Snapshot(ctx context.Context, nonce string) (multihoprelay.NodeChainReceipt, error) {
	if _, err := n.ObserveServerContext(ctx); err != nil {
		return multihoprelay.NodeChainReceipt{}, err
	}
	if n.front == nil || !n.front.Current() {
		return multihoprelay.NodeChainReceipt{}, routerVPNServerChainAtStage("front-current", errServerChainFront)
	}
	n.mu.Lock()
	defer n.mu.Unlock()
	if ctx.Err() != nil || n.closing || n.ctx.Err() != nil {
		return multihoprelay.NodeChainReceipt{}, routerVPNServerChainAtStage("snapshot-lifecycle", errors.Join(errServerChainFront, ctx.Err(), n.ctx.Err()))
	}
	n.sequence++
	now := time.Now()
	r := multihoprelay.NodeChainReceipt{Schema: 1, SessionID: n.capture.Request.SessionID, OwnerID: n.capture.OwnerID, Peer: n.capture.Peer, SourceSHA256: n.binding.SourceSHA256, RegistrySHA256: n.capture.RegistrySHA256, DNSPolicySHA256: n.capture.Source.DNSPolicySHA256, CaptureSHA256: n.binding.CaptureSHA256, Nonce: nonce, Sequence: n.sequence, HeartbeatAt: now.UnixMilli(), Phase: multihoprelay.NodeChainPending, FrontReady: true}
	if !n.proof.ProvenAt.IsZero() && n.front.TrafficAllowed() {
		if !now.Before(n.proof.ProvenAt.Add(n.proofLifetime())) {
			return multihoprelay.NodeChainReceipt{}, errServerChainFront
		}
		r.Phase = multihoprelay.NodeChainReady
		r.TrafficAllowed = true
		r.DNSProven = n.proof.DNSProven
		r.PublicProven = n.proof.PublicProven
		if n.capture.Source.Schema == 8 {
			r.ExitIP = n.proof.ExitIP
		}
		r.ProofAt = n.proof.ProvenAt.UnixMilli()
		for _, row := range n.proof.Prefixes {
			prefix := multihoprelay.NodeChainPrefixReceipt{Position: row.Proof.Position, ProfileID: row.Proof.ProfileID, NodeID: row.Proof.NodeID, Mode: row.Proof.Mode, Proven: true, ResponseMS: row.ResponseMS}
			if row.Proof.NodeKind == "external" || n.capture.Source.PrivateStreamAt(row.Proof.Position) {
				prefix.NodeKind, prefix.ProofKind, prefix.SourceSHA256 = row.Proof.NodeKind, row.Proof.Kind, row.Proof.SourceSHA256
			}
			r.Prefixes = append(r.Prefixes, prefix)
		}
	}
	return r, nil
}
func (n *routerVPNServerChain) Close(ctx context.Context) error {
	if ctx == nil {
		return errServerChainFront
	}
	select {
	case n.closeGate <- struct{}{}:
	case <-ctx.Done():
		return ctx.Err()
	}
	defer func() { <-n.closeGate }()
	n.mu.Lock()
	if n.closed {
		n.mu.Unlock()
		return nil
	}
	n.closing = true
	candidate := n.candidate
	begun := n.begun
	if n.expiry != nil {
		if n.expiry.Stop() {
			n.expiryWorkers.Done()
		}
	}
	n.mu.Unlock()
	n.cancel()
	if candidate != nil {
		if err := candidate.Close(ctx); err != nil {
			return routerVPNServerChainAtStage("close-candidate", err)
		}
	}
	if n.front != nil {
		if err := n.front.joinContext(ctx); err != nil {
			return routerVPNServerChainAtStage("close-front", err)
		}
	}
	if begun {
		select {
		case <-n.proofDone:
		case <-ctx.Done():
			return routerVPNServerChainAtStage("close-proof", ctx.Err())
		}
	}
	n.expiryJoinOnce.Do(func() { go func() { n.expiryWorkers.Wait(); close(n.expiryJoined) }() })
	select {
	case <-n.expiryJoined:
	case <-ctx.Done():
		return routerVPNServerChainAtStage("close-expiry", ctx.Err())
	}
	if err := n.drainConnections(ctx); err != nil {
		return routerVPNServerChainAtStage("close-connections", err)
	}
	if n.front != nil {
		if err := n.front.Close(ctx); err != nil {
			return routerVPNServerChainAtStage("close-front", err)
		}
	}
	if n.socks != nil {
		if err := n.socks.CloseContext(ctx); err != nil {
			return routerVPNServerChainAtStage("close-socks", err)
		}
	}
	if n.connect != nil {
		if err := n.connect.CloseContext(ctx); err != nil {
			return routerVPNServerChainAtStage("close-connect", err)
		}
	}
	if err := n.closeTransportContext(ctx); err != nil {
		return routerVPNServerChainAtStage("close-transport", err)
	}
	if n.box != nil {
		n.boxOnce.Do(func() { go func() { n.boxError = n.box.Close(); close(n.boxDone) }() })
		select {
		case <-n.boxDone:
		case <-ctx.Done():
			return routerVPNServerChainAtStage("close-box", ctx.Err())
		}
		if n.boxError != nil {
			return routerVPNServerChainAtStage("close-box", n.boxError)
		}
	}
	if n.carrier != nil {
		if err := n.carrier.CloseContext(ctx); err != nil {
			return routerVPNServerChainAtStage("close-carrier", err)
		}
	}
	if n.carrierJoined != nil {
		select {
		case <-n.carrierJoined:
		case <-ctx.Done():
			return routerVPNServerChainAtStage("close-carrier-join", ctx.Err())
		}
	}
	if n.stopParent != nil && !n.stopParent() {
		select {
		case <-n.parentDone:
		case <-ctx.Done():
			return routerVPNServerChainAtStage("close-parent", ctx.Err())
		}
	}
	n.mu.Lock()
	n.closed = true
	n.mu.Unlock()
	return nil
}

var _ mobilemultihop.NodeChainServerProofEngine = (*routerVPNServerChain)(nil)
