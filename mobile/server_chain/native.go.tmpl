	info   os.FileInfo
	digest string
	limit  int64
}
type routerVPNServerChain struct {
	ctx                    context.Context
	cancel                 context.CancelFunc
	stopParent             func() bool
	parentDone             chan struct{}
	root                   *os.Root
	directory              string
	directoryInfo          os.FileInfo
	files                  map[string]routerVPNServerChainFile
	capture                multihoprelay.NodeChainCapture
	policy                 *mobilemultihop.NodeChainServerPolicy
	carrier                *mobilemultihop.NodeChainServerCarrier
	carrierJoined          chan struct{}
	binding                mobilemultihop.NodeChainServerBinding
	dnsCapture             mobilemultihop.NodeChainServerDNSCapture
	box                    *box.Box
	dns                    adapter.DNSRouter
