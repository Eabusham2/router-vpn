func routerImportedPQRealityNames() map[string]bool {
	names := map[string]bool{}
	for _, kind := range []string{"socks5", "shadowsocks", "hysteria2", "http-connect", "https-connect", "wireguard", "amneziawg", "openvpn-tcp", "openvpn-udp"} {
		for _, first := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, last := range []string{"off", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				names[kind+"--reality-pq-vision--"+first+"--"+last+".json"] = true
			}
		}
	}
	return names
}

func TestRouterImportedPQRealitySourceGraphs(t *testing.T) {
	routerImportedPQRealityGraphs(t, "ROUTERVPN_IMPORTED_PQ_XRAY_FIXTURES", true, false)
}
func TestRouterImportedPQRealityAndroidSourceGraphs(t *testing.T) {
	routerImportedPQRealityGraphs(t, "ROUTERVPN_ANDROID_IMPORTED_PQ_XRAY_FIXTURES", true, true)
}
func TestRouterImportedPQRealityAppleGraphs(t *testing.T) {
	routerImportedPQRealityGraphs(t, "ROUTERVPN_APPLE_IMPORTED_PQ_XRAY_FIXTURES", false, false)
}
func TestRouterImportedPQRealityDesktopGraphs(t *testing.T) {
	routerImportedPQRealityGraphs(t, "ROUTERVPN_DESKTOP_IMPORTED_PQ_XRAY_FIXTURES", false, false)
}

func routerImportedPQRealityGraphs(t *testing.T, environment string, captured, android bool) {
	directory := os.Getenv(environment)
	if directory == "" {
		if os.Getenv("ROUTERVPN_REQUIRE_IMPORTED_PQ_XRAY_FIXTURES") == "1" {
			t.Fatal("required separate PQ source inventory missing")
		}
		t.Skip("separate PQ parser gate supplies original host captures")
	}
	expected := routerImportedPQRealityNames()
	rows, err := os.ReadDir(directory)
	if err != nil || len(rows) != len(expected) {
		t.Fatal("PQ parser lost its exact 81 original graph inventory", err)
	}
	for _, row := range rows {
		t.Run(row.Name(), func(t *testing.T) {
			name := row.Name()
			if android {
				if !strings.HasPrefix(name, "android-") {
					t.Fatal("PQ Android source lacks its producer identity")
				}
				name = strings.TrimPrefix(name, "android-")
			}
			info, err := row.Info()
			if err != nil || !expected[name] || row.Type()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > 4<<20 {
				t.Fatal("PQ parser received a foreign or unbounded source", err)
			}
			raw, err := os.ReadFile(filepath.Join(directory, row.Name()))
			if err != nil {
				t.Fatal(err)
			}
			config := string(raw)
			if captured {
				var source []string
				if json.Unmarshal(raw, &source) != nil || len(source) != 9 || source[2] != "reality-pq-vision" {
					t.Fatal("PQ parser lost original seven inputs and graph receipt")
				}
				plan, err := mobilemultihop.NewImportedEntry(source[0], source[1], source[2], source[3], source[4], source[5], source[6])
				if err != nil {
					t.Fatal("pinned native compiler rejected original PQ source", err)
				}
				defer plan.Close()
				if plan.SourceSHA256() != source[7] || plan.Config() != source[8] || plan.Healthy() {
					t.Fatal("pinned native PQ source identity changed or acquired live proof")
				}
				config = plan.Config()
			}
			var graph map[string]any
			if json.Unmarshal([]byte(config), &graph) != nil {
				t.Fatal("invalid original PQ graph")
			}
			routerImportedPQRealityAxes(t, name, graph)
			found := 0
			for _, value := range graph["outbounds"].([]any) {
				out := value.(map[string]any)
				if out["type"] != "routervpn-xray" {
					continue
				}
				found++
				if out["mode"] != "reality-pq-vision" || out["tag"] != "routervpn-execution-local" || out["detour"] == nil {
					t.Fatal("PQ parser lost exact final native owner")
				}
			}
			if found != 1 {
				t.Fatal("PQ parser requires one exact native final")
			}
			if err := CheckConfig(config); err != nil {
				t.Fatal("actual pinned Libbox rejected the original PQ host graph", err)
			}
		})
	}
}

func routerImportedPQRealityAxes(t *testing.T, name string, graph map[string]any) {
	t.Helper()
	axes := strings.Split(strings.TrimSuffix(name, ".json"), "--")
	if len(axes) != 4 || axes[1] != "reality-pq-vision" {
		t.Fatal("PQ graph lost its exact inventory axes")
	}
	byTag := map[string]map[string]any{}
	for _, family := range []string{"outbounds", "endpoints"} {
		rows, _ := graph[family].([]any)
		for _, value := range rows {
			row := value.(map[string]any)
			tag, _ := row["tag"].(string)
			if tag == "" || byTag[tag] != nil {
				t.Fatal("PQ graph has an unowned or duplicate transport tag")
			}
			byTag[tag] = row
		}
	}
	entry, final := byTag["entry-wg"], byTag["routervpn-execution-local"]
	types := map[string]string{"socks5": "socks", "shadowsocks": "shadowsocks", "hysteria2": "hysteria2", "http-connect": "http", "https-connect": "http", "wireguard": "wireguard", "amneziawg": "routervpn-amneziawg", "openvpn-tcp": "openvpn-client", "openvpn-udp": "openvpn-client"}
	if entry == nil || final == nil || types[axes[0]] == "" || entry["type"] != types[axes[0]] {
		t.Fatal("PQ filename substituted another imported transport")
	}
	if strings.HasPrefix(axes[0], "openvpn-") && entry["network"] != strings.TrimPrefix(axes[0], "openvpn-") {
		t.Fatal("PQ filename substituted another OpenVPN wire transport")
	}
	if axes[0] == "http-connect" || axes[0] == "https-connect" {
		tls, _ := entry["tls"].(map[string]any)
		if (axes[0] == "https-connect") != (tls != nil && tls["enabled"] == true) {
			t.Fatal("PQ filename substituted CONNECT TLS policy")
		}
	}
	layer := func(row map[string]any, off string) string {
		if row["detour"] == nil && off == "" || row["detour"] == off {
			return "off"
		}
		tag, _ := row["detour"].(string)
		outer := byTag[tag]
		if outer["type"] == "routervpn-openvpn-layer-map" {
			mode, _ := outer["mode"].(string)
			return mode
		}
		if outer["type"] == "routervpn-aes-xor" {
			return "aes-256-gcm+xor-whitening"
		}
		if outer["type"] == "shadowsocks" && outer["method"] == "2022-blake3-aes-256-gcm" {
			return "aes-256-gcm"
		}
		return "unowned"
	}
	if layer(entry, "") != axes[2] || layer(final, "entry-wg") != axes[3] {
		t.Fatal("PQ filename substituted an independent Start Layer")
	}
}
