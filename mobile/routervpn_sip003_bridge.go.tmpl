package libbox

import "github.com/sagernet/sing-box/experimental/libbox/routervpn/nativesip003"

// RouterCompileSIP003Profile validates and composes only the generated
// Shadowsocks 2022 + built-in WebSocket/TLS TCP and Hysteria2 UDP graph. It
// starts no helper and opens no sockets. Actual traffic belongs to Libbox.
func RouterCompileSIP003Profile(wrapper, helper string) (string, error) {
	result, err := nativesip003.Compile([]byte(wrapper), []byte(helper))
	return string(result), err
}

// RouterComposeSIP003StartLayer keeps both native TCP and UDP paths inside the
// explicitly selected authenticated home-node Start Layer.
func RouterComposeSIP003StartLayer(wrapper, helper, aes, policy string) (string, error) {
	result, err := nativesip003.ComposeStartLayer([]byte(wrapper), []byte(helper), []byte(aes), []byte(policy))
	return string(result), err
}
