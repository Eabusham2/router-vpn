package routervpnamnezia

import (
	"context"
	"errors"
	"net"
	"net/netip"
	"sync"
	"time"

	awgconn "github.com/amnezia-vpn/amneziawg-go/v3/conn"
	M "github.com/sagernet/sing/common/metadata"
	N "github.com/sagernet/sing/common/network"
)

// A client bind dials only the captured peer through the existing protected
// platform/entry dialer. It exposes no OS listener, hostname lookup or fallback.
type peerBind struct {
	ctx        context.Context
	dialer     N.Dialer
	target     netip.AddrPort
	mu         sync.Mutex
	generation uint64
	conn       net.Conn
	cancel     context.CancelFunc
}

var _ awgconn.Bind = (*peerBind)(nil)

func (b *peerBind) Open(port uint16) ([]awgconn.ReceiveFunc, uint16, error) {
	if port != 0 {
		return nil, 0, errors.New("native AWG has no imported listen port")
	}
	b.mu.Lock()
	if b.conn != nil || b.cancel != nil {
		b.mu.Unlock()
		return nil, 0, awgconn.ErrBindAlreadyOpen
	}
	b.generation++
	generation := b.generation
	ctx, cancel := context.WithTimeout(b.ctx, 10*time.Second)
	b.cancel = cancel
	b.mu.Unlock()
	c, err := b.dialer.DialContext(ctx, N.NetworkUDP, M.SocksaddrFromNetIP(b.target))
	b.mu.Lock()
	if b.generation != generation || b.ctx.Err() != nil {
		b.mu.Unlock()
		cancel()
		if c != nil {
			_ = c.Close()
		}
		return nil, 0, net.ErrClosed
	}
	b.cancel = nil
	cancel()
	if err != nil {
		b.mu.Unlock()
		return nil, 0, errors.New("native AWG protected peer dial failed")
	}
	b.conn = c
	b.mu.Unlock()
	receive := func(packets [][]byte, sizes []int, endpoints []awgconn.Endpoint) (int, error) {
		if len(packets) != 1 || len(sizes) < 1 || len(endpoints) < 1 {
			return 0, errors.New("invalid AWG receive batch")
		}
		n, err := c.Read(packets[0])
		if err != nil {
			return 0, err
		}
		sizes[0] = n
		endpoints[0] = peerEndpoint(b.target)
		return 1, nil
	}
	return []awgconn.ReceiveFunc{receive}, 0, nil
}
func (b *peerBind) Close() error {
	b.mu.Lock()
	b.generation++
	c, cancel := b.conn, b.cancel
	b.conn = nil
	b.cancel = nil
	b.mu.Unlock()
	if cancel != nil {
		cancel()
	}
	if c != nil {
		return c.Close()
	}
	return nil
}
func (b *peerBind) SetMark(mark uint32) error {
	if mark != 0 {
		return errors.New("unowned AWG socket mark")
	}
	return nil
}
func (b *peerBind) BatchSize() int { return 1 }
func (b *peerBind) ParseEndpoint(value string) (awgconn.Endpoint, error) {
	remote, err := netip.ParseAddrPort(value)
	if err != nil || remote != b.target {
		return nil, errors.New("AWG endpoint differs from captured peer")
	}
	return peerEndpoint(remote), nil
}

// AWG sends its bounded junk prelude and handshake as one group even when
// Receive uses a one-packet batch. Preserve that group; never drop the prelude.
func (b *peerBind) Send(packets [][]byte, remote awgconn.Endpoint) error {
	ep, ok := remote.(peerEndpoint)
	if !ok || netip.AddrPort(ep) != b.target || len(packets) > 129 {
		return errors.New("unowned AWG send target or batch")
	}
	b.mu.Lock()
	c := b.conn
	b.mu.Unlock()
	if c == nil || b.ctx.Err() != nil {
		return net.ErrClosed
	}
	for _, packet := range packets {
		if len(packet) > 65535 {
			return errors.New("oversized AWG datagram")
		}
		n, err := c.Write(packet)
		if err != nil {
			return err
		}
		if n != len(packet) {
			return errors.New("short AWG datagram write")
		}
	}
	return nil
}

type peerEndpoint netip.AddrPort

func (e peerEndpoint) ClearSrc()           {}
func (e peerEndpoint) SrcToString() string { return "" }
func (e peerEndpoint) DstToString() string { return netip.AddrPort(e).String() }
func (e peerEndpoint) DstIP() netip.Addr   { return netip.AddrPort(e).Addr() }
func (e peerEndpoint) SrcIP() netip.Addr   { return netip.Addr{} }
func (e peerEndpoint) DstToBytes() []byte {
	a := netip.AddrPort(e)
	raw, _ := a.MarshalBinary()
	return raw
}
