func TestRouterVPNExternalMTUAndMeasurementsCannotOverlap(t *testing.T) {
	var activity routerVPNExternalActivity
	measurement, err := activity.beginMeasurement()
	if err != nil {
		t.Fatal(err)
	}
	if _, err := activity.beginMTU(); err == nil {
		t.Fatal("MTU replaced a reader owned by a measurement")
	}
	if _, err := activity.beginMeasurement(); err == nil {
		t.Fatal("another measurement overlapped its captured resource")
	}
	measurement()
	measurement()
	change, err := activity.beginMTU()
	if err != nil {
		t.Fatal(err)
	}
	if _, err := activity.beginMeasurement(); err == nil {
		t.Fatal("measurement adopted a reader during its MTU transaction")
	}
	if _, err := activity.beginMTU(); err == nil {
		t.Fatal("MTU transactions overlapped")
	}
	change()
	change()
	measurement, err = activity.beginMeasurement()
	if err != nil {
		t.Fatal("measurement failed after authorized MTU release", err)
	}
	measurement()
}

func TestRouterVPNExternalNativeActivityConcurrency(t *testing.T) {
	var activity routerVPNExternalActivity
	var running atomic.Int32
	var group sync.WaitGroup
	for worker := 0; worker < 16; worker++ {
		group.Add(1)
		go func(mtu bool) {
			defer group.Done()
			for n := 0; n < 50; n++ {
				var release func()
				var err error
				if mtu {
					release, err = activity.beginMTU()
				} else {
					release, err = activity.beginMeasurement()
				}
				if err != nil {
					continue
				}
				if running.Add(1) != 1 {
					t.Error("native resource had overlapping owners")
				}
				running.Add(-1)
				release()
			}
		}(worker%2 == 0)
	}
	group.Wait()
	if running.Load() != 0 {
		t.Fatal("native activity leaked")
	}
}

func TestRouterVPNExternalEmptyMTULeaseCannotMintOwnership(t *testing.T) {
	for _, lease := range []*RouterVPNExternalMTULease{nil, {}} {
		if lease.Healthy() || lease.Config() != "" || lease.Authority() != "" {
			t.Fatal("empty native lease became authoritative")
		}
		if _, err := lease.Inbound(); err == nil {
			t.Fatal("empty lease gained TUN")
		}
		if _, _, err := lease.Lifetime(context.Background()); err == nil {
			t.Fatal("empty lease gained lifetime")
		}
		if _, err := lease.ChangeMTU(context.Background(), nil, 1400); err == nil {
			t.Fatal("empty lease changed native TUN")
		}
		if _, err := lease.Resolve(context.Background(), "speed.cloudflare.com"); err == nil {
			t.Fatal("empty lease resolved public origin")
		}
		lease.Close()
		lease.Close()
	}
}

func TestRouterVPNMTUFinalizationContextPreservesOriginalCleanup(t *testing.T) {
	for _, phase := range []string{"readback", "physical-rebind", "mixed-failure", "cleanup-expired"} {
		t.Run(phase, func(t *testing.T) {
			work, finish, err := mobilemtu.WithOperationContext(context.Background(), time.Second, 30*time.Millisecond)
			if err != nil {
				t.Fatal(err)
			}
			defer finish()
			work, cancel := context.WithCancel(work)
			defer cancel()
			calls := 0
			genuine := errors.New("original native policy identity changed")
			var retained context.Context
			limit := time.Now().Add(time.Second)
			err = routerVPNMTUFinalizeContext(work, limit, func(call context.Context) error {
				calls++
				if calls == 1 {
					if call != work {
						t.Error("native read lost original caller")
					}
					if phase == "cleanup-expired" {
						retained, err = mobilemtu.OperationCleanupContext(work)
						if err != nil {
							t.Fatal(err)
						}
						<-retained.Done()
					}
					cancel()
					if phase == "mixed-failure" {
						return errors.Join(genuine, call.Err())
					}
					return call.Err()
				}
				if !mobilemtu.SameOperationContext(work, call) || call.Err() != nil {
					t.Fatal("retry lost original cleanup authority")
				}
				retained, err = mobilemtu.OperationCleanupContext(work)
				if err != nil {
					t.Fatal(err)
				}
				deadline, _ := call.Deadline()
				originalDeadline, _ := retained.Deadline()
				if deadline.After(limit) || !deadline.Equal(originalDeadline) {
					t.Fatal("finalization renewed cleanup allowance")
				}
				return nil
			})
			if !errors.Is(work.Err(), context.Canceled) {
				t.Fatal("successful cleanup erased work cancellation")
			}
			switch phase {
			case "readback", "physical-rebind":
				if err != nil || calls != 2 {
					t.Fatal("original native result could not finalize under cleanup", calls, err)
				}
			case "mixed-failure":
				if calls != 1 || !errors.Is(err, genuine) {
					t.Fatal("real native loss was retried or hidden", calls, err)
				}
			case "cleanup-expired":
				if calls != 1 || !errors.Is(err, context.DeadlineExceeded) || !errors.Is(err, context.Canceled) {
					t.Fatal("expired original cleanup was renewed or errorlost", calls, err)
				}
			}
		})
	}
}
