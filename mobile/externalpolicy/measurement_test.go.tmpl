package box_test

import "testing"

// The real pinned Box, option parser, outbound/DNS managers and proof factory
// are used; only the OS TUN is a test adapter in externalNativeFixture.
func TestRouterVPNExternalMeasurementCannotReplaceSuccessfulNativeProofWithHostBoolean(t *testing.T) {
	engine := externalNativeFixture(t, nil)
	proof, err := engine.RouterVPNExternalCreateProof(externalFixtureSource, externalFixtureCapture, "owned-session")
	if err != nil {
		t.Fatal(err)
	}
	for _, current := range []func() bool{nil, func() bool { return false }, func() bool { return true }} {
		if measurement, err := engine.RouterVPNExternalHopMeasurement(proof, externalFixtureSource, externalFixtureCapture, "owned-session", current); err == nil || measurement != nil {
			t.Fatal("an unproved native connection or host Boolean gained measurement authority")
		}
	}
	proof.Cancel()
	if measurement, err := engine.RouterVPNExternalHopMeasurement(proof, externalFixtureSource, externalFixtureCapture, "owned-session", func() bool { return true }); err == nil || measurement != nil {
		t.Fatal("cancelled native proof gained measurement authority")
	}
	if measurement, err := engine.RouterVPNExternalHopMeasurement(nil, externalFixtureSource, externalFixtureCapture, "owned-session", func() bool { return true }); err == nil || measurement != nil {
		t.Fatal("missing native proof gained measurement authority")
	}
}

func TestRouterVPNExternalMTUCannotReplaceProofWithHostSelection(t *testing.T) {
	engine := externalNativeFixture(t, nil)
	proof, err := engine.RouterVPNExternalCreateProof(externalFixtureSource, externalFixtureCapture, "owned-session")
	if err != nil {
		t.Fatal(err)
	}
	if lease, err := engine.RouterVPNExternalClaimMTU(proof, externalFixtureSource, externalFixtureCapture); err == nil || lease != nil {
		t.Fatal("unproved native Box created an MTU lease")
	}
	proof.Cancel()
	if lease, err := engine.RouterVPNExternalClaimMTU(proof, externalFixtureSource, externalFixtureCapture); err == nil || lease != nil {
		t.Fatal("canceled proof created an MTU lease")
	}
	if lease, err := engine.RouterVPNExternalClaimMTU(nil, externalFixtureSource, externalFixtureCapture); err == nil || lease != nil {
		t.Fatal("missing proof created an MTU lease")
	}
}
