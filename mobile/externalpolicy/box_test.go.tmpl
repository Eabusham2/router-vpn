// The actual native parser, Box, managers, options and proof factory are used.
// Only the OS TUN is replaced; no host route or public connection is opened.
type externalFixtureTUN struct{ inbound.Adapter }

func (*externalFixtureTUN) Start(adapter.StartStage) error { return nil }
func (*externalFixtureTUN) Close() error                   { return nil }

const externalFixtureSource = `{"log":{"disabled":true},"inbounds":[{"type":"tun","tag":"tun-in","address":["172.29.93.1/30","fd29:93::1/126"],"mtu":1280,"auto_route":true,"strict_route":true,"stack":"system"}],"outbounds":[{"type":"socks","tag":"custom-exit","version":"5","server":"203.0.113.20","server_port":443,"username":"captured-user","password":"captured-secret"}],"route":{"final":"custom-exit","auto_detect_interface":true}}`
const externalFixtureCapture = `{"schema":1,"exit_id":"selected-exit","protocol":"socks5","expected_public_ip":"203.0.113.88","profile":{"id":"selected-exit","node_kind":"external","external":{"protocol":"socks5","expected_public_ip":"203.0.113.88","socks5":{"host":"203.0.113.20","port":443,"username":"captured-user","password":"captured-secret"}},"dns_mode":"rescue","mtu_policy":"fixed","manual_mtu":1280,"home_lan_access":false,"ipv6_mode":"off"}}`

func externalNativeFixture(t *testing.T, mutate func(map[string]any)) *box.Box {
	return externalNativeCapturedFixture(t, externalFixtureSource, externalFixtureCapture, mutate)
}

func externalNativeCapturedFixture(t *testing.T, source, capture string, mutate func(map[string]any)) *box.Box {
	t.Helper()
	policy, err := mobilemultihop.NewExternalPolicy(source, capture)
	if err != nil {
		t.Fatal(err)
	}
	raw := policy.Config()
	if mutate != nil {
		var value map[string]any
		if json.Unmarshal([]byte(raw), &value) != nil {
			t.Fatal("bad fixture")
		}
		mutate(value)
		data, _ := json.Marshal(value)
		raw = string(data)
	}
	ins := include.InboundRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
		return &externalFixtureTUN{inbound.NewAdapter(C.TypeTun, tag)}, nil
	})
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx = box.Context(ctx, ins, include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(raw))
	if err != nil {
		t.Fatal("actual pinned parser", err)
	}
	engine, err := box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal("actual pinned Box construction", err)
	}
	t.Cleanup(func() { _ = engine.Close() })
	return engine
}

func externalNativeExecutionSource(t *testing.T) (string, string) {
	return externalNativeExecutionProtocolSource(t, "shadowsocks", "")
}

func externalNativeExecutionProtocolSource(t *testing.T, protocol, layerMode string) (string, string) {
	t.Helper()
	key := base64.StdEncoding.EncodeToString([]byte(strings.Repeat("k", 32)))
	external := map[string]any{"protocol": protocol, "expected_public_ip": "203.0.113.88", "response_probe": map[string]any{"url": "https://203.0.113.20/response", "server_name": "node.example"}}
	switch protocol {
	case "wireguard", "amneziawg":
		serverPrivate, _ := ecdh.X25519().NewPrivateKey([]byte(strings.Repeat("v", 32)))
		remotePrivate, _ := ecdh.X25519().NewPrivateKey([]byte(strings.Repeat("r", 32)))
		external[protocol] = map[string]any{"private_key": base64.StdEncoding.EncodeToString([]byte(strings.Repeat("l", 32))), "addresses": []string{"10.93.0.2/32", "fd93::2/128"}, "peer_public_key": base64.StdEncoding.EncodeToString(remotePrivate.PublicKey().Bytes()), "endpoint": "203.0.113.20:51820", "allowed_ips": []string{"0.0.0.0/0", "::/0"}, "mtu": 1280}
		if protocol == "amneziawg" {
			external[protocol].(map[string]any)["parameters"] = map[string]string{"jc": "3", "jmin": "40", "jmax": "900", "s1": "56", "s2": "48", "s3": "24", "s4": "32", "h1": "10-19", "h2": "20-29", "h3": "30-39", "h4": "40-49"}
		}
		external["server_peer"] = map[string]any{"public_key": base64.StdEncoding.EncodeToString(serverPrivate.PublicKey().Bytes()), "addresses": []string{"10.93.0.3/32", "fd93::3/128"}, "mtu": 1360, "persistent_keepalive_interval": 25}
	case "shadowsocks":
		external["shadowsocks"] = map[string]any{"server": "203.0.113.20", "port": 8388, "method": "aes-256-gcm", "password": "captured-external-secret"}
	case "hysteria2":
		external["hysteria2"] = map[string]any{"server": "203.0.113.20", "port": 443, "password": "captured-external-secret", "tls_server_name": "node.example"}
	case "socks5", "http-connect", "https-connect":
		transport := map[string]any{"host": "203.0.113.20", "port": 8443, "username": "captured-external-user", "password": "captured-external-secret"}
		if protocol == "https-connect" {
			transport["tls_server_name"] = "node.example"
		}
		external[strings.ReplaceAll(protocol, "-", "_")] = transport
	default:
		t.Fatal("unsupported native fixture protocol")
	}
	var layer *multihoprelay.StartLayer
	if layerMode != "" {
		layer = &multihoprelay.StartLayer{Mode: layerMode, API: "http://10.93.0.1:8787", Transport: map[string]any{"type": "shadowsocks", "tag": "provisioned-start", "server": "203.0.113.20", "server_port": 8388, "method": "2022-blake3-aes-256-gcm", "password": key}}
		raw, _ := json.Marshal(layer)
		var saved map[string]any
		if err := json.Unmarshal(raw, &saved); err != nil {
			t.Fatal(err)
		}
		external["start_layer"] = saved
	}
	paired, err := multihoprelay.ExternalSelection("selected-exit", protocol, external, layer)
	if err != nil {
		t.Fatal(err)
	}
	transport := paired.Transport
	transport["tag"], transport["detour"] = "custom-exit", "entry-wg"
	wg := map[string]any{"type": "wireguard", "tag": "entry-wg", "system": false, "listen_port": 51888, "mtu": 1280, "private_key": key, "address": []string{"10.77.0.2/32"}, "peers": []any{map[string]any{"address": "198.51.100.20", "port": 51820, "public_key": key, "allowed_ips": []string{"0.0.0.0/0", "::/0"}}}}
	var graph map[string]any
	if err := json.Unmarshal([]byte(externalFixtureSource), &graph); err != nil {
		t.Fatal(err)
	}
	graph["outbounds"], graph["endpoints"] = []any{transport}, []any{wg}
	if multihoprelay.ExternalPacketMode(protocol) {
		wg["mtu"] = 1500
		graph["outbounds"], graph["endpoints"] = []any{}, []any{wg, transport}
	}
	profile := map[string]any{"id": "selected-exit", "node_kind": "external", "dns_mode": "rescue", "ipv6_mode": "off", "home_lan_access": false, "mtu_policy": "fixed", "manual_mtu": 1280, "start_layer": layerMode, "multihop_enabled": true, "multihop_entry_id": "paired-entry", "multihop_exit_id": "selected-exit", "multihop_exit_mode": protocol, "multihop_execution": "auto", "external": external}
	capture := map[string]any{"schema": 1, "exit_id": "selected-exit", "protocol": protocol, "expected_public_ip": "203.0.113.88", "entry_tag": "entry-wg", "profile": profile, "entry": map[string]any{"id": "paired-entry", "node_kind": "router-vpn", "node_proof_id": strings.Repeat("c", 64), "router_api": "http://10.77.0.1:8787", "api_token": "captured-entry-token"}}
	source, err := json.Marshal(graph)
	if err != nil {
		t.Fatal(err)
	}
	raw, err := json.Marshal(capture)
	if err != nil {
		t.Fatal(err)
	}
	prepared, err := mobilemultihop.PrepareExternalExecutionCapture(string(source), string(raw), "")
	if err != nil {
		t.Fatal(err)
	}
	return string(source), prepared
}

func TestRouterVPNExternalExecutionAdoptsOnlyExactNativeSelectorCandidates(t *testing.T) {
	for _, protocol := range []string{"wireguard", "amneziawg", "shadowsocks", "hysteria2", "socks5", "http-connect", "https-connect"} {
		for _, layer := range []string{"", "aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			t.Run(protocol+"/"+layer, func(t *testing.T) {
				source, capture := externalNativeExecutionProtocolSource(t, protocol, layer)
				exerciseExternalNativeExecution(t, source, capture)
			})
		}
	}
}

func exerciseExternalNativeExecution(t *testing.T, source, capture string) {
	t.Helper()
	var selected map[string]any
	if json.Unmarshal([]byte(capture), &selected) != nil {
		t.Fatal("invalid native capture")
	}
	credentialField, credentialValue := "password", "foreign-private-secret"
	if protocol, _ := selected["protocol"].(string); multihoprelay.ExternalPacketMode(protocol) {
		credentialField, credentialValue = "private_key", base64.StdEncoding.EncodeToString([]byte(strings.Repeat("f", 32)))
	}
	engine := externalNativeCapturedFixture(t, source, capture, nil)
	r, err := engine.RouterVPNExternalCreateProof(source, capture, "owned-session")
	if err != nil {
		t.Fatal("captured selector graph rejected by actual native Box", err)
	}
	outbound, ok := engine.Outbound().Outbound(mobilemultihop.ExternalFinalTag)
	if !ok {
		t.Fatal("native selector is missing")
	}
	selector, ok := outbound.(*group.Selector)
	if !ok || selector.Start() != nil {
		t.Fatal("actual selector cannot acquire both native candidates")
	}
	if selector.Now() != mobilemultihop.LocalTag || !selector.SelectOutbound(mobilemultihop.ServerTag) || selector.Now() != mobilemultihop.ServerTag || !selector.SelectOutbound(mobilemultihop.LocalTag) || selector.SelectOutbound("direct") {
		t.Fatal("actual native selector lost captured candidate ownership")
	}
	if r.Healthy() || r.Execution() != "" {
		t.Fatal("configuration alone fabricated live execution proof")
	}
	// This pinned manager reports its dependency error after removing the
	// candidate from its lookup map. An error alone cannot authorize reuse:
	// the captured native proof must recheck every exact owner.
	if err := engine.Outbound().Remove(mobilemultihop.ServerTag); err == nil {
		t.Fatal("expected the actual native dependency error")
	}
	if raw, err := r.Run(); err == nil || raw != "" || r.Healthy() {
		t.Fatal("removed captured candidate retained native execution authority")
	}
	if err := r.Close(); err != nil {
		t.Fatal(err)
	}
	for _, change := range []struct {
		name, tag, field string
		value            any
	}{
		{"listener credential", mobilemultihop.ServerTag, "password", "foreign-private-secret"},
		{"listener entry detour", mobilemultihop.ServerTag, "detour", mobilemultihop.LocalTag},
		{"external credential", mobilemultihop.LocalTag, credentialField, credentialValue},
		{"selector candidate", mobilemultihop.ExternalFinalTag, "outbounds", []string{mobilemultihop.LocalTag}},
		{"selector initial owner", mobilemultihop.ExternalFinalTag, "default", mobilemultihop.ServerTag},
	} {
		t.Run(change.name, func(t *testing.T) {
			changed := externalNativeCapturedFixture(t, source, capture, func(g map[string]any) {
				for _, family := range []string{"outbounds", "endpoints"} {
					rows, _ := g[family].([]any)
					for _, raw := range rows {
						item := raw.(map[string]any)
						if item["tag"] == change.tag {
							item[change.field] = change.value
							return
						}
					}
				}
				t.Fatal("test lost captured native outbound")
			})
			if _, err := changed.RouterVPNExternalCreateProof(source, capture, "owned-session"); err == nil || strings.Contains(err.Error(), "foreign-private-secret") {
				t.Fatal("foreign native execution graph was adopted or exposed", err)
			}
		})
	}
}

func TestRouterVPNExternalNativeLayersKeepIndependentOrdinaryEntryAndExit(t *testing.T) {
	for _, protocol := range []string{"shadowsocks", "hysteria2", "socks5", "http-connect", "https-connect"} {
		for _, entryMode := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
			for _, exitMode := range []string{"aes-256-gcm", "aes-256-gcm+xor-whitening"} {
				t.Run(protocol+"/"+entryMode+"/"+exitMode, func(t *testing.T) {
					source, capture := externalNativeExecutionProtocolSource(t, protocol, exitMode)
					var graph, selected map[string]any
					if json.Unmarshal([]byte(source), &graph) != nil || json.Unmarshal([]byte(capture), &selected) != nil {
						t.Fatal("invalid captured fixture")
					}
					delete(selected, "execution")
					profile := selected["profile"].(map[string]any)
					profile["multihop_execution"] = "local"
					entryBody, _ := json.Marshal(profile)
					var entry map[string]any
					if json.Unmarshal(entryBody, &entry) != nil {
						t.Fatal("invalid copied external entry")
					}
					entry["id"], entry["multihop_enabled"], entry["start_layer"] = "paired-entry", false, entryMode
					ext := entry["external"].(map[string]any)
					ext["expected_public_ip"] = "198.51.100.88"
					delete(ext, "response_probe")
					transport := ext[strings.ReplaceAll(protocol, "-", "_")].(map[string]any)
					hostField := "server"
					if protocol == "socks5" || protocol == "http-connect" || protocol == "https-connect" {
						hostField = "host"
					}
					transport[hostField] = "198.51.100.20"
					layer := ext["start_layer"].(map[string]any)
					layer["mode"], layer["api"] = entryMode, "http://10.94.0.1:8787"
					layer["transport"].(map[string]any)["server"] = "198.51.100.20"
					layer["transport"].(map[string]any)["password"] = base64.StdEncoding.EncodeToString([]byte(strings.Repeat("i", 32)))
					rawEntry, err := multihoprelay.ExternalTransport(protocol, ext)
					if err != nil {
						t.Fatal(err)
					}
					rawEntry["tag"] = "entry-wg"
					graph["endpoints"] = []any{}
					graph["outbounds"] = append([]any{rawEntry}, graph["outbounds"].([]any)...)
					selected["entry"] = entry
					raw, _ := json.Marshal(graph)
					source = string(raw)
					raw, _ = json.Marshal(selected)
					capture = string(raw)
					engine := externalNativeCapturedFixture(t, source, capture, nil)
					request, err := engine.RouterVPNExternalCreateProof(source, capture, "owned-layer-session")
					if err != nil {
						t.Fatal("actual native owners rejected independent ordinary layers", err)
					}
					request.Cancel()
					if raw, err := request.Run(); err == nil || raw != "" || request.Healthy() {
						t.Fatal("native layer graph manufactured proof after cancellation")
					}
					for _, tag := range []string{mobilemultihop.ExternalEntryStartLayerTag, multihoprelay.ExitStartLayerTag} {
						changed := externalNativeCapturedFixture(t, source, capture, func(g map[string]any) {
							for _, raw := range g["outbounds"].([]any) {
								out := raw.(map[string]any)
								if out["tag"] == tag {
									out["password"] = base64.StdEncoding.EncodeToString([]byte(strings.Repeat("x", 32)))
									return
								}
							}
							t.Fatal("native layer owner absent")
						})
						if _, err := changed.RouterVPNExternalCreateProof(source, capture, "owned-layer-session"); err == nil {
							t.Fatal("native parser accepted changed layer credentials as the captured owner")
						}
					}
				})
			}
		}
	}
}

func TestRouterVPNExternalProofRequiresTheExactConstructedConfiguration(t *testing.T) {
	engine := externalNativeFixture(t, nil)
	request, err := engine.RouterVPNExternalCreateProof(externalFixtureSource, externalFixtureCapture, "owned-session")
	if err != nil {
		t.Fatal("factory rejected matching actual Box", err)
	}
	if request.Healthy() {
		t.Fatal("factory manufactured successful traffic proof")
	}
	request.Cancel()
	if raw, err := request.Run(); err == nil || raw != "" || request.Healthy() {
		t.Fatal("canceled actual native request ran", raw, err)
	}
	for _, mutation := range []struct {
		name   string
		change func(map[string]any)
	}{
		{"DNS resolver", func(g map[string]any) {
			g["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)["server"] = "1.0.0.1"
		}},
		{"LAN routing", func(g map[string]any) { g["route"].(map[string]any)["rules"] = []any{} }},
		{"MTU", func(g map[string]any) { g["inbounds"].([]any)[0].(map[string]any)["mtu"] = 1400 }},
		{"transport credentials", func(g map[string]any) { g["outbounds"].([]any)[0].(map[string]any)["password"] = "foreign-secret" }},
		{"transport endpoint", func(g map[string]any) { g["outbounds"].([]any)[0].(map[string]any)["server"] = "198.51.100.20" }},
	} {
		t.Run(mutation.name, func(t *testing.T) {
			changed := externalNativeFixture(t, mutation.change)
			if _, err := changed.RouterVPNExternalCreateProof(externalFixtureSource, externalFixtureCapture, "owned-session"); err == nil || strings.Contains(err.Error(), "foreign-secret") {
				t.Fatal("foreign native configuration accepted or exposed", err)
			}
		})
	}
}

func TestRouterVPNExternalProofRetiresWhenActualOutboundIsRemoved(t *testing.T) {
	engine := externalNativeFixture(t, nil)
	r, err := engine.RouterVPNExternalCreateProof(externalFixtureSource, externalFixtureCapture, "owned-session")
	if err != nil {
		t.Fatal(err)
	}
	if err := engine.Outbound().Remove("custom-exit"); err != nil {
		t.Fatal(err)
	}
	if raw, err := r.Run(); err == nil || raw != "" || r.Healthy() {
		t.Fatal("removed actual outbound retained proof ownership", raw, err)
	}
}

func TestRouterVPNExternalProofPermitsLoggingOnlyAndRejectsOtherSources(t *testing.T) {
	engine := externalNativeFixture(t, func(g map[string]any) { g["log"] = map[string]any{"disabled": true, "level": "debug"} })
	if _, err := engine.RouterVPNExternalCreateProof(externalFixtureSource, externalFixtureCapture, "owned-session"); err != nil {
		t.Fatal("logging changed network policy identity", err)
	}
	for _, capture := range []string{strings.ReplaceAll(externalFixtureCapture, "captured-secret", "foreign-secret"), strings.ReplaceAll(externalFixtureCapture, `"manual_mtu":1280`, `"manual_mtu":1400`), strings.ReplaceAll(externalFixtureCapture, `"ipv6_mode":"off"`, `"ipv6_mode":"on"`)} {
		if _, err := engine.RouterVPNExternalCreateProof(externalFixtureSource, capture, "owned-session"); err == nil {
			t.Fatal("changed selected source adopted running Box")
		}
	}
	if _, err := engine.RouterVPNExternalCreateProof(externalFixtureSource, externalFixtureCapture, ""); err == nil {
		t.Fatal("missing host session accepted")
	}
	if err := engine.Close(); err != nil {
		t.Fatal(err)
	}
	if _, err := engine.RouterVPNExternalCreateProof(externalFixtureSource, externalFixtureCapture, "replacement"); err == nil {
		t.Fatal("closed Box accepted new proof")
	}
}
