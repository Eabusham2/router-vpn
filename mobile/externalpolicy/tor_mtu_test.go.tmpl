type torMTUFixtureOptions struct {
	option.DialerOptions
	Bridges                    []string `json:"bridges"`
	SessionID                  string   `json:"session_id"`
	ProfileSHA256              string   `json:"profile_sha256,omitempty"`
	EntrySHA256                string   `json:"entry_sha256,omitempty"`
	ExternalPredecessorProfile string   `json:"external_predecessor_profile,omitempty"`
	ExternalPredecessorConfig  string   `json:"external_predecessor_config,omitempty"`
	ExternalTorProfile         string   `json:"external_tor_profile,omitempty"`
}
type torMTUFixtureOutbound struct {
	outbound.Adapter
	N.Dialer
	ctx                 context.Context
	cancel              context.CancelFunc
	session             string
	entrySHA            string
	externalEntry       *mobiletor.ExternalPredecessorProof
	externalConfig      string
	externalProofs      atomic.Int32
	externalFailed      atomic.Bool
	dnsTarget           string
	canceled            atomic.Bool
	dnsCalls            atomic.Int32
	dnsReply            atomic.Int32
	dnsMeasurementCalls atomic.Int32
	workers             sync.WaitGroup
	mu                  sync.Mutex
	closed              bool
}

// Keep the real Box DNS router and compiled TCP transport. Only the final Tor
// network is replaced by an owned in-memory DNS peer; no system resolver or
// external socket can make the selected-policy proof pass accidentally.
func (o *torMTUFixtureOutbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	target := o.dnsTarget
	if target == "" {
		target = "9.9.9.9:53"
	}
	if ctx.Err() != nil || network != N.NetworkTCP && !(network == N.NetworkUDP && o.dnsTarget != "") || destination.String() != target {
		return nil, errors.New("selected DNS escaped captured Tor route")
	}
	o.mu.Lock()
	if o.closed || o.ctx.Err() != nil {
		o.mu.Unlock()
		return nil, net.ErrClosed
	}
	o.workers.Add(1)
	o.mu.Unlock()
	client, server := net.Pipe()
	stop := context.AfterFunc(o.ctx, func() { _ = client.Close(); _ = server.Close() })
	go func() {
		defer o.workers.Done()
		defer stop()
		defer server.Close()
		peer := &dns.Conn{Conn: server}
		read := peer.ReadMsg
		write := peer.WriteMsg
		if network == N.NetworkUDP {
			// A datagram returned by the captured entry has no TCP length prefix.
			read = func() (*dns.Msg, error) {
				packet := make([]byte, 8192)
				n, err := server.Read(packet)
				if err != nil {
					return nil, err
				}
				message := new(dns.Msg)
				return message, message.Unpack(packet[:n])
			}
			write = func(message *dns.Msg) error {
				packet, err := message.Pack()
				if err == nil {
					_, err = server.Write(packet)
				}
				return err
			}
		}
		for {
			query, err := read()
			if err != nil {
				return
			}
			o.dnsCalls.Add(1)
			answer := new(dns.Msg)
			answer.SetReply(query)
			if len(query.Question) != 1 || query.Question[0].Name != "example.com." || query.Question[0].Qtype != dns.TypeA {
				answer.Rcode = dns.RcodeRefused
			} else {
				name, address := query.Question[0].Name, "93.184.216.34"
				switch o.dnsReply.Load() {
				case 1:
					answer.Rcode = dns.RcodeServerFailure
				case 2:
					address = "10.77.0.1"
				case 3:
					name = "unrelated.example."
				}
				answer.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 60}, A: net.ParseIP(address)}}
			}
			if write(answer) != nil {
				return
			}
		}
	}()
	return client, nil
}

func (o *torMTUFixtureOutbound) TorSessionID() string { return o.session }
func (o *torMTUFixtureOutbound) TorHealthy(session string) bool {
	return session == o.session && o.ctx.Err() == nil && !o.canceled.Load()
}
func (o *torMTUFixtureOutbound) CancelTor(session string) {
	if session == o.session {
		o.canceled.Store(true)
		o.cancel()
	}
}
func (o *torMTUFixtureOutbound) TorProofWithPredecessor(ctx context.Context, session string, entry *mobiletor.PredecessorProof) (mobiletor.Proof, error) {
	if o.externalEntry != nil || o.entrySHA != "" && entry.Fingerprint() != o.entrySHA {
		return mobiletor.Proof{}, errors.New("fixture circuit belongs to another captured entry")
	}
	return mobiletor.Proof{SessionID: session, IsTor: o.TorHealthy(session) && ctx.Err() == nil, IP: "198.51.100.7", CheckedAt: time.Now()}, nil
}
func (o *torMTUFixtureOutbound) TorExternalPredecessor(profile string) (*mobiletor.ExternalPredecessorProof, error) {
	if o.externalEntry == nil || !o.externalEntry.MatchesProfile(profile) {
		return nil, errors.New("ordinary fixture source changed")
	}
	return o.externalEntry, nil
}
func (o *torMTUFixtureOutbound) TorExternalConfig() string { return o.externalConfig }
func (o *torMTUFixtureOutbound) TorProofWithExternalPredecessor(ctx context.Context, session string, entry *mobiletor.ExternalPredecessorProof) (mobiletor.Proof, error) {
	o.externalProofs.Add(1)
	if entry == nil || entry != o.externalEntry || entry.Fingerprint() != o.entrySHA || o.externalFailed.Load() {
		return mobiletor.Proof{}, errors.New("ordinary fixture proof rejected")
	}
	return mobiletor.Proof{SessionID: session, IsTor: o.TorHealthy(session) && ctx.Err() == nil, IP: "198.51.100.7", CheckedAt: time.Now()}, nil
}
func (o *torMTUFixtureOutbound) TorMeasurementDial(context.Context, string, bool, string) (net.Conn, error) {
	return nil, net.ErrClosed
}
func (o *torMTUFixtureOutbound) Close() error {
	o.mu.Lock()
	o.closed = true
	o.mu.Unlock()
	o.cancel()
	o.workers.Wait()
	return nil
}

const torMTUFrozenProfile = `{"id":"tor-exit","node_kind":"external","external":{"protocol":"tor"},"dns_mode":"custom","dns_protocol":"tcp","dns_host":"9.9.9.9","dns_port":53,"home_lan_access":false,"ipv6_mode":"off","mtu_policy":"auto","jumbo_tun":false}`

func torMTUNativeFixture(t *testing.T) (*box.Box, string) {
	t.Helper()
	raw, err := mobiletor.CompileProfile(torMTUFrozenProfile, "frozen-session", "")
	if err != nil {
		t.Fatal(err)
	}
	return torMTUNativeConfigFixture(t, raw)
}

func torMTUNativeConfigFixture(t *testing.T, raw string) (*box.Box, string) {
	t.Helper()
	registry := include.OutboundRegistry()
	outbound.Register[torMTUFixtureOptions](registry, "routervpn-tor", func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options torMTUFixtureOptions) (adapter.Outbound, error) {
		var external *mobiletor.ExternalPredecessorProof
		var config string
		if options.ExternalPredecessorProfile != "" {
			var err error
			external, err = mobiletor.NewExternalPredecessorProof(options.ExternalPredecessorProfile, options.ExternalPredecessorConfig)
			if err != nil {
				return nil, err
			}
			config, err = mobiletor.CompileProfileWithExternalPredecessor(options.ExternalTorProfile, options.SessionID, options.ExternalPredecessorConfig, options.ExternalPredecessorProfile)
			if err != nil {
				return nil, err
			}
		}
		owned, cancel := context.WithCancel(ctx)
		return &torMTUFixtureOutbound{Adapter: outbound.NewAdapter("routervpn-tor", tag, []string{N.NetworkTCP}, nil), ctx: owned, cancel: cancel, session: options.SessionID, entrySHA: options.EntrySHA256,
			externalEntry: external, externalConfig: config}, nil
	})
	// This peer stands in for the private network beyond the encrypted entry.
	// The shipping DNS router and UDP/TCP transport still select their own detour.
	outbound.Register[option.ShadowsocksOutboundOptions](registry, "shadowsocks", func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.ShadowsocksOutboundOptions) (adapter.Outbound, error) {
		owned, cancel := context.WithCancel(ctx)
		return &torMTUFixtureOutbound{Adapter: outbound.NewAdapter("shadowsocks", tag, []string{N.NetworkTCP, N.NetworkUDP}, nil), ctx: owned, cancel: cancel, dnsTarget: "10.77.0.53:53"}, nil
	})
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx = box.Context(ctx, include.InboundRegistry(), registry, include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(raw))
	if err != nil {
		t.Fatal(err)
	}
	engine, err := box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = engine.Close() })
	return engine, raw
}

