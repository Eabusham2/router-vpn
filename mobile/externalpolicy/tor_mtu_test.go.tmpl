func TestRouterTorExternalProofRejectsActualGraphChangedAfterSourceCapture(t *testing.T) {
	for _, changed := range []string{"credentials", "resolver", "route", "mtu", "proxy-only", "missing-profile", "changed-profile"} {
		t.Run(changed, func(t *testing.T) {
			config := torMTUOrdinaryConfig(t)
			var graph map[string]any
			if err := json.Unmarshal([]byte(config), &graph); err != nil {
				t.Fatal(err)
			}
			profile := torMTUOrdinaryEntryProfile
			switch changed {
			case "credentials":
				for _, raw := range graph["outbounds"].([]any) {
					out := raw.(map[string]any)
					if out["tag"] == "custom-exit" {
						out["password"] = "other-provider-secret"
					}
				}
			case "resolver":
				graph["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)["server"] = "8.8.8.8"
			case "route":
				graph["route"].(map[string]any)["rules"] = []any{}
			case "mtu":
				graph["inbounds"].([]any)[0].(map[string]any)["mtu"] = 1400
			case "proxy-only":
				graph["inbounds"] = []any{map[string]any{"type": "mixed", "tag": "proxy-only", "listen": "127.0.0.1", "listen_port": 18080}}
			case "missing-profile":
				profile = ""
			case "changed-profile":
				profile = strings.Replace(profile, "captured-provider-secret", "changed-provider-secret", 1)
			}
			data, _ := json.Marshal(graph)
			engine, _ := torMTUNativeConfigFixture(t, string(data))
			proof, err := engine.RouterVPNTorCreateProof(mobiletor.ProfileOutboundTag, "frozen-session", profile)
			if err == nil {
				defer proof.Cancel()
				var raw string
				raw, err = proof.Run()
				if raw != "" || proof.Healthy() {
					t.Fatal("changed graph published an ordinary Tor proof")
				}
			}
			if err == nil || strings.Contains(err.Error(), "secret") {
				t.Fatal("changed graph acquired native authority or leaked credentials", err)
			}
			final, _ := engine.Outbound().Outbound(mobiletor.ProfileOutboundTag)
			owned := final.(*torMTUFixtureOutbound)
			if owned.externalProofs.Load() != 0 || owned.dnsCalls.Load() != 0 {
				t.Fatal("rejected source reached live proof or DNS")
			}
		})
	}
}

func TestRouterTorExternalProofAndMTURetainExactProviderAndSelectedDNS(t *testing.T) {
	for _, failure := range []string{"none", "provider", "DNS"} {
		t.Run(failure, func(t *testing.T) {
			config := torMTUOrdinaryConfig(t)
			engine, _ := torMTUNativeConfigFixture(t, config)
			final, _ := engine.Outbound().Outbound(mobiletor.ProfileOutboundTag)
			owned := final.(*torMTUFixtureOutbound)
			owned.externalFailed.Store(failure == "provider")
			if failure == "DNS" {
				owned.dnsReply.Store(1)
			}
			proof, err := engine.RouterVPNTorCreateProof(mobiletor.ProfileOutboundTag, "frozen-session", torMTUOrdinaryEntryProfile)
			if err != nil {
				t.Fatal(err)
			}
			defer proof.Cancel()
			raw, err := proof.Run()
			if failure != "none" {
				if err == nil || raw != "" || proof.Healthy() || !owned.canceled.Load() {
					t.Fatal("failed provider/DNS proof appeared connected", err)
				}
				if failure == "provider" && owned.dnsCalls.Load() != 0 {
					t.Fatal("selected DNS ran before required ordinary provider proof")
				}
				return
			}
			var result mobiletor.Proof
			if err != nil || json.Unmarshal([]byte(raw), &result) != nil || !result.DNSProven || !result.IsTor || !proof.Healthy() || owned.externalProofs.Load() != 1 || owned.dnsCalls.Load() == 0 || strings.Contains(raw, "secret") {
				t.Fatal("exact provider or selected Tor DNS lost native proof ownership", err)
			}
			lease, err := engine.RouterVPNTorClaimMTU(proof, config, torMTUOrdinaryExitProfile)
			if err != nil {
				t.Fatal(err)
			}
			defer lease.Close()
			if !lease.Healthy() || lease.Config() != config || !strings.Contains(lease.Authority(), `"source_kind":"tor"`) || strings.Contains(lease.Authority(), "expected_public_ip") {
				t.Fatal("ordinary Tor MTU lost captured entry or fabricated static Tor exit identity")
			}
			// A retest must re-prove the retained ordinary predecessor before the
			// system-TUN probe. The final circuit's old success is insufficient.
			owned.externalFailed.Store(true)
			var systemDials atomic.Int32
			err = lease.Verify(context.Background(), func(context.Context, string, string) (net.Conn, error) {
				systemDials.Add(1)
				return nil, errors.New("unowned system route")
			})
			if err == nil || owned.externalProofs.Load() != 2 || systemDials.Load() != 0 {
				t.Fatal("MTU retest bypassed current ordinary provider proof", err)
			}
			owned.externalFailed.Store(false)
			if err := engine.Outbound().Remove("custom-exit"); err != nil {
				t.Fatal(err)
			}
			if proof.Healthy() || lease.Healthy() {
				t.Fatal("removed native predecessor retained Tor proof or MTU authority")
			}
		})
	}
}

func TestRouterTorHomeDNSUsesOnlyCapturedPrivateEntry(t *testing.T) {
	entry := `{"id":"private-entry","node_kind":"router-vpn","node_proof_id":"` + strings.Repeat("a", 64) + `","router_api":"http://10.77.0.1:8787","api_token":"captured-entry-secret","adguard_ipv4":"10.77.0.53"}`
	base := `{"inbounds":[{"type":"tun","tag":"owned-tun","address":["172.29.10.1/30"],"mtu":1392,"auto_route":true,"strict_route":true}],"outbounds":[{"type":"shadowsocks","tag":"proxy","server":"198.51.100.22","server_port":443,"method":"aes-256-gcm","password":"captured-transport-secret"}],"dns":{"servers":[{"type":"tcp","tag":"entry-dns","server":"10.77.0.53","detour":"proxy"}],"final":"entry-dns"},"route":{"final":"proxy","auto_detect_interface":true}}`
	for _, protocol := range []string{"", "udp", "tcp"} {
		for _, failed := range []bool{false, true} {
			t.Run(protocol+map[bool]string{false: "/answer", true: "/failed"}[failed], func(t *testing.T) {
				profile := `{"id":"tor-exit","node_kind":"external","external":{"protocol":"tor"},"dns_protocol":"` + protocol + `","home_lan_access":false,"ipv6_mode":"off","mtu_policy":"auto","multihop_enabled":true,"multihop_entry_id":"private-entry","multihop_exit_id":"tor-exit","multihop_entry_mode":"ss","multihop_exit_mode":"tor","multihop_execution":"local"}`
				config, err := mobiletor.CompileProfileWithPredecessor(profile, "frozen-session", base, entry)
				if err != nil {
					t.Fatal(err)
				}
				engine, _ := torMTUNativeConfigFixture(t, config)
				lower, _ := engine.Outbound().Outbound("proxy")
				final, _ := engine.Outbound().Outbound(mobiletor.ProfileOutboundTag)
				private := lower.(*torMTUFixtureOutbound)
				tor := final.(*torMTUFixtureOutbound)
				if failed {
					private.dnsReply.Store(1)
				}
				proof, err := engine.RouterVPNTorCreateProof(mobiletor.ProfileOutboundTag, "frozen-session", entry)
				if err != nil {
					t.Fatal(err)
				}
				t.Cleanup(proof.Cancel)
				raw, err := proof.Run()
				if private.dnsCalls.Load() == 0 || tor.dnsCalls.Load() != 0 {
					t.Fatal("Home DNS did not exclusively use the captured private entry")
				}
				if failed {
					if err == nil || raw != "" || proof.Healthy() {
						t.Fatal("failed private AdGuard silently fell back", err)
					}
					return
				}
				var result mobiletor.Proof
				if err != nil || json.Unmarshal([]byte(raw), &result) != nil || !result.DNSProven || !proof.Healthy() {
					t.Fatal("captured private AdGuard proof failed", err)
				}
				if err := engine.Outbound().Remove("proxy"); err != nil {
					t.Fatal(err)
				}
				if proof.Healthy() {
					t.Fatal("removed private entry retained Tor DNS authority")
				}
			})
		}
	}
}

func torMTUProved(t *testing.T, engine *box.Box) *box.RouterVPNTorProofRequest {
	t.Helper()
	proof, err := engine.RouterVPNTorCreateProof(mobiletor.ProfileOutboundTag, "frozen-session", "")
	if err != nil {
		t.Fatal(err)
	}
	raw, err := proof.Run()
	if err != nil || !proof.Healthy() {
		t.Fatal("actual native capture rejected synthetic circuit fixture", err)
	}
	var delivered mobiletor.Proof
	if json.Unmarshal([]byte(raw), &delivered) != nil || !delivered.DNSProven {
		t.Fatal("actual selected native DNS route was not proved")
	}
	final, found := engine.Outbound().Outbound(mobiletor.ProfileOutboundTag)
	if !found || final.(*torMTUFixtureOutbound).dnsCalls.Load() == 0 {
		t.Fatal("Tor native proof bypassed the compiled DNS transport")
	}
	t.Cleanup(proof.Cancel)
	return proof
}

func TestRouterTorProofRejectsActualSelectedDNSFailures(t *testing.T) {
	for _, kind := range []int32{1, 2, 3} {
		t.Run(map[int32]string{1: "failed-response", 2: "private-answer", 3: "unrelated-answer"}[kind], func(t *testing.T) {
			engine, _ := torMTUNativeFixture(t)
			final, found := engine.Outbound().Outbound(mobiletor.ProfileOutboundTag)
			if !found {
				t.Fatal("actual Tor fixture missing")
			}
			owned := final.(*torMTUFixtureOutbound)
			owned.dnsReply.Store(kind)
			proof, err := engine.RouterVPNTorCreateProof(mobiletor.ProfileOutboundTag, "frozen-session", "")
			if err != nil {
				t.Fatal(err)
			}
			if raw, err := proof.Run(); err == nil || raw != "" || proof.Healthy() || !owned.canceled.Load() || owned.dnsCalls.Load() == 0 {
				t.Fatal("failed captured DNS became a healthy Tor session", err)
			}
		})
	}
}

func TestRouterTorMTUCapturesActualNativeGraphAndPolicy(t *testing.T) {
	engine, config := torMTUNativeFixture(t)
	proof := torMTUProved(t, engine)
	for _, mutate := range []func(map[string]any){
		func(g map[string]any) { g["inbounds"].([]any)[0].(map[string]any)["mtu"] = 1400 },
		func(g map[string]any) { g["route"].(map[string]any)["rules"] = []any{} },
		func(g map[string]any) {
			g["dns"].(map[string]any)["servers"].([]any)[0].(map[string]any)["server"] = "1.1.1.1"
		},
		func(g map[string]any) { g["outbounds"].([]any)[0].(map[string]any)["session_id"] = "other" },
	} {
		var graph map[string]any
		_ = json.Unmarshal([]byte(config), &graph)
		mutate(graph)
		changed, _ := json.Marshal(graph)
		if lease, err := engine.RouterVPNTorClaimMTU(proof, string(changed), torMTUFrozenProfile); err == nil || lease != nil {
			t.Fatal("changed native graph acquired Tor TUN")
		}
	}
	if lease, err := engine.RouterVPNTorClaimMTU(proof, config, strings.Replace(torMTUFrozenProfile, `"mtu_policy":"auto"`, `"mtu_policy":"default"`, 1)); err == nil || lease != nil {
		t.Fatal("mutable UI policy replaced frozen automatic selection")
	}
	lease, err := engine.RouterVPNTorClaimMTU(proof, config, torMTUFrozenProfile)
	if err != nil {
		t.Fatal(err)
	}
	defer lease.Close()
	if !lease.Healthy() || lease.Config() != config || !strings.Contains(lease.Authority(), `"source_kind":"tor"`) || strings.Contains(lease.Authority(), "expected_public_ip") {
		t.Fatal("native Tor authority lost dynamic identity")
	}
	if duplicate, err := engine.RouterVPNTorClaimMTU(proof, config, torMTUFrozenProfile); err == nil || duplicate != nil {
		t.Fatal("duplicate optimizer gained same Tor proof")
	}
	inbound, err := lease.Inbound()
	if err != nil {
		t.Fatal(err)
	}
	// This is the actual native TUN, constructed but never started on the OS.
	// A rejected replacement preserves both exact reader and proof ownership.
	current, changeErr := lease.ChangeMTU(context.Background(), inbound, 1400)
	if changeErr == nil || current != inbound || !proof.Healthy() || !lease.Healthy() {
		t.Fatal("failed native reader transaction lost the captured session", changeErr)
	}
	other, _ := torMTUNativeFixture(t)
	if foreign, err := other.RouterVPNTorClaimMTU(proof, config, torMTUFrozenProfile); err == nil || foreign != nil {
		t.Fatal("proof adopted a different native Box")
	}
	lease.Close()
	if replacement, err := engine.RouterVPNTorClaimMTU(proof, config, torMTUFrozenProfile); err != nil {
		t.Fatal("completed lease did not release native claim", err)
	} else {
		replacement.Close()
	}
}

func TestRouterTorMTUJumboAndInheritedFixedRetainNativeLease(t *testing.T) {
	for _, mode := range []string{"jumbo", "default-jumbo", "fixed", "entry-jumbo", "entry-fixed"} {
		t.Run(mode, func(t *testing.T) {
			var profile map[string]any
			if err := json.Unmarshal([]byte(torMTUFrozenProfile), &profile); err != nil {
				t.Fatal(err)
			}
			entry, base := "", ""
			wantPolicy, wantJumbo, wantEntryFixed := "auto", true, 0
			switch mode {
			case "jumbo", "default-jumbo":
				profile["jumbo_tun"] = true
				if mode == "default-jumbo" {
					profile["mtu_policy"], wantPolicy = "default", "default"
				}
			case "fixed":
				profile["mtu_policy"], profile["manual_mtu"], wantPolicy, wantJumbo = "fixed", 9000, "fixed", false
			case "entry-jumbo", "entry-fixed":
				captured := map[string]any{"id": "private-entry", "node_kind": "router-vpn", "node_proof_id": strings.Repeat("a", 64), "router_api": "http://10.77.0.1:8787", "api_token": "exact-entry-proof", "mtu_policy": "auto", "jumbo_tun": mode == "entry-jumbo"}
				if mode == "entry-fixed" {
					captured["mtu_policy"], captured["manual_mtu"], wantJumbo, wantEntryFixed = "fixed", 9000, false, 9000
				}
				encoded, err := json.Marshal(captured)
				if err != nil {
					t.Fatal(err)
				}
				entry = string(encoded)
				base = `{"inbounds":[{"type":"tun","tag":"owned-tun","stack":"system","address":["172.29.10.1/30"],"mtu":9000,"auto_route":true,"strict_route":true}],"outbounds":[{"type":"shadowsocks","tag":"proxy","server":"198.51.100.22","server_port":443,"method":"aes-256-gcm","password":"exact-transport-key"}],"route":{"final":"proxy","auto_detect_interface":true}}`
				profile["multihop_enabled"], profile["multihop_entry_id"], profile["multihop_exit_id"] = true, "private-entry", profile["id"]
				profile["multihop_entry_mode"], profile["multihop_exit_mode"], profile["multihop_execution"] = "ss", "tor", "local"
			}
			encoded, err := json.Marshal(profile)
			if err != nil {
				t.Fatal(err)
			}
			config, err := mobiletor.CompileProfileWithPredecessor(string(encoded), "frozen-session", base, entry)
			if err != nil {
				t.Fatal(err)
			}
			engine, _ := torMTUNativeConfigFixture(t, config)
			proof, err := engine.RouterVPNTorCreateProof(mobiletor.ProfileOutboundTag, "frozen-session", entry)
			if err != nil {
				t.Fatal(err)
			}
			t.Cleanup(proof.Cancel)
			if _, err := proof.Run(); err != nil || !proof.Healthy() {
				t.Fatal("native Tor/DNS proof failed", err)
			}
			lease, err := engine.RouterVPNTorClaimMTU(proof, config, string(encoded))
			if err != nil {
				t.Fatal("CONTROL: proved native Jumbo/Fixed could not retain its TUN", err)
			}
			defer lease.Close()
			var policy struct {
				MTUPolicy     string `json:"mtu_policy"`
				Jumbo         bool   `json:"jumbo_tun"`
				EntryFixedMTU int    `json:"entry_fixed_mtu"`
			}
			if json.Unmarshal([]byte(lease.Authority()), &policy) != nil || policy.MTUPolicy != wantPolicy || policy.Jumbo != wantJumbo || policy.EntryFixedMTU != wantEntryFixed {
				t.Fatal("native lease relabeled the exact captured preference", lease.Authority())
			}
			inbound, err := lease.Inbound()
			if err != nil {
				t.Fatal(err)
			}
			for _, requested := range []int{1280, 1500, 9000} {
				current, err := lease.ChangeMTU(context.Background(), inbound, requested)
				if err == nil || !strings.Contains(err.Error(), "does not permit MTU optimization") || current != inbound || !lease.Healthy() || !proof.Healthy() {
					t.Fatal("CONTROL: native Fixed/Jumbo lease reached the mutation boundary", err)
				}
			}
			if err := engine.Inbound().Remove(inbound.Tag()); err != nil {
				t.Fatal(err)
			}
			if lease.Healthy() || proof.Healthy() {
				t.Fatal("retired Jumbo reader retained native authority")
			}
		})
	}
}

func TestRouterTorMTUCancellationAndArbitraryReplacementRetireProof(t *testing.T) {
	for _, kind := range []string{"cancel", "TUN", "DNS", "Tor"} {
		t.Run(kind, func(t *testing.T) {
			engine, config := torMTUNativeFixture(t)
			proof := torMTUProved(t, engine)
			lease, err := engine.RouterVPNTorClaimMTU(proof, config, torMTUFrozenProfile)
			if err != nil {
				t.Fatal(err)
			}
			defer lease.Close()
			owned, release, err := lease.Lifetime(context.Background())
			if err != nil {
				t.Fatal(err)
			}
			defer release()
			switch kind {
			case "cancel":
				proof.Cancel()
			case "TUN":
				inbound, err := lease.Inbound()
				if err != nil {
					t.Fatal(err)
				}
				if err := engine.Inbound().Remove(inbound.Tag()); err != nil {
					t.Fatal(err)
				}
			case "DNS":
				final, _ := engine.Outbound().Outbound(mobiletor.ProfileOutboundTag)
				manager := service.FromContext[adapter.DNSTransportManager](final.(*torMTUFixtureOutbound).ctx)
				if manager == nil {
					t.Fatal("actual native DNS manager missing")
				}
				// The pinned manager can report a default-fallback error after
				// removing the tag. Proof must retire even on partial teardown.
				_ = manager.Remove("routervpn-tor-dns")
				if _, exists := manager.Transport("routervpn-tor-dns"); exists {
					t.Fatal("native DNS fixture did not remove the selected owner")
				}
			case "Tor":
				if err := engine.Outbound().Remove(mobiletor.ProfileOutboundTag); err != nil {
					t.Fatal(err)
				}
			}
			if proof.Healthy() || lease.Healthy() {
				t.Fatal("retired native dependency stayed authoritative")
			}
			if _, err := lease.Inbound(); err == nil {
				t.Fatal("retired dependency retained its TUN")
			}
			if kind == "cancel" {
				select {
				case <-owned.Done():
				case <-time.After(time.Second):
					t.Fatal("proof cancellation did not cancel owned sockets")
				}
			}
		})
	}
}
