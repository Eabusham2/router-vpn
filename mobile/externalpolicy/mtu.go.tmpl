package box

import (
	"context"
	"errors"
	"net"
	"net/netip"
	"sync"
	"sync/atomic"
	"time"

	"github.com/sagernet/sing-box/adapter"
	C "github.com/sagernet/sing-box/constant"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/hopmeasure"
	"github.com/sagernet/sing-box/experimental/libbox/routervpn/mobilemtu"
	"github.com/sagernet/sing-box/routervpn/mobiletor"
)

// A successful proof grants at most one MTU controller. Only this lease may
// move its captured TUN pointer across RouterVPNChangeMTU, which preserves all
// other native configuration and manager owners. Arbitrary replacement still
// retires proof, measurements and the optimizer.
type RouterVPNExternalMTULease struct {
	proof             *RouterVPNExternalProofRequest
	box               *Box
	ctx               context.Context
	cancel            context.CancelFunc
	closed            atomic.Bool
	config, authority string
}

// Shared native activity ownership prevents an authorized TUN transaction
// overlapping a measurement, even if a host forgets its normal MTU hold.
// No reader lock is held across network work or callbacks into native managers.
type routerVPNExternalActivity struct {
	mu           sync.Mutex
	measurements int
	changing     bool
}

func (a *routerVPNExternalActivity) beginMeasurement() (func(), error) {
	return a.beginMeasurementContext(context.Background())
}
func (a *routerVPNExternalActivity) beginMeasurementContext(ctx context.Context) (func(), error) {
	if err := adapter.RouterVPNLockContext(ctx, &a.mu); err != nil {
		return nil, err
	}
	if a.changing || a.measurements != 0 {
		a.mu.Unlock()
		return nil, errors.New("another external native operation still owns the TUN")
	}
	a.measurements++
	a.mu.Unlock()
	var once sync.Once
	return func() { once.Do(func() { a.mu.Lock(); a.measurements--; a.mu.Unlock() }) }, nil
}
func (a *routerVPNExternalActivity) beginMTU() (func(), error) {
	return a.beginMTUContext(context.Background())
}
func (a *routerVPNExternalActivity) beginMTUContext(ctx context.Context) (func(), error) {
	if err := adapter.RouterVPNLockContext(ctx, &a.mu); err != nil {
		return nil, err
	}
	if a.changing || a.measurements != 0 {
		a.mu.Unlock()
		return nil, errors.New("external measurement still owns the TUN")
	}
	a.changing = true
	a.mu.Unlock()
	var once sync.Once
	return func() { once.Do(func() { a.mu.Lock(); a.changing = false; a.mu.Unlock() }) }, nil
}

func (s *Box) RouterVPNExternalClaimMTU(proof *RouterVPNExternalProofRequest, source, capture string) (*RouterVPNExternalMTULease, error) {
	if s == nil || proof == nil || proof.engine == nil || proof.engine.box != s || !proof.Healthy() {
		return nil, errors.New("external MTU proof does not own this native Box")
	}
	config, authority, err := proof.request.MTUAuthority(source, capture)
	if err != nil {
		return nil, err
	}
	if proof.engine.physical != nil {
		config, authority, err = proof.engine.physical.mtuAuthority(config, authority)
		if err != nil {
			return nil, err
		}
	}
	ctx, cancel, err := proof.request.MTULifetime(s.ctx)
	if err != nil {
		return nil, err
	}
	lease := &RouterVPNExternalMTULease{proof: proof, box: s, ctx: ctx, cancel: cancel, config: config, authority: authority}
	if !proof.mtu.CompareAndSwap(nil, lease) {
		cancel()
		return nil, errors.New("external proof already owns an MTU controller")
	}
	if !lease.Healthy() {
		lease.Close()
		return nil, errors.New("external MTU ownership changed during capture")
	}
	return lease, nil
}

func (s *Box) RouterVPNExternalClaimMTUContext(caller context.Context, proof *RouterVPNExternalProofRequest, source, capture string) (*RouterVPNExternalMTULease, error) {
	if s == nil || proof == nil || proof.engine == nil || proof.engine.box != s {
		return nil, errors.New("external MTU proof does not own this native Box")
	}
	if err := proof.HealthyContext(caller); err != nil {
		return nil, err
	}
	config, authority, err := proof.request.MTUAuthorityContext(caller, source, capture)
	if err != nil {
		return nil, err
	}
	if proof.engine.physical != nil {
		bounded, ok := proof.engine.physical.(interface {
			mtuAuthorityContext(context.Context, string, string) (string, string, error)
		})
		if !ok {
			return nil, errors.New("external MTU physical authority omitted bounded capability")
		}
		config, authority, err = bounded.mtuAuthorityContext(caller, config, authority)
		if err != nil {
			return nil, err
		}
	}
	ctx, cancel, err := proof.request.MTULifetimeContext(caller, s.ctx)
	if err != nil {
		return nil, err
	}
	lease := &RouterVPNExternalMTULease{proof: proof, box: s, ctx: ctx, cancel: cancel, config: config, authority: authority}
	if !proof.mtu.CompareAndSwap(nil, lease) {
		cancel()
		return nil, errors.New("external proof already owns an MTU controller")
	}
	if err := lease.HealthyContext(caller); err != nil {
		lease.Close()
		return nil, err
	}
	return lease, nil
}

func (l *RouterVPNExternalMTULease) Config() string {
	if l == nil {
		return ""
	}
	return l.config
}
func (l *RouterVPNExternalMTULease) Authority() string {
	if l == nil {
		return ""
	}
	return l.authority
}
func (l *RouterVPNExternalMTULease) Healthy() bool {
	return l != nil && l.ctx != nil && l.proof != nil && !l.closed.Load() && l.ctx.Err() == nil && l.proof.mtu.Load() == l && l.proof.Healthy()
}
func (l *RouterVPNExternalMTULease) HealthyContext(ctx context.Context) error {
	if ctx == nil {
		return errors.New("external MTU observation lost caller")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if l == nil || l.ctx == nil || l.proof == nil || l.closed.Load() || l.ctx.Err() != nil || l.proof.mtu.Load() != l {
		return errors.New("external MTU lease retired")
	}
	return l.proof.HealthyContext(ctx)
}
func (l *RouterVPNExternalMTULease) InboundContext(ctx context.Context) (adapter.Inbound, error) {
	if err := l.HealthyContext(ctx); err != nil {
		return nil, err
	}
	e := l.proof.engine
	if err := adapter.RouterVPNRLockContext(ctx, &e.mu); err != nil {
		return nil, err
	}
	defer e.mu.RUnlock()
	if _, err := e.identityLockedContext(ctx); err != nil {
		return nil, err
	}
	if l.ctx.Err() != nil || l.closed.Load() {
		return nil, errors.New("external MTU lease retired")
	}
	return e.tun, ctx.Err()
}
func (l *RouterVPNExternalMTULease) Close() {
	if l != nil && !l.closed.Swap(true) {
		if l.cancel != nil {
			l.cancel()
		}
		if l.proof != nil {
			l.proof.mtu.CompareAndSwap(l, nil)
		}
	}
}
func (l *RouterVPNExternalMTULease) Lifetime(parent context.Context) (context.Context, context.CancelFunc, error) {
	if err := l.HealthyContext(parent); err != nil {
		return nil, nil, err
	}
	ctx, cancel := context.WithCancel(parent)
	stop := context.AfterFunc(l.ctx, cancel)
	release := func() { stop(); cancel() }
	if err := l.HealthyContext(ctx); err != nil {
		release()
		return nil, nil, err
	}
	return ctx, release, nil
}
func (l *RouterVPNExternalMTULease) Inbound() (adapter.Inbound, error) {
	if !l.Healthy() {
		return nil, errors.New("external MTU proof retired")
	}
	e := l.proof.engine
	e.mu.RLock()
	defer e.mu.RUnlock()
	if e.identityLocked() == "" || l.ctx.Err() != nil || l.closed.Load() {
		return nil, errors.New("external MTU TUN retired")
	}
	return e.tun, nil
}
func (l *RouterVPNExternalMTULease) ChangeMTU(parent context.Context, expected adapter.Inbound, mtu int) (adapter.Inbound, error) {
	if l == nil || l.box == nil {
		return nil, errors.New("external MTU native Box is unavailable")
	}
	return l.changeMTU(parent, expected, mtu, l.box.RouterVPNChangeMTU)
}

// The public entry supplies only the real native transaction. Tests can replace
// kernel TUN creation while retaining the actual manager, proof, cancellation,
// reader adoption and physical-policy acknowledgements around that operation.
func (l *RouterVPNExternalMTULease) changeMTU(parent context.Context, expected adapter.Inbound, mtu int,
	change func(context.Context, adapter.Inbound, int) (adapter.Inbound, error)) (adapter.Inbound, error) {
	if change == nil || mtu < 1280 || mtu > 9000 {
		return expected, errors.New("external MTU candidate is invalid")
	}
	if !mobilemtu.SameOperationContext(parent, parent) {
		compatibility, finish, err := mobilemtu.WithCleanupContext(parent, 3*time.Second)
		if err != nil {
			return expected, err
		}
		defer finish()
		parent = compatibility
	}
	ctx, release, err := l.Lifetime(parent)
	if err != nil {
		return expected, err
	}
	defer release()
	end, err := l.proof.activity.beginMTUContext(ctx)
	if err != nil {
		return expected, err
	}
	defer end()
	// The retained lease owns the TUN, but a remote provider may reconnect
	// without replacing that TUN. Read its fresh native generation before
	// taking the engine lock or changing any interface state.
	if err := l.proof.VerifyCurrentPathContext(ctx); err != nil {
		return expected, err
	}
	e := l.proof.engine
	if err := adapter.RouterVPNWriteLockContext(ctx, &e.mu); err != nil {
		return expected, err
	}
	if _, err := e.identityLockedContext(ctx); err != nil {
		e.mu.Unlock()
		return expected, err
	}
	if l.closed.Load() || l.proof.mtu.Load() != l || e.tun != expected {
		e.mu.Unlock()
		return expected, errors.New("external MTU captured reader changed")
	}
	if e.physical != nil {
		if err := e.physical.retireTUN(ctx, expected); err != nil {
			failure := err
			if mobiletor.ObservationContextExpired(ctx, err) {
				failure = errors.Join(err, routerVPNMTUFinalizeContext(ctx, time.Time{}, func(call context.Context) error { return e.physical.adoptTUN(call, expected) }))
			}
			e.mu.Unlock()
			if !mobiletor.ObservationContextOnly(failure) {
				l.proof.Cancel()
			}
			return expected, failure
		}
	}
	current, changeErr := change(ctx, expected, mtu)
	// The native manager either installs its candidate or restores its exact
	// rollback reader. It returns that captured result even on a failed change.
	// No arbitrary TUN pointer can be adopted through this boundary.
	if current == nil || current.Tag() != e.tunTag || current.Type() != C.TypeTun {
		e.mu.Unlock()
		l.proof.Cancel()
		return nil, errors.Join(changeErr, ctx.Err(), errors.New("external MTU lost the native reader"))
	}
	// The manager returned this exact transaction's reader. Keep it even if
	// the caller expired before readback; only original cleanup may finalize it.
	e.tun = current
	finalErr := routerVPNMTUFinalizeContext(ctx, time.Time{}, func(finalCtx context.Context) error {
		if err := finalCtx.Err(); err != nil {
			return err
		}
		if e.physical != nil {
			if err := e.physical.adoptTUN(finalCtx, current); err != nil {
				return err
			}
		}
		if _, err := e.identityLockedContext(finalCtx); err != nil {
			return err
		}
		if l.closed.Load() || l.proof.mtu.Load() != l {
			return errors.New("external MTU changed another native owner")
		}
		return finalCtx.Err()
	})
	e.mu.Unlock()
	if finalErr != nil {
		if !mobiletor.ObservationContextOnly(finalErr) {
			l.proof.Cancel()
			return nil, errors.Join(changeErr, ctx.Err(), finalErr)
		}
		return current, errors.Join(changeErr, ctx.Err(), finalErr)
	}
	if err := ctx.Err(); err != nil {
		return current, errors.Join(changeErr, err)
	}
	if err := l.HealthyContext(ctx); err != nil {
		return current, errors.Join(changeErr, err)
	}
	if err := l.proof.VerifyCurrentPathContext(ctx); err != nil {
		return current, errors.Join(changeErr, err)
	}
	return current, changeErr
}
func (l *RouterVPNExternalMTULease) Verify(ctx context.Context, dial func(context.Context, string, string) (net.Conn, error)) error {
	if err := l.HealthyContext(ctx); err != nil {
		return err
	}
	err := l.proof.request.VerifyMTUContext(ctx, dial)
	return errors.Join(err, l.HealthyContext(ctx), ctx.Err())
}

func (l *RouterVPNExternalMTULease) Resolve(parent context.Context, host string) ([]netip.Addr, error) {
	if err := l.HealthyContext(parent); err != nil {
		return nil, err
	}
	if host != hopmeasure.PublicHost {
		return nil, errors.New("unowned external MTU DNS target")
	}
	owned, release, err := l.Lifetime(parent)
	if err != nil {
		return nil, err
	}
	defer release()
	ctx, cancel := context.WithTimeout(owned, 5*time.Second)
	defer cancel()
	e := l.proof.engine
	ctx = adapter.WithContext(ctx, &adapter.InboundContext{Inbound: e.tunTag, InboundType: C.TypeTun, Network: "udp", Protocol: "dns"})
	addresses, err := l.box.dnsRouter.Lookup(ctx, host, adapter.DNSQueryOptions{})
	if err != nil || ctx.Err() != nil {
		return nil, errors.Join(err, ctx.Err())
	}
	if err := l.HealthyContext(ctx); err != nil {
		return nil, err
	}
	result := make([]netip.Addr, 0, len(addresses))
	for _, ip := range addresses {
		if routerVPNPublicMeasurementAddress(ip) {
			result = append(result, ip)
		}
	}
	if len(result) == 0 {
		return nil, errors.New("external MTU resolver returned no public target")
	}
	return result, nil
}

// Finalize only the already-returned native transaction. Pure work expiry may
// enter its single original cleanup allowance; native identity/policy failures
// never receive a retry that hides their failure. No caller obtains a winner
// from this helper: work cancellation is preserved separately by the lease.
func routerVPNMTUFinalizeContext(work context.Context, limit time.Time, finalize func(context.Context) error) error {
	if work == nil || finalize == nil {
		return errors.New("MTU finalization lost its original transaction")
	}
	err := finalize(work)
	if err == nil || !mobiletor.ObservationContextExpired(work, err) {
		return err
	}
	cleanup, cleanupErr := mobilemtu.OperationCleanupContext(work)
	if cleanupErr != nil {
		return errors.Join(err, cleanupErr)
	}
	if !limit.IsZero() {
		bounded, stop := context.WithDeadline(cleanup, limit)
		defer stop()
		cleanup = bounded
	}
	if cleanupErr := cleanup.Err(); cleanupErr != nil {
		return errors.Join(err, cleanupErr)
	}
	if cleanupErr := finalize(cleanup); cleanupErr != nil {
		return errors.Join(err, cleanupErr)
	}
	return nil
}
