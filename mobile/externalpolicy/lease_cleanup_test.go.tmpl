type routerVPNExternalLeaseRacingPhysical struct {
	*boundedIdentityPhysical
	stage string
	entered chan struct{}
	release chan struct{}
	once sync.Once
}
func(p *routerVPNExternalLeaseRacingPhysical)pause(){
	p.once.Do(func(){close(p.entered);<-p.release})
}
func(p *routerVPNExternalLeaseRacingPhysical)current()bool{
	if strings.HasPrefix(p.stage,"legacy"){p.pause()}
	if p.stage=="legacy-error"{return false}
	return p.boundedIdentityPhysical.current()
}
func(p *routerVPNExternalLeaseRacingPhysical)currentContext(ctx context.Context)error{
	if !strings.HasPrefix(p.stage,"legacy")&&p.stage!="tun-error"{p.pause()}
	if p.stage=="current-error"{return net.ErrClosed}
	return p.boundedIdentityPhysical.currentContext(ctx)
}
func(p *routerVPNExternalLeaseRacingPhysical)validTUNContext(ctx context.Context,_ adapter.Inbound)error{
	if p.stage=="tun-error"{p.pause();return net.ErrClosed}
	return p.boundedIdentityPhysical.currentContext(ctx)
}
func TestRouterVPNExternalLeaseInFlightObservationCannotRetireTerminalControl(t *testing.T){
	for _,stage:=range []string{"current-error","tun-error","context-success","legacy-error","legacy-success","context-replacement","legacy-replacement"}{
		t.Run(stage,func(t *testing.T){synctest.Test(t,func(t *testing.T){
			engine,physical,stop,barrier,replace:=routerVPNExternalLeaseTestOwner(t)
			racing:=&routerVPNExternalLeaseRacingPhysical{boundedIdentityPhysical:physical,stage:stage,entered:make(chan struct{}),release:make(chan struct{})}
			engine.physical=racing
			close(barrier.release)
			type result struct{identity string;err error}
			observed:=make(chan result,1)
			go func(){
				if strings.HasPrefix(stage,"legacy"){
					identity:=engine.Identity()
					var err error
					if identity==""{err=net.ErrClosed}
					observed<-result{identity,err}
				}else{
					identity,err:=engine.IdentityContext(context.Background())
					observed<-result{identity,err}
				}
			}()
			<-racing.entered
			cancelled:=make(chan struct{})
			go func(){engine.leaseCleanup.cancel();close(cancelled)}()
			<-barrier.revocation
			if strings.HasSuffix(stage,"replacement"){replace()}
			close(racing.release)
			answer:=<-observed
			<-cancelled
			if answer.identity!=""||answer.err==nil{
				t.Fatal("started-before-Cancel observation published an ordinary identity after terminal retirement")
			}
			if physical.cancelled.Load(){
				t.Fatal("in-flight ordinary observation destroyed the separately retained terminal control")
			}
			err:=stop.current(context.Background())
			if strings.HasSuffix(stage,"replacement"){
				if err==nil||!physical.cancelled.Load(){t.Fatal("retained cleanup accepted actual replacement or failed to revoke its source",err)}
			}else if err!=nil||physical.cancelled.Load(){
				t.Fatal("intentional data retirement destroyed the proved original cleanup owner",err)
			}
		})})
	}
}
func TestRouterVPNExternalLeaseObservationStillRevokesActualOwnerLoss(t *testing.T){
	for _,stage:=range []string{"current-error","tun-error","legacy-error"}{
		t.Run(stage,func(t *testing.T){synctest.Test(t,func(t *testing.T){
			engine,physical,_,_,_:=routerVPNExternalLeaseTestOwner(t)
			racing:=&routerVPNExternalLeaseRacingPhysical{boundedIdentityPhysical:physical,stage:stage,entered:make(chan struct{}),release:make(chan struct{})}
			close(racing.release)
			engine.physical=racing
			if strings.HasPrefix(stage,"legacy"){
				if engine.Identity()!=""{t.Fatal("failed original physical owner retained an identity")}
			}else if identity,err:=engine.IdentityContext(context.Background());identity!=""||err==nil{
				t.Fatal("failed original physical owner retained bounded identity",err)
			}
			if !physical.cancelled.Load()||engine.leaseCleanup.transition.Load()!=routerVPNExternalLeaseFailed{
				t.Fatal("real uncancelled owner loss was misclassified as intentional terminal retirement")
			}
		})})
	}
}

func TestRouterVPNExternalLeaseFailedTransitionDeniesBeforePhysicalCancel(t *testing.T){
	raw:=routerVPNExternalLeaseTestPipe(t)
	engine,_,_:=newRouterVPNDNSDialFixture(t,func(context.Context,string,M.Socksaddr)(net.Conn,error){return raw,nil})
	physical:=&boundedIdentityPhysical{}
	engine.physical=physical
	engine.entryTag="captured-entry"
	engine.leaseCleanup=newRouterVPNExternalLeaseCleanup(engine,nil)
	barrier:=&routerVPNExternalLeaseTestBarrier{tun:engine.tun,entered:make(chan struct{}),release:make(chan struct{}),revocation:make(chan struct{})}
	stop:=&routerVPNExternalLeaseStop{owner:engine.leaseCleanup,barrier:barrier,entry:engine.routes[engine.entryTag],
		tag:engine.entryTag,address:"10.77.0.1:8787",quiesceDone:make(chan struct{})}
	engine.leaseCleanup.pending=stop
	connection,err:=engine.Dial(context.Background(),mobilemultihop.ExternalFinalTag,"1.1.1.1:443")
	if err!=nil||connection==nil{t.Fatal("original data stream unavailable",err)}
	physical.observe=func(context.Context)error{return net.ErrClosed}
	scope:=engine.leaseCleanup.data
	scope.mu.Lock()
	held:=true
	var workers []<-chan struct{}
	defer func(){
		if held{scope.mu.Unlock()}
		for _,done:=range workers{
			select{case <-done:case <-time.After(3*time.Second):t.Error("original failed-transition test worker did not join")}
		}
	}()
	failed,failedDone:=make(chan error,1),make(chan struct{})
	workers=append(workers,failedDone)
	go func(){defer close(failedDone);_,err:=engine.IdentityContext(context.Background());failed<-err}()
	// Observe the actual CAS while retirement is held at its original mutex.
	// Mutex waits are not durably blocked in testing/synctest.
	deadline:=time.NewTimer(3*time.Second)
	defer deadline.Stop()
	for engine.leaseCleanup.transition.Load()!=routerVPNExternalLeaseFailed{
		select{case <-deadline.C:t.Fatal("actual identity failure did not claim its original transition");case <-time.After(time.Millisecond):}
	}
	if physical.cancelled.Load()||scope.retired.Load(){
		t.Fatal("controlled actual failure did not pause between its atomic claim and physical retirement")
	}
	type ioResult struct{n int;err error}
	written,writeDone:=make(chan ioResult,1),make(chan struct{})
	workers=append(workers,writeDone)
	go func(){defer close(writeDone);n,err:=connection.Write([]byte("retired"));written<-ioResult{n,err}}()
	identified,identityDone:=make(chan bool,1),make(chan struct{})
	workers=append(workers,identityDone)
	go func(){defer close(identityDone);identity,err:=engine.IdentityContext(context.Background());identified<-identity==""&&err!=nil}()
	dialed,dialDone:=make(chan bool,1),make(chan struct{})
	workers=append(workers,dialDone)
	go func(){defer close(dialDone);c,err:=engine.Dial(context.Background(),mobilemultihop.ExternalFinalTag,"1.1.1.1:443");dialed<-c==nil&&err!=nil}()
	select{
	case result:=<-written:
		if result.n!=0||!errors.Is(result.err,net.ErrClosed)||raw.writes.Load()!=0{t.Fatal("failed transition admitted an already-returned stream")}
	case <-time.After(3*time.Second):t.Fatal("failed transition left stream admission waiting behind physical retirement")
	}
	select{
	case rejected:=<-identified:if !rejected{t.Fatal("failed transition published a new ordinary identity")}
	case <-time.After(3*time.Second):t.Fatal("failed transition did not immediately reject ordinary identity")
	}
	select{
	case rejected:=<-dialed:if !rejected{t.Fatal("failed transition admitted a new ordinary dial")}
	case <-time.After(3*time.Second):t.Fatal("failed transition left ordinary dial admission waiting")
	}
	scope.mu.Unlock()
	held=false
	select{
	case err:=<-failed:if err==nil||!physical.cancelled.Load(){t.Fatal("actual failure did not revoke its original source",err)}
	case <-time.After(3*time.Second):t.Fatal("original failed observation did not return after release")
	}
	engine.leaseCleanup.cancel()
	if barrier.quiesces.Load()!=0||engine.leaseCleanup.pending!=stop{
		t.Fatal("failed winner manufactured terminal authority or dropped original unresolved ownership")
	}
	if err:=stop.current(context.Background());err==nil{t.Fatal("failed winner authorized a retained stop")}
}
