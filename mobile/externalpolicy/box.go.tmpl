// Snapshot the actual options before construction can mutate nested native
// adapters. Comparison later reparses the compiled graph with these registries.
// Only logging and the daemon-owned OOM service are operational differences;
// DNS, routes, packet policy, credentials, services and all detours remain bound.
func routerVPNExternalOptionsDigest(ctx context.Context, options option.Options) string {
	encoded := routerVPNCapturedOptions(ctx, options)
	if encoded == "" {
		return ""
	}
	sum := sha256.Sum256([]byte(encoded))
	return hex.EncodeToString(sum[:])
}

func routerVPNTorOptionsSnapshot(ctx context.Context, options option.Options) string {
	if options.Route == nil || options.Route.Final != mobiletor.ProfileOutboundTag {
		return ""
	}
	return routerVPNCapturedOptions(ctx, options)
}

func routerVPNCapturedOptions(ctx context.Context, options option.Options) string {
	if options.Route == nil || (options.Route.Final != mobilemultihop.ExternalFinalTag && options.Route.Final != mobiletor.ProfileOutboundTag) {
		return ""
	}
	options.Log = nil
	services := make([]option.Service, 0, len(options.Services))
	for _, service := range options.Services {
		if service.Type != C.TypeOOMKiller {
			services = append(services, service)
		}
	}
	options.Services = services
	encoded, err := json.MarshalContext(ctx, options)
	if err != nil {
		return ""
	}
	return string(encoded)
}

type RouterVPNExternalProofRequest struct {
	request  *mobilemultihop.ExternalProofRequest
	engine   *routerVPNExternalNativeEngine
	mtu      atomic.Pointer[RouterVPNExternalMTULease]
	activity routerVPNExternalActivity
}

// A desktop lower path adds an actual native physical owner. Mobile and other
// existing external paths leave this nil. The implementation lives in the
// desktop Box package, so imported JSON and host booleans cannot supply it.
// Its lifetime check must not acquire the engine lock: the owned TUN also
// invokes that check during a serialized native MTU replacement.
type routerVPNExternalPhysicalBinding interface {
	current() bool
	validTUN(adapter.Inbound) bool
	cancel()
	cancelObservation()
	measurementConfig(string) (string, error)
	mtuAuthority(string, string) (string, string, error)
	retireTUN(context.Context, adapter.Inbound) error
	adoptTUN(context.Context, adapter.Inbound) error
}

func (s *Box) RouterVPNExternalCreateProof(source, capture, session string) (*RouterVPNExternalProofRequest, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	return s.RouterVPNExternalCreateProofContext(ctx, source, capture, session)
}

func (s *Box) RouterVPNExternalCreateProofContext(ctx context.Context, source, capture, session string) (*RouterVPNExternalProofRequest, error) {
	if ctx == nil {
		return nil, errors.New("external native proof has no constructor caller")
	}
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	if s == nil || s.ctx == nil || s.ctx.Err() != nil || s.routerVPNExternalOptions == "" {
		return nil, errors.New("external native Box is unavailable")
	}
	policy, err := mobilemultihop.NewExternalPolicy(source, capture)
	if err != nil {
		return nil, err
	}
	compiled, err := json.UnmarshalExtendedContext[option.Options](s.ctx, []byte(policy.Config()))
	if err != nil || routerVPNExternalOptionsDigest(s.ctx, compiled) != s.routerVPNExternalOptions {
		return nil, errors.New("external proof does not match the running native configuration")
	}
	var meta struct {
		EntryTag string `json:"entry_tag"`
		TUNTag   string `json:"tun_tag"`
	}
	if err := json.Unmarshal([]byte(policy.Metadata()), &meta); err != nil {
		return nil, errors.New("external native policy metadata invalid")
	}
	engine, err := s.routerVPNCapturedEngineContext(ctx, meta.EntryTag, meta.TUNTag, mobilemultihop.ExternalFinalTag, mobilemultihop.ExternalDNSTag, compiled)
	if err != nil {
		return nil, err
	}
	request, err := mobilemultihop.NewExternalProofRequestContext(ctx, s.ctx, policy, session, engine)
	if err != nil {
		return nil, err
	}
	return &RouterVPNExternalProofRequest{request: request, engine: engine}, nil
}
func (r *RouterVPNExternalProofRequest) Run() (string, error) {
	return r.RunObserved(nil)
}
func (r *RouterVPNExternalProofRequest) RunObserved(observe func(context.Context) error) (string, error) {
	if r == nil || r.request == nil {
		return "", errors.New("external native proof request is unavailable")
	}
	raw, err := r.request.RunObserved(observe)
	if err != nil {
		r.Cancel()
	}
	return raw, err
}
func (r *RouterVPNExternalProofRequest) RunContext(ctx context.Context, observe func(context.Context) error) (string, error) {
	if r == nil || r.request == nil {
		return "", errors.New("external native proof request is unavailable")
	}
	raw, err := r.request.RunContext(ctx, observe)
	if err != nil {
		r.Cancel()
	}
	return raw, err
}
func (r *RouterVPNExternalProofRequest) Cancel() {
	if r != nil {
		if r.engine != nil && r.engine.physical != nil {
			if r.engine.leaseCleanup != nil {
				r.engine.leaseCleanup.cancel()
			} else {
				r.engine.physical.cancel()
			}
		}
		if r.request != nil {
			r.request.Cancel()
		}
	}
}
func (r *RouterVPNExternalProofRequest) Healthy() bool {
	return r != nil && r.request != nil && r.request.Healthy()
}
func (r *RouterVPNExternalProofRequest) HealthyContext(ctx context.Context) error {
	if r == nil || r.request == nil {
		return errors.New("external proof is unavailable")
	}
	return r.request.HealthyContext(ctx)
}
func (r *RouterVPNExternalProofRequest) VerifyCurrentPathContext(ctx context.Context) error {
	if r == nil || r.request == nil {
		return errors.New("external proof is unavailable")
	}
	err := r.request.VerifyCurrentPathContext(ctx)
	if err != nil && !mobiletor.ObservationContextExpired(ctx, err) && r.engine != nil && r.engine.physical != nil {
		r.engine.revokeOrdinaryOwner(true)
	}
	return err
}
func (r *RouterVPNExternalProofRequest) VerifyCurrentPath() error {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	return r.VerifyCurrentPathContext(ctx)
}
func (r *RouterVPNExternalProofRequest) Close() error {
	if r == nil || r.request == nil {
		return nil
	}
	r.Cancel()
	return r.request.Close()
}
func (r *RouterVPNExternalProofRequest) ProgressJSON() string {
	if r == nil || r.request == nil {
		return ""
	}
	return r.request.ProgressJSON()
}
func (r *RouterVPNExternalProofRequest) Execution() string {
	if r == nil || r.request == nil {
		return ""
	}
	return r.request.Execution()
}
func (r *RouterVPNExternalProofRequest) ExecutionContext(ctx context.Context) (string, error) {
	if r == nil || r.request == nil {
		return "", errors.New("external proof is unavailable")
	}
	return r.request.ExecutionContext(ctx)
}

type routerVPNExternalNativeEngine struct {
	mu       sync.RWMutex
	box      *Box
	tun      adapter.Inbound
	tunTag   string
	owners   map[string]adapter.Outbound
	routes   map[string]adapter.Outbound
	dns      map[string]adapter.DNSTransport
	services map[string]adapter.Service
	physical routerVPNExternalPhysicalBinding
	entryTag string
	leaseCleanup *routerVPNExternalLeaseCleanup
}

func (e *routerVPNExternalNativeEngine) OpenVPNRemote(tag string) (nativeopenvpn.RemoteReceipt, error) {
	if e == nil || e.Identity() == "" || (tag != mobilemultihop.LocalTag && tag != mobilemultihop.ExternalFinalTag) || tag == mobilemultihop.LocalTag && e.Selected() != tag {
		return nativeopenvpn.RemoteReceipt{}, errors.New("OpenVPN receipt belongs to a retired or unselected native route")
	}
	owner := e.routes[tag]
	endpoint, ok := owner.(interface {
		RouterVPNConnectedRemote() (nativeopenvpn.RemoteReceipt, error)
	})
	if !ok {
		return nativeopenvpn.RemoteReceipt{}, errors.New("native OpenVPN endpoint cannot attest its connected remote")
	}
	receipt, err := endpoint.RouterVPNConnectedRemote()
	current, exists := e.box.outbound.Outbound(tag)
	if err != nil {
		return nativeopenvpn.RemoteReceipt{}, err
	}
	if !exists || current != owner || e.Identity() == "" || tag == mobilemultihop.LocalTag && e.Selected() != tag {
		return nativeopenvpn.RemoteReceipt{}, errors.New("native OpenVPN remote owner changed during observation")
	}
	return receipt, nil
}

func (e *routerVPNExternalNativeEngine) SelectedContext(ctx context.Context) (string, error) {
	if _, err := e.IdentityContext(ctx); err != nil {
		return "", err
	}
	selector, ok := e.routes[mobilemultihop.ExternalFinalTag].(*group.Selector)
	if !ok {
		return "", errors.New("external native selector is unavailable")
	}
	selected := selector.Now()
	if _, err := e.IdentityContext(ctx); err != nil {
		return "", err
	}
	return selected, nil
}
func (e *routerVPNExternalNativeEngine) OpenVPNRemoteContext(ctx context.Context, tag string) (nativeopenvpn.RemoteReceipt, error) {
	var empty nativeopenvpn.RemoteReceipt
	if _, err := e.IdentityContext(ctx); err != nil {
		return empty, err
	}
	if tag != mobilemultihop.LocalTag && tag != mobilemultihop.ExternalFinalTag {
		return empty, errors.New("OpenVPN native route is not captured")
	}
	if tag == mobilemultihop.LocalTag {
		selected, err := e.SelectedContext(ctx)
		if err != nil {
			return empty, err
		}
		if selected != tag {
			return empty, errors.New("OpenVPN native route is not selected")
		}
	}
	owner := e.routes[tag]
	endpoint, ok := owner.(interface {
		RouterVPNConnectedRemoteContext(context.Context) (nativeopenvpn.RemoteReceipt, error)
	})
	if !ok {
		return empty, errors.New("OpenVPN native endpoint has no bounded remote observation")
	}
	receipt, err := endpoint.RouterVPNConnectedRemoteContext(ctx)
	if err != nil {
		return empty, err
	}
	current, found, err := adapter.RouterVPNOutboundContext(ctx, e.box.outbound, tag)
	if err != nil {
		return empty, err
	}
	if !found || current != owner {
		return empty, errors.New("OpenVPN native remote owner changed")
	}
	if _, err := e.IdentityContext(ctx); err != nil {
		return empty, err
	}
	if tag == mobilemultihop.LocalTag {
		selected, err := e.SelectedContext(ctx)
		if err != nil {
			return empty, err
		}
		if selected != tag {
			return empty, errors.New("OpenVPN native selection changed")
		}
	}
	return receipt, nil
}

func (s *Box) routerVPNExternalEngine(entryTag, tunTag string, compiled option.Options) (*routerVPNExternalNativeEngine, error) {
	return s.routerVPNCapturedEngine(entryTag, tunTag, mobilemultihop.ExternalFinalTag, mobilemultihop.ExternalDNSTag, compiled)
}

func (s *Box) routerVPNCapturedEngine(entryTag, tunTag, finalTag, dnsTag string, compiled option.Options) (*routerVPNExternalNativeEngine, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
	defer cancel()
	return s.routerVPNCapturedEngineContext(ctx, entryTag, tunTag, finalTag, dnsTag, compiled)
}

func (s *Box) routerVPNCapturedEngineContext(ctx context.Context, entryTag, tunTag, finalTag, dnsTag string, compiled option.Options) (*routerVPNExternalNativeEngine, error) {
	if ctx == nil {
		return nil, errors.New("external graph capture has no caller")
	}
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	if s == nil || s.ctx == nil || s.ctx.Err() != nil || s.outbound == nil || s.dnsRouter == nil || s.dnsTransport == nil || s.inbound == nil || s.service == nil || tunTag == "" || compiled.DNS == nil {
		return nil, errors.New("external native route owners missing")
	}
	tun, ok, err := adapter.RouterVPNInboundContext(ctx, s.inbound, tunTag)
	if err != nil {
		return nil, err
	}
	if !ok || tun == nil || tun.Type() != C.TypeTun || len(compiled.Inbounds) != 1 || compiled.Inbounds[0].Tag != tunTag {
		return nil, errors.New("external native TUN owner missing")
	}
	// Enumerate the immutable compiled configuration, then use locked manager
	// lookups. Iterating manager-owned slices while a teardown removes objects
	// would race the native slice storage. Every encrypted dependency, DNS
	// bootstrap and helper service remains bound, not only the final two tags.
	owners := map[string]adapter.Outbound{}
	tags := make([]string, 0, len(compiled.Outbounds)+len(compiled.Endpoints))
	for _, outbound := range compiled.Outbounds {
		tags = append(tags, outbound.Tag)
	}
	for _, endpoint := range compiled.Endpoints {
		tags = append(tags, endpoint.Tag)
	}
	for _, tag := range tags {
		owner, ok, err := adapter.RouterVPNOutboundContext(ctx, s.outbound, tag)
		if err != nil {
			return nil, err
		}
		if tag == "" || !ok || owner == nil {
			return nil, errors.New("external native transport owner missing")
		}
		owners[tag] = owner
	}
	routes := map[string]adapter.Outbound{}
	for _, tag := range []string{finalTag, entryTag} {
		if tag == "" {
			continue
		}
		owner := owners[tag]
		if owner == nil {
			return nil, errors.New("external native proof route missing")
		}
		routes[tag] = owner
	}
	// Execution candidates can be dialed only when the exact captured final
	// owner is the selector installed by the shared external policy compiler.
	if selector, ok := owners[mobilemultihop.ExternalFinalTag].(*group.Selector); ok && finalTag == mobilemultihop.ExternalFinalTag {
		_ = selector
		for _, tag := range []string{mobilemultihop.LocalTag, mobilemultihop.ServerTag} {
			if owners[tag] == nil {
				return nil, errors.New("external native candidate owner missing")
			}
			routes[tag] = owners[tag]
		}
	}
	dns := map[string]adapter.DNSTransport{}
	for _, configured := range compiled.DNS.Servers {
		owner, ok, err := adapter.RouterVPNTransportContext(ctx, s.dnsTransport, configured.Tag)
		if err != nil {
			return nil, err
		}
		if configured.Tag == "" || !ok || owner == nil {
			return nil, errors.New("external native DNS owner missing")
		}
		dns[configured.Tag] = owner
	}
	if dns[dnsTag] == nil {
		return nil, errors.New("external selected DNS owner missing")
	}
	services := map[string]adapter.Service{}
	for _, configured := range compiled.Services {
		if configured.Type == C.TypeOOMKiller {
			continue
		}
		owner, ok, err := adapter.RouterVPNServiceContext(ctx, s.service, configured.Tag)
		if err != nil {
			return nil, err
		}
		if configured.Tag == "" || !ok || owner == nil {
			return nil, errors.New("external native helper owner missing")
		}
		services[configured.Tag] = owner
	}
	engine := &routerVPNExternalNativeEngine{box: s, tun: tun, tunTag: tunTag, dns: dns, owners: owners, routes: routes, services: services, entryTag: entryTag}
	if _, err := engine.IdentityContext(ctx); err != nil {
		return nil, err
	}
	return engine, nil
}
func (e *routerVPNExternalNativeEngine) Identity() string {
	if e == nil {
		return ""
	}
	if !e.ordinaryObservationCurrent() { return "" }
	e.mu.RLock()
	defer e.mu.RUnlock()
	return e.identityLocked()
}

// IdentityContext observes only the captured graph. An expired read does not
// revoke a healthy physical owner; a demonstrated replacement revokes it now.
func (e *routerVPNExternalNativeEngine) IdentityContext(ctx context.Context) (string, error) {
	if e == nil {
		return "", errors.New("external native owner is unavailable")
	}
	if !e.ordinaryObservationCurrent() { return "",net.ErrClosed }
	if err := adapter.RouterVPNRLockContext(ctx, &e.mu); err != nil {
		return "", err
	}
	defer e.mu.RUnlock()
	return e.identityLockedContext(ctx)
}
func (e *routerVPNExternalNativeEngine) identityLockedContext(ctx context.Context) (string, error) {
	// Logical cancellation is not a failed native readback. Its separately
	// captured stop owner is the only authority that may retain control.
	if !e.ordinaryObservationCurrent() { return "",net.ErrClosed }
	if ctx == nil {
		return "", errors.New("external graph observation has no caller")
	}
	if err := ctx.Err(); err != nil {
		return "", err
	}
	if e == nil {
		return "", errors.New("external native owner is unavailable")
	}
	invalid := func(message string) (string, error) {
		if e.physical != nil {
			e.revokeOrdinaryOwner(true)
		}
		return "", errors.New(message)
	}
	if e.box == nil || e.box.ctx.Err() != nil {
		return invalid("external native graph was retired")
	}
	select {
	case <-e.box.done:
		return invalid("external native Box was closed")
	default:
	}
	var physical interface {
		currentContext(context.Context) error
		validTUNContext(context.Context, adapter.Inbound) error
	}
	if e.physical != nil {
		var ok bool
		physical, ok = e.physical.(interface {
			currentContext(context.Context) error
			validTUNContext(context.Context, adapter.Inbound) error
		})
		if !ok {
			return "", errors.New("external physical owner has no bounded observation")
		}
		if err := physical.currentContext(ctx); err != nil {
			if !mobiletor.ObservationContextExpired(ctx, err) {
				e.revokeOrdinaryOwner(true)
			}
			return "", err
		}
	}
	for tag, owner := range e.owners {
		current, found, err := adapter.RouterVPNOutboundContext(ctx, e.box.outbound, tag)
		if err != nil {
			return "", err
		}
		if !found || current != owner {
			return invalid("external native outbound owner changed")
		}
	}
	for tag, owner := range e.dns {
		current, found, err := adapter.RouterVPNTransportContext(ctx, e.box.dnsTransport, tag)
		if err != nil {
			return "", err
		}
		if !found || current != owner {
			return invalid("external native DNS owner changed")
		}
	}
	for tag, owner := range e.services {
		current, found, err := adapter.RouterVPNServiceContext(ctx, e.box.service, tag)
		if err != nil {
			return "", err
		}
		if !found || current != owner {
			return invalid("external native service owner changed")
		}
	}
	current, found, err := adapter.RouterVPNInboundContext(ctx, e.box.inbound, e.tunTag)
	if err != nil {
		return "", err
	}
	if !found || current != e.tun {
		return invalid("external native TUN owner changed")
	}
	if physical != nil {
		if err := physical.validTUNContext(ctx, e.tun); err != nil {
			if !mobiletor.ObservationContextExpired(ctx, err) {
				e.revokeOrdinaryOwner(true)
			}
			return "", err
		}
	}
	if err := ctx.Err(); err != nil {
		return "", err
	}
	if !e.ordinaryObservationCurrent() { return "",net.ErrClosed }
	return fmt.Sprintf("%p", e.box), nil
}

func (e *routerVPNExternalNativeEngine) identityLocked() (identity string) {
	// Check before the integrity-failure defer: ordinary denial must not
	// accidentally cancel the separately sealed cleanup owner.
	if !e.ordinaryObservationCurrent() { return "" }
	if e == nil {
		return ""
	}
	defer func() {
		if identity == "" && e.physical != nil {
			// A manager may remove an object and then return its dependency
			// error without closing it. Revoke this exact physical generation
			// on every identity failure, not only a changed interface readback.
			e.revokeOrdinaryOwner(false)
		}
	}()
	if e.box == nil || e.box.ctx.Err() != nil || e.physical != nil && !e.physical.current() {
		return ""
	}
	select {
	case <-e.box.done:
		return ""
	default:
	}
	for tag, owner := range e.owners {
		current, ok := e.box.outbound.Outbound(tag)
		if !ok || current != owner {
			return ""
		}
	}
	for tag, owner := range e.dns {
		current, ok := e.box.dnsTransport.Transport(tag)
		if !ok || current != owner {
			return ""
		}
	}
	for tag, owner := range e.services {
		current, ok := e.box.service.Get(tag)
		if !ok || current != owner {
			return ""
		}
	}
	current, ok := e.box.inbound.Get(e.tunTag)
	if !ok || current != e.tun {
		return ""
	}
	if e.physical != nil && !e.physical.validTUN(e.tun) {
		return ""
	}
	if !e.ordinaryObservationCurrent() { return "" }
	return fmt.Sprintf("%p", e.box)
}
func (e *routerVPNExternalNativeEngine) Dial(ctx context.Context, tag, address string) (net.Conn, error) {
	ctx,finish,err := e.beginData(ctx)
	if err != nil { return nil,err }
	defer finish()
	if _, err := e.IdentityContext(ctx); err != nil {
		return nil, err
	}
	if ctx.Err() != nil {
		return nil, errors.New("external native owner changed")
	}
	owner, ok := e.routes[tag]
	if !ok {
		return nil, errors.New("unowned external proof route")
	}
	host, _, err := net.SplitHostPort(address)
	if err != nil {
		return nil, errors.New("external proof destination invalid")
	}
	if _, err = netip.ParseAddr(host); err != nil {
		return nil, errors.New("external proof cannot use a default resolver")
	}
	connection, err := owner.DialContext(ctx, "tcp", M.ParseSocksaddr(address))
	var ownershipErr error
	if connection != nil { connection,ownershipErr = e.keepData(connection) }
	_, identityErr := e.IdentityContext(ctx)
	if err != nil || ownershipErr != nil || identityErr != nil || ctx.Err() != nil {
		if connection != nil {
			_ = connection.Close()
		}
		return nil, errors.New("external native dial failed or became stale")
	}
	return connection, nil
}
func routerVPNExternalDNSFailureCode(err error) (string, uint64) {
	var nativeErrno syscall.Errno
	hasErrno := errors.As(err, &nativeErrno)
	code := uint64(0)
	if hasErrno {
		code = uint64(nativeErrno)
	}
	switch {
	case errors.Is(err, context.Canceled):
		return "canceled", code
	case errors.Is(err, context.DeadlineExceeded):
		return "deadline", code
	case errors.Is(err, net.ErrClosed):
		return "closed", code
	case errors.Is(err, io.EOF), errors.Is(err, io.ErrUnexpectedEOF):
		return "eof", code
	}
	var networkError net.Error
	if errors.As(err, &networkError) && networkError.Timeout() {
		return "timeout", code
	}
	if hasErrno {
		return "syscall", code
	}
	return "other", code
}

func (e *routerVPNExternalNativeEngine) DNSProof(parent context.Context, tunTag string) error {
	parent,finish,err := e.beginData(parent)
	if err != nil { return err }
	defer finish()
	if _, err := e.IdentityContext(parent); err != nil {
		return err
	}
	if e.tunTag != tunTag {
		return errors.New("external DNS proof belongs to another TUN")
	}
	ctx, cancel := context.WithTimeout(parent, 5*time.Second)
	defer cancel()
	ctx = adapter.WithContext(ctx, &adapter.InboundContext{Inbound: tunTag, InboundType: C.TypeTun, Network: "udp", Protocol: "dns"})
	// Uses the actual selected DNS router. Supplying a transport override here
	// would bypass routing and could conceal a policy regression.
	// Preserve the original exchange result before the public proof sanitizes it.
	// Only fixed diagnostic classes and numeric errno reach the captured logger.
	selectedExchange, proofLogger := e.box.dnsRouter.Exchange, e.box.logger
	exchange := func(exchangeContext context.Context, question *dns.Msg, options adapter.DNSQueryOptions) (*dns.Msg, error) {
		answer, err := selectedExchange(exchangeContext, question, options)
		if err != nil {
			class, errno := routerVPNExternalDNSFailureCode(err)
			proofLogger.ErrorContext(exchangeContext, "routervpn external DNS proof stage=exchange class=", class, " errno=", errno)
		}
		return answer, err
	}
	if err := routerVPNStrategyDNSExchange(ctx, exchange); err != nil {
		return err
	}
	if _, err := e.IdentityContext(ctx); err != nil {
		return err
	}
	if ctx.Err() != nil {
		return errors.New("external DNS owner changed during proof")
	}
	return nil
}

func (e *routerVPNExternalNativeEngine) Select(tag string) error {
	if e.Identity() == "" || tag != mobilemultihop.LocalTag && tag != mobilemultihop.ServerTag || e.routes[tag] == nil {
		return errors.New("external candidate selection is unowned")
	}
	selector, ok := e.routes[mobilemultihop.ExternalFinalTag].(*group.Selector)
	if !ok || !selector.SelectOutbound(tag) || selector.Now() != tag || e.Identity() == "" {
		return errors.New("external selector did not retain the captured candidate")
	}
	return nil
}
func (e *routerVPNExternalNativeEngine) Selected() string {
	if e.Identity() == "" {
		return ""
	}
	selector, ok := e.routes[mobilemultihop.ExternalFinalTag].(*group.Selector)
	if !ok {
		return ""
	}
	return selector.Now()
}
