type routerDNSOperationKey struct{}

func TestRouterExternalDNSOperationsKeepOriginalNativeContext(t *testing.T) {
	for _, phase := range []string{"identity", "verify", "activity", "selected-dns", "catalog-dial", "service-start", "status", "instance-replaced", "activity-current", "scope-busy", "cancel-before"} {
		t.Run(phase, func(t *testing.T) {
			server, proof, shared, native := routerExternalMeasurementOwner(t)
			measurement, err := RouterExternalCreateDNSMeasurement(server, proof, routerExternalMeasurementSource, routerExternalMeasurementCapture, "original-measurement-session")
			if err != nil {
				t.Fatal("actual native DNS service capture", err)
			}
			defer measurement.Close()
			engine := *routerProofField[dnsmeasure.Engine](t, measurement.service, "engine")
			observer, observed := engine.(dnsmeasure.ContextEngine)
			boundary, verified := engine.(dnsmeasure.MeasurementBoundary)
			if !observed || !verified {
				t.Fatal("ordinary DNS service lost captured observation/proof methods")
			}
			parent, cancel := context.WithCancel(context.WithValue(context.Background(), routerDNSOperationKey{}, phase))
			defer cancel()
			caller := &routerConstructorCaller{Context: parent, entered: make(chan struct{})}
			originalObserve := proof.currentContext
			var legacy atomic.Int32
			proof.current = func() bool { legacy.Add(1); return false }
			admitted := make(chan struct{})
			var admittedOnce sync.Once
			proof.currentContext = func(ctx context.Context) error {
				if phase == "status" {
					deadline, ok := ctx.Deadline()
					if !ok || time.Until(deadline) > dnsmeasure.ObservationTimeout {
						return errors.New("DNS status lost bounded original observation")
					}
				} else if ctx.Value(routerDNSOperationKey{}) != phase {
					return errors.New("DNS operation detached original caller")
				}
				if phase == "verify" {
					deadline, ok := ctx.Deadline()
					if !ok || time.Until(deadline) > 1500*time.Millisecond {
						return errors.New("DNS path observation restarted its original deadline")
					}
				}
				if phase == "service-start" || phase == "status" {
					admittedOnce.Do(func() { close(admitted) })
				}
				return originalObserve(ctx)
			}
			activityLock := routerExternalMeasurementField[sync.Mutex](t, proof.request, "activity", "mu")
			var heldRW *sync.RWMutex
			var heldActivity bool
			switch phase {
			case "identity", "verify", "service-start", "status":
				heldRW = routerExternalMeasurementField[sync.RWMutex](t, proof.request, "engine", "mu")
			case "selected-dns":
				heldRW = routerExternalMeasurementField[sync.RWMutex](t, native, "dnsTransport", "access")
			case "catalog-dial":
				heldRW = routerExternalMeasurementField[sync.RWMutex](t, native, "outbound", "access")
			case "activity", "instance-replaced":
				heldActivity = true
			}
			if heldRW != nil {
				heldRW.Lock()
			}
			if heldActivity {
				activityLock.Lock()
			}
			var once sync.Once
			releaseLock := func() {
				once.Do(func() {
					if heldRW != nil {
						heldRW.Unlock()
					}
					if heldActivity {
						activityLock.Unlock()
					}
				})
			}
			defer releaseLock()
			if phase == "scope-busy" {
				activityLock.Lock()
				*routerExternalMeasurementField[bool](t, proof.request, "activity", "changing") = true
				activityLock.Unlock()
				defer func() {
					activityLock.Lock()
					*routerExternalMeasurementField[bool](t, proof.request, "activity", "changing") = false
					activityLock.Unlock()
				}()
			}
			if phase == "cancel-before" {
				cancel()
			}
			type result struct {
				ctx     context.Context
				release func()
				status  string
				err     error
			}
			done := make(chan result, 1)
			go func() {
				var actual result
				switch phase {
				case "identity":
					_, actual.err = observer.IdentityContext(caller)
				case "verify":
					actual.err = boundary.VerifyMeasurement(caller)
				case "selected-dns":
					actual.err = engine.SelectedDNS(caller)
				case "catalog-dial":
					var connection net.Conn
					connection, actual.err = engine.Dial(caller, "1.1.1.1:53")
					if connection != nil {
						actual.err = errors.Join(actual.err, connection.Close(), errors.New("held DNS observation opened a socket"))
					}
				case "service-start":
					actual.err = measurement.service.StartContext(caller, "abcdef0123456789abcdef0123456789", "tcp")
				case "status":
					actual.status = measurement.StatusJSON()
				default:
					actual.ctx, actual.release, actual.err = engine.BeginMeasurement(caller)
				}
				done <- actual
			}()
			var replacement *daemon.Instance
			if heldRW != nil || heldActivity {
				entered := caller.entered
				if phase == "service-start" || phase == "status" {
					entered = admitted
				}
				select {
				case <-entered:
				case actual := <-done:
					t.Fatal("native DNS operation bypassed its original held observation", actual.err)
				case <-time.After(time.Second):
					cancel()
					releaseLock()
					<-done
					t.Fatal("native DNS operation did not enter original observation")
				}
				if phase == "instance-replaced" {
					replacement = new(daemon.Instance)
					*routerProofField[*box.Box](t, replacement, "instance") = native
					lock := routerProofField[sync.RWMutex](t, server.StartedService, "serviceAccess")
					lock.Lock()
					*routerProofField[*daemon.Instance](t, server.StartedService, "instance") = replacement
					lock.Unlock()
					releaseLock()
				} else if phase == "service-start" {
					measurement.Cancel("abcdef0123456789abcdef0123456789")
				} else if phase != "status" {
					cancel()
				}
			}
			var actual result
			select {
			case actual = <-done:
			case <-time.After(2 * time.Second):
				cancel()
				releaseLock()
				<-done
				t.Fatal("native DNS operation failed to join its bounded observation")
			}
			if actual.release != nil {
				defer actual.release()
			}
			releaseLock()
			proof.currentContext = originalObserve
			if phase == "activity-current" {
				if actual.err != nil || actual.ctx == nil || actual.release == nil || actual.ctx.Err() != nil {
					t.Fatal("original native DNS scope was not retained", actual.err)
				}
				activityLock.Lock()
				count := *routerExternalMeasurementField[int](t, proof.request, "activity", "measurements")
				activityLock.Unlock()
				if count != 1 {
					t.Fatal("actual native DNS activity was not captured", count)
				}
				cancel()
				if actual.ctx.Err() == nil {
					t.Fatal("native DNS scope escaped original operation cancellation")
				}
				actual.release()
			} else if phase == "status" {
				var status dnsmeasure.Status
				if SJ.Unmarshal([]byte(actual.status), &status) != nil || status.Stage != "invalidated" || status.Failure == "" || len(status.Results) != 0 {
					t.Fatal("unconfirmed native DNS status reported valid results", status)
				}
			} else {
				if actual.err == nil || actual.ctx != nil || actual.release != nil {
					t.Fatal("retired or busy DNS owner gained an activity", actual.err)
				}
				if phase != "instance-replaced" && phase != "scope-busy" && !errors.Is(actual.err, context.Canceled) {
					t.Fatal("native DNS operation lost original cancellation", actual.err)
				}
			}
			if phase == "service-start" {
				if err := measurement.Drain("abcdef0123456789abcdef0123456789"); err != nil {
					t.Fatal(err)
				}
			}
			activityLock.Lock()
			count := *routerExternalMeasurementField[int](t, proof.request, "activity", "measurements")
			changing := *routerExternalMeasurementField[bool](t, proof.request, "activity", "changing")
			activityLock.Unlock()
			if count != 0 || changing != (phase == "scope-busy") {
				t.Fatal("DNS operation released another native activity", count, changing)
			}
			if replacement != nil {
				current, err := server.StartedService.RouterVPNInstanceContext(context.Background())
				if err != nil || current != replacement {
					t.Fatal("old DNS operation changed replacement instance", err)
				}
			}
			if legacy.Load() != 0 || (*routerProofField[context.Context](t, shared, "ctx")).Err() != nil || !routerProofField[atomic.Bool](t, shared, "succeeded").Load() {
				t.Fatal("DNS operation used legacy proof or retired healthy VPN")
			}
		})
	}
}

func TestRouterExternalDNSConstructorKeepsCapturedNativeOwner(t *testing.T) {
	for _, phase := range []string{"current", "legacy", "nil", "cancel-before", "instance-held", "engine-held", "dns-held", "instance-replaced", "unproved", "source-changed", "dns-policy", "session-changed", "missing-observer"} {
		t.Run(phase, func(t *testing.T) {
			server, proof, shared, native := routerExternalMeasurementOwner(t)
			started := server.StartedService
			parent, cancel := context.WithCancel(context.Background())
			defer cancel()
			caller := &routerConstructorCaller{Context: parent, entered: make(chan struct{})}
			originalObserve := proof.currentContext
			var first context.Context
			var legacy atomic.Int32
			proof.current = func() bool { legacy.Add(1); return false }
			proof.currentContext = func(ctx context.Context) error {
				if first == nil {
					first = ctx
				}
				if ctx != first || phase != "legacy" && ctx != caller {
					return errors.New("DNS native constructor replaced its original caller")
				}
				return originalObserve(ctx)
			}
			if phase == "unproved" {
				routerProofField[atomic.Bool](t, shared, "succeeded").Store(false)
			}
			if phase == "missing-observer" {
				proof.currentContext = nil
			}
			if phase == "cancel-before" {
				cancel()
			}
			var held *sync.RWMutex
			switch phase {
			case "instance-held":
				held = routerProofField[sync.RWMutex](t, started, "serviceAccess")
			case "engine-held", "instance-replaced":
				held = routerExternalMeasurementField[sync.RWMutex](t, proof.request, "engine", "mu")
			case "dns-held":
				held = routerExternalMeasurementField[sync.RWMutex](t, native, "dnsTransport", "access")
			}
			var once sync.Once
			release := func() {
				once.Do(func() {
					if held != nil {
						held.Unlock()
					}
				})
			}
			if held != nil {
				held.Lock()
			}
			defer release()
			type result struct {
				measurement *RouterDNSMeasurement
				err         error
			}
			done := make(chan result, 1)
			go func() {
				ctx := context.Context(caller)
				if phase == "nil" {
					ctx = nil
				}
				source, capture, session := routerExternalMeasurementSource, routerExternalMeasurementCapture, "original-measurement-session"
				if phase == "source-changed" {
					source += " "
				}
				if phase == "session-changed" {
					session = "replacement-session"
				}
				if phase == "dns-policy" {
					capture = strings.Replace(capture, `"dns_mode":"rescue"`, `"dns_mode":"custom","dns_protocol":"tcp","dns_host":"9.9.9.9","dns_port":5353`, 1)
					if _, err := mobilemultihop.NewExternalPolicy(source, capture); err != nil {
						done <- result{nil, errors.New("DNS alternate-policy fixture is malformed")}
						return
					}
				}
				var value *RouterDNSMeasurement
				var err error
				if phase == "legacy" {
					value, err = RouterExternalCreateDNSMeasurement(server, proof, source, capture, session)
				} else {
					value, err = routerExternalCreateDNSMeasurementContext(ctx, server, proof, source, capture, session)
				}
				done <- result{value, err}
			}()
			var replacement *daemon.Instance
			if held != nil {
				select {
				case <-caller.entered:
				case actual := <-done:
					t.Fatal("DNS constructor bypassed held original observation", actual.err)
				case <-time.After(time.Second):
					cancel()
					release()
					<-done
					t.Fatal("DNS constructor did not enter original native caller")
				}
				if phase == "instance-replaced" {
					replacement = new(daemon.Instance)
					*routerProofField[*box.Box](t, replacement, "instance") = native
					lock := routerProofField[sync.RWMutex](t, started, "serviceAccess")
					lock.Lock()
					*routerProofField[*daemon.Instance](t, started, "instance") = replacement
					lock.Unlock()
					release()
				} else {
					cancel()
				}
			}
			var actual result
			select {
			case actual = <-done:
			case <-time.After(time.Second):
				cancel()
				release()
				<-done
				t.Fatal("DNS constructor did not join original native cancellation")
			}
			release()
			if phase == "current" || phase == "legacy" {
				if actual.err != nil || actual.measurement == nil {
					t.Fatal("DNS constructor lost captured successful native owner", actual.err)
				}
				defer actual.measurement.Close()
				cancel()
				proof.currentContext = originalObserve
				engine := *routerProofField[dnsmeasure.Engine](t, actual.measurement.service, "engine")
				observer, ok := engine.(dnsmeasure.ContextEngine)
				if !ok {
					t.Fatal("ordinary native DNS service omitted original-context identity")
				}
				if _, err := observer.IdentityContext(context.Background()); err != nil {
					t.Fatal("constructor cancellation retired independent DNS service", err)
				}
				description := *routerProofField[dnsmeasure.Description](t, actual.measurement.service, "description")
				expected := dnsmeasure.Description{NodeID: "selected-exit", SessionID: "original-measurement-session", RouteLabel: "Current external exit", IPv6Enabled: false, Selected: dnsmeasure.Endpoint{ID: "selected", Kind: "selected", Name: "Selected DNS", Address: "1.1.1.1", Port: 443, Transport: "https", ServerName: "cloudflare-dns.com", Path: "/dns-query", Route: "custom-exit", RouteLabel: "Selected DNS via custom-exit"}}
				if description != expected {
					t.Fatal("DNS constructor changed selected capture", description)
				}
				var status dnsmeasure.Status
				if SJ.Unmarshal([]byte(actual.measurement.StatusJSON()), &status) != nil || status.Stage != "idle" || status.Request != "" || !status.Drained || len(status.Results) != 0 {
					t.Fatal("DNS constructor manufactured query results or started work", status)
				}
			} else {
				if actual.measurement != nil {
					_ = actual.measurement.Close()
				}
				if actual.err == nil || actual.measurement != nil {
					t.Fatal("DNS constructor published unproved, replaced or foreign capture", actual.err)
				}
				if strings.Contains(actual.err.Error(), "fixture is malformed") {
					t.Fatal(actual.err)
				}
				if phase == "cancel-before" || phase == "instance-held" || phase == "engine-held" || phase == "dns-held" {
					if !errors.Is(actual.err, context.Canceled) {
						t.Fatal("DNS constructor lost original cancellation", actual.err)
					}
				}
			}
			if replacement != nil {
				current, err := started.RouterVPNInstanceContext(context.Background())
				if err != nil || current != replacement {
					t.Fatal("old DNS constructor changed replacement owner", err)
				}
			}
			if legacy.Load() != 0 {
				t.Fatal("DNS constructor used legacy proof callback")
			}
			if phase != "unproved" && ((*routerProofField[context.Context](t, shared, "ctx")).Err() != nil || !routerProofField[atomic.Bool](t, shared, "succeeded").Load()) {
				t.Fatal("DNS construction retired the healthy original proof")
			}
		})
	}
}

const routerExternalMeasurementSource = `{"log":{"disabled":true},"inbounds":[{"type":"tun","tag":"tun-in","address":["172.29.93.1/30","fd29:93::1/126"],"mtu":1280,"auto_route":true,"strict_route":true,"stack":"system"}],"outbounds":[{"type":"socks","tag":"custom-exit","version":"5","server":"203.0.113.20","server_port":443,"username":"captured-user","password":"captured-secret"}],"route":{"final":"custom-exit","auto_detect_interface":true}}`
const routerExternalMeasurementCapture = `{"schema":1,"exit_id":"selected-exit","protocol":"socks5","expected_public_ip":"203.0.113.88","profile":{"id":"selected-exit","node_kind":"external","external":{"protocol":"socks5","expected_public_ip":"203.0.113.88","socks5":{"host":"203.0.113.20","port":443,"username":"captured-user","password":"captured-secret"}},"dns_mode":"rescue","mtu_policy":"fixed","manual_mtu":1280,"home_lan_access":false,"ipv6_mode":"off"}}`

type routerExternalMeasurementTUN struct{ inbound.Adapter }

func (*routerExternalMeasurementTUN) Start(adapter.StartStage) error { return nil }
func (*routerExternalMeasurementTUN) Close() error                   { return nil }

// Only this fixture inspects exact pinned private fields. Native capture,
// identity, manager and activity observations still execute shipping methods.
func routerExternalMeasurementField[T any](t *testing.T, owner any, names ...string) *T {
	t.Helper()
	field := reflect.ValueOf(owner)
	for _, name := range names {
		if field.Kind() == reflect.Pointer {
			field = field.Elem()
		}
		if !field.IsValid() || field.Kind() != reflect.Struct {
			t.Fatal("pinned external observation owner changed", names)
		}
		field = field.FieldByName(name)
	}
	if !field.IsValid() || !field.CanAddr() || field.Type() != reflect.TypeFor[T]() {
		t.Fatal("pinned external observation field changed", names)
	}
	return (*T)(unsafe.Pointer(field.UnsafeAddr()))
}

func routerExternalMeasurementOwner(t *testing.T) (*CommandServer, *RouterExternalProofRequest, *mobilemultihop.ExternalProofRequest, *box.Box) {
	t.Helper()
	policy, err := mobilemultihop.NewExternalPolicy(routerExternalMeasurementSource, routerExternalMeasurementCapture)
	if err != nil {
		t.Fatal(err)
	}
	ins := include.InboundRegistry()
	inbound.Register[option.TunInboundOptions](ins, C.TypeTun, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.TunInboundOptions) (adapter.Inbound, error) {
		return &routerExternalMeasurementTUN{inbound.NewAdapter(C.TypeTun, tag)}, nil
	})
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	ctx = box.Context(ctx, ins, include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
	options, err := SJ.UnmarshalExtendedContext[option.Options](ctx, []byte(policy.Config()))
	if err != nil {
		t.Fatal("actual native external parser", err)
	}
	native, err := box.New(box.Options{Context: ctx, Options: options})
	if err != nil {
		t.Fatal("actual native external Box", err)
	}
	t.Cleanup(func() { _ = native.Close() })
	started := daemon.NewStartedService(daemon.ServiceOptions{Context: context.Background(), LogMaxLines: 16})
	instance := new(daemon.Instance)
	*routerProofField[*box.Box](t, instance, "instance") = native
	*routerProofField[*daemon.Instance](t, started, "instance") = instance
	t.Cleanup(func() {
		lock := routerProofField[sync.RWMutex](t, started, "serviceAccess")
		lock.Lock()
		*routerProofField[*daemon.Instance](t, started, "instance") = nil
		lock.Unlock()
		started.Close()
	})
	server := &CommandServer{StartedService: started}
	proof, err := RouterExternalCreateProof(server, routerExternalMeasurementSource, routerExternalMeasurementCapture, "original-measurement-session")
	if err != nil {
		t.Fatal("actual native proof capture", err)
	}
	t.Cleanup(func() { _ = proof.Close() })
	shared := *routerProofField[*mobilemultihop.ExternalProofRequest](t, proof.request, "request")
	// This is an ownership fixture, not a successful network proof. Model only
	// the already-proved state; source compilation, actual Box/TUN managers,
	// StartedService and complete measurement constructors remain real.
	routerProofField[atomic.Bool](t, shared, "succeeded").Store(true)
	if err := proof.healthyContext(context.Background()); err != nil {
		t.Fatal("captured native fixture is not current", err)
	}
	return server, proof, shared, native
}

func TestRouterExternalHopContextKeepsOriginalNativeOwner(t *testing.T) {
