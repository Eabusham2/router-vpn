// Only the fixture accesses private fields, checking the exact pinned type.
// Production observation still uses the original native methods and mutexes.
func routerProofField[T any](t *testing.T, owner any, name string) *T {
	t.Helper()
	field := reflect.ValueOf(owner).Elem().FieldByName(name)
	if !field.IsValid() || !field.CanAddr() || field.Type() != reflect.TypeFor[T]() {
		t.Fatal("pinned native field changed", name)
	}
	return (*T)(unsafe.Pointer(field.UnsafeAddr()))
}
func routerProofNativeOwner(t *testing.T) (*routerMultihopEngine, *daemon.StartedService, *O.Manager, *O.Registry) {
	t.Helper()
	registry := O.NewRegistry()
	manager := O.NewManager(log.NewNOPFactory().Logger(), registry, nil, "")
	native := new(box.Box)
	*routerProofField[*O.Manager](t, native, "outbound") = manager
	instance := new(daemon.Instance)
	*routerProofField[*box.Box](t, instance, "instance") = native
	started := daemon.NewStartedService(daemon.ServiceOptions{Context: context.Background(), LogMaxLines: 16})
	t.Cleanup(started.Close)
	*routerProofField[*daemon.Instance](t, started, "instance") = instance
	return &routerMultihopEngine{server: &CommandServer{StartedService: started}, instance: native}, started, manager, registry
}
func TestRouterNativeProofContextRetiresHeldReads(t *testing.T) {
	for _, phase := range []string{"identity", "dial", "dns", "hop-identity", "hop-dial", "capture", "selected", "manager-dial", "manager-selected", "select", "manager-select"} {
		t.Run(phase, func(t *testing.T) {
			core, started, manager, _ := routerProofNativeOwner(t)
			held := routerProofField[sync.RWMutex](t, started, "serviceAccess")
			if phase == "manager-dial" || phase == "manager-selected" || phase == "manager-select" {
				held = routerProofField[sync.RWMutex](t, manager, "access")
			}
			held.Lock()
			var once sync.Once
			release := func() { once.Do(held.Unlock) }
			defer release()
			ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
			defer cancel()
			done := make(chan error, 1)
			go func() {
				var err error
				hop := &routerHopMeasurementEngine{core: core}
				switch phase {
				case "select", "manager-select":
					err = core.SelectContext(ctx, mobilemultihop.ServerTag)
				case "identity":
					_, err = core.IdentityContext(ctx)
				case "dial", "manager-dial":
					_, err = core.Dial(ctx, mobilemultihop.LocalTag, "1.1.1.1:443")
				case "dns":
					err = core.DNSProof(ctx)
				case "hop-identity":
					_, err = hop.IdentityContext(ctx)
				case "hop-dial":
					_, err = hop.Dial(ctx, "entry-wg", "1.1.1.1:443")
				case "capture":
					_, err = routerCapturedMultihopEngine(ctx, core.server)
				case "selected", "manager-selected":
					_, err = core.SelectedContext(ctx)
				}
				done <- err
			}()
			select {
			case err := <-done:
				if !errors.Is(err, context.DeadlineExceeded) {
					t.Fatal("native read lost original caller deadline", err)
				}
			case <-time.After(time.Second):
				release()
				<-done
				t.Fatal("native read waited on original mutex after caller expired")
			}
			release()
			if identity, err := core.IdentityContext(context.Background()); err != nil || identity == "" {
				t.Fatal("cancelled read retired the original native instance", err)
			}
		})
	}
}

