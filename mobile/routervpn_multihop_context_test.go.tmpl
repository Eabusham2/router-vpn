	dial func(context.Context) (net.Conn, error)
}

func (o *routerProofDialOutbound) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
	return nil, errors.New("unowned packet route in TCP proof fixture")
}
func (o *routerProofDialOutbound) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
	return o.dial(ctx)
