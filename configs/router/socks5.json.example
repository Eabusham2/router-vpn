{
  "log": {"level": "warn"},
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "::",
      "listen_port": 1080,
      "users": [
        {"username": "TEMP_INIT_USER", "password": "TEMP_INIT_PASSWORD"}
      ]
    }
  ],
  "outbounds": [{"type": "direct", "tag": "direct"}],
  "route": {"default_domain_resolver": "home-dns"},
  "dns": {
    "servers": [
      {"type": "udp", "tag": "home-dns", "server": "CHANGE_ADGUARD_IPV4", "server_port": 53}
    ]
  }
}
