diff --git a/deploy/test_ios_xray_exits.py b/deploy/test_ios_xray_exits.py
new file mode 100644
index 0000000000000000000000000000000000000000..bb95e3d268822ff52999545d1b688794191bca3a
--- /dev/null
+++ b/deploy/test_ios_xray_exits.py
@@ -0,0 +1,206 @@
+#!/usr/bin/env python3
+"""Execute Apple exit graph/MTU code with the real shared Go compiler.
+
+Native fixture keys are generated by Go 1.24+. --entry-fixtures accepts the same
+previously generated public fixture file for an offline test machine. Neither
+path stubs the compiler, uses a live node, or claims physical-device acceptance.
+"""
+from pathlib import Path
+import argparse
+import importlib.util
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+POLICY = ROOT / 'ios/RouterVPN/PacketTunnel/RouterVPNMultihopGraph.swift'
+GO_HELPER = r'''package main
+import("encoding/json";"fmt";"io";"os";"router-vpn/internal/mobilemultihop";"router-vpn/internal/mobileperf")
+func main(){
+ var input struct{Op string;Config string;Policy string}
+ if err:=json.NewDecoder(io.LimitReader(os.Stdin,8<<20)).Decode(&input);err!=nil{fmt.Fprintln(os.Stderr,"invalid test request");os.Exit(1)}
+ var value string;var err error
+ switch input.Op{
+ case "exit":value,err=mobilemultihop.CompileXrayExit(input.Config,input.Policy)
+ case "plan":var c *mobilemultihop.Controller;c,err=mobilemultihop.New(input.Config,input.Policy);if err==nil{value=c.Config();err=c.Close()}
+ case "mtu":value,err=mobilemultihop.ApplyMTUPolicy(input.Config,input.Policy)
+ case "mtu-profile":value,err=mobilemultihop.MultihopMTUProfile(input.Config,input.Policy)
+ case "lan":value,err=mobilemultihop.ApplyLANPolicy(input.Config,input.Policy)
+ case "performance":value,err=mobileperf.Apply(input.Config,input.Policy)
+ default:err=fmt.Errorf("unknown test operation")
+ }
+ if err!=nil{fmt.Fprintln(os.Stderr,err);os.Exit(1)};fmt.Print(value)
+}
+'''
+TEST = r'''
+let nativeEntries = try JSONSerialization.jsonObject(with: Data(contentsOf: URL(fileURLWithPath:ProcessInfo.processInfo.environment["ROUTERVPN_XRAY_ENTRY_FIXTURES"]!))) as! [String:[String:Any]]
+func json(_ value: Any) throws -> String { String(decoding:try JSONSerialization.data(withJSONObject:value,options:[.sortedKeys]),as:UTF8.self) }
+func object(_ text: String) throws -> [String:Any] { try JSONSerialization.jsonObject(with:Data(text.utf8)) as! [String:Any] }
+func rpc(_ op: String,_ config: String,_ policy: String) throws -> String {
+    let child=Process(),input=Pipe(),output=Pipe(),errors=Pipe()
+    child.executableURL=URL(fileURLWithPath:ProcessInfo.processInfo.environment["ROUTERVPN_XRAY_EXIT_POLICY"]!)
+    child.standardInput=input;child.standardOutput=output;child.standardError=errors
+    try child.run()
+    try input.fileHandleForWriting.write(contentsOf:Data(json(["Op":op,"Config":config,"Policy":policy]).utf8))
+    try input.fileHandleForWriting.close()
+    let result=output.fileHandleForReading.readDataToEndOfFile()
+    let diagnostic=errors.fileHandleForReading.readDataToEndOfFile()
+    child.waitUntilExit()
+    guard child.terminationStatus==0 else { throw P.issue("Production policy rejected input: "+String(decoding:diagnostic,as:UTF8.self)) }
+    return String(decoding:result,as:UTF8.self)
+}
+func compile(_ assets: String,_ mode: String) throws -> String { try rpc("exit",assets,mode) }
+@MainActor func entryEndpoint(_ mode: String) -> [String:Any] {
+    if let native=nativeEntries[mode]{return native}
+    if mode=="wg" {return wg}
+    if mode.hasPrefix("awg2-"){
+        var endpoint=wg;endpoint["type"]="routervpn-amneziawg"
+        endpoint["amnezia"]=["jc":"3","jmin":"40","jmax":"900","s1":"56","s2":"48","s3":"24","s4":mode=="awg2-fast" ? "32":"80","h1":"10-19","h2":"20-29","h3":"30-39","h4":"40-49"]
+        return endpoint
+    }
+    var proxy:[String:Any]=["type":mode,"tag":P.entryTag,"server":"192.0.2.11","server_port":443,"password":key]
+    if mode=="shadowsocks"{proxy["method"]="2022-blake3-aes-256-gcm"}
+    else {proxy["tls"]=["enabled":true,"server_name":"entry.example.test"]}
+    return proxy
+}
+@MainActor func assets(_ mode: String, legacy: Bool=false) throws -> [String:String] {
+    var raw=try object(nativeEntries[mode]!["config_json"] as! String)
+    var out=raw["outbounds"] as! [[String:Any]],settings=out[0]["settings"] as! [String:Any]
+    var peers=settings["vnext"] as! [[String:Any]],users=peers[0]["users"] as! [[String:Any]]
+    users[0]["id"]="22222222-2222-4222-8222-222222222222"
+    peers[0]["address"]="198.51.100.22";peers[0]["users"]=users;settings["vnext"]=peers
+    out[0]["settings"]=settings;raw["outbounds"]=out
+    var result=["xray.json":Data(try json(raw).utf8).base64EncodedString()]
+    if !legacy {
+        let wrapper:[String:Any]=["inbounds":[["type":"tun","auto_route":true,"strict_route":true]],
+          "outbounds":[["type":"socks","tag":"owned-exit","server":"127.0.0.1","server_port":1090,"version":"5"]],
+          "dns":["servers":[["type":"udp","tag":"home","server":"192.168.50.133","detour":"owned-exit"]],"final":"home"],
+          "route":["final":"owned-exit","rules":[["protocol":"dns","action":"hijack-dns"]]]]
+        result["sing-box.json"]=Data(try json(wrapper).utf8).base64EncodedString()
+    }
+    return result
+}
+var graphCount=0
+let entryModes=["wg","awg2-fast","awg2-strong","shadowsocks","hysteria2","reality-vision","reality-pq-vision","reality-xhttp"]
+@MainActor func verify(_ phase: String,_ entryMode: String,_ exitMode: String,_ execution: String,_ dnsMode: String) throws {
+    var e=entry,x=exit
+    e["router_api"]="http://10.77.0.1:8787";e["api_token"]="test-entry-token"
+    x["router_api"]="http://10.88.0.1:8787";x["api_token"]="test-exit-token"
+    e["mtu_policy"]="fixed";e["manual_mtu"]=1500;e["home_lan_access"]=false;e["ipv6_mode"]="off"
+    x["mtu_policy"]="auto";x["home_lan_access"]=false;x["ipv6_mode"]="off"
+    x["dns_mode"]=dnsMode;x["dns_protocol"]="tcp";x["dns_host"]="192.168.50.133"
+    x["dns_server_name"]="resolver.example.test";x["dns_path"]="/private-dns";x["dns_port"]=5353;x["adguard_ipv4"]="192.168.50.133"
+    let original=try assets(exitMode),snapshot=original
+    let compiled=try P.xrayFiles(assets:original,mode:exitMode,profile:x,compiler:compile)
+    try check("raw exit never staged as another backend",Set(compiled.keys)==Set(["sing-box.json"]))
+    let built=try P.build(entryEndpoint:entryEndpoint(entryMode),entryProfile:e,exitProfile:x,exitMode:exitMode,files:compiled)
+    let sized=try RouterVPNMTUPolicy.multihop(built,entryProfile:e,exitProfile:x)
+    let profiles=try json(["entry":e,"exit":x])
+    let graphText=String(decoding:sized["sing-box.json"]!,as:UTF8.self)
+    let sharedMTU=try rpc("mtu",graphText,profiles)
+    let lan=try rpc("lan",sharedMTU,profiles)
+    let final=try rpc("performance",lan,profiles)
+    let graph=try object(final),out=graph["outbounds"] as! [[String:Any]],ins=graph["inbounds"] as! [[String:Any]],ends=graph["endpoints"] as! [[String:Any]]
+    let last=out.first{$0["tag"] as? String=="proxy"}!,first=(out+ends).first{$0["tag"] as? String==P.entryTag}!
+    let nativeSource=String(data:Data(base64Encoded:original["xray.json"]!)!,encoding:.utf8)!
+    try check("native exit exact original protocol",last["mode"] as? String==exitMode && last["config_json"] as? String==nativeSource)
+    try check("exit socket ownership",last["detour"] as? String==P.entryTag && last.count==5 && first["detour"]==nil)
+    try check("one system VPN",ins.filter{$0["type"] as? String=="tun"}.count==1 && ends.count==(entryMode=="wg" || entryMode.hasPrefix("awg2-") ? 1:0))
+    let tun=ins.first{$0["type"] as? String=="tun"}!,addresses=tun["address"] as! [String]
+    try check("capture IPv4 and IPv6 even with IPv6-Off",addresses.contains{$0.contains(":")} && addresses.contains{!$0.contains(":")})
+    try check("MTU belongs to actual interface",tun["mtu"] as? Int==(entryMode=="wg" || entryMode.hasPrefix("awg2-") ? 1280:1500))
+    let dns=graph["dns"] as! [String:Any],servers=dns["servers"] as! [[String:Any]],server=servers.last!
+    let kind=["home":"udp","custom":"tcp","dot":"tls","doh":"https","doh3":"h3"][dnsMode]!
+    try check("selected resolver preserved",server["server"] as? String=="192.168.50.133" && server["type"] as? String==kind && server["detour"] as? String=="proxy")
+    try check("selected resolver port preserved",server["server_port"] as? Int==(dnsMode=="home" ? 53:5353))
+    if ["doh","doh3"].contains(dnsMode){try check("DNS path preserved",server["path"] as? String=="/private-dns")}
+    try check("separate loopback entry proof",ins.contains{$0["tag"] as? String==P.entryProofTag && $0["listen"] as? String=="127.0.0.1" && $0["listen_port"] as? Int==1098})
+    let meta=try json(["entry_id":"entry","exit_id":"exit","entry_node_id":e["node_proof_id"]!,"exit_node_id":x["node_proof_id"]!,"entry_token":"test-entry-token","exit_token":"test-exit-token","entry_api":"http://10.77.0.1:8787","exit_api":"http://10.88.0.1:8787","entry_tag":P.entryTag,"entry_mode":entryMode,"exit_mode":exitMode,"execution":execution])
+    let plan=try rpc("plan",final,meta),planned=try object(plan),plannedOut=planned["outbounds"] as! [[String:Any]]
+    let local=plannedOut.first{$0["tag"] as? String=="routervpn-execution-local"}!
+    try check("comparison preserves local exit protocol",local["config_json"] as? String==nativeSource && local["detour"] as? String==P.entryTag)
+    try check("server execution remains through entry",plannedOut.contains{$0["tag"] as? String=="routervpn-execution-server" && $0["detour"] as? String==P.entryTag})
+    let owner=try object(rpc("mtu-profile",final,profiles))
+    try check("optimizer holds fixed proxy MTU",entryMode=="wg" || entryMode.hasPrefix("awg2-") || owner["manual_mtu"] as? Int==1500)
+    try check("source assets never rewritten",original==snapshot)
+    if let folder=ProcessInfo.processInfo.environment["ROUTERVPN_IOS_XRAY_EXIT_FIXTURES"] {
+        let dir=URL(fileURLWithPath:folder).appendingPathComponent([phase,entryMode,exitMode,execution,dnsMode].joined(separator:"-"))
+        try FileManager.default.createDirectory(at:dir,withIntermediateDirectories:true)
+        try Data(final.utf8).write(to:dir.appendingPathComponent("sing-box.json"))
+        try Data(plan.utf8).write(to:dir.appendingPathComponent("planned.json"))
+    }
+    graphCount += 1
+}
+for e in entryModes {for x in P.nativeXrayModes {for execution in ["local","server","auto"] {try verify("matrix",e,x,execution,"home")}}}
+for x in P.nativeXrayModes {for dns in ["home","custom","dot","doh","doh3"] {try verify("dns","shadowsocks",x,"auto",dns)}}
+try check("full positive graph matrix",graphCount==87)
+for mode in P.nativeXrayModes {
+    let good=try assets(mode)
+    for fault in ["raw","extra","encoding"] {
+        var bad=good
+        if fault=="raw"{bad["xray.json"]=Data("{}".utf8).base64EncodedString()}
+        if fault=="extra"{bad["cert.pem"]="e30="}
+        if fault=="encoding"{bad["xray.json"]! += "\n"}
+        reject("malformed exact exit source "+fault){_ = try P.xrayFiles(assets:bad,mode:mode,profile:exit,compiler:compile)}
+    }
+    reject("no output from native compiler") {_ = try P.xrayFiles(assets:good,mode:mode,profile:exit,compiler:{_,_ in ""})}
+    for fault in ["mode","auth","detour"] {
+        reject("compiler output cannot change "+fault){
+            _ = try P.xrayFiles(assets:good,mode:mode,profile:exit,compiler:{payload,selected in
+                var graph=try object(compile(payload,selected)),outs=graph["outbounds"] as! [[String:Any]]
+                if fault=="mode"{outs[0]["mode"]="max"};if fault=="auth"{outs[0]["config_json"]="{}"};if fault=="detour"{outs[0]["detour"]="direct"}
+                graph["outbounds"]=outs;return try json(graph)
+            })
+        }
+    }
+    var hostname=exit;hostname["dns_mode"]="doh3";hostname["dns_host"]="resolver.example.test";hostname["adguard_ipv4"]="192.168.50.133"
+    let graph=try object(String(decoding:P.xrayFiles(assets:good,mode:mode,profile:hostname,compiler:compile)["sing-box.json"]!,as:UTF8.self))
+    let servers=(graph["dns"] as! [String:Any])["servers"] as! [[String:Any]]
+    try check("resolver hostname bootstrap traverses exit",servers.count==2 && servers.allSatisfy{$0["detour"] as? String=="proxy"} && servers[1]["domain_resolver"] as? String=="routervpn-bootstrap-dns")
+}
+var home=exit;home["adguard_ipv4"]="192.168.50.133"
+let legacy=try P.xrayFiles(assets:assets("reality-xhttp",legacy:true),mode:"reality-xhttp",profile:home,compiler:compile)
+let homeServers=(try object(String(decoding:legacy["sing-box.json"]!,as:UTF8.self))["dns"] as! [String:Any])["servers"] as! [[String:Any]]
+try check("legacy raw XHTTP uses only captured home AdGuard",homeServers[0]["server"] as? String=="192.168.50.133")
+for mode in ["split","max","tor","unregistered"] {reject("unsupported exit not relabeled") {_ = try P.xrayFiles(assets:assets("reality-vision"),mode:mode,profile:home,compiler:compile)}}
+print("Apple native Xray exits: PASS (\(graphCount) graphs; \(checks) executable checks; no live node contacted)")
+'''
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--entry-fixtures',type=Path)
+    parser.add_argument('--fixture-dir',type=Path)
+    args=parser.parse_args()
+    for command in ('go','swiftc'):
+        if not shutil.which(command):raise RuntimeError(command+' is required')
+    spec=importlib.util.spec_from_file_location('apple_graph_fixture',ROOT/'deploy/test_ios_multihop_graph.py')
+    fixture=importlib.util.module_from_spec(spec);spec.loader.exec_module(fixture)
+    boundary='for mode in ["shadowsocks", "hysteria2"] {'
+    prefix=fixture.TEST.split(boundary,1)[0]
+    if prefix==fixture.TEST:raise RuntimeError('Original graph harness boundary changed')
+    with tempfile.TemporaryDirectory(prefix='.ios-xray-exit-policy-',dir=ROOT) as go_dir,tempfile.TemporaryDirectory(prefix='router-ios-xray-exits-') as temp:
+        go_dir=Path(go_dir);temp=Path(temp)
+        (go_dir/'main.go').write_text(GO_HELPER)
+        helper=temp/'policy'
+        subprocess.run(['go','build','-buildvcs=false','-o',str(helper),str(go_dir/'main.go')],cwd=ROOT,check=True,timeout=90)
+        entries=args.entry_fixtures
+        if entries is None:
+            entries=temp/'entries.json'
+            with entries.open('w') as output:subprocess.run(['go','run','./deploy/testfixtures/xray-entry'],cwd=ROOT,stdout=output,check=True,timeout=90)
+        if set(json.loads(entries.read_text()))!={'reality-vision','reality-pq-vision','reality-xhttp'}:raise RuntimeError('Incomplete public native fixtures')
+        source=temp/'main.swift';source.write_text(prefix+TEST)
+        exe=temp/'tests'
+        subprocess.run(['swiftc','-swift-version','6',str(POLICY),str(POLICY.with_name('RouterVPNMTUPolicy.swift')),str(ROOT/'ios/RouterVPN/App/Models.swift'),str(source),'-o',str(exe)],check=True,timeout=90)
+        env=dict(os.environ,ROUTERVPN_XRAY_EXIT_POLICY=str(helper),ROUTERVPN_XRAY_ENTRY_FIXTURES=str(entries.resolve()))
+        if args.fixture_dir:env['ROUTERVPN_IOS_XRAY_EXIT_FIXTURES']=str(args.fixture_dir.resolve())
+        subprocess.run([str(exe)],env=env,check=True,timeout=90)
+    provider=(POLICY.parent/'PacketTunnelProvider.swift').read_text()
+    scope=provider.split('private func startMultihop(',1)[1].split('private func startLibbox(',1)[0]
+    for required in ('RouterVPNMultihopGraph.xrayFiles(', 'LibboxRouterCompileXrayExit(', 'engine.prepareMTUHold(initialMTUHold)', 'expectedNodeID: entryProofID', 'expectedNodeID: exitProofID', 'currentPathProofGuard() === comparisonGuard'):
+        if required not in scope:raise AssertionError('Shipping native exit binding missing '+required)
+    if not scope.index('LibboxRouterCompileXrayExit(')<scope.index('engine.start(')<scope.index('expectedNodeID: exitProofID'):raise AssertionError('Unverified native exit startup order')
+    print('Real PacketTunnel compiler, MTU hold, retained runtime and distinct node-proof bindings preserved.')
+
+if __name__=='__main__':main()
